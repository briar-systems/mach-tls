# borrowed certificate, key, chain, and trust store contracts

use tls.error;
use crypto.signature;
use std.types.size.usize;
use std.types.string.str;

fwd tls.cert.name;

pub def KeyFormat: u8;

pub val PKCS8_DER:       KeyFormat = 0;
pub val SEC1_DER:        KeyFormat = 1;
pub val RSA_PKCS1_DER:   KeyFormat = 2;

pub rec Certificate {
    der:     *u8;
    der_len: usize;
}

pub rec Chain {
    certificates: *Certificate;
    len:          usize;
}

pub rec PrivateKey {
    format:    KeyFormat;
    algorithm: signature.Algorithm;
    der:       *^u8;
    der_len:   usize;
}

pub rec TrustStore {
    anchors: *Certificate;
    len:     usize;
}

# verification covers path building, time, purpose, and server name
pub def VerifyChainFun: fun(*TrustStore, *Chain, str, u64) error.Error;

test "cert: encoded private key formats are explicit" {
    if (PKCS8_DER == SEC1_DER) { ret 1; }
    if (SEC1_DER == RSA_PKCS1_DER) { ret 1; }
    ret 0;
}
