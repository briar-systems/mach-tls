# trust anchors from a PEM CA bundle, such as a system's ca-certificates.crt
#
# a bundle is not a chain. distributions write comment lines between blocks
# and ship certificates this build cannot use, so the reader is tolerant where
# `load.chain_pem` is strict: text outside a block is ignored, and a block that
# cannot become an anchor is skipped. a skip is always reported with its
# reason, never dropped, because a quietly smaller anchor set is a trust
# decision nobody made. a bundle past a bound is refused whole for the same
# reason, never truncated.

use crypto.contracts;
use crypto.encoding.pem;
use pki.cert;
use pki.x509;
use std.allocator;
use std.allocator.page;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.path.Path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use tls.client;
use tls.memory_range;

# system bundles are about 200 KiB and 150 certificates
pub val MAX_BYTES:   usize = 1048576;
pub val MAX_BLOCKS:  usize = 1024;
pub val MAX_ANCHORS: usize = client.MAX_TRUST_ANCHORS;

pub def Status: u8;
pub val OK:         Status = 0;
pub val INVALID:    Status = 1;
pub val MISSING:    Status = 2;
pub val UNREADABLE: Status = 3;
pub val TOO_LARGE:  Status = 4;
pub val STORAGE:    Status = 5;
pub val NO_ANCHORS: Status = 6;

pub def Reason: u8;
pub val MALFORMED_PEM:         Reason = 1;
pub val NOT_A_CERTIFICATE:     Reason = 2;
pub val MALFORMED_CERTIFICATE: Reason = 3;
pub val UNSUPPORTED:           Reason = 4;
pub val DUPLICATE:             Reason = 5;

# one block that did not become an anchor
pub rec Skip {
    index:  usize;
    offset: usize;
    length: usize;
    reason: Reason;
    detail: contracts.Error;
}

pub rec Requirements {
    blocks:       usize;
    certificates: usize;
    der:          usize;
}

pub rec Storage {
    der:             contracts.Buffer;
    anchors:         *cert.Certificate;
    anchor_capacity: usize;
    skips:           *Skip;
    skip_capacity:   usize;
}

pub rec Bundle {
    store:   cert.TrustStore;
    skips:   *Skip;
    skipped: usize;
    blocks:  usize;
}

pub rec Loaded {
    bundle:       Bundle;
    der:          *u8;
    der_size:     usize;
    anchors:      *cert.Certificate;
    anchor_count: usize;
    skips:        *Skip;
    skip_count:   usize;
}

val BEGIN:       [11]u8 = [11]u8{'-', '-', '-', '-', '-', 'B', 'E', 'G', 'I', 'N', ' '};
val END:         [9]u8  = [9]u8{'-', '-', '-', '-', '-', 'E', 'N', 'D', ' '};
val DASHES:      [5]u8  = [5]u8{'-', '-', '-', '-', '-'};
val CERTIFICATE: [11]u8 = [11]u8{
    'C', 'E', 'R', 'T', 'I', 'F', 'I', 'C', 'A', 'T', 'E',
};

rec Block {
    offset:      usize;
    finish:      usize;
    label_start: usize;
    label_len:   usize;
    closed:      bool;
}

fun matches(input: contracts.Bytes, at: usize, expected: *u8,
    length: usize) bool {
    if (at > input.len || length > input.len - at) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (input.data[at + i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the index of the newline ending the line at `at`, or the input's length
fun line_end(input: contracts.Bytes, at: usize) usize {
    var position: usize = at;
    for (position < input.len && input.data[position] != '\n') {
        position = position + 1;
    }
    ret position;
}

fun next_line(input: contracts.Bytes, at: usize) usize {
    val end: usize = line_end(input, at);
    if (end < input.len) { ret end + 1; }
    ret end;
}

# finds the next block from the line start `from`. a block opens with a line
# that starts `-----BEGIN ` and closes with the first line after it that starts
# `-----END `. a block that meets another opening line or the end of the input
# first is unterminated, and ends where the next one starts
fun next_block(input: contracts.Bytes, from: usize, block: *Block) bool {
    var at: usize = from;
    for (at < input.len && !matches(input, at, ?BEGIN[0], 11)) {
        at = next_line(input, at);
    }
    if (at >= input.len) { ret false; }
    block.offset      = at;
    block.label_start = at + 11;
    block.label_len   = 0;
    block.closed      = false;
    var stop: usize = line_end(input, at);
    if (stop > at && input.data[stop - 1] == '\r') { stop = stop - 1; }
    if (stop >= at + 16 && matches(input, stop - 5, ?DASHES[0], 5)) {
        block.label_len = stop - 5 - block.label_start;
    }
    var line: usize = next_line(input, at);
    for (line < input.len) {
        if (matches(input, line, ?END[0], 9)) {
            block.closed = true;
            block.finish = next_line(input, line);
            ret true;
        }
        if (matches(input, line, ?BEGIN[0], 11)) {
            block.finish = line;
            ret true;
        }
        line = next_line(input, line);
    }
    block.finish = input.len;
    ret true;
}

fun certificate_label(input: contracts.Bytes, block: *Block) bool {
    ret block.label_len == 11 &&
        matches(input, block.label_start, ?CERTIFICATE[0], 11);
}

fun input_valid(input: contracts.Bytes) bool {
    ret (input.data != nil || input.len == 0) &&
        memory_range.valid(input.data, input.len);
}

# what `parse` needs for this input: every block, every block labelled as a
# certificate, and a bound on the der those decode to
pub fun measure(input: contracts.Bytes, output: *Requirements) Status {
    if (output == nil || !input_valid(input)) { ret INVALID; }
    output.blocks       = 0;
    output.certificates = 0;
    output.der          = 0;
    if (input.len > MAX_BYTES) { ret TOO_LARGE; }
    var at:    usize = 0;
    var block: Block;
    for (next_block(input, at, ?block)) {
        if (output.blocks == MAX_BLOCKS) { ret TOO_LARGE; }
        output.blocks = output.blocks + 1;
        if (block.closed && certificate_label(input, ?block)) {
            output.certificates = output.certificates + 1;
            # der is never longer than the base64 that encodes it
            output.der = output.der + (block.finish - block.offset);
        }
        at = block.finish;
    }
    ret OK;
}

fun capped(value: usize) usize {
    if (value > MAX_ANCHORS) { ret MAX_ANCHORS; }
    ret value;
}

fun clear(output: *Bundle) {
    output.store   = cert.no_trust_store();
    output.skips   = nil;
    output.skipped = 0;
    output.blocks  = 0;
}

fun same(first: cert.Certificate, second: contracts.Bytes) bool {
    if (first.der_len != second.len) { ret false; }
    var i: usize = 0;
    for (i < second.len) {
        if (first.der[i] != second.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun duplicate(anchors: *cert.Certificate, count: usize,
    der: contracts.Bytes) bool {
    var i: usize = 0;
    for (i < count) {
        if (same(anchors[i], der)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# reads every block of input into storage. the anchors borrow storage.der,
# which must stay stable for the life of the trust store. on OK and on
# NO_ANCHORS the output also lists every skipped block, in bundle order
pub fun parse(input: contracts.Bytes, storage: Storage,
    output: *Bundle) Status {
    if (output == nil) { ret INVALID; }
    clear(output);
    var required: Requirements;
    val measured: Status = measure(input, ?required);
    if (measured != OK) { ret measured; }
    if (storage.der.capacity < required.der ||
        storage.anchor_capacity < capped(required.certificates) ||
        storage.skip_capacity < required.blocks) { ret STORAGE; }
    if ((required.der != 0 && storage.der.data == nil) ||
        (required.certificates != 0 && storage.anchors == nil) ||
        (required.blocks != 0 && storage.skips == nil) ||
        !memory_range.valid(storage.der.data, storage.der.capacity) ||
        memory_range.overlap(input.data, input.len, storage.der.data,
        storage.der.capacity)) { ret INVALID; }
    var found:   usize = 0;
    var skipped: usize = 0;
    var written: usize = 0;
    var index:   usize = 0;
    var at:      usize = 0;
    var block:   Block;
    for (next_block(input, at, ?block)) {
        at = block.finish;
        var reason: Reason          = 0;
        var detail: contracts.Error = contracts.INVALID_INPUT;
        if (!block.closed || block.label_len == 0) { reason = MALFORMED_PEM; }
        or (!certificate_label(input, ?block)) {
            reason = NOT_A_CERTIFICATE;
            detail = contracts.UNSUPPORTED;
        }
        or {
            var decoded: pem.Block;
            detail = pem.decode(contracts.Bytes{data: ?input.data[block.offset],
                len: block.finish - block.offset},
                contracts.Buffer{data: ?storage.der.data[written],
                capacity: storage.der.capacity - written}, ?decoded);
            if (detail != contracts.OK) { reason = MALFORMED_PEM; }
            or {
                # parsed as an anchor, not a chain member: a root is trusted
                # because it was configured, so a self-signature this build
                # cannot verify does not disqualify it
                var parsed: x509.Certificate;
                detail = x509.parse_trust_anchor(decoded.der, ?parsed);
                if (detail == contracts.UNSUPPORTED) { reason = UNSUPPORTED; }
                or (detail != contracts.OK)          { reason = MALFORMED_CERTIFICATE; }
                or (duplicate(storage.anchors, found, decoded.der)) {
                    reason = DUPLICATE;
                }
                or {
                    if (found == MAX_ANCHORS) { ret TOO_LARGE; }
                    storage.anchors[found] = cert.Certificate{
                        der: decoded.der.data, der_len: decoded.der.len
                    };
                    written = written + decoded.der.len;
                    found   = found + 1;
                }
            }
        }
        if (reason != 0) {
            storage.skips[skipped] = Skip{index: index, offset: block.offset,
                length: block.finish - block.offset, reason: reason,
                detail: detail};
            skipped = skipped + 1;
        }
        index = index + 1;
    }
    output.blocks  = index;
    output.skipped = skipped;
    if (skipped != 0) { output.skips = storage.skips; }
    if (found == 0)   { ret NO_ANCHORS; }
    output.store = cert.TrustStore{anchors: storage.anchors, len: found};
    ret OK;
}

pub fun empty(output: *Loaded) {
    if (output == nil) { ret; }
    clear(?output.bundle);
    output.der          = nil;
    output.der_size     = 0;
    output.anchors      = nil;
    output.anchor_count = 0;
    output.skips        = nil;
    output.skip_count   = 0;
}

fun open_status(error: io_error.Error) Status {
    if (error.kind == io_error.NOT_FOUND) { ret MISSING; }
    ret UNREADABLE;
}

# reads the whole file, refusing one that is past the bound or that changes
# size while it is read
fun read_file(a: *allocator.Allocator, path: str, data: **u8,
    length: *usize) Status {
    @data   = nil;
    @length = 0;
    val opened: res[fs.File, io_error.Error] = fs.open(path::Path);
    if (sel opened.err) { ret open_status(opened.err); }
    var handle: fs.File                          = opened.ok;
    val stat:   res[fs.Metadata, io_error.Error] = fs.stat_of(handle);
    if (sel stat.err) {
        fs.close(?handle);
        ret UNREADABLE;
    }
    var metadata: fs.Metadata = stat.ok;
    if (!fs.meta_is_file(?metadata)) {
        fs.close(?handle);
        ret UNREADABLE;
    }
    val size: usize = metadata.size;
    if (size > MAX_BYTES) {
        fs.close(?handle);
        ret TOO_LARGE;
    }
    var memory: *u8 = nil;
    if (size != 0) {
        val allocated: res[*u8, allocator.Error] = allocator.allocate[u8](a, size);
        if (sel allocated.err) {
            fs.close(?handle);
            ret STORAGE;
        }
        memory = allocated.ok;
    }
    var total:  usize  = 0;
    var extra:  u8     = 0;
    var status: Status = OK;
    for (status == OK) {
        var target: *u8   = ?extra;
        var want:   usize = 1;
        if (total < size) {
            target = ?memory[total];
            want   = size - total;
        }
        val read: res[usize, io_error.Error] = fs.read(handle, target, want);
        if (sel read.err) {
            if (!io_error.retryable(read.err)) { status = UNREADABLE; }
            cnt;
        }
        val count: usize = read.ok;
        if (count == 0) {
            if (total != size) { status = UNREADABLE; }
            brk;
        }
        # a byte past the size the file had when opened
        if (total == size) { status = UNREADABLE; }
        total = total + count;
    }
    fs.close(?handle);
    if (status != OK) {
        allocator.deallocate[u8](a, memory, size);
        ret status;
    }
    @data   = memory;
    @length = size;
    ret OK;
}

# loads the bundle at path into memory from a, which the caller returns with
# `release` after the trust store's last use. output holds the parse's result
# on OK and on NO_ANCHORS, and is empty otherwise
pub fun load(a: *allocator.Allocator, path: str, output: *Loaded) Status {
    if (output == nil) { ret INVALID; }
    empty(output);
    if (a == nil || path == nil || path[0] == 0) { ret INVALID; }
    var text:   *u8    = nil;
    var length: usize  = 0;
    val read:   Status = read_file(a, path, ?text, ?length);
    if (read != OK) { ret read; }
    val input:    contracts.Bytes = contracts.Bytes{data: text, len: length};
    var required: Requirements;
    var status:   Status          = measure(input, ?required);
    if (status == OK) {
        val der:     res[*u8, allocator.Error]               = allocator.allocate[u8](a, required.der);
        val anchors: res[*cert.Certificate, allocator.Error] =
            allocator.allocate[cert.Certificate](a, capped(required.certificates));
        val skips: res[*Skip, allocator.Error] =
            allocator.allocate[Skip](a, required.blocks);
        if (sel der.ok) {
            output.der      = der.ok;
            output.der_size = required.der;
        }
        if (sel anchors.ok) {
            output.anchors      = anchors.ok;
            output.anchor_count = capped(required.certificates);
        }
        if (sel skips.ok) {
            output.skips      = skips.ok;
            output.skip_count = required.blocks;
        }
        if ((sel der.err) || (sel anchors.err) || (sel skips.err)) { status = STORAGE; }
    }
    if (status == OK) {
        status = parse(input, Storage{
            der:     contracts.Buffer{data: output.der, capacity: output.der_size},
            anchors: output.anchors, anchor_capacity: output.anchor_count,
            skips:   output.skips, skip_capacity: output.skip_count
        },
            ?output.bundle);
    }
    allocator.deallocate[u8](a, text, length);
    if (status != OK && status != NO_ANCHORS) { release(a, output); }
    ret status;
}

pub fun release(a: *allocator.Allocator, loaded: *Loaded) {
    if (a == nil || loaded == nil) { ret; }
    allocator.deallocate[u8](a, loaded.der, loaded.der_size);
    allocator.deallocate[cert.Certificate](a, loaded.anchors, loaded.anchor_count);
    allocator.deallocate[Skip](a, loaded.skips, loaded.skip_count);
    empty(loaded);
}

#[testing]
val ROOT: str = "-----BEGIN CERTIFICATE-----\nMIIBoDCCAVKgAwIBAgIUcUBdqlz8lEoxcPtVyGLrQN0qDrwwBQYDK2VwMDwxCzAJ\nBgNVBAYTAlVTMRMwEQYDVQQKDApCcmlhciBUZXN0MRgwFgYDVQQDDA9CcmlhciBU\nZXN0IFJvb3QwHhcNMjYwODI4MTEzMjQ1WhcNMzYwODI1MTEzMjQ1WjA8MQswCQYD\nVQQGEwJVUzETMBEGA1UECgwKQnJpYXIgVGVzdDEYMBYGA1UEAwwPQnJpYXIgVGVz\ndCBSb290MCowBQYDK2VwAyEA1zQsVUhtzx5sroC8d3ohC0MJZbzDcOsY4SoyGpTY\ncU2jZjBkMB8GA1UdIwQYMBaAFELfNo+RqDCA56syuG7lnW5tmzn+MBIGA1UdEwEB\n/wQIMAYBAf8CAQAwDgYDVR0PAQH/BAQDAgEGMB0GA1UdDgQWBBRC3zaPkagwgOer\nMrhu5Z1ubZs5/jAFBgMrZXADQQB+WLFqB51+X7MOjRk2ZhOLGMvH4WNx8S8TO5rD\nVHQtXkYNVwGK3eDz3CZdB9uJH2HCTrIISG55wgGR3yg6cHoJ\n-----END CERTIFICATE-----\n";

# a P-521 key, which this build cannot represent
#[testing]
val P521_ROOT: str = "-----BEGIN CERTIFICATE-----\nMIICBTCCAWagAwIBAgIUdCIyy1M1plepJx9Rx4jW/1gRlhgwCgYIKoZIzj0EAwIw\nFDESMBAGA1UEAwwJUDUyMSBSb290MB4XDTI2MDkyNzA2NTUxNFoXDTM2MDkyNDA2\nNTUxNFowFDESMBAGA1UEAwwJUDUyMSBSb290MIGbMBAGByqGSM49AgEGBSuBBAAj\nA4GGAAQB6r27q74kR2bnzCe518X4u9oi36t0+sSTCD3sYi97eyHrrk87sf2tkw7q\n/E9q3TRlKRkj11TaOzMANQ8TBcXPRg0AUVFesV7196pa2nwg50bUGVd943pk5vzA\nO8faUOllkoRLvCNOFgVwFv653rKFFpjHhNEDlcf/nlGQyGUA2pgGPumjUzBRMB0G\nA1UdDgQWBBT1EPlmAcVldcCX8QoVJmrZfDKUCzAfBgNVHSMEGDAWgBT1EPlmAcVl\ndcCX8QoVJmrZfDKUCzAPBgNVHRMBAf8EBTADAQH/MAoGCCqGSM49BAMCA4GMADCB\niAJCAJtYloGQ4V4O4ij4yZycBQ8EFAn1AQcIVNqwMJoeq1VfOhKiZBfYCIWOd9cO\n4eOLhlC7uX3GoJq7yKjdv9Bbnc0UAkIBuKSg6hnLBeyuR3k9txlWixHxVpk+pX8f\nrrztkcR5IEJYiF3uVNvk5wBRNzvp3oQ3zS3FJvi7LPfqtN4l9hGp0HU=\n-----END CERTIFICATE-----\n";

#[testing]
fun put(target: *u8, at: usize, value: str) usize {
    var i: usize = 0;
    for (value[i] != 0) {
        target[at + i] = value[i]::u8;
        i              = i + 1;
    }
    ret at + i;
}

#[testing]
fun skip_is(bundle: *Bundle, i: usize, index: usize, reason: Reason) bool {
    ret i < bundle.skipped && bundle.skips[i].index == index &&
        bundle.skips[i].reason == reason;
}

# every anchor and skip is accounted for, and no anchor repeats
#[testing]
fun consistent(bundle: *Bundle) bool {
    if (bundle.store.len + bundle.skipped != bundle.blocks ||
        bundle.store.len > MAX_ANCHORS) { ret false; }
    var i: usize = 0;
    for (i < bundle.store.len) {
        var parsed: x509.Certificate;
        val anchor: cert.Certificate = bundle.store.anchors[i];
        if (x509.parse_trust_anchor(contracts.Bytes{data: anchor.der,
            len: anchor.der_len}, ?parsed) != contracts.OK ||
            duplicate(bundle.store.anchors, i, contracts.Bytes{data: anchor.der,
            len: anchor.der_len})) { ret false; }
        i = i + 1;
    }
    ret true;
}

test cert_bundle__every_block_is_an_anchor_or_a_reported_skip {
    # the comment lines every distribution writes, then one block of each kind.
    # an unterminated block must not swallow the block after it
    var text: [4096]u8;
    var at:   usize = put(?text[0], 0, "# Briar Test Root\n");
    at = put(?text[0], at, ROOT);
    val second: usize = put(?text[0], at, "\n-----BEGIN CERTIFICATE-----\nAAAA\n");
    at = put(?text[0], second, ROOT);
    at = put(?text[0], at, "-----BEGIN PRIVATE KEY-----\nAAAA\n-----END PRIVATE KEY-----\n");
    at = put(?text[0], at, "-----BEGIN CERTIFICATE-----\n!!!!\n-----END CERTIFICATE-----\n");
    at = put(?text[0], at, "-----BEGIN CERTIFICATE-----\nMAA=\n-----END CERTIFICATE-----\n");
    at = put(?text[0], at, P521_ROOT);
    val tail: usize = at;
    at = put(?text[0], at, "-----BEGIN CERTIFICATE-----\nAAAA\n");
    val input: contracts.Bytes = contracts.Bytes{data: ?text[0], len: at};

    var required: Requirements;
    if (measure(input, ?required) != OK || required.blocks != 8 ||
        required.certificates != 5) { ret 1; }
    var der:     [4096]u8;
    var anchors: [8]cert.Certificate;
    var skips:   [8]Skip;
    var bundle:  Bundle;
    if (parse(input, Storage{der: contracts.Buffer{data: ?der[0], capacity: 4096},
        anchors:       ?anchors[0], anchor_capacity: 8, skips: ?skips[0],
        skip_capacity: 8}, ?bundle) != OK) { ret 2; }
    if (bundle.blocks != 8 || bundle.store.len != 1 || bundle.skipped != 7 ||
        bundle.store.anchors[0].der_len != 420 || !consistent(?bundle)) { ret 3; }
    if (!skip_is(?bundle, 0, 1, MALFORMED_PEM) || skips[0].offset != 642 ||
        skips[0].length != second - 642 ||
        !skip_is(?bundle, 1, 2, DUPLICATE) || skips[1].offset != second ||
        !skip_is(?bundle, 2, 3, NOT_A_CERTIFICATE) ||
        !skip_is(?bundle, 3, 4, MALFORMED_PEM) ||
        !skip_is(?bundle, 4, 5, MALFORMED_CERTIFICATE) ||
        !skip_is(?bundle, 5, 6, UNSUPPORTED) ||
        !skip_is(?bundle, 6, 7, MALFORMED_PEM) || skips[6].offset != tail ||
        skips[6].length != at - tail) { ret 4; }

    # storage smaller than measure asked for refuses before anything is written
    if (parse(input, Storage{der: contracts.Buffer{data: ?der[0],
        capacity: required.der - 1}, anchors: ?anchors[0], anchor_capacity: 8,
        skips:    ?skips[0], skip_capacity: 8}, ?bundle) != STORAGE ||
        bundle.store.len != 0 || bundle.skips != nil) { ret 5; }
    if (parse(input, Storage{der: contracts.Buffer{data: ?der[0], capacity: 4096},
        anchors:       ?anchors[0], anchor_capacity: 8, skips: ?skips[0],
        skip_capacity: 7}, ?bundle) != STORAGE) { ret 6; }
    # without one usable anchor the bundle is refused, and still says why
    val unusable: contracts.Bytes = contracts.Bytes{data: ?text[tail - 761],
        len: at - (tail - 761)};
    if (parse(unusable, Storage{der: contracts.Buffer{data: ?der[0], capacity: 4096},
        anchors:       ?anchors[0], anchor_capacity: 8, skips: ?skips[0],
        skip_capacity: 8}, ?bundle) != NO_ANCHORS || bundle.store.len != 0 ||
        bundle.blocks != 2 || !skip_is(?bundle, 0, 0, UNSUPPORTED) ||
        !skip_is(?bundle, 1, 1, MALFORMED_PEM)) { ret 7; }
    if (parse(contracts.Bytes{data: ?text[0], len: 17}, Storage{
        der:             contracts.Buffer{data: nil, capacity: 0}, anchors: nil,
        anchor_capacity: 0, skips: nil, skip_capacity: 0
    }, ?bundle) != NO_ANCHORS ||
        bundle.blocks != 0 || bundle.skipped != 0) { ret 8; }
    ret 0;
}

test cert_bundle__bounds_refuse_the_bundle_whole {
    var text:     [18500]u8;
    var at:       usize = 0;
    var required: Requirements;
    if (measure(contracts.Bytes{data: ?text[0], len: MAX_BYTES + 1},
        ?required) != TOO_LARGE) { ret 1; }
    var i: usize = 0;
    for (i < MAX_BLOCKS) {
        at = put(?text[0], at, "-----BEGIN X-----\n");
        i  = i + 1;
    }
    if (measure(contracts.Bytes{data: ?text[0], len: at}, ?required) != OK ||
        required.blocks != MAX_BLOCKS || required.certificates != 0) { ret 2; }
    at = put(?text[0], at, "-----BEGIN X-----\n");
    if (measure(contracts.Bytes{data: ?text[0], len: at}, ?required) != TOO_LARGE) {
        ret 3;
    }
    if (measure(contracts.Bytes{data: nil, len: 1}, ?required) != INVALID) { ret 4; }
    ret 0;
}

# loads a bundle and checks its counts. a system bundle's blocks are all
# well-formed and distinct, so the only skip it may have is a certificate
# whose key this build cannot use. a nonzero blocks also fixes the counts
#[testing]
fun loads(path: str, blocks: usize, anchors: usize, unsupported: usize) bool {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret false; }
    var loaded: Loaded;
    if (load(?a, path, ?loaded) != OK || !consistent(?loaded.bundle) ||
        (blocks != 0 && (loaded.bundle.blocks != blocks ||
        loaded.bundle.store.len != anchors ||
        loaded.bundle.skipped != unsupported))) { ret false; }
    var i: usize = 0;
    for (i < loaded.bundle.skipped) {
        if (loaded.bundle.skips[i].reason != UNSUPPORTED ||
            loaded.bundle.skips[i].detail != contracts.UNSUPPORTED) { ret false; }
        i = i + 1;
    }
    release(?a, ?loaded);
    ret loaded.bundle.store.len == 0 && loaded.der == nil;
}

test cert_bundle__loads_the_debian_and_alpine_system_bundles {
    # every debian root loads. alpine's one skip is e-szigno tls root ca 2023,
    # whose p-521 key this build has no verifier for
    if (!loads("test/fixtures/bundles/debian.pem", 150, 150, 0)) { ret 1; }
    if (!loads("test/fixtures/bundles/alpine.pem", 121, 120, 1)) { ret 2; }
    ret 0;
}

test cert_bundle__loads_this_system_bundle_where_there_is_one {
    val path:    str                       = "/etc/ssl/certs/ca-certificates.crt";
    val present: res[bool, io_error.Error] = fs.is_file(path::Path);
    if (sel present.err)       { ret 0; }
    if (!present.ok)           { ret 0; }
    if (!loads(path, 0, 0, 0)) { ret 1; }
    ret 0;
}

test cert_bundle__a_path_that_is_not_a_bundle_is_refused {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var loaded: Loaded;
    if (load(?a, "test/fixtures/bundles/absent.pem", ?loaded) != MISSING ||
        load(?a, "test/fixtures/bundles", ?loaded) != UNREADABLE ||
        load(?a, "", ?loaded) != INVALID || load(nil, "x", ?loaded) != INVALID ||
        loaded.der != nil || loaded.skips != nil) { ret 2; }
    ret 0;
}
