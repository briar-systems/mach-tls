# immutable credential generations and safe rotation

use crypto.contracts;
use crypto.encoding.der;
use crypto.encoding.keys;
use crypto.group.p256;
use crypto.secret;
use crypto.signature;
use pki.cert;
use pki.load;
use pki.name;
use pki.verify;
use pki.x509;
use std.crypto.ct;
use std.encoding.base64;
use std.sync.atomic;
use std.sync.mutex;
use std.sync.thread;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

pub val NO_DEFAULT: usize = 0 - 1;

val INITIAL:   i64 = 0;
val READY:     i64 = 1;
val PUBLISHED: i64 = 2;
val RETIRED:   i64 = 3;

pub rec Identity {
    server_name: contracts.Bytes;
    chain:       cert.Chain;
    private_key: *keys.PrivateKey;
}

# copying a generation duplicates synchronization state and is invalid
pub rec Generation {
    identities:          *Identity;
    identity_len:        usize;
    default_index:       usize;
    client_trust:        *cert.TrustStore;
    require_client_auth: bool;
    state:               i64;
    borrows:             i64;
}

pub rec Store {
    lock:        mutex.Mutex;
    current:     *Generation;
    initialized: bool;
}

# a lease must be released before its generation storage is reclaimed
pub rec Lease {
    generation: *Generation;
    identity:   *Identity;
}

# a value cleared by declaration rather than by an empty literal: a record
# literal leaves every field it does not name holding the previous stack
# frame's contents (briar-systems/mach#3108)
pub fun no_identity() Identity {
    var value: Identity;
    ret value;
}

pub fun empty_generation() Generation {
    ret Generation{
        identities:          nil,
        identity_len:        0,
        default_index:       NO_DEFAULT,
        client_trust:        nil,
        require_client_auth: false,
        state:               INITIAL,
        borrows:             0,
    };
}

pub fun empty_store() Store {
    ret Store{lock: mutex.make(), current: nil, initialized: false};
}

pub fun empty_lease() Lease {
    ret Lease{generation: nil, identity: nil};
}

fun bytes_equal(first: contracts.Bytes, second: contracts.Bytes) bool {
    if (first.len != second.len)                                    { ret false; }
    if (first.len > 0 && (first.data == nil || second.data == nil)) { ret false; }
    var i: usize = 0;
    for (i < first.len) {
        if (first.data[i] != second.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun folded_equal(first: contracts.Bytes, second: contracts.Bytes) bool {
    var first_len:  usize = first.len;
    var second_len: usize = second.len;
    if ((first_len > 0 && first.data == nil) ||
        (second_len > 0 && second.data == nil)) { ret false; }
    if (first_len > 0 && first.data[first_len - 1] == '.') { first_len = first_len - 1; }
    if (second_len > 0 && second.data[second_len - 1] == '.') {
        second_len = second_len - 1;
    }
    if (first_len != second_len || first.data == nil || second.data == nil) {
        ret false;
    }
    var i: usize = 0;
    for (i < first_len) {
        var left:  u8 = first.data[i];
        var right: u8 = second.data[i];
        if (left >= 'A' && left <= 'Z')   { left = left + ('a' - 'A'); }
        if (right >= 'A' && right <= 'Z') { right = right + ('a' - 'A'); }
        if (left != right)                { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ip_like(value: contracts.Bytes) bool {
    if (value.len == 0 || value.data == nil) { ret false; }
    var dot: bool  = false;
    var i:   usize = 0;
    for (i < value.len) {
        val character: u8 = value.data[i];
        if (character == ':')                   { ret true; }
        if (character == '.')                   { dot = true; }
        or (character < '0' || character > '9') { ret false; }
        i = i + 1;
    }
    ret dot;
}

fun public_equal(first: contracts.Bytes, second: contracts.Bytes) bool {
    ret bytes_equal(first, second);
}

fun key_matches_leaf(leaf: *x509.Certificate, private_key: *keys.PrivateKey) bool {
    if (leaf == nil || private_key == nil ||
        leaf.public_key.algorithm != private_key.algorithm) { ret false; }
    if (private_key.algorithm == keys.ED25519 || private_key.algorithm == keys.P256) {
        var private_bytes: contracts.SecretBytes;
        if (keys.private_bytes(private_key, ?private_bytes) != contracts.OK) {
            ret false;
        }
        var derived:   [65]u8;
        var operation: contracts.Operation;
        if (private_key.algorithm == keys.ED25519) {
            operation = signature.derive_ed25519_public(private_bytes,
                contracts.Buffer{data: ?derived[0], capacity: 65});
        }
        or {
            operation = p256.derive_public(private_bytes,
                contracts.Buffer{data: ?derived[0], capacity: 65});
        }
        ret operation.error == contracts.OK &&
            public_equal(contracts.Bytes{data: ?derived[0], len: operation.written},
            leaf.public_key.first);
    }
    if (private_key.algorithm == keys.RSA) {
        var modulus:          [512]u8;
        var exponent:         [512]u8;
        var private_exponent: [512]^u8;
        val status:           contracts.Error = keys.copy_rsa(private_key,
            contracts.Buffer{data: ?modulus[0], capacity: 512},
            contracts.Buffer{data: ?exponent[0], capacity: 512},
            contracts.SecretBuffer{data: ?private_exponent[0], capacity: 512});
        ct.zeroize(?private_exponent[0], 512);
        ret status == contracts.OK && private_key.modulus_len == leaf.public_key.first.len &&
            private_key.exponent_len == leaf.public_key.second.len &&
            public_equal(contracts.Bytes{data: ?modulus[0],
            len: private_key.modulus_len}, leaf.public_key.first) &&
            public_equal(contracts.Bytes{data: ?exponent[0],
            len: private_key.exponent_len}, leaf.public_key.second);
    }
    ret false;
}

pub fun key_matches(chain: *cert.Chain, private_key: *keys.PrivateKey) bool {
    if (chain == nil || private_key == nil || chain.len == 0 ||
        chain.certificates == nil || chain.certificates[0].der == nil ||
        chain.certificates[0].der_len == 0) { ret false; }
    var leaf: x509.Certificate;
    if (x509.parse(contracts.Bytes{data: chain.certificates[0].der,
        len: chain.certificates[0].der_len}, ?leaf) != contracts.OK) {
        ret false;
    }
    ret key_matches_leaf(?leaf, private_key);
}

fun validate_chain(value: *cert.Chain) bool {
    if (value == nil || value.len == 0 || value.len > verify.MAX_CHAIN_DEPTH ||
        value.certificates == nil) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val encoded: cert.Certificate = value.certificates[i];
        var parsed:  x509.Certificate;
        if (encoded.der == nil || encoded.der_len == 0) { ret false; }
        val input: contracts.Bytes = contracts.Bytes{data: encoded.der,
            len: encoded.der_len};
        val status: contracts.Error = x509.parse(input, ?parsed);
        if (status != contracts.OK) {
            if (status != contracts.UNSUPPORTED || i + 1 != value.len ||
                x509.parse_trust_anchor(input, ?parsed) != contracts.OK ||
                !x509.name_equal(parsed.subject, parsed.issuer)) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

fun validate_trust(value: *cert.TrustStore) bool {
    if (value == nil)                           { ret true; }
    if (value.len == 0 || value.anchors == nil) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val encoded: cert.Certificate = value.anchors[i];
        var parsed:  x509.Certificate;
        if (encoded.der == nil || encoded.der_len == 0 ||
            x509.parse_trust_anchor(contracts.Bytes{data: encoded.der,
            len: encoded.der_len}, ?parsed) != contracts.OK) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun identity_covers_leaf(identity: *Identity, leaf: *x509.Certificate) bool {
    if (identity == nil || leaf == nil || identity.server_name.len == 0) { ret true; }
    if (identity.server_name.data[0] != '*') {
        ret verify.identity(leaf, identity.server_name);
    }
    if (!leaf.extensions.subject_alt_name_present) { ret false; }
    var root: der.Element;
    if (der.exact(leaf.extensions.subject_alt_name, ?root) != contracts.OK ||
        root.tag != der.SEQUENCE) { ret false; }
    var parent: der.Cursor = der.cursor(leaf.extensions.subject_alt_name);
    var body:   der.Cursor;
    der.enter(?parent, ?root, ?body);
    for (!der.complete(?body)) {
        var general_name: der.Element;
        if (der.next(?body, ?general_name) != contracts.OK) { ret false; }
        if (general_name.tag == 0x82 &&
            folded_equal(identity.server_name, general_name.content)) { ret true; }
    }
    ret false;
}

fun identity_covers_name(identity: *Identity) bool {
    if (identity == nil) { ret false; }
    var leaf: x509.Certificate;
    if (x509.parse(contracts.Bytes{data: identity.chain.certificates[0].der,
        len: identity.chain.certificates[0].der_len}, ?leaf) != contracts.OK) {
        ret false;
    }
    ret identity_covers_leaf(identity, ?leaf);
}

fun generation_empty(value: *Generation) bool {
    ret value != nil && value.identities == nil && value.identity_len == 0 &&
        value.default_index == NO_DEFAULT && value.client_trust == nil &&
        !value.require_client_auth && value.state == INITIAL && value.borrows == 0;
}

pub fun initialize(value: *Generation, identities: *Identity,
    identity_len: usize, default_index: usize, client_trust: *cert.TrustStore,
    require_client_auth: bool) contracts.Error {
    if (!generation_empty(value) || identities == nil || identity_len == 0 ||
        (default_index != NO_DEFAULT && default_index >= identity_len) ||
        (require_client_auth && client_trust == nil) || !validate_trust(client_trust)) {
        ret contracts.INVALID_INPUT;
    }
    var i: usize = 0;
    for (i < identity_len) {
        val identity:   *Identity = ?identities[i];
        val empty_name: bool      = identity.server_name.len == 0;
        if ((empty_name && i != default_index) ||
            (!empty_name && (identity.server_name.data == nil ||
            !name.valid_presented_dns(identity.server_name))) ||
            !validate_chain(?identity.chain) || identity.private_key == nil ||
            !key_matches(?identity.chain, identity.private_key) ||
            !identity_covers_name(identity)) {
            ret contracts.INVALID_INPUT;
        }
        var prior: usize = 0;
        for (prior < i) {
            if (!empty_name && folded_equal(identity.server_name,
                identities[prior].server_name)) { ret contracts.INVALID_INPUT; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    value.identities          = identities;
    value.identity_len        = identity_len;
    value.default_index       = default_index;
    value.client_trust        = client_trust;
    value.require_client_auth = require_client_auth;
    atomic.store(?value.borrows, 0);
    atomic.store(?value.state, READY);
    ret contracts.OK;
}

# rfc 8737 acmeIdentifier, as object identifier content
val ACME_IDENTIFIER: [8]u8 = [8]u8{
    0x2b, 0x06, 0x01, 0x05, 0x05, 0x07, 0x01, 0x1f,
};

# the sole subject alternative name of a tls-alpn-01 certificate, which must
# be a non-wildcard dns name
fun tls_alpn_challenge_dns_name(value: *x509.Certificate,
    output: *contracts.Bytes) bool {
    if (value == nil || output == nil || !value.extensions.subject_alt_name_present ||
        value.extensions.subject_alt_name.data == nil ||
        value.extensions.subject_alt_name.len == 0) { ret false; }
    var sequence: der.Element;
    if (der.exact(value.extensions.subject_alt_name, ?sequence) != contracts.OK ||
        sequence.tag != der.SEQUENCE) { ret false; }
    var names:    der.Cursor = der.cursor(sequence.content);
    var dns_name: der.Element;
    if (der.next(?names, ?dns_name) != contracts.OK || dns_name.tag != 0x82 ||
        !der.complete(?names) || dns_name.content.len == 0 ||
        dns_name.content.data[0] == '*' ||
        !name.valid_presented_dns(dns_name.content)) { ret false; }
    @output = dns_name.content;
    ret true;
}

# rfc 8737 requires one non-wildcard dns san equal to the validation name
pub fun tls_alpn_challenge_name_matches(value: *x509.Certificate,
    expected: contracts.Bytes) bool {
    if (expected.data == nil || expected.len == 0 || expected.data[0] == '*' ||
        !name.valid_reference_dns(expected)) { ret false; }
    var presented: contracts.Bytes;
    ret value != nil && tls_alpn_challenge_dns_name(value, ?presented) &&
        name.match_dns(expected, presented);
}

# parses an rfc 8737 tls-alpn-01 certificate, which carries a critical
# acmeIdentifier holding a 32 byte digest and one non-wildcard dns san.
# output is left untouched unless parsing succeeds
pub fun parse_tls_alpn_challenge(input: contracts.Bytes,
    output: *x509.Certificate) contracts.Error {
    if (output == nil) { ret contracts.INVALID_INPUT; }
    var acme:    contracts.Bytes = contracts.Bytes{data: ?ACME_IDENTIFIER[0], len: 8};
    var options: x509.Options    = x509.Options{
        trust_anchor: false,
        critical:     ?acme,
        critical_len: 1,
    };
    var parsed: x509.Certificate;
    val status: contracts.Error = x509.parse_with(input, ?options, ?parsed);
    if (status != contracts.OK) { ret status; }
    var found:      x509.Extension;
    var identifier: der.Element;
    var presented:  contracts.Bytes;
    if (!x509.extension(?parsed, acme, ?found) || !found.critical ||
        der.exact(found.value, ?identifier) != contracts.OK ||
        identifier.tag != der.OCTET_STRING || identifier.content.len != 32 ||
        !tls_alpn_challenge_dns_name(?parsed, ?presented)) {
        ret contracts.INVALID_INPUT;
    }
    @output = parsed;
    ret contracts.OK;
}

# RFC 8737 credentials are transient, single-certificate server identities.
# Their critical acmeIdentifier extension is accepted only by this initializer.
pub fun initialize_tls_alpn_challenge(value: *Generation, identity: *Identity)
    contracts.Error {
    if (!generation_empty(value) || identity == nil || identity.server_name.data == nil ||
        identity.server_name.len == 0 || identity.server_name.data[0] == '*' ||
        !name.valid_presented_dns(identity.server_name) || identity.chain.len != 1 ||
        identity.chain.certificates == nil || identity.chain.certificates[0].der == nil ||
        identity.chain.certificates[0].der_len == 0 || identity.private_key == nil) {
        ret contracts.INVALID_INPUT;
    }
    var leaf: x509.Certificate;
    if (parse_tls_alpn_challenge(contracts.Bytes{
        data: identity.chain.certificates[0].der,
        len:  identity.chain.certificates[0].der_len
    }, ?leaf) != contracts.OK ||
        !key_matches_leaf(?leaf, identity.private_key) ||
        !tls_alpn_challenge_name_matches(?leaf,
        identity.server_name)) { ret contracts.INVALID_INPUT; }
    value.identities          = identity;
    value.identity_len        = 1;
    value.default_index       = 0;
    value.client_trust        = nil;
    value.require_client_auth = false;
    atomic.store(?value.borrows, 0);
    atomic.store(?value.state, READY);
    ret contracts.OK;
}

fun select_identity(value: *Generation,
    server_name: contracts.Bytes) *Identity {
    if (value == nil || value.identities == nil || value.identity_len == 0) {
        ret nil;
    }
    if (server_name.len > 0) {
        var parsed_ip: [16]u8;
        if (server_name.data == nil || ip_like(server_name) ||
            name.parse_ip(server_name,
            contracts.Buffer{data: ?parsed_ip[0], capacity: 16}).error ==
            contracts.OK || !name.valid_reference_dns(server_name)) { ret nil; }
        var i: usize = 0;
        for (i < value.identity_len) {
            val pattern: contracts.Bytes = value.identities[i].server_name;
            if (pattern.len > 0 && pattern.data[0] != '*' &&
                name.match_dns(server_name, pattern)) { ret ?value.identities[i]; }
            i = i + 1;
        }
        var best:        *Identity = nil;
        var best_length: usize     = 0;
        i = 0;
        for (i < value.identity_len) {
            val pattern: contracts.Bytes = value.identities[i].server_name;
            if (pattern.len > best_length && pattern.len > 0 &&
                pattern.data[0] == '*' && name.match_dns(server_name, pattern)) {
                best        = ?value.identities[i];
                best_length = pattern.len;
            }
            i = i + 1;
        }
        if (best != nil) { ret best; }
    }
    if (value.default_index != NO_DEFAULT && value.default_index < value.identity_len) {
        ret ?value.identities[value.default_index];
    }
    ret nil;
}

pub fun initialize_store(value: *Store,
    initial: *Generation) contracts.Error {
    if (value == nil || initial == nil || value.initialized || value.current != nil) {
        ret contracts.INVALID_INPUT;
    }
    var expected: i64 = READY;
    if (!atomic.cas(?initial.state, ?expected, PUBLISHED)) {
        ret contracts.INVALID_STATE;
    }
    value.lock        = mutex.make();
    value.current     = initial;
    value.initialized = true;
    ret contracts.OK;
}

pub fun initialize_vacant_store(value: *Store) contracts.Error {
    if (value == nil || value.initialized || value.current != nil) {
        ret contracts.INVALID_INPUT;
    }
    value.lock        = mutex.make();
    value.initialized = true;
    ret contracts.OK;
}

pub fun publish_store(value: *Store, replacement: *Generation)
    contracts.Error {
    if (value == nil || replacement == nil) { ret contracts.INVALID_INPUT; }
    var expected: i64 = READY;
    if (!atomic.cas(?replacement.state, ?expected, PUBLISHED)) {
        ret contracts.INVALID_STATE;
    }
    mutex.lock(?value.lock);
    if (!value.initialized || value.current != nil) {
        mutex.unlock(?value.lock);
        atomic.store(?replacement.state, READY);
        ret contracts.INVALID_STATE;
    }
    value.current = replacement;
    mutex.unlock(?value.lock);
    ret contracts.OK;
}

pub fun withdraw_store(value: *Store,
    retired: **Generation) contracts.Error {
    if (value == nil || retired == nil) { ret contracts.INVALID_INPUT; }
    @retired = nil;
    mutex.lock(?value.lock);
    if (!value.initialized || value.current == nil ||
        atomic.load(?value.current.state) != PUBLISHED) {
        mutex.unlock(?value.lock);
        ret contracts.INVALID_STATE;
    }
    val previous: *Generation = value.current;
    value.current = nil;
    atomic.store(?previous.state, RETIRED);
    @retired = previous;
    mutex.unlock(?value.lock);
    ret contracts.OK;
}

pub fun acquire(value: *Store, server_name: contracts.Bytes,
    output: *Lease) contracts.Error {
    if (value == nil || output == nil || output.generation != nil ||
        output.identity != nil) { ret contracts.INVALID_INPUT; }
    mutex.lock(?value.lock);
    if (!value.initialized) {
        mutex.unlock(?value.lock);
        ret contracts.INVALID_STATE;
    }
    if (value.current == nil) {
        mutex.unlock(?value.lock);
        ret contracts.UNSUPPORTED;
    }
    if (atomic.load(?value.current.state) != PUBLISHED) {
        mutex.unlock(?value.lock);
        ret contracts.INVALID_STATE;
    }
    val identity: *Identity = select_identity(value.current, server_name);
    if (identity == nil) {
        mutex.unlock(?value.lock);
        ret contracts.UNSUPPORTED;
    }
    val borrows: i64 = atomic.load(?value.current.borrows);
    if (borrows < 0 || borrows == 0x7fffffffffffffff) {
        mutex.unlock(?value.lock);
        ret contracts.INVALID_STATE;
    }
    atomic.fetch_add(?value.current.borrows, 1);
    output.generation = value.current;
    output.identity   = identity;
    mutex.unlock(?value.lock);
    ret contracts.OK;
}

pub fun acquire_client_trust(value: *Store, output: *Lease,
    trust: **cert.TrustStore, required: *bool) contracts.Error {
    if (value == nil || output == nil || trust == nil || required == nil ||
        output.generation != nil || output.identity != nil) {
        ret contracts.INVALID_INPUT;
    }
    @trust    = nil;
    @required = false;
    mutex.lock(?value.lock);
    if (!value.initialized || value.current == nil ||
        atomic.load(?value.current.state) != PUBLISHED) {
        mutex.unlock(?value.lock);
        ret contracts.INVALID_STATE;
    }
    val borrows: i64 = atomic.load(?value.current.borrows);
    if (borrows < 0 || borrows == 0x7fffffffffffffff) {
        mutex.unlock(?value.lock);
        ret contracts.INVALID_STATE;
    }
    atomic.fetch_add(?value.current.borrows, 1);
    output.generation = value.current;
    output.identity   = nil;
    @trust            = value.current.client_trust;
    @required         = value.current.require_client_auth;
    mutex.unlock(?value.lock);
    ret contracts.OK;
}

pub fun release(value: *Lease) contracts.Error {
    if (value == nil || value.generation == nil) { ret contracts.INVALID_INPUT; }
    val previous: i64 = atomic.fetch_sub(?value.generation.borrows, 1);
    if (previous <= 0) {
        atomic.fetch_add(?value.generation.borrows, 1);
        ret contracts.INVALID_STATE;
    }
    value.generation = nil;
    value.identity   = nil;
    ret contracts.OK;
}

pub fun rotate(value: *Store, replacement: *Generation,
    retired: **Generation) contracts.Error {
    if (value == nil || replacement == nil || retired == nil) {
        ret contracts.INVALID_INPUT;
    }
    @retired = nil;
    var expected: i64 = READY;
    if (!atomic.cas(?replacement.state, ?expected, PUBLISHED)) {
        ret contracts.INVALID_STATE;
    }
    mutex.lock(?value.lock);
    if (!value.initialized || value.current == nil ||
        atomic.load(?value.current.state) != PUBLISHED) {
        mutex.unlock(?value.lock);
        atomic.store(?replacement.state, READY);
        ret contracts.INVALID_STATE;
    }
    val previous: *Generation = value.current;
    value.current = replacement;
    atomic.store(?previous.state, RETIRED);
    @retired = previous;
    mutex.unlock(?value.lock);
    ret contracts.OK;
}

pub fun retire_store(value: *Store,
    retired: **Generation) contracts.Error {
    if (value == nil || retired == nil) { ret contracts.INVALID_INPUT; }
    @retired = nil;
    mutex.lock(?value.lock);
    if (!value.initialized || value.current == nil) {
        mutex.unlock(?value.lock);
        ret contracts.INVALID_STATE;
    }
    val previous: *Generation = value.current;
    value.current     = nil;
    value.initialized = false;
    atomic.store(?previous.state, RETIRED);
    @retired = previous;
    mutex.unlock(?value.lock);
    ret contracts.OK;
}

pub fun reclaimable(value: *Generation) bool {
    ret value != nil && atomic.load(?value.state) == RETIRED &&
        atomic.load(?value.borrows) == 0;
}

pub fun clear(value: *Generation) contracts.Error {
    if (value == nil) { ret contracts.INVALID_INPUT; }
    val state: i64 = atomic.load(?value.state);
    if ((state != READY && state != RETIRED) || atomic.load(?value.borrows) != 0) {
        ret contracts.INVALID_STATE;
    }
    @value = empty_generation();
    ret contracts.OK;
}

test cert_credentials__exact_sni_outranks_wildcard_and_fallback {
    var identities: [3]Identity;
    identities[0].server_name = contracts.Bytes{data: "*.example.com"::*u8, len: 13};
    identities[1].server_name = contracts.Bytes{data: "api.example.com"::*u8, len: 15};
    identities[2].server_name = contracts.Bytes{data: nil, len: 0};
    var generation: Generation = empty_generation();
    generation.identities    = ?identities[0];
    generation.identity_len  = 3;
    generation.default_index = 2;
    if (select_identity(?generation,
        contracts.Bytes{data: "api.example.com"::*u8, len: 15}) !=
        ?identities[1] ||
        select_identity(?generation,
        contracts.Bytes{data: "web.example.com"::*u8, len: 15}) !=
        ?identities[0] ||
        select_identity(?generation,
        contracts.Bytes{data: "unknown.test"::*u8, len: 12}) !=
        ?identities[2] ||
        select_identity(?generation,
        contracts.Bytes{data: "192.00.2.1"::*u8, len: 10}) != nil) { ret 1; }
    ret 0;
}

test cert_credentials__leases_keep_retired_generations_alive {
    val certificate_pem_data: *u8 = "-----BEGIN CERTIFICATE-----\nMIIBoDCCAVKgAwIBAgIUcUBdqlz8lEoxcPtVyGLrQN0qDrwwBQYDK2VwMDwxCzAJ\nBgNVBAYTAlVTMRMwEQYDVQQKDApCcmlhciBUZXN0MRgwFgYDVQQDDA9CcmlhciBU\nZXN0IFJvb3QwHhcNMjYwODI4MTEzMjQ1WhcNMzYwODI1MTEzMjQ1WjA8MQswCQYD\nVQQGEwJVUzETMBEGA1UECgwKQnJpYXIgVGVzdDEYMBYGA1UEAwwPQnJpYXIgVGVz\ndCBSb290MCowBQYDK2VwAyEA1zQsVUhtzx5sroC8d3ohC0MJZbzDcOsY4SoyGpTY\ncU2jZjBkMB8GA1UdIwQYMBaAFELfNo+RqDCA56syuG7lnW5tmzn+MBIGA1UdEwEB\n/wQIMAYBAf8CAQAwDgYDVR0PAQH/BAQDAgEGMB0GA1UdDgQWBBRC3zaPkagwgOer\nMrhu5Z1ubZs5/jAFBgMrZXADQQB+WLFqB51+X7MOjRk2ZhOLGMvH4WNx8S8TO5rD\nVHQtXkYNVwGK3eDz3CZdB9uJH2HCTrIISG55wgGR3yg6cHoJ\n-----END CERTIFICATE-----\n"::*u8;
    var certificate_der:      [420]u8;
    var certificate:          cert.Certificate;
    if (load.certificate_pem(contracts.Bytes{data: certificate_pem_data, len: 623},
        contracts.Buffer{data: ?certificate_der[0], capacity: 420},
        ?certificate).error != contracts.OK) { ret 1; }
    var chain:   cert.Chain      = cert.Chain{certificates: ?certificate, len: 1};
    var trust:   cert.TrustStore = cert.TrustStore{anchors: ?certificate, len: 1};
    var key_der: [48]^u8         = [48]^u8{
        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06,
        0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20,
        0xcd, 0x88, 0xe0, 0x5f, 0x4f, 0x49, 0x84, 0xb7,
        0x86, 0x59, 0xb2, 0xfe, 0x29, 0x08, 0x23, 0xc8,
        0xfe, 0xa0, 0xc5, 0xe0, 0x49, 0xf6, 0xf0, 0x83,
        0x8f, 0x7e, 0x4e, 0x9a, 0x8d, 0x4c, 0x9d, 0xed,
    };
    var owner: secret.Allocator = secret.system_allocator();
    var key:   keys.PrivateKey  = keys.empty_private();
    if (load.private_der(contracts.SecretBytes{data: ?key_der[0], len: 48},
        cert.PKCS8_DER, ?owner, ?key) != contracts.OK) { ret 2; }
    var identity: Identity = Identity{
        server_name: contracts.Bytes{data: nil, len: 0},
        chain:       chain,
        private_key: ?key,
    };
    var first:  Generation = empty_generation();
    var second: Generation = empty_generation();
    if (initialize(?first, ?identity, 1, 0, ?trust, true) != contracts.OK ||
        initialize(?second, ?identity, 1, 0, ?trust, true) != contracts.OK) { ret 3; }
    var store: Store = empty_store();
    if (initialize_store(?store, ?first) != contracts.OK) { ret 4; }
    var lease: Lease = empty_lease();
    if (acquire(?store, contracts.Bytes{data: "unknown.test"::*u8, len: 12},
        ?lease) != contracts.OK || lease.generation != ?first) { ret 5; }
    var retired: *Generation = nil;
    if (rotate(?store, ?second, ?retired) != contracts.OK || retired != ?first ||
        reclaimable(?first)) { ret 6; }
    if (release(?lease) != contracts.OK || !reclaimable(?first) ||
        clear(?first) != contracts.OK) { ret 7; }
    var trust_lease:    Lease            = empty_lease();
    var selected_trust: *cert.TrustStore = nil;
    var required:       bool             = false;
    if (acquire_client_trust(?store, ?trust_lease, ?selected_trust, ?required) !=
        contracts.OK || selected_trust != ?trust || !required ||
        release(?trust_lease) != contracts.OK) { ret 8; }
    if (retire_store(?store, ?retired) != contracts.OK || retired != ?second ||
        !reclaimable(?second) || clear(?second) != contracts.OK ||
        keys.destroy_private(?key) != contracts.OK) { ret 9; }
    ret 0;
}

#[testing]
var transient_race_store:    *Store;
#[testing]
var transient_race_lease:    Lease;
#[testing]
var transient_race_entered:  i64;
#[testing]
var transient_race_acquired: i64;
#[testing]
var transient_race_release:  i64;
#[testing]
var transient_race_status:   contracts.Error;

#[testing]
fun hold_transient_lease(context: *u8) {
    atomic.store(?transient_race_entered, 1);
    transient_race_status = acquire(transient_race_store,
        contracts.Bytes{data: nil, len: 0}, ?transient_race_lease);
    atomic.store(?transient_race_acquired, 1);
    for (atomic.load(?transient_race_release) == 0) { atomic.spin_hint(); }
    if (transient_race_status == contracts.OK) {
        transient_race_status = release(?transient_race_lease);
    }
}

test cert_credentials__a_vacant_store_retires_across_an_in_flight_lease_and_publishes_again {
    var first_identity: Identity = no_identity();
    first_identity.server_name = contracts.Bytes{data: nil, len: 0};
    var first: Generation = empty_generation();
    first.identities    = ?first_identity;
    first.identity_len  = 1;
    first.default_index = 0;
    atomic.store(?first.state, READY);
    var second_identity: Identity = no_identity();
    second_identity.server_name = contracts.Bytes{data: nil, len: 0};
    var second: Generation = empty_generation();
    second.identities    = ?second_identity;
    second.identity_len  = 1;
    second.default_index = 0;
    atomic.store(?second.state, READY);
    var store: Store = empty_store();
    if (initialize_vacant_store(?store) != contracts.OK ||
        publish_store(?store, ?first) != contracts.OK) { ret 1; }
    transient_race_store = ?store;
    transient_race_lease = empty_lease();
    atomic.store(?transient_race_entered, 0);
    atomic.store(?transient_race_acquired, 0);
    atomic.store(?transient_race_release, 0);
    transient_race_status = contracts.INVALID_STATE;
    var worker: thread.Thread;
    thread.spawn_with(hold_transient_lease, nil, ?worker);
    if (worker.tid < 0) { ret 2; }
    for (atomic.load(?transient_race_entered) == 0 ||
        atomic.load(?transient_race_acquired) == 0) {
        atomic.spin_hint();
    }
    if (transient_race_status != contracts.OK ||
        transient_race_lease.generation != ?first) {
        atomic.store(?transient_race_release, 1);
        thread.join(?worker);
        ret 3;
    }
    var retired: *Generation = nil;
    if (withdraw_store(?store, ?retired) != contracts.OK || retired != ?first ||
        reclaimable(?first)) {
        atomic.store(?transient_race_release, 1);
        thread.join(?worker);
        ret 4;
    }
    var refused: Lease = empty_lease();
    if (acquire(?store, contracts.Bytes{data: nil, len: 0}, ?refused) !=
        contracts.UNSUPPORTED) {
        atomic.store(?transient_race_release, 1);
        thread.join(?worker);
        ret 5;
    }
    atomic.store(?transient_race_release, 1);
    thread.join(?worker);
    if (transient_race_status != contracts.OK || !reclaimable(?first) ||
        clear(?first) != contracts.OK || publish_store(?store, ?second) !=
        contracts.OK) { ret 6; }
    var replacement: Lease = empty_lease();
    if (acquire(?store, contracts.Bytes{data: nil, len: 0}, ?replacement) !=
        contracts.OK || replacement.generation != ?second ||
        release(?replacement) != contracts.OK ||
        withdraw_store(?store, ?retired) != contracts.OK || retired != ?second ||
        clear(?second) != contracts.OK) { ret 7; }
    ret 0;
}

#[testing]
var allocation_failures: usize;

#[testing]
fun failing_allocate(context: ptr, secret_context: *^u8, length: usize,
    output: **^u8) i64 {
    allocation_failures = allocation_failures + 1;
    @output             = nil;
    ret -1;
}

#[testing]
fun failing_deallocate(context: ptr, secret_context: *^u8, data: *^u8,
    length: usize) i64 {
    ret 0;
}

test cert_credentials__an_allocation_failure_never_publishes_a_partial_key {
    var key_der: [48]^u8 = [48]^u8{
        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06,
        0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20,
        0xeb, 0x3b, 0x8b, 0xa3, 0x21, 0x67, 0x09, 0xef,
        0x29, 0x39, 0x0e, 0x9c, 0x43, 0x84, 0x01, 0xbe,
        0xca, 0x3f, 0xf8, 0x03, 0x7d, 0x60, 0xbb, 0x30,
        0x42, 0x18, 0xc8, 0x8c, 0xd4, 0xb7, 0x9b, 0x72,
    };
    var failing: secret.Allocator = secret.Allocator{context: nil,
        secret_context: nil, allocate_fn: failing_allocate,
        deallocate_fn:  failing_deallocate, initialized: true};
    allocation_failures = 0;
    var key:     keys.PrivateKey = keys.empty_private();
    val refused: contracts.Error = load.private_der(
        contracts.SecretBytes{data: ?key_der[0], len: 48}, cert.PKCS8_DER,
        ?failing, ?key);
    if (refused == contracts.OK)  { ret 1; }
    if (allocation_failures == 0) { ret 2; }
    # nothing was published, so the key is still the empty one
    if (key.algorithm != 0 || key.private_len != 0 || key.encoded_len != 0) {
        ret 3;
    }
    var chain_entry: cert.Certificate = cert.Certificate{der: "x"::*u8,
        der_len: 1};
    var chain: cert.Chain = cert.Chain{certificates: ?chain_entry, len: 1};
    if (key_matches(?chain, ?key)) { ret 4; }
    var identity: Identity;
    identity.server_name = contracts.Bytes{data: nil, len: 0};
    identity.chain       = chain;
    identity.private_key = ?key;
    var generation: Generation = empty_generation();
    # a credential generation is never published from an unusable key
    if (initialize(?generation, ?identity, 1, 0, nil,
        false) == contracts.OK) { ret 5; }
    # the rejected generation published nothing at all
    if (generation.identities != nil || generation.identity_len != 0 ||
        generation.client_trust != nil ||
        generation.default_index != NO_DEFAULT) { ret 6; }

    # the same input succeeds with a working allocator, so the refusal above
    # was the allocator and not the input
    var working:  secret.Allocator = secret.system_allocator();
    var accepted: keys.PrivateKey  = keys.empty_private();
    if (load.private_der(contracts.SecretBytes{data: ?key_der[0], len: 48},
        cert.PKCS8_DER, ?working, ?accepted) != contracts.OK) { ret 7; }
    if (accepted.algorithm != keys.ED25519)              { ret 8; }
    if (keys.destroy_private(?accepted) != contracts.OK) { ret 9; }
    ct.zeroize(?key_der[0], 48);
    ret 0;
}

test cert_credentials__a_tls_alpn_challenge_has_exactly_one_matching_dns_san {
    var valid: [15]u8 = [15]u8{
        0x30, 0x0d, 0x82, 0x0b, 'A', 'p', 'i', '.', 'E', 'x', 'a', 'm', 'p',
        'l', 'e'
    };
    var certificate: x509.Certificate = x509.no_certificate();
    certificate.extensions.subject_alt_name_present = true;
    certificate.extensions.subject_alt_name         = contracts.Bytes{
        data: ?valid[0], len: 15
    };
    if (!tls_alpn_challenge_name_matches(?certificate,
        contracts.Bytes{data: "api.example"::*u8, len: 11}) ||
        tls_alpn_challenge_name_matches(?certificate,
        contracts.Bytes{data: "other.example"::*u8, len: 13})) { ret 1; }

    var wildcard: [13]u8 = [13]u8{
        0x30, 0x0b, 0x82, 0x09, '*', '.', 'e', 'x', 'a', 'm', 'p', 'l', 'e'
    };
    certificate.extensions.subject_alt_name = contracts.Bytes{
        data: ?wildcard[0], len: 13
    };
    if (tls_alpn_challenge_name_matches(?certificate,
        contracts.Bytes{data: "www.example"::*u8, len: 11}) ||
        tls_alpn_challenge_name_matches(?certificate,
        contracts.Bytes{data: "*.example"::*u8, len: 9})) { ret 2; }

    var multiple: [30]u8 = [30]u8{
        0x30, 0x1c, 0x82, 0x0b, 'a', 'p', 'i', '.', 'e', 'x', 'a', 'm', 'p',
        'l', 'e', 0x82, 0x0d, 'o', 't', 'h', 'e', 'r', '.', 'e', 'x', 'a',
        'm', 'p', 'l', 'e'
    };
    certificate.extensions.subject_alt_name = contracts.Bytes{
        data: ?multiple[0], len: 30
    };
    if (tls_alpn_challenge_name_matches(?certificate,
        contracts.Bytes{data: "api.example"::*u8, len: 11})) { ret 3; }
    ret 0;
}

#[testing]
val TLS_ALPN_CERTIFICATE_FIXTURE: str =
    "";

test cert_credentials__challenge_parsing_rejects_wildcard_and_multiple_sans_transactionally {
    var encoded: [382]u8;
    if (base64.decode(TLS_ALPN_CERTIFICATE_FIXTURE::*u8, 512,
        ?encoded[0], 382) != 382) { ret 1; }
    var valid: x509.Certificate;
    if (parse_tls_alpn_challenge(contracts.Bytes{data: ?encoded[0], len: 382},
        ?valid) != contracts.OK ||
        !tls_alpn_challenge_name_matches(?valid,
        contracts.Bytes{data: "api.example"::*u8, len: 11})) { ret 2; }
    # without the challenge parser, the critical acmeIdentifier is refused
    var plain: x509.Certificate;
    if (x509.parse(contracts.Bytes{data: ?encoded[0], len: 382},
        ?plain) == contracts.OK) { ret 6; }

    # replace the sole name with an equal-length wildcard without resigning.
    val wildcard: str   = "*.x.example";
    var i:        usize = 0;
    for (i < 11) {
        encoded[246 + i] = wildcard[i];
        i                = i + 1;
    }
    var rejected: x509.Certificate = x509.no_certificate();
    rejected.version       = 99;
    rejected.not_after     = 123;
    rejected.extensions.ca = true;
    if (parse_tls_alpn_challenge(contracts.Bytes{data: ?encoded[0], len: 382},
        ?rejected) != contracts.INVALID_INPUT || rejected.version != 99 ||
        rejected.not_after != 123 || !rejected.extensions.ca) { ret 3; }

    if (base64.decode(TLS_ALPN_CERTIFICATE_FIXTURE::*u8, 512,
        ?encoded[0], 382) != 382) { ret 4; }
    val two_names: [13]u8 = [13]u8{
        0x82, 0x04, 'a', '.', 'i', 'o',
        0x82, 0x05, 'b', '.', 'd', 'e', 'v'
    };
    i = 0;
    for (i < 13) {
        encoded[244 + i] = two_names[i];
        i                = i + 1;
    }
    if (parse_tls_alpn_challenge(contracts.Bytes{data: ?encoded[0], len: 382},
        ?rejected) != contracts.INVALID_INPUT || rejected.version != 99 ||
        rejected.not_after != 123 || !rejected.extensions.ca) { ret 5; }
    ret 0;
}
