        0xd7, 0x95, 0xf9, 0x37, 0xba, 0xc8, 0x36, 0x37, 0xc3, 0x05, 0x22, 0x0a,
    };
    var certificate: Certificate;
    if (parse(contracts.Bytes{data: ?certificate_der[0], len: 480},
            ?certificate) != contracts.OK || certificate.version != 2 ||
        certificate.signature_algorithm != ED25519 ||
        certificate.public_key.algorithm != keys.ED25519 ||
        certificate.serial.len != 20 || certificate.signature.len != 64 ||
        certificate.extensions.ca ||
        !certificate.extensions.basic_constraints_present ||
        !certificate.extensions.basic_constraints_critical ||
        certificate.extensions.key_usage != KEY_USAGE_DIGITAL_SIGNATURE ||
        certificate.extensions.purposes != PURPOSE_SERVER_AUTH ||
        !certificate.extensions.subject_alt_name_present ||
        !certificate.extensions.subject_key_id_present ||
        !certificate.extensions.authority_key_id_present) { ret 1; }
    certificate_der[9] = 0x04;
    if (parse(contracts.Bytes{data: ?certificate_der[0], len: 480},
            ?certificate) == contracts.OK) { ret 2; }
    ret 0;
}
