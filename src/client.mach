# incremental tls 1.3 client handshake and transport-independent crypto ownership

use crypto.contracts;
use crypto.encoding.keys;
use crypto.group.p256;
use crypto.group.x25519;
use crypto.secret;
use crypto.signature;
use std.crypto.ct;
use std.memory.buffers;
use std.sync.atomic;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.buffer;
use tls.cert;
use tls.cert.credentials;
use tls.cert.load;
use tls.cert.name;
use tls.cert.verify;
use tls.cert.x509;
use tls.clock;
use tls.config;
use tls.engine;
use tls.error;
use tls.handshake;
use tls.handshake.codec;
use tls.handshake.extensions;
use tls.handshake.negotiation;
use tls.memory_range;
use tls.record;
use tls.session;
use tls.signature_scheme;
use tls.test.pool;
use tls.tls13;
use tls.tls13.established;
use tls.tls13.key_schedule;
use tls.tls13.transcript;
use tls.transition;

pub def Level: u8;
pub val INITIAL:     Level = engine.INITIAL;
pub val HANDSHAKE:   Level = engine.HANDSHAKE;
pub val APPLICATION: Level = engine.APPLICATION;

pub def Direction: u8;
pub val SEND:    Direction = engine.SEND;
pub val RECEIVE: Direction = engine.RECEIVE;

pub def EventKind: u8;
pub val CRYPTO:             EventKind = engine.CRYPTO;
pub val TRAFFIC_SECRET:     EventKind = engine.TRAFFIC_SECRET;
pub val PEER_PARAMETERS:    EventKind = engine.PEER_PARAMETERS;
pub val EARLY_DATA:         EventKind = engine.EARLY_DATA;
pub val AUTHENTICATION:     EventKind = engine.AUTHENTICATION;
pub val HANDSHAKE_COMPLETE: EventKind = engine.HANDSHAKE_COMPLETE;
pub val ALERT:              EventKind = engine.ALERT;

pub def Status: u8;
pub val OK:       Status = engine.OK;
pub val MORE:     Status = engine.MORE;
pub val BLOCKED:  Status = engine.BLOCKED;
pub val COMPLETE: Status = engine.COMPLETE;
pub val FAILED:   Status = engine.FAILED;
pub val CLOSED:   Status = engine.CLOSED;

pub val EARLY_NOT_OFFERED:           u8 = engine.EARLY_NOT_OFFERED;
pub val EARLY_ACCEPTED:              u8 = engine.EARLY_ACCEPTED;
pub val EARLY_REJECTED:              u8 = engine.EARLY_REJECTED;
pub val AUTHENTICATED:               u8 = engine.AUTHENTICATED;
pub val AUTHENTICATION_FAILED:       u8 = engine.AUTHENTICATION_FAILED;
pub val RESTART_RETRY:               u8 = 1;
pub val RESTART_VERSION_NEGOTIATION: u8 = 2;

pub val MAX_KEY_SHARE:             usize = 65;
pub val MAX_PUBLIC_KEY:            usize = 512;
pub val MAX_TRUST_ANCHORS:         usize = 256;
pub val MAX_SIGNATURE:             usize = 512;
pub val MAX_SIGNED_CONTEXT:        usize = 64 + 34 + 1 + 48;
pub val QUIC_TRANSPORT_PARAMETERS: u16   = 0x0039;

val EXPECT_SERVER_HELLO:           u8 = 1;
val EXPECT_ENCRYPTED_EXTENSIONS:   u8 = 2;
val EXPECT_CERTIFICATE_OR_REQUEST: u8 = 3;
val EXPECT_CERTIFICATE:            u8 = 4;
val EXPECT_CERTIFICATE_VERIFY:     u8 = 5;
val EXPECT_FINISHED:               u8 = 6;
val ESTABLISHED:                   u8 = 7;
val CLOSING:                       u8 = 8;
val TERMINAL:                      u8 = 9;
val DESTROYED:                     u8 = 10;

pub rec ExtraExtension {
    kind: u16;
    data: contracts.Bytes;
}

# handshake memory comes from the caller's source, one region per use. input and
# output go at the handover; hello and the peer parameters stay until finish
rec Buffers {
    input:           buffer.Region;
    output:          buffer.Region;
    hello:           buffer.Region;
    peer_parameters: buffer.Region;
}

fun no_buffers() Buffers {
    ret Buffers{input: buffer.empty(), output: buffer.empty(),
        hello: buffer.empty(), peer_parameters: buffer.empty()};
}

pub rec Handshake {
    config:          *config.ClientConfig;
    configuration:   config.ClientConfig;
    entropy:         secret.Entropy;
    trust:           cert.TrustStore;
    identity:        credentials.Identity;
    memory:          buffer.Lease;
    buffers:         Buffers;
    output_required: usize;
    hello_required:  usize;
    certificates:    [verify.MAX_CHAIN_DEPTH]cert.Certificate;
    # post-handshake bytes the core could not take yet for want of memory
    leftover:                    bool;
    extra:                       ExtraExtension;
    peer_extension:              u16;
    transcript:                  transcript.Transcript;
    schedule:                    key_schedule.Schedule;
    state:                       u8;
    failure:                     error.Error;
    pending_alert:               record.AlertDescription;
    suite:                       tls13.CipherSuite;
    group:                       tls13.NamedGroup;
    at:                          clock.Moment;
    input_len:                   usize;
    input_read:                  usize;
    hello_len:                   usize;
    output_len:                  usize;
    output_level:                Level;
    output_pending:              bool;
    random:                      [32]u8;
    session_id:                  [32]u8;
    private_key:                 [32]^u8;
    public_key:                  [MAX_KEY_SHARE]u8;
    public_key_len:              usize;
    cookie:                      [258]u8;
    cookie_len:                  usize;
    retry_count:                 u8;
    server_hello_seen:           bool;
    client_auth_requested:       bool;
    client_auth_scheme:          tls13.SignatureScheme;
    authenticated:               bool;
    peer_leaf:                   x509.Certificate;
    peer_key_first:              [MAX_PUBLIC_KEY]u8;
    peer_key_second:             [MAX_PUBLIC_KEY]u8;
    selected_alpn_storage:       [255]u8;
    peer_parameters:             contracts.Bytes;
    selected_alpn:               contracts.Bytes;
    handshake_send_pending:      bool;
    handshake_receive_pending:   bool;
    application_send_pending:    bool;
    application_receive_pending: bool;
    parameters_pending:          bool;
    early_pending:               bool;
    authentication_pending:      bool;
    complete_pending:            bool;
    alert_pending:               bool;
    event_active:                bool;
    event_generation:            u64;
    active_event:                engine.Event;
    secret_generation:           [6]u64;
    transition_owner:            i64;
    receive_record_plaintext:    usize;
    send_record_plaintext:       usize;
    record_limit_offered:        bool;
    record_limit_seen:           bool;
    sessions:                    *session.ClientStore;
    offered_ticket:              session.Ticket;
    offering_psk:                bool;
    psk_accepted:                bool;
    binder_transcript:           transcript.Transcript;
    # the established core, seeded when the handshake queue drains
    delegating: bool;
    core:       established.Established;
}

fun result(status: Status, failure: error.Error, consumed: usize,
    required: usize) engine.Result {
    ret engine.result(status, failure, consumed, required);
}

fun valid_level(level: Level) bool {
    ret engine.valid_level(level);
}

fun next_generation(value: u64) u64 {
    ret engine.next_generation(value);
}

fun write_u16(data: *u8, offset: usize, value: u16) {
    data[offset]     = (value >> 8)::u8;
    data[offset + 1] = value::u8;
}

fun write_u24(data: *u8, offset: usize, value: usize) {
    data[offset]     = (value >> 16)::u8;
    data[offset + 1] = (value >> 8)::u8;
    data[offset + 2] = value::u8;
}

fun read_u16(data: *u8, offset: usize) u16 {
    ret (data[offset]::u16 << 8) | data[offset + 1]::u16;
}

fun copy_bytes(destination: *u8, source: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = source[i];
        i              = i + 1;
    }
}

fun zero_bytes(destination: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = 0;
        i              = i + 1;
    }
}

fun bytes_equal(first: contracts.Bytes, second: contracts.Bytes) bool {
    if (first.len != second.len || (first.len != 0 &&
        (first.data == nil || second.data == nil))) { ret false; }
    var i: usize = 0;
    for (i < first.len) {
        if (first.data[i] != second.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun client_owner_valid(client: *Handshake) bool {
    if (client == nil) { ret false; }
    val address: usize = (?client.state)::usize;
    val offset:  usize = $offset_of(Handshake, state);
    ret address >= offset && memory_range.valid((address - offset)::*u8,
        $size_of(Handshake));
}

fun client_owner_data(client: *Handshake) *u8 {
    if (!client_owner_valid(client)) { ret nil; }
    ret ((?client.state)::usize - $offset_of(Handshake, state))::*u8;
}

fun client_owner_overlaps(client: *Handshake, data: *u8, len: usize) bool {
    if (!client_owner_valid(client) || !memory_range.valid(data, len)) {
        ret true;
    }
    ret memory_range.overlap(client_owner_data(client), $size_of(Handshake), data, len);
}

fun enter(client: *Handshake) bool {
    if (!client_owner_valid(client)) { ret false; }
    ret transition.enter(?client.transition_owner);
}

fun leave(client: *Handshake) {
    transition.leave(?client.transition_owner);
}

fun config_descriptor_valid(value: *config.ClientConfig) bool {
    if (value == nil || !memory_range.valid((?value.server_name)::*u8,
        $size_of(config.ClientConfig))) { ret false; }
    val entropy: *secret.Entropy  = value.entropy;
    val trust:   *cert.TrustStore = value.trust;
    if (entropy == nil || !memory_range.valid((?entropy.context)::*u8,
        $size_of(secret.Entropy)) ||
        trust == nil || !memory_range.valid((?trust.anchors)::*u8,
        $size_of(cert.TrustStore))) { ret false; }
    if (value.client_identity != nil) {
        val identity: *credentials.Identity = value.client_identity;
        if (!memory_range.valid((?identity.server_name)::*u8,
            $size_of(credentials.Identity))) { ret false; }
        if (identity.private_key != nil &&
            !memory_range.valid((?identity.private_key.algorithm)::*u8,
            $size_of(keys.PrivateKey))) { ret false; }
    }
    ret true;
}

fun descriptor_overlaps(value: *config.ClientConfig, data: *u8,
    len: usize) bool {
    if (!config_descriptor_valid(value) || !memory_range.valid(data, len)) {
        ret true;
    }
    if (memory_range.overlap(data, len, (?value.server_name)::*u8,
        $size_of(config.ClientConfig)) ||
        memory_range.overlap(data, len, (?value.entropy.context)::*u8,
        $size_of(secret.Entropy)) ||
        memory_range.overlap(data, len, (?value.trust.anchors)::*u8,
        $size_of(cert.TrustStore))) { ret true; }
    if (value.client_identity != nil) {
        val identity: *credentials.Identity = value.client_identity;
        if (memory_range.overlap(data, len, (?identity.server_name)::*u8,
            $size_of(credentials.Identity))) { ret true; }
        if (identity.private_key != nil &&
            memory_range.overlap(data, len,
            (?identity.private_key.algorithm)::*u8,
            $size_of(keys.PrivateKey))) { ret true; }
    }
    ret false;
}

fun config_borrows_valid(value: *config.ClientConfig,
    extra: ExtraExtension) bool {
    if (!config_descriptor_valid(value)) { ret false; }
    var alpn_bytes:      usize = 0;
    var version_bytes:   usize = 0;
    var suite_bytes:     usize = 0;
    var group_bytes:     usize = 0;
    var signature_bytes: usize = 0;
    var anchor_bytes:    usize = 0;
    if (!memory_range.scaled(value.alpn_len, $size_of(config.ProtocolName),
        ?alpn_bytes) ||
        !memory_range.scaled(value.version_len, $size_of(u16), ?version_bytes) ||
        !memory_range.scaled(value.suite_len, $size_of(tls13.CipherSuite),
        ?suite_bytes) ||
        !memory_range.scaled(value.group_len, $size_of(tls13.NamedGroup),
        ?group_bytes) ||
        !memory_range.scaled(value.signature_len,
        $size_of(tls13.SignatureScheme), ?signature_bytes) ||
        !memory_range.scaled(value.trust.len, $size_of(cert.Certificate),
        ?anchor_bytes) ||
        !memory_range.valid(value.server_name.data, value.server_name.len) ||
        !memory_range.valid(value.alpn::*u8, alpn_bytes) ||
        !memory_range.valid(value.versions::*u8, version_bytes) ||
        !memory_range.valid(value.suites::*u8, suite_bytes) ||
        !memory_range.valid(value.groups::*u8, group_bytes) ||
        !memory_range.valid(value.signatures::*u8, signature_bytes) ||
        !memory_range.valid(value.trust.anchors::*u8, anchor_bytes) ||
        !memory_range.valid(value.entropy.context::*u8,
        value.entropy_context_size) ||
        !memory_range.valid(extra.data.data, extra.data.len) ||
        !name.valid_reference_dns(value.server_name)) { ret false; }
    var i: usize = 0;
    for (i < value.alpn_len) {
        if (!memory_range.valid(value.alpn[i].data, value.alpn[i].len)) {
            ret false;
        }
        i = i + 1;
    }
    i = 0;
    for (i < value.trust.len) {
        if (value.trust.anchors[i].der_len == 0 ||
            !memory_range.valid(value.trust.anchors[i].der,
            value.trust.anchors[i].der_len)) { ret false; }
        i = i + 1;
    }
    if (value.client_identity != nil) {
        val identity:    *credentials.Identity = value.client_identity;
        var chain_bytes: usize                 = 0;
        if (identity.chain.len == 0 ||
            identity.chain.len > verify.MAX_CHAIN_DEPTH ||
            !memory_range.scaled(identity.chain.len,
            $size_of(cert.Certificate), ?chain_bytes) ||
            !memory_range.valid(identity.chain.certificates::*u8,
            chain_bytes)) { ret false; }
        i = 0;
        for (i < identity.chain.len) {
            if (identity.chain.certificates[i].der_len == 0 ||
                !memory_range.valid(identity.chain.certificates[i].der,
                identity.chain.certificates[i].der_len)) { ret false; }
            i = i + 1;
        }
    }
    ret true;
}

fun region_overlaps(region: buffer.Region, data: *u8, len: usize) bool {
    ret region.held && memory_range.overlap(data, len, region.chunk.data, region.chunk.bytes);
}

fun buffers_overlap(client: *Handshake, data: *u8, len: usize) bool {
    if (!memory_range.valid(data, len)) { ret true; }
    ret region_overlaps(client.buffers.input, data, len) ||
        region_overlaps(client.buffers.output, data, len) ||
        region_overlaps(client.buffers.hello, data, len) ||
        region_overlaps(client.buffers.peer_parameters, data, len) ||
        buffer.lease_overlaps(client.memory, data, len);
}

fun borrowed_overlaps(value: *config.ClientConfig, extra: ExtraExtension,
    data: *u8, len: usize, include_local_descriptors: bool,
    include_callback_context: bool) bool {
    if (!config_descriptor_valid(value) || !memory_range.valid(data, len)) {
        ret true;
    }
    if (include_local_descriptors && descriptor_overlaps(value, data, len)) {
        ret true;
    }
    if (!include_local_descriptors && value.client_identity != nil &&
        value.client_identity.private_key != nil &&
        memory_range.overlap(data, len,
        (?value.client_identity.private_key.algorithm)::*u8,
        $size_of(keys.PrivateKey))) { ret true; }
    if (include_callback_context &&
        memory_range.overlap(data, len, value.entropy.context::*u8,
        value.entropy_context_size)) {
        ret true;
    }
    var alpn_bytes:      usize = 0;
    var version_bytes:   usize = 0;
    var suite_bytes:     usize = 0;
    var group_bytes:     usize = 0;
    var signature_bytes: usize = 0;
    var anchor_bytes:    usize = 0;
    if (!memory_range.scaled(value.alpn_len, $size_of(config.ProtocolName),
        ?alpn_bytes) ||
        !memory_range.scaled(value.version_len, $size_of(u16), ?version_bytes) ||
        !memory_range.scaled(value.suite_len, $size_of(tls13.CipherSuite),
        ?suite_bytes) ||
        !memory_range.scaled(value.group_len, $size_of(tls13.NamedGroup),
        ?group_bytes) ||
        !memory_range.scaled(value.signature_len,
        $size_of(tls13.SignatureScheme), ?signature_bytes) ||
        value.trust == nil || !memory_range.scaled(value.trust.len,
        $size_of(cert.Certificate), ?anchor_bytes)) { ret true; }
    if (memory_range.overlap(data, len, value.server_name.data,
        value.server_name.len) ||
        memory_range.overlap(data, len, value.alpn::*u8,
        alpn_bytes) ||
        memory_range.overlap(data, len, value.versions::*u8,
        version_bytes) ||
        memory_range.overlap(data, len, value.suites::*u8,
        suite_bytes) ||
        memory_range.overlap(data, len, value.groups::*u8,
        group_bytes) ||
        memory_range.overlap(data, len, value.signatures::*u8,
        signature_bytes) ||
        memory_range.overlap(data, len, value.trust.anchors::*u8,
        anchor_bytes) ||
        memory_range.overlap(data, len, extra.data.data, extra.data.len)) {
        ret true;
    }
    var i: usize = 0;
    for (i < value.alpn_len) {
        if (memory_range.overlap(data, len, value.alpn[i].data,
            value.alpn[i].len)) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < value.trust.len) {
        if (memory_range.overlap(data, len, value.trust.anchors[i].der,
            value.trust.anchors[i].der_len)) { ret true; }
        i = i + 1;
    }
    if (value.client_identity != nil) {
        val identity:    *credentials.Identity = value.client_identity;
        var chain_bytes: usize                 = 0;
        if (!memory_range.scaled(identity.chain.len,
            $size_of(cert.Certificate), ?chain_bytes)) { ret true; }
        if (memory_range.overlap(data, len, identity.chain.certificates::*u8,
            chain_bytes)) { ret true; }
        i = 0;
        for (i < identity.chain.len) {
            if (memory_range.overlap(data, len,
                identity.chain.certificates[i].der,
                identity.chain.certificates[i].der_len)) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

pub fun aliases_borrowed(client: *Handshake, data: *u8, len: usize) bool {
    if (!client_owner_valid(client) ||
        atomic.load(?client.transition_owner) != 0 ||
        client.config != ?client.configuration ||
        client.state < EXPECT_SERVER_HELLO || client.state >= DESTROYED) {
        ret true;
    }
    ret client_owner_overlaps(client, data, len) ||
        borrowed_overlaps(client.config, client.extra, data, len, true, true);
}

pub fun aliases_configuration(client: *Handshake, data: *u8, len: usize) bool {
    if (!client_owner_valid(client) ||
        atomic.load(?client.transition_owner) != 0 ||
        client.config != ?client.configuration ||
        client.state < EXPECT_SERVER_HELLO || client.state >= DESTROYED) {
        ret true;
    }
    ret borrowed_overlaps(client.config, client.extra, data, len, false, true);
}

fun config_sources_disjoint(client: *Handshake, value: *config.ClientConfig,
    memory: buffer.Lease, extra: ExtraExtension) bool {
    if (!client_owner_valid(client) || !buffer.lease_valid(memory) ||
        borrowed_overlaps(value, extra, client_owner_data(client),
        $size_of(Handshake), true, true) ||
        buffer.lease_overlaps(memory, client_owner_data(client), $size_of(Handshake))) {
        ret false;
    }
    if (value.entropy_context_size != 0 &&
        (client_owner_overlaps(client, value.entropy.context::*u8,
        value.entropy_context_size) ||
        buffer.lease_overlaps(memory, value.entropy.context::*u8,
        value.entropy_context_size) ||
        borrowed_overlaps(value, extra, value.entropy.context::*u8,
        value.entropy_context_size,
        true, false))) {
        ret false;
    }
    ret !borrowed_overlaps(value, extra, memory.source::*u8,
        $size_of(buffers.Source), true, true) &&
        !borrowed_overlaps(value, extra, memory.account::*u8,
        $size_of(buffers.Account), true, true);
}

fun client_identity_valid(value: *config.ClientConfig) bool {
    val identity: *credentials.Identity = value.client_identity;
    if (identity == nil) { ret true; }
    if (identity.private_key == nil || identity.chain.certificates == nil ||
        identity.chain.len == 0 || identity.chain.len > verify.MAX_CHAIN_DEPTH ||
        !credentials.key_matches(?identity.chain, identity.private_key)) { ret false; }
    var total: usize = 0;
    var i:     usize = 0;
    for (i < identity.chain.len) {
        val encoded: cert.Certificate = identity.chain.certificates[i];
        if (encoded.der == nil || encoded.der_len == 0 ||
            encoded.der_len > value.limits.max_chain_bytes - total) { ret false; }
        total = total + encoded.der_len;
        i     = i + 1;
    }
    ret true;
}

fun reserved_client_extension(kind: u16) bool {
    ret kind == extensions.SERVER_NAME || kind == extensions.SUPPORTED_GROUPS ||
        kind == extensions.SIGNATURE_ALGORITHMS ||
        kind == extensions.APPLICATION_LAYER_PROTOCOL ||
        kind == extensions.SUPPORTED_VERSIONS || kind == extensions.KEY_SHARE ||
        kind == extensions.COOKIE || kind == extensions.RECORD_SIZE_LIMIT;
}

fun add_size(total: *usize, amount: usize) bool {
    if (total == nil || amount > ~(0::usize) - @total) { ret false; }
    @total = @total + amount;
    ret true;
}

fun client_hello_requirement(value: *config.ClientConfig,
    extra: ExtraExtension, output: *usize) bool {
    if (output == nil) { ret false; }
    var required: usize = 77 + value.suite_len * 2;
    if (!add_size(?required, 9 + value.server_name.len) ||
        !add_size(?required, 6 + value.group_len * 2) ||
        !add_size(?required, 6 + value.signature_len * 2)) { ret false; }
    var alpn: usize = 6;
    var i:    usize = 0;
    for (i < value.alpn_len) {
        if (!add_size(?alpn, 1 + value.alpn[i].len)) { ret false; }
        i = i + 1;
    }
    if (!add_size(?required, alpn) || !add_size(?required, 7) ||
        !add_size(?required, 10 + MAX_KEY_SHARE) ||
        !add_size(?required, 262)) { ret false; }
    if (extra.kind != 0 &&
        !add_size(?required, 4 + extra.data.len)) { ret false; }
    if (!add_size(?required, 6)) { ret false; }
    if (value.sessions != nil &&
        !add_size(?required, 6 + 4 + 2 + 2 + session.MAX_TICKET_BYTES + 4 + 2 +
        1 + key_schedule.MAX_HASH_SIZE)) { ret false; }
    @output = required;
    ret true;
}

fun client_extension_requirement(value: *config.ClientConfig,
    extra: ExtraExtension, output: *usize) bool {
    if (output == nil) { ret false; }
    var required: usize = 0;
    if (!add_size(?required, 9 + value.server_name.len) ||
        !add_size(?required, 6 + value.group_len * 2) ||
        !add_size(?required, 6 + value.signature_len * 2)) { ret false; }
    var alpn: usize = 6;
    var i:    usize = 0;
    for (i < value.alpn_len) {
        if (!add_size(?alpn, 1 + value.alpn[i].len)) { ret false; }
        i = i + 1;
    }
    if (!add_size(?required, alpn) || !add_size(?required, 7) ||
        !add_size(?required, 10 + MAX_KEY_SHARE) ||
        !add_size(?required, 262) || !add_size(?required, 6)) { ret false; }
    if (extra.kind != 0 &&
        !add_size(?required, 4 + extra.data.len)) { ret false; }
    if (value.sessions != nil &&
        !add_size(?required, 6 + 4 + 2 + 2 + session.MAX_TICKET_BYTES + 4 + 2 +
        1 + key_schedule.MAX_HASH_SIZE)) { ret false; }
    @output = required;
    ret true;
}

fun client_flight_requirement(value: *config.ClientConfig,
    output: *usize) bool {
    if (output == nil) { ret false; }
    var required: usize = 60;
    if (value.client_identity != nil) {
        required = 8 + 8 + MAX_SIGNATURE + 4 + 48;
        var i: usize = 0;
        for (i < value.client_identity.chain.len) {
            if (!add_size(?required,
                5 + value.client_identity.chain.certificates[i].der_len)) {
                ret false;
            }
            i = i + 1;
        }
    }
    @output = required;
    ret true;
}

fun entropy_equal(first: secret.Entropy, second: secret.Entropy) bool {
    ret first.context == second.context &&
        first.secret_context == second.secret_context &&
        first.fill_fn == second.fill_fn && first.initialized == second.initialized;
}

fun limits_equal(first: config.Limits, second: config.Limits) bool {
    ret first.max_receive_record_plaintext ==
        second.max_receive_record_plaintext &&
        first.max_send_record_plaintext == second.max_send_record_plaintext &&
        first.max_peer_handshake_bytes == second.max_peer_handshake_bytes &&
        first.max_client_hello_bytes == second.max_client_hello_bytes &&
        first.max_client_flight_bytes == second.max_client_flight_bytes &&
        first.max_server_flight_bytes == second.max_server_flight_bytes &&
        first.max_chain_bytes == second.max_chain_bytes &&
        first.max_certificate_bytes == second.max_certificate_bytes &&
        first.max_ticket_bytes == second.max_ticket_bytes;
}

fun configuration_equal(first: config.ClientConfig,
    second: config.ClientConfig) bool {
    ret first.server_name.data == second.server_name.data &&
        first.server_name.len == second.server_name.len &&
        first.alpn == second.alpn && first.alpn_len == second.alpn_len &&
        first.trust == second.trust && first.versions == second.versions &&
        first.version_len == second.version_len &&
        first.suites == second.suites && first.suite_len == second.suite_len &&
        first.groups == second.groups && first.group_len == second.group_len &&
        first.signatures == second.signatures &&
        first.signature_len == second.signature_len &&
        first.client_identity == second.client_identity &&
        first.sessions == second.sessions &&
        first.retain_exporter == second.retain_exporter &&
        first.entropy == second.entropy &&
        first.entropy_context_size == second.entropy_context_size &&
        limits_equal(first.limits, second.limits);
}

fun region_equal(first: buffer.Region, second: buffer.Region) bool {
    ret first.chunk.data == second.chunk.data && first.chunk.bytes == second.chunk.bytes &&
        first.held == second.held && first.flying == second.flying;
}

fun buffers_equal(first: Buffers, second: Buffers) bool {
    ret region_equal(first.input, second.input) &&
        region_equal(first.output, second.output) &&
        region_equal(first.hello, second.hello) &&
        region_equal(first.peer_parameters, second.peer_parameters);
}

fun lease_equal(first: buffer.Lease, second: buffer.Lease) bool {
    ret first.source == second.source && first.account == second.account &&
        first.lane == second.lane;
}

fun entropy_fill(client: *Handshake, output: *^u8, length: usize) bool {
    if (!client_owner_valid(client) ||
        !transition.held(?client.transition_owner) ||
        client.config != ?client.configuration || !client.entropy.initialized ||
        client.entropy.fill_fn == nil || output == nil) { ret false; }
    val descriptor:              secret.Entropy          = client.entropy;
    val expected_config:         *config.ClientConfig    = client.config;
    val expected_configuration:  config.ClientConfig     = client.configuration;
    val expected_memory:         buffer.Lease            = client.memory;
    val expected_buffers:        Buffers                 = client.buffers;
    val expected_extra:          ExtraExtension          = client.extra;
    val expected_peer_extension: u16                     = client.peer_extension;
    val expected_state:          u8                      = client.state;
    val expected_failure:        error.Error             = client.failure;
    val expected_pending_alert:  record.AlertDescription = client.pending_alert;
    val expected_input_len:      usize                   = client.input_len;
    val expected_input_read:     usize                   = client.input_read;
    val expected_hello_len:      usize                   = client.hello_len;
    val expected_output_len:     usize                   = client.output_len;
    val expected_output_level:   Level                   = client.output_level;
    val expected_output_pending: bool                    = client.output_pending;
    val expected_event_active:   bool                    = client.event_active;
    val expected_receive_limit:  usize                   = client.receive_record_plaintext;
    val expected_send_limit:     usize                   = client.send_record_plaintext;
    val status:                  i64                     = descriptor.fill_fn(descriptor.context,
        descriptor.secret_context, output, length);
    val valid: bool = transition.held(?client.transition_owner) &&
        client.config == expected_config && client.state == expected_state &&
        entropy_equal(client.entropy, descriptor) &&
        configuration_equal(client.configuration, expected_configuration) &&
        lease_equal(client.memory, expected_memory) &&
        buffers_equal(client.buffers, expected_buffers) &&
        client.extra.kind == expected_extra.kind &&
        client.extra.data.data == expected_extra.data.data &&
        client.extra.data.len == expected_extra.data.len &&
        client.peer_extension == expected_peer_extension &&
        client.failure == expected_failure &&
        client.pending_alert == expected_pending_alert &&
        client.input_len == expected_input_len &&
        client.input_read == expected_input_read &&
        client.hello_len == expected_hello_len &&
        client.output_len == expected_output_len &&
        client.output_level == expected_output_level &&
        client.output_pending == expected_output_pending &&
        client.event_active == expected_event_active &&
        client.receive_record_plaintext == expected_receive_limit &&
        client.send_record_plaintext == expected_send_limit;
    if (!valid || status != 0) {
        ct.zeroize(output, length);
        client.entropy                  = descriptor;
        client.configuration            = expected_configuration;
        client.configuration.entropy    = ?client.entropy;
        client.config                   = ?client.configuration;
        client.memory                   = expected_memory;
        client.buffers                  = expected_buffers;
        client.extra                    = expected_extra;
        client.peer_extension           = expected_peer_extension;
        client.state                    = expected_state;
        client.failure                  = expected_failure;
        client.pending_alert            = expected_pending_alert;
        client.input_len                = expected_input_len;
        client.input_read               = expected_input_read;
        client.hello_len                = expected_hello_len;
        client.output_len               = expected_output_len;
        client.output_level             = expected_output_level;
        client.output_pending           = expected_output_pending;
        client.event_active             = expected_event_active;
        client.receive_record_plaintext = expected_receive_limit;
        client.send_record_plaintext    = expected_send_limit;
        ret false;
    }
    ret true;
}

fun fill_entropy(client: *Handshake, output: *u8, length: usize) bool {
    if (!client_owner_valid(client) || client.config == nil || output == nil) {
        ret false;
    }
    var temporary: [MAX_KEY_SHARE]^u8;
    if (length > MAX_KEY_SHARE || !entropy_fill(client, ?temporary[0], length)) {
        ct.zeroize(?temporary[0], MAX_KEY_SHARE);
        ret false;
    }
    var i: usize = 0;
    for (i < length) {
        output[i] = temporary[i]:>u8;
        i         = i + 1;
    }
    ct.zeroize(?temporary[0], MAX_KEY_SHARE);
    ret true;
}

fun fill_private(client: *Handshake) bool {
    if (!client_owner_valid(client) || client.config == nil) { ret false; }
    ct.zeroize(?client.private_key[0], 32);
    ret entropy_fill(client, ?client.private_key[0], 32);
}

fun config_valid(value: *config.ClientConfig,
    extra: ExtraExtension, peer_extension: u16) bool {
    if (!config_descriptor_valid(value) || !config_borrows_valid(value, extra)) {
        ret false;
    }
    if (value.entropy == nil ||
        !value.entropy.initialized || value.entropy.fill_fn == nil ||
        value.entropy.secret_context != nil ||
        ((value.entropy.context == nil) !=
        (value.entropy_context_size == 0)) ||
        !memory_range.valid(value.entropy.context::*u8,
        value.entropy_context_size) ||
        value.server_name.data == nil ||
        value.server_name.len == 0 || value.server_name.len > 253 ||
        value.trust == nil || value.trust.anchors == nil ||
        value.trust.len == 0 ||
        value.trust.len > MAX_TRUST_ANCHORS || value.alpn == nil ||
        value.alpn_len == 0 || value.alpn_len > 255 ||
        value.versions == nil || value.version_len != 1 ||
        value.suites == nil || value.suite_len == 0 || value.groups == nil ||
        value.group_len == 0 || value.signatures == nil ||
        !config.valid_signature_count(value.signature_len) ||
        value.suite_len > 3 || value.group_len > 2 ||
        value.limits.max_receive_record_plaintext < 63 ||
        value.limits.max_receive_record_plaintext > record.MAX_PLAINTEXT ||
        value.limits.max_send_record_plaintext == 0 ||
        value.limits.max_send_record_plaintext > record.MAX_PLAINTEXT ||
        value.limits.max_peer_handshake_bytes <= handshake.HEADER_SIZE ||
        value.limits.max_peer_handshake_bytes >
        handshake.MAX_BODY_SIZE + handshake.HEADER_SIZE ||
        value.limits.max_client_hello_bytes <= handshake.HEADER_SIZE ||
        value.limits.max_client_hello_bytes >
        handshake.MAX_BODY_SIZE + handshake.HEADER_SIZE ||
        value.limits.max_client_flight_bytes <= handshake.HEADER_SIZE ||
        value.limits.max_client_flight_bytes >
        handshake.MAX_BODY_SIZE + handshake.HEADER_SIZE ||
        !config.certificate_limits_valid(value.limits) ||
        value.limits.max_ticket_bytes == 0 ||
        value.limits.max_ticket_bytes > handshake.MAX_BODY_SIZE ||
        (extra.data.len != 0 && extra.data.data == nil) ||
        extra.data.len > 65531 || (extra.kind == 0 && extra.data.len != 0) ||
        (extra.kind != 0 && reserved_client_extension(extra.kind)) ||
        (peer_extension != 0 && peer_extension != extra.kind)) {
        ret false;
    }
    if (value.versions[0] != tls13.VERSION) { ret false; }
    var i: usize = 0;
    for (i < value.suite_len) {
        if (!codec.valid_cipher_suite(value.suites[i])) { ret false; }
        var prior: usize = 0;
        for (prior < i) {
            if (value.suites[prior] == value.suites[i]) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < value.group_len) {
        if (!codec.valid_named_group(value.groups[i])) { ret false; }
        var prior: usize = 0;
        for (prior < i) {
            if (value.groups[prior] == value.groups[i]) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < value.signature_len) {
        if (!codec.valid_signature_scheme(value.signatures[i])) { ret false; }
        var prior: usize = 0;
        for (prior < i) {
            if (value.signatures[prior] == value.signatures[i]) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    i = 0;
    var alpn_total: usize = 0;
    for (i < value.alpn_len) {
        if (value.alpn[i].data == nil || value.alpn[i].len == 0 ||
            value.alpn[i].len > 255) { ret false; }
        if (value.alpn[i].len > 65535 - alpn_total - 1) { ret false; }
        alpn_total = alpn_total + 1 + value.alpn[i].len;
        var prior: usize = 0;
        for (prior < i) {
            if (bytes_equal(contracts.Bytes{data: value.alpn[prior].data,
                len: value.alpn[prior].len},
                contracts.Bytes{data: value.alpn[i].data,
                len: value.alpn[i].len})) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    if (!client_identity_valid(value)) { ret false; }
    var hello_required:     usize = 0;
    var flight_required:    usize = 0;
    var extension_required: usize = 0;
    if (!client_hello_requirement(value, extra, ?hello_required) ||
        !client_flight_requirement(value, ?flight_required) ||
        !client_extension_requirement(value, extra, ?extension_required) ||
        extension_required > 65535 ||
        hello_required > value.limits.max_client_hello_bytes ||
        flight_required > value.limits.max_client_flight_bytes) { ret false; }
    ret true;
}

# the hello and output one connection needs, known from the configuration
fun output_requirements(value: *config.ClientConfig, extra: ExtraExtension,
    hello: *usize, output: *usize) bool {
    var flight_required: usize = 0;
    if (!client_hello_requirement(value, extra, hello) ||
        !client_flight_requirement(value, ?flight_required)) { ret false; }
    @output = @hello;
    if (flight_required > @output) { @output = flight_required; }
    ret true;
}

fun init_inner(client: *Handshake, configuration: *config.ClientConfig,
    memory: buffer.Lease, extra: ExtraExtension, peer_extension: u16) bool {
    var hello:  usize = 0;
    var output: usize = 0;
    if (!client_owner_valid(client) ||
        (client.state != 0 && client.state != DESTROYED) ||
        !config_valid(configuration, extra, peer_extension) ||
        !output_requirements(configuration, extra, ?hello, ?output) ||
        !config_sources_disjoint(client, configuration, memory, extra)) {
        ret false;
    }
    client.configuration         = configuration[0];
    client.entropy               = configuration.entropy[0];
    client.trust                 = configuration.trust[0];
    client.configuration.entropy = ?client.entropy;
    client.configuration.trust   = ?client.trust;
    if (configuration.client_identity != nil) {
        client.identity                      = configuration.client_identity[0];
        client.configuration.client_identity = ?client.identity;
    }
    or {
        client.identity                      = credentials.no_identity();
        client.configuration.client_identity = nil;
    }
    client.config                      = ?client.configuration;
    client.memory                      = memory;
    client.buffers                     = no_buffers();
    client.hello_required              = hello;
    client.output_required             = output;
    client.leftover                    = false;
    client.extra                       = extra;
    client.peer_extension              = peer_extension;
    client.transcript                  = transcript.empty();
    client.state                       = EXPECT_SERVER_HELLO;
    client.delegating                  = false;
    client.core                        = established.empty();
    client.failure                     = error.OK;
    client.pending_alert               = record.NO_ALERT;
    client.input_len                   = 0;
    client.input_read                  = 0;
    client.hello_len                   = 0;
    client.output_len                  = 0;
    client.output_pending              = false;
    client.public_key_len              = 0;
    client.cookie_len                  = 0;
    client.retry_count                 = 0;
    client.server_hello_seen           = false;
    client.client_auth_requested       = false;
    client.client_auth_scheme          = 0;
    client.authenticated               = false;
    client.peer_leaf                   = x509.no_certificate();
    client.peer_parameters.data        = nil;
    client.peer_parameters.len         = 0;
    client.selected_alpn.data          = nil;
    client.selected_alpn.len           = 0;
    client.handshake_send_pending      = false;
    client.handshake_receive_pending   = false;
    client.application_send_pending    = false;
    client.application_receive_pending = false;
    client.parameters_pending          = false;
    client.early_pending               = false;
    client.authentication_pending      = false;
    client.complete_pending            = false;
    client.alert_pending               = false;
    client.event_active                = false;
    client.receive_record_plaintext    =
        client.config.limits.max_receive_record_plaintext;
    client.send_record_plaintext = client.config.limits.max_send_record_plaintext;
    client.record_limit_offered  = true;
    client.record_limit_seen     = false;
    client.sessions              = configuration.sessions;
    client.offering_psk          = false;
    client.psk_accepted          = false;
    client.binder_transcript     = transcript.empty();
    session.ticket_destroy(?client.offered_ticket);
    client.event_generation = next_generation(client.event_generation);
    ct.zeroize(?client.private_key[0], 32);
    ret true;
}

# memory is the connection's lease. the caller owns its account and keeps it
# open until the handshake is finished or destroyed
pub fun init(client: *Handshake, configuration: *config.ClientConfig,
    memory: buffer.Lease, extra: ExtraExtension, peer_extension: u16) bool {
    if (!enter(client)) { ret false; }
    val initialized: bool = init_inner(client, configuration, memory, extra,
        peer_extension);
    leave(client);
    ret initialized;
}

fun put_extension(output: *u8, offset: usize, kind: u16,
    body: contracts.Bytes) usize {
    write_u16(output, offset, kind);
    write_u16(output, offset + 2, body.len::u16);
    if (body.len != 0) { copy_bytes(?output[offset + 4], body.data, body.len); }
    ret offset + 4 + body.len;
}

fun configured_suite_value(client: *Handshake, suite: tls13.CipherSuite) bool {
    var i: usize = 0;
    for (i < client.config.suite_len) {
        if (client.config.suites[i] == suite) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun offered_group(client: *Handshake, group: tls13.NamedGroup) bool {
    var i: usize = 0;
    for (i < client.config.group_len) {
        if (client.config.groups[i] == group) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun derive_share(client: *Handshake, group: tls13.NamedGroup) bool {
    var attempt: usize = 0;
    for (attempt < 16) {
        if (!fill_private(client)) { ret false; }
        var operation: contracts.Operation;
        if (group == tls13.X25519) {
            operation = x25519.derive_public(
                contracts.SecretBytes{data: ?client.private_key[0], len: 32},
                contracts.Buffer{data: ?client.public_key[0], capacity: MAX_KEY_SHARE});
        }
        or {
            operation = p256.derive_public(
                contracts.SecretBytes{data: ?client.private_key[0], len: 32},
                contracts.Buffer{data: ?client.public_key[0], capacity: MAX_KEY_SHARE});
        }
        if (operation.error == contracts.OK) {
            client.group          = group;
            client.public_key_len = operation.written;
            ret true;
        }
        attempt = attempt + 1;
    }
    ct.zeroize(?client.private_key[0], 32);
    ret false;
}

fun build_extensions(client: *Handshake, output: *u8, capacity: usize) usize {
    val name_len: usize = client.config.server_name.len;
    var required: usize = 4 + 2 + 1 + 2 + name_len;
    required = required + 4 + 2 + client.config.group_len * 2;
    required = required + 4 + 2 + client.config.signature_len * 2;
    var alpn_body: usize = 2;
    var i:         usize = 0;
    for (i < client.config.alpn_len) {
        alpn_body = alpn_body + 1 + client.config.alpn[i].len;
        i         = i + 1;
    }
    required = required + 4 + alpn_body;
    required = required + 4 + 3;
    required = required + 4 + 2 + 2 + 2 + client.public_key_len;
    if (client.record_limit_offered)                              { required = required + 6; }
    if (client.cookie_len != 0)                                   { required = required + 4 + client.cookie_len; }
    if (client.extra.kind != 0)                                   { required = required + 4 + client.extra.data.len; }
    if (output == nil || capacity < required || required > 65535) { ret 0; }

    var offset: usize = 0;
    write_u16(output, offset, extensions.SERVER_NAME);
    write_u16(output, offset + 2, (5 + name_len)::u16);
    write_u16(output, offset + 4, (3 + name_len)::u16);
    output[offset + 6] = 0;
    write_u16(output, offset + 7, name_len::u16);
    copy_bytes(?output[offset + 9], client.config.server_name.data, name_len);
    offset = offset + 9 + name_len;

    write_u16(output, offset, extensions.SUPPORTED_GROUPS);
    write_u16(output, offset + 2, (2 + client.config.group_len * 2)::u16);
    write_u16(output, offset + 4, (client.config.group_len * 2)::u16);
    i = 0;
    for (i < client.config.group_len) {
        write_u16(output, offset + 6 + i * 2, client.config.groups[i]);
        i = i + 1;
    }
    offset = offset + 6 + client.config.group_len * 2;

    write_u16(output, offset, extensions.SIGNATURE_ALGORITHMS);
    write_u16(output, offset + 2, (2 + client.config.signature_len * 2)::u16);
    write_u16(output, offset + 4, (client.config.signature_len * 2)::u16);
    i = 0;
    for (i < client.config.signature_len) {
        write_u16(output, offset + 6 + i * 2, client.config.signatures[i]);
        i = i + 1;
    }
    offset = offset + 6 + client.config.signature_len * 2;

    write_u16(output, offset, extensions.APPLICATION_LAYER_PROTOCOL);
    write_u16(output, offset + 2, alpn_body::u16);
    write_u16(output, offset + 4, (alpn_body - 2)::u16);
    var alpn_offset: usize = offset + 6;
    i = 0;
    for (i < client.config.alpn_len) {
        output[alpn_offset] = client.config.alpn[i].len::u8;
        copy_bytes(?output[alpn_offset + 1], client.config.alpn[i].data,
            client.config.alpn[i].len);
        alpn_offset = alpn_offset + 1 + client.config.alpn[i].len;
        i           = i + 1;
    }
    offset = alpn_offset;

    var versions: [3]u8 = [3]u8{2, 3, 4};
    offset = put_extension(output, offset, extensions.SUPPORTED_VERSIONS,
        contracts.Bytes{data: ?versions[0], len: 3});

    if (client.record_limit_offered) {
        var limit: [2]u8;
        write_u16(?limit[0], 0, (client.receive_record_plaintext + 1)::u16);
        offset = put_extension(output, offset, extensions.RECORD_SIZE_LIMIT,
            contracts.Bytes{data: ?limit[0], len: 2});
    }

    write_u16(output, offset, extensions.KEY_SHARE);
    write_u16(output, offset + 2, (6 + client.public_key_len)::u16);
    write_u16(output, offset + 4, (4 + client.public_key_len)::u16);
    write_u16(output, offset + 6, client.group);
    write_u16(output, offset + 8, client.public_key_len::u16);
    copy_bytes(?output[offset + 10], ?client.public_key[0], client.public_key_len);
    offset = offset + 10 + client.public_key_len;

    if (client.cookie_len != 0) {
        offset = put_extension(output, offset, extensions.COOKIE,
            contracts.Bytes{data: ?client.cookie[0], len: client.cookie_len});
    }
    if (client.extra.kind != 0) {
        offset = put_extension(output, offset, client.extra.kind, client.extra.data);
    }
    if (client.offering_psk) {
        var modes: [2]u8;
        modes[0] = 1;
        modes[1] = 1;
        offset   = put_extension(output, offset,
            extensions.PSK_KEY_EXCHANGE_MODES,
            contracts.Bytes{data: ?modes[0], len: 2});
        val identity_len: usize = client.offered_ticket.identity_len;
        val binder_len:   usize = key_schedule.hash_size(
            key_schedule.algorithm_for_suite(client.offered_ticket.suite));
        val body: usize = 2 + 2 + identity_len + 4 + 2 + 1 + binder_len;
        if (binder_len == 0 || capacity < offset + 4 + body ||
            offset + 4 + body > 65535) { ret 0; }
        write_u16(output, offset, extensions.PRE_SHARED_KEY);
        write_u16(output, offset + 2, body::u16);
        write_u16(output, offset + 4, (2 + identity_len + 4)::u16);
        write_u16(output, offset + 6, identity_len::u16);
        copy_bytes(?output[offset + 8], ?client.offered_ticket.identity[0],
            identity_len);
        var age_offset: usize = offset + 8 + identity_len;
        var i:          usize = 0;
        for (i < 4) {
            output[age_offset + i] = 0;
            i                      = i + 1;
        }
        var binder_offset: usize = age_offset + 4;
        write_u16(output, binder_offset, (1 + binder_len)::u16);
        output[binder_offset + 2] = binder_len::u8;
        i                         = 0;
        for (i < binder_len) {
            output[binder_offset + 3 + i] = 0;
            i                             = i + 1;
        }
        offset = binder_offset + 3 + binder_len;
    }
    ret offset;
}

# replace the placeholder binder in the encoded hello with the real one
fun patch_binder(client: *Handshake, encoded_length: usize) error.Error {
    if (!client.offering_psk) { ret error.OK; }
    val size: usize = key_schedule.hash_size(client.schedule.algorithm);
    if (size == 0) { ret error.INTERNAL_ERROR; }
    val encoded: contracts.Bytes = contracts.Bytes{data: client.buffers.output.chunk.data,
        len: encoded_length};
    var prefix:  contracts.Bytes;
    var failure: error.Error = codec.client_hello_binder_prefix(encoded,
        client.retry_count != 0, ?prefix);
    if (failure != error.OK)                     { ret failure; }
    if (prefix.len + 3 + size != encoded_length) { ret error.INTERNAL_ERROR; }
    transcript.destroy(?client.binder_transcript);
    client.binder_transcript = transcript.empty();
    failure                  = transcript.init_for_suite(?client.binder_transcript,
        client.offered_ticket.suite);
    if (failure == error.OK) {
        failure = transcript.update_binder_client_hello(
            ?client.binder_transcript, encoded, client.retry_count != 0);
    }
    var hash: [48]u8;
    if (failure == error.OK) {
        failure = transcript.snapshot(?client.binder_transcript,
            contracts.Buffer{data: ?hash[0], capacity: 48});
    }
    var binder: [48]u8;
    if (failure == error.OK) {
        failure = key_schedule.binder(?client.schedule, true,
            contracts.Bytes{data: ?hash[0], len: size},
            contracts.Buffer{data: ?binder[0], capacity: 48});
    }
    transcript.destroy(?client.binder_transcript);
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    if (failure != error.OK) {
        i = 0;
        for (i < 48) {
            binder[i] = 0;
            i         = i + 1;
        }
        ret failure;
    }
    copy_bytes(?client.buffers.output.chunk.data[prefix.len + 3], ?binder[0], size);
    i = 0;
    for (i < 48) {
        binder[i] = 0;
        i         = i + 1;
    }
    ret error.OK;
}

fun build_client_hello(client: *Handshake, after_retry: bool) error.Error {
    val extension_len: usize = build_extensions(client, client.buffers.hello.chunk.data,
        client.buffers.hello.chunk.bytes);
    if (extension_len == 0) { ret error.RESOURCE_LIMIT; }
    var suites: [6]u8;
    var i:      usize = 0;
    for (i < client.config.suite_len) {
        write_u16(?suites[0], i * 2, client.config.suites[i]);
        i = i + 1;
    }
    var compression: [1]u8;
    var hello:       codec.ClientHello;
    hello.legacy_version      = tls13.LEGACY_VERSION;
    hello.random              = contracts.Bytes{data: ?client.random[0], len: 32};
    hello.legacy_session_id   = contracts.Bytes{data: ?client.session_id[0], len: 32};
    hello.cipher_suites       = contracts.Bytes{data: ?suites[0], len: client.config.suite_len * 2};
    hello.compression_methods = contracts.Bytes{data: ?compression[0], len: 1};
    hello.extensions          = extensions.list(client.buffers.hello.chunk.data, extension_len,
        extensions.CLIENT_HELLO);
    hello.after_retry = after_retry;
    val encoded: handshake.Progress = codec.encode_client_hello(?hello,
        contracts.Buffer{data: client.buffers.output.chunk.data,
        capacity: client.buffers.output.chunk.bytes});
    if (encoded.status != handshake.COMPLETE) {
        if (encoded.error != error.OK) { ret encoded.error; }
        ret error.RESOURCE_LIMIT;
    }
    if (encoded.produced > client.buffers.hello.chunk.bytes) { ret error.RESOURCE_LIMIT; }
    val patched: error.Error = patch_binder(client, encoded.produced);
    if (patched != error.OK) { ret patched; }
    copy_bytes(client.buffers.hello.chunk.data, client.buffers.output.chunk.data, encoded.produced);
    client.hello_len      = encoded.produced;
    client.output_len     = encoded.produced;
    client.output_level   = INITIAL;
    client.output_pending = true;
    ret error.OK;
}

fun fail(client: *Handshake, failure: error.Error,
    alert: record.AlertDescription) engine.Result {
    if (client != nil && client.state != DESTROYED) {
        client.failure                     = failure;
        client.pending_alert               = alert;
        client.output_pending              = false;
        client.output_len                  = 0;
        client.handshake_send_pending      = false;
        client.handshake_receive_pending   = false;
        client.application_send_pending    = false;
        client.application_receive_pending = false;
        client.parameters_pending          = false;
        client.early_pending               = false;
        client.authentication_pending      = false;
        client.complete_pending            = false;
        client.alert_pending               = alert != record.NO_ALERT;
        client.state                       = TERMINAL;
    }
    ret result(FAILED, failure, 0, 0);
}

fun start_inner(client: *Handshake, at: clock.Moment) engine.Result {
    if (!client_owner_valid(client) ||
        client.config == nil || client.state != EXPECT_SERVER_HELLO ||
        client.output_pending || client.hello_len != 0) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    val hello: engine.Result = reserved(client, buffer.reserve(client.memory,
        ?client.buffers.hello, client.hello_required, 0));
    if (hello.status != OK) { ret hello; }
    val output: engine.Result = reserved(client, buffer.reserve(client.memory,
        ?client.buffers.output, client.output_required, 0));
    if (output.status != OK) { ret output; }
    client.at = at;
    if (client.sessions != nil &&
        session.client_store_take(client.sessions, client.config.server_name,
        at.monotonic, ?client.offered_ticket) &&
        client.offered_ticket.valid) {
        if (configured_suite_value(client, client.offered_ticket.suite) &&
            key_schedule.init(?client.schedule, client.offered_ticket.suite,
            contracts.SecretBytes{data: ?client.offered_ticket.secret[0],
            len: client.offered_ticket.secret_len}) == error.OK) {
            client.offering_psk = true;
        }
        or {
            session.ticket_destroy(?client.offered_ticket);
        }
    }
    if (!fill_entropy(client, ?client.random[0], 32) ||
        !fill_entropy(client, ?client.session_id[0], 32) ||
        !derive_share(client, client.config.groups[0])) {
        ret fail(client, error.INTERNAL_ERROR, record.INTERNAL_ERROR_ALERT);
    }
    val failure: error.Error = build_client_hello(client, false);
    if (failure != error.OK) { ret fail(client, failure, record.INTERNAL_ERROR_ALERT); }
    ret result(OK, error.OK, 0, client.output_len);
}

pub fun start(client: *Handshake, at: clock.Moment) engine.Result {
    if (!enter(client)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    val started: engine.Result = start_inner(client, at);
    leave(client);
    ret started;
}

fun restart_inner(client: *Handshake, reason: u8) engine.Result {
    if (!client_owner_valid(client) ||
        client.config == nil || client.state != EXPECT_SERVER_HELLO ||
        client.server_hello_seen || client.event_active || client.hello_len == 0 ||
        (reason != RESTART_RETRY && reason != RESTART_VERSION_NEGOTIATION)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    client.input_len  = 0;
    client.input_read = 0;
    if (!client.output_pending) {
        copy_bytes(client.buffers.output.chunk.data, client.buffers.hello.chunk.data, client.hello_len);
        client.output_len     = client.hello_len;
        client.output_level   = INITIAL;
        client.output_pending = true;
    }
    ret result(OK, error.OK, 0, client.output_len);
}

pub fun restart(client: *Handshake, reason: u8) engine.Result {
    if (!enter(client)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    val restarted: engine.Result = restart_inner(client, reason);
    leave(client);
    ret restarted;
}

fun decode_own_hello(client: *Handshake, output: *codec.ClientHello) error.Error {
    var message: handshake.Message;
    val parsed:  handshake.Progress = handshake.parse(client.buffers.hello.chunk.data,
        client.hello_len,
        client.config.limits.max_client_hello_bytes - handshake.HEADER_SIZE,
        ?message);
    if (parsed.status != handshake.COMPLETE || parsed.consumed != client.hello_len) {
        ret error.INTERNAL_ERROR;
    }
    ret codec.decode_client_hello(?message, client.retry_count != 0, output);
}

fun selected_share(server: *codec.ServerHello, group: *tls13.NamedGroup,
    public_key: *contracts.Bytes) bool {
    var extension: extensions.Extension;
    if (!extensions.find(server.extensions, extensions.KEY_SHARE, ?extension) ||
        extension.len < 4) { ret false; }
    val length: usize = read_u16(extension.data, 2)::usize;
    if (length != extension.len - 4) { ret false; }
    group[0]      = read_u16(extension.data, 0);
    public_key[0] = contracts.Bytes{data: ?extension.data[4], len: length};
    ret true;
}

fun shared_secret(client: *Handshake, peer: contracts.Bytes,
    output: *^u8) bool {
    var operation: contracts.Operation;
    if (client.group == tls13.X25519) {
        operation = x25519.agree(
            contracts.SecretBytes{data: ?client.private_key[0], len: 32}, peer,
            contracts.SecretBuffer{data: output, capacity: 32});
    }
    or {
        operation = p256.agree(
            contracts.SecretBytes{data: ?client.private_key[0], len: 32}, peer,
            contracts.SecretBuffer{data: output, capacity: 32});
    }
    ret operation.error == contracts.OK && operation.written == 32;
}

fun handle_retry(client: *Handshake, frame: contracts.Bytes,
    server: *codec.ServerHello, own: *codec.ClientHello) error.Error {
    if (client.retry_count != 0 || client.server_hello_seen) {
        ret error.UNEXPECTED_MESSAGE;
    }
    val selected: error.Error = negotiation.validate_server_selection(server, own);
    if (selected != error.OK) { ret selected; }
    var share: extensions.Extension;
    if (!extensions.find(server.extensions, extensions.KEY_SHARE, ?share) ||
        share.len != 2) { ret error.ILLEGAL_PARAMETER; }
    val group: tls13.NamedGroup = read_u16(share.data, 0);
    if (!offered_group(client, group) || group == client.group) {
        ret error.ILLEGAL_PARAMETER;
    }
    var cookie: extensions.Extension;
    client.cookie_len = 0;
    if (extensions.find(server.extensions, extensions.COOKIE, ?cookie)) {
        if (cookie.len > 258) { ret error.RESOURCE_LIMIT; }
        copy_bytes(?client.cookie[0], cookie.data, cookie.len);
        client.cookie_len = cookie.len;
    }
    var failure: error.Error = transcript.init_for_suite(?client.transcript,
        server.cipher_suite);
    if (failure == error.OK) {
        failure = transcript.update_frame(?client.transcript,
            contracts.Bytes{data: client.buffers.hello.chunk.data, len: client.hello_len});
    }
    if (failure == error.OK) {
        failure = transcript.rewrite_for_retry(?client.transcript, frame);
    }
    if (failure != error.OK) { ret failure; }
    client.suite       = server.cipher_suite;
    client.retry_count = 1;
    if (!derive_share(client, group)) { ret error.INTERNAL_ERROR; }
    failure = build_client_hello(client, true);
    if (failure == error.OK) {
        failure = transcript.update_frame(?client.transcript,
            contracts.Bytes{data: client.buffers.hello.chunk.data, len: client.hello_len});
    }
    ret failure;
}

fun handle_server_hello(client: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var server:  codec.ServerHello;
    var failure: error.Error = codec.decode_server_hello(message, ?server);
    if (failure != error.OK) { ret failure; }
    var own: codec.ClientHello;
    failure = decode_own_hello(client, ?own);
    if (failure != error.OK) { ret failure; }
    if (server.retry)        { ret handle_retry(client, frame, ?server, ?own); }
    failure = negotiation.validate_server_selection(?server, ?own);
    if (failure != error.OK || (client.retry_count != 0 && server.cipher_suite != client.suite)) {
        if (failure != error.OK) { ret failure; }
        ret error.ILLEGAL_PARAMETER;
    }
    var group: tls13.NamedGroup;
    var peer:  contracts.Bytes;
    if (!selected_share(?server, ?group, ?peer) || group != client.group) {
        ret error.ILLEGAL_PARAMETER;
    }
    if (client.retry_count == 0) {
        failure = transcript.init_for_suite(?client.transcript, server.cipher_suite);
        if (failure == error.OK) {
            failure = transcript.update_frame(?client.transcript,
                contracts.Bytes{data: client.buffers.hello.chunk.data, len: client.hello_len});
        }
    }
    if (failure == error.OK) { failure = transcript.update_frame(?client.transcript, frame); }
    var hash: [48]u8;
    if (failure == error.OK) {
        failure = transcript.snapshot(?client.transcript,
            contracts.Buffer{data: ?hash[0], capacity: 48});
    }
    if (failure != error.OK) { ret failure; }
    var selected_psk: extensions.Extension;
    val psk_selected: bool = extensions.find(server.extensions,
        extensions.PRE_SHARED_KEY, ?selected_psk);
    if (psk_selected) {
        if (!client.offering_psk || selected_psk.len != 2 ||
            read_u16(selected_psk.data, 0) != 0 ||
            server.cipher_suite != client.offered_ticket.suite) {
            ret error.ILLEGAL_PARAMETER;
        }
        client.psk_accepted = true;
    }
    or (client.offering_psk) {
        # the offer was declined, so the resumption schedule is discarded
        key_schedule.destroy(?client.schedule);
        session.ticket_destroy(?client.offered_ticket);
        client.offering_psk = false;
    }
    var shared: [32]^u8;
    if (!shared_secret(client, peer, ?shared[0])) {
        ct.zeroize(?shared[0], 32);
        ret error.HANDSHAKE_FAILURE;
    }
    if (!client.psk_accepted) {
        failure = key_schedule.init(?client.schedule, server.cipher_suite,
            contracts.SecretBytes{data: nil, len: 0});
    }
    if (failure == error.OK) {
        failure = key_schedule.advance_handshake(?client.schedule,
            contracts.SecretBytes{data: ?shared[0], len: 32},
            contracts.Bytes{data: ?hash[0],
            len: key_schedule.hash_size(client.schedule.algorithm)});
    }
    ct.zeroize(?shared[0], 32);
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    ct.zeroize(?client.private_key[0], 32);
    if (failure != error.OK) { ret failure; }
    client.suite                     = server.cipher_suite;
    client.server_hello_seen         = true;
    client.handshake_send_pending    = true;
    client.handshake_receive_pending = true;
    client.state                     = EXPECT_ENCRYPTED_EXTENSIONS;
    ret error.OK;
}

fun alert_for(failure: error.Error) record.AlertDescription {
    ret engine.alert_for(failure);
}

fun alpn_offered(client: *Handshake, value: contracts.Bytes) bool {
    var i: usize = 0;
    for (i < client.config.alpn_len) {
        if (client.config.alpn[i].len == value.len &&
            bytes_equal(contracts.Bytes{data: client.config.alpn[i].data,
            len: client.config.alpn[i].len}, value)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun handle_encrypted_extensions(client: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var encrypted: codec.EncryptedExtensions;
    var failure:   error.Error = codec.decode_encrypted_extensions(message, ?encrypted);
    if (failure != error.OK) { ret failure; }
    var iterator:          extensions.Iterator = extensions.iterator(encrypted.extensions);
    var item:              extensions.Extension;
    var alpn_seen:         bool                = false;
    var peer_seen:         bool                = false;
    var record_limit_seen: bool                = false;
    for (true) {
        val status: extensions.NextStatus = extensions.next(?iterator, ?item);
        if (status == extensions.NEXT_DONE) { brk; }
        if (status != extensions.NEXT_ITEM) { ret error.DECODE_ERROR; }
        if (item.kind == extensions.APPLICATION_LAYER_PROTOCOL) {
            val length:   usize           = item.data[2]::usize;
            val selected: contracts.Bytes = contracts.Bytes{
                data: ?item.data[3], len: length
            };
            if (item.len != 3 + length || !alpn_offered(client, selected)) {
                ret error.NO_APPLICATION_PROTOCOL;
            }
            copy_bytes(?client.selected_alpn_storage[0], selected.data, selected.len);
            client.selected_alpn = contracts.Bytes{
                data: ?client.selected_alpn_storage[0], len: selected.len
            };
            alpn_seen = true;
        }
        or (item.kind == extensions.SUPPORTED_GROUPS) {
            # the server advertises its complete preference set here
        }
        or (item.kind == extensions.RECORD_SIZE_LIMIT &&
            client.record_limit_offered) {
            val limit: usize = read_u16(item.data, 0)::usize - 1;
            if (limit < client.send_record_plaintext) {
                client.send_record_plaintext = limit;
            }
            record_limit_seen = true;
        }
        or (client.peer_extension != 0 && item.kind == client.peer_extension) {
            if (item.len > client.buffers.peer_parameters.chunk.bytes) {
                ret error.RESOURCE_LIMIT;
            }
            copy_bytes(client.buffers.peer_parameters.chunk.data, item.data, item.len);
            client.peer_parameters = contracts.Bytes{
                data: client.buffers.peer_parameters.chunk.data, len: item.len
            };
            client.parameters_pending = true;
            peer_seen                 = true;
        }
        or (item.kind != extensions.SERVER_NAME) {
            ret error.UNSUPPORTED_EXTENSION;
        }
    }
    if (!alpn_seen)                               { ret error.NO_APPLICATION_PROTOCOL; }
    if (client.peer_extension != 0 && !peer_seen) { ret error.MISSING_EXTENSION; }
    client.record_limit_seen = record_limit_seen;
    failure                  = transcript.update_frame(?client.transcript, frame);
    if (failure != error.OK) { ret failure; }
    client.early_pending = true;
    if (client.psk_accepted) {
        client.authenticated = true;
        client.state         = EXPECT_FINISHED;
    }
    or {
        client.state = EXPECT_CERTIFICATE_OR_REQUEST;
    }
    ret error.OK;
}

fun signature_requested(request: *codec.CertificateRequest,
    scheme: tls13.SignatureScheme) bool {
    var offered: extensions.Extension;
    if (!extensions.find(request.extensions, extensions.SIGNATURE_ALGORITHMS,
        ?offered) || offered.len < 4) { ret false; }
    var offset: usize = 2;
    for (offset + 1 < offered.len) {
        if (read_u16(offered.data, offset) == scheme) { ret true; }
        offset = offset + 2;
    }
    ret false;
}

fun configured_signature(client: *Handshake, scheme: tls13.SignatureScheme) bool {
    var i: usize = 0;
    for (i < client.config.signature_len) {
        if (client.config.signatures[i] == scheme) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun select_client_signature(client: *Handshake,
    request: *codec.CertificateRequest) tls13.SignatureScheme {
    if (client.config.client_identity == nil ||
        client.config.client_identity.private_key == nil) { ret 0; }
    val algorithm: keys.Algorithm = client.config.client_identity.private_key.algorithm;
    var i:         usize          = 0;
    for (i < client.config.signature_len) {
        val scheme: tls13.SignatureScheme = client.config.signatures[i];
        if (signature_scheme.can_sign(scheme, algorithm) &&
            signature_requested(request, scheme)) { ret scheme; }
        i = i + 1;
    }
    ret 0;
}

fun handle_certificate_request(client: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var request: codec.CertificateRequest;
    var failure: error.Error = codec.decode_certificate_request(message, ?request);
    if (failure != error.OK)      { ret failure; }
    if (request.context.len != 0) { ret error.ILLEGAL_PARAMETER; }
    client.client_auth_requested = true;
    client.client_auth_scheme    = select_client_signature(client, ?request);
    failure                      = transcript.update_frame(?client.transcript, frame);
    if (failure == error.OK) { client.state = EXPECT_CERTIFICATE; }
    ret failure;
}

fun retain_peer_key(client: *Handshake) bool {
    val first:  contracts.Bytes = client.peer_leaf.public_key.first;
    val second: contracts.Bytes = client.peer_leaf.public_key.second;
    if (first.data == nil || first.len == 0 || first.len > MAX_PUBLIC_KEY ||
        second.len > MAX_PUBLIC_KEY || (second.len != 0 && second.data == nil)) {
        ret false;
    }
    copy_bytes(?client.peer_key_first[0], first.data, first.len);
    if (second.len != 0) {
        copy_bytes(?client.peer_key_second[0], second.data, second.len);
    }
    client.peer_leaf.public_key.encoded.data = nil;
    client.peer_leaf.public_key.encoded.len  = 0;
    client.peer_leaf.public_key.first        = contracts.Bytes{
        data: ?client.peer_key_first[0], len: first.len
    };
    client.peer_leaf.public_key.second = contracts.Bytes{
        data: ?client.peer_key_second[0], len: second.len
    };
    ret true;
}

fun handle_certificate(client: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var certificate_message: codec.CertificateMessage;
    var failure:             error.Error = codec.decode_certificate(message, false,
        ?certificate_message);
    if (failure != error.OK) { ret failure; }
    if (certificate_message.context.len != 0 || certificate_message.count == 0 ||
        certificate_message.count > verify.MAX_CHAIN_DEPTH ||
        certificate_message.count > verify.MAX_CHAIN_DEPTH ||
        certificate_message.entries.len > client.config.limits.max_chain_bytes) {
        ret error.BAD_CERTIFICATE;
    }
    var iterator: codec.CertificateIterator = codec.certificate_iterator(
        ?certificate_message);
    var entry: codec.CertificateEntry;
    var count: usize = 0;
    var total: usize = 0;
    for (true) {
        val status: extensions.NextStatus = codec.next_certificate(?iterator, ?entry);
        if (status == extensions.NEXT_DONE) { brk; }
        if (status != extensions.NEXT_ITEM || count >= verify.MAX_CHAIN_DEPTH ||
            entry.certificate.len > client.config.limits.max_certificate_bytes ||
            entry.certificate.len > client.config.limits.max_chain_bytes - total) {
            ret error.BAD_CERTIFICATE;
        }
        client.certificates[count].der     = entry.certificate.data;
        client.certificates[count].der_len = entry.certificate.len;
        total                              = total + entry.certificate.len;
        count                              = count + 1;
    }
    if (count != certificate_message.count || count == 0) { ret error.BAD_CERTIFICATE; }
    val chain: cert.Chain = cert.Chain{certificates: ?client.certificates[0],
        len: count};
    val name:    contracts.Bytes = client.config.server_name;
    var options: verify.Options;
    options.identity             = name;
    options.purpose              = verify.SERVER_AUTH;
    options.now                  = client.at.wall;
    options.max_depth            = verify.MAX_CHAIN_DEPTH;
    options.max_signature_checks = verify.MAX_SIGNATURE_CHECKS;
    failure                      = verify.chain(client.config.trust, ?chain, ?options);
    if (failure != error.OK) { ret failure; }
    if (x509.parse(contracts.Bytes{data: client.certificates[0].der,
        len: client.certificates[0].der_len}, ?client.peer_leaf) != contracts.OK ||
        !retain_peer_key(client)) {
        ret error.BAD_CERTIFICATE;
    }
    failure = transcript.update_frame(?client.transcript, frame);
    if (failure == error.OK) { client.state = EXPECT_CERTIFICATE_VERIFY; }
    ret failure;
}

fun certificate_verify_input(client: *Handshake, server: bool,
    output: *u8) error.Error {
    var hash:    [48]u8;
    val size:    usize       = key_schedule.hash_size(client.schedule.algorithm);
    val failure: error.Error = transcript.snapshot(?client.transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48});
    if (failure != error.OK) { ret failure; }
    var i: usize = 0;
    for (i < 64) {
        output[i] = 0x20;
        i         = i + 1;
    }
    var context: *u8 = "TLS 1.3, client CertificateVerify"::*u8;
    if (server) { context = "TLS 1.3, server CertificateVerify"::*u8; }
    copy_bytes(?output[64], context, 33);
    output[97] = 0;
    copy_bytes(?output[98], ?hash[0], size);
    i = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    ret error.OK;
}

fun verify_peer_signature(client: *Handshake, value: *codec.CertificateVerify) error.Error {
    if (!configured_signature(client, value.scheme)) { ret error.ILLEGAL_PARAMETER; }
    var signed:  [MAX_SIGNED_CONTEXT]u8;
    var failure: error.Error = certificate_verify_input(client, true, ?signed[0]);
    if (failure != error.OK) { ret failure; }
    val message: contracts.Bytes = contracts.Bytes{data: ?signed[0],
        len: 98 + key_schedule.hash_size(client.schedule.algorithm)};
    val status: contracts.Error = signature_scheme.verify(value.scheme,
        ?client.peer_leaf.public_key, message, value.signature);
    var i: usize = 0;
    for (i < MAX_SIGNED_CONTEXT) {
        signed[i] = 0;
        i         = i + 1;
    }
    if (status == contracts.UNSUPPORTED) { ret error.UNSUPPORTED_ALGORITHM; }
    if (status != contracts.OK)          { ret error.DECRYPT_ERROR; }
    ret error.OK;
}

fun handle_certificate_verify(client: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var value:   codec.CertificateVerify;
    var failure: error.Error = codec.decode_certificate_verify(message, ?value);
    if (failure == error.OK) { failure = verify_peer_signature(client, ?value); }
    if (failure == error.OK) { failure = transcript.update_frame(?client.transcript, frame); }
    if (failure == error.OK) {
        client.authenticated = true;
        client.state         = EXPECT_FINISHED;
    }
    ret failure;
}

fun append_client_certificate(client: *Handshake, offset: usize) usize {
    val identity:       *credentials.Identity = client.config.client_identity;
    var entries_length: usize                 = 0;
    if (identity != nil && client.client_auth_scheme != 0) {
        var i: usize = 0;
        for (i < identity.chain.len) {
            val encoded_length: usize = identity.chain.certificates[i].der_len;
            if (encoded_length > client.buffers.output.chunk.bytes ||
                entries_length > client.buffers.output.chunk.bytes - encoded_length ||
                entries_length + encoded_length > client.buffers.output.chunk.bytes - 5) {
                ret 0;
            }
            entries_length = entries_length + 5 + encoded_length;
            i              = i + 1;
        }
    }
    if (offset > client.buffers.output.chunk.bytes ||
        entries_length > client.buffers.output.chunk.bytes - 8) { ret 0; }
    val required: usize = 8 + entries_length;
    if (required > client.buffers.output.chunk.bytes - offset) { ret 0; }
    client.buffers.output.chunk.data[offset] = handshake.CERTIFICATE;
    write_u24(client.buffers.output.chunk.data, offset + 1, 4 + entries_length);
    client.buffers.output.chunk.data[offset + 4] = 0;
    write_u24(client.buffers.output.chunk.data, offset + 5, entries_length);
    var cursor: usize = offset + 8;
    if (entries_length != 0) {
        var i: usize = 0;
        for (i < identity.chain.len) {
            val encoded: cert.Certificate = identity.chain.certificates[i];
            write_u24(client.buffers.output.chunk.data, cursor, encoded.der_len);
            copy_bytes(?client.buffers.output.chunk.data[cursor + 3], encoded.der, encoded.der_len);
            write_u16(client.buffers.output.chunk.data, cursor + 3 + encoded.der_len, 0);
            cursor = cursor + 5 + encoded.der_len;
            i      = i + 1;
        }
    }
    ret cursor;
}

fun sign_client(client: *Handshake, message: contracts.Bytes,
    output: contracts.Buffer) contracts.Operation {
    val private_key: *keys.PrivateKey = client.config.client_identity.private_key;
    if (private_key.algorithm == keys.ED25519 || private_key.algorithm == keys.P256) {
        var key: contracts.SecretBytes;
        if (keys.private_bytes(private_key, ?key) != contracts.OK) {
            ret contracts.Operation{error: contracts.INVALID_KEY, written: 0};
        }
        if (private_key.algorithm == keys.ED25519) {
            ret signature.sign_ed25519(key, message, output);
        }
        ret signature.sign_ecdsa_p256_sha256(key, message, output);
    }
    var modulus:          [512]u8;
    var exponent:         [512]u8;
    var private_exponent: [512]^u8;
    val copied:           contracts.Error = keys.copy_rsa(private_key,
        contracts.Buffer{data: ?modulus[0], capacity: 512},
        contracts.Buffer{data: ?exponent[0], capacity: 512},
        contracts.SecretBuffer{data: ?private_exponent[0], capacity: 512});
    if (copied != contracts.OK) {
        ct.zeroize(?private_exponent[0], 512);
        ret contracts.Operation{error: copied, written: 0};
    }
    var salt:        [48]^u8;
    var salt_length: usize = 48;
    if (client.client_auth_scheme == tls13.RSA_PSS_RSAE_SHA256) { salt_length = 32; }
    if (!entropy_fill(client, ?salt[0], salt_length)) {
        ct.zeroize(?private_exponent[0], 512);
        ct.zeroize(?salt[0], 48);
        ret contracts.Operation{error: contracts.ENTROPY_UNAVAILABLE, written: 0};
    }
    val rsa_key: signature.RsaPrivateKey = signature.RsaPrivateKey{
        modulus:          contracts.Bytes{data: ?modulus[0], len: private_key.modulus_len},
        public_exponent:  contracts.Bytes{data: ?exponent[0], len: private_key.exponent_len},
        private_exponent: contracts.SecretBytes{data: ?private_exponent[0],
            len: private_key.modulus_len},
    };
    var operation: contracts.Operation;
    if (client.client_auth_scheme == tls13.RSA_PSS_RSAE_SHA256) {
        operation = signature.sign_rsa_pss_sha256(rsa_key, message,
            contracts.SecretBytes{data: ?salt[0], len: 32}, output);
    }
    or {
        operation = signature.sign_rsa_pss_sha384(rsa_key, message,
            contracts.SecretBytes{data: ?salt[0], len: 48}, output);
    }
    ct.zeroize(?private_exponent[0], 512);
    ct.zeroize(?salt[0], 48);
    ret operation;
}

fun append_client_certificate_verify(client: *Handshake, offset: usize) usize {
    if (client.config.client_identity == nil || client.client_auth_scheme == 0) {
        ret offset;
    }
    var signed: [MAX_SIGNED_CONTEXT]u8;
    if (certificate_verify_input(client, false, ?signed[0]) != error.OK) { ret 0; }
    var signature_bytes: [MAX_SIGNATURE]u8;
    val operation:       contracts.Operation = sign_client(client,
        contracts.Bytes{data: ?signed[0],
        len: 98 + key_schedule.hash_size(client.schedule.algorithm)},
        contracts.Buffer{data: ?signature_bytes[0], capacity: MAX_SIGNATURE});
    var i: usize = 0;
    for (i < MAX_SIGNED_CONTEXT) {
        signed[i] = 0;
        i         = i + 1;
    }
    if (operation.error != contracts.OK || operation.written == 0 ||
        8 + operation.written > client.buffers.output.chunk.bytes - offset) { ret 0; }
    var value: codec.CertificateVerify;
    value.scheme    = client.client_auth_scheme;
    value.signature = contracts.Bytes{data: ?signature_bytes[0], len: operation.written};
    val encoded: handshake.Progress = codec.encode_certificate_verify(?value,
        contracts.Buffer{data: ?client.buffers.output.chunk.data[offset],
        capacity: client.buffers.output.chunk.bytes - offset});
    i = 0;
    for (i < MAX_SIGNATURE) {
        signature_bytes[i] = 0;
        i                  = i + 1;
    }
    if (encoded.status != handshake.COMPLETE) { ret 0; }
    ret offset + encoded.produced;
}

fun append_client_finished(client: *Handshake, offset: usize) usize {
    var hash: [48]u8;
    val size: usize = key_schedule.hash_size(client.schedule.algorithm);
    if (transcript.snapshot(?client.transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK) { ret 0; }
    var verify_data: [48]u8;
    if (key_schedule.finished(?client.schedule,
        ?client.schedule.client_handshake_traffic,
        contracts.Bytes{data: ?hash[0], len: size},
        contracts.Buffer{data: ?verify_data[0], capacity: 48}) != error.OK) { ret 0; }
    var value: codec.Finished;
    value.verify_data = contracts.Bytes{data: ?verify_data[0], len: size};
    val encoded: handshake.Progress = codec.encode_finished(?value,
        contracts.Buffer{data: ?client.buffers.output.chunk.data[offset],
        capacity: client.buffers.output.chunk.bytes - offset});
    var i: usize = 0;
    for (i < 48) {
        hash[i]        = 0;
        verify_data[i] = 0;
        i              = i + 1;
    }
    if (encoded.status != handshake.COMPLETE) { ret 0; }
    ret offset + encoded.produced;
}

fun build_client_flight(client: *Handshake) error.Error {
    var offset: usize = 0;
    if (client.client_auth_requested) {
        val certificate_end: usize = append_client_certificate(client, offset);
        if (certificate_end == 0) { ret error.RESOURCE_LIMIT; }
        var failure: error.Error = transcript.update_frame(?client.transcript,
            contracts.Bytes{data: ?client.buffers.output.chunk.data[offset],
            len: certificate_end - offset});
        if (failure != error.OK) { ret failure; }
        offset = certificate_end;
        if (client.config.client_identity != nil && client.client_auth_scheme != 0) {
            val verify_end: usize = append_client_certificate_verify(client, offset);
            if (verify_end == 0) { ret error.INTERNAL_ERROR; }
            failure = transcript.update_frame(?client.transcript,
                contracts.Bytes{data: ?client.buffers.output.chunk.data[offset],
                len: verify_end - offset});
            if (failure != error.OK) { ret failure; }
            offset = verify_end;
        }
    }
    val finished_end: usize = append_client_finished(client, offset);
    if (finished_end == 0) { ret error.INTERNAL_ERROR; }
    var failure: error.Error = transcript.update_frame(?client.transcript,
        contracts.Bytes{data: ?client.buffers.output.chunk.data[offset], len: finished_end - offset});
    if (failure != error.OK) { ret failure; }
    offset = finished_end;
    var hash: [48]u8;
    val size: usize = key_schedule.hash_size(client.schedule.algorithm);
    failure = transcript.snapshot(?client.transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48});
    if (failure == error.OK) {
        failure = key_schedule.derive_resumption(?client.schedule,
            contracts.Bytes{data: ?hash[0], len: size});
    }
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    if (failure != error.OK) { ret failure; }
    client.output_len     = offset;
    client.output_level   = HANDSHAKE;
    client.output_pending = true;
    ret error.OK;
}

fun handle_finished(client: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var value:   codec.Finished;
    val size:    usize       = key_schedule.hash_size(client.schedule.algorithm);
    var failure: error.Error = codec.decode_finished(message, size, ?value);
    var hash:    [48]u8;
    if (failure == error.OK) {
        failure = transcript.snapshot(?client.transcript,
            contracts.Buffer{data: ?hash[0], capacity: 48});
    }
    if (failure == error.OK) {
        failure = key_schedule.verify_finished(?client.schedule,
            ?client.schedule.server_handshake_traffic,
            contracts.Bytes{data: ?hash[0], len: size}, value.verify_data);
    }
    if (failure == error.OK) { failure = transcript.update_frame(?client.transcript, frame); }
    if (failure == error.OK) {
        failure = transcript.snapshot(?client.transcript,
            contracts.Buffer{data: ?hash[0], capacity: 48});
    }
    if (failure == error.OK) {
        failure = key_schedule.advance_application(?client.schedule,
            contracts.Bytes{data: ?hash[0], len: size});
    }
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    if (failure == error.OK) { failure = build_client_flight(client); }
    if (failure != error.OK) { ret failure; }
    client.application_send_pending    = true;
    client.application_receive_pending = true;
    client.authentication_pending      = true;
    client.complete_pending            = true;
    client.state                       = ESTABLISHED;
    ret error.OK;
}

fun process_frame(client: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    if (client.state == EXPECT_SERVER_HELLO) {
        ret handle_server_hello(client, frame, message);
    }
    if (client.state == EXPECT_ENCRYPTED_EXTENSIONS) {
        ret handle_encrypted_extensions(client, frame, message);
    }
    if (client.state == EXPECT_CERTIFICATE_OR_REQUEST) {
        if (message.header.message_type == handshake.CERTIFICATE_REQUEST) {
            ret handle_certificate_request(client, frame, message);
        }
        if (message.header.message_type == handshake.CERTIFICATE) {
            ret handle_certificate(client, frame, message);
        }
        ret error.UNEXPECTED_MESSAGE;
    }
    if (client.state == EXPECT_CERTIFICATE) {
        ret handle_certificate(client, frame, message);
    }
    if (client.state == EXPECT_CERTIFICATE_VERIFY) {
        ret handle_certificate_verify(client, frame, message);
    }
    if (client.state == EXPECT_FINISHED) {
        ret handle_finished(client, frame, message);
    }
    ret error.UNEXPECTED_MESSAGE;
}

# the limit for the next buffered message, chosen by its type
fun peer_limit(client: *Handshake) usize {
    var message_type: handshake.MessageType = 0;
    if (client.input_read < client.input_len) {
        message_type = client.buffers.input.chunk.data[client.input_read];
    }
    ret config.peer_message_limit(client.config.limits, message_type);
}

fun release_buffers(client: *Handshake) {
    buffer.release(client.memory, ?client.buffers.input, client.buffers.input.chunk.bytes);
    buffer.release(client.memory, ?client.buffers.output, client.buffers.output.chunk.bytes);
    buffer.release(client.memory, ?client.buffers.hello, client.buffers.hello.chunk.bytes);
    buffer.release(client.memory, ?client.buffers.peer_parameters,
        client.buffers.peer_parameters.chunk.bytes);
}

# a refused reservation either waits, changing nothing, or fails the handshake
fun reserved(client: *Handshake, outcome: buffer.Outcome) engine.Result {
    if (outcome == buffer.HELD) { ret result(OK, error.OK, 0, 0); }
    if (outcome == buffer.WAIT) { ret result(engine.WAITING, error.OK, 0, 0); }
    ret fail(client, error.RESOURCE_LIMIT, record.INTERNAL_ERROR_ALERT);
}

# the most input one connection buffers at once
fun input_limit(client: *Handshake) usize {
    val chain:   usize = config.certificate_message_bytes(client.config.limits);
    val message: usize = client.config.limits.max_peer_handshake_bytes;
    if (chain > message) { ret chain; }
    ret message;
}

# everything a buffered message needs is held before it is processed, so a
# message either runs to completion or leaves the handshake untouched
fun prepare_frame(client: *Handshake, message_type: handshake.MessageType,
    length: usize) buffer.Outcome {
    if (message_type != handshake.ENCRYPTED_EXTENSIONS || client.peer_extension == 0) {
        ret buffer.HELD;
    }
    ret buffer.reserve(client.memory, ?client.buffers.peer_parameters, length, 0);
}

# the core takes the bytes the server sent behind its finished. when it must
# wait for memory they stay in input and are offered again before anything else
fun hand_leftover(client: *Handshake) engine.Result {
    if (client.input_read < client.input_len) {
        val fed: engine.Result = established.feed(?client.core,
            ?client.buffers.input.chunk.data[client.input_read],
            client.input_len - client.input_read);
        if (fed.status == engine.WAITING) {
            client.leftover = true;
            ret fed;
        }
    }
    client.leftover   = false;
    client.input_read = 0;
    client.input_len  = 0;
    buffer.release(client.memory, ?client.buffers.input, client.buffers.input.chunk.bytes);
    ret result(OK, error.OK, 0, 0);
}

fun drive(client: *Handshake, level: Level) engine.Result {
    var progressed: bool = false;
    for (true) {
        if (client.output_pending || client.event_active) {
            ret result(BLOCKED, error.OK, 0, 0);
        }
        if (client.input_read == client.input_len) {
            client.input_read = 0;
            client.input_len  = 0;
            ret result(MORE, error.OK, 0, handshake.HEADER_SIZE);
        }
        var message: handshake.Message;
        val parsed:  handshake.Progress = handshake.parse(
            ?client.buffers.input.chunk.data[client.input_read], client.input_len - client.input_read,
            peer_limit(client) - handshake.HEADER_SIZE,
            ?message);
        if (parsed.status == handshake.NEED_INPUT) {
            ret result(MORE, error.OK, 0, parsed.required);
        }
        if (parsed.status != handshake.COMPLETE) {
            ret fail(client, parsed.error, alert_for(parsed.error));
        }
        val frame: contracts.Bytes = contracts.Bytes{
            data: ?client.buffers.input.chunk.data[client.input_read], len: parsed.consumed
        };
        val prepared: buffer.Outcome = prepare_frame(client,
            message.header.message_type, frame.len);
        if (prepared == buffer.FAIL) {
            ret fail(client, error.RESOURCE_LIMIT, record.INTERNAL_ERROR_ALERT);
        }
        if (prepared == buffer.WAIT) {
            if (progressed) { ret result(OK, error.OK, 0, 0); }
            ret result(engine.WAITING, error.OK, 0, 0);
        }
        val failure: error.Error = process_frame(client, frame, ?message);
        if (failure != error.OK) { ret fail(client, failure, alert_for(failure)); }
        client.input_read = client.input_read + parsed.consumed;
        progressed        = true;
        if (client.output_pending || client.handshake_send_pending ||
            client.handshake_receive_pending || client.application_send_pending ||
            client.application_receive_pending || client.parameters_pending ||
            client.early_pending || client.authentication_pending ||
            client.complete_pending || client.alert_pending) {
            ret result(OK, error.OK, 0, 0);
        }
    }
    ret result(FAILED, error.INTERNAL_ERROR, 0, 0);
}

fun compact_input(client: *Handshake) {
    if (client.input_read == 0) { ret; }
    if (client.input_read == client.input_len) {
        client.input_read = 0;
        client.input_len  = 0;
        ret;
    }
    val remaining: usize = client.input_len - client.input_read;
    var i:         usize = 0;
    for (i < remaining) {
        client.buffers.input.chunk.data[i] = client.buffers.input.chunk.data[client.input_read + i];
        i                                  = i + 1;
    }
    client.input_read = 0;
    client.input_len  = remaining;
}

fun ingest_inner(client: *Handshake, level: Level, data: *u8,
    length: usize) engine.Result {
    if (!client_owner_valid(client) ||
        client.config == nil || !valid_level(level) ||
        client.state == DESTROYED || client.state == TERMINAL ||
        !memory_range.valid(data, length) ||
        client_owner_overlaps(client, data, length) ||
        buffers_overlap(client, data, length) ||
        borrowed_overlaps(client.config, client.extra, data, length,
        true, true)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    if (client.output_pending || client.event_active) {
        ret result(BLOCKED, error.OK, 0, 0);
    }
    var expected: Level = HANDSHAKE;
    if (client.state == EXPECT_SERVER_HELLO) { expected = INITIAL; }
    if (client.state == ESTABLISHED)         { expected = APPLICATION; }
    if (level != expected) {
        ret fail(client, error.UNEXPECTED_MESSAGE, record.UNEXPECTED_MESSAGE_ALERT);
    }
    val unread: usize = client.input_len - client.input_read;
    if (length > input_limit(client) - unread) {
        ret fail(client, error.RESOURCE_LIMIT, record.INTERNAL_ERROR_ALERT);
    }
    # a larger chunk takes only the unread bytes, which is the same compaction
    if (length > client.buffers.input.chunk.bytes - unread) {
        val room: engine.Result = reserved(client, buffer.reserve_from(client.memory,
            ?client.buffers.input, unread + length, client.input_read, unread));
        if (room.status != OK) { ret room; }
        client.input_read = 0;
        client.input_len  = unread;
    }
    compact_input(client);
    val before: usize = client.input_len;
    if (length != 0) {
        copy_bytes(?client.buffers.input.chunk.data[client.input_len], data, length);
        client.input_len = client.input_len + length;
    }
    var progress: engine.Result = drive(client, level);
    if (progress.status == engine.WAITING) {
        # nothing was processed, so the bytes are handed back
        zero_bytes(?client.buffers.input.chunk.data[before], length);
        client.input_len = before;
        ret progress;
    }
    progress.consumed = length;
    ret progress;
}

pub fun ingest(client: *Handshake, level: Level, data: *u8,
    length: usize) engine.Result {
    if (!enter(client)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var progress: engine.Result;
    if (client.delegating) {
        if (client_owner_overlaps(client, data, length) ||
            buffers_overlap(client, data, length)) {
            progress = result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
        }
        or (client.leftover && hand_leftover(client).status == engine.WAITING) {
            progress = result(engine.WAITING, error.OK, 0, 0);
        }
        or { progress = established.ingest(?client.core, level, data, length); }
    }
    or { progress = ingest_inner(client, level, data, length); }
    leave(client);
    ret progress;
}

fun poll_inner(client: *Handshake) engine.Result {
    if (!client_owner_valid(client) ||
        client.config == nil || client.state == DESTROYED ||
        client.state == TERMINAL) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var level: Level = HANDSHAKE;
    if (client.state == EXPECT_SERVER_HELLO) { level = INITIAL; }
    if (client.state == ESTABLISHED)         { level = APPLICATION; }
    ret drive(client, level);
}

pub fun poll(client: *Handshake) engine.Result {
    if (!enter(client)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var progress: engine.Result;
    if (client.delegating) {
        if (client.leftover && hand_leftover(client).status == engine.WAITING) {
            progress = result(engine.WAITING, error.OK, 0, 0);
        }
        or { progress = established.poll(?client.core); }
    }
    or { progress = poll_inner(client); }
    leave(client);
    ret progress;
}

fun pending(client: *Handshake) bool {
    ret client.output_pending || client.handshake_send_pending ||
        client.handshake_receive_pending || client.application_send_pending ||
        client.application_receive_pending || client.parameters_pending ||
        client.early_pending || client.authentication_pending ||
        client.complete_pending || client.alert_pending;
}

fun next_event_inner(client: *Handshake, output: *engine.Event) bool {
    # nothing pending is answered before the borrowed descriptors are walked
    if (!client_owner_valid(client) || output == nil || client.event_active ||
        client.state == DESTROYED || !pending(client) ||
        !memory_range.valid((?output.token)::*u8, $size_of(engine.Event)) ||
        client_owner_overlaps(client, (?output.token)::*u8, $size_of(engine.Event)) ||
        buffers_overlap(client, (?output.token)::*u8, $size_of(engine.Event)) ||
        borrowed_overlaps(client.config, client.extra, (?output.token)::*u8,
        $size_of(engine.Event), true, true)) { ret false; }
    var event: engine.Event = engine.empty_event();
    event.token = next_generation(client.event_generation);
    event.suite = client.suite;
    event.aead  = aead_for(client.suite);
    var secret_index: usize = 6;
    if (client.output_pending) {
        event.kind      = CRYPTO;
        event.level     = client.output_level;
        event.direction = SEND;
        event.data      = contracts.Bytes{data: client.buffers.output.chunk.data,
            len: client.output_len};
    }
    or (client.handshake_send_pending) {
        event.kind       = TRAFFIC_SECRET;
        event.level      = HANDSHAKE;
        event.direction  = SEND;
        event.secret     = key_schedule.bytes(?client.schedule.client_handshake_traffic);
        secret_index     = 0;
        event.generation = next_generation(client.secret_generation[0]);
    }
    or (client.handshake_receive_pending) {
        event.kind       = TRAFFIC_SECRET;
        event.level      = HANDSHAKE;
        event.direction  = RECEIVE;
        event.secret     = key_schedule.bytes(?client.schedule.server_handshake_traffic);
        secret_index     = 1;
        event.generation = next_generation(client.secret_generation[1]);
    }
    or (client.parameters_pending) {
        event.kind  = PEER_PARAMETERS;
        event.level = HANDSHAKE;
        event.data  = client.peer_parameters;
    }
    or (client.early_pending) {
        event.kind        = EARLY_DATA;
        event.disposition = EARLY_NOT_OFFERED;
    }
    or (client.authentication_pending) {
        event.kind        = AUTHENTICATION;
        event.disposition = AUTHENTICATED;
    }
    or (client.application_send_pending) {
        event.kind       = TRAFFIC_SECRET;
        event.level      = APPLICATION;
        event.direction  = SEND;
        event.secret     = key_schedule.bytes(?client.schedule.client_application_traffic);
        secret_index     = 2;
        event.generation = next_generation(client.secret_generation[2]);
    }
    or (client.application_receive_pending) {
        event.kind       = TRAFFIC_SECRET;
        event.level      = APPLICATION;
        event.direction  = RECEIVE;
        event.secret     = key_schedule.bytes(?client.schedule.server_application_traffic);
        secret_index     = 3;
        event.generation = next_generation(client.secret_generation[3]);
    }
    or (client.complete_pending) {
        event.kind  = HANDSHAKE_COMPLETE;
        event.level = APPLICATION;
    }
    or {
        event.kind  = ALERT;
        event.alert = client.pending_alert;
    }
    output[0]               = event;
    client.event_generation = event.token;
    if (secret_index < 6) {
        client.secret_generation[secret_index] = event.generation;
    }
    client.active_event = event;
    client.event_active = true;
    ret true;
}

pub fun next_event(client: *Handshake, output: *engine.Event) bool {
    if (!enter(client)) { ret false; }
    var available: bool = false;
    if (client.delegating) {
        available = output != nil && !client_owner_overlaps(client,
            (?output.token)::*u8, $size_of(engine.Event)) &&
            established.next_event(?client.core, output);
    }
    or { available = next_event_inner(client, output); }
    leave(client);
    ret available;
}

# the configured protocol the handshake selected, borrowed from the caller
fun configured_alpn(client: *Handshake) contracts.Bytes {
    var i: usize = 0;
    for (client.selected_alpn.len != 0 && i < client.config.alpn_len) {
        val name: config.ProtocolName = client.config.alpn[i];
        if (name.len == client.selected_alpn.len) {
            var equal: bool  = true;
            var at:    usize = 0;
            for (at < name.len) {
                if (name.data[at] != client.selected_alpn.data[at]) { equal = false; }
                at = at + 1;
            }
            if (equal) { ret contracts.Bytes{data: name.data, len: name.len}; }
        }
        i = i + 1;
    }
    ret contracts.Bytes{data: nil, len: 0};
}

# once the last handshake event is accepted the established core takes over:
# it is seeded with the application secrets, and the schedule, transcript and
# offered psk go with the handshake
fun discard_completed(client: *Handshake) {
    var seed: established.Seed;
    seed.role                  = engine.CLIENT;
    seed.suite                 = client.suite;
    seed.group                 = client.group;
    seed.retry_count           = client.retry_count;
    seed.tickets_issued        = 0;
    seed.authenticated         = client.authenticated;
    seed.resumed               = client.psk_accepted;
    seed.peer_offered_alpn     = false;
    seed.client_auth_requested = client.client_auth_requested;
    seed.quic                  = client.peer_extension == QUIC_TRANSPORT_PARAMETERS;
    seed.retain_exporter       = client.config.retain_exporter;
    seed.alpn                  = configured_alpn(client);
    seed.server_name           = client.config.server_name;
    seed.receive_record_limit  = client.receive_record_plaintext;
    seed.send_record_limit     = client.send_record_plaintext;
    seed.max_message_bytes     = client.config.limits.max_peer_handshake_bytes;
    seed.max_ticket_bytes      = client.config.limits.max_ticket_bytes;
    seed.sessions              = client.sessions;
    seed.started_at            = client.at.monotonic;
    var resumption: *key_schedule.Secret = nil;
    if (client.schedule.resumption_ready) {
        resumption = ?client.schedule.resumption_master;
    }
    val seeded: bool = established.begin(?client.core, seed,
        ?client.schedule.client_application_traffic,
        ?client.schedule.server_application_traffic, resumption,
        ?client.schedule.exporter_master, client.memory);
    key_schedule.destroy(?client.schedule);
    transcript.destroy(?client.transcript);
    session.ticket_destroy(?client.offered_ticket);
    if (!seeded) {
        fail(client, error.INTERNAL_ERROR, record.INTERNAL_ERROR_ALERT);
        ret;
    }
    client.delegating = true;
    buffer.release(client.memory, ?client.buffers.output, client.buffers.output.chunk.bytes);
    hand_leftover(client);
}

fun complete_event_inner(client: *Handshake, token: u64, accepted: bool) bool {
    if (!client_owner_valid(client) ||
        !client.event_active || token == 0 ||
        token != client.active_event.token) { ret false; }
    val kind:      EventKind = client.active_event.kind;
    val level:     Level     = client.active_event.level;
    val direction: Direction = client.active_event.direction;
    client.event_active = false;
    if (!accepted) {
        fail(client, error.INTERNAL_ERROR, record.INTERNAL_ERROR_ALERT);
        ret true;
    }
    if (kind == CRYPTO) {
        client.output_pending = false;
        client.output_len     = 0;
    }
    or (kind == TRAFFIC_SECRET && level == HANDSHAKE && direction == SEND) {
        client.handshake_send_pending = false;
    }
    or (kind == TRAFFIC_SECRET && level == HANDSHAKE && direction == RECEIVE) {
        client.handshake_receive_pending = false;
    }
    or (kind == TRAFFIC_SECRET && level == APPLICATION && direction == SEND) {
        client.application_send_pending = false;
    }
    or (kind == TRAFFIC_SECRET && level == APPLICATION && direction == RECEIVE) {
        client.application_receive_pending = false;
    }
    or (kind == PEER_PARAMETERS) {
        client.parameters_pending = false;
    }
    or (kind == EARLY_DATA) {
        client.early_pending = false;
    }
    or (kind == AUTHENTICATION) {
        client.authentication_pending = false;
    }
    or (kind == HANDSHAKE_COMPLETE) {
        client.complete_pending = false;
    }
    or (kind == ALERT) {
        client.alert_pending = false;
    }
    if (client.state == ESTABLISHED && !pending(client) &&
        client.schedule.stage == key_schedule.APPLICATION &&
        client.schedule.master_secret.active) {
        discard_completed(client);
    }
    ret true;
}

pub fun complete_event(client: *Handshake, token: u64, accepted: bool) bool {
    if (!enter(client)) { ret false; }
    var completed: bool = false;
    if (client.delegating) {
        completed = established.complete_event(?client.core, token, accepted);
    }
    or { completed = complete_event_inner(client, token, accepted); }
    leave(client);
    ret completed;
}

fun close_inner(client: *Handshake, description: record.AlertDescription) engine.Result {
    if (!client_owner_valid(client) ||
        client.state == DESTROYED || client.state == TERMINAL ||
        client.state == CLOSING || client.alert_pending ||
        !record.valid_tls13_alert(description)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    client.pending_alert = description;
    client.alert_pending = true;
    if (description != record.USER_CANCELED_ALERT) {
        client.state = CLOSING;
    }
    ret result(OK, error.OK, 0, 0);
}

pub fun close(client: *Handshake, description: record.AlertDescription) engine.Result {
    if (!enter(client)) {
        ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var closed: engine.Result;
    if (client.delegating) { closed = established.close(?client.core, description); }
    or                     { closed = close_inner(client, description); }
    leave(client);
    ret closed;
}

fun destroy_inner(client: *Handshake) bool {
    if (!client_owner_valid(client) || client.event_active ||
        established.event_active(?client.core)) { ret false; }
    established.wipe(?client.core);
    client.delegating = false;
    ct.zeroize(?client.private_key[0], 32);
    transcript.destroy(?client.transcript);
    transcript.destroy(?client.binder_transcript);
    key_schedule.destroy(?client.schedule);
    session.ticket_destroy(?client.offered_ticket);
    release_buffers(client);
    client.sessions     = nil;
    client.offering_psk = false;
    client.config       = nil;
    # cleared by declaration, which covers every field rather than the subset
    # a manual list happens to name (briar-systems/mach#3108)
    client.configuration        = config.no_client_config();
    client.entropy              = config.no_entropy();
    client.trust                = cert.no_trust_store();
    client.identity             = credentials.no_identity();
    client.extra.data.data      = nil;
    client.peer_parameters.data = nil;
    client.selected_alpn.data   = nil;
    client.output_pending       = false;
    client.alert_pending        = false;
    # every per-handshake field goes with the handshake, so an engine
    # initialised on this record again starts from the declared zero state;
    # only the transition owner survives, since this thread still holds it
    val owner:   i64 = client.transition_owner;
    var cleared: Handshake;
    @client                 = cleared;
    client.transition_owner = owner;
    client.state            = DESTROYED;
    ret true;
}

pub fun destroy(client: *Handshake) bool {
    if (!enter(client)) { ret false; }
    val destroyed: bool = destroy_inner(client);
    leave(client);
    ret destroyed;
}

# move the established connection into core and release the handshake, which
# init may then reuse. refused, changing nothing, until the handshake queue
# has drained, no event is active and the core holds every byte the server
# sent. the core keeps charging the same lease; take the snapshot first, since
# the peer's quic parameters are not kept past this call
pub fun finish(client: *Handshake, core: *established.Established) contracts.Error {
    if (!enter(client)) { ret contracts.INVALID_STATE; }
    var finished: contracts.Error = contracts.INVALID_STATE;
    if (client.delegating && !client.leftover && !client.event_active &&
        !pending(client) && established.move(core, ?client.core)) {
        destroy_inner(client);
        finished = contracts.OK;
    }
    leave(client);
    ret finished;
}

# a key update, served by the established core once the handshake has drained
pub fun request_key_update(client: *Handshake, request: u8) engine.Result {
    if (!enter(client)) { ret result(FAILED, error.ILLEGAL_PARAMETER, 0, 0); }
    var requested: engine.Result = result(FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    if (client.delegating) {
        requested = established.request_key_update(?client.core, request);
    }
    leave(client);
    ret requested;
}

fun aead_for(suite: tls13.CipherSuite) record.Algorithm {
    if (suite == tls13.AES_128_GCM_SHA256) { ret record.AES_128_GCM; }
    if (suite == tls13.AES_256_GCM_SHA384) { ret record.AES_256_GCM; }
    if (suite == tls13.CHACHA20_POLY1305_SHA256) {
        ret record.CHACHA20_POLY1305;
    }
    ret 0;
}

fun secret_for(client: *Handshake, level: Level,
    direction: Direction) *key_schedule.Secret {
    if (level == HANDSHAKE && direction == SEND) {
        ret ?client.schedule.client_handshake_traffic;
    }
    if (level == HANDSHAKE && direction == RECEIVE) {
        ret ?client.schedule.server_handshake_traffic;
    }
    if (level == APPLICATION && direction == SEND) {
        ret ?client.schedule.client_application_traffic;
    }
    if (level == APPLICATION && direction == RECEIVE) {
        ret ?client.schedule.server_application_traffic;
    }
    ret nil;
}

fun traffic_keys_inner(client: *Handshake, event: *engine.Event,
    key: contracts.SecretBuffer, iv: contracts.Buffer,
    key_length: *usize) bool {
    if (!client_owner_valid(client) || event == nil || key_length == nil ||
        !client.event_active || event.token != client.active_event.token ||
        client.active_event.kind != TRAFFIC_SECRET) { ret false; }
    val traffic: *key_schedule.Secret = secret_for(client,
        client.active_event.level, client.active_event.direction);
    if (traffic == nil) { ret false; }
    if (key_schedule.traffic_key(?client.schedule, traffic, key) != error.OK ||
        key_schedule.traffic_iv(?client.schedule, traffic, iv) != error.OK) {
        ret false;
    }
    @key_length = key_schedule.key_size(client.suite);
    ret true;
}

# derive the record keys for the borrowed traffic-secret event
pub fun traffic_keys(client: *Handshake, event: *engine.Event,
    key: contracts.SecretBuffer, iv: contracts.Buffer,
    key_length: *usize) bool {
    if (!enter(client)) { ret false; }
    var derived: bool = false;
    if (client.delegating) {
        derived = established.traffic_keys(?client.core, event, key, iv, key_length);
    }
    or { derived = traffic_keys_inner(client, event, key, iv, key_length); }
    leave(client);
    ret derived;
}

fun snapshot_inner(client: *Handshake) engine.Snapshot {
    var value: engine.Snapshot = engine.empty_snapshot();
    if (!client_owner_valid(client)) { ret value; }
    value.role      = engine.CLIENT;
    value.version   = tls13.VERSION;
    value.peer_name = contracts.Bytes{data: nil, len: 0};
    if (client.config != nil && client.state != DESTROYED) {
        value.peer_name = client.configuration.server_name;
    }
    value.error                 = client.failure;
    value.suite                 = client.suite;
    value.group                 = client.group;
    value.retry_count           = client.retry_count;
    value.authenticated         = client.authenticated;
    value.selected_alpn         = client.selected_alpn;
    value.peer_parameters       = client.peer_parameters;
    value.client_auth_requested = client.client_auth_requested;
    value.resumed               = client.psk_accepted;
    value.output_pending        = client.output_pending;
    value.event_active          = client.event_active;
    value.destroyed             = client.state == DESTROYED;
    if (client.state == ESTABLISHED) { value.status = COMPLETE; }
    or (client.state == TERMINAL)    { value.status = FAILED; }
    or (client.state == DESTROYED)   { value.status = CLOSED; }
    or                               { value.status = MORE; }
    ret value;
}

pub fun snapshot(client: *Handshake) engine.Snapshot {
    if (!enter(client)) { ret engine.empty_snapshot(); }
    var value: engine.Snapshot;
    if (client.delegating) {
        # the server's parameters are the handshake's to report, until finish
        value                 = established.snapshot(?client.core);
        value.peer_parameters = client.peer_parameters;
    }
    or { value = snapshot_inner(client); }
    leave(client);
    ret value;
}

pub fun receive_record_limit(client: *Handshake) usize {
    if (!enter(client)) { ret 0; }
    var limit: usize = 0;
    if (client.delegating) { limit = established.receive_record_limit(?client.core); }
    or (client.config != nil && client.state != DESTROYED) {
        limit = client.receive_record_plaintext;
    }
    leave(client);
    ret limit;
}

pub fun send_record_limit(client: *Handshake) usize {
    if (!enter(client)) { ret 0; }
    var limit: usize = 0;
    if (client.delegating) { limit = established.send_record_limit(?client.core); }
    or (client.config != nil && client.state != DESTROYED) {
        limit = client.send_record_plaintext;
    }
    leave(client);
    ret limit;
}

# see the note on the no_* constructors in config.mach
fun no_extra_extension() ExtraExtension {
    var value: ExtraExtension;
    ret value;
}

# leave a nonzero pattern on the stack the next declaration will occupy, so a
# field left unset by a literal is observable rather than coincidentally zero
fun dirty_frame(depth: usize) usize {
    var scratch: [32]usize;
    var i:       usize = 0;
    for (i < 32) {
        scratch[i] = 6510615555426900570;
        i          = i + 1;
    }
    if (depth > 0) { ret dirty_frame(depth - 1) + scratch[0]; }
    ret scratch[31];
}

# every field, including the ones a manual clear left out: `sessions`, the
# five lengths, and `entropy_context_size`
fun configuration_cleared(value: *config.ClientConfig) bool {
    ret value.server_name.data == nil && value.server_name.len == 0
        && value.alpn == nil && value.alpn_len == 0 && value.trust == nil
        && value.versions == nil && value.version_len == 0
        && value.suites == nil && value.suite_len == 0
        && value.groups == nil && value.group_len == 0
        && value.signatures == nil && value.signature_len == 0
        && value.client_identity == nil && value.entropy == nil
        && value.entropy_context_size == 0 && value.sessions == nil;
}

# a destroyed client keeps no callable pointer and no stale bound, on every
# field rather than the subset a manual clear happened to name
test "client: destroy leaves no residue in any cleared record" {
    if (dirty_frame(4) == 0) { ret 1; }
    val cleared: config.ClientConfig = config.no_client_config();
    if (!configuration_cleared(?cleared)) { ret 2; }
    val entropy: secret.Entropy = config.no_entropy();
    if (entropy.context != nil || entropy.secret_context != nil
        || entropy.fill_fn != nil || entropy.initialized) { ret 3; }
    val trust: cert.TrustStore = cert.no_trust_store();
    if (trust.anchors != nil || trust.len != 0) { ret 4; }
    val identity: credentials.Identity = credentials.no_identity();
    if (identity.server_name.data != nil || identity.server_name.len != 0
        || identity.chain.certificates != nil || identity.private_key != nil) {
        ret 5;
    }
    ret 0;
}

test "client: configuration rejects unbounded and missing ownership" {
    var client:        Handshake;
    var configuration: config.ClientConfig;
    if (init(?client, ?configuration, pool.shared(), no_extra_extension(), 0)) { ret 1; }
    ret 0;
}

test "client: user canceled warning permits orderly close" {
    var client: Handshake;
    client.state = ESTABLISHED;
    if (close(?client, record.USER_CANCELED_ALERT).status != OK ||
        client.state != ESTABLISHED || !client.alert_pending ||
        close(?client, record.CLOSE_NOTIFY).status != FAILED) { ret 1; }
    client.event_active = true;
    var alert_event: engine.Event;
    alert_event.token   = 1;
    alert_event.kind    = ALERT;
    alert_event.alert   = record.USER_CANCELED_ALERT;
    client.active_event = alert_event;
    if (!complete_event(?client, 1, true) || client.alert_pending ||
        client.state != ESTABLISHED ||
        close(?client, record.CLOSE_NOTIFY).status != OK ||
        client.state != CLOSING || !client.alert_pending) { ret 2; }
    ret 0;
}

var oversized_extension: [65500]u8;

#[oblivious]
fun deterministic_entropy(context: ptr, secret_context: *^u8,
    destination: *^u8, length: usize) i64 {
    val counter: *u8   = context::*u8;
    var i:       usize = 0;
    for (i < length) {
        val byte: u8 = counter[0] + i::u8 + 1;
        destination[i] = byte;
        i              = i + 1;
    }
    counter[0] = counter[0] + 17;
    ret 0;
}

var reentry_client:         *Handshake;
var reentry_rejections:     usize;
var hostile_entropy_client: *Handshake;
var hostile_entropy_calls:  usize;

fun reentrant_entropy(context: ptr, secret_context: *^u8,
    destination: *^u8, length: usize) i64 {
    if (reentry_client != nil) {
        if (start(reentry_client, clock.at(0, 0)).status == FAILED) {
            reentry_rejections = reentry_rejections + 1;
        }
        if (!destroy(reentry_client)) {
            reentry_rejections = reentry_rejections + 1;
        }
    }
    val counter: *u8   = context::*u8;
    var i:       usize = 0;
    for (i < length) {
        val byte: u8 = counter[0] + i::u8 + 1;
        destination[i] = byte;
        i              = i + 1;
    }
    counter[0] = counter[0] + 17;
    ret 0;
}

fun hostile_entropy(context: ptr, secret_context: *^u8,
    destination: *^u8, length: usize) i64 {
    hostile_entropy_calls = hostile_entropy_calls + 1;
    var i: usize = 0;
    for (i < length) {
        destination[i] = (i + 1)::u8;
        i              = i + 1;
    }
    if (hostile_entropy_calls == 3 && hostile_entropy_client != nil) {
        hostile_entropy_client.buffers.output.chunk.data                   = nil;
        hostile_entropy_client.configuration.limits.max_client_hello_bytes = 0;
        hostile_entropy_client.state                                       = DESTROYED;
        hostile_entropy_client.output_pending                              = true;
    }
    ret 0;
}

test "client: rfc 8446 retry is transcript-safe at every fragmentation boundary" {
    var entropy_counter: u8             = 1;
    var entropy:         secret.Entropy = secret.Entropy{context: ?entropy_counter,
        secret_context: nil, fill_fn: deterministic_entropy, initialized: true};
    var anchor:    cert.Certificate       = cert.Certificate{der: "x"::*u8, der_len: 1};
    var trust:     cert.TrustStore        = cert.TrustStore{anchors: ?anchor, len: 1};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h3"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups: [2]tls13.NamedGroup = [2]tls13.NamedGroup{
        tls13.X25519, tls13.SECP256R1
    };
    var signatures: [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{
        tls13.ED25519
    };
    var configuration: config.ClientConfig;
    configuration.server_name = contracts.Bytes{
        data: "api.example.com"::*u8, len: 15
    };
    configuration.alpn                                = ?protocols[0];
    configuration.alpn_len                            = 1;
    configuration.trust                               = ?trust;
    configuration.versions                            = ?versions[0];
    configuration.version_len                         = 1;
    configuration.suites                              = ?suites[0];
    configuration.suite_len                           = 1;
    configuration.groups                              = ?groups[0];
    configuration.group_len                           = 2;
    configuration.signatures                          = ?signatures[0];
    configuration.signature_len                       = 1;
    configuration.entropy                             = ?entropy;
    configuration.entropy_context_size                = 1;
    entropy.fill_fn                                   = reentrant_entropy;
    configuration.limits                              = config.production_limits();
    configuration.limits.max_peer_handshake_bytes     = 4096;
    configuration.limits.max_chain_bytes              = 3072;
    configuration.limits.max_ticket_bytes             = 4096;
    configuration.limits.max_receive_record_plaintext = 1024;
    configuration.limits.max_send_record_plaintext    = 2048;
    val memory:                   buffer.Lease        = pool.shared();
    var production_configuration: config.ClientConfig = configuration;
    production_configuration.limits = config.production_limits();
    if (!config_valid(?production_configuration, no_extra_extension(), 0)) { ret 66; }
    var bounded_configuration: config.ClientConfig = configuration;
    bounded_configuration.limits.max_peer_handshake_bytes =
        handshake.HEADER_SIZE;
    if (config_valid(?bounded_configuration, no_extra_extension(), 0)) { ret 67; }
    var exact_hello:  usize = 0;
    var exact_flight: usize = 0;
    if (!client_hello_requirement(?configuration, no_extra_extension(),
        ?exact_hello) || exact_hello == 0 ||
        !client_flight_requirement(?configuration, ?exact_flight) ||
        exact_flight == 0) { ret 68; }
    bounded_configuration                               = configuration;
    bounded_configuration.limits.max_client_hello_bytes = exact_hello - 1;
    if (config_valid(?bounded_configuration, no_extra_extension(), 0)) { ret 69; }
    bounded_configuration                                = configuration;
    bounded_configuration.limits.max_client_flight_bytes = exact_flight - 1;
    if (config_valid(?bounded_configuration, no_extra_extension(), 0)) { ret 70; }
    bounded_configuration = configuration;
    var missing_fill_entropy: secret.Entropy = entropy;
    missing_fill_entropy.fill_fn  = nil;
    bounded_configuration.entropy = ?missing_fill_entropy;
    if (config_valid(?bounded_configuration, no_extra_extension(), 0)) { ret 71; }
    var oversized_configuration: config.ClientConfig = configuration;
    oversized_configuration.limits.max_peer_handshake_bytes = 70000;
    oversized_configuration.limits.max_client_hello_bytes   = 70000;
    val oversized_extra: ExtraExtension = ExtraExtension{kind: 0xffa5,
        data: contracts.Bytes{data: ?oversized_extension[0], len: 65500}};
    var oversized_client: Handshake;
    if (init(?oversized_client, ?oversized_configuration,
        memory, oversized_extra, 0) ||
        oversized_client.state != 0) { ret 72; }
    var local_bound_configuration: config.ClientConfig = configuration;
    local_bound_configuration.limits.max_peer_handshake_bytes = 64;
    var local_bound_client: Handshake;
    if (!init(?local_bound_client, ?local_bound_configuration, memory,
        no_extra_extension(), 0) ||
        start(?local_bound_client, clock.at(1787875200, 1787875200)).status != OK ||
        local_bound_client.hello_len <=
        local_bound_configuration.limits.max_peer_handshake_bytes) {
        ret 73;
    }
    var local_hello: codec.ClientHello;
    if (decode_own_hello(?local_bound_client, ?local_hello) != error.OK ||
        !destroy(?local_bound_client)) { ret 74; }
    var hostile_descriptor: secret.Entropy = entropy;
    hostile_descriptor.fill_fn = hostile_entropy;
    var hostile_configuration: config.ClientConfig = configuration;
    hostile_configuration.entropy = ?hostile_descriptor;
    var hostile_client: Handshake;
    hostile_entropy_client = ?hostile_client;
    hostile_entropy_calls  = 0;
    if (!init(?hostile_client, ?hostile_configuration, memory,
        no_extra_extension(), 0)) { ret 75; }
    val hostile_started: engine.Result = start(?hostile_client, clock.at(1787875200, 1787875200));
    if (hostile_started.status != FAILED ||
        hostile_started.error != error.INTERNAL_ERROR ||
        !lease_equal(hostile_client.memory, memory) ||
        hostile_client.configuration.limits.max_client_hello_bytes !=
        configuration.limits.max_client_hello_bytes ||
        hostile_client.output_pending || hostile_client.state != TERMINAL) {
        ret 76;
    }
    var hostile_key_index: usize = 0;
    for (hostile_key_index < 32) {
        if (hostile_client.private_key[hostile_key_index]:>u8 != 0) { ret 77; }
        hostile_key_index = hostile_key_index + 1;
    }
    if (!destroy(?hostile_client)) { ret 78; }
    hostile_entropy_client = nil;
    var value: Handshake;
    reentry_client     = ?value;
    reentry_rejections = 0;
    if (configuration.entropy == nil || !configuration.entropy.initialized) { ret 21; }
    if (configuration.server_name.data == nil ||
        configuration.server_name.len == 0) { ret 22; }
    if (configuration.trust == nil || configuration.trust.len == 0)          { ret 23; }
    if (configuration.alpn == nil || configuration.alpn_len == 0)            { ret 24; }
    if (configuration.versions == nil || configuration.version_len == 0)     { ret 25; }
    if (configuration.suites == nil || configuration.suite_len == 0)         { ret 26; }
    if (configuration.groups == nil || configuration.group_len == 0)         { ret 27; }
    if (configuration.signatures == nil || configuration.signature_len == 0) { ret 28; }
    if (!codec.valid_named_group(configuration.groups[0]) ||
        !codec.valid_named_group(configuration.groups[1])) { ret 31; }
    if (configuration.versions[0] != tls13.VERSION)                 { ret 33; }
    if (!codec.valid_cipher_suite(configuration.suites[0]))         { ret 34; }
    if (!codec.valid_signature_scheme(configuration.signatures[0])) { ret 35; }
    if (configuration.alpn[0].data == nil || configuration.alpn[0].len == 0 ||
        configuration.alpn[0].len > 255) { ret 36; }
    if (configuration.limits.max_receive_record_plaintext == 0 ||
        configuration.limits.max_peer_handshake_bytes <= handshake.HEADER_SIZE ||
        configuration.limits.max_chain_bytes == 0) { ret 37; }
    var quic_extra: ExtraExtension;
    quic_extra.kind = QUIC_TRANSPORT_PARAMETERS;
    if (quic_extra.data.len != 0) { ret 38; }
    var missing: buffer.Lease = memory;
    missing.account = nil;
    if (init(?value, ?configuration, missing, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 50; }
    missing        = memory;
    missing.source = (~(0::usize) - 1)::*buffers.Source;
    if (init(?value, ?configuration, missing, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 51; }
    var alias_protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: memory.account::*u8, len: 2}
    };
    var alias_configuration: config.ClientConfig = configuration;
    alias_configuration.alpn = ?alias_protocols[0];
    if (init(?value, ?alias_configuration, memory, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 54; }
    alias_configuration             = configuration;
    alias_configuration.server_name = contracts.Bytes{
        data: (~(0::usize) - 1)::*u8, len: 3
    };
    if (config_valid(?alias_configuration, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 58; }
    alias_configuration      = configuration;
    alias_configuration.alpn = (~(0::usize) - 1)::*config.ProtocolName;
    if (config_valid(?alias_configuration, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 59; }
    var wrapping_protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: (~(0::usize) - 1)::*u8, len: 3}
    };
    alias_configuration      = configuration;
    alias_configuration.alpn = ?wrapping_protocols[0];
    if (config_valid(?alias_configuration, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 60; }
    var nul_name: [15]u8 = [15]u8{'a', 'p', 'i', 0, 'e', 'x', 'a', 'm',
        'p', 'l', 'e', '.', 'c', 'o', 'm'};
    alias_configuration             = configuration;
    alias_configuration.server_name = contracts.Bytes{
        data: ?nul_name[0], len: 15
    };
    if (config_valid(?alias_configuration, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 61; }
    alias_configuration       = configuration;
    alias_configuration.trust =
        (~(0::usize) - 1)::*cert.TrustStore;
    if (config_valid(?alias_configuration, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 65; }
    if (!config_valid(?configuration, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 32; }
    if (!init(?value, ?configuration, memory, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 1; }
    if (!aliases_borrowed(?value, configuration.groups::*u8,
        2 * $size_of(tls13.NamedGroup))) {
        ret 62;
    }
    if (init(?value, ?configuration, memory, quic_extra,
        QUIC_TRANSPORT_PARAMETERS)) { ret 55; }
    configuration.entropy   = nil;
    configuration.trust     = nil;
    configuration.groups    = nil;
    configuration.group_len = 0;
    entropy.initialized     = false;
    trust.len               = 0;
    if (value.config == ?configuration || value.config.entropy != ?value.entropy ||
        value.config.trust != ?value.trust || value.config.groups == nil ||
        !value.config.entropy.initialized || value.config.trust.len != 1) {
        ret 57;
    }
    val started: engine.Result = start(?value, clock.at(1787875200, 1787875200));
    if (started.status != OK || !value.output_pending ||
        reentry_rejections < 6 ||
        atomic.load(?value.transition_owner) != 0) { ret 2; }
    var event: engine.Event;
    if (!next_event(?value, ?event) || event.kind != CRYPTO ||
        event.level != INITIAL || event.data.len == 0 ||
        next_event(?value, ?value.active_event) ||
        next_event(?value, ?event) || complete_event(?value, event.token + 1, true) ||
        destroy(?value)) { ret 3; }
    val hello_token: u64 = value.active_event.token;
    if (!complete_event(?value, hello_token, true)) { ret 4; }
    if (ingest(?value, INITIAL, value.buffers.output.chunk.data, 1).status != FAILED ||
        ingest(?value, INITIAL, client_owner_data(?value), 1).status != FAILED ||
        value.state != EXPECT_SERVER_HELLO) { ret 56; }
    if (restart(?value, RESTART_VERSION_NEGOTIATION).status != OK ||
        !next_event(?value, ?event) || event.kind != CRYPTO ||
        event.level != INITIAL || !bytes_equal(event.data,
        contracts.Bytes{data: value.buffers.hello.chunk.data, len: value.hello_len}) ||
        !complete_event(?value, event.token, true) ||
        restart(?value, RESTART_RETRY).status != OK ||
        !next_event(?value, ?event) || event.kind != CRYPTO ||
        !bytes_equal(event.data,
        contracts.Bytes{data: value.buffers.hello.chunk.data, len: value.hello_len}) ||
        !complete_event(?value, event.token, true)) { ret 39; }

    var retry_extensions: [12]u8 = [12]u8{
        0, 43, 0, 2, 3, 4,
        0, 51, 0, 2, 0, 23,
    };
    var retry: codec.ServerHello;
    retry.legacy_version     = tls13.LEGACY_VERSION;
    retry.random             = contracts.Bytes{data: ?codec.HELLO_RETRY_RANDOM[0], len: 32};
    retry.legacy_session_id  = contracts.Bytes{data: ?value.session_id[0], len: 32};
    retry.cipher_suite       = tls13.AES_128_GCM_SHA256;
    retry.compression_method = 0;
    retry.extensions         = extensions.list(?retry_extensions[0], 12,
        extensions.HELLO_RETRY_REQUEST);
    retry.retry = true;
    var wire:    [256]u8;
    val encoded: handshake.Progress = codec.encode_server_hello(?retry,
        contracts.Buffer{data: ?wire[0], capacity: 256});
    if (encoded.status != handshake.COMPLETE) { ret 5; }
    var i: usize = 0;
    for (i < encoded.produced) {
        val fragmented: engine.Result = ingest(?value, INITIAL, ?wire[i], 1);
        if (fragmented.consumed != 1 ||
            (i + 1 < encoded.produced && fragmented.status != MORE)) { ret 6; }
        i = i + 1;
    }
    val retried: engine.Snapshot = snapshot(?value);
    if (retried.retry_count != 1 || retried.group != tls13.SECP256R1 ||
        !retried.output_pending || value.transcript.frame_count != 3 ||
        !value.transcript.retry_used) { ret 7; }
    if (!next_event(?value, ?event) || event.kind != CRYPTO ||
        event.level != INITIAL || event.data.len == 0) { ret 8; }
    var second_hello: handshake.Message;
    if (handshake.parse(event.data.data, event.data.len, 4096,
        ?second_hello).status != handshake.COMPLETE) { ret 9; }
    var decoded: codec.ClientHello;
    if (codec.decode_client_hello(?second_hello, true, ?decoded) != error.OK ||
        decoded.after_retry == false) { ret 10; }
    var record_limit: extensions.Extension;
    if (!extensions.find(decoded.extensions, extensions.RECORD_SIZE_LIMIT,
        ?record_limit) || record_limit.len != 2 ||
        read_u16(record_limit.data, 0) != 1025 ||
        receive_record_limit(?value) != 1024 ||
        send_record_limit(?value) != 2048) { ret 63; }
    if (!complete_event(?value, event.token, true) || !destroy(?value)) { ret 11; }
    reentry_client = nil;
    ret 0;
}

test "client: event rejection has one terminal alert ownership path" {
    var entropy_counter: u8             = 3;
    var entropy:         secret.Entropy = secret.Entropy{context: ?entropy_counter,
        secret_context: nil, fill_fn: deterministic_entropy, initialized: true};
    var anchor:    cert.Certificate       = cert.Certificate{der: "x"::*u8, der_len: 1};
    var trust:     cert.TrustStore        = cert.TrustStore{anchors: ?anchor, len: 1};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:        [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures:    [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{tls13.ED25519};
    var configuration: config.ClientConfig;
    configuration.server_name = contracts.Bytes{
        data: "api.example.com"::*u8, len: 15
    };
    configuration.alpn                            = ?protocols[0];
    configuration.alpn_len                        = 1;
    configuration.trust                           = ?trust;
    configuration.versions                        = ?versions[0];
    configuration.version_len                     = 1;
    configuration.suites                          = ?suites[0];
    configuration.suite_len                       = 1;
    configuration.groups                          = ?groups[0];
    configuration.group_len                       = 1;
    configuration.signatures                      = ?signatures[0];
    configuration.signature_len                   = 1;
    configuration.entropy                         = ?entropy;
    configuration.entropy_context_size            = 1;
    configuration.limits                          = config.production_limits();
    configuration.limits.max_peer_handshake_bytes = 4096;
    configuration.limits.max_chain_bytes          = 3072;
    configuration.limits.max_ticket_bytes         = 4096;
    val memory:      buffer.Lease = pool.shared();
    var empty_extra: ExtraExtension;
    var value:       Handshake;
    if (!init(?value, ?configuration, memory, empty_extra, 0) ||
        start(?value, clock.at(1787875200, 1787875200)).status != OK) { ret 1; }
    var event: engine.Event;
    if (!next_event(?value, ?event) || !complete_event(?value, event.token, false)) {
        ret 2;
    }
    if (snapshot(?value).status != FAILED || !next_event(?value, ?event) ||
        event.kind != ALERT || event.alert != record.INTERNAL_ERROR_ALERT ||
        !complete_event(?value, event.token, true) || !destroy(?value)) { ret 3; }
    ret 0;
}

test "client: wrong-level and out-of-state messages fail closed once" {
    var entropy_counter: u8             = 5;
    var entropy:         secret.Entropy = secret.Entropy{context: ?entropy_counter,
        secret_context: nil, fill_fn: deterministic_entropy, initialized: true};
    var anchor:    cert.Certificate       = cert.Certificate{der: "x"::*u8, der_len: 1};
    var trust:     cert.TrustStore        = cert.TrustStore{anchors: ?anchor, len: 1};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{
        tls13.ED25519
    };
    var configuration: config.ClientConfig;
    configuration.server_name = contracts.Bytes{
        data: "api.example.com"::*u8, len: 15
    };
    configuration.alpn                            = ?protocols[0];
    configuration.alpn_len                        = 1;
    configuration.trust                           = ?trust;
    configuration.versions                        = ?versions[0];
    configuration.version_len                     = 1;
    configuration.suites                          = ?suites[0];
    configuration.suite_len                       = 1;
    configuration.groups                          = ?groups[0];
    configuration.group_len                       = 1;
    configuration.signatures                      = ?signatures[0];
    configuration.signature_len                   = 1;
    configuration.entropy                         = ?entropy;
    configuration.entropy_context_size            = 1;
    configuration.limits                          = config.production_limits();
    configuration.limits.max_peer_handshake_bytes = 4096;
    configuration.limits.max_chain_bytes          = 3072;
    configuration.limits.max_ticket_bytes         = 4096;
    val memory:      buffer.Lease = pool.shared();
    var empty_extra: ExtraExtension;
    var value:       Handshake;
    if (!init(?value, ?configuration, memory, empty_extra, 0))        { ret 1; }
    if (start(?value, clock.at(1787875200, 1787875200)).status != OK) { ret 4; }
    var event: engine.Event;
    if (!next_event(?value, ?event) || event.kind != CRYPTO ||
        !complete_event(?value, event.token, true)) { ret 2; }
    var illegal: [4]u8         = [4]u8{handshake.NEW_SESSION_TICKET, 0, 0, 0};
    val failed:  engine.Result = ingest(?value, INITIAL, ?illegal[0], 4);
    if (failed.status != FAILED || failed.error != error.UNEXPECTED_MESSAGE ||
        !next_event(?value, ?event) || event.kind != ALERT ||
        event.alert != record.UNEXPECTED_MESSAGE_ALERT ||
        !complete_event(?value, event.token, true) ||
        complete_event(?value, event.token, true) || !destroy(?value)) { ret 3; }
    ret 0;
}

fun hex_nibble(value: u8, output: *u8) bool {
    if (value >= '0' && value <= '9') {
        output[0] = value - '0';
        ret true;
    }
    if (value >= 'a' && value <= 'f') {
        output[0] = value - 'a' + 10;
        ret true;
    }
    ret false;
}

fun decode_hex(input: *u8, length: usize, output: *u8,
    capacity: usize) bool {
    if (input == nil || output == nil || (length & 1) != 0 ||
        length / 2 > capacity) { ret false; }
    var i: usize = 0;
    for (i < length / 2) {
        var high: u8;
        var low:  u8;
        if (!hex_nibble(input[i * 2], ?high) ||
            !hex_nibble(input[i * 2 + 1], ?low)) { ret false; }
        output[i] = (high << 4) | low;
        i         = i + 1;
    }
    ret true;
}

fun secrets_equal(first: contracts.SecretBytes,
    second: contracts.SecretBytes) bool {
    if (first.len != second.len || first.data == nil || second.data == nil) {
        ret false;
    }
    var i: usize = 0;
    for (i < first.len) {
        if (first.data[i]:>u8 != second.data[i]:>u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "client: complete authenticated rfc 8446 flight has exact traffic transitions" {
    val root_hex: *u8 = ""::*u8;
    val leaf_hex: *u8 = ""::*u8;
    var root_der: [341]u8;
    var leaf_der: [393]u8;
    if (!decode_hex(root_hex, 682, ?root_der[0], 341) ||
        !decode_hex(leaf_hex, 786, ?leaf_der[0], 393)) { ret 1; }
    var anchor:             cert.Certificate = cert.Certificate{der: ?root_der[0], der_len: 341};
    var trust:              cert.TrustStore  = cert.TrustStore{anchors: ?anchor, len: 1};
    var client_certificate: cert.Certificate = cert.Certificate{
        der: ?leaf_der[0], der_len: 393
    };
    var client_chain: cert.Chain = cert.Chain{certificates: ?client_certificate, len: 1};
    var key_der:      [48]^u8    = [48]^u8{
        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06,
        0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20,
        0xeb, 0x3b, 0x8b, 0xa3, 0x21, 0x67, 0x09, 0xef,
        0x29, 0x39, 0x0e, 0x9c, 0x43, 0x84, 0x01, 0xbe,
        0xca, 0x3f, 0xf8, 0x03, 0x7d, 0x60, 0xbb, 0x30,
        0x42, 0x18, 0xc8, 0x8c, 0xd4, 0xb7, 0x9b, 0x72,
    };
    var owner:      secret.Allocator = secret.system_allocator();
    var client_key: keys.PrivateKey  = keys.empty_private();
    val loaded_key: contracts.Error  = load.private_der(
        contracts.SecretBytes{data: ?key_der[0], len: 48}, cert.PKCS8_DER,
        ?owner, ?client_key);
    ct.zeroize(?key_der[0], 48);
    if (loaded_key != contracts.OK) { ret 39; }
    var client_identity: credentials.Identity = credentials.Identity{
        server_name: contracts.Bytes{data: nil, len: 0},
        chain:       client_chain, private_key: ?client_key
    };
    var entropy_counter: u8             = 7;
    var entropy:         secret.Entropy = secret.Entropy{context: ?entropy_counter,
        secret_context: nil, fill_fn: deterministic_entropy, initialized: true};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:        [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures:    [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{tls13.ED25519};
    var configuration: config.ClientConfig;
    configuration.server_name = contracts.Bytes{
        data: "api.example.com"::*u8, len: 15
    };
    configuration.alpn                            = ?protocols[0];
    configuration.alpn_len                        = 1;
    configuration.trust                           = ?trust;
    configuration.versions                        = ?versions[0];
    configuration.version_len                     = 1;
    configuration.suites                          = ?suites[0];
    configuration.suite_len                       = 1;
    configuration.groups                          = ?groups[0];
    configuration.group_len                       = 1;
    configuration.signatures                      = ?signatures[0];
    configuration.signature_len                   = 1;
    configuration.client_identity                 = ?client_identity;
    configuration.entropy                         = ?entropy;
    configuration.entropy_context_size            = 1;
    configuration.limits                          = config.production_limits();
    configuration.limits.max_peer_handshake_bytes = 4096;
    configuration.limits.max_chain_bytes          = 3072;
    configuration.limits.max_ticket_bytes         = 4096;
    val memory:            buffer.Lease   = pool.shared();
    var client_parameters: [2]u8          = [2]u8{0x01, 0x02};
    val client_extra:      ExtraExtension = ExtraExtension{
        kind: QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?client_parameters[0], len: 2}
    };
    var value: Handshake;
    if (!init(?value, ?configuration, memory, client_extra,
        QUIC_TRANSPORT_PARAMETERS) ||
        start(?value, clock.at(1800000000, 1800000000)).status != OK) { ret 2; }
    var event: engine.Event;
    if (!next_event(?value, ?event) || event.kind != CRYPTO) { ret 3; }
    var server_transcript: transcript.Transcript = transcript.empty();
    if (transcript.init_for_suite(?server_transcript,
        tls13.AES_128_GCM_SHA256) != error.OK ||
        transcript.update_frame(?server_transcript, event.data) != error.OK) { ret 4; }
    var client_hello_message: handshake.Message;
    if (handshake.parse(event.data.data, event.data.len, 4096,
        ?client_hello_message).status != handshake.COMPLETE) { ret 5; }
    var client_hello: codec.ClientHello;
    if (codec.decode_client_hello(?client_hello_message, false,
        ?client_hello) != error.OK) { ret 6; }
    val client_public: contracts.Bytes = contracts.Bytes{
        data: ?value.public_key[0], len: value.public_key_len
    };
    if (!complete_event(?value, event.token, true)) { ret 8; }

    var server_private: [32]^u8;
    var i:              usize = 0;
    for (i < 32) {
        server_private[i] = (0xa0 + i)::u8;
        i                 = i + 1;
    }
    var server_public: [32]u8;
    if (x25519.derive_public(contracts.SecretBytes{data: ?server_private[0], len: 32},
        contracts.Buffer{data: ?server_public[0], capacity: 32}).error != contracts.OK) {
        ret 9;
    }
    var shared: [32]^u8;
    if (x25519.agree(contracts.SecretBytes{data: ?server_private[0], len: 32},
        client_public, contracts.SecretBuffer{data: ?shared[0], capacity: 32}).error !=
        contracts.OK) { ret 10; }
    var server_extensions: [46]u8;
    server_extensions[0]  = 0;
    server_extensions[1]  = 43;
    server_extensions[2]  = 0;
    server_extensions[3]  = 2;
    server_extensions[4]  = 3;
    server_extensions[5]  = 4;
    server_extensions[6]  = 0;
    server_extensions[7]  = 51;
    server_extensions[8]  = 0;
    server_extensions[9]  = 36;
    server_extensions[10] = 0;
    server_extensions[11] = 29;
    server_extensions[12] = 0;
    server_extensions[13] = 32;
    copy_bytes(?server_extensions[14], ?server_public[0], 32);
    var server_random: [32]u8;
    for (i < 32) {
        server_random[i] = (0x40 + i)::u8;
        i                = i + 1;
    }
    var server_hello: codec.ServerHello;
    server_hello.legacy_version     = tls13.LEGACY_VERSION;
    server_hello.random             = contracts.Bytes{data: ?server_random[0], len: 32};
    server_hello.legacy_session_id  = contracts.Bytes{data: ?value.session_id[0], len: 32};
    server_hello.cipher_suite       = tls13.AES_128_GCM_SHA256;
    server_hello.compression_method = 0;
    server_hello.extensions         = extensions.list(?server_extensions[0], 46,
        extensions.SERVER_HELLO);
    server_hello.retry = false;
    var flight:  [1024]u8;
    var encoded: handshake.Progress = codec.encode_server_hello(?server_hello,
        contracts.Buffer{data: ?flight[0], capacity: 1024});
    if (encoded.status != handshake.COMPLETE ||
        transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?flight[0], len: encoded.produced}) != error.OK) { ret 11; }
    var hash: [48]u8;
    if (transcript.snapshot(?server_transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK) { ret 12; }
    var server_schedule: key_schedule.Schedule;
    if (key_schedule.init(?server_schedule, tls13.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: nil, len: 0}) != error.OK ||
        key_schedule.advance_handshake(?server_schedule,
        contracts.SecretBytes{data: ?shared[0], len: 32},
        contracts.Bytes{data: ?hash[0], len: 32}) != error.OK) { ret 13; }
    ct.zeroize(?shared[0], 32);
    ct.zeroize(?server_private[0], 32);
    if (ingest(?value, INITIAL, ?flight[0], encoded.produced).status != OK) { ret 14; }
    var traffic_events: usize = 0;
    for (next_event(?value, ?event)) {
        if (event.kind != TRAFFIC_SECRET || event.level != HANDSHAKE) { ret 15; }
        var expected: contracts.SecretBytes = key_schedule.bytes(
            ?server_schedule.server_handshake_traffic);
        if (event.direction == SEND) {
            expected = key_schedule.bytes(?server_schedule.client_handshake_traffic);
        }
        if (!secrets_equal(event.secret, expected) ||
            !complete_event(?value, event.token, true)) { ret 16; }
        traffic_events = traffic_events + 1;
    }
    if (traffic_events != 2) { ret 17; }

    var encrypted_extensions: [17]u8 = [17]u8{
        0, 16, 0, 5, 0, 3, 2, 'h', '2',
        0, 57, 0, 4, 0x11, 0x22, 0x33, 0x44,
    };
    encoded = codec.encode_extension_message(handshake.ENCRYPTED_EXTENSIONS,
        extensions.list(?encrypted_extensions[0], 17,
        extensions.ENCRYPTED_EXTENSIONS),
        contracts.Buffer{data: ?flight[0], capacity: 1024});
    if (encoded.status != handshake.COMPLETE ||
        transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?flight[0], len: encoded.produced}) != error.OK ||
        ingest(?value, HANDSHAKE, ?flight[0], encoded.produced).status != OK) { ret 18; }
    if (!next_event(?value, ?event) || event.kind != PEER_PARAMETERS ||
        event.data.len != 4 || event.data.data[0] != 0x11 ||
        !complete_event(?value, event.token, true)) { ret 47; }
    zero_bytes(value.buffers.input.chunk.data, value.buffers.input.chunk.bytes);
    if (snapshot(?value).peer_parameters.len != 4 ||
        snapshot(?value).peer_parameters.data[3] != 0x44 ||
        snapshot(?value).selected_alpn.data[0] != 'h') { ret 48; }
    if (!next_event(?value, ?event) || event.kind != EARLY_DATA ||
        event.disposition != EARLY_NOT_OFFERED ||
        !complete_event(?value, event.token, true)) { ret 19; }

    var request_extensions: [8]u8 = [8]u8{0, 13, 0, 4, 0, 2, 8, 7};
    var request:            codec.CertificateRequest;
    request.context    = contracts.Bytes{data: nil, len: 0};
    request.extensions = extensions.list(?request_extensions[0], 8,
        extensions.CERTIFICATE_REQUEST);
    encoded = codec.encode_certificate_request(?request,
        contracts.Buffer{data: ?flight[0], capacity: 1024});
    if (encoded.status != handshake.COMPLETE ||
        transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?flight[0], len: encoded.produced}) != error.OK ||
        ingest(?value, HANDSHAKE, ?flight[0], encoded.produced).status != MORE ||
        !value.client_auth_requested || value.client_auth_scheme != tls13.ED25519) {
        ret 40;
    }

    var certificate_entries: [398]u8;
    write_u24(?certificate_entries[0], 0, 393);
    copy_bytes(?certificate_entries[3], ?leaf_der[0], 393);
    write_u16(?certificate_entries[0], 396, 0);
    var certificate_message: codec.CertificateMessage;
    certificate_message.context = contracts.Bytes{data: nil, len: 0};
    certificate_message.entries = contracts.Bytes{data: ?certificate_entries[0], len: 398};
    certificate_message.count   = 1;
    encoded                     = codec.encode_certificate(?certificate_message, false,
        contracts.Buffer{data: ?flight[0], capacity: 1024});
    if (encoded.status != handshake.COMPLETE) { ret 201; }
    if (transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?flight[0], len: encoded.produced}) != error.OK) { ret 202; }
    val certificate_result: engine.Result = ingest(?value, HANDSHAKE, ?flight[0], encoded.produced);
    if (certificate_result.status != MORE) { ret 220 + certificate_result.error::i32; }
    zero_bytes(value.buffers.input.chunk.data, value.buffers.input.chunk.bytes);

    if (transcript.snapshot(?server_transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK) { ret 21; }
    var client_hash: [48]u8;
    if (transcript.snapshot(?value.transcript,
        contracts.Buffer{data: ?client_hash[0], capacity: 48}) != error.OK ||
        !bytes_equal(contracts.Bytes{data: ?hash[0], len: 32},
        contracts.Bytes{data: ?client_hash[0], len: 32})) { ret 36; }
    var signed: [MAX_SIGNED_CONTEXT]u8;
    i = 0;
    for (i < 64) {
        signed[i] = 0x20;
        i         = i + 1;
    }
    copy_bytes(?signed[64], "TLS 1.3, server CertificateVerify"::*u8, 33);
    signed[97] = 0;
    copy_bytes(?signed[98], ?hash[0], 32);
    var leaf_private: [32]^u8 = [32]^u8{
        0xeb, 0x3b, 0x8b, 0xa3, 0x21, 0x67, 0x09, 0xef,
        0x29, 0x39, 0x0e, 0x9c, 0x43, 0x84, 0x01, 0xbe,
        0xca, 0x3f, 0xf8, 0x03, 0x7d, 0x60, 0xbb, 0x30,
        0x42, 0x18, 0xc8, 0x8c, 0xd4, 0xb7, 0x9b, 0x72,
    };
    var signature_bytes:     [64]u8;
    val signature_operation: contracts.Operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?leaf_private[0], len: 32},
        contracts.Bytes{data: ?signed[0], len: 130},
        contracts.Buffer{data: ?signature_bytes[0], capacity: 64});
    ct.zeroize(?leaf_private[0], 32);
    if (signature_operation.error != contracts.OK || signature_operation.written != 64) {
        ret 22;
    }
    var certificate_verify: codec.CertificateVerify;
    certificate_verify.scheme    = tls13.ED25519;
    certificate_verify.signature = contracts.Bytes{data: ?signature_bytes[0], len: 64};
    var client_signed: [MAX_SIGNED_CONTEXT]u8;
    if (certificate_verify_input(?value, true, ?client_signed[0]) != error.OK ||
        !bytes_equal(contracts.Bytes{data: ?signed[0], len: 130},
        contracts.Bytes{data: ?client_signed[0], len: 130})) { ret 38; }
    signature_bytes[0] = signature_bytes[0] ^ 1;
    if (verify_peer_signature(?value, ?certificate_verify) != error.DECRYPT_ERROR) {
        ret 46;
    }
    signature_bytes[0] = signature_bytes[0] ^ 1;
    if (verify_peer_signature(?value, ?certificate_verify) != error.OK) { ret 37; }
    encoded = codec.encode_certificate_verify(?certificate_verify,
        contracts.Buffer{data: ?flight[0], capacity: 1024});
    if (encoded.status != handshake.COMPLETE) { ret 231; }
    if (signature.verify_ed25519(value.peer_leaf.public_key.first,
        contracts.Bytes{data: ?signed[0], len: 130},
        contracts.Bytes{data: ?signature_bytes[0], len: 64}) != contracts.OK) { ret 232; }
    if (transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?flight[0], len: encoded.produced}) != error.OK) { ret 233; }
    val verify_result: engine.Result = ingest(?value, HANDSHAKE, ?flight[0], encoded.produced);
    if (verify_result.status != MORE) { ret 240 + verify_result.error::i32; }

    if (transcript.snapshot(?server_transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK) { ret 24; }
    var verify_data: [48]u8;
    if (key_schedule.finished(?server_schedule,
        ?server_schedule.server_handshake_traffic,
        contracts.Bytes{data: ?hash[0], len: 32},
        contracts.Buffer{data: ?verify_data[0], capacity: 48}) != error.OK) { ret 25; }
    var finished: codec.Finished;
    finished.verify_data = contracts.Bytes{data: ?verify_data[0], len: 32};
    encoded              = codec.encode_finished(?finished,
        contracts.Buffer{data: ?flight[0], capacity: 1024});
    if (encoded.status != handshake.COMPLETE ||
        transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?flight[0], len: encoded.produced}) != error.OK) { ret 26; }
    if (transcript.snapshot(?server_transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK ||
        key_schedule.advance_application(?server_schedule,
        contracts.Bytes{data: ?hash[0], len: 32}) != error.OK) { ret 27; }
    i = 0;
    for (i < encoded.produced) {
        val fragmented: engine.Result = ingest(?value, HANDSHAKE, ?flight[i], 1);
        if (fragmented.consumed != 1 ||
            (i + 1 < encoded.produced && fragmented.status != MORE)) { ret 28; }
        i = i + 1;
    }
    if (!next_event(?value, ?event) || event.kind != CRYPTO ||
        event.level != HANDSHAKE) { ret 29; }
    var client_offset:  usize              = 0;
    var client_message: handshake.Message;
    var parsed_client:  handshake.Progress = handshake.parse(event.data.data,
        event.data.len, 4096, ?client_message);
    if (parsed_client.status != handshake.COMPLETE ||
        client_message.header.message_type != handshake.CERTIFICATE) { ret 30; }
    var sent_certificate: codec.CertificateMessage;
    if (codec.decode_certificate(?client_message, true, ?sent_certificate) != error.OK ||
        sent_certificate.count != 1 ||
        transcript.update_frame(?server_transcript,
        contracts.Bytes{data: event.data.data, len: parsed_client.consumed}) != error.OK) {
        ret 41;
    }
    client_offset = parsed_client.consumed;
    parsed_client = handshake.parse(?event.data.data[client_offset],
        event.data.len - client_offset, 4096, ?client_message);
    if (parsed_client.status != handshake.COMPLETE ||
        client_message.header.message_type != handshake.CERTIFICATE_VERIFY) { ret 42; }
    var sent_verify: codec.CertificateVerify;
    if (codec.decode_certificate_verify(?client_message, ?sent_verify) != error.OK ||
        transcript.snapshot(?server_transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK) { ret 43; }
    i = 0;
    for (i < 64) {
        signed[i] = 0x20;
        i         = i + 1;
    }
    copy_bytes(?signed[64], "TLS 1.3, client CertificateVerify"::*u8, 33);
    signed[97] = 0;
    copy_bytes(?signed[98], ?hash[0], 32);
    if (signature.verify_ed25519(value.peer_leaf.public_key.first,
        contracts.Bytes{data: ?signed[0], len: 130}, sent_verify.signature) != contracts.OK ||
        transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?event.data.data[client_offset],
        len: parsed_client.consumed}) != error.OK) { ret 44; }
    client_offset = client_offset + parsed_client.consumed;
    parsed_client = handshake.parse(?event.data.data[client_offset],
        event.data.len - client_offset, 4096, ?client_message);
    if (parsed_client.status != handshake.COMPLETE ||
        client_offset + parsed_client.consumed != event.data.len ||
        client_message.header.message_type != handshake.FINISHED) { ret 45; }
    var client_finished: codec.Finished;
    if (codec.decode_finished(?client_message, 32, ?client_finished) != error.OK ||
        transcript.snapshot(?server_transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK ||
        key_schedule.verify_finished(?server_schedule,
        ?server_schedule.client_handshake_traffic,
        contracts.Bytes{data: ?hash[0], len: 32},
        client_finished.verify_data) != error.OK ||
        transcript.update_frame(?server_transcript,
        contracts.Bytes{data: ?event.data.data[client_offset],
        len: parsed_client.consumed}) != error.OK ||
        !complete_event(?value, event.token, true)) { ret 31; }
    var application_events:  usize = 0;
    var authentication_seen: bool  = false;
    var complete_seen:       bool  = false;
    for (next_event(?value, ?event)) {
        if (event.kind == AUTHENTICATION) {
            authentication_seen = event.disposition == AUTHENTICATED;
        }
        or (event.kind == TRAFFIC_SECRET && event.level == APPLICATION) {
            var expected: contracts.SecretBytes = key_schedule.bytes(
                ?server_schedule.server_application_traffic);
            if (event.direction == SEND) {
                expected = key_schedule.bytes(?server_schedule.client_application_traffic);
            }
            if (!secrets_equal(event.secret, expected)) { ret 32; }
            application_events = application_events + 1;
        }
        or (event.kind == HANDSHAKE_COMPLETE) {
            complete_seen = true;
        }
        if (!complete_event(?value, event.token, true)) { ret 33; }
    }
    if (!authentication_seen || !complete_seen || application_events != 2 ||
        snapshot(?value).status != COMPLETE) {
        ret 34;
    }
    # the drained handshake handed over to the core, which under quic keeps no
    # application secret since quic never updates tls keys
    if (!value.delegating || value.schedule.master_secret.active ||
        value.schedule.resumption_ready || value.core.send.active ||
        value.core.receive.active || !value.core.quic) { ret 40; }
    transcript.destroy(?server_transcript);
    key_schedule.destroy(?server_schedule);
    if (!destroy(?value) || keys.destroy_private(?client_key) != contracts.OK) { ret 35; }
    ret 0;
}
