# bounded client and server configuration

use crypto.contracts;
use crypto.secret;
use std.types.bool.bool;
use std.types.size.usize;
use tls.cert;
use tls.cert.credentials;
use tls.session;
use tls.tls13;

pub val MAX_SIGNATURE_SCHEMES: usize = 5;

pub fun valid_signature_count(value: usize) bool {
    ret value > 0 && value <= MAX_SIGNATURE_SCHEMES;
}

pub rec ProtocolName {
    data: *u8;
    len:  usize;
}

pub rec Limits {
    max_receive_record_plaintext: usize;
    max_send_record_plaintext:    usize;
    max_peer_handshake_bytes:     usize;
    max_client_hello_bytes:       usize;
    max_client_flight_bytes:      usize;
    max_server_flight_bytes:      usize;
    max_chain_bytes:              usize;
    max_ticket_bytes:             usize;
}

pub rec ClientConfig {
    server_name:          contracts.Bytes;
    alpn:                 *ProtocolName;
    alpn_len:             usize;
    trust:                *cert.TrustStore;
    versions:             *u16;
    version_len:          usize;
    suites:               *tls13.CipherSuite;
    suite_len:            usize;
    groups:               *tls13.NamedGroup;
    group_len:            usize;
    signatures:           *tls13.SignatureScheme;
    signature_len:        usize;
    client_identity:      *credentials.Identity;
    entropy:              *secret.Entropy;
    entropy_context_size: usize;
    sessions:             *session.ClientStore;
    limits:               Limits;
}

# client authentication policy belongs to the published credential generation,
# so the listener configuration deliberately does not restate it
pub rec ServerConfig {
    credentials:            *credentials.Store;
    alpn:                   *ProtocolName;
    alpn_len:               usize;
    require_alpn:           bool;
    versions:               *u16;
    version_len:            usize;
    suites:                 *tls13.CipherSuite;
    suite_len:              usize;
    groups:                 *tls13.NamedGroup;
    group_len:              usize;
    signatures:             *tls13.SignatureScheme;
    signature_len:          usize;
    entropy:                *secret.Entropy;
    entropy_context_size:   usize;
    tickets:                *session.KeyRing;
    replay:                 *session.ReplayWindow;
    replay_policy:          session.ReplayPolicy;
    tickets_per_connection: u8;
    limits:                 Limits;
}

# a value cleared by declaration rather than by an empty literal: a record
# literal leaves every field it does not name holding the previous stack
# frame's contents (briar-systems/mach#3108)
pub fun no_client_config() ClientConfig {
    var value: ClientConfig;
    ret value;
}

pub fun no_server_config() ServerConfig {
    var value: ServerConfig;
    ret value;
}

pub fun no_entropy() secret.Entropy {
    var value: secret.Entropy;
    ret value;
}

pub fun production_limits() Limits {
    var limits: Limits;
    limits.max_receive_record_plaintext = 16384;
    limits.max_send_record_plaintext    = 16384;
    limits.max_peer_handshake_bytes     = 1048576;
    limits.max_client_hello_bytes       = 65536;
    limits.max_client_flight_bytes      = 525312;
    limits.max_server_flight_bytes      = 525312;
    limits.max_chain_bytes              = 524288;
    limits.max_ticket_bytes             = 16384;
    ret limits;
}

test "config: default limits are finite and protocol conforming" {
    val limits: Limits = production_limits();
    if (limits.max_receive_record_plaintext != 16384 ||
        limits.max_send_record_plaintext != 16384) { ret 1; }
    if (limits.max_peer_handshake_bytes <= 4 ||
        limits.max_client_hello_bytes == 0 ||
        limits.max_client_flight_bytes == 0 ||
        limits.max_server_flight_bytes == 0 ||
        limits.max_chain_bytes == 0) { ret 1; }
    ret 0;
}

test "config: all verification schemes fit one bounded policy" {
    if (!valid_signature_count(MAX_SIGNATURE_SCHEMES) ||
        valid_signature_count(0) ||
        valid_signature_count(MAX_SIGNATURE_SCHEMES + 1)) { ret 1; }
    ret 0;
}
