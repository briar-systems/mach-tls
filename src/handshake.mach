# incremental tls handshake framing

use crypto.contracts;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.error;

pub def MessageType:    u8;
pub def ProgressStatus: u8;

pub val CLIENT_HELLO:         MessageType = 1;
pub val SERVER_HELLO:         MessageType = 2;
pub val NEW_SESSION_TICKET:   MessageType = 4;
pub val END_OF_EARLY_DATA:    MessageType = 5;
pub val ENCRYPTED_EXTENSIONS: MessageType = 8;
pub val CERTIFICATE:          MessageType = 11;
pub val CERTIFICATE_REQUEST:  MessageType = 13;
pub val CERTIFICATE_VERIFY:   MessageType = 15;
pub val FINISHED:             MessageType = 20;
pub val KEY_UPDATE:           MessageType = 24;
pub val MESSAGE_HASH:         MessageType = 254;

pub val HELLO_REQUEST:       MessageType = 0;
pub val SERVER_KEY_EXCHANGE: MessageType = 12;
pub val SERVER_HELLO_DONE:   MessageType = 14;
pub val CLIENT_KEY_EXCHANGE: MessageType = 16;

pub val PROGRESSED:  ProgressStatus = 0;
pub val NEED_INPUT:  ProgressStatus = 1;
pub val NEED_OUTPUT: ProgressStatus = 2;
pub val COMPLETE:    ProgressStatus = 3;
pub val REJECTED:    ProgressStatus = 4;

pub val HEADER_SIZE:   usize = 4;
pub val MAX_BODY_SIZE: usize = 0xFFFFFF;

pub rec Header {
    message_type: MessageType;
    length:       u32;
}

pub rec Message {
    header: Header;
    body:   contracts.Bytes;
}

pub rec Progress {
    status:   ProgressStatus;
    consumed: usize;
    produced: usize;
    required: usize;
    error:    error.Error;
}

fun known_message_type(message_type: MessageType) bool {
    ret message_type == CLIENT_HELLO || message_type == SERVER_HELLO
        || message_type == NEW_SESSION_TICKET || message_type == END_OF_EARLY_DATA
        || message_type == ENCRYPTED_EXTENSIONS || message_type == CERTIFICATE
        || message_type == CERTIFICATE_REQUEST || message_type == CERTIFICATE_VERIFY
        || message_type == FINISHED || message_type == KEY_UPDATE
        || message_type == MESSAGE_HASH;
}

fun known_tls12_message_type(message_type: MessageType) bool {
    ret message_type == HELLO_REQUEST || message_type == CLIENT_HELLO
        || message_type == SERVER_HELLO || message_type == CERTIFICATE
        || message_type == SERVER_KEY_EXCHANGE
        || message_type == CERTIFICATE_REQUEST
        || message_type == SERVER_HELLO_DONE
        || message_type == CERTIFICATE_VERIFY
        || message_type == CLIENT_KEY_EXCHANGE || message_type == FINISHED;
}

fun read_u24(data: *u8) u32 {
    ret (data[0]::u32 << 16) | (data[1]::u32 << 8) | data[2]::u32;
}

fun write_u24(data: *u8, value: u32) {
    data[0] = (value >> 16)::u8;
    data[1] = (value >> 8)::u8;
    data[2] = value::u8;
}

fun progress(status: ProgressStatus, consumed: usize, produced: usize,
    required: usize, failure: error.Error) Progress {
    ret Progress{
        status:   status,
        consumed: consumed,
        produced: produced,
        required: required,
        error:    failure,
    };
}

# parse one complete handshake frame without consuming partial input
pub fun parse(input: *u8, length: usize, limit: usize, output: *Message) Progress {
    ret parse_version(input, length, limit, false, output);
}

# the tls 1.2 message set is disjoint enough that each version keeps its own
pub fun parse_version(input: *u8, length: usize, limit: usize, tls12: bool,
    output: *Message) Progress {
    if (output == nil || (length != 0 && input == nil) || limit > MAX_BODY_SIZE) {
        ret progress(REJECTED, 0, 0, 0, error.ILLEGAL_PARAMETER);
    }
    if (length < HEADER_SIZE) {
        ret progress(NEED_INPUT, 0, 0, HEADER_SIZE, error.OK);
    }
    val message_type: MessageType = input[0];
    var known:        bool        = known_message_type(message_type);
    if (tls12) { known = known_tls12_message_type(message_type); }
    if (!known) {
        ret progress(REJECTED, 0, 0, HEADER_SIZE, error.UNEXPECTED_MESSAGE);
    }
    val body_length: usize = read_u24(?input[1])::usize;
    if (body_length > limit) {
        ret progress(REJECTED, 0, 0, HEADER_SIZE + body_length, error.RESOURCE_LIMIT);
    }
    val total: usize = HEADER_SIZE + body_length;
    if (length < total) {
        ret progress(NEED_INPUT, 0, 0, total, error.OK);
    }
    output.header.message_type = message_type;
    output.header.length       = body_length::u32;
    output.body.data           = nil;
    output.body.len            = body_length;
    if (body_length != 0) { output.body.data = ?input[HEADER_SIZE]; }
    ret progress(COMPLETE, total, 0, total, error.OK);
}

# serialize one frame transactionally into caller-owned storage
pub fun serialize(message_type: MessageType, body: contracts.Bytes,
    output: contracts.Buffer) Progress {
    ret serialize_version(message_type, body, false, output);
}

pub fun serialize_version(message_type: MessageType, body: contracts.Bytes,
    tls12: bool, output: contracts.Buffer) Progress {
    var known: bool = known_message_type(message_type);
    if (tls12) { known = known_tls12_message_type(message_type); }
    if (!known || (body.len != 0 && body.data == nil)
        || body.len > MAX_BODY_SIZE || (output.capacity != 0 && output.data == nil)) {
        ret progress(REJECTED, 0, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val required: usize = HEADER_SIZE + body.len;
    if (output.capacity < required) {
        ret progress(NEED_OUTPUT, 0, 0, required, error.OK);
    }
    output.data[0] = message_type;
    write_u24(?output.data[1], body.len::u32);
    var i: usize = 0;
    for (i < body.len) {
        output.data[HEADER_SIZE + i] = body.data[i];
        i                            = i + 1;
    }
    ret progress(COMPLETE, body.len, required, required, error.OK);
}

test handshake__framing_is_incremental_and_transactional {
    var body: [3]u8 = [3]u8{1, 2, 3};
    var wire: [8]u8;
    var i:    usize = 0;
    for (i < 8) {
        wire[i] = 0xcc;
        i       = i + 1;
    }
    val small: Progress = serialize(CLIENT_HELLO,
        contracts.Bytes{data: ?body[0], len: 3},
        contracts.Buffer{data: ?wire[0], capacity: 6});
    if (small.status != NEED_OUTPUT || small.required != 7 || wire[0] != 0xcc) { ret 1; }
    val encoded: Progress = serialize(CLIENT_HELLO,
        contracts.Bytes{data: ?body[0], len: 3},
        contracts.Buffer{data: ?wire[0], capacity: 8});
    if (encoded.status != COMPLETE || encoded.produced != 7
        || wire[0] != CLIENT_HELLO || wire[3] != 3) { ret 2; }
    var message: Message;
    i = 0;
    for (i < 7) {
        val partial: Progress = parse(?wire[0], i, 16, ?message);
        if (partial.status != NEED_INPUT || partial.consumed != 0) { ret 3; }
        i = i + 1;
    }
    val decoded: Progress = parse(?wire[0], 7, 16, ?message);
    if (decoded.status != COMPLETE || decoded.consumed != 7
        || message.header.message_type != CLIENT_HELLO || message.body.len != 3
        || message.body.data[0] != 1 || message.body.data[2] != 3) { ret 4; }
    ret 0;
}

test handshake__framing_rejects_unknown_types_and_bounded_bodies {
    var wire:    [4]u8 = [4]u8{99, 0, 0, 0};
    var message: Message;
    if (parse(?wire[0], 4, 16, ?message).error != error.UNEXPECTED_MESSAGE) { ret 1; }
    wire[0] = CERTIFICATE;
    wire[1] = 0;
    wire[2] = 1;
    wire[3] = 0;
    val bounded: Progress = parse(?wire[0], 4, 255, ?message);
    if (bounded.error != error.RESOURCE_LIMIT || bounded.required != 260) { ret 2; }
    ret 0;
}
