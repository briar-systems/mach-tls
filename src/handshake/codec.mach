# typed tls 1.3 handshake message codecs and negotiation

use crypto.contracts;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.error;
use tls.handshake;
use tls.handshake.extensions;
use tls.signature_scheme;
use tls.tls13;

pub val HELLO_RETRY_RANDOM: [32]u8 = [32]u8{
    0xcf, 0x21, 0xad, 0x74, 0xe5, 0x9a, 0x61, 0x11,
    0xbe, 0x1d, 0x8c, 0x02, 0x1e, 0x65, 0xb8, 0x91,
    0xc2, 0xa2, 0x11, 0x16, 0x7a, 0xbb, 0x8c, 0x5e,
    0x07, 0x9e, 0x09, 0xe2, 0xc8, 0xa8, 0x33, 0x9c,
};

pub val MAX_TICKET_LIFETIME:  u32 = 604800;
pub val UPDATE_NOT_REQUESTED: u8  = 0;
pub val UPDATE_REQUESTED:     u8  = 1;

rec Reader {
    data:   *u8;
    len:    usize;
    offset: usize;
    failed: bool;
}

rec Writer {
    data:   *u8;
    offset: usize;
}

pub rec ClientHello {
    legacy_version:      u16;
    random:              contracts.Bytes;
    legacy_session_id:   contracts.Bytes;
    cipher_suites:       contracts.Bytes;
    compression_methods: contracts.Bytes;
    extensions:          extensions.List;
    after_retry:         bool;
}

pub rec ServerHello {
    legacy_version:     u16;
    random:             contracts.Bytes;
    legacy_session_id:  contracts.Bytes;
    cipher_suite:       tls13.CipherSuite;
    compression_method: u8;
    extensions:         extensions.List;
    retry:              bool;
}

pub rec EncryptedExtensions {
    extensions: extensions.List;
}

pub rec CertificateRequest {
    context:    contracts.Bytes;
    extensions: extensions.List;
}

pub rec CertificateMessage {
    context: contracts.Bytes;
    entries: contracts.Bytes;
    count:   usize;
}

pub rec CertificateEntry {
    certificate: contracts.Bytes;
    extensions:  extensions.List;
}

pub rec CertificateIterator {
    data:   *u8;
    len:    usize;
    offset: usize;
    failed: bool;
}

pub rec CertificateVerify {
    scheme:    tls13.SignatureScheme;
    signature: contracts.Bytes;
}

pub rec Finished {
    verify_data: contracts.Bytes;
}

pub rec NewSessionTicket {
    lifetime:   u32;
    age_add:    u32;
    nonce:      contracts.Bytes;
    ticket:     contracts.Bytes;
    extensions: extensions.List;
}

pub rec KeyUpdate {
    request: u8;
}

fun reader(data: *u8, len: usize) Reader {
    ret Reader{data: data, len: len, offset: 0, failed: len != 0 && data == nil};
}

fun remaining(state: *Reader) usize {
    if (state == nil || state.failed || state.offset > state.len) { ret 0; }
    ret state.len - state.offset;
}

fun take(state: *Reader, length: usize) contracts.Bytes {
    var result: contracts.Bytes;
    result.len = length;
    if (state == nil || state.failed || state.offset > state.len
        || length > state.len - state.offset) {
        if (state != nil) { state.failed = true; }
        result.len = 0;
        ret result;
    }
    if (length != 0) { result.data = ?state.data[state.offset]; }
    state.offset = state.offset + length;
    ret result;
}

fun u8_value(state: *Reader) u8 {
    val bytes: contracts.Bytes = take(state, 1);
    if (state.failed) { ret 0; }
    ret bytes.data[0];
}

fun u16_value(state: *Reader) u16 {
    val bytes: contracts.Bytes = take(state, 2);
    if (state.failed) { ret 0; }
    ret (bytes.data[0]::u16 << 8) | bytes.data[1]::u16;
}

fun u24_value(state: *Reader) usize {
    val bytes: contracts.Bytes = take(state, 3);
    if (state.failed) { ret 0; }
    ret (bytes.data[0]::usize << 16) | (bytes.data[1]::usize << 8)
        | bytes.data[2]::usize;
}

fun u32_value(state: *Reader) u32 {
    val bytes: contracts.Bytes = take(state, 4);
    if (state.failed) { ret 0; }
    ret (bytes.data[0]::u32 << 24) | (bytes.data[1]::u32 << 16)
        | (bytes.data[2]::u32 << 8) | bytes.data[3]::u32;
}

fun vector8(state: *Reader) contracts.Bytes {
    val length: usize = u8_value(state)::usize;
    ret take(state, length);
}

fun vector16(state: *Reader) contracts.Bytes {
    val length: usize = u16_value(state)::usize;
    ret take(state, length);
}

fun vector24(state: *Reader) contracts.Bytes {
    val length: usize = u24_value(state);
    ret take(state, length);
}

fun complete(state: *Reader) bool {
    ret state != nil && !state.failed && state.offset == state.len;
}

fun put_u8(output: *Writer, value: u8) {
    output.data[output.offset] = value;
    output.offset              = output.offset + 1;
}

fun put_u16(output: *Writer, value: u16) {
    output.data[output.offset]     = (value >> 8)::u8;
    output.data[output.offset + 1] = value::u8;
    output.offset                  = output.offset + 2;
}

fun put_u24(output: *Writer, value: usize) {
    output.data[output.offset]     = (value >> 16)::u8;
    output.data[output.offset + 1] = (value >> 8)::u8;
    output.data[output.offset + 2] = value::u8;
    output.offset                  = output.offset + 3;
}

fun put_u32(output: *Writer, value: u32) {
    output.data[output.offset]     = (value >> 24)::u8;
    output.data[output.offset + 1] = (value >> 16)::u8;
    output.data[output.offset + 2] = (value >> 8)::u8;
    output.data[output.offset + 3] = value::u8;
    output.offset                  = output.offset + 4;
}

fun put_bytes(output: *Writer, value: contracts.Bytes) {
    var i: usize = 0;
    for (i < value.len) {
        output.data[output.offset + i] = value.data[i];
        i                              = i + 1;
    }
    output.offset = output.offset + value.len;
}

fun begin_message(output: *Writer, buffer: contracts.Buffer,
    message_type: handshake.MessageType, body_length: usize) {
    output.data   = buffer.data;
    output.offset = 0;
    put_u8(output, message_type);
    put_u24(output, body_length);
}

fun result(status: handshake.ProgressStatus, produced: usize,
    required: usize, failure: error.Error) handshake.Progress {
    ret handshake.Progress{
        status:   status,
        consumed: 0,
        produced: produced,
        required: required,
        error:    failure,
    };
}

fun prepare(message_type: handshake.MessageType, body_length: usize,
    output: contracts.Buffer) handshake.Progress {
    if (body_length > handshake.MAX_BODY_SIZE || (output.capacity != 0 && output.data == nil)) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val required: usize = handshake.HEADER_SIZE + body_length;
    if (output.capacity < required) {
        ret result(handshake.NEED_OUTPUT, 0, required, error.OK);
    }
    ret result(handshake.PROGRESSED, 0, required, error.OK);
}

pub fun valid_cipher_suite(suite: tls13.CipherSuite) bool {
    ret suite == tls13.AES_128_GCM_SHA256 || suite == tls13.AES_256_GCM_SHA384
        || suite == tls13.CHACHA20_POLY1305_SHA256;
}

pub fun valid_named_group(group: tls13.NamedGroup) bool {
    ret group == tls13.X25519 || group == tls13.SECP256R1;
}

pub fun valid_signature_scheme(scheme: tls13.SignatureScheme) bool {
    ret signature_scheme.valid_tls13(scheme);
}

fun hello_retry_random(random: contracts.Bytes) bool {
    if (random.len != 32 || random.data == nil) { ret false; }
    var i: usize = 0;
    for (i < 32) {
        if (random.data[i] != HELLO_RETRY_RANDOM[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun extension_u16_contains(extension: extensions.Extension, value: u16) bool {
    if (extension.len < 2) { ret false; }
    var offset: usize = 2;
    for (offset + 1 < extension.len) {
        if (((extension.data[offset]::u16 << 8) | extension.data[offset + 1]::u16) == value) {
            ret true;
        }
        offset = offset + 2;
    }
    ret false;
}

fun psk_mode(extension: extensions.Extension, mode: u8) bool {
    var i: usize = 1;
    for (i < extension.len) {
        if (extension.data[i] == mode) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun valid_client_combinations(value: *ClientHello) error.Error {
    var versions: extensions.Extension;
    if (!extensions.find(value.extensions, extensions.SUPPORTED_VERSIONS, ?versions)) {
        ret error.PROTOCOL_VERSION;
    }
    if (!extensions.offers_tls13(value.extensions)) { ret error.PROTOCOL_VERSION; }
    var groups:     extensions.Extension;
    val has_groups: bool = extensions.find(value.extensions, extensions.SUPPORTED_GROUPS, ?groups);
    var shares:     extensions.Extension;
    val has_shares: bool = extensions.find(value.extensions, extensions.KEY_SHARE, ?shares);
    var psk:        extensions.Extension;
    val has_psk:    bool = extensions.find(value.extensions, extensions.PRE_SHARED_KEY, ?psk);
    var modes:      extensions.Extension;
    val has_modes:  bool = extensions.find(value.extensions, extensions.PSK_KEY_EXCHANGE_MODES, ?modes);
    if (has_psk && !has_modes) { ret error.MISSING_EXTENSION; }
    if (extensions.contains(value.extensions, extensions.EARLY_DATA) && !has_psk) {
        ret error.ILLEGAL_PARAMETER;
    }
    if (!has_shares && (!has_psk || !psk_mode(modes, 0))) {
        ret error.MISSING_EXTENSION;
    }
    if (has_shares && !has_groups) { ret error.MISSING_EXTENSION; }
    if (has_shares) {
        var offset: usize = 2;
        var count:  usize = 0;
        for (offset < shares.len) {
            val group: u16 = (shares.data[offset]::u16 << 8)
                | shares.data[offset + 1]::u16;
            if (!extension_u16_contains(groups, group)) { ret error.ILLEGAL_PARAMETER; }
            val key_len: usize = (shares.data[offset + 2]::usize << 8)
                | shares.data[offset + 3]::usize;
            offset = offset + 4 + key_len;
            count  = count + 1;
        }
        if (value.after_retry && count != 1) { ret error.ILLEGAL_PARAMETER; }
    }
    if (!value.after_retry && extensions.contains(value.extensions, extensions.COOKIE)) {
        ret error.ILLEGAL_PARAMETER;
    }
    ret error.OK;
}

pub fun decode_client_hello(message: *handshake.Message, after_retry: bool,
    output: *ClientHello) error.Error {
    if (message == nil || output == nil || message.header.message_type != handshake.CLIENT_HELLO
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    var state: Reader = reader(message.body.data, message.body.len);
    output.legacy_version      = u16_value(?state);
    output.random              = take(?state, 32);
    output.legacy_session_id   = vector8(?state);
    output.cipher_suites       = vector16(?state);
    output.compression_methods = vector8(?state);
    val extension_bytes: contracts.Bytes = vector16(?state);
    output.extensions = extensions.list(extension_bytes.data, extension_bytes.len,
        extensions.CLIENT_HELLO);
    output.after_retry = after_retry;
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    if (output.legacy_version != tls13.LEGACY_VERSION || output.random.len != 32
        || output.legacy_session_id.len > 32 || output.cipher_suites.len < 2
        || (output.cipher_suites.len & 1) != 0 || output.compression_methods.len != 1
        || output.compression_methods.data[0] != 0) { ret error.ILLEGAL_PARAMETER; }
    val extension_error: error.Error = extensions.validate(output.extensions);
    if (extension_error != error.OK) { ret extension_error; }
    ret valid_client_combinations(output);
}

fun valid_server_combinations(value: *ServerHello) error.Error {
    if (!extensions.contains(value.extensions, extensions.SUPPORTED_VERSIONS)) {
        ret error.MISSING_EXTENSION;
    }
    val has_share: bool = extensions.contains(value.extensions, extensions.KEY_SHARE);
    val has_psk:   bool = extensions.contains(value.extensions, extensions.PRE_SHARED_KEY);
    if (value.retry) {
        if (has_psk || (!has_share && !extensions.contains(value.extensions, extensions.COOKIE))) {
            ret error.ILLEGAL_PARAMETER;
        }
    }
    or {
        if (!has_share && !has_psk) { ret error.MISSING_EXTENSION; }
    }
    ret error.OK;
}

pub fun decode_server_hello(message: *handshake.Message, output: *ServerHello) error.Error {
    if (message == nil || output == nil || message.header.message_type != handshake.SERVER_HELLO
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    var state: Reader = reader(message.body.data, message.body.len);
    output.legacy_version     = u16_value(?state);
    output.random             = take(?state, 32);
    output.legacy_session_id  = vector8(?state);
    output.cipher_suite       = u16_value(?state);
    output.compression_method = u8_value(?state);
    val extension_bytes: contracts.Bytes = vector16(?state);
    output.retry = hello_retry_random(output.random);
    var context: extensions.Context = extensions.SERVER_HELLO;
    if (output.retry) { context = extensions.HELLO_RETRY_REQUEST; }
    output.extensions = extensions.list(extension_bytes.data, extension_bytes.len, context);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    if (output.legacy_version != tls13.LEGACY_VERSION || output.random.len != 32
        || output.legacy_session_id.len > 32 || output.compression_method != 0
        || !valid_cipher_suite(output.cipher_suite)) { ret error.ILLEGAL_PARAMETER; }
    val extension_error: error.Error = extensions.validate(output.extensions);
    if (extension_error != error.OK) { ret extension_error; }
    ret valid_server_combinations(output);
}

fun decode_extension_message(message: *handshake.Message,
    expected: handshake.MessageType, context: extensions.Context,
    output: *extensions.List) error.Error {
    if (message == nil || output == nil || message.header.message_type != expected
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    var state: Reader          = reader(message.body.data, message.body.len);
    val bytes: contracts.Bytes = vector16(?state);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    output.data    = bytes.data;
    output.len     = bytes.len;
    output.context = context;
    ret extensions.validate(output[0]);
}

pub fun decode_encrypted_extensions(message: *handshake.Message,
    output: *EncryptedExtensions) error.Error {
    if (output == nil) { ret error.ILLEGAL_PARAMETER; }
    ret decode_extension_message(message, handshake.ENCRYPTED_EXTENSIONS,
        extensions.ENCRYPTED_EXTENSIONS, ?output.extensions);
}

pub fun decode_certificate_request(message: *handshake.Message,
    output: *CertificateRequest) error.Error {
    if (message == nil || output == nil
        || message.header.message_type != handshake.CERTIFICATE_REQUEST
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    var state: Reader = reader(message.body.data, message.body.len);
    output.context = vector8(?state);
    val bytes: contracts.Bytes = vector16(?state);
    output.extensions = extensions.list(bytes.data, bytes.len, extensions.CERTIFICATE_REQUEST);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    val extension_error: error.Error = extensions.validate(output.extensions);
    if (extension_error != error.OK) { ret extension_error; }
    if (!extensions.contains(output.extensions, extensions.SIGNATURE_ALGORITHMS)) {
        ret error.MISSING_EXTENSION;
    }
    ret error.OK;
}

fun inspect_certificate_entries(bytes: contracts.Bytes, allow_empty: bool,
    count: *usize) error.Error {
    if (count == nil || (bytes.len != 0 && bytes.data == nil)) { ret error.ILLEGAL_PARAMETER; }
    if (!allow_empty && bytes.len == 0)                        { ret error.BAD_CERTIFICATE; }
    var state:   Reader = reader(bytes.data, bytes.len);
    var entries: usize  = 0;
    for (remaining(?state) != 0) {
        val certificate:     contracts.Bytes = vector24(?state);
        val extension_bytes: contracts.Bytes = vector16(?state);
        if (state.failed || certificate.len == 0) { ret error.DECODE_ERROR; }
        val extension_list: extensions.List = extensions.list(extension_bytes.data,
            extension_bytes.len, extensions.CERTIFICATE_ENTRY);
        val extension_error: error.Error = extensions.validate(extension_list);
        if (extension_error != error.OK) { ret extension_error; }
        entries = entries + 1;
    }
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    count[0] = entries;
    ret error.OK;
}

pub fun decode_certificate(message: *handshake.Message, allow_empty: bool,
    output: *CertificateMessage) error.Error {
    if (message == nil || output == nil || message.header.message_type != handshake.CERTIFICATE
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    var state: Reader = reader(message.body.data, message.body.len);
    output.context = vector8(?state);
    output.entries = vector24(?state);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    ret inspect_certificate_entries(output.entries, allow_empty, ?output.count);
}

pub fun certificate_iterator(message: *CertificateMessage) CertificateIterator {
    if (message == nil) {
        ret CertificateIterator{data: nil, len: 0, offset: 0, failed: true};
    }
    ret CertificateIterator{data: message.entries.data, len: message.entries.len,
        offset: 0, failed: false};
}

pub fun next_certificate(state: *CertificateIterator, output: *CertificateEntry) extensions.NextStatus {
    if (state == nil || output == nil || state.failed || state.offset > state.len
        || (state.len != 0 && state.data == nil)) {
        if (state != nil) { state.failed = true; }
        ret extensions.NEXT_INVALID;
    }
    if (state.offset == state.len) { ret extensions.NEXT_DONE; }
    var body: Reader = reader(?state.data[state.offset], state.len - state.offset);
    output.certificate = vector24(?body);
    val extension_bytes: contracts.Bytes = vector16(?body);
    if (body.failed || output.certificate.len == 0) {
        state.failed = true;
        ret extensions.NEXT_INVALID;
    }
    output.extensions = extensions.list(extension_bytes.data, extension_bytes.len,
        extensions.CERTIFICATE_ENTRY);
    if (extensions.validate(output.extensions) != error.OK) {
        state.failed = true;
        ret extensions.NEXT_INVALID;
    }
    state.offset = state.offset + body.offset;
    ret extensions.NEXT_ITEM;
}

pub fun decode_certificate_verify(message: *handshake.Message,
    output: *CertificateVerify) error.Error {
    if (message == nil || output == nil
        || message.header.message_type != handshake.CERTIFICATE_VERIFY
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    var state: Reader = reader(message.body.data, message.body.len);
    output.scheme    = u16_value(?state);
    output.signature = vector16(?state);
    if (!complete(?state) || output.signature.len == 0) { ret error.DECODE_ERROR; }
    if (!valid_signature_scheme(output.scheme))         { ret error.UNSUPPORTED_ALGORITHM; }
    ret error.OK;
}

pub fun decode_finished(message: *handshake.Message, hash_length: usize,
    output: *Finished) error.Error {
    if (message == nil || output == nil || message.header.message_type != handshake.FINISHED
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    if ((hash_length != 32 && hash_length != 48) || message.body.len != hash_length) {
        ret error.DECODE_ERROR;
    }
    output.verify_data = message.body;
    ret error.OK;
}

pub fun decode_new_session_ticket(message: *handshake.Message,
    output: *NewSessionTicket) error.Error {
    if (message == nil || output == nil
        || message.header.message_type != handshake.NEW_SESSION_TICKET
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    var state: Reader = reader(message.body.data, message.body.len);
    output.lifetime = u32_value(?state);
    output.age_add  = u32_value(?state);
    output.nonce    = vector8(?state);
    output.ticket   = vector16(?state);
    val extension_bytes: contracts.Bytes = vector16(?state);
    output.extensions = extensions.list(extension_bytes.data, extension_bytes.len,
        extensions.NEW_SESSION_TICKET);
    if (!complete(?state) || output.ticket.len == 0) { ret error.DECODE_ERROR; }
    if (output.lifetime > MAX_TICKET_LIFETIME)       { ret error.ILLEGAL_PARAMETER; }
    ret extensions.validate(output.extensions);
}

pub fun decode_key_update(message: *handshake.Message, output: *KeyUpdate) error.Error {
    if (message == nil || output == nil || message.header.message_type != handshake.KEY_UPDATE
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    if (message.body.len != 1 || message.body.data[0] > UPDATE_REQUESTED) {
        ret error.ILLEGAL_PARAMETER;
    }
    output.request = message.body.data[0];
    ret error.OK;
}

pub fun decode_empty(message: *handshake.Message, expected: handshake.MessageType) error.Error {
    if (message == nil || message.header.message_type != expected
        || (expected != handshake.END_OF_EARLY_DATA)
        || message.body.len != 0 || message.header.length != 0) {
        ret error.UNEXPECTED_MESSAGE;
    }
    ret error.OK;
}

pub fun decode_message_hash(message: *handshake.Message, hash_length: usize,
    output: *contracts.Bytes) error.Error {
    if (message == nil || output == nil || message.header.message_type != handshake.MESSAGE_HASH
        || message.body.len::u32 != message.header.length) { ret error.UNEXPECTED_MESSAGE; }
    if ((hash_length != 32 && hash_length != 48) || message.body.len != hash_length) {
        ret error.DECODE_ERROR;
    }
    output[0] = message.body;
    ret error.OK;
}

pub fun validate_client(value: *ClientHello) error.Error {
    if (value == nil || value.legacy_version != tls13.LEGACY_VERSION
        || value.random.len != 32 || value.random.data == nil
        || value.legacy_session_id.len > 32
        || (value.legacy_session_id.len != 0 && value.legacy_session_id.data == nil)
        || value.cipher_suites.len < 2 || (value.cipher_suites.len & 1) != 0
        || value.cipher_suites.data == nil || value.compression_methods.len != 1
        || value.compression_methods.data == nil || value.compression_methods.data[0] != 0
        || value.extensions.context != extensions.CLIENT_HELLO) {
        ret error.ILLEGAL_PARAMETER;
    }
    val extension_error: error.Error = extensions.validate(value.extensions);
    if (extension_error != error.OK) { ret extension_error; }
    ret valid_client_combinations(value);
}

pub fun encode_client_hello(value: *ClientHello, output: contracts.Buffer) handshake.Progress {
    val validation: error.Error = validate_client(value);
    if (validation != error.OK) { ret result(handshake.REJECTED, 0, 0, validation); }
    val body_length: usize = 2 + 32 + 1 + value.legacy_session_id.len
        + 2 + value.cipher_suites.len + 1 + value.compression_methods.len
        + 2 + value.extensions.len;
    val ready: handshake.Progress = prepare(handshake.CLIENT_HELLO, body_length, output);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    var writer: Writer;
    begin_message(?writer, output, handshake.CLIENT_HELLO, body_length);
    put_u16(?writer, value.legacy_version);
    put_bytes(?writer, value.random);
    put_u8(?writer, value.legacy_session_id.len::u8);
    put_bytes(?writer, value.legacy_session_id);
    put_u16(?writer, value.cipher_suites.len::u16);
    put_bytes(?writer, value.cipher_suites);
    put_u8(?writer, value.compression_methods.len::u8);
    put_bytes(?writer, value.compression_methods);
    put_u16(?writer, value.extensions.len::u16);
    put_bytes(?writer, contracts.Bytes{data: value.extensions.data, len: value.extensions.len});
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

# return the encoded prefix covered by psk binder transcript hashes
pub fun client_hello_binder_prefix(encoded: contracts.Bytes, after_retry: bool,
    output: *contracts.Bytes) error.Error {
    if (output == nil || encoded.data == nil || encoded.len < handshake.HEADER_SIZE) {
        ret error.ILLEGAL_PARAMETER;
    }
    var message: handshake.Message;
    val parsed:  handshake.Progress = handshake.parse(encoded.data, encoded.len,
        handshake.MAX_BODY_SIZE, ?message);
    if (parsed.status != handshake.COMPLETE || parsed.consumed != encoded.len) {
        ret error.DECODE_ERROR;
    }
    var hello:   ClientHello;
    val decoded: error.Error = decode_client_hello(?message, after_retry, ?hello);
    if (decoded != error.OK) { ret decoded; }
    var psk: extensions.Extension;
    if (!extensions.find(hello.extensions, extensions.PRE_SHARED_KEY, ?psk)) {
        ret error.MISSING_EXTENSION;
    }
    val identities_length: usize = (psk.data[0]::usize << 8) | psk.data[1]::usize;
    val psk_offset:        usize = hello.extensions.len - 4 - psk.len;
    val body_prefix:       usize = 2 + 32 + 1 + hello.legacy_session_id.len
        + 2 + hello.cipher_suites.len + 1 + hello.compression_methods.len
        + 2 + psk_offset + 4 + 2 + identities_length;
    val prefix_length: usize = handshake.HEADER_SIZE + body_prefix;
    if (prefix_length > encoded.len) { ret error.DECODE_ERROR; }
    output.data = encoded.data;
    output.len  = prefix_length;
    ret error.OK;
}

pub fun validate_server(value: *ServerHello) error.Error {
    if (value == nil || value.legacy_version != tls13.LEGACY_VERSION
        || value.random.len != 32 || value.random.data == nil
        || value.legacy_session_id.len > 32
        || (value.legacy_session_id.len != 0 && value.legacy_session_id.data == nil)
        || value.compression_method != 0 || !valid_cipher_suite(value.cipher_suite)) {
        ret error.ILLEGAL_PARAMETER;
    }
    val retry: bool = hello_retry_random(value.random);
    if (retry != value.retry) { ret error.ILLEGAL_PARAMETER; }
    val expected: extensions.Context = extensions.SERVER_HELLO;
    if ((value.retry && value.extensions.context != extensions.HELLO_RETRY_REQUEST)
        || (!value.retry && value.extensions.context != expected)) { ret error.ILLEGAL_PARAMETER; }
    val extension_error: error.Error = extensions.validate(value.extensions);
    if (extension_error != error.OK) { ret extension_error; }
    ret valid_server_combinations(value);
}

pub fun encode_server_hello(value: *ServerHello, output: contracts.Buffer) handshake.Progress {
    val validation: error.Error = validate_server(value);
    if (validation != error.OK) { ret result(handshake.REJECTED, 0, 0, validation); }
    val body_length: usize = 2 + 32 + 1 + value.legacy_session_id.len
        + 2 + 1 + 2 + value.extensions.len;
    val ready: handshake.Progress = prepare(handshake.SERVER_HELLO, body_length, output);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    var writer: Writer;
    begin_message(?writer, output, handshake.SERVER_HELLO, body_length);
    put_u16(?writer, value.legacy_version);
    put_bytes(?writer, value.random);
    put_u8(?writer, value.legacy_session_id.len::u8);
    put_bytes(?writer, value.legacy_session_id);
    put_u16(?writer, value.cipher_suite);
    put_u8(?writer, value.compression_method);
    put_u16(?writer, value.extensions.len::u16);
    put_bytes(?writer, contracts.Bytes{data: value.extensions.data, len: value.extensions.len});
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun encode_extension_message(message_type: handshake.MessageType,
    value: extensions.List, output: contracts.Buffer) handshake.Progress {
    if (message_type != handshake.ENCRYPTED_EXTENSIONS
        || value.context != extensions.ENCRYPTED_EXTENSIONS) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val validation: error.Error = extensions.validate(value);
    if (validation != error.OK) { ret result(handshake.REJECTED, 0, 0, validation); }
    val body_length: usize              = 2 + value.len;
    val ready:       handshake.Progress = prepare(message_type, body_length, output);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    var writer: Writer;
    begin_message(?writer, output, message_type, body_length);
    put_u16(?writer, value.len::u16);
    put_bytes(?writer, contracts.Bytes{data: value.data, len: value.len});
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun encode_certificate_request(value: *CertificateRequest,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || value.context.len > 255
        || (value.context.len != 0 && value.context.data == nil)
        || value.extensions.context != extensions.CERTIFICATE_REQUEST) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val validation: error.Error = extensions.validate(value.extensions);
    if (validation != error.OK) {
        ret result(handshake.REJECTED, 0, 0, validation);
    }
    if (!extensions.contains(value.extensions, extensions.SIGNATURE_ALGORITHMS)) {
        ret result(handshake.REJECTED, 0, 0, error.MISSING_EXTENSION);
    }
    val body_length: usize              = 1 + value.context.len + 2 + value.extensions.len;
    val ready:       handshake.Progress = prepare(handshake.CERTIFICATE_REQUEST, body_length, output);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    var writer: Writer;
    begin_message(?writer, output, handshake.CERTIFICATE_REQUEST, body_length);
    put_u8(?writer, value.context.len::u8);
    put_bytes(?writer, value.context);
    put_u16(?writer, value.extensions.len::u16);
    put_bytes(?writer, contracts.Bytes{data: value.extensions.data, len: value.extensions.len});
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun encode_certificate(value: *CertificateMessage, allow_empty: bool,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || value.context.len > 255
        || (value.context.len != 0 && value.context.data == nil)) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    var count:      usize       = 0;
    val validation: error.Error = inspect_certificate_entries(value.entries, allow_empty, ?count);
    if (validation != error.OK) {
        ret result(handshake.REJECTED, 0, 0, validation);
    }
    if (count != value.count) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val body_length: usize              = 1 + value.context.len + 3 + value.entries.len;
    val ready:       handshake.Progress = prepare(handshake.CERTIFICATE, body_length, output);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    var writer: Writer;
    begin_message(?writer, output, handshake.CERTIFICATE, body_length);
    put_u8(?writer, value.context.len::u8);
    put_bytes(?writer, value.context);
    put_u24(?writer, value.entries.len);
    put_bytes(?writer, value.entries);
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun encode_certificate_verify(value: *CertificateVerify,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || !valid_signature_scheme(value.scheme) || value.signature.len == 0
        || value.signature.len > 65535 || value.signature.data == nil) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val body_length: usize              = 4 + value.signature.len;
    val ready:       handshake.Progress = prepare(handshake.CERTIFICATE_VERIFY, body_length, output);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    var writer: Writer;
    begin_message(?writer, output, handshake.CERTIFICATE_VERIFY, body_length);
    put_u16(?writer, value.scheme);
    put_u16(?writer, value.signature.len::u16);
    put_bytes(?writer, value.signature);
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun encode_finished(value: *Finished, output: contracts.Buffer) handshake.Progress {
    if (value == nil || (value.verify_data.len != 32 && value.verify_data.len != 48)
        || value.verify_data.data == nil) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    ret handshake.serialize(handshake.FINISHED, value.verify_data, output);
}

pub fun encode_message_hash(value: contracts.Bytes,
    output: contracts.Buffer) handshake.Progress {
    if ((value.len != 32 && value.len != 48) || value.data == nil) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    ret handshake.serialize(handshake.MESSAGE_HASH, value, output);
}

pub fun encode_new_session_ticket(value: *NewSessionTicket,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || value.lifetime > MAX_TICKET_LIFETIME || value.nonce.len > 255
        || (value.nonce.len != 0 && value.nonce.data == nil) || value.ticket.len == 0
        || value.ticket.len > 65535 || value.ticket.data == nil
        || value.extensions.context != extensions.NEW_SESSION_TICKET) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val validation: error.Error = extensions.validate(value.extensions);
    if (validation != error.OK) { ret result(handshake.REJECTED, 0, 0, validation); }
    val body_length: usize = 4 + 4 + 1 + value.nonce.len + 2 + value.ticket.len
        + 2 + value.extensions.len;
    val ready: handshake.Progress = prepare(handshake.NEW_SESSION_TICKET, body_length, output);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    var writer: Writer;
    begin_message(?writer, output, handshake.NEW_SESSION_TICKET, body_length);
    put_u32(?writer, value.lifetime);
    put_u32(?writer, value.age_add);
    put_u8(?writer, value.nonce.len::u8);
    put_bytes(?writer, value.nonce);
    put_u16(?writer, value.ticket.len::u16);
    put_bytes(?writer, value.ticket);
    put_u16(?writer, value.extensions.len::u16);
    put_bytes(?writer, contracts.Bytes{data: value.extensions.data, len: value.extensions.len});
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun encode_key_update(value: KeyUpdate, output: contracts.Buffer) handshake.Progress {
    if (value.request > UPDATE_REQUESTED) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    var body: [1]u8;
    body[0] = value.request;
    ret handshake.serialize(handshake.KEY_UPDATE,
        contracts.Bytes{data: ?body[0], len: 1}, output);
}

pub fun encode_empty(message_type: handshake.MessageType,
    output: contracts.Buffer) handshake.Progress {
    if (message_type != handshake.END_OF_EARLY_DATA) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    ret handshake.serialize(message_type, contracts.Bytes{data: nil, len: 0}, output);
}

test "codec: client hello round trips through fragmented framing" {
    var random: [32]u8;
    var i:      usize = 0;
    for (i < 32) {
        random[i] = i::u8;
        i         = i + 1;
    }
    var suites:          [2]u8 = [2]u8{0x13, 0x01};
    var compression:     [1]u8;
    var extension_bytes: [65]u8;
    var offset:          usize = 0;
    extension_bytes[offset]     = 0;
    extension_bytes[offset + 1] = 43;
    extension_bytes[offset + 2] = 0;
    extension_bytes[offset + 3] = 3;
    extension_bytes[offset + 4] = 2;
    extension_bytes[offset + 5] = 3;
    extension_bytes[offset + 6] = 4;
    offset                      = offset + 7;
    extension_bytes[offset]     = 0;
    extension_bytes[offset + 1] = 10;
    extension_bytes[offset + 2] = 0;
    extension_bytes[offset + 3] = 4;
    extension_bytes[offset + 4] = 0;
    extension_bytes[offset + 5] = 2;
    extension_bytes[offset + 6] = 0;
    extension_bytes[offset + 7] = 29;
    offset                      = offset + 8;
    extension_bytes[offset]     = 0;
    extension_bytes[offset + 1] = 13;
    extension_bytes[offset + 2] = 0;
    extension_bytes[offset + 3] = 4;
    extension_bytes[offset + 4] = 0;
    extension_bytes[offset + 5] = 2;
    extension_bytes[offset + 6] = 8;
    extension_bytes[offset + 7] = 7;
    offset                      = offset + 8;
    extension_bytes[offset]     = 0;
    extension_bytes[offset + 1] = 51;
    extension_bytes[offset + 2] = 0;
    extension_bytes[offset + 3] = 38;
    extension_bytes[offset + 4] = 0;
    extension_bytes[offset + 5] = 36;
    extension_bytes[offset + 6] = 0;
    extension_bytes[offset + 7] = 29;
    extension_bytes[offset + 8] = 0;
    extension_bytes[offset + 9] = 32;
    i                           = 0;
    for (i < 32) {
        extension_bytes[offset + 10 + i] = (0xa0 + i)::u8;
        i                                = i + 1;
    }
    offset = offset + 42;
    var hello: ClientHello;
    hello.legacy_version      = tls13.LEGACY_VERSION;
    hello.random              = contracts.Bytes{data: ?random[0], len: 32};
    hello.legacy_session_id   = contracts.Bytes{data: nil, len: 0};
    hello.cipher_suites       = contracts.Bytes{data: ?suites[0], len: 2};
    hello.compression_methods = contracts.Bytes{data: ?compression[0], len: 1};
    hello.extensions          = extensions.list(?extension_bytes[0], offset, extensions.CLIENT_HELLO);
    hello.after_retry         = false;
    var wire:    [256]u8;
    val encoded: handshake.Progress = encode_client_hello(?hello,
        contracts.Buffer{data: ?wire[0], capacity: 256});
    if (encoded.status != handshake.COMPLETE) { ret 1; }
    var message: handshake.Message;
    i = 0;
    for (i < encoded.produced) {
        if (handshake.parse(?wire[0], i, 1024, ?message).status != handshake.NEED_INPUT) { ret 2; }
        i = i + 1;
    }
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 3; }
    var decoded: ClientHello;
    if (decode_client_hello(?message, false, ?decoded) != error.OK
        || decoded.extensions.len != offset || decoded.cipher_suites.len != 2) { ret 4; }
    ret 0;
}

test "codec: psk binder prefix retains encoded length fields and identities" {
    var random:          [32]u8;
    var suites:          [2]u8 = [2]u8{0x13, 0x01};
    var compression:     [1]u8;
    var extension_bytes: [61]u8;
    var offset:          usize = 0;
    extension_bytes[offset]      = 0;
    extension_bytes[offset + 1]  = 43;
    extension_bytes[offset + 2]  = 0;
    extension_bytes[offset + 3]  = 3;
    extension_bytes[offset + 4]  = 2;
    extension_bytes[offset + 5]  = 3;
    extension_bytes[offset + 6]  = 4;
    offset                       = offset + 7;
    extension_bytes[offset]      = 0;
    extension_bytes[offset + 1]  = 45;
    extension_bytes[offset + 2]  = 0;
    extension_bytes[offset + 3]  = 2;
    extension_bytes[offset + 4]  = 1;
    extension_bytes[offset + 5]  = 0;
    offset                       = offset + 6;
    extension_bytes[offset]      = 0;
    extension_bytes[offset + 1]  = 41;
    extension_bytes[offset + 2]  = 0;
    extension_bytes[offset + 3]  = 44;
    extension_bytes[offset + 4]  = 0;
    extension_bytes[offset + 5]  = 7;
    extension_bytes[offset + 6]  = 0;
    extension_bytes[offset + 7]  = 1;
    extension_bytes[offset + 8]  = 0xaa;
    extension_bytes[offset + 9]  = 0;
    extension_bytes[offset + 10] = 0;
    extension_bytes[offset + 11] = 0;
    extension_bytes[offset + 12] = 1;
    extension_bytes[offset + 13] = 0;
    extension_bytes[offset + 14] = 33;
    extension_bytes[offset + 15] = 32;
    var i: usize = 0;
    for (i < 32) {
        extension_bytes[offset + 16 + i] = i::u8;
        i                                = i + 1;
    }
    offset = offset + 48;
    var hello: ClientHello;
    hello.legacy_version      = tls13.LEGACY_VERSION;
    hello.random              = contracts.Bytes{data: ?random[0], len: 32};
    hello.legacy_session_id   = contracts.Bytes{data: nil, len: 0};
    hello.cipher_suites       = contracts.Bytes{data: ?suites[0], len: 2};
    hello.compression_methods = contracts.Bytes{data: ?compression[0], len: 1};
    hello.extensions          = extensions.list(?extension_bytes[0], offset, extensions.CLIENT_HELLO);
    hello.after_retry         = false;
    var wire:    [128]u8;
    val encoded: handshake.Progress = encode_client_hello(?hello,
        contracts.Buffer{data: ?wire[0], capacity: 128});
    if (encoded.status != handshake.COMPLETE || encoded.produced != 108) { ret 1; }
    var prefix: contracts.Bytes;
    if (client_hello_binder_prefix(
        contracts.Bytes{data: ?wire[0], len: encoded.produced}, false, ?prefix) != error.OK
        || prefix.data != ?wire[0] || prefix.len != 73 || prefix.data[prefix.len - 1] != 1
        || wire[prefix.len] != 0 || wire[prefix.len + 1] != 33) { ret 2; }
    if (client_hello_binder_prefix(
        contracts.Bytes{data: ?wire[0], len: encoded.produced + 1}, false, ?prefix)
        != error.DECODE_ERROR) { ret 3; }
    hello.extensions = extensions.list(?extension_bytes[0], 13, extensions.CLIENT_HELLO);
    val without_psk: handshake.Progress = encode_client_hello(?hello,
        contracts.Buffer{data: ?wire[0], capacity: 128});
    if (without_psk.status != handshake.REJECTED) { ret 4; }
    ret 0;
}

test "codec: server and post hello messages round trip" {
    var random:          [32]u8;
    var session_id:      [1]u8 = [1]u8{0xaa};
    var extension_bytes: [46]u8;
    extension_bytes[0]  = 0;
    extension_bytes[1]  = 43;
    extension_bytes[2]  = 0;
    extension_bytes[3]  = 2;
    extension_bytes[4]  = 3;
    extension_bytes[5]  = 4;
    extension_bytes[6]  = 0;
    extension_bytes[7]  = 51;
    extension_bytes[8]  = 0;
    extension_bytes[9]  = 36;
    extension_bytes[10] = 0;
    extension_bytes[11] = 29;
    extension_bytes[12] = 0;
    extension_bytes[13] = 32;
    var i: usize = 0;
    for (i < 32) {
        extension_bytes[14 + i] = (0x80 + i)::u8;
        i                       = i + 1;
    }
    var server: ServerHello;
    server.legacy_version     = tls13.LEGACY_VERSION;
    server.random             = contracts.Bytes{data: ?random[0], len: 32};
    server.legacy_session_id  = contracts.Bytes{data: ?session_id[0], len: 1};
    server.cipher_suite       = tls13.AES_128_GCM_SHA256;
    server.compression_method = 0;
    server.extensions         = extensions.list(?extension_bytes[0], 46, extensions.SERVER_HELLO);
    server.retry              = false;
    var wire:    [512]u8;
    var encoded: handshake.Progress = encode_server_hello(?server,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (encoded.status != handshake.COMPLETE) { ret 1; }
    var message: handshake.Message;
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 2; }
    var decoded_server: ServerHello;
    if (decode_server_hello(?message, ?decoded_server) != error.OK
        || decoded_server.cipher_suite != tls13.AES_128_GCM_SHA256) { ret 3; }

    val empty_extensions: extensions.List = extensions.list(nil, 0, extensions.ENCRYPTED_EXTENSIONS);
    encoded = encode_extension_message(handshake.ENCRYPTED_EXTENSIONS, empty_extensions,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 4; }
    var encrypted: EncryptedExtensions;
    if (decode_encrypted_extensions(?message, ?encrypted) != error.OK
        || encrypted.extensions.len != 0) { ret 5; }

    var signature_extension: [8]u8 = [8]u8{0, 13, 0, 4, 0, 2, 8, 7};
    var request:             CertificateRequest;
    request.context    = contracts.Bytes{data: nil, len: 0};
    request.extensions = extensions.list(?signature_extension[0], 8,
        extensions.CERTIFICATE_REQUEST);
    encoded = encode_certificate_request(?request,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 6; }
    var decoded_request: CertificateRequest;
    if (decode_certificate_request(?message, ?decoded_request) != error.OK) { ret 7; }

    var entries:     [6]u8 = [6]u8{0, 0, 1, 0x30, 0, 0};
    var certificate: CertificateMessage;
    certificate.context = contracts.Bytes{data: nil, len: 0};
    certificate.entries = contracts.Bytes{data: ?entries[0], len: 6};
    certificate.count   = 1;
    encoded             = encode_certificate(?certificate, false,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 8; }
    var decoded_certificate: CertificateMessage;
    if (decode_certificate(?message, false, ?decoded_certificate) != error.OK
        || decoded_certificate.count != 1) { ret 9; }
    var certificate_state: CertificateIterator = certificate_iterator(?decoded_certificate);
    var entry:             CertificateEntry;
    if (next_certificate(?certificate_state, ?entry) != extensions.NEXT_ITEM
        || entry.certificate.len != 1 || entry.certificate.data[0] != 0x30
        || next_certificate(?certificate_state, ?entry) != extensions.NEXT_DONE) { ret 10; }

    var signature:    [3]u8 = [3]u8{1, 2, 3};
    var verification: CertificateVerify;
    verification.scheme    = tls13.ED25519;
    verification.signature = contracts.Bytes{data: ?signature[0], len: 3};
    encoded                = encode_certificate_verify(?verification,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 11; }
    var decoded_verification: CertificateVerify;
    if (decode_certificate_verify(?message, ?decoded_verification) != error.OK
        || decoded_verification.signature.len != 3) { ret 12; }

    var verify_data: [32]u8;
    var finished:    Finished;
    finished.verify_data = contracts.Bytes{data: ?verify_data[0], len: 32};
    encoded              = encode_finished(?finished, contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 13; }
    var decoded_finished: Finished;
    if (decode_finished(?message, 32, ?decoded_finished) != error.OK) { ret 14; }

    var nonce:        [1]u8 = [1]u8{9};
    var ticket_bytes: [2]u8 = [2]u8{7, 8};
    var early_data:   [8]u8 = [8]u8{0, 42, 0, 4, 0, 0, 0x10, 0};
    var ticket:       NewSessionTicket;
    ticket.lifetime   = 3600;
    ticket.age_add    = 0x01020304;
    ticket.nonce      = contracts.Bytes{data: ?nonce[0], len: 1};
    ticket.ticket     = contracts.Bytes{data: ?ticket_bytes[0], len: 2};
    ticket.extensions = extensions.list(?early_data[0], 8, extensions.NEW_SESSION_TICKET);
    encoded           = encode_new_session_ticket(?ticket,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 15; }
    var decoded_ticket: NewSessionTicket;
    if (decode_new_session_ticket(?message, ?decoded_ticket) != error.OK
        || decoded_ticket.ticket.len != 2 || decoded_ticket.lifetime != 3600) { ret 16; }

    encoded = encode_key_update(KeyUpdate{request: UPDATE_REQUESTED},
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE) { ret 17; }
    var update: KeyUpdate;
    if (decode_key_update(?message, ?update) != error.OK || update.request != UPDATE_REQUESTED) { ret 18; }
    encoded = encode_empty(handshake.END_OF_EARLY_DATA,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (handshake.parse(?wire[0], encoded.produced, 1024, ?message).status != handshake.COMPLETE
        || decode_empty(?message, handshake.END_OF_EARLY_DATA) != error.OK) { ret 19; }
    ret 0;
}

test "codec: malformed message bodies fail closed" {
    var wire:    [128]u8;
    var body:    [1]u8              = [1]u8{2};
    var encoded: handshake.Progress = handshake.serialize(handshake.KEY_UPDATE,
        contracts.Bytes{data: ?body[0], len: 1},
        contracts.Buffer{data: ?wire[0], capacity: 128});
    var message: handshake.Message;
    handshake.parse(?wire[0], encoded.produced, 128, ?message);
    var update: KeyUpdate;
    if (decode_key_update(?message, ?update) != error.ILLEGAL_PARAMETER) { ret 1; }

    var short_verify: [31]u8;
    encoded = handshake.serialize(handshake.FINISHED,
        contracts.Bytes{data: ?short_verify[0], len: 31},
        contracts.Buffer{data: ?wire[0], capacity: 128});
    handshake.parse(?wire[0], encoded.produced, 128, ?message);
    var finished: Finished;
    if (decode_finished(?message, 32, ?finished) != error.DECODE_ERROR) { ret 2; }

    var empty_request: [3]u8;
    encoded = handshake.serialize(handshake.CERTIFICATE_REQUEST,
        contracts.Bytes{data: ?empty_request[0], len: 3},
        contracts.Buffer{data: ?wire[0], capacity: 128});
    handshake.parse(?wire[0], encoded.produced, 128, ?message);
    var request: CertificateRequest;
    if (decode_certificate_request(?message, ?request) != error.MISSING_EXTENSION) { ret 3; }

    var ticket_body: [13]u8 = [13]u8{0, 9, 0x3a, 0x81, 0, 0, 0, 0, 0, 0, 1, 1, 0};
    encoded = handshake.serialize(handshake.NEW_SESSION_TICKET,
        contracts.Bytes{data: ?ticket_body[0], len: 13},
        contracts.Buffer{data: ?wire[0], capacity: 128});
    handshake.parse(?wire[0], encoded.produced, 128, ?message);
    var ticket: NewSessionTicket;
    if (decode_new_session_ticket(?message, ?ticket) == error.OK) { ret 4; }
    ret 0;
}

test "codec: p-384 certificate verify preserves signature scheme 0x0503" {
    var signature_bytes: [8]u8 = [8]u8{0x30, 6, 2, 1, 1, 2, 1, 1};
    var value:           CertificateVerify;
    value.scheme    = tls13.ECDSA_SECP384R1_SHA384;
    value.signature = contracts.Bytes{data: ?signature_bytes[0], len: 8};
    var wire:    [16]u8;
    val encoded: handshake.Progress = encode_certificate_verify(?value,
        contracts.Buffer{data: ?wire[0], capacity: 16});
    if (encoded.status != handshake.COMPLETE || encoded.produced != 16 ||
        wire[4] != 0x05 || wire[5] != 0x03) { ret 1; }
    var message: handshake.Message;
    if (handshake.parse(?wire[0], 16, 16, ?message).status !=
        handshake.COMPLETE) { ret 2; }
    var decoded: CertificateVerify;
    if (decode_certificate_verify(?message, ?decoded) != error.OK ||
        decoded.scheme != tls13.ECDSA_SECP384R1_SHA384 ||
        decoded.signature.len != 8) { ret 3; }
    wire[5] = 0x04;
    if (handshake.parse(?wire[0], 16, 16, ?message).status !=
        handshake.COMPLETE ||
        decode_certificate_verify(?message, ?decoded) !=
        error.UNSUPPORTED_ALGORITHM) { ret 4; }
    ret 0;
}

test "codec: rfc 8448 client and server hellos decode exactly" {
    var client: [196]u8 = [196]u8{
        0x01, 0x00, 0x00, 0xc0, 0x03, 0x03, 0xcb, 0x34,
        0xec, 0xb1, 0xe7, 0x81, 0x63, 0xba, 0x1c, 0x38,
        0xc6, 0xda, 0xcb, 0x19, 0x6a, 0x6d, 0xff, 0xa2,
        0x1a, 0x8d, 0x99, 0x12, 0xec, 0x18, 0xa2, 0xef,
        0x62, 0x83, 0x02, 0x4d, 0xec, 0xe7, 0x00, 0x00,
        0x06, 0x13, 0x01, 0x13, 0x03, 0x13, 0x02, 0x01,
        0x00, 0x00, 0x91, 0x00, 0x00, 0x00, 0x0b, 0x00,
        0x09, 0x00, 0x00, 0x06, 0x73, 0x65, 0x72, 0x76,
        0x65, 0x72, 0xff, 0x01, 0x00, 0x01, 0x00, 0x00,
        0x0a, 0x00, 0x14, 0x00, 0x12, 0x00, 0x1d, 0x00,
        0x17, 0x00, 0x18, 0x00, 0x19, 0x01, 0x00, 0x01,
        0x01, 0x01, 0x02, 0x01, 0x03, 0x01, 0x04, 0x00,
        0x23, 0x00, 0x00, 0x00, 0x33, 0x00, 0x26, 0x00,
        0x24, 0x00, 0x1d, 0x00, 0x20, 0x99, 0x38, 0x1d,
        0xe5, 0x60, 0xe4, 0xbd, 0x43, 0xd2, 0x3d, 0x8e,
        0x43, 0x5a, 0x7d, 0xba, 0xfe, 0xb3, 0xc0, 0x6e,
        0x51, 0xc1, 0x3c, 0xae, 0x4d, 0x54, 0x13, 0x69,
        0x1e, 0x52, 0x9a, 0xaf, 0x2c, 0x00, 0x2b, 0x00,
        0x03, 0x02, 0x03, 0x04, 0x00, 0x0d, 0x00, 0x20,
        0x00, 0x1e, 0x04, 0x03, 0x05, 0x03, 0x06, 0x03,
        0x02, 0x03, 0x08, 0x04, 0x08, 0x05, 0x08, 0x06,
        0x04, 0x01, 0x05, 0x01, 0x06, 0x01, 0x02, 0x01,
        0x04, 0x02, 0x05, 0x02, 0x06, 0x02, 0x02, 0x02,
        0x00, 0x2d, 0x00, 0x02, 0x01, 0x01, 0x00, 0x1c,
        0x00, 0x02, 0x40, 0x01,
    };
    var message: handshake.Message;
    var i:       usize = 0;
    for (i < 196) {
        if (handshake.parse(?client[0], i, 1024, ?message).status != handshake.NEED_INPUT) {
            ret 1;
        }
        i = i + 1;
    }
    if (handshake.parse(?client[0], 196, 1024, ?message).status != handshake.COMPLETE) { ret 2; }
    var client_hello: ClientHello;
    val client_error: error.Error = decode_client_hello(?message, false, ?client_hello);
    if (client_error != error.OK)                                                  { ret 3; }
    if (client_hello.cipher_suites.len != 6 || client_hello.extensions.len != 145) { ret 3; }

    var server: [90]u8 = [90]u8{
        0x02, 0x00, 0x00, 0x56, 0x03, 0x03, 0xa6, 0xaf,
        0x06, 0xa4, 0x12, 0x18, 0x60, 0xdc, 0x5e, 0x6e,
        0x60, 0x24, 0x9c, 0xd3, 0x4c, 0x95, 0x93, 0x0c,
        0x8a, 0xc5, 0xcb, 0x14, 0x34, 0xda, 0xc1, 0x55,
        0x77, 0x2e, 0xd3, 0xe2, 0x69, 0x28, 0x00, 0x13,
        0x01, 0x00, 0x00, 0x2e, 0x00, 0x33, 0x00, 0x24,
        0x00, 0x1d, 0x00, 0x20, 0xc9, 0x82, 0x88, 0x76,
        0x11, 0x20, 0x95, 0xfe, 0x66, 0x76, 0x2b, 0xdb,
        0xf7, 0xc6, 0x72, 0xe1, 0x56, 0xd6, 0xcc, 0x25,
        0x3b, 0x83, 0x3d, 0xf1, 0xdd, 0x69, 0xb1, 0xb0,
        0x4e, 0x75, 0x1f, 0x0f, 0x00, 0x2b, 0x00, 0x02,
        0x03, 0x04,
    };
    i = 0;
    for (i < 90) {
        if (handshake.parse(?server[0], i, 1024, ?message).status != handshake.NEED_INPUT) {
            ret 4;
        }
        i = i + 1;
    }
    if (handshake.parse(?server[0], 90, 1024, ?message).status != handshake.COMPLETE) { ret 5; }
    var server_hello: ServerHello;
    if (decode_server_hello(?message, ?server_hello) != error.OK
        || server_hello.cipher_suite != tls13.AES_128_GCM_SHA256
        || server_hello.extensions.len != 46 || server_hello.retry) { ret 6; }
    ret 0;
}
