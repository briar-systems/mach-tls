# tls 1.3 extension parsing and placement rules

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.error;
use tls.tls13;

pub def ExtensionType: u16;
pub def Context:       u8;
pub def NextStatus:    u8;

pub val SERVER_NAME:                  ExtensionType = 0;
pub val MAX_FRAGMENT_LENGTH:          ExtensionType = 1;
pub val STATUS_REQUEST:               ExtensionType = 5;
pub val SUPPORTED_GROUPS:             ExtensionType = 10;
pub val SIGNATURE_ALGORITHMS:         ExtensionType = 13;
pub val APPLICATION_LAYER_PROTOCOL:   ExtensionType = 16;
pub val SIGNED_CERTIFICATE_TIMESTAMP: ExtensionType = 18;
pub val PADDING:                      ExtensionType = 21;
pub val RECORD_SIZE_LIMIT:            ExtensionType = 28;
pub val PRE_SHARED_KEY:               ExtensionType = 41;
pub val EARLY_DATA:                   ExtensionType = 42;
pub val SUPPORTED_VERSIONS:           ExtensionType = 43;
pub val COOKIE:                       ExtensionType = 44;
pub val PSK_KEY_EXCHANGE_MODES:       ExtensionType = 45;
pub val CERTIFICATE_AUTHORITIES:      ExtensionType = 47;
pub val OID_FILTERS:                  ExtensionType = 48;
pub val POST_HANDSHAKE_AUTH:          ExtensionType = 49;
pub val SIGNATURE_ALGORITHMS_CERT:    ExtensionType = 50;
pub val KEY_SHARE:                    ExtensionType = 51;
pub val EC_POINT_FORMATS:             ExtensionType = 11;
pub val EXTENDED_MASTER_SECRET:       ExtensionType = 23;
pub val RENEGOTIATION_INFO:           ExtensionType = 0xFF01;

pub val CLIENT_HELLO:         Context = 1;
pub val SERVER_HELLO:         Context = 2;
pub val HELLO_RETRY_REQUEST:  Context = 3;
pub val ENCRYPTED_EXTENSIONS: Context = 4;
pub val CERTIFICATE_REQUEST:  Context = 5;
pub val CERTIFICATE_ENTRY:    Context = 6;
pub val NEW_SESSION_TICKET:   Context = 7;
# a tls 1.2 server hello carries extensions tls 1.3 forbids there, so it is a
# context of its own rather than a relaxation of the tls 1.3 rules
pub val TLS12_SERVER_HELLO: Context = 8;

pub val NEXT_ITEM:    NextStatus = 0;
pub val NEXT_DONE:    NextStatus = 1;
pub val NEXT_INVALID: NextStatus = 2;

pub rec Extension {
    kind: ExtensionType;
    data: *u8;
    len:  usize;
}

pub rec List {
    data:    *u8;
    len:     usize;
    context: Context;
}

pub rec Iterator {
    list:   List;
    offset: usize;
    failed: bool;
}

fun read_u16(data: *u8, offset: usize) u16 {
    ret (data[offset]::u16 << 8) | data[offset + 1]::u16;
}

fun read_u24(data: *u8, offset: usize) usize {
    ret (data[offset]::usize << 16) | (data[offset + 1]::usize << 8)
        | data[offset + 2]::usize;
}

fun valid_context(context: Context) bool {
    ret context >= CLIENT_HELLO && context <= TLS12_SERVER_HELLO;
}

pub fun list(data: *u8, len: usize, context: Context) List {
    ret List{data: data, len: len, context: context};
}

pub fun iterator(value: List) Iterator {
    ret Iterator{list: value, offset: 0, failed: false};
}

pub fun next(state: *Iterator, output: *Extension) NextStatus {
    if (state == nil || output == nil || state.failed || !valid_context(state.list.context)
        || state.offset > state.list.len || (state.list.len != 0 && state.list.data == nil)) {
        if (state != nil) { state.failed = true; }
        ret NEXT_INVALID;
    }
    if (state.offset == state.list.len) { ret NEXT_DONE; }
    if (state.list.len - state.offset < 4) {
        state.failed = true;
        ret NEXT_INVALID;
    }
    val length: usize = read_u16(state.list.data, state.offset + 2)::usize;
    if (length > state.list.len - state.offset - 4) {
        state.failed = true;
        ret NEXT_INVALID;
    }
    output.kind = read_u16(state.list.data, state.offset);
    output.data = nil;
    output.len  = length;
    if (length != 0) { output.data = ?state.list.data[state.offset + 4]; }
    state.offset = state.offset + 4 + length;
    ret NEXT_ITEM;
}

fun known(kind: ExtensionType) bool {
    ret kind == SERVER_NAME || kind == MAX_FRAGMENT_LENGTH || kind == STATUS_REQUEST
        || kind == EC_POINT_FORMATS || kind == EXTENDED_MASTER_SECRET
        || kind == RENEGOTIATION_INFO
        || kind == SUPPORTED_GROUPS || kind == SIGNATURE_ALGORITHMS
        || kind == APPLICATION_LAYER_PROTOCOL || kind == SIGNED_CERTIFICATE_TIMESTAMP
        || kind == PADDING || kind == RECORD_SIZE_LIMIT || kind == PRE_SHARED_KEY
        || kind == EARLY_DATA || kind == SUPPORTED_VERSIONS || kind == COOKIE
        || kind == PSK_KEY_EXCHANGE_MODES || kind == CERTIFICATE_AUTHORITIES
        || kind == OID_FILTERS || kind == POST_HANDSHAKE_AUTH
        || kind == SIGNATURE_ALGORITHMS_CERT || kind == KEY_SHARE;
}

fun allowed(kind: ExtensionType, context: Context) bool {
    if (kind == SERVER_NAME) {
        ret context == CLIENT_HELLO || context == ENCRYPTED_EXTENSIONS ||
            context == TLS12_SERVER_HELLO;
    }
    if (kind == MAX_FRAGMENT_LENGTH || kind == RECORD_SIZE_LIMIT) {
        ret context == CLIENT_HELLO || context == ENCRYPTED_EXTENSIONS ||
            context == TLS12_SERVER_HELLO;
    }
    if (kind == STATUS_REQUEST) {
        ret context == CLIENT_HELLO || context == CERTIFICATE_REQUEST
            || context == CERTIFICATE_ENTRY;
    }
    if (kind == SUPPORTED_GROUPS) {
        ret context == CLIENT_HELLO || context == ENCRYPTED_EXTENSIONS;
    }
    if (kind == EC_POINT_FORMATS) {
        ret context == CLIENT_HELLO || context == TLS12_SERVER_HELLO;
    }
    if (kind == EXTENDED_MASTER_SECRET || kind == RENEGOTIATION_INFO) {
        ret context == CLIENT_HELLO || context == TLS12_SERVER_HELLO;
    }
    if (kind == SIGNATURE_ALGORITHMS || kind == SIGNATURE_ALGORITHMS_CERT) {
        ret context == CLIENT_HELLO || context == CERTIFICATE_REQUEST;
    }
    if (kind == APPLICATION_LAYER_PROTOCOL) {
        ret context == CLIENT_HELLO || context == ENCRYPTED_EXTENSIONS ||
            context == TLS12_SERVER_HELLO;
    }
    if (kind == SIGNED_CERTIFICATE_TIMESTAMP) {
        ret context == CLIENT_HELLO || context == CERTIFICATE_REQUEST
            || context == CERTIFICATE_ENTRY;
    }
    if (kind == PADDING || kind == PSK_KEY_EXCHANGE_MODES
        || kind == POST_HANDSHAKE_AUTH) { ret context == CLIENT_HELLO; }
    if (kind == PRE_SHARED_KEY) {
        ret context == CLIENT_HELLO || context == SERVER_HELLO;
    }
    if (kind == EARLY_DATA) {
        ret context == CLIENT_HELLO || context == ENCRYPTED_EXTENSIONS
            || context == NEW_SESSION_TICKET;
    }
    if (kind == SUPPORTED_VERSIONS) {
        ret context == CLIENT_HELLO || context == SERVER_HELLO
            || context == HELLO_RETRY_REQUEST;
    }
    if (kind == COOKIE) {
        ret context == CLIENT_HELLO || context == HELLO_RETRY_REQUEST;
    }
    if (kind == CERTIFICATE_AUTHORITIES) {
        ret context == CLIENT_HELLO || context == CERTIFICATE_REQUEST;
    }
    if (kind == OID_FILTERS) { ret context == CERTIFICATE_REQUEST; }
    if (kind == KEY_SHARE) {
        ret context == CLIENT_HELLO || context == SERVER_HELLO
            || context == HELLO_RETRY_REQUEST;
    }
    ret false;
}

fun unique_u16_values(data: *u8, length: usize) bool {
    if ((length & 1) != 0) { ret false; }
    var i: usize = 0;
    for (i < length) {
        var j: usize = 0;
        for (j < i) {
            if (read_u16(data, i) == read_u16(data, j)) { ret false; }
            j = j + 2;
        }
        i = i + 2;
    }
    ret true;
}

fun u16_vector(data: *u8, length: usize, minimum: usize) bool {
    if (length < 2) { ret false; }
    val inner: usize = read_u16(data, 0)::usize;
    ret inner == length - 2 && inner >= minimum && (inner & 1) == 0
        && unique_u16_values(?data[2], inner);
}

fun valid_server_name(extension: Extension, context: Context) bool {
    if (context == ENCRYPTED_EXTENSIONS || context == TLS12_SERVER_HELLO) {
        ret extension.len == 0;
    }
    if (extension.len < 5) { ret false; }
    val list_len: usize = read_u16(extension.data, 0)::usize;
    if (list_len != extension.len - 2) { ret false; }
    var offset: usize = 2;
    var names:  usize = 0;
    for (offset < extension.len) {
        if (extension.len - offset < 3 || extension.data[offset] != 0) { ret false; }
        val name_len: usize = read_u16(extension.data, offset + 1)::usize;
        if (name_len == 0 || name_len > extension.len - offset - 3) { ret false; }
        var i: usize = 0;
        for (i < name_len) {
            if (extension.data[offset + 3 + i] == 0) { ret false; }
            i = i + 1;
        }
        names = names + 1;
        if (names != 1) { ret false; }
        offset = offset + 3 + name_len;
    }
    ret names == 1 && offset == extension.len;
}

fun valid_status_request(extension: Extension, context: Context) bool {
    if (context == CERTIFICATE_REQUEST) { ret extension.len == 0; }
    if (context == CERTIFICATE_ENTRY) {
        if (extension.len < 4 || extension.data[0] != 1) { ret false; }
        ret read_u24(extension.data, 1) == extension.len - 4
            && extension.len > 4;
    }
    if (extension.len < 5 || extension.data[0] != 1) { ret false; }
    val responder_len: usize = read_u16(extension.data, 1)::usize;
    if (responder_len > extension.len - 5) { ret false; }
    var offset:        usize = 3;
    val responder_end: usize = offset + responder_len;
    for (offset < responder_end) {
        if (responder_end - offset < 2) { ret false; }
        val id_len: usize = read_u16(extension.data, offset)::usize;
        if (id_len == 0 || id_len > responder_end - offset - 2) { ret false; }
        offset = offset + 2 + id_len;
    }
    if (offset != responder_end || extension.len - offset < 2) { ret false; }
    val request_len: usize = read_u16(extension.data, offset)::usize;
    ret request_len == extension.len - offset - 2;
}

fun valid_alpn(extension: Extension, context: Context) bool {
    if (extension.len < 4) { ret false; }
    val list_len: usize = read_u16(extension.data, 0)::usize;
    if (list_len != extension.len - 2) { ret false; }
    var offset: usize = 2;
    var count:  usize = 0;
    for (offset < extension.len) {
        val protocol_len: usize = extension.data[offset]::usize;
        if (protocol_len == 0 || protocol_len > extension.len - offset - 1) { ret false; }
        offset = offset + 1 + protocol_len;
        count  = count + 1;
    }
    if (offset != extension.len || count == 0) { ret false; }
    if (context == ENCRYPTED_EXTENSIONS || context == TLS12_SERVER_HELLO) {
        ret count == 1;
    }
    ret true;
}

fun valid_sct(extension: Extension, context: Context) bool {
    if (context == CLIENT_HELLO || context == CERTIFICATE_REQUEST) {
        ret extension.len == 0;
    }
    if (extension.len < 2) { ret false; }
    val list_len: usize = read_u16(extension.data, 0)::usize;
    if (list_len != extension.len - 2 || list_len == 0) { ret false; }
    var offset: usize = 2;
    for (offset < extension.len) {
        if (extension.len - offset < 2) { ret false; }
        val sct_len: usize = read_u16(extension.data, offset)::usize;
        if (sct_len == 0 || sct_len > extension.len - offset - 2) { ret false; }
        offset = offset + 2 + sct_len;
    }
    ret offset == extension.len;
}

# a client offer that omits TLS 1.3 is structurally sound but unsupported; the
# version decision belongs to the server so it can answer protocol_version
fun valid_supported_versions(extension: Extension, context: Context) bool {
    if (context == SERVER_HELLO || context == HELLO_RETRY_REQUEST) {
        ret extension.len == 2 && read_u16(extension.data, 0) == tls13.VERSION;
    }
    if (extension.len < 3) { ret false; }
    val vector_len: usize = extension.data[0]::usize;
    ret vector_len == extension.len - 1 && vector_len >= 2 &&
        (vector_len & 1) == 0 && unique_u16_values(?extension.data[1], vector_len);
}

pub fun offers_tls13(value: List) bool {
    var versions: Extension;
    if (value.context != CLIENT_HELLO ||
        !find(value, SUPPORTED_VERSIONS, ?versions) || versions.len < 3) {
        ret false;
    }
    var offset: usize = 1;
    for (offset + 1 < versions.len) {
        if (read_u16(versions.data, offset) == tls13.VERSION) { ret true; }
        offset = offset + 2;
    }
    ret false;
}

fun valid_key_exchange(group: u16, data: *u8, length: usize) bool {
    if (group == tls13.X25519)    { ret length == 32; }
    if (group == tls13.SECP256R1) { ret length == 65 && data[0] == 4; }
    ret length != 0;
}

fun valid_key_share_client(extension: Extension) bool {
    if (extension.len < 6) { ret false; }
    val vector_len: usize = read_u16(extension.data, 0)::usize;
    if (vector_len != extension.len - 2 || vector_len == 0) { ret false; }
    var offset: usize = 2;
    for (offset < extension.len) {
        if (extension.len - offset < 4) { ret false; }
        val group:   u16   = read_u16(extension.data, offset);
        val key_len: usize = read_u16(extension.data, offset + 2)::usize;
        if (key_len > extension.len - offset - 4
            || !valid_key_exchange(group, ?extension.data[offset + 4], key_len)) { ret false; }
        var prior: usize = 2;
        for (prior < offset) {
            if (read_u16(extension.data, prior) == group) { ret false; }
            val prior_len: usize = read_u16(extension.data, prior + 2)::usize;
            prior = prior + 4 + prior_len;
        }
        offset = offset + 4 + key_len;
    }
    ret offset == extension.len;
}

fun valid_key_share_server(extension: Extension) bool {
    if (extension.len < 4) { ret false; }
    val group:   u16   = read_u16(extension.data, 0);
    val key_len: usize = read_u16(extension.data, 2)::usize;
    ret key_len == extension.len - 4
        && valid_key_exchange(group, ?extension.data[4], key_len)
        && (group == tls13.X25519 || group == tls13.SECP256R1);
}

fun valid_psk_modes(extension: Extension) bool {
    if (extension.len < 2 || extension.data[0]::usize != extension.len - 1) { ret false; }
    var seen_ke:  bool  = false;
    var seen_dhe: bool  = false;
    var i:        usize = 1;
    for (i < extension.len) {
        if (extension.data[i] == 0) {
            if (seen_ke) { ret false; }
            seen_ke = true;
        }
        or (extension.data[i] == 1) {
            if (seen_dhe) { ret false; }
            seen_dhe = true;
        }
        or { ret false; }
        i = i + 1;
    }
    ret seen_ke || seen_dhe;
}

fun valid_psk_client(extension: Extension) bool {
    if (extension.len < 9) { ret false; }
    val identities_len: usize = read_u16(extension.data, 0)::usize;
    if (identities_len == 0 || identities_len > extension.len - 4) { ret false; }
    var offset:         usize = 2;
    val identities_end: usize = offset + identities_len;
    var identity_count: usize = 0;
    for (offset < identities_end) {
        if (identities_end - offset < 6) { ret false; }
        val identity_len: usize = read_u16(extension.data, offset)::usize;
        if (identity_len == 0 || identity_len > identities_end - offset - 6) { ret false; }
        offset         = offset + 2 + identity_len + 4;
        identity_count = identity_count + 1;
    }
    if (offset != identities_end || extension.len - offset < 2) { ret false; }
    val binders_len: usize = read_u16(extension.data, offset)::usize;
    offset = offset + 2;
    if (binders_len == 0 || binders_len != extension.len - offset) { ret false; }
    var binder_count: usize = 0;
    for (offset < extension.len) {
        val binder_len: usize = extension.data[offset]::usize;
        if ((binder_len != 32 && binder_len != 48)
            || binder_len > extension.len - offset - 1) { ret false; }
        offset       = offset + 1 + binder_len;
        binder_count = binder_count + 1;
    }
    ret offset == extension.len && identity_count == binder_count;
}

fun valid_distinguished_names(extension: Extension) bool {
    if (extension.len < 4) { ret false; }
    val list_len: usize = read_u16(extension.data, 0)::usize;
    if (list_len != extension.len - 2 || list_len == 0) { ret false; }
    var offset: usize = 2;
    for (offset < extension.len) {
        if (extension.len - offset < 2) { ret false; }
        val name_len: usize = read_u16(extension.data, offset)::usize;
        if (name_len == 0 || name_len > extension.len - offset - 2) { ret false; }
        offset = offset + 2 + name_len;
    }
    ret offset == extension.len;
}

fun valid_oid_filters(extension: Extension) bool {
    if (extension.len < 5) { ret false; }
    val list_len: usize = read_u16(extension.data, 0)::usize;
    if (list_len != extension.len - 2 || list_len == 0) { ret false; }
    var offset: usize = 2;
    for (offset < extension.len) {
        val oid_len: usize = extension.data[offset]::usize;
        if (oid_len == 0 || oid_len > extension.len - offset - 3) { ret false; }
        offset = offset + 1 + oid_len;
        val values_len: usize = read_u16(extension.data, offset)::usize;
        if (values_len > extension.len - offset - 2) { ret false; }
        offset = offset + 2 + values_len;
    }
    ret offset == extension.len;
}

fun valid_one(extension: Extension, context: Context) bool {
    if (!allowed(extension.kind, context)) { ret false; }
    if (extension.kind == SERVER_NAME)     { ret valid_server_name(extension, context); }
    if (extension.kind == MAX_FRAGMENT_LENGTH) {
        ret extension.len == 1 && extension.data[0] >= 1 && extension.data[0] <= 4;
    }
    if (extension.kind == STATUS_REQUEST) { ret valid_status_request(extension, context); }
    if (extension.kind == SUPPORTED_GROUPS || extension.kind == SIGNATURE_ALGORITHMS
        || extension.kind == SIGNATURE_ALGORITHMS_CERT) {
        ret u16_vector(extension.data, extension.len, 2);
    }
    if (extension.kind == APPLICATION_LAYER_PROTOCOL)   { ret valid_alpn(extension, context); }
    if (extension.kind == SIGNED_CERTIFICATE_TIMESTAMP) { ret valid_sct(extension, context); }
    if (extension.kind == PADDING) {
        var i: usize = 0;
        for (i < extension.len) {
            if (extension.data[i] != 0) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (extension.kind == RECORD_SIZE_LIMIT) {
        if (extension.len != 2) { ret false; }
        val limit: u16 = read_u16(extension.data, 0);
        ret limit >= 64 && limit <= 16385;
    }
    if (extension.kind == PRE_SHARED_KEY) {
        if (context == SERVER_HELLO) { ret extension.len == 2; }
        ret valid_psk_client(extension);
    }
    if (extension.kind == EARLY_DATA) {
        if (context == NEW_SESSION_TICKET) { ret extension.len == 4; }
        ret extension.len == 0;
    }
    if (extension.kind == SUPPORTED_VERSIONS) {
        ret valid_supported_versions(extension, context);
    }
    if (extension.kind == COOKIE) {
        ret extension.len >= 3 && read_u16(extension.data, 0)::usize == extension.len - 2;
    }
    if (extension.kind == PSK_KEY_EXCHANGE_MODES)  { ret valid_psk_modes(extension); }
    if (extension.kind == CERTIFICATE_AUTHORITIES) { ret valid_distinguished_names(extension); }
    if (extension.kind == OID_FILTERS)             { ret valid_oid_filters(extension); }
    if (extension.kind == POST_HANDSHAKE_AUTH)     { ret extension.len == 0; }
    if (extension.kind == EC_POINT_FORMATS) {
        ret extension.len >= 2 &&
            extension.data[0]::usize == extension.len - 1;
    }
    if (extension.kind == EXTENDED_MASTER_SECRET) { ret extension.len == 0; }
    if (extension.kind == RENEGOTIATION_INFO) {
        # only an initial handshake is ever accepted, so the field stays empty
        ret extension.len == 1 && extension.data[0] == 0;
    }
    if (extension.kind == KEY_SHARE) {
        if (context == CLIENT_HELLO) { ret valid_key_share_client(extension); }
        if (context == HELLO_RETRY_REQUEST) {
            if (extension.len != 2) { ret false; }
            val selected: u16 = read_u16(extension.data, 0);
            ret selected == tls13.X25519 || selected == tls13.SECP256R1;
        }
        ret valid_key_share_server(extension);
    }
    ret false;
}

pub fun validate(value: List) error.Error {
    if (!valid_context(value.context) || (value.len != 0 && value.data == nil)
        || value.len > 65535) { ret error.ILLEGAL_PARAMETER; }
    var outer:   Iterator = iterator(value);
    var current: Extension;
    var index:   usize    = 0;
    for (true) {
        val status: NextStatus = next(?outer, ?current);
        if (status == NEXT_DONE)    { ret error.OK; }
        if (status == NEXT_INVALID) { ret error.DECODE_ERROR; }
        if (!known(current.kind)) {
            if (value.context == SERVER_HELLO || value.context == HELLO_RETRY_REQUEST) {
                ret error.UNSUPPORTED_EXTENSION;
            }
        }
        or {
            if (!valid_one(current, value.context)) { ret error.ILLEGAL_PARAMETER; }
        }
        var prior:       Iterator = iterator(value);
        var candidate:   Extension;
        var prior_index: usize    = 0;
        for (prior_index < index) {
            if (next(?prior, ?candidate) != NEXT_ITEM) { ret error.DECODE_ERROR; }
            if (candidate.kind == current.kind)        { ret error.ILLEGAL_PARAMETER; }
            prior_index = prior_index + 1;
        }
        if (value.context == CLIENT_HELLO && current.kind == PRE_SHARED_KEY
            && outer.offset != value.len) { ret error.ILLEGAL_PARAMETER; }
        index = index + 1;
    }
    ret error.INTERNAL_ERROR;
}

pub fun find(value: List, kind: ExtensionType, output: *Extension) bool {
    if (output == nil || validate(value) != error.OK) { ret false; }
    var state: Iterator = iterator(value);
    for (true) {
        val status: NextStatus = next(?state, output);
        if (status != NEXT_ITEM) { ret false; }
        if (output.kind == kind) { ret true; }
    }
    ret false;
}

pub fun contains(value: List, kind: ExtensionType) bool {
    var extension: Extension;
    ret find(value, kind, ?extension);
}

test extensions__iterator_rejects_truncation_without_overrun {
    var bytes: [9]u8 = [9]u8{0, 43, 0, 3, 2, 3, 4, 0, 1};
    var i:     usize = 0;
    for (i < 9) {
        var state:     Iterator   = iterator(list(?bytes[0], i, CLIENT_HELLO));
        var extension: Extension;
        var status:    NextStatus = NEXT_ITEM;
        for (status == NEXT_ITEM) { status = next(?state, ?extension); }
        if (i == 0) {
            if (status != NEXT_DONE) { ret 1; }
        }
        or (i < 7) {
            if (status != NEXT_INVALID) { ret 2; }
        }
        i = i + 1;
    }
    ret 0;
}

test extensions__placement_duplicates_and_psk_ordering_are_strict {
    var good: [7]u8 = [7]u8{0, 43, 0, 3, 2, 3, 4};
    if (validate(list(?good[0], 7, CLIENT_HELLO)) != error.OK) { ret 1; }
    if (validate(list(?good[0], 7, SERVER_HELLO)) == error.OK) { ret 2; }
    var duplicate: [14]u8;
    var i:         usize = 0;
    for (i < 7) {
        duplicate[i]     = good[i];
        duplicate[7 + i] = good[i];
        i                = i + 1;
    }
    if (validate(list(?duplicate[0], 14, CLIENT_HELLO)) != error.ILLEGAL_PARAMETER) { ret 3; }
    var unknown: [4]u8 = [4]u8{0x7a, 0x7a, 0, 0};
    if (validate(list(?unknown[0], 4, CLIENT_HELLO)) != error.OK)                    { ret 4; }
    if (validate(list(?unknown[0], 4, SERVER_HELLO)) != error.UNSUPPORTED_EXTENSION) { ret 5; }
    ret 0;
}

test extensions__key_shares_and_algorithm_vectors_enforce_structure {
    var share: [38]u8;
    share[0] = 0;
    share[1] = 36;
    share[2] = 0;
    share[3] = 29;
    share[4] = 0;
    share[5] = 32;
    var i: usize = 0;
    for (i < 32) {
        share[6 + i] = i::u8;
        i            = i + 1;
    }
    var encoded: [42]u8;
    encoded[0] = 0;
    encoded[1] = 51;
    encoded[2] = 0;
    encoded[3] = 38;
    i          = 0;
    for (i < 38) {
        encoded[4 + i] = share[i];
        i              = i + 1;
    }
    if (validate(list(?encoded[0], 42, CLIENT_HELLO)) != error.OK) { ret 1; }
    encoded[9] = 31;
    if (validate(list(?encoded[0], 42, CLIENT_HELLO)) == error.OK) { ret 2; }
    var status_request: [4]u8 = [4]u8{0, 5, 0, 0};
    if (validate(list(?status_request[0], 4, CERTIFICATE_REQUEST)) != error.OK) { ret 3; }
    var nonempty_status: [5]u8 = [5]u8{0, 5, 0, 1, 0};
    if (validate(list(?nonempty_status[0], 5, CERTIFICATE_REQUEST)) == error.OK) { ret 4; }
    ret 0;
}

test extensions__psk_identities_and_binders_have_matching_cardinality {
    var psk: [48]u8;
    psk[0]  = 0;
    psk[1]  = 41;
    psk[2]  = 0;
    psk[3]  = 44;
    psk[4]  = 0;
    psk[5]  = 7;
    psk[6]  = 0;
    psk[7]  = 1;
    psk[8]  = 0xaa;
    psk[9]  = 0;
    psk[10] = 0;
    psk[11] = 0;
    psk[12] = 1;
    psk[13] = 0;
    psk[14] = 33;
    psk[15] = 32;
    var i: usize = 0;
    for (i < 32) {
        psk[16 + i] = i::u8;
        i           = i + 1;
    }
    if (validate(list(?psk[0], 48, CLIENT_HELLO)) != error.OK) { ret 1; }
    i = 1;
    for (i < 48) {
        if (validate(list(?psk[0], i, CLIENT_HELLO)) == error.OK) { ret 2; }
        i = i + 1;
    }
    psk[15] = 31;
    if (validate(list(?psk[0], 48, CLIENT_HELLO)) == error.OK) { ret 3; }
    psk[15] = 32;
    psk[3]  = 45;
    if (validate(list(?psk[0], 48, CLIENT_HELLO)) == error.OK) { ret 4; }
    psk[3] = 44;
    psk[5] = 8;
    if (validate(list(?psk[0], 48, CLIENT_HELLO)) == error.OK) { ret 5; }
    psk[5]  = 7;
    psk[14] = 32;
    if (validate(list(?psk[0], 48, CLIENT_HELLO)) == error.OK) { ret 6; }
    psk[14] = 33;
    var out_of_order: [55]u8;
    i = 0;
    for (i < 48) {
        out_of_order[i] = psk[i];
        i               = i + 1;
    }
    out_of_order[48] = 0;
    out_of_order[49] = 43;
    out_of_order[50] = 0;
    out_of_order[51] = 3;
    out_of_order[52] = 2;
    out_of_order[53] = 3;
    out_of_order[54] = 4;
    if (validate(list(?out_of_order[0], 55, CLIENT_HELLO)) != error.ILLEGAL_PARAMETER) {
        ret 7;
    }
    ret 0;
}
