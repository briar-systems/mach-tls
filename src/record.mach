# bounded tls 1.2 and tls 1.3 record protection

use crypto.aead.aes_gcm;
use chacha: crypto.aead.chacha20_poly1305;
use crypto.contracts;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls_error: tls.error;
use tls.memory_range;

pub def ContentType: u8;

pub val INVALID:            ContentType = 0;
pub val CHANGE_CIPHER_SPEC: ContentType = 20;
pub val ALERT:              ContentType = 21;
pub val HANDSHAKE:          ContentType = 22;
pub val APPLICATION_DATA:   ContentType = 23;

pub def Protocol: u8;
pub val TLS12: Protocol = 12;
pub val TLS13: Protocol = 13;

pub def Algorithm: u8;
pub val AES_128_GCM:       Algorithm = 1;
pub val AES_256_GCM:       Algorithm = 2;
pub val CHACHA20_POLY1305: Algorithm = 3;

pub def AlertLevel: u8;
pub val WARNING: AlertLevel = 1;
pub val FATAL:   AlertLevel = 2;

pub def AlertDescription: u8;
pub val CLOSE_NOTIFY:                   AlertDescription = 0;
pub val UNEXPECTED_MESSAGE_ALERT:       AlertDescription = 10;
pub val BAD_RECORD_MAC_ALERT:           AlertDescription = 20;
pub val RECORD_OVERFLOW_ALERT:          AlertDescription = 22;
pub val HANDSHAKE_FAILURE_ALERT:        AlertDescription = 40;
pub val BAD_CERTIFICATE_ALERT:          AlertDescription = 42;
pub val UNSUPPORTED_CERTIFICATE_ALERT:  AlertDescription = 43;
pub val CERTIFICATE_REVOKED_ALERT:      AlertDescription = 44;
pub val CERTIFICATE_EXPIRED_ALERT:      AlertDescription = 45;
pub val CERTIFICATE_UNKNOWN_ALERT:      AlertDescription = 46;
pub val ILLEGAL_PARAMETER_ALERT:        AlertDescription = 47;
pub val UNKNOWN_CA_ALERT:               AlertDescription = 48;
pub val ACCESS_DENIED_ALERT:            AlertDescription = 49;
pub val DECODE_ERROR_ALERT:             AlertDescription = 50;
pub val DECRYPT_ERROR_ALERT:            AlertDescription = 51;
pub val PROTOCOL_VERSION_ALERT:         AlertDescription = 70;
pub val INSUFFICIENT_SECURITY_ALERT:    AlertDescription = 71;
pub val INTERNAL_ERROR_ALERT:           AlertDescription = 80;
pub val INAPPROPRIATE_FALLBACK_ALERT:   AlertDescription = 86;
pub val USER_CANCELED_ALERT:            AlertDescription = 90;
pub val NO_RENEGOTIATION_ALERT:         AlertDescription = 100;
pub val MISSING_EXTENSION_ALERT:        AlertDescription = 109;
pub val UNSUPPORTED_EXTENSION_ALERT:    AlertDescription = 110;
pub val UNRECOGNIZED_NAME_ALERT:        AlertDescription = 112;
pub val BAD_CERT_STATUS_RESPONSE_ALERT: AlertDescription = 113;
pub val UNKNOWN_PSK_IDENTITY_ALERT:     AlertDescription = 115;
pub val CERTIFICATE_REQUIRED_ALERT:     AlertDescription = 116;
pub val NO_APPLICATION_PROTOCOL_ALERT:  AlertDescription = 120;
pub val NO_ALERT:                       AlertDescription = 255;

pub val HEADER_SIZE:              usize = 5;
pub val TAG_SIZE:                 usize = 16;
pub val MAX_PLAINTEXT:            usize = 16384;
pub val MAX_CIPHERTEXT_EXTRA:     usize = 256;
pub val MAX_CIPHERTEXT:           usize = MAX_PLAINTEXT + MAX_CIPHERTEXT_EXTRA;
pub val MAX_INNER_PLAINTEXT:      usize = MAX_CIPHERTEXT - TAG_SIZE;
pub val TLS12_MAX_CIPHERTEXT:     usize = MAX_PLAINTEXT + 2048;
pub val TLS12_AES_EXPLICIT_NONCE: usize = 8;

pub def ParseStatus: u8;
pub val PARSE_MORE:   ParseStatus = 0;
pub val PARSE_READY:  ParseStatus = 1;
pub val PARSE_FAILED: ParseStatus = 2;

pub rec Header {
    content_type:   ContentType;
    legacy_version: u16;
    length:         u16;
}

pub rec Frame {
    header:   Header;
    fragment: *u8;
    length:   usize;
    consumed: usize;
}

pub rec Parsed {
    status:   ParseStatus;
    error:    tls_error.Error;
    alert:    AlertDescription;
    required: usize;
    frame:    Frame;
}

pub rec AlertMessage {
    level:       AlertLevel;
    description: AlertDescription;
    recognized:  bool;
    fatal:       bool;
}

# an aead member is keyed one of two ways. a per-call member takes the raw key
# on every record through seal and open. a keyed member expands the key once,
# at install, into the cipher's context and runs every record against it
# through seal_with and open_with. a member sets exactly one pair.
pub def SealFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.SecretBytes, contracts.Buffer) contracts.Operation;
pub def OpenFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.Bytes, contracts.SecretBuffer) contracts.Operation;
pub def SealWithFun: fun(*aes_gcm.Context, contracts.Bytes, contracts.Bytes,
    contracts.SecretBytes, contracts.Buffer) contracts.Operation;
pub def OpenWithFun: fun(*aes_gcm.Context, contracts.Bytes, contracts.Bytes,
    contracts.Bytes, contracts.SecretBuffer) contracts.Operation;

pub rec Aead {
    kind:      Algorithm;
    key_size:  usize;
    seal:      SealFun;
    open:      OpenFun;
    seal_with: SealWithFun;
    open_with: OpenWithFun;
}

# a cipher is never copied, since its context is expanded where it lives.
# key holds a per-call member's raw key and context a keyed member's expanded
# key, and the other stays empty
pub rec Cipher {
    protocol:  Protocol;
    aead:      Aead;
    key:       [32]^u8;
    key_len:   usize;
    context:   aes_gcm.Context;
    iv:        [12]u8;
    iv_len:    usize;
    sequence:  u64;
    installed: bool;
    failed:    bool;
}

pub rec Sealed {
    error:    tls_error.Error;
    alert:    AlertDescription;
    written:  usize;
    required: usize;
}

pub rec Opened {
    status:       ParseStatus;
    error:        tls_error.Error;
    alert:        AlertDescription;
    content_type: ContentType;
    written:      usize;
    consumed:     usize;
    required:     usize;
}

fun valid_content_type(value: ContentType) bool {
    ret value == CHANGE_CIPHER_SPEC || value == ALERT || value == HANDSHAKE || value == APPLICATION_DATA;
}

fun valid_inner_type(value: ContentType) bool {
    ret value == ALERT || value == HANDSHAKE || value == APPLICATION_DATA;
}

fun known_alert(value: AlertDescription) bool {
    ret value == CLOSE_NOTIFY || value == UNEXPECTED_MESSAGE_ALERT || value == BAD_RECORD_MAC_ALERT
        || value == RECORD_OVERFLOW_ALERT || value == HANDSHAKE_FAILURE_ALERT || value == BAD_CERTIFICATE_ALERT
        || value == UNSUPPORTED_CERTIFICATE_ALERT || value == CERTIFICATE_REVOKED_ALERT
        || value == CERTIFICATE_EXPIRED_ALERT || value == CERTIFICATE_UNKNOWN_ALERT
        || value == ILLEGAL_PARAMETER_ALERT || value == UNKNOWN_CA_ALERT || value == ACCESS_DENIED_ALERT
        || value == DECODE_ERROR_ALERT || value == DECRYPT_ERROR_ALERT || value == PROTOCOL_VERSION_ALERT
        || value == INSUFFICIENT_SECURITY_ALERT || value == INTERNAL_ERROR_ALERT
        || value == INAPPROPRIATE_FALLBACK_ALERT || value == USER_CANCELED_ALERT
        || value == NO_RENEGOTIATION_ALERT || value == MISSING_EXTENSION_ALERT
        || value == UNSUPPORTED_EXTENSION_ALERT || value == UNRECOGNIZED_NAME_ALERT
        || value == BAD_CERT_STATUS_RESPONSE_ALERT || value == UNKNOWN_PSK_IDENTITY_ALERT
        || value == CERTIFICATE_REQUIRED_ALERT || value == NO_APPLICATION_PROTOCOL_ALERT;
}

pub fun valid_tls13_alert(value: AlertDescription) bool {
    ret known_alert(value) && value != NO_RENEGOTIATION_ALERT;
}

fun warning_alert(protocol: Protocol, value: AlertDescription) bool {
    ret value == CLOSE_NOTIFY || value == USER_CANCELED_ALERT ||
        (protocol == TLS12 && value == NO_RENEGOTIATION_ALERT);
}

fun cipher_owner_data(cipher: *Cipher) *u8 {
    if (cipher == nil) { ret nil; }
    val address: usize = (?cipher.protocol)::usize;
    val offset:  usize = $offset_of(Cipher, protocol);
    if (address < offset) { ret nil; }
    val data: *u8 = (address - offset)::*u8;
    if (!memory_range.valid(data, $size_of(Cipher))) { ret nil; }
    ret data;
}

fun cipher_owner_overlaps(cipher: *Cipher, data: *u8, len: usize) bool {
    val owner: *u8 = cipher_owner_data(cipher);
    ret owner == nil || !memory_range.valid(data, len) ||
        memory_range.overlap(owner, $size_of(Cipher), data, len);
}

fun secret_overlap(first: *^u8, first_len: usize, second: *^u8,
    second_len: usize) bool {
    if (first_len == 0 || second_len == 0) { ret false; }
    if (first == nil || second == nil)     { ret true; }
    var i: usize = 0;
    for (i < first_len) {
        if (?first[i] == second) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < second_len) {
        if (first == ?second[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun secret_public_overlap(secret: *^u8, secret_len: usize, public: *u8,
    public_len: usize) bool {
    if (secret_len == 0 || public_len == 0) { ret false; }
    if (secret == nil || public == nil)     { ret true; }
    var i: usize = 0;
    for (i < secret_len) {
        if (?secret[i] == public) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < public_len) {
        if (secret == ?public[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun zero_public(data: *u8, length: usize) {
    if (data == nil) { ret; }
    var i: usize = 0;
    for (i < length) {
        data[i] = 0;
        i       = i + 1;
    }
}

fun read_u16(data: *u8, offset: usize) u16 {
    ret (data[offset]::u16 << 8) | data[offset + 1]::u16;
}

fun write_u16(data: *u8, offset: usize, value: u16) {
    data[offset]     = (value >> 8)::u8;
    data[offset + 1] = value::u8;
}

fun write_u64(data: *u8, offset: usize, value: u64) {
    data[offset]     = (value >> 56)::u8;
    data[offset + 1] = (value >> 48)::u8;
    data[offset + 2] = (value >> 40)::u8;
    data[offset + 3] = (value >> 32)::u8;
    data[offset + 4] = (value >> 24)::u8;
    data[offset + 5] = (value >> 16)::u8;
    data[offset + 6] = (value >> 8)::u8;
    data[offset + 7] = value::u8;
}

fun write_header(data: *u8, content_type: ContentType, version: u16, length: usize) {
    data[0] = content_type;
    write_u16(data, 1, version);
    write_u16(data, 3, length::u16);
}

fun failed_parse(error: tls_error.Error, alert: AlertDescription) Parsed {
    var result: Parsed;
    result.status = PARSE_FAILED;
    result.error  = error;
    result.alert  = alert;
    ret result;
}

pub fun inspect(input: *u8, length: usize, protocol: Protocol, protected: bool) Parsed {
    var result: Parsed;
    result.status   = PARSE_MORE;
    result.error    = tls_error.OK;
    result.alert    = NO_ALERT;
    result.required = HEADER_SIZE;
    if (protocol != TLS12 && protocol != TLS13) { ret failed_parse(tls_error.ILLEGAL_PARAMETER, ILLEGAL_PARAMETER_ALERT); }
    if (!memory_range.valid(input, length)) {
        ret failed_parse(tls_error.INTERNAL_ERROR, INTERNAL_ERROR_ALERT);
    }
    if (length < HEADER_SIZE) { ret result; }

    val content_type:    ContentType = input[0];
    val version:         u16         = read_u16(input, 1);
    val fragment_length: usize       = read_u16(input, 3)::usize;
    if (!valid_content_type(content_type)) { ret failed_parse(tls_error.UNEXPECTED_MESSAGE, UNEXPECTED_MESSAGE_ALERT); }
    if (protocol == TLS13) {
        if (protected && (content_type != APPLICATION_DATA || version != 0x0303)) {
            ret failed_parse(tls_error.UNEXPECTED_MESSAGE, UNEXPECTED_MESSAGE_ALERT);
        }
        if (!protected && version != 0x0301 && version != 0x0303) {
            ret failed_parse(tls_error.ILLEGAL_PARAMETER, PROTOCOL_VERSION_ALERT);
        }
    }
    or (protected && version != 0x0303) {
        ret failed_parse(tls_error.ILLEGAL_PARAMETER, PROTOCOL_VERSION_ALERT);
    }
    # rfc 5246 appendix e.1 lets an unprotected tls 1.2 record carry the
    # sender's lowest supported version, which every deployed client uses for
    # its first client hello
    or (!protected && (version < 0x0301 || version > 0x0303)) {
        ret failed_parse(tls_error.ILLEGAL_PARAMETER, PROTOCOL_VERSION_ALERT);
    }

    var limit: usize = MAX_PLAINTEXT;
    if (protected && protocol == TLS13) { limit = MAX_CIPHERTEXT; }
    if (protected && protocol == TLS12) { limit = TLS12_MAX_CIPHERTEXT; }
    if (fragment_length > limit)        { ret failed_parse(tls_error.RECORD_OVERFLOW, RECORD_OVERFLOW_ALERT); }
    if (!protected && content_type != APPLICATION_DATA && fragment_length == 0) {
        ret failed_parse(tls_error.UNEXPECTED_MESSAGE, UNEXPECTED_MESSAGE_ALERT);
    }
    val total: usize = HEADER_SIZE + fragment_length;
    result.required = total;
    if (length < total) { ret result; }
    result.status       = PARSE_READY;
    result.frame.header = Header{content_type: content_type, legacy_version: version, length: fragment_length::u16};
    if (fragment_length > 0) { result.frame.fragment = ?input[HEADER_SIZE]; }
    result.frame.length   = fragment_length;
    result.frame.consumed = total;
    ret result;
}

pub fun encode_plain(content_type: ContentType, protocol: Protocol, content: contracts.Bytes, output: contracts.Buffer) Sealed {
    var result: Sealed;
    result.alert = NO_ALERT;
    if (!valid_content_type(content_type) || (protocol != TLS12 && protocol != TLS13)
        || (content.len > 0 && content.data == nil)) {
        result.error = tls_error.ILLEGAL_PARAMETER;
        ret result;
    }
    if (content.len > MAX_PLAINTEXT) {
        result.error = tls_error.RECORD_OVERFLOW;
        result.alert = RECORD_OVERFLOW_ALERT;
        ret result;
    }
    if (content_type != APPLICATION_DATA && content.len == 0) {
        result.error = tls_error.UNEXPECTED_MESSAGE;
        result.alert = UNEXPECTED_MESSAGE_ALERT;
        ret result;
    }
    result.required = HEADER_SIZE + content.len;
    if (output.capacity < result.required ||
        !memory_range.valid(content.data, content.len) ||
        !memory_range.valid(output.data, result.required) ||
        memory_range.overlap(output.data, result.required,
        content.data, content.len)) {
        result.error = tls_error.RESOURCE_LIMIT;
        ret result;
    }
    write_header(output.data, content_type, 0x0303, content.len);
    var i: usize = 0;
    for (i < content.len) {
        output.data[HEADER_SIZE + i] = content.data[i];
        i                            = i + 1;
    }
    result.error   = tls_error.OK;
    result.written = result.required;
    ret result;
}

pub fun encode_alert(protocol: Protocol, description: AlertDescription, output: contracts.Buffer) Sealed {
    if ((protocol != TLS12 && protocol != TLS13) || !known_alert(description)
        || (protocol == TLS13 && description == NO_RENEGOTIATION_ALERT)) {
        ret Sealed{error: tls_error.ILLEGAL_PARAMETER, alert: NO_ALERT, written: 0, required: 0};
    }
    var data: [2]u8;
    data[0] = FATAL;
    if (warning_alert(protocol, description)) { data[0] = WARNING; }
    data[1] = description;
    ret encode_plain(ALERT, protocol, contracts.Bytes{data: ?data[0], len: 2}, output);
}

pub fun decode_alert(protocol: Protocol, data: *u8, length: usize, output: *AlertMessage) tls_error.Error {
    if ((protocol != TLS12 && protocol != TLS13) || length != 2 ||
        !memory_range.valid(data, length) ||
        !memory_range.valid(output::*u8, $size_of(AlertMessage)) ||
        memory_range.overlap(data, length, output::*u8,
        $size_of(AlertMessage))) { ret tls_error.DECODE_ERROR; }
    if (data[0] != WARNING && data[0] != FATAL) { ret tls_error.DECODE_ERROR; }
    val level:       AlertLevel       = data[0];
    val description: AlertDescription = data[1];
    val recognized:  bool             = known_alert(description) &&
        !(protocol == TLS13 && description == NO_RENEGOTIATION_ALERT);
    output.level       = level;
    output.description = description;
    output.recognized  = recognized;
    output.fatal       = level == FATAL || !recognized ||
        (protocol == TLS13 && description != CLOSE_NOTIFY &&
        description != USER_CANCELED_ALERT);
    ret tls_error.OK;
}

fun valid_secret_alert(protocol: Protocol, data: *^u8) bool {
    var bytes: [2]u8;
    bytes[0] = data[0]:>u8;
    bytes[1] = data[1]:>u8;
    var message: AlertMessage;
    ret decode_alert(protocol, ?bytes[0], 2, ?message) == tls_error.OK;
}

pub fun aead(kind: Algorithm, seal: SealFun, open: OpenFun) Aead {
    var result: Aead;
    result.kind = kind;
    result.seal = seal;
    result.open = open;
    if (kind == AES_128_GCM)                              { result.key_size = 16; }
    if (kind == AES_256_GCM || kind == CHACHA20_POLY1305) { result.key_size = 32; }
    ret result;
}

pub fun keyed_aead(kind: Algorithm, seal_with: SealWithFun,
    open_with: OpenWithFun) Aead {
    var result: Aead;
    result.kind      = kind;
    result.seal_with = seal_with;
    result.open_with = open_with;
    if (kind == AES_128_GCM) { result.key_size = 16; }
    if (kind == AES_256_GCM) { result.key_size = 32; }
    ret result;
}

pub fun aes_128_gcm() Aead {
    ret keyed_aead(AES_128_GCM, aes_gcm.seal_with, aes_gcm.open_with);
}

pub fun aes_256_gcm() Aead {
    ret keyed_aead(AES_256_GCM, aes_gcm.seal_with, aes_gcm.open_with);
}

pub fun chacha20_poly1305() Aead {
    ret aead(CHACHA20_POLY1305, chacha.seal, chacha.open);
}

fun valid_aead(value: Aead) bool {
    var expected: usize = 0;
    if (value.kind == AES_128_GCM)                                    { expected = 16; }
    if (value.kind == AES_256_GCM || value.kind == CHACHA20_POLY1305) { expected = 32; }
    if (expected == 0 || value.key_size != expected)                  { ret false; }
    if (keyed(value)) {
        ret value.seal == nil && value.open == nil &&
            (value.kind == AES_128_GCM || value.kind == AES_256_GCM);
    }
    ret value.seal != nil && value.open != nil && value.seal_with == nil &&
        value.open_with == nil;
}

fun keyed(value: Aead) bool {
    ret value.seal_with != nil && value.open_with != nil;
}

pub fun destroy(cipher: *Cipher) {
    if (cipher_owner_data(cipher) == nil) { ret; }
    ct.zeroize(?cipher.key[0], 32);
    aes_gcm.dnit(?cipher.context);
    var i: usize = 0;
    for (i < 12) {
        cipher.iv[i] = 0;
        i            = i + 1;
    }
    cipher.key_len        = 0;
    cipher.iv_len         = 0;
    cipher.sequence       = 0;
    cipher.protocol       = 0;
    cipher.aead.kind      = 0;
    cipher.aead.key_size  = 0;
    cipher.aead.seal      = nil;
    cipher.aead.open      = nil;
    cipher.aead.seal_with = nil;
    cipher.aead.open_with = nil;
    cipher.installed      = false;
    cipher.failed         = false;
}

pub fun install(cipher: *Cipher, protocol: Protocol, algorithm: Aead, key: contracts.SecretBytes, iv: contracts.Bytes) bool {
    if (cipher_owner_data(cipher) == nil ||
        (protocol != TLS12 && protocol != TLS13) || !valid_aead(algorithm)
        || key.data == nil || key.len != algorithm.key_size ||
        !memory_range.valid(iv.data, iv.len) ||
        memory_range.overlap(cipher_owner_data(cipher), $size_of(Cipher),
        iv.data, iv.len) ||
        secret_public_overlap(key.data, key.len, cipher_owner_data(cipher),
        $size_of(Cipher)) ||
        secret_public_overlap(key.data, key.len, iv.data, iv.len)) {
        ret false;
    }
    var expected_iv: usize = 12;
    if (protocol == TLS12 && (algorithm.kind == AES_128_GCM || algorithm.kind == AES_256_GCM)) { expected_iv = 4; }
    if (iv.len != expected_iv)                                                                 { ret false; }
    var staged_iv: [12]u8;
    var i:         usize = 0;
    for (i < iv.len) {
        staged_iv[i] = iv.data[i];
        i            = i + 1;
    }
    # the key lies outside the cipher, so it is read straight into place once
    # the old key is gone. a failed expansion leaves the cipher empty
    destroy(cipher);
    if (keyed(algorithm)) {
        if (aes_gcm.init(?cipher.context, key) != contracts.OK) {
            aes_gcm.dnit(?cipher.context);
            ret false;
        }
    }
    or {
        i = 0;
        for (i < key.len) {
            cipher.key[i] = key.data[i];
            i             = i + 1;
        }
        cipher.key_len = key.len;
    }
    cipher.protocol = protocol;
    cipher.aead     = algorithm;
    cipher.iv_len   = iv.len;
    i               = 0;
    for (i < iv.len) {
        cipher.iv[i] = staged_iv[i];
        i            = i + 1;
    }
    i = 0;
    for (i < 12) {
        staged_iv[i] = 0;
        i            = i + 1;
    }
    cipher.sequence  = 0;
    cipher.installed = true;
    cipher.failed    = false;
    ret true;
}

fun make_nonce(cipher: *Cipher, nonce: *u8) {
    var i: usize = 0;
    for (i < 12) {
        nonce[i] = 0;
        i        = i + 1;
    }
    if (cipher.protocol == TLS12 && (cipher.aead.kind == AES_128_GCM || cipher.aead.kind == AES_256_GCM)) {
        i = 0;
        for (i < 4) {
            nonce[i] = cipher.iv[i];
            i        = i + 1;
        }
        write_u64(nonce, 4, cipher.sequence);
        ret;
    }
    i = 0;
    for (i < 12) {
        nonce[i] = cipher.iv[i];
        i        = i + 1;
    }
    var encoded: [8]u8;
    write_u64(?encoded[0], 0, cipher.sequence);
    i = 0;
    for (i < 8) {
        nonce[4 + i] = nonce[4 + i] ^ encoded[i];
        i            = i + 1;
    }
}

fun make_tls12_aad(sequence: u64, content_type: ContentType, plaintext_length: usize, aad: *u8) {
    write_u64(aad, 0, sequence);
    aad[8] = content_type;
    write_u16(aad, 9, 0x0303);
    write_u16(aad, 11, plaintext_length::u16);
}

fun sequence_available(cipher: *Cipher) bool {
    ret cipher.sequence != 0xffffffffffffffff;
}

fun advance(cipher: *Cipher) {
    cipher.sequence = cipher.sequence + 1;
}

fun seal_failure(error: tls_error.Error, alert: AlertDescription, required: usize) Sealed {
    ret Sealed{error: error, alert: alert, written: 0, required: required};
}

fun open_failure(status: ParseStatus, error: tls_error.Error, alert: AlertDescription, consumed: usize, required: usize) Opened {
    ret Opened{status: status, error: error, alert: alert, content_type: INVALID,
        written: 0, consumed: consumed, required: required};
}

#[oblivious]
fun seal_with_cipher(cipher: *Cipher, nonce: contracts.Bytes, aad: contracts.Bytes,
    plaintext: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    if (keyed(cipher.aead)) {
        ret cipher.aead.seal_with(?cipher.context, nonce, aad, plaintext, output);
    }
    ret cipher.aead.seal(contracts.SecretBytes{data: ?cipher.key[0], len: cipher.key_len},
        nonce, aad, plaintext, output);
}

#[oblivious]
fun open_with_cipher(cipher: *Cipher, nonce: contracts.Bytes, aad: contracts.Bytes,
    input: contracts.Bytes, output: contracts.SecretBuffer) contracts.Operation {
    if (keyed(cipher.aead)) {
        ret cipher.aead.open_with(?cipher.context, nonce, aad, input, output);
    }
    ret cipher.aead.open(contracts.SecretBytes{data: ?cipher.key[0], len: cipher.key_len},
        nonce, aad, input, output);
}

pub fun seal(
    cipher: *Cipher,
    content_type: ContentType,
    content: contracts.SecretBytes,
    padding: usize,
    scratch: contracts.SecretBuffer,
    output: contracts.Buffer,
) Sealed {
    if (cipher_owner_data(cipher) == nil || !cipher.installed || cipher.failed ||
        !valid_aead(cipher.aead)) {
        ret seal_failure(tls_error.ILLEGAL_PARAMETER, NO_ALERT, 0);
    }
    if (!sequence_available(cipher)) { ret seal_failure(tls_error.SEQUENCE_EXHAUSTED, INTERNAL_ERROR_ALERT, 0); }
    if (!valid_content_type(content_type) || (content.len > 0 && content.data == nil)) {
        ret seal_failure(tls_error.ILLEGAL_PARAMETER, NO_ALERT, 0);
    }
    if (content.len > MAX_PLAINTEXT) { ret seal_failure(tls_error.RECORD_OVERFLOW, RECORD_OVERFLOW_ALERT, 0); }
    if (content_type != APPLICATION_DATA && content.len == 0) {
        ret seal_failure(tls_error.UNEXPECTED_MESSAGE, UNEXPECTED_MESSAGE_ALERT, 0);
    }
    if (content_type == ALERT && content.len != 2) { ret seal_failure(tls_error.DECODE_ERROR, DECODE_ERROR_ALERT, 0); }
    if (content_type == ALERT && !valid_secret_alert(cipher.protocol, content.data)) {
        ret seal_failure(tls_error.DECODE_ERROR, DECODE_ERROR_ALERT, 0);
    }
    if (secret_public_overlap(content.data, content.len,
        cipher_owner_data(cipher), $size_of(Cipher))) {
        ret seal_failure(tls_error.ILLEGAL_PARAMETER, NO_ALERT, 0);
    }
    var nonce: [12]u8;
    make_nonce(cipher, ?nonce[0]);
    if (cipher.protocol == TLS13) {
        if (!valid_inner_type(content_type) || padding > MAX_INNER_PLAINTEXT || content.len + 1 > MAX_INNER_PLAINTEXT - padding) {
            ret seal_failure(tls_error.RECORD_OVERFLOW, RECORD_OVERFLOW_ALERT, 0);
        }
        val inner_length:     usize = content.len + 1 + padding;
        val encrypted_length: usize = inner_length + TAG_SIZE;
        val required:         usize = HEADER_SIZE + encrypted_length;
        if (scratch.data == nil || scratch.capacity < inner_length ||
            output.capacity < required ||
            !memory_range.valid(output.data, required) ||
            cipher_owner_overlaps(cipher, output.data, required) ||
            secret_overlap(content.data, content.len, scratch.data,
            inner_length) ||
            secret_public_overlap(scratch.data, inner_length,
            cipher_owner_data(cipher), $size_of(Cipher)) ||
            secret_public_overlap(content.data, content.len, output.data,
            required) ||
            secret_public_overlap(scratch.data, inner_length, output.data,
            required)) {
            ret seal_failure(tls_error.RESOURCE_LIMIT, NO_ALERT, required);
        }
        var i: usize = 0;
        for (i < content.len) {
            scratch.data[i] = content.data[i];
            i               = i + 1;
        }
        scratch.data[content.len] = content_type:>u8;
        i                         = content.len + 1;
        for (i < inner_length) {
            scratch.data[i] = 0;
            i               = i + 1;
        }
        var aad: [5]u8;
        write_header(?aad[0], APPLICATION_DATA, 0x0303, encrypted_length);
        val operation: contracts.Operation = seal_with_cipher(cipher,
            contracts.Bytes{data: ?nonce[0], len: 12},
            contracts.Bytes{data: ?aad[0], len: 5},
            contracts.SecretBytes{data: scratch.data, len: inner_length},
            contracts.Buffer{data: ?output.data[HEADER_SIZE], capacity: encrypted_length},
        );
        ct.zeroize(scratch.data, inner_length);
        if (operation.error != contracts.OK || operation.written != encrypted_length) {
            zero_public(output.data, required);
            cipher.failed = true;
            ret seal_failure(tls_error.INTERNAL_ERROR, INTERNAL_ERROR_ALERT, required);
        }
        write_header(output.data, APPLICATION_DATA, 0x0303, encrypted_length);
        advance(cipher);
        ret Sealed{error: tls_error.OK, alert: NO_ALERT, written: required, required: required};
    }

    if (padding != 0) { ret seal_failure(tls_error.ILLEGAL_PARAMETER, NO_ALERT, 0); }
    var explicit_length: usize = 0;
    if (cipher.aead.kind == AES_128_GCM || cipher.aead.kind == AES_256_GCM) { explicit_length = TLS12_AES_EXPLICIT_NONCE; }
    val encrypted_length: usize = explicit_length + content.len + TAG_SIZE;
    val required:         usize = HEADER_SIZE + encrypted_length;
    if (output.capacity < required || !memory_range.valid(output.data, required) ||
        cipher_owner_overlaps(cipher, output.data, required) ||
        secret_public_overlap(content.data, content.len, output.data,
        required)) {
        ret seal_failure(tls_error.RESOURCE_LIMIT, NO_ALERT, required);
    }
    var aad: [13]u8;
    make_tls12_aad(cipher.sequence, content_type, content.len, ?aad[0]);
    val operation: contracts.Operation = seal_with_cipher(cipher,
        contracts.Bytes{data: ?nonce[0], len: 12},
        contracts.Bytes{data: ?aad[0], len: 13},
        content,
        contracts.Buffer{data: ?output.data[HEADER_SIZE + explicit_length],
        capacity: content.len + TAG_SIZE},
    );
    if (operation.error != contracts.OK || operation.written != content.len + TAG_SIZE) {
        zero_public(output.data, required);
        cipher.failed = true;
        ret seal_failure(tls_error.INTERNAL_ERROR, INTERNAL_ERROR_ALERT, required);
    }
    if (explicit_length > 0) { write_u64(output.data, HEADER_SIZE, cipher.sequence); }
    write_header(output.data, content_type, 0x0303, encrypted_length);
    advance(cipher);
    ret Sealed{error: tls_error.OK, alert: NO_ALERT, written: required, required: required};
}

fun mark_peer_failure(cipher: *Cipher, error: tls_error.Error, alert: AlertDescription, consumed: usize, required: usize) Opened {
    cipher.failed = true;
    ret open_failure(PARSE_FAILED, error, alert, consumed, required);
}

#[oblivious]
fun inspect_inner(data: *^u8, length: usize, has_content: *bool,
    decoded_type: *ContentType, decoded_end: *usize) {
    var present:      ^u8    = 0;
    var content_type: ^u8    = 0;
    var content_end:  ^usize = 0;
    var i:            usize  = 0;
    for (i < length) {
        val nonzero: ^u8 = 1 ^ ct.is_zero[u8](data[i]);
        present      = present | nonzero;
        content_type = ct.select_u8(nonzero, data[i], content_type);
        content_end  = ct.select_usize(nonzero, i + 1, content_end);
        i            = i + 1;
    }
    has_content[0]  = present:>u8 != 0;
    decoded_type[0] = content_type:>u8;
    decoded_end[0]  = content_end:>usize;
}

pub fun open(cipher: *Cipher, input: *u8, length: usize, output: contracts.SecretBuffer) Opened {
    if (cipher_owner_data(cipher) == nil || !cipher.installed || cipher.failed ||
        !valid_aead(cipher.aead) || !memory_range.valid(input, length) ||
        cipher_owner_overlaps(cipher, input, length)) {
        ret open_failure(PARSE_FAILED, tls_error.ILLEGAL_PARAMETER, NO_ALERT, 0, 0);
    }
    if (!sequence_available(cipher)) {
        ret open_failure(PARSE_FAILED, tls_error.SEQUENCE_EXHAUSTED, INTERNAL_ERROR_ALERT, 0, 0);
    }
    val parsed: Parsed = inspect(input, length, cipher.protocol, true);
    if (parsed.status == PARSE_MORE)   { ret open_failure(PARSE_MORE, tls_error.OK, NO_ALERT, 0, parsed.required); }
    if (parsed.status == PARSE_FAILED) { ret mark_peer_failure(cipher, parsed.error, parsed.alert, 0, parsed.required); }

    var explicit_length: usize = 0;
    if (cipher.protocol == TLS12 && (cipher.aead.kind == AES_128_GCM || cipher.aead.kind == AES_256_GCM)) {
        explicit_length = TLS12_AES_EXPLICIT_NONCE;
    }
    if (parsed.frame.length < explicit_length + TAG_SIZE) {
        ret mark_peer_failure(cipher, tls_error.DECODE_ERROR, DECODE_ERROR_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }
    val plaintext_length: usize = parsed.frame.length - explicit_length - TAG_SIZE;
    if (cipher.protocol == TLS13 && plaintext_length > MAX_INNER_PLAINTEXT) {
        ret mark_peer_failure(cipher, tls_error.RECORD_OVERFLOW, RECORD_OVERFLOW_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }
    if (cipher.protocol == TLS12 && plaintext_length > MAX_PLAINTEXT) {
        ret mark_peer_failure(cipher, tls_error.RECORD_OVERFLOW, RECORD_OVERFLOW_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }
    if ((plaintext_length > 0 && output.data == nil) ||
        output.capacity < plaintext_length ||
        secret_public_overlap(output.data, plaintext_length,
        cipher_owner_data(cipher), $size_of(Cipher)) ||
        secret_public_overlap(output.data, plaintext_length, input,
        parsed.frame.consumed)) {
        ret open_failure(PARSE_READY, tls_error.RESOURCE_LIMIT, NO_ALERT, 0, plaintext_length);
    }

    var nonce: [12]u8;
    make_nonce(cipher, ?nonce[0]);
    if (explicit_length > 0) {
        var i: usize = 0;
        for (i < 8) {
            nonce[4 + i] = parsed.frame.fragment[i];
            i            = i + 1;
        }
    }
    var aad13: [13]u8;
    var aad5:  [5]u8;
    var aad:   contracts.Bytes;
    if (cipher.protocol == TLS13) {
        var i: usize = 0;
        for (i < 5) {
            aad5[i] = input[i];
            i       = i + 1;
        }
        aad = contracts.Bytes{data: ?aad5[0], len: 5};
    }
    or {
        make_tls12_aad(cipher.sequence, parsed.frame.header.content_type, plaintext_length, ?aad13[0]);
        aad = contracts.Bytes{data: ?aad13[0], len: 13};
    }
    val operation: contracts.Operation = open_with_cipher(cipher,
        contracts.Bytes{data: ?nonce[0], len: 12},
        aad,
        contracts.Bytes{data: ?parsed.frame.fragment[explicit_length], len: parsed.frame.length - explicit_length},
        contracts.SecretBuffer{data: output.data, capacity: plaintext_length},
    );
    if (operation.error == contracts.AUTH_FAILED) {
        ct.zeroize(output.data, plaintext_length);
        ret mark_peer_failure(cipher, tls_error.BAD_RECORD_MAC, BAD_RECORD_MAC_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }
    if (operation.error != contracts.OK || operation.written != plaintext_length) {
        if (output.data != nil) { ct.zeroize(output.data, plaintext_length); }
        ret mark_peer_failure(cipher, tls_error.INTERNAL_ERROR, INTERNAL_ERROR_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }

    if (cipher.protocol == TLS12) {
        if (parsed.frame.header.content_type != APPLICATION_DATA && operation.written == 0) {
            ct.zeroize(output.data, operation.written);
            ret mark_peer_failure(cipher, tls_error.UNEXPECTED_MESSAGE, UNEXPECTED_MESSAGE_ALERT, parsed.frame.consumed, parsed.frame.consumed);
        }
        if (parsed.frame.header.content_type == ALERT && operation.written != 2) {
            ct.zeroize(output.data, operation.written);
            ret mark_peer_failure(cipher, tls_error.DECODE_ERROR, DECODE_ERROR_ALERT, parsed.frame.consumed, parsed.frame.consumed);
        }
        if (parsed.frame.header.content_type == ALERT && !valid_secret_alert(TLS12, output.data)) {
            ct.zeroize(output.data, operation.written);
            ret mark_peer_failure(cipher, tls_error.DECODE_ERROR, DECODE_ERROR_ALERT, parsed.frame.consumed, parsed.frame.consumed);
        }
        advance(cipher);
        ret Opened{status: PARSE_READY, error: tls_error.OK, alert: NO_ALERT, content_type: parsed.frame.header.content_type,
            written: operation.written, consumed: parsed.frame.consumed, required: parsed.frame.consumed};
    }

    var has_content:  bool;
    var content_type: ContentType;
    var content_end:  usize;
    inspect_inner(output.data, operation.written, ?has_content, ?content_type, ?content_end);
    if (!has_content) {
        ct.zeroize(output.data, operation.written);
        ret mark_peer_failure(cipher, tls_error.UNEXPECTED_MESSAGE, UNEXPECTED_MESSAGE_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }
    val content_length: usize = content_end - 1;
    if (!valid_inner_type(content_type) || (content_type != APPLICATION_DATA && content_length == 0)
        || (content_type == ALERT && content_length != 2)) {
        ct.zeroize(output.data, operation.written);
        ret mark_peer_failure(cipher, tls_error.UNEXPECTED_MESSAGE, UNEXPECTED_MESSAGE_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }
    if (content_type == ALERT && !valid_secret_alert(TLS13, output.data)) {
        ct.zeroize(output.data, operation.written);
        ret mark_peer_failure(cipher, tls_error.DECODE_ERROR, DECODE_ERROR_ALERT, parsed.frame.consumed, parsed.frame.consumed);
    }
    ct.zeroize(?output.data[content_length], operation.written - content_length);
    advance(cipher);
    ret Opened{status: PARSE_READY, error: tls_error.OK, alert: NO_ALERT, content_type: content_type,
        written: content_length, consumed: parsed.frame.consumed, required: parsed.frame.consumed};
}

var fake_seal_calls:        usize;
var fake_open_calls:        usize;
var observed_seal_capacity: usize;
var observed_open_capacity: usize;
var max_padding_scratch:    [MAX_INNER_PLAINTEXT]^u8;
var max_padding_wire:       [HEADER_SIZE + MAX_CIPHERTEXT]u8;
var max_padding_plaintext:  [MAX_INNER_PLAINTEXT]^u8;

fun fake_tag(aad: contracts.Bytes, nonce: contracts.Bytes, data: *u8, length: usize) u32 {
    var value: u32   = length::u32;
    var i:     usize = 0;
    for (i < aad.len) {
        value = value ^ aad.data[i]::u32;
        i     = i + 1;
    }
    i = 0;
    for (i < nonce.len) {
        value = value ^ nonce.data[i]::u32;
        i     = i + 1;
    }
    i = 0;
    for (i < length) {
        value = value ^ data[i]::u32;
        i     = i + 1;
    }
    ret value & 0xff;
}

#[oblivious]
fun fake_seal(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    plaintext: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    fake_seal_calls = fake_seal_calls + 1;
    val required: usize = plaintext.len + TAG_SIZE;
    if (output.data == nil || output.capacity < required) { ret contracts.Operation{error: contracts.OUTPUT_TOO_SMALL, written: 0}; }
    var i: usize = 0;
    for (i < plaintext.len) {
        output.data[i] = (plaintext.data[i] ^ key.data[0]):>u8;
        i              = i + 1;
    }
    val tag: u32 = fake_tag(aad, nonce, output.data, plaintext.len);
    i = 0;
    for (i < TAG_SIZE) {
        output.data[plaintext.len + i] = (tag ^ i::u32)::u8;
        i                              = i + 1;
    }
    ret contracts.Operation{error: contracts.OK, written: required};
}

#[oblivious]
fun fake_open(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    input: contracts.Bytes, output: contracts.SecretBuffer) contracts.Operation {
    fake_open_calls = fake_open_calls + 1;
    if (input.len < TAG_SIZE) { ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0}; }
    val plaintext_length: usize = input.len - TAG_SIZE;
    if (output.capacity < plaintext_length || (plaintext_length > 0 && output.data == nil)) {
        ret contracts.Operation{error: contracts.OUTPUT_TOO_SMALL, written: 0};
    }
    val tag:        u32   = fake_tag(aad, nonce, input.data, plaintext_length);
    var difference: u32   = 0;
    var i:          usize = 0;
    for (i < TAG_SIZE) {
        difference = difference | (input.data[plaintext_length + i]::u32 ^ tag ^ i::u32);
        i          = i + 1;
    }
    if (difference != 0) {
        ct.zeroize(output.data, plaintext_length);
        ret contracts.Operation{error: contracts.AUTH_FAILED, written: 0};
    }
    i = 0;
    for (i < plaintext_length) {
        output.data[i] = input.data[i] ^ key.data[0];
        i              = i + 1;
    }
    ret contracts.Operation{error: contracts.OK, written: plaintext_length};
}

fun leaky_reject_open(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    input: contracts.Bytes, output: contracts.SecretBuffer) contracts.Operation {
    fake_open_calls = fake_open_calls + 1;
    ret contracts.Operation{error: contracts.AUTH_FAILED, written: 0};
}

fun short_seal(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    plaintext: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    fake_seal_calls = fake_seal_calls + 1;
    if (output.data != nil && output.capacity > 0) { output.data[0] = 0xaa; }
    ret contracts.Operation{error: contracts.OK, written: 1};
}

fun wide_fail_seal(key: contracts.SecretBytes, nonce: contracts.Bytes,
    aad: contracts.Bytes, plaintext: contracts.SecretBytes,
    output: contracts.Buffer) contracts.Operation {
    observed_seal_capacity = output.capacity;
    var i: usize = 0;
    for (i < output.capacity) {
        output.data[i] = 0xaa;
        i              = i + 1;
    }
    ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0};
}

fun wide_fail_open(key: contracts.SecretBytes, nonce: contracts.Bytes,
    aad: contracts.Bytes, input: contracts.Bytes,
    output: contracts.SecretBuffer) contracts.Operation {
    observed_open_capacity = output.capacity;
    var i: usize = 0;
    for (i < output.capacity) {
        output.data[i] = 0xaa;
        i              = i + 1;
    }
    ret contracts.Operation{error: contracts.AUTH_FAILED, written: 0};
}

fun test_key(key: *^u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        key[i] = (i + 1)::u8;
        i      = i + 1;
    }
}

fun fill_secret(data: *^u8, length: usize, first: u8) {
    var i: usize = 0;
    for (i < length) {
        data[i] = (first::usize + i)::u8;
        i       = i + 1;
    }
}

fun fill_public(data: *u8, length: usize, first: u8) {
    var i: usize = 0;
    for (i < length) {
        data[i] = (first::usize + i)::u8;
        i       = i + 1;
    }
}

fun wire_equal(actual: *u8, expected: *u8, length: usize) bool {
    var i: usize = 0;
    for (i < length) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "record: tls 1.3 real aead records match independent vectors" {
    var aes128_key: [16]^u8;
    var aes128_iv:  [12]u8;
    fill_secret(?aes128_key[0], 16, 0);
    fill_public(?aes128_iv[0], 12, 0x10);
    var hello: [5]^u8;
    hello[0] = 'h';
    hello[1] = 'e';
    hello[2] = 'l';
    hello[3] = 'l';
    hello[4] = 'o';
    var scratch: [32]^u8;
    var wire:    [64]u8;
    var sender:  Cipher;
    if (!install(?sender, TLS13, aes_128_gcm(),
        contracts.SecretBytes{data: ?aes128_key[0], len: 16},
        contracts.Bytes{data: ?aes128_iv[0], len: 12})) { ret 1; }
    val aes128_sealed: Sealed = seal(?sender, HANDSHAKE,
        contracts.SecretBytes{data: ?hello[0], len: 5}, 2,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 32},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    var aes128_expected: [29]u8 = [29]u8{
        0x17, 0x03, 0x03, 0x00, 0x18, 0xac, 0x4b, 0x6f, 0xc3, 0x60,
        0x59, 0xb6, 0xef, 0x6b, 0xc7, 0x4e, 0xf9, 0x53, 0x7c, 0x3c,
        0xed, 0x80, 0x62, 0xa0, 0x83, 0xaf, 0x23, 0x81, 0x69,
    };
    if (aes128_sealed.error != tls_error.OK || aes128_sealed.written != 29
        || !wire_equal(?wire[0], ?aes128_expected[0], 29)) { ret 2; }
    var receiver: Cipher;
    install(?receiver, TLS13, aes_128_gcm(),
        contracts.SecretBytes{data: ?aes128_key[0], len: 16},
        contracts.Bytes{data: ?aes128_iv[0], len: 12});
    var plaintext:     [32]^u8;
    val aes128_opened: Opened = open(?receiver, ?wire[0], 29,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 32});
    if (aes128_opened.error != tls_error.OK || aes128_opened.content_type != HANDSHAKE
        || aes128_opened.written != 5) { ret 3; }
    var i: usize = 0;
    for (i < 5) {
        if (plaintext[i]:>u8 != hello[i]:>u8) { ret 4; }
        i = i + 1;
    }
    for (i < 8) {
        if (plaintext[i]:>u8 != 0) { ret 5; }
        i = i + 1;
    }
    install(?receiver, TLS13, aes_128_gcm(),
        contracts.SecretBytes{data: ?aes128_key[0], len: 16},
        contracts.Bytes{data: ?aes128_iv[0], len: 12});
    wire[28] = wire[28] ^ 1;
    i        = 0;
    for (i < 8) {
        plaintext[i] = 0xaa;
        i            = i + 1;
    }
    val rejected: Opened = open(?receiver, ?wire[0], 29,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 32});
    if (rejected.error != tls_error.BAD_RECORD_MAC || rejected.alert != BAD_RECORD_MAC_ALERT
        || !receiver.failed) { ret 6; }
    i = 0;
    for (i < 8) {
        if (plaintext[i]:>u8 != 0) { ret 6; }
        i = i + 1;
    }

    var aes256_key: [32]^u8;
    var aes256_iv:  [12]u8;
    fill_secret(?aes256_key[0], 32, 0);
    fill_public(?aes256_iv[0], 12, 0x20);
    var alert_data: [2]^u8;
    alert_data[0] = FATAL;
    alert_data[1] = CLOSE_NOTIFY;
    install(?sender, TLS13, aes_256_gcm(),
        contracts.SecretBytes{data: ?aes256_key[0], len: 32},
        contracts.Bytes{data: ?aes256_iv[0], len: 12});
    sender.sequence = 5;
    val aes256_sealed: Sealed = seal(?sender, ALERT,
        contracts.SecretBytes{data: ?alert_data[0], len: 2}, 3,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 32},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    var aes256_expected: [27]u8 = [27]u8{
        0x17, 0x03, 0x03, 0x00, 0x16, 0x16, 0x55, 0x7b, 0x76,
        0x7d, 0xe3, 0xc9, 0x4a, 0x8b, 0xdb, 0xe3, 0xbf, 0x38,
        0xb7, 0xc4, 0xfb, 0x31, 0x98, 0x20, 0x44, 0xfa, 0x55,
    };
    if (aes256_sealed.error != tls_error.OK || aes256_sealed.written != 27
        || !wire_equal(?wire[0], ?aes256_expected[0], 27)) { ret 7; }
    install(?receiver, TLS13, aes_256_gcm(),
        contracts.SecretBytes{data: ?aes256_key[0], len: 32},
        contracts.Bytes{data: ?aes256_iv[0], len: 12});
    receiver.sequence = 5;
    val aes256_opened: Opened = open(?receiver, ?wire[0], 27,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 32});
    if (aes256_opened.error != tls_error.OK || aes256_opened.content_type != ALERT
        || aes256_opened.written != 2 || plaintext[0]:>u8 != FATAL
        || plaintext[1]:>u8 != CLOSE_NOTIFY) { ret 8; }

    var chacha_key: [32]^u8;
    var chacha_iv:  [12]u8;
    fill_secret(?chacha_key[0], 32, 0);
    fill_public(?chacha_iv[0], 12, 0x30);
    var mach: [4]^u8;
    mach[0] = 'm';
    mach[1] = 'a';
    mach[2] = 'c';
    mach[3] = 'h';
    install(?sender, TLS13, chacha20_poly1305(),
        contracts.SecretBytes{data: ?chacha_key[0], len: 32},
        contracts.Bytes{data: ?chacha_iv[0], len: 12});
    sender.sequence = 7;
    val chacha_sealed: Sealed = seal(?sender, APPLICATION_DATA,
        contracts.SecretBytes{data: ?mach[0], len: 4}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 32},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    var chacha_expected: [26]u8 = [26]u8{
        0x17, 0x03, 0x03, 0x00, 0x15, 0xaa, 0xa0, 0xdf, 0x67,
        0x48, 0xe7, 0x46, 0x76, 0x81, 0xd8, 0x61, 0x73, 0x6e,
        0x63, 0xd7, 0xcd, 0x90, 0x44, 0x6d, 0xba, 0x33,
    };
    if (chacha_sealed.error != tls_error.OK || chacha_sealed.written != 26
        || !wire_equal(?wire[0], ?chacha_expected[0], 26)) { ret 9; }
    install(?receiver, TLS13, chacha20_poly1305(),
        contracts.SecretBytes{data: ?chacha_key[0], len: 32},
        contracts.Bytes{data: ?chacha_iv[0], len: 12});
    receiver.sequence = 7;
    val chacha_opened: Opened = open(?receiver, ?wire[0], 26,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 32});
    if (chacha_opened.error != tls_error.OK || chacha_opened.content_type != APPLICATION_DATA
        || chacha_opened.written != 4) { ret 10; }
    i = 0;
    for (i < 4) {
        if (plaintext[i]:>u8 != mach[i]:>u8) { ret 11; }
        i = i + 1;
    }
    ret 0;
}

test "record: tls 1.2 real aead records match independent vectors" {
    var aes_key: [16]^u8;
    var aes_iv:  [4]u8;
    fill_secret(?aes_key[0], 16, 0);
    fill_public(?aes_iv[0], 4, 0xa0);
    var hello: [5]^u8;
    hello[0] = 'h';
    hello[1] = 'e';
    hello[2] = 'l';
    hello[3] = 'l';
    hello[4] = 'o';
    var wire:   [64]u8;
    var sender: Cipher;
    install(?sender, TLS12, aes_128_gcm(), contracts.SecretBytes{data: ?aes_key[0], len: 16},
        contracts.Bytes{data: ?aes_iv[0], len: 4});
    sender.sequence = 3;
    val aes_sealed: Sealed = seal(?sender, APPLICATION_DATA,
        contracts.SecretBytes{data: ?hello[0], len: 5}, 0,
        contracts.SecretBuffer{data: nil, capacity: 0},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    var aes_expected: [34]u8 = [34]u8{
        0x17, 0x03, 0x03, 0x00, 0x1d, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x03, 0xce, 0xf4, 0xbe, 0xb8, 0xcf,
        0xfc, 0xbd, 0x5d, 0x97, 0x48, 0xaf, 0x66, 0x23, 0x83,
        0x25, 0x44, 0xed, 0x91, 0xf9, 0x73, 0x3b,
    };
    if (aes_sealed.error != tls_error.OK || aes_sealed.written != 34
        || !wire_equal(?wire[0], ?aes_expected[0], 34)) { ret 1; }
    var receiver: Cipher;
    install(?receiver, TLS12, aes_128_gcm(), contracts.SecretBytes{data: ?aes_key[0], len: 16},
        contracts.Bytes{data: ?aes_iv[0], len: 4});
    receiver.sequence = 3;
    var plaintext:  [16]^u8;
    val aes_opened: Opened = open(?receiver, ?wire[0], 34,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 16});
    if (aes_opened.error != tls_error.OK || aes_opened.content_type != APPLICATION_DATA
        || aes_opened.written != 5) { ret 2; }
    var i: usize = 0;
    for (i < 5) {
        if (plaintext[i]:>u8 != hello[i]:>u8) { ret 3; }
        i = i + 1;
    }

    var chacha_key: [32]^u8;
    var chacha_iv:  [12]u8;
    fill_secret(?chacha_key[0], 32, 0);
    fill_public(?chacha_iv[0], 12, 0x40);
    var mach: [4]^u8;
    mach[0] = 'm';
    mach[1] = 'a';
    mach[2] = 'c';
    mach[3] = 'h';
    install(?sender, TLS12, chacha20_poly1305(),
        contracts.SecretBytes{data: ?chacha_key[0], len: 32},
        contracts.Bytes{data: ?chacha_iv[0], len: 12});
    sender.sequence = 9;
    val chacha_sealed: Sealed = seal(?sender, HANDSHAKE,
        contracts.SecretBytes{data: ?mach[0], len: 4}, 0,
        contracts.SecretBuffer{data: nil, capacity: 0},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    var chacha_expected: [25]u8 = [25]u8{
        0x16, 0x03, 0x03, 0x00, 0x14, 0x35, 0x9f, 0x01, 0x98,
        0xf3, 0xe6, 0x3b, 0x96, 0xfa, 0x57, 0x3a, 0xad, 0x4b,
        0xdf, 0x36, 0x71, 0xf0, 0x35, 0x4f, 0xbb,
    };
    if (chacha_sealed.error != tls_error.OK || chacha_sealed.written != 25
        || !wire_equal(?wire[0], ?chacha_expected[0], 25)) { ret 4; }
    install(?receiver, TLS12, chacha20_poly1305(),
        contracts.SecretBytes{data: ?chacha_key[0], len: 32},
        contracts.Bytes{data: ?chacha_iv[0], len: 12});
    receiver.sequence = 9;
    val chacha_opened: Opened = open(?receiver, ?wire[0], 25,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 16});
    if (chacha_opened.error != tls_error.OK || chacha_opened.content_type != HANDSHAKE
        || chacha_opened.written != 4) { ret 5; }
    i = 0;
    for (i < 4) {
        if (plaintext[i]:>u8 != mach[i]:>u8) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test "record: fragmented headers and bodies retain exact requirements" {
    var data: [9]u8 = [9]u8{APPLICATION_DATA, 3, 3, 0, 4, 't', 'e', 's', 't'};
    var i:    usize = 0;
    for (i < 9) {
        val parsed:   Parsed = inspect(?data[0], i, TLS13, false);
        var expected: usize  = 9;
        if (i < 5)                                                      { expected = HEADER_SIZE; }
        if (parsed.status != PARSE_MORE || parsed.required != expected) { ret 1; }
        i = i + 1;
    }
    val ready: Parsed = inspect(?data[0], 9, TLS13, false);
    if (ready.status != PARSE_READY || ready.frame.length != 4 || ready.frame.consumed != 9) { ret 2; }
    data[0] = 19;
    if (inspect(?data[0], 9, TLS13, false).error != tls_error.UNEXPECTED_MESSAGE) { ret 3; }
    data[0] = APPLICATION_DATA;
    data[1] = 3;
    data[2] = 2;
    if (inspect(?data[0], 9, TLS12, true).error != tls_error.ILLEGAL_PARAMETER) { ret 4; }
    ret 0;
}

test "record: tls 1.3 encrypts type and padding and authenticates before release" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv: [12]u8;
    var i:  usize = 0;
    for (i < 12) {
        iv[i] = (0xa0 + i)::u8;
        i     = i + 1;
    }
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var sender:    Cipher;
    var receiver:  Cipher;
    if (!install(?sender, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12})
        || !install(?receiver, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12})) { ret 1; }
    var message: [5]^u8;
    message[0] = 'h';
    message[1] = 'e';
    message[2] = 'l';
    message[3] = 'l';
    message[4] = 'o';
    var scratch: [64]^u8;
    var wire:    [128]u8;
    val sealed:  Sealed = seal(?sender, HANDSHAKE, contracts.SecretBytes{data: ?message[0], len: 5}, 7,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 64}, contracts.Buffer{data: ?wire[0], capacity: 128});
    if (sealed.error != tls_error.OK || sealed.written != 34 || wire[0] != APPLICATION_DATA || sender.sequence != 1) { ret 2; }
    var plaintext: [64]^u8;
    val opened:    Opened = open(?receiver, ?wire[0], sealed.written, contracts.SecretBuffer{data: ?plaintext[0], capacity: 64});
    if (opened.error != tls_error.OK || opened.content_type != HANDSHAKE || opened.written != 5 || receiver.sequence != 1) { ret 3; }
    i = 0;
    for (i < 5) {
        if (plaintext[i]:>u8 != message[i]:>u8) { ret 4; }
        i = i + 1;
    }
    i = 5;
    for (i < 13) {
        if (plaintext[i]:>u8 != 0) { ret 5; }
        i = i + 1;
    }

    var rejected_receiver: Cipher;
    install(?rejected_receiver, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12});
    wire[sealed.written - 1] = wire[sealed.written - 1] ^ 1;
    i                        = 0;
    for (i < 64) {
        plaintext[i] = 0xaa;
        i            = i + 1;
    }
    val rejected: Opened = open(?rejected_receiver, ?wire[0], sealed.written, contracts.SecretBuffer{data: ?plaintext[0], capacity: 64});
    if (rejected.error != tls_error.BAD_RECORD_MAC || rejected.alert != BAD_RECORD_MAC_ALERT || !rejected_receiver.failed) { ret 6; }
    i = 0;
    for (i < 13) {
        if (plaintext[i]:>u8 != 0) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "record: tls 1.2 aes and chacha nonce layouts round trip" {
    var aes_key: [16]^u8;
    test_key(?aes_key[0], 16);
    var aes_iv:       [4]u8 = [4]u8{1, 2, 3, 4};
    val aes:          Aead  = aead(AES_128_GCM, fake_seal, fake_open);
    var aes_sender:   Cipher;
    var aes_receiver: Cipher;
    install(?aes_sender, TLS12, aes, contracts.SecretBytes{data: ?aes_key[0], len: 16}, contracts.Bytes{data: ?aes_iv[0], len: 4});
    install(?aes_receiver, TLS12, aes, contracts.SecretBytes{data: ?aes_key[0], len: 16}, contracts.Bytes{data: ?aes_iv[0], len: 4});
    var message: [3]^u8;
    message[0] = 't';
    message[1] = 'l';
    message[2] = 's';
    var wire:       [96]u8;
    val aes_sealed: Sealed = seal(?aes_sender, HANDSHAKE, contracts.SecretBytes{data: ?message[0], len: 3}, 0,
        contracts.SecretBuffer{data: nil, capacity: 0}, contracts.Buffer{data: ?wire[0], capacity: 96});
    if (aes_sealed.error != tls_error.OK || aes_sealed.written != 32 || read_u16(?wire[0], 3) != 27) { ret 1; }
    var plaintext:  [32]^u8;
    val aes_opened: Opened = open(?aes_receiver, ?wire[0], aes_sealed.written, contracts.SecretBuffer{data: ?plaintext[0], capacity: 32});
    if (aes_opened.error != tls_error.OK || aes_opened.content_type != HANDSHAKE || aes_opened.written != 3) { ret 2; }

    var chacha_key: [32]^u8;
    test_key(?chacha_key[0], 32);
    var chacha_iv: [12]u8;
    var i:         usize = 0;
    for (i < 12) {
        chacha_iv[i] = i::u8;
        i            = i + 1;
    }
    val chacha:          Aead = aead(CHACHA20_POLY1305, fake_seal, fake_open);
    var chacha_sender:   Cipher;
    var chacha_receiver: Cipher;
    install(?chacha_sender, TLS12, chacha, contracts.SecretBytes{data: ?chacha_key[0], len: 32}, contracts.Bytes{data: ?chacha_iv[0], len: 12});
    install(?chacha_receiver, TLS12, chacha, contracts.SecretBytes{data: ?chacha_key[0], len: 32}, contracts.Bytes{data: ?chacha_iv[0], len: 12});
    val chacha_sealed: Sealed = seal(?chacha_sender, APPLICATION_DATA, contracts.SecretBytes{data: ?message[0], len: 3}, 0,
        contracts.SecretBuffer{data: nil, capacity: 0}, contracts.Buffer{data: ?wire[0], capacity: 96});
    if (chacha_sealed.error != tls_error.OK || chacha_sealed.written != 24 || read_u16(?wire[0], 3) != 19) { ret 3; }
    val chacha_opened: Opened = open(?chacha_receiver, ?wire[0], chacha_sealed.written, contracts.SecretBuffer{data: ?plaintext[0], capacity: 32});
    if (chacha_opened.error != tls_error.OK || chacha_opened.content_type != APPLICATION_DATA || chacha_opened.written != 3) { ret 4; }
    ret 0;
}

test "record: sequence exhaustion and key transitions are explicit" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv:        [12]u8;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var cipher:    Cipher;
    install(?cipher, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12});
    cipher.sequence = 0xffffffffffffffff;
    var content: [1]^u8;
    content[0] = 1;
    var scratch: [4]^u8;
    var output:  [32]u8;
    output[0] = 0xaa;
    val rejected: Sealed = seal(?cipher, APPLICATION_DATA, contracts.SecretBytes{data: ?content[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4}, contracts.Buffer{data: ?output[0], capacity: 32});
    if (rejected.error != tls_error.SEQUENCE_EXHAUSTED || output[0] != 0xaa)                                                                                { ret 1; }
    if (!install(?cipher, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12}) || cipher.sequence != 0) { ret 2; }
    destroy(?cipher);
    if (cipher.installed || cipher.key_len != 0 || cipher.iv_len != 0) { ret 3; }
    ret 0;
}

test "record: alert encoding and decoding preserve protocol rules" {
    var wire:    [16]u8;
    val encoded: Sealed = encode_alert(TLS13, CLOSE_NOTIFY, contracts.Buffer{data: ?wire[0], capacity: 16});
    if (encoded.error != tls_error.OK || encoded.written != 7 ||
        wire[5] != WARNING || wire[6] != CLOSE_NOTIFY) { ret 1; }
    var message: AlertMessage;
    if (decode_alert(TLS13, ?wire[5], 2, ?message) != tls_error.OK || message.description != CLOSE_NOTIFY) { ret 2; }
    val canceled: Sealed = encode_alert(TLS13, USER_CANCELED_ALERT,
        contracts.Buffer{data: ?wire[0], capacity: 16});
    if (canceled.error != tls_error.OK || wire[5] != WARNING ||
        decode_alert(TLS13, ?wire[5], 2, ?message) != tls_error.OK ||
        message.fatal) { ret 4; }
    wire[5] = 3;
    if (decode_alert(TLS13, ?wire[5], 2, ?message) != tls_error.DECODE_ERROR) { ret 3; }
    ret 0;
}

test "record: installation rejects self-aliased public iv ownership" {
    var key: [16]^u8;
    var iv:  [12]u8;
    test_key(?key[0], 16);
    var i: usize = 0;
    for (i < 12) {
        iv[i] = (0x80 + i)::u8;
        i     = i + 1;
    }
    var cipher:    Cipher;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    if (!install(?cipher, TLS13, algorithm,
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 1; }
    var expected_key: [16]u8;
    var expected_iv:  [12]u8;
    i = 0;
    for (i < 16) {
        expected_key[i] = cipher.key[i]:>u8;
        i               = i + 1;
    }
    i = 0;
    for (i < 12) {
        expected_iv[i] = cipher.iv[i];
        i              = i + 1;
    }
    if (install(?cipher, TLS13, algorithm,
        contracts.SecretBytes{data: ?cipher.key[0], len: 16},
        contracts.Bytes{data: ?cipher.iv[0], len: 12})) { ret 2; }
    i = 0;
    for (i < 16) {
        if (cipher.key[i]:>u8 != expected_key[i]) { ret 3; }
        i = i + 1;
    }
    i = 0;
    for (i < 12) {
        if (cipher.iv[i] != expected_iv[i]) { ret 4; }
        i = i + 1;
    }
    destroy(?cipher);
    ret 0;
}

test "record: public inputs and outputs cannot alias cipher ownership" {
    var key: [16]^u8;
    var iv:  [12]u8;
    test_key(?key[0], 16);
    var cipher: Cipher;
    if (!install(?cipher, TLS13, aes_128_gcm(),
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 1; }
    var content: [1]^u8 = [1]^u8{1};
    var scratch: [2]^u8;
    val sealed:  Sealed = seal(?cipher, APPLICATION_DATA,
        contracts.SecretBytes{data: ?content[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 2},
        contracts.Buffer{data: (?cipher.protocol)::*u8,
        capacity: HEADER_SIZE + 1 + TAG_SIZE});
    if (sealed.error != tls_error.RESOURCE_LIMIT || cipher.sequence != 0 ||
        cipher.failed) { ret 2; }
    val opened: Opened = open(?cipher, (?cipher.protocol)::*u8,
        HEADER_SIZE, contracts.SecretBuffer{data: ?scratch[0], capacity: 2});
    if (opened.error != tls_error.ILLEGAL_PARAMETER || cipher.sequence != 0 ||
        cipher.failed) { ret 3; }
    destroy(?cipher);
    ret 0;
}

test "record: plain encoding rejects overlapping public ranges" {
    var wire:   [8]u8  = [8]u8{1, 2, 3, 0, 0, 0, 0, 0};
    val sealed: Sealed = encode_plain(HANDSHAKE, TLS13,
        contracts.Bytes{data: ?wire[0], len: 3},
        contracts.Buffer{data: ?wire[0], capacity: 8});
    if (sealed.error != tls_error.RESOURCE_LIMIT || sealed.written != 0) {
        ret 1;
    }
    ret 0;
}

test "record: empty application records remain protocol-correct" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var iv4:       [4]u8;
    var sender:    Cipher;
    var receiver:  Cipher;
    install(?sender, TLS12, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv4[0], len: 4});
    install(?receiver, TLS12, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv4[0], len: 4});
    var wire:     [64]u8;
    val sealed12: Sealed = seal(?sender, APPLICATION_DATA, contracts.SecretBytes{data: nil, len: 0}, 0,
        contracts.SecretBuffer{data: nil, capacity: 0}, contracts.Buffer{data: ?wire[0], capacity: 64});
    if (sealed12.error != tls_error.OK || sealed12.written != 29) { ret 1; }
    val opened12: Opened = open(?receiver, ?wire[0], sealed12.written,
        contracts.SecretBuffer{data: nil, capacity: 0});
    if (opened12.error != tls_error.OK || opened12.content_type != APPLICATION_DATA || opened12.written != 0) { ret 2; }

    var iv12: [12]u8;
    install(?sender, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv12[0], len: 12});
    install(?receiver, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv12[0], len: 12});
    var scratch:  [1]^u8;
    val sealed13: Sealed = seal(?sender, APPLICATION_DATA, contracts.SecretBytes{data: nil, len: 0}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 1}, contracts.Buffer{data: ?wire[0], capacity: 64});
    if (sealed13.error != tls_error.OK || sealed13.written != 22) { ret 3; }
    var plaintext: [1]^u8;
    val opened13:  Opened = open(?receiver, ?wire[0], sealed13.written,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 1});
    if (opened13.error != tls_error.OK || opened13.content_type != APPLICATION_DATA || opened13.written != 0
        || plaintext[0]:>u8 != 0) { ret 4; }
    ret 0;
}

test "record: tls 1.3 permits the complete padding envelope" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv:        [12]u8;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var sender:    Cipher;
    install(?sender, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12});
    fake_seal_calls = 0;
    val oversized: Sealed = seal(?sender, APPLICATION_DATA,
        contracts.SecretBytes{data: nil, len: 0}, MAX_INNER_PLAINTEXT,
        contracts.SecretBuffer{data: ?max_padding_scratch[0], capacity: MAX_INNER_PLAINTEXT},
        contracts.Buffer{data: ?max_padding_wire[0], capacity: HEADER_SIZE + MAX_CIPHERTEXT});
    if (oversized.error != tls_error.RECORD_OVERFLOW || fake_seal_calls != 0
        || sender.sequence != 0) { ret 1; }
    val sealed: Sealed = seal(?sender, APPLICATION_DATA,
        contracts.SecretBytes{data: nil, len: 0}, MAX_INNER_PLAINTEXT - 1,
        contracts.SecretBuffer{data: ?max_padding_scratch[0], capacity: MAX_INNER_PLAINTEXT},
        contracts.Buffer{data: ?max_padding_wire[0], capacity: HEADER_SIZE + MAX_CIPHERTEXT});
    if (sealed.error != tls_error.OK || sealed.written != HEADER_SIZE + MAX_CIPHERTEXT
        || read_u16(?max_padding_wire[0], 3)::usize != MAX_CIPHERTEXT
        || fake_seal_calls != 1 || sender.sequence != 1) { ret 2; }
    var receiver: Cipher;
    install(?receiver, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12});
    val opened: Opened = open(?receiver, ?max_padding_wire[0], sealed.written,
        contracts.SecretBuffer{data: ?max_padding_plaintext[0], capacity: MAX_INNER_PLAINTEXT});
    if (opened.error != tls_error.OK || opened.content_type != APPLICATION_DATA
        || opened.written != 0 || receiver.sequence != 1
        || max_padding_plaintext[0]:>u8 != 0
        || max_padding_plaintext[MAX_INNER_PLAINTEXT - 1]:>u8 != 0) { ret 3; }
    ret 0;
}

test "record: bounds and exhaustion reject before cryptographic work" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv12:      [12]u8;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var cipher:    Cipher;
    install(?cipher, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv12[0], len: 12});
    var content: [1]^u8;
    content[0] = 1;
    var scratch: [4]^u8;
    var output:  [64]u8;
    fake_seal_calls = 0;
    cipher.sequence = 0xffffffffffffffff;
    val exhausted: Sealed = seal(?cipher, APPLICATION_DATA, contracts.SecretBytes{data: ?content[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4}, contracts.Buffer{data: ?output[0], capacity: 64});
    if (exhausted.error != tls_error.SEQUENCE_EXHAUSTED || fake_seal_calls != 0) { ret 1; }

    install(?cipher, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv12[0], len: 12});
    val invalid_type: Sealed = seal(?cipher, 19, contracts.SecretBytes{data: ?content[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4}, contracts.Buffer{data: ?output[0], capacity: 64});
    if (invalid_type.error != tls_error.ILLEGAL_PARAMETER || fake_seal_calls != 0) { ret 2; }
    var invalid_alert: [2]^u8;
    invalid_alert[0] = 3;
    invalid_alert[1] = CLOSE_NOTIFY;
    val bad_alert: Sealed = seal(?cipher, ALERT,
        contracts.SecretBytes{data: ?invalid_alert[0], len: 2}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4},
        contracts.Buffer{data: ?output[0], capacity: 64});
    if (bad_alert.error != tls_error.DECODE_ERROR || fake_seal_calls != 0
        || cipher.sequence != 0) { ret 2; }

    var oversized: [5]u8 = [5]u8{APPLICATION_DATA, 3, 3, 0x41, 1};
    fake_open_calls = 0;
    val overflow: Opened = open(?cipher, ?oversized[0], 5,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4});
    if (overflow.status != PARSE_FAILED || overflow.error != tls_error.RECORD_OVERFLOW
        || fake_open_calls != 0 || !cipher.failed) { ret 3; }

    install(?cipher, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv12[0], len: 12});
    var partial: [5]u8  = [5]u8{APPLICATION_DATA, 3, 3, 0, 17};
    val more:    Opened = open(?cipher, ?partial[0], 5,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4});
    if (more.status != PARSE_MORE || more.error != tls_error.OK || more.required != 22
        || fake_open_calls != 0 || cipher.failed || cipher.sequence != 0) { ret 4; }

    var iv4: [4]u8;
    install(?cipher, TLS12, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv4[0], len: 4});
    var short_record: [28]u8;
    write_header(?short_record[0], HANDSHAKE, 0x0303, 23);
    val short: Opened = open(?cipher, ?short_record[0], 28,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4});
    if (short.status != PARSE_FAILED || short.error != tls_error.DECODE_ERROR
        || fake_open_calls != 0 || !cipher.failed) { ret 5; }
    ret 0;
}

test "record: fragmented ciphertext and output retries do not consume state" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv:        [12]u8;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var sender:    Cipher;
    var receiver:  Cipher;
    install(?sender, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12});
    install(?receiver, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12});
    var content: [4]^u8;
    content[0] = 'd';
    content[1] = 'a';
    content[2] = 't';
    content[3] = 'a';
    var scratch: [16]^u8;
    var wire:    [64]u8;
    val sealed:  Sealed = seal(?sender, APPLICATION_DATA, contracts.SecretBytes{data: ?content[0], len: 4}, 2,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 16}, contracts.Buffer{data: ?wire[0], capacity: 64});
    if (sealed.error != tls_error.OK) { ret 1; }
    var plaintext: [16]^u8;
    fake_open_calls = 0;
    var i: usize = 0;
    for (i < sealed.written) {
        val partial: Opened = open(?receiver, ?wire[0], i,
            contracts.SecretBuffer{data: ?plaintext[0], capacity: 16});
        if (partial.status != PARSE_MORE || partial.error != tls_error.OK || partial.consumed != 0
            || receiver.sequence != 0 || receiver.failed || fake_open_calls != 0) { ret 2; }
        i = i + 1;
    }
    var small: [4]^u8;
    val retry: Opened = open(?receiver, ?wire[0], sealed.written,
        contracts.SecretBuffer{data: ?small[0], capacity: 4});
    if (retry.status != PARSE_READY || retry.error != tls_error.RESOURCE_LIMIT || retry.required != 7
        || retry.consumed != 0 || receiver.sequence != 0 || receiver.failed || fake_open_calls != 0) { ret 3; }
    val opened: Opened = open(?receiver, ?wire[0], sealed.written,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 16});
    if (opened.status != PARSE_READY || opened.error != tls_error.OK || opened.written != 4
        || opened.consumed != sealed.written || receiver.sequence != 1 || fake_open_calls != 1) { ret 4; }
    ret 0;
}

test "record: authenticated malformed inners and leaky providers release nothing" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv:        [12]u8;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var receiver:  Cipher;
    var wire:      [64]u8;
    var aad:       [5]u8;
    var inner:     [1]^u8;
    write_header(?wire[0], APPLICATION_DATA, 0x0303, 17);
    write_header(?aad[0], APPLICATION_DATA, 0x0303, 17);
    fake_seal(contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12},
        contracts.Bytes{data: ?aad[0], len: 5}, contracts.SecretBytes{data: ?inner[0], len: 1},
        contracts.Buffer{data: ?wire[5], capacity: 59});
    install(?receiver, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12});
    var plaintext: [8]^u8;
    var i:         usize = 0;
    for (i < 8) {
        plaintext[i] = 0xaa;
        i            = i + 1;
    }
    val empty: Opened = open(?receiver, ?wire[0], 22, contracts.SecretBuffer{data: ?plaintext[0], capacity: 8});
    if (empty.error != tls_error.UNEXPECTED_MESSAGE || !receiver.failed || plaintext[0]:>u8 != 0) { ret 1; }

    inner[0] = 19;
    fake_seal(contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12},
        contracts.Bytes{data: ?aad[0], len: 5}, contracts.SecretBytes{data: ?inner[0], len: 1},
        contracts.Buffer{data: ?wire[5], capacity: 59});
    install(?receiver, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12});
    plaintext[0] = 0xaa;
    val invalid: Opened = open(?receiver, ?wire[0], 22, contracts.SecretBuffer{data: ?plaintext[0], capacity: 8});
    if (invalid.error != tls_error.UNEXPECTED_MESSAGE || !receiver.failed || plaintext[0]:>u8 != 0) { ret 2; }

    val rejecting: Aead = aead(AES_128_GCM, fake_seal, leaky_reject_open);
    install(?receiver, TLS13, rejecting, contracts.SecretBytes{data: ?key[0], len: 16}, contracts.Bytes{data: ?iv[0], len: 12});
    plaintext[0] = 0xaa;
    val rejected: Opened = open(?receiver, ?wire[0], 22, contracts.SecretBuffer{data: ?plaintext[0], capacity: 8});
    if (rejected.error != tls_error.BAD_RECORD_MAC || rejected.alert != BAD_RECORD_MAC_ALERT
        || plaintext[0]:>u8 != 0 || !receiver.failed) { ret 3; }
    ret 0;
}

test "record: key installation and provider failures are transactional" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv:        [12]u8;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var cipher:    Cipher;
    if (!install(?cipher, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 1; }
    cipher.sequence = 7;
    var forged: Aead = algorithm;
    forged.key_size = 32;
    if (install(?cipher, TLS13, forged, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12}) || cipher.sequence != 7 || cipher.key[0]:>u8 != 1) { ret 2; }
    if (install(?cipher, TLS13, algorithm, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 4}) || cipher.sequence != 7 || cipher.key[0]:>u8 != 1) { ret 3; }

    val failing: Aead = aead(AES_128_GCM, short_seal, fake_open);
    if (!install(?cipher, TLS13, failing, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 4; }
    var content: [1]^u8;
    content[0] = 1;
    var scratch: [4]^u8;
    var output:  [32]u8;
    var i:       usize = 0;
    for (i < 32) {
        output[i] = 0xcc;
        i         = i + 1;
    }
    val failed: Sealed = seal(?cipher, APPLICATION_DATA, contracts.SecretBytes{data: ?content[0], len: 1}, 1,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4}, contracts.Buffer{data: ?output[0], capacity: 32});
    if (failed.error != tls_error.INTERNAL_ERROR || failed.required != 24
        || cipher.sequence != 0 || !cipher.failed) { ret 5; }
    i = 0;
    for (i < failed.required) {
        if (output[i] != 0) { ret 6; }
        i = i + 1;
    }
    i = 0;
    for (i < 3) {
        if (scratch[i]:>u8 != 0) { ret 7; }
        i = i + 1;
    }

    destroy(?cipher);
    if (cipher.installed || cipher.protocol != 0 || cipher.aead.seal != nil || cipher.aead.open != nil
        || cipher.key[0]:>u8 != 0 || cipher.iv[0] != 0) { ret 8; }
    ret 0;
}

test "record: providers receive exact writable regions" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv:      [12]u8;
    var content: [1]^u8 = [1]^u8{7};
    var scratch: [4]^u8;
    var output:  [32]u8;
    var i:       usize  = 0;
    for (i < 32) {
        output[i] = 0xcc;
        i         = i + 1;
    }
    var cipher:       Cipher;
    val failing_seal: Aead = aead(AES_128_GCM, wide_fail_seal, fake_open);
    if (!install(?cipher, TLS13, failing_seal,
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 1; }
    observed_seal_capacity = 0;
    val sealed: Sealed = seal(?cipher, APPLICATION_DATA,
        contracts.SecretBytes{data: ?content[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4},
        contracts.Buffer{data: ?output[0], capacity: 32});
    if (sealed.error != tls_error.INTERNAL_ERROR || sealed.required != 23 ||
        observed_seal_capacity != 18 || output[23] != 0xcc) { ret 2; }

    val producing: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    if (!install(?cipher, TLS13, producing,
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 3; }
    val good: Sealed = seal(?cipher, APPLICATION_DATA,
        contracts.SecretBytes{data: ?content[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: 4},
        contracts.Buffer{data: ?output[0], capacity: 32});
    if (good.error != tls_error.OK) { ret 4; }
    val failing_open: Aead = aead(AES_128_GCM, fake_seal, wide_fail_open);
    if (!install(?cipher, TLS13, failing_open,
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 5; }
    var plaintext: [8]^u8;
    i = 0;
    for (i < 8) {
        plaintext[i] = 0xcc;
        i            = i + 1;
    }
    observed_open_capacity = 0;
    val opened: Opened = open(?cipher, ?output[0], good.written,
        contracts.SecretBuffer{data: ?plaintext[0], capacity: 8});
    if (opened.error != tls_error.BAD_RECORD_MAC ||
        observed_open_capacity != 2 || plaintext[0]:>u8 != 0 ||
        plaintext[1]:>u8 != 0 || plaintext[2]:>u8 != 0xcc) { ret 6; }
    ret 0;
}

test "record: public ranges validate before access" {
    val maximum: usize  = ~(0::usize);
    val parsed:  Parsed = inspect(maximum::*u8, HEADER_SIZE, TLS13, false);
    if (parsed.status != PARSE_FAILED ||
        parsed.error != tls_error.INTERNAL_ERROR) { ret 1; }
    val plain: Sealed = encode_plain(APPLICATION_DATA, TLS13,
        contracts.Bytes{data: nil, len: 0},
        contracts.Buffer{data: maximum::*u8, capacity: HEADER_SIZE});
    if (plain.error != tls_error.RESOURCE_LIMIT) { ret 2; }
    var aliased: [16]u8;
    aliased[0] = WARNING;
    aliased[1] = CLOSE_NOTIFY;
    if (decode_alert(TLS13, ?aliased[0], 2,
        (?aliased[0])::*AlertMessage) != tls_error.DECODE_ERROR ||
        aliased[0] != WARNING || aliased[1] != CLOSE_NOTIFY) { ret 3; }
    var key:    [16]^u8;
    var cipher: Cipher;
    if (install(?cipher, TLS13, aes_128_gcm(),
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: maximum::*u8, len: 12})) { ret 4; }
    ret 0;
}

test "record: secret regions reject partial and cipher ownership aliases" {
    var key: [16]^u8;
    test_key(?key[0], 16);
    var iv:        [12]u8;
    val algorithm: Aead = aead(AES_128_GCM, fake_seal, fake_open);
    var cipher:    Cipher;
    if (!install(?cipher, TLS13, algorithm,
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 1; }
    var shared:  [8]^u8;
    var wire:    [64]u8;
    val partial: Sealed = seal(?cipher, APPLICATION_DATA,
        contracts.SecretBytes{data: ?shared[0], len: 4}, 0,
        contracts.SecretBuffer{data: ?shared[1], capacity: 7},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    if (partial.error != tls_error.RESOURCE_LIMIT || cipher.sequence != 0) {
        ret 2;
    }
    val owned_content: Sealed = seal(?cipher, APPLICATION_DATA,
        contracts.SecretBytes{data: ?cipher.key[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?shared[0], capacity: 8},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    if (owned_content.error != tls_error.ILLEGAL_PARAMETER ||
        cipher.sequence != 0) { ret 3; }

    var sender: Cipher;
    if (!install(?sender, TLS13, algorithm,
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 4; }
    shared[0] = 7;
    val good: Sealed = seal(?sender, APPLICATION_DATA,
        contracts.SecretBytes{data: ?shared[0], len: 1}, 0,
        contracts.SecretBuffer{data: ?shared[1], capacity: 7},
        contracts.Buffer{data: ?wire[0], capacity: 64});
    if (good.error != tls_error.OK) { ret 5; }
    val owned_output: Opened = open(?cipher, ?wire[0], good.written,
        contracts.SecretBuffer{data: ?cipher.key[0], capacity: 16});
    if (owned_output.error != tls_error.RESOURCE_LIMIT ||
        cipher.sequence != 0 || cipher.failed) { ret 6; }
    if (install(?cipher, TLS13, algorithm,
        contracts.SecretBytes{data: ?cipher.key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 7; }
    ret 0;
}

test "record: alerts classify known, unknown, warning, and fatal values" {
    var wire:        [16]u8;
    val renegotiate: Sealed = encode_alert(TLS12, NO_RENEGOTIATION_ALERT,
        contracts.Buffer{data: ?wire[0], capacity: 16});
    if (renegotiate.error != tls_error.OK || wire[5] != WARNING) { ret 1; }
    wire[0] = 0xaa;
    val forbidden: Sealed = encode_alert(TLS13, NO_RENEGOTIATION_ALERT,
        contracts.Buffer{data: ?wire[0], capacity: 16});
    if (forbidden.error != tls_error.ILLEGAL_PARAMETER || forbidden.written != 0 || wire[0] != 0xaa) { ret 2; }
    val unknown: Sealed = encode_alert(TLS13, 200, contracts.Buffer{data: ?wire[0], capacity: 16});
    if (unknown.error != tls_error.ILLEGAL_PARAMETER || wire[0] != 0xaa) { ret 3; }

    var data:    [2]u8 = [2]u8{WARNING, 200};
    var message: AlertMessage;
    if (decode_alert(TLS13, ?data[0], 2, ?message) != tls_error.OK || message.recognized || !message.fatal
        || message.description != 200) { ret 4; }
    data[1] = CLOSE_NOTIFY;
    if (decode_alert(TLS13, ?data[0], 2, ?message) != tls_error.OK || !message.recognized || message.fatal) { ret 5; }
    data[1] = BAD_RECORD_MAC_ALERT;
    if (decode_alert(TLS13, ?data[0], 2, ?message) != tls_error.OK || !message.recognized || !message.fatal) { ret 6; }
    message.description = 77;
    data[0]             = 3;
    if (decode_alert(TLS13, ?data[0], 2, ?message) != tls_error.DECODE_ERROR || message.description != 77) { ret 7; }
    ret 0;
}

test "record: a tls 1.2 initial record may carry a lower legacy version" {
    var wire:   [8]u8  = [8]u8{HANDSHAKE, 0x03, 0x01, 0x00, 0x03, 1, 2, 3};
    val legacy: Parsed = inspect(?wire[0], 8, TLS12, false);
    if (legacy.status != PARSE_READY || legacy.frame.length != 3) { ret 1; }
    wire[2] = 0x03;
    val current: Parsed = inspect(?wire[0], 8, TLS12, false);
    if (current.status != PARSE_READY) { ret 2; }
    # ssl 3.0 and anything above tls 1.2 stay refused
    wire[2] = 0x00;
    if (inspect(?wire[0], 8, TLS12, false).error != tls_error.ILLEGAL_PARAMETER) {
        ret 3;
    }
    wire[1] = 0x03;
    wire[2] = 0x04;
    if (inspect(?wire[0], 8, TLS12, false).error != tls_error.ILLEGAL_PARAMETER) {
        ret 4;
    }
    # a protected tls 1.2 record must carry the exact version
    wire[0] = APPLICATION_DATA;
    wire[2] = 0x01;
    if (inspect(?wire[0], 8, TLS12, true).error != tls_error.ILLEGAL_PARAMETER) {
        ret 5;
    }
    wire[2] = 0x03;
    if (inspect(?wire[0], 8, TLS12, true).status != PARSE_READY) { ret 6; }
    ret 0;
}
