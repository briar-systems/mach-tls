# incremental tls 1.3 server handshake and credential selection

use crypto.contracts;
use crypto.encoding.keys;
use crypto.group.p256;
use crypto.group.x25519;
use crypto.secret;
use crypto.signature;
use std.chrono.duration;
use std.chrono.time;
use std.crypto.ct;
use std.memory.buffers;
use std.sync.atomic;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.buffer;
use tls.cert;
use tls.cert.credentials;
use tls.cert.load;
use tls.cert.name;
use tls.cert.verify;
use tls.cert.x509;
use tls.client;
use tls.clock;
use tls.config;
use tls.engine;
use tls.error;
use tls.handshake;
use tls.handshake.codec;
use tls.handshake.extensions;
use tls.handshake.negotiation;
use tls.memory_range;
use tls.record;
use tls.session;
use tls.signature_scheme;
use tls.test.pool;
use tls.tls13;
use tls.tls13.established;
use tls.tls13.key_schedule;
use tls.tls13.transcript;
use tls.transition;
use tls.validation;

pub val MAX_KEY_SHARE:              usize = 65;
pub val MAX_PUBLIC_KEY:             usize = 512;
pub val MAX_SIGNATURE:              usize = 512;
pub val MAX_SIGNED_CONTEXT:         usize = 64 + 34 + 1 + 48;
pub val MAX_QUEUED_EVENTS:          usize = 12;
pub val MAX_TICKETS_PER_CONNECTION: u8    = 4;
pub val TICKET_MESSAGE_BYTES:       usize = 4 + 4 + 4 + 1 + session.NONCE_SIZE + 2 +
    session.MAX_TICKET_BYTES + 2;
pub val QUIC_TRANSPORT_PARAMETERS: u16 = 0x0039;

val EXPECT_CLIENT_HELLO:              u8 = 1;
val EXPECT_RETRY_HELLO:               u8 = 2;
val EXPECT_CLIENT_CERTIFICATE:        u8 = 3;
val EXPECT_CLIENT_CERTIFICATE_VERIFY: u8 = 4;
val EXPECT_CLIENT_FINISHED:           u8 = 5;
val ESTABLISHED:                      u8 = 6;
val CLOSING:                          u8 = 7;
val TERMINAL:                         u8 = 8;
val DESTROYED:                        u8 = 9;

val SEND_HANDSHAKE:      usize = 0;
val RECEIVE_HANDSHAKE:   usize = 1;
val SEND_APPLICATION:    usize = 2;
val RECEIVE_APPLICATION: usize = 3;
val NO_SECRET:           usize = 4;

pub rec ExtraExtension {
    kind: u16;
    data: contracts.Bytes;
}

# handshake memory comes from the caller's source, one region per use. input and
# output go at the handover; hello and the peer parameters stay until finish,
# since the snapshot still reports what they hold
rec Buffers {
    input:           buffer.Region;
    output:          buffer.Region;
    hello:           buffer.Region;
    peer_parameters: buffer.Region;
}

fun no_buffers() Buffers {
    ret Buffers{input: buffer.empty(), output: buffer.empty(),
        hello: buffer.empty(), peer_parameters: buffer.empty()};
}

# an ordered queue keeps interleaved flights and secret transitions explicit
rec Pending {
    kind:         engine.EventKind;
    level:        engine.Level;
    direction:    engine.Direction;
    secret_index: usize;
    offset:       usize;
    length:       usize;
    disposition:  u8;
    alert:        record.AlertDescription;
}

# selectors inspect one complete client hello and lease exactly one generation.
pub rec CredentialOffer {
    server_name: contracts.Bytes;
    # the encoded protocol-name list, without its u16 length prefix
    offered_alpn: contracts.Bytes;
}

pub def CredentialSelect: fun(*credentials.Store, CredentialOffer, *credentials.Lease)
    contracts.Error;

pub rec CredentialSelector {
    store:  *credentials.Store;
    select: CredentialSelect;
}

pub fun no_credential_selector() CredentialSelector {
    var value: CredentialSelector;
    value.store  = nil;
    value.select = nil;
    ret value;
}

fun selector_valid(value: CredentialSelector) bool {
    if (value.select == nil || value.store == nil) {
        ret value.select == nil && value.store == nil;
    }
    ret value.store.initialized &&
        memory_range.valid((?value.store.lock)::*u8, $size_of(credentials.Store));
}

pub fun offered_alpn_contains(offer: CredentialOffer, protocol: contracts.Bytes)
    bool {
    if (offer.offered_alpn.data == nil || protocol.data == nil || protocol.len == 0) {
        ret false;
    }
    var at: usize = 0;
    for (at < offer.offered_alpn.len) {
        val length: usize = offer.offered_alpn.data[at]::usize;
        if (length == 0 || length > offer.offered_alpn.len - at - 1) { ret false; }
        if (length == protocol.len && bytes_equal(contracts.Bytes{
            data: ?offer.offered_alpn.data[at + 1], len: length
        }, protocol)) {
            ret true;
        }
        at = at + 1 + length;
    }
    ret false;
}

pub fun offered_alpn_exactly(offer: CredentialOffer,
    protocol: contracts.Bytes) bool {
    if (offer.offered_alpn.data == nil || protocol.data == nil ||
        protocol.len == 0 || protocol.len > 255 ||
        offer.offered_alpn.len != protocol.len + 1 ||
        offer.offered_alpn.data[0] != protocol.len::u8) { ret false; }
    ret bytes_equal(contracts.Bytes{data: ?offer.offered_alpn.data[1],
        len: protocol.len}, protocol);
}

pub rec Handshake {
    config:                   *config.ServerConfig;
    configuration:            config.ServerConfig;
    entropy:                  secret.Entropy;
    memory:                   buffer.Lease;
    buffers:                  Buffers;
    output_required:          usize;
    certificates:             [verify.MAX_CHAIN_DEPTH]cert.Certificate;
    extra:                    ExtraExtension;
    peer_extension:           u16;
    transcript:               transcript.Transcript;
    schedule:                 key_schedule.Schedule;
    lease:                    credentials.Lease;
    lease_held:               bool;
    selector:                 CredentialSelector;
    state:                    u8;
    failure:                  error.Error;
    pending_alert:            record.AlertDescription;
    suite:                    tls13.CipherSuite;
    group:                    tls13.NamedGroup;
    signature_scheme:         tls13.SignatureScheme;
    at:                       clock.Moment;
    input_len:                usize;
    input_read:               usize;
    hello_len:                usize;
    output_used:              usize;
    random:                   [32]u8;
    session_id:               [32]u8;
    session_id_len:           usize;
    private_key:              [32]^u8;
    public_key:               [MAX_KEY_SHARE]u8;
    public_key_len:           usize;
    retry_count:              u8;
    client_auth_required:     bool;
    client_trust:             *cert.TrustStore;
    client_certificate_seen:  bool;
    client_certificate_empty: bool;
    authenticated:            bool;
    early_data_offered:       bool;
    resumed:                  bool;
    psk_index:                u16;
    ticket_state:             session.State;
    binder_transcript:        transcript.Transcript;
    tickets_issued:           u8;
    ticket_nonce:             u64;
    peer_leaf:                x509.Certificate;
    peer_key_first:           [MAX_PUBLIC_KEY]u8;
    peer_key_second:          [MAX_PUBLIC_KEY]u8;
    selected_alpn_storage:    [255]u8;
    selected_alpn:            contracts.Bytes;
    peer_offered_alpn:        bool;
    server_name_storage:      [253]u8;
    server_name:              contracts.Bytes;
    peer_parameters:          contracts.Bytes;
    queue:                    [MAX_QUEUED_EVENTS]Pending;
    queue_head:               usize;
    queue_len:                usize;
    event_active:             bool;
    event_generation:         u64;
    active_event:             engine.Event;
    secret_generation:        [4]u64;
    transition_owner:         i64;
    receive_record_plaintext: usize;
    send_record_plaintext:    usize;
    record_limit_seen:        bool;
    # the established core, seeded when the handshake queue drains
    delegating: bool;
    core:       established.Established;
}

fun result(status: engine.Status, failure: error.Error, consumed: usize,
    required: usize) engine.Result {
    ret engine.result(status, failure, consumed, required);
}

fun write_u16(data: *u8, offset: usize, value: u16) {
    data[offset]     = (value >> 8)::u8;
    data[offset + 1] = value::u8;
}

fun write_u24(data: *u8, offset: usize, value: usize) {
    data[offset]     = (value >> 16)::u8;
    data[offset + 1] = (value >> 8)::u8;
    data[offset + 2] = value::u8;
}

fun read_u16(data: *u8, offset: usize) u16 {
    ret (data[offset]::u16 << 8) | data[offset + 1]::u16;
}

fun copy_bytes(destination: *u8, source: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = source[i];
        i              = i + 1;
    }
}

fun zero_bytes(destination: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = 0;
        i              = i + 1;
    }
}

fun bytes_equal(first: contracts.Bytes, second: contracts.Bytes) bool {
    if (first.len != second.len || (first.len != 0 &&
        (first.data == nil || second.data == nil))) { ret false; }
    var i: usize = 0;
    for (i < first.len) {
        if (first.data[i] != second.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun add_size(total: *usize, amount: usize) bool {
    if (total == nil || amount > ~(0::usize) - @total) { ret false; }
    @total = @total + amount;
    ret true;
}

fun server_owner_valid(server: *Handshake) bool {
    if (server == nil) { ret false; }
    val address: usize = (?server.state)::usize;
    val offset:  usize = $offset_of(Handshake, state);
    ret address >= offset && memory_range.valid((address - offset)::*u8,
        $size_of(Handshake));
}

fun server_owner_data(server: *Handshake) *u8 {
    if (!server_owner_valid(server)) { ret nil; }
    ret ((?server.state)::usize - $offset_of(Handshake, state))::*u8;
}

fun server_owner_overlaps(server: *Handshake, data: *u8, len: usize) bool {
    if (!server_owner_valid(server) || !memory_range.valid(data, len)) {
        ret true;
    }
    ret memory_range.overlap(server_owner_data(server), $size_of(Handshake), data, len);
}

fun enter(server: *Handshake) bool {
    if (!server_owner_valid(server)) { ret false; }
    ret transition.enter(?server.transition_owner);
}

fun leave(server: *Handshake) {
    transition.leave(?server.transition_owner);
}

# the configuration is secret-welded through its credential store, so its own
# bytes are reached from the address of a public field
fun config_data(value: *config.ServerConfig) *u8 {
    if (value == nil) { ret nil; }
    val address: usize = (?value.alpn_len)::usize;
    val offset:  usize = $offset_of(config.ServerConfig, alpn_len);
    if (address < offset) { ret nil; }
    ret (address - offset)::*u8;
}

fun config_descriptor_valid(value: *config.ServerConfig) bool {
    if (value == nil || !memory_range.valid(config_data(value),
        $size_of(config.ServerConfig))) { ret false; }
    val entropy: *secret.Entropy = value.entropy;
    if (entropy == nil || !memory_range.valid((?entropy.context)::*u8,
        $size_of(secret.Entropy))) { ret false; }
    if (value.credentials == nil ||
        !memory_range.valid((?value.credentials.lock)::*u8,
        $size_of(credentials.Store))) { ret false; }
    ret true;
}

fun descriptor_overlaps(value: *config.ServerConfig, data: *u8,
    len: usize) bool {
    if (!config_descriptor_valid(value) || !memory_range.valid(data, len)) {
        ret true;
    }
    ret memory_range.overlap(data, len, config_data(value),
        $size_of(config.ServerConfig)) ||
        memory_range.overlap(data, len, (?value.entropy.context)::*u8,
        $size_of(secret.Entropy)) ||
        memory_range.overlap(data, len, (?value.credentials.lock)::*u8,
        $size_of(credentials.Store));
}

fun config_borrows_valid(value: *config.ServerConfig,
    extra: ExtraExtension) bool {
    if (!config_descriptor_valid(value)) { ret false; }
    var alpn_bytes:      usize = 0;
    var version_bytes:   usize = 0;
    var suite_bytes:     usize = 0;
    var group_bytes:     usize = 0;
    var signature_bytes: usize = 0;
    if (!memory_range.scaled(value.alpn_len, $size_of(config.ProtocolName),
        ?alpn_bytes) ||
        !memory_range.scaled(value.version_len, $size_of(u16), ?version_bytes) ||
        !memory_range.scaled(value.suite_len, $size_of(tls13.CipherSuite),
        ?suite_bytes) ||
        !memory_range.scaled(value.group_len, $size_of(tls13.NamedGroup),
        ?group_bytes) ||
        !memory_range.scaled(value.signature_len,
        $size_of(tls13.SignatureScheme), ?signature_bytes) ||
        !memory_range.valid(value.alpn::*u8, alpn_bytes) ||
        !memory_range.valid(value.versions::*u8, version_bytes) ||
        !memory_range.valid(value.suites::*u8, suite_bytes) ||
        !memory_range.valid(value.groups::*u8, group_bytes) ||
        !memory_range.valid(value.signatures::*u8, signature_bytes) ||
        !memory_range.valid(value.entropy.context::*u8,
        value.entropy_context_size) ||
        !memory_range.valid(extra.data.data, extra.data.len)) { ret false; }
    var i: usize = 0;
    for (i < value.alpn_len) {
        if (!memory_range.valid(value.alpn[i].data, value.alpn[i].len)) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

fun region_overlaps(region: buffer.Region, data: *u8, len: usize) bool {
    ret region.held && memory_range.overlap(data, len, region.chunk.data, region.chunk.bytes);
}

fun buffers_overlap(server: *Handshake, data: *u8, len: usize) bool {
    if (!memory_range.valid(data, len)) { ret true; }
    ret region_overlaps(server.buffers.input, data, len) ||
        region_overlaps(server.buffers.output, data, len) ||
        region_overlaps(server.buffers.hello, data, len) ||
        region_overlaps(server.buffers.peer_parameters, data, len) ||
        buffer.lease_overlaps(server.memory, data, len);
}

fun borrowed_overlaps(value: *config.ServerConfig, extra: ExtraExtension,
    data: *u8, len: usize, include_local_descriptors: bool,
    include_callback_context: bool) bool {
    if (!config_descriptor_valid(value) || !memory_range.valid(data, len)) {
        ret true;
    }
    if (include_local_descriptors && descriptor_overlaps(value, data, len)) {
        ret true;
    }
    if (include_callback_context &&
        memory_range.overlap(data, len, value.entropy.context::*u8,
        value.entropy_context_size)) { ret true; }
    var alpn_bytes:      usize = 0;
    var version_bytes:   usize = 0;
    var suite_bytes:     usize = 0;
    var group_bytes:     usize = 0;
    var signature_bytes: usize = 0;
    if (!memory_range.scaled(value.alpn_len, $size_of(config.ProtocolName),
        ?alpn_bytes) ||
        !memory_range.scaled(value.version_len, $size_of(u16), ?version_bytes) ||
        !memory_range.scaled(value.suite_len, $size_of(tls13.CipherSuite),
        ?suite_bytes) ||
        !memory_range.scaled(value.group_len, $size_of(tls13.NamedGroup),
        ?group_bytes) ||
        !memory_range.scaled(value.signature_len,
        $size_of(tls13.SignatureScheme), ?signature_bytes)) { ret true; }
    if (memory_range.overlap(data, len, value.alpn::*u8, alpn_bytes) ||
        memory_range.overlap(data, len, value.versions::*u8, version_bytes) ||
        memory_range.overlap(data, len, value.suites::*u8, suite_bytes) ||
        memory_range.overlap(data, len, value.groups::*u8, group_bytes) ||
        memory_range.overlap(data, len, value.signatures::*u8,
        signature_bytes) ||
        memory_range.overlap(data, len, extra.data.data, extra.data.len)) {
        ret true;
    }
    var i: usize = 0;
    for (i < value.alpn_len) {
        if (memory_range.overlap(data, len, value.alpn[i].data,
            value.alpn[i].len)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun aliases_borrowed(server: *Handshake, data: *u8, len: usize) bool {
    if (!server_owner_valid(server) ||
        atomic.load(?server.transition_owner) != 0 ||
        server.config != ?server.configuration ||
        server.state < EXPECT_CLIENT_HELLO || server.state >= DESTROYED) {
        ret true;
    }
    ret server_owner_overlaps(server, data, len) ||
        buffers_overlap(server, data, len) ||
        borrowed_overlaps(server.config, server.extra, data, len, true, true) ||
        (server.selector.select != nil && memory_range.overlap(data, len,
        (?server.selector.store.lock)::*u8, $size_of(credentials.Store)));
}

pub fun aliases_configuration(server: *Handshake, data: *u8, len: usize) bool {
    if (!server_owner_valid(server) ||
        atomic.load(?server.transition_owner) != 0 ||
        server.config != ?server.configuration ||
        server.state < EXPECT_CLIENT_HELLO || server.state >= DESTROYED) {
        ret true;
    }
    ret borrowed_overlaps(server.config, server.extra, data, len, false, true) ||
        (server.selector.select != nil && memory_range.overlap(data, len,
        (?server.selector.store.lock)::*u8, $size_of(credentials.Store)));
}

fun config_sources_disjoint(server: *Handshake, value: *config.ServerConfig,
    memory: buffer.Lease, extra: ExtraExtension) bool {
    if (!server_owner_valid(server) || !buffer.lease_valid(memory) ||
        borrowed_overlaps(value, extra, server_owner_data(server),
        $size_of(Handshake), true, true) ||
        buffer.lease_overlaps(memory, server_owner_data(server), $size_of(Handshake))) {
        ret false;
    }
    if (value.entropy_context_size != 0 &&
        (server_owner_overlaps(server, value.entropy.context::*u8,
        value.entropy_context_size) ||
        buffer.lease_overlaps(memory, value.entropy.context::*u8,
        value.entropy_context_size) ||
        borrowed_overlaps(value, extra, value.entropy.context::*u8,
        value.entropy_context_size, true, false))) { ret false; }
    ret !borrowed_overlaps(value, extra, memory.source::*u8,
        $size_of(buffers.Source), true, true) &&
        !borrowed_overlaps(value, extra, memory.account::*u8,
        $size_of(buffers.Account), true, true);
}

fun selector_sources_disjoint(server: *Handshake, value: *config.ServerConfig,
    memory: buffer.Lease, extra: ExtraExtension,
    selector: CredentialSelector) bool {
    if (selector.select == nil) { ret true; }
    val data:   *u8   = (?selector.store.lock)::*u8;
    val length: usize = $size_of(credentials.Store);
    ret !server_owner_overlaps(server, data, length) &&
        !buffer.lease_overlaps(memory, data, length) &&
        !borrowed_overlaps(value, extra, data, length, true, true);
}

fun reserved_server_extension(kind: u16) bool {
    ret kind == extensions.SERVER_NAME || kind == extensions.SUPPORTED_GROUPS ||
        kind == extensions.APPLICATION_LAYER_PROTOCOL ||
        kind == extensions.SUPPORTED_VERSIONS || kind == extensions.KEY_SHARE ||
        kind == extensions.COOKIE || kind == extensions.RECORD_SIZE_LIMIT ||
        kind == extensions.EARLY_DATA;
}

# exact server hello output, including the retry form
fun server_hello_requirement(output: *usize) bool {
    if (output == nil) { ret false; }
    var required: usize = 4 + 2 + 32 + 1 + 32 + 2 + 1 + 2;
    if (!add_size(?required, 6) ||
        !add_size(?required, 8 + MAX_KEY_SHARE)) { ret false; }
    @output = required;
    ret true;
}

# exact encrypted-extensions through finished output for the widest credential
fun server_flight_requirement(value: *config.ServerConfig,
    extra: ExtraExtension, output: *usize) bool {
    if (output == nil) { ret false; }
    var encrypted: usize = 6;
    if (!add_size(?encrypted, 4)) { ret false; }
    var alpn:   usize = 4 + 2 + 1;
    var i:      usize = 0;
    var widest: usize = 0;
    for (i < value.alpn_len) {
        if (value.alpn[i].len > widest) { widest = value.alpn[i].len; }
        i = i + 1;
    }
    if (!add_size(?alpn, widest) || !add_size(?encrypted, alpn) ||
        !add_size(?encrypted, 6)) { ret false; }
    if (extra.kind != 0 && !add_size(?encrypted, 4 + extra.data.len)) {
        ret false;
    }
    var required: usize = encrypted;
    if (!add_size(?required, 4 + 1 + 2 + 4 + 2 + value.signature_len * 2) ||
        !add_size(?required, 8 + value.limits.max_chain_bytes +
        5 * verify.MAX_CHAIN_DEPTH) ||
        !add_size(?required, 8 + MAX_SIGNATURE) ||
        !add_size(?required, 4 + 48)) { ret false; }
    @output = required;
    ret true;
}

fun entropy_equal(first: secret.Entropy, second: secret.Entropy) bool {
    ret first.context == second.context &&
        first.secret_context == second.secret_context &&
        first.fill_fn == second.fill_fn && first.initialized == second.initialized;
}

fun limits_equal(first: config.Limits, second: config.Limits) bool {
    ret first.max_receive_record_plaintext ==
        second.max_receive_record_plaintext &&
        first.max_send_record_plaintext == second.max_send_record_plaintext &&
        first.max_peer_handshake_bytes == second.max_peer_handshake_bytes &&
        first.max_client_hello_bytes == second.max_client_hello_bytes &&
        first.max_client_flight_bytes == second.max_client_flight_bytes &&
        first.max_server_flight_bytes == second.max_server_flight_bytes &&
        first.max_chain_bytes == second.max_chain_bytes &&
        first.max_certificate_bytes == second.max_certificate_bytes &&
        first.max_ticket_bytes == second.max_ticket_bytes;
}

fun configuration_equal(first: config.ServerConfig,
    second: config.ServerConfig) bool {
    ret first.credentials == second.credentials &&
        first.alpn == second.alpn && first.alpn_len == second.alpn_len &&
        first.require_alpn == second.require_alpn &&
        first.versions == second.versions &&
        first.version_len == second.version_len &&
        first.suites == second.suites && first.suite_len == second.suite_len &&
        first.groups == second.groups && first.group_len == second.group_len &&
        first.signatures == second.signatures &&
        first.signature_len == second.signature_len &&
        first.entropy == second.entropy &&
        first.entropy_context_size == second.entropy_context_size &&
        first.tickets == second.tickets && first.replay == second.replay &&
        first.replay_policy == second.replay_policy &&
        first.tickets_per_connection == second.tickets_per_connection &&
        first.retain_exporter == second.retain_exporter &&
        limits_equal(first.limits, second.limits);
}

fun region_equal(first: buffer.Region, second: buffer.Region) bool {
    ret first.chunk.data == second.chunk.data && first.chunk.bytes == second.chunk.bytes &&
        first.held == second.held && first.flying == second.flying;
}

fun buffers_equal(first: Buffers, second: Buffers) bool {
    ret region_equal(first.input, second.input) &&
        region_equal(first.output, second.output) &&
        region_equal(first.hello, second.hello) &&
        region_equal(first.peer_parameters, second.peer_parameters);
}

fun lease_equal(first: buffer.Lease, second: buffer.Lease) bool {
    ret first.source == second.source && first.account == second.account &&
        first.lane == second.lane;
}

# an entropy callback cannot reenter, redirect, or observe handshake state
fun entropy_fill(server: *Handshake, output: *^u8, length: usize) bool {
    if (!server_owner_valid(server) ||
        !transition.held(?server.transition_owner) ||
        server.config != ?server.configuration || !server.entropy.initialized ||
        server.entropy.fill_fn == nil || output == nil) { ret false; }
    val descriptor:              secret.Entropy          = server.entropy;
    val expected_config:         *config.ServerConfig    = server.config;
    val expected_configuration:  config.ServerConfig     = server.configuration;
    val expected_memory:         buffer.Lease            = server.memory;
    val expected_buffers:        Buffers                 = server.buffers;
    val expected_extra:          ExtraExtension          = server.extra;
    val expected_peer_extension: u16                     = server.peer_extension;
    val expected_state:          u8                      = server.state;
    val expected_failure:        error.Error             = server.failure;
    val expected_pending_alert:  record.AlertDescription = server.pending_alert;
    val expected_input_len:      usize                   = server.input_len;
    val expected_input_read:     usize                   = server.input_read;
    val expected_hello_len:      usize                   = server.hello_len;
    val expected_output_used:    usize                   = server.output_used;
    val expected_queue_head:     usize                   = server.queue_head;
    val expected_queue_len:      usize                   = server.queue_len;
    val expected_event_active:   bool                    = server.event_active;
    val expected_receive_limit:  usize                   = server.receive_record_plaintext;
    val expected_send_limit:     usize                   = server.send_record_plaintext;
    val status:                  i64                     = descriptor.fill_fn(descriptor.context,
        descriptor.secret_context, output, length);
    val valid: bool = transition.held(?server.transition_owner) &&
        server.config == expected_config && server.state == expected_state &&
        entropy_equal(server.entropy, descriptor) &&
        configuration_equal(server.configuration, expected_configuration) &&
        lease_equal(server.memory, expected_memory) &&
        buffers_equal(server.buffers, expected_buffers) &&
        server.extra.kind == expected_extra.kind &&
        server.extra.data.data == expected_extra.data.data &&
        server.extra.data.len == expected_extra.data.len &&
        server.peer_extension == expected_peer_extension &&
        server.failure == expected_failure &&
        server.pending_alert == expected_pending_alert &&
        server.input_len == expected_input_len &&
        server.input_read == expected_input_read &&
        server.hello_len == expected_hello_len &&
        server.output_used == expected_output_used &&
        server.queue_head == expected_queue_head &&
        server.queue_len == expected_queue_len &&
        server.event_active == expected_event_active &&
        server.receive_record_plaintext == expected_receive_limit &&
        server.send_record_plaintext == expected_send_limit;
    if (!valid || status != 0) {
        ct.zeroize(output, length);
        server.entropy                  = descriptor;
        server.configuration            = expected_configuration;
        server.configuration.entropy    = ?server.entropy;
        server.config                   = ?server.configuration;
        server.memory                   = expected_memory;
        server.buffers                  = expected_buffers;
        server.extra                    = expected_extra;
        server.peer_extension           = expected_peer_extension;
        server.state                    = expected_state;
        server.failure                  = expected_failure;
        server.pending_alert            = expected_pending_alert;
        server.input_len                = expected_input_len;
        server.input_read               = expected_input_read;
        server.hello_len                = expected_hello_len;
        server.output_used              = expected_output_used;
        server.queue_head               = expected_queue_head;
        server.queue_len                = expected_queue_len;
        server.event_active             = expected_event_active;
        server.receive_record_plaintext = expected_receive_limit;
        server.send_record_plaintext    = expected_send_limit;
        ret false;
    }
    ret true;
}

fun fill_public(server: *Handshake, output: *u8, length: usize) bool {
    if (!server_owner_valid(server) || server.config == nil || output == nil) {
        ret false;
    }
    var temporary: [MAX_KEY_SHARE]^u8;
    if (length > MAX_KEY_SHARE || !entropy_fill(server, ?temporary[0], length)) {
        ct.zeroize(?temporary[0], MAX_KEY_SHARE);
        ret false;
    }
    var i: usize = 0;
    for (i < length) {
        output[i] = temporary[i]:>u8;
        i         = i + 1;
    }
    ct.zeroize(?temporary[0], MAX_KEY_SHARE);
    ret true;
}

fun fill_private(server: *Handshake) bool {
    if (!server_owner_valid(server) || server.config == nil) { ret false; }
    ct.zeroize(?server.private_key[0], 32);
    ret entropy_fill(server, ?server.private_key[0], 32);
}

# exact output storage a listener needs before it can accept a connection
pub fun storage_requirements(value: *config.ServerConfig, extra: ExtraExtension,
    hello: *usize, flight: *usize) bool {
    if (!config_descriptor_valid(value) || !config_borrows_valid(value, extra) ||
        hello == nil || flight == nil) { ret false; }
    ret server_hello_requirement(hello) &&
        server_flight_requirement(value, extra, flight);
}

# the output one connection needs, known from the configuration alone
fun output_requirement(value: *config.ServerConfig, extra: ExtraExtension,
    output: *usize) bool {
    var hello_required:  usize = 0;
    var flight_required: usize = 0;
    var ticket_output:   usize = 0;
    if (!server_hello_requirement(?hello_required) ||
        !server_flight_requirement(value, extra, ?flight_required) ||
        flight_required > value.limits.max_server_flight_bytes ||
        !memory_range.scaled(value.tickets_per_connection::usize,
        TICKET_MESSAGE_BYTES, ?ticket_output) ||
        hello_required > ~(0::usize) - flight_required ||
        hello_required + flight_required > ~(0::usize) - ticket_output) {
        ret false;
    }
    @output = hello_required + flight_required + ticket_output;
    ret true;
}

pub fun config_valid(value: *config.ServerConfig, extra: ExtraExtension,
    peer_extension: u16) bool {
    if (!config_descriptor_valid(value) || !config_borrows_valid(value, extra)) {
        ret false;
    }
    if (value.entropy == nil || !value.entropy.initialized ||
        value.entropy.fill_fn == nil || value.entropy.secret_context != nil ||
        ((value.entropy.context == nil) != (value.entropy_context_size == 0)) ||
        !memory_range.valid(value.entropy.context::*u8,
        value.entropy_context_size) ||
        value.credentials == nil || !value.credentials.initialized ||
        (value.alpn_len != 0 && value.alpn == nil) || value.alpn_len > 255 ||
        (value.require_alpn && value.alpn_len == 0) ||
        value.versions == nil || value.version_len != 1 ||
        value.suites == nil || value.suite_len == 0 || value.groups == nil ||
        value.group_len == 0 || value.signatures == nil ||
        !config.valid_signature_count(value.signature_len) ||
        value.suite_len > 3 ||
        value.group_len > 2 ||
        value.limits.max_receive_record_plaintext < 63 ||
        value.limits.max_receive_record_plaintext > record.MAX_PLAINTEXT ||
        value.limits.max_send_record_plaintext == 0 ||
        value.limits.max_send_record_plaintext > record.MAX_PLAINTEXT ||
        value.limits.max_peer_handshake_bytes <= handshake.HEADER_SIZE ||
        value.limits.max_peer_handshake_bytes >
        handshake.MAX_BODY_SIZE + handshake.HEADER_SIZE ||
        value.limits.max_client_hello_bytes <= handshake.HEADER_SIZE ||
        value.limits.max_client_hello_bytes >
        handshake.MAX_BODY_SIZE + handshake.HEADER_SIZE ||
        value.limits.max_client_flight_bytes <= handshake.HEADER_SIZE ||
        value.limits.max_client_flight_bytes >
        handshake.MAX_BODY_SIZE + handshake.HEADER_SIZE ||
        value.limits.max_server_flight_bytes <= handshake.HEADER_SIZE ||
        value.limits.max_server_flight_bytes >
        handshake.MAX_BODY_SIZE + handshake.HEADER_SIZE ||
        !config.certificate_limits_valid(value.limits) ||
        value.limits.max_ticket_bytes == 0 ||
        value.limits.max_ticket_bytes > handshake.MAX_BODY_SIZE ||
        (extra.data.len != 0 && extra.data.data == nil) ||
        extra.data.len > 65531 || (extra.kind == 0 && extra.data.len != 0) ||
        (extra.kind != 0 && reserved_server_extension(extra.kind)) ||
        value.tickets_per_connection > MAX_TICKETS_PER_CONNECTION ||
        (value.tickets_per_connection != 0 && value.tickets == nil) ||
        (value.tickets != nil && !value.tickets.initialized) ||
        (value.replay_policy != session.REPLAY_PERMISSIVE &&
        value.replay_policy != session.REPLAY_SINGLE_USE) ||
        (value.replay_policy == session.REPLAY_SINGLE_USE &&
        (value.replay == nil || !value.replay.initialized ||
        value.tickets == nil)) ||
        (value.replay != nil && !value.replay.initialized)) { ret false; }
    if (value.versions[0] != tls13.VERSION) { ret false; }
    var i: usize = 0;
    for (i < value.suite_len) {
        if (!codec.valid_cipher_suite(value.suites[i])) { ret false; }
        var prior: usize = 0;
        for (prior < i) {
            if (value.suites[prior] == value.suites[i]) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < value.group_len) {
        if (!codec.valid_named_group(value.groups[i])) { ret false; }
        var prior: usize = 0;
        for (prior < i) {
            if (value.groups[prior] == value.groups[i]) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < value.signature_len) {
        if (!codec.valid_signature_scheme(value.signatures[i])) { ret false; }
        var prior: usize = 0;
        for (prior < i) {
            if (value.signatures[prior] == value.signatures[i]) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < value.alpn_len) {
        if (value.alpn[i].data == nil || value.alpn[i].len == 0 ||
            value.alpn[i].len > 255) { ret false; }
        var prior: usize = 0;
        for (prior < i) {
            if (bytes_equal(contracts.Bytes{data: value.alpn[prior].data,
                len: value.alpn[prior].len},
                contracts.Bytes{data: value.alpn[i].data,
                len: value.alpn[i].len})) { ret false; }
            prior = prior + 1;
        }
        i = i + 1;
    }
    var output: usize = 0;
    ret output_requirement(value, extra, ?output);
}

fun init_inner(server: *Handshake, configuration: *config.ServerConfig,
    memory: buffer.Lease, extra: ExtraExtension, peer_extension: u16,
    selector: CredentialSelector) bool {
    var output: usize = 0;
    if (!server_owner_valid(server) ||
        (server.state != 0 && server.state != DESTROYED) ||
        !config_valid(configuration, extra, peer_extension) ||
        !output_requirement(configuration, extra, ?output) ||
        !config_sources_disjoint(server, configuration, memory, extra) ||
        !selector_valid(selector) || !selector_sources_disjoint(server,
        configuration, memory, extra, selector)) {
        ret false;
    }
    server.configuration            = configuration[0];
    server.entropy                  = configuration.entropy[0];
    server.configuration.entropy    = ?server.entropy;
    server.config                   = ?server.configuration;
    server.memory                   = memory;
    server.buffers                  = no_buffers();
    server.output_required          = output;
    server.extra                    = extra;
    server.peer_extension           = peer_extension;
    server.transcript               = transcript.empty();
    server.lease                    = credentials.empty_lease();
    server.lease_held               = false;
    server.selector                 = selector;
    server.state                    = EXPECT_CLIENT_HELLO;
    server.delegating               = false;
    server.core                     = established.empty();
    server.failure                  = error.OK;
    server.pending_alert            = record.NO_ALERT;
    server.suite                    = 0;
    server.group                    = 0;
    server.signature_scheme         = 0;
    server.input_len                = 0;
    server.input_read               = 0;
    server.hello_len                = 0;
    server.output_used              = 0;
    server.session_id_len           = 0;
    server.public_key_len           = 0;
    server.retry_count              = 0;
    server.client_auth_required     = false;
    server.client_trust             = nil;
    server.client_certificate_seen  = false;
    server.client_certificate_empty = false;
    server.authenticated            = false;
    server.early_data_offered       = false;
    server.resumed                  = false;
    server.psk_index                = 0;
    server.ticket_state             = session.empty_state();
    server.binder_transcript        = transcript.empty();
    server.tickets_issued           = 0;
    server.ticket_nonce             = 0;
    server.peer_leaf                = x509.no_certificate();
    server.selected_alpn.data       = nil;
    server.selected_alpn.len        = 0;
    server.peer_offered_alpn        = false;
    server.server_name.data         = nil;
    server.server_name.len          = 0;
    server.peer_parameters.data     = nil;
    server.peer_parameters.len      = 0;
    server.queue_head               = 0;
    server.queue_len                = 0;
    server.event_active             = false;
    server.receive_record_plaintext =
        server.config.limits.max_receive_record_plaintext;
    server.send_record_plaintext = server.config.limits.max_send_record_plaintext;
    server.record_limit_seen     = false;
    server.event_generation      = engine.next_generation(server.event_generation);
    ct.zeroize(?server.private_key[0], 32);
    ret true;
}

# memory is the connection's lease. the caller owns its account and keeps it
# open until the handshake is finished or destroyed
pub fun init(server: *Handshake, configuration: *config.ServerConfig,
    memory: buffer.Lease, extra: ExtraExtension, peer_extension: u16) bool {
    if (!enter(server)) { ret false; }
    val initialized: bool = init_inner(server, configuration, memory, extra,
        peer_extension, no_credential_selector());
    leave(server);
    ret initialized;
}

pub fun init_with_credential_selector(server: *Handshake,
    configuration: *config.ServerConfig, memory: buffer.Lease, extra: ExtraExtension,
    peer_extension: u16, selector: CredentialSelector) bool {
    if (!enter(server)) { ret false; }
    val initialized: bool = init_inner(server, configuration, memory, extra,
        peer_extension, selector);
    leave(server);
    ret initialized;
}

fun queue_clear(server: *Handshake) {
    server.queue_head = 0;
    server.queue_len  = 0;
}

fun queue_push(server: *Handshake, item: Pending) bool {
    if (server.queue_len >= MAX_QUEUED_EVENTS) { ret false; }
    server.queue[server.queue_len] = item;
    server.queue_len               = server.queue_len + 1;
    ret true;
}

fun queue_crypto(server: *Handshake, level: engine.Level, offset: usize,
    length: usize) bool {
    ret queue_push(server, Pending{kind: engine.CRYPTO, level: level,
        direction: engine.SEND, secret_index: NO_SECRET, offset: offset,
        length:    length, disposition: 0, alert: record.NO_ALERT});
}

fun queue_secret(server: *Handshake, level: engine.Level,
    direction: engine.Direction, secret_index: usize) bool {
    ret queue_push(server, Pending{kind: engine.TRAFFIC_SECRET, level: level,
        direction:   direction, secret_index: secret_index, offset: 0, length: 0,
        disposition: 0, alert: record.NO_ALERT});
}

fun queue_simple(server: *Handshake, kind: engine.EventKind, level: engine.Level,
    disposition: u8) bool {
    ret queue_push(server, Pending{kind: kind, level: level, direction: 0,
        secret_index: NO_SECRET, offset: 0, length: 0, disposition: disposition,
        alert:        record.NO_ALERT});
}

fun pending(server: *Handshake) bool {
    ret server.queue_head < server.queue_len;
}

fun release_buffers(server: *Handshake) {
    buffer.release(server.memory, ?server.buffers.input, server.buffers.input.chunk.bytes);
    buffer.release(server.memory, ?server.buffers.output, server.buffers.output.chunk.bytes);
    buffer.release(server.memory, ?server.buffers.hello, server.buffers.hello.chunk.bytes);
    buffer.release(server.memory, ?server.buffers.peer_parameters,
        server.buffers.peer_parameters.chunk.bytes);
}

# a refused reservation either waits, changing nothing, or fails the handshake
fun reserved(server: *Handshake, outcome: buffer.Outcome) engine.Result {
    if (outcome == buffer.HELD) { ret result(engine.OK, error.OK, 0, 0); }
    if (outcome == buffer.WAIT) { ret result(engine.WAITING, error.OK, 0, 0); }
    ret fail(server, error.RESOURCE_LIMIT, record.INTERNAL_ERROR_ALERT);
}

# the most input one connection buffers at once
fun input_limit(server: *Handshake) usize {
    val chain:   usize = config.certificate_message_bytes(server.config.limits);
    val message: usize = server.config.limits.max_peer_handshake_bytes;
    if (chain > message) { ret chain; }
    ret message;
}

# everything a buffered message needs is held before it is processed, so a
# message either runs to completion or leaves the handshake untouched
fun prepare_frame(server: *Handshake, message_type: handshake.MessageType,
    length: usize) buffer.Outcome {
    if (message_type != handshake.CLIENT_HELLO) { ret buffer.HELD; }
    if (server.retry_count == 0) {
        val hello: buffer.Outcome = buffer.reserve(server.memory,
            ?server.buffers.hello, length, 0);
        if (hello != buffer.HELD) { ret hello; }
    }
    if (server.peer_extension == 0) { ret buffer.HELD; }
    ret buffer.reserve(server.memory, ?server.buffers.peer_parameters, length, 0);
}

fun release_lease(server: *Handshake) {
    if (server.lease_held) {
        credentials.release(?server.lease);
        server.lease_held = false;
    }
    server.lease = credentials.empty_lease();
}

fun fail(server: *Handshake, failure: error.Error,
    alert: record.AlertDescription) engine.Result {
    if (server != nil && server.state != DESTROYED) {
        server.failure       = failure;
        server.pending_alert = alert;
        queue_clear(server);
        server.output_used = 0;
        if (alert != record.NO_ALERT) {
            queue_push(server, Pending{kind: engine.ALERT, level: 0,
                direction:   0, secret_index: NO_SECRET, offset: 0, length: 0,
                disposition: 0, alert: alert});
        }
        server.state = TERMINAL;
    }
    ret result(engine.FAILED, failure, 0, 0);
}

fun start_inner(server: *Handshake, at: clock.Moment) engine.Result {
    if (!server_owner_valid(server) || server.config == nil ||
        server.state != EXPECT_CLIENT_HELLO || server.hello_len != 0 ||
        pending(server)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    val output: engine.Result = reserved(server, buffer.reserve(server.memory,
        ?server.buffers.output, server.output_required, 0));
    if (output.status != engine.OK) { ret output; }
    server.at = at;
    if (!fill_public(server, ?server.random[0], 32)) {
        ret fail(server, error.INTERNAL_ERROR, record.INTERNAL_ERROR_ALERT);
    }
    var i:             usize = 0;
    var matches_retry: bool  = true;
    for (i < 32) {
        if (server.random[i] != codec.HELLO_RETRY_RANDOM[i]) {
            matches_retry = false;
        }
        i = i + 1;
    }
    if (matches_retry) {
        ret fail(server, error.INTERNAL_ERROR, record.INTERNAL_ERROR_ALERT);
    }
    ret result(engine.OK, error.OK, 0, handshake.HEADER_SIZE);
}

pub fun start(server: *Handshake, at: clock.Moment) engine.Result {
    if (!enter(server)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    val started: engine.Result = start_inner(server, at);
    leave(server);
    ret started;
}

fun put_extension(output: *u8, offset: usize, kind: u16,
    body: contracts.Bytes) usize {
    write_u16(output, offset, kind);
    write_u16(output, offset + 2, body.len::u16);
    if (body.len != 0) { copy_bytes(?output[offset + 4], body.data, body.len); }
    ret offset + 4 + body.len;
}

fun derive_share(server: *Handshake, group: tls13.NamedGroup) bool {
    var attempt: usize = 0;
    for (attempt < 16) {
        if (!fill_private(server)) { ret false; }
        var operation: contracts.Operation;
        if (group == tls13.X25519) {
            operation = x25519.derive_public(
                contracts.SecretBytes{data: ?server.private_key[0], len: 32},
                contracts.Buffer{data: ?server.public_key[0],
                capacity: MAX_KEY_SHARE});
        }
        or {
            operation = p256.derive_public(
                contracts.SecretBytes{data: ?server.private_key[0], len: 32},
                contracts.Buffer{data: ?server.public_key[0],
                capacity: MAX_KEY_SHARE});
        }
        if (operation.error == contracts.OK) {
            server.group          = group;
            server.public_key_len = operation.written;
            ret true;
        }
        attempt = attempt + 1;
    }
    ct.zeroize(?server.private_key[0], 32);
    ret false;
}

fun shared_secret(server: *Handshake, peer: contracts.Bytes, output: *^u8) bool {
    var operation: contracts.Operation;
    if (server.group == tls13.X25519) {
        operation = x25519.agree(
            contracts.SecretBytes{data: ?server.private_key[0], len: 32}, peer,
            contracts.SecretBuffer{data: output, capacity: 32});
    }
    or {
        operation = p256.agree(
            contracts.SecretBytes{data: ?server.private_key[0], len: 32}, peer,
            contracts.SecretBuffer{data: output, capacity: 32});
    }
    ret operation.error == contracts.OK && operation.written == 32;
}

fun client_share(hello: *codec.ClientHello, group: tls13.NamedGroup,
    output: *contracts.Bytes) bool {
    var shares: extensions.Extension;
    if (!extensions.find(hello.extensions, extensions.KEY_SHARE, ?shares) ||
        shares.len < 2) { ret false; }
    var offset: usize = 2;
    for (offset + 3 < shares.len) {
        val current: u16   = read_u16(shares.data, offset);
        val key_len: usize = read_u16(shares.data, offset + 2)::usize;
        if (current == group) {
            output[0] = contracts.Bytes{data: ?shares.data[offset + 4],
                len: key_len};
            ret true;
        }
        offset = offset + 4 + key_len;
    }
    ret false;
}

fun offered_version(hello: *codec.ClientHello) bool {
    ret extensions.offers_tls13(hello.extensions);
}

fun extract_server_name(hello: *codec.ClientHello,
    output: *contracts.Bytes) bool {
    output[0] = contracts.Bytes{data: nil, len: 0};
    var name_extension: extensions.Extension;
    if (!extensions.find(hello.extensions, extensions.SERVER_NAME,
        ?name_extension) || name_extension.len < 5) { ret true; }
    val length: usize = read_u16(name_extension.data, 3)::usize;
    if (name_extension.data[2] != 0 || length == 0 || length > 253 ||
        name_extension.len != 5 + length) { ret false; }
    output[0] = contracts.Bytes{data: ?name_extension.data[5], len: length};
    ret true;
}

fun extract_offered_alpn(hello: *codec.ClientHello,
    output: *contracts.Bytes) bool {
    output[0] = contracts.Bytes{data: nil, len: 0};
    var extension: extensions.Extension;
    if (!extensions.find(hello.extensions, extensions.APPLICATION_LAYER_PROTOCOL,
        ?extension)) { ret true; }
    if (extension.len < 3) { ret false; }
    val length: usize = read_u16(extension.data, 0)::usize;
    if (length == 0 || length != extension.len - 2) { ret false; }
    var at: usize = 2;
    for (at < extension.len) {
        val item: usize = extension.data[at]::usize;
        if (item == 0 || item > extension.len - at - 1) { ret false; }
        at = at + 1 + item;
    }
    if (at != extension.len) { ret false; }
    output[0] = contracts.Bytes{data: ?extension.data[2], len: length};
    ret true;
}

fun retain_server_name(server: *Handshake, value: contracts.Bytes) {
    if (value.len == 0 || value.len > 253) {
        server.server_name = contracts.Bytes{data: nil, len: 0};
        ret;
    }
    copy_bytes(?server.server_name_storage[0], value.data, value.len);
    server.server_name = contracts.Bytes{data: ?server.server_name_storage[0],
        len: value.len};
}

fun scheme_matches_key(scheme: tls13.SignatureScheme,
    algorithm: keys.Algorithm) bool {
    ret signature_scheme.can_sign(scheme, algorithm);
}

fun record_size_limit(server: *Handshake, hello: *codec.ClientHello) bool {
    var limit_extension: extensions.Extension;
    server.record_limit_seen = false;
    if (!extensions.find(hello.extensions, extensions.RECORD_SIZE_LIMIT,
        ?limit_extension)) { ret true; }
    if (limit_extension.len != 2) { ret false; }
    val limit: usize = read_u16(limit_extension.data, 0)::usize - 1;
    if (limit == 0) { ret false; }
    if (limit < server.send_record_plaintext) {
        server.send_record_plaintext = limit;
    }
    server.record_limit_seen = true;
    ret true;
}

fun psk_identity_count(psk: extensions.Extension) usize {
    if (psk.len < 2) { ret 0; }
    val identities_len: usize = read_u16(psk.data, 0)::usize;
    var offset:         usize = 2;
    val end:            usize = 2 + identities_len;
    var count:          usize = 0;
    for (offset + 5 < end) {
        val identity_len: usize = read_u16(psk.data, offset)::usize;
        offset = offset + 2 + identity_len + 4;
        count  = count + 1;
    }
    ret count;
}

fun psk_identity_at(psk: extensions.Extension, index: usize,
    identity: *contracts.Bytes, obfuscated_age: *u32) bool {
    if (psk.len < 2) { ret false; }
    val identities_len: usize = read_u16(psk.data, 0)::usize;
    var offset:         usize = 2;
    val end:            usize = 2 + identities_len;
    var current:        usize = 0;
    for (offset + 5 < end) {
        val identity_len: usize = read_u16(psk.data, offset)::usize;
        if (current == index) {
            identity[0] = contracts.Bytes{data: ?psk.data[offset + 2],
                len: identity_len};
            val age_offset: usize = offset + 2 + identity_len;
            obfuscated_age[0] = (psk.data[age_offset]::u32 << 24) |
                (psk.data[age_offset + 1]::u32 << 16) |
                (psk.data[age_offset + 2]::u32 << 8) |
                psk.data[age_offset + 3]::u32;
            ret true;
        }
        offset  = offset + 2 + identity_len + 4;
        current = current + 1;
    }
    ret false;
}

fun psk_binder_at(psk: extensions.Extension, index: usize,
    binder: *contracts.Bytes) bool {
    if (psk.len < 2) { ret false; }
    val identities_len: usize = read_u16(psk.data, 0)::usize;
    var offset:         usize = 2 + identities_len;
    if (offset + 2 > psk.len) { ret false; }
    val binders_len: usize = read_u16(psk.data, offset)::usize;
    offset = offset + 2;
    val end: usize = offset + binders_len;
    if (end > psk.len) { ret false; }
    var current: usize = 0;
    for (offset < end) {
        val binder_len: usize = psk.data[offset]::usize;
        if (offset + 1 + binder_len > end) { ret false; }
        if (current == index) {
            binder[0] = contracts.Bytes{data: ?psk.data[offset + 1],
                len: binder_len};
            ret true;
        }
        offset  = offset + 1 + binder_len;
        current = current + 1;
    }
    ret false;
}

fun offered_psk_dhe(hello: *codec.ClientHello) bool {
    var modes: extensions.Extension;
    if (!extensions.find(hello.extensions, extensions.PSK_KEY_EXCHANGE_MODES,
        ?modes)) { ret false; }
    var i: usize = 1;
    for (i < modes.len) {
        if (modes.data[i] == 1) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun configured_suite(server: *Handshake, suite: tls13.CipherSuite) bool {
    var i: usize = 0;
    for (i < server.config.suite_len) {
        if (server.config.suites[i] == suite) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ticket_name_matches(server: *Handshake, state: *session.State) bool {
    if (state.server_name_len != server.server_name.len) { ret false; }
    var i: usize = 0;
    for (i < state.server_name_len) {
        if (state.server_name[i] != server.server_name.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun binder_matches(first: contracts.Bytes, second: *u8, length: usize) bool {
    if (first.len != length || first.data == nil) { ret false; }
    var difference: u8    = 0;
    var i:          usize = 0;
    for (i < length) {
        difference = difference | (first.data[i] ^ second[i]);
        i          = i + 1;
    }
    ret difference == 0;
}

# a ticket is accepted only when its key, lifetime, suite, name, binder, and
# replay policy all admit it; anything short of that is a full handshake
fun try_resume(server: *Handshake, hello: *codec.ClientHello,
    frame: contracts.Bytes, suite: *tls13.CipherSuite) error.Error {
    server.resumed = false;
    if (server.config.tickets == nil) { ret error.OK; }
    var psk: extensions.Extension;
    if (!extensions.find(hello.extensions, extensions.PRE_SHARED_KEY, ?psk)) {
        ret error.OK;
    }
    if (!offered_psk_dhe(hello)) { ret error.OK; }
    val count: usize = psk_identity_count(psk);
    if (count == 0) { ret error.OK; }
    var index: usize = 0;
    for (index < count) {
        var identity:       contracts.Bytes;
        var obfuscated_age: u32 = 0;
        var state:          session.State;
        if (psk_identity_at(psk, index, ?identity, ?obfuscated_age) &&
            identity.len != 0 &&
            session.open(server.config.tickets, identity,
            server.at, ?state)) {
            val usable: bool = configured_suite(server, state.suite) &&
                offered_suite_value(hello, state.suite) &&
                ticket_name_matches(server, ?state);
            if (usable) {
                val failure: error.Error = accept_ticket(server, hello, frame,
                    psk, index, identity, ?state);
                if (failure != error.OK) {
                    session.state_destroy(?state);
                    ret failure;
                }
                if (server.resumed) {
                    @suite = state.suite;
                    session.state_destroy(?state);
                    ret error.OK;
                }
            }
            session.state_destroy(?state);
        }
        index = index + 1;
    }
    ret error.OK;
}

fun offered_suite_value(hello: *codec.ClientHello,
    suite: tls13.CipherSuite) bool {
    var offset: usize = 0;
    for (offset + 1 < hello.cipher_suites.len) {
        if (read_u16(hello.cipher_suites.data, offset) == suite) { ret true; }
        offset = offset + 2;
    }
    ret false;
}

# verify the binder over the truncated client hello on a separate transcript
fun accept_ticket(server: *Handshake, hello: *codec.ClientHello,
    frame: contracts.Bytes, psk: extensions.Extension, index: usize,
    identity: contracts.Bytes, state: *session.State) error.Error {
    var offered: contracts.Bytes;
    if (!psk_binder_at(psk, index, ?offered)) { ret error.ILLEGAL_PARAMETER; }
    val size: usize = key_schedule.hash_size(
        key_schedule.algorithm_for_suite(state.suite));
    if (size == 0 || offered.len != size) { ret error.ILLEGAL_PARAMETER; }
    var failure: error.Error = key_schedule.init(?server.schedule, state.suite,
        contracts.SecretBytes{data: ?state.secret[0], len: state.secret_len});
    if (failure != error.OK) { ret failure; }
    failure = transcript.init_for_suite(?server.binder_transcript, state.suite);
    if (failure == error.OK) {
        failure = transcript.update_binder_client_hello(
            ?server.binder_transcript, frame, false);
    }
    var hash: [48]u8;
    if (failure == error.OK) {
        failure = transcript.snapshot(?server.binder_transcript,
            contracts.Buffer{data: ?hash[0], capacity: 48});
    }
    var expected: [48]u8;
    if (failure == error.OK) {
        failure = key_schedule.binder(?server.schedule, true,
            contracts.Bytes{data: ?hash[0], len: size},
            contracts.Buffer{data: ?expected[0], capacity: 48});
    }
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    transcript.destroy(?server.binder_transcript);
    if (failure != error.OK) {
        key_schedule.destroy(?server.schedule);
        i = 0;
        for (i < 48) {
            expected[i] = 0;
            i           = i + 1;
        }
        ret failure;
    }
    val matched: bool = binder_matches(offered, ?expected[0], size);
    i = 0;
    for (i < 48) {
        expected[i] = 0;
        i           = i + 1;
    }
    if (!matched) {
        key_schedule.destroy(?server.schedule);
        ret error.DECRYPT_ERROR;
    }
    # a binder is unique per client hello, so ticket reuse is keyed on the
    # ticket identity, which is what a single-use policy actually bounds
    if (server.config.replay_policy == session.REPLAY_SINGLE_USE &&
        !session.replay_admit(server.config.replay, identity,
        time.time_add(state.issued_at, state.lifetime_seconds::i64 * duration.SECOND),
        server.at.wall)) {
        key_schedule.destroy(?server.schedule);
        ret error.OK;
    }
    server.resumed       = true;
    server.psk_index     = index::u16;
    server.authenticated = state.client_authenticated;
    server.ticket_state  = @state;
    ret error.OK;
}

fun retain_peer_parameters(server: *Handshake, hello: *codec.ClientHello) error.Error {
    if (server.peer_extension == 0) { ret error.OK; }
    var item: extensions.Extension;
    if (!extensions.find(hello.extensions, server.peer_extension, ?item)) {
        ret error.MISSING_EXTENSION;
    }
    if (item.len > server.buffers.peer_parameters.chunk.bytes) {
        ret error.RESOURCE_LIMIT;
    }
    if (item.len != 0) {
        copy_bytes(server.buffers.peer_parameters.chunk.data, item.data, item.len);
    }
    server.peer_parameters = contracts.Bytes{
        data: server.buffers.peer_parameters.chunk.data, len: item.len
    };
    ret error.OK;
}

# a retry hello may change only the key share, cookie, and psk-bound extensions
fun retry_extension_mutable(kind: u16) bool {
    ret kind == extensions.KEY_SHARE || kind == extensions.COOKIE ||
        kind == extensions.PRE_SHARED_KEY || kind == extensions.EARLY_DATA ||
        kind == extensions.PADDING;
}

fun find_in(list: extensions.List, kind: u16, output: *extensions.Extension) bool {
    ret extensions.find(list, kind, output);
}

fun hello_consistent(first: *codec.ClientHello,
    second: *codec.ClientHello) bool {
    if (first.legacy_version != second.legacy_version ||
        !bytes_equal(first.random, second.random) ||
        !bytes_equal(first.legacy_session_id, second.legacy_session_id) ||
        !bytes_equal(first.cipher_suites, second.cipher_suites) ||
        !bytes_equal(first.compression_methods, second.compression_methods)) {
        ret false;
    }
    var iterator: extensions.Iterator = extensions.iterator(second.extensions);
    var item:     extensions.Extension;
    for (true) {
        val status: extensions.NextStatus = extensions.next(?iterator, ?item);
        if (status == extensions.NEXT_DONE)     { brk; }
        if (status != extensions.NEXT_ITEM)     { ret false; }
        if (retry_extension_mutable(item.kind)) { cnt; }
        var original: extensions.Extension;
        if (!find_in(first.extensions, item.kind, ?original) ||
            !bytes_equal(contracts.Bytes{data: original.data, len: original.len},
            contracts.Bytes{data: item.data, len: item.len})) { ret false; }
    }
    var reverse: extensions.Iterator = extensions.iterator(first.extensions);
    for (true) {
        val status: extensions.NextStatus = extensions.next(?reverse, ?item);
        if (status == extensions.NEXT_DONE)     { brk; }
        if (status != extensions.NEXT_ITEM)     { ret false; }
        if (retry_extension_mutable(item.kind)) { cnt; }
        var repeated: extensions.Extension;
        if (!find_in(second.extensions, item.kind, ?repeated)) { ret false; }
    }
    ret true;
}

fun decode_retained_hello(server: *Handshake, output: *codec.ClientHello) error.Error {
    var message: handshake.Message;
    val parsed:  handshake.Progress = handshake.parse(server.buffers.hello.chunk.data,
        server.hello_len,
        server.config.limits.max_client_hello_bytes - handshake.HEADER_SIZE,
        ?message);
    if (parsed.status != handshake.COMPLETE ||
        parsed.consumed != server.hello_len) { ret error.INTERNAL_ERROR; }
    ret codec.decode_client_hello(?message, false, output);
}

fun build_policy(server: *Handshake, schemes: *tls13.SignatureScheme,
    protocols: *negotiation.Protocol, policy: *negotiation.Policy) bool {
    val identity: *credentials.Identity = server.lease.identity;
    if (identity == nil || identity.private_key == nil) { ret false; }
    val algorithm: keys.Algorithm = identity.private_key.algorithm;
    var count:     usize          = 0;
    var i:         usize          = 0;
    for (i < server.config.signature_len) {
        if (scheme_matches_key(server.config.signatures[i], algorithm)) {
            schemes[count] = server.config.signatures[i];
            count          = count + 1;
        }
        i = i + 1;
    }
    if (count == 0) { ret false; }
    i = 0;
    for (i < server.config.alpn_len) {
        protocols[i] = negotiation.Protocol{data: server.config.alpn[i].data,
            len: server.config.alpn[i].len};
        i = i + 1;
    }
    policy.suites           = server.config.suites;
    policy.suite_len        = server.config.suite_len;
    policy.groups           = server.config.groups;
    policy.group_len        = server.config.group_len;
    policy.signatures       = schemes;
    policy.signature_len    = count;
    policy.protocols        = protocols;
    policy.protocol_len     = server.config.alpn_len;
    policy.require_protocol = server.config.require_alpn;
    ret true;
}

fun acquire_credentials(server: *Handshake, requested: contracts.Bytes,
    offered_alpn: contracts.Bytes) error.Error {
    if (server.lease_held) { ret error.OK; }
    var status: contracts.Error = contracts.INVALID_STATE;
    if (server.selector.select == nil) {
        status = credentials.acquire(server.config.credentials, requested,
            ?server.lease);
    }
    or {
        status = server.selector.select(server.selector.store, CredentialOffer{
            server_name: requested, offered_alpn: offered_alpn
        }, ?server.lease);
        if (status == contracts.UNSUPPORTED) {
            status = credentials.acquire(server.config.credentials, requested,
                ?server.lease);
        }
    }
    if (status == contracts.UNSUPPORTED) { ret error.UNRECOGNIZED_NAME; }
    if (status != contracts.OK || server.lease.identity == nil ||
        server.lease.generation == nil) { ret error.HANDSHAKE_FAILURE; }
    server.lease_held           = true;
    server.client_auth_required = server.lease.generation.require_client_auth;
    server.client_trust         = server.lease.generation.client_trust;
    if (server.client_auth_required && server.client_trust == nil) {
        ret error.INTERNAL_ERROR;
    }
    ret error.OK;
}

fun build_hello_retry(server: *Handshake, selection: *negotiation.Selection) error.Error {
    var extension_bytes: [16]u8;
    var offset:          usize = 0;
    var version:         [2]u8;
    write_u16(?version[0], 0, tls13.VERSION);
    offset = put_extension(?extension_bytes[0], offset,
        extensions.SUPPORTED_VERSIONS,
        contracts.Bytes{data: ?version[0], len: 2});
    var group_bytes: [2]u8;
    write_u16(?group_bytes[0], 0, selection.group);
    offset = put_extension(?extension_bytes[0], offset, extensions.KEY_SHARE,
        contracts.Bytes{data: ?group_bytes[0], len: 2});
    var retry: codec.ServerHello;
    retry.legacy_version    = tls13.LEGACY_VERSION;
    retry.random            = contracts.Bytes{data: ?codec.HELLO_RETRY_RANDOM[0], len: 32};
    retry.legacy_session_id = contracts.Bytes{data: ?server.session_id[0],
        len: server.session_id_len};
    retry.cipher_suite       = selection.suite;
    retry.compression_method = 0;
    retry.extensions         = extensions.list(?extension_bytes[0], offset,
        extensions.HELLO_RETRY_REQUEST);
    retry.retry = true;
    val encoded: handshake.Progress = codec.encode_server_hello(?retry,
        contracts.Buffer{data: ?server.buffers.output.chunk.data[server.output_used],
        capacity: server.buffers.output.chunk.bytes - server.output_used});
    if (encoded.status != handshake.COMPLETE) {
        if (encoded.error != error.OK) { ret encoded.error; }
        ret error.RESOURCE_LIMIT;
    }
    var failure: error.Error = transcript.init_for_suite(?server.transcript,
        selection.suite);
    if (failure == error.OK) {
        failure = transcript.update_frame(?server.transcript,
            contracts.Bytes{data: server.buffers.hello.chunk.data, len: server.hello_len});
    }
    if (failure == error.OK) {
        failure = transcript.rewrite_for_retry(?server.transcript,
            contracts.Bytes{data: ?server.buffers.output.chunk.data[server.output_used],
            len: encoded.produced});
    }
    if (failure != error.OK) { ret failure; }
    if (!queue_crypto(server, engine.INITIAL, server.output_used,
        encoded.produced)) { ret error.INTERNAL_ERROR; }
    server.output_used = server.output_used + encoded.produced;
    server.suite       = selection.suite;
    server.group       = selection.group;
    server.retry_count = 1;
    server.state       = EXPECT_RETRY_HELLO;
    ret error.OK;
}

fun build_server_hello(server: *Handshake, peer: contracts.Bytes) error.Error {
    var extension_bytes: [96]u8;
    var offset:          usize = 0;
    var version:         [2]u8;
    write_u16(?version[0], 0, tls13.VERSION);
    offset = put_extension(?extension_bytes[0], offset,
        extensions.SUPPORTED_VERSIONS,
        contracts.Bytes{data: ?version[0], len: 2});
    write_u16(?extension_bytes[0], offset, extensions.KEY_SHARE);
    write_u16(?extension_bytes[0], offset + 2, (4 + server.public_key_len)::u16);
    write_u16(?extension_bytes[0], offset + 4, server.group);
    write_u16(?extension_bytes[0], offset + 6, server.public_key_len::u16);
    copy_bytes(?extension_bytes[offset + 8], ?server.public_key[0],
        server.public_key_len);
    offset = offset + 8 + server.public_key_len;
    if (server.resumed) {
        var selected: [2]u8;
        write_u16(?selected[0], 0, server.psk_index);
        offset = put_extension(?extension_bytes[0], offset,
            extensions.PRE_SHARED_KEY,
            contracts.Bytes{data: ?selected[0], len: 2});
    }
    var hello: codec.ServerHello;
    hello.legacy_version    = tls13.LEGACY_VERSION;
    hello.random            = contracts.Bytes{data: ?server.random[0], len: 32};
    hello.legacy_session_id = contracts.Bytes{data: ?server.session_id[0],
        len: server.session_id_len};
    hello.cipher_suite       = server.suite;
    hello.compression_method = 0;
    hello.extensions         = extensions.list(?extension_bytes[0], offset,
        extensions.SERVER_HELLO);
    hello.retry = false;
    val encoded: handshake.Progress = codec.encode_server_hello(?hello,
        contracts.Buffer{data: ?server.buffers.output.chunk.data[server.output_used],
        capacity: server.buffers.output.chunk.bytes - server.output_used});
    if (encoded.status != handshake.COMPLETE) {
        if (encoded.error != error.OK) { ret encoded.error; }
        ret error.RESOURCE_LIMIT;
    }
    var failure: error.Error = transcript.update_frame(?server.transcript,
        contracts.Bytes{data: ?server.buffers.output.chunk.data[server.output_used],
        len: encoded.produced});
    if (failure != error.OK) { ret failure; }
    var hash: [48]u8;
    failure = transcript.snapshot(?server.transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48});
    if (failure != error.OK) { ret failure; }
    var shared: [32]^u8;
    if (!shared_secret(server, peer, ?shared[0])) {
        ct.zeroize(?shared[0], 32);
        ret error.HANDSHAKE_FAILURE;
    }
    if (!server.resumed) {
        failure = key_schedule.init(?server.schedule, server.suite,
            contracts.SecretBytes{data: nil, len: 0});
    }
    if (failure == error.OK) {
        failure = key_schedule.advance_handshake(?server.schedule,
            contracts.SecretBytes{data: ?shared[0], len: 32},
            contracts.Bytes{data: ?hash[0],
            len: key_schedule.hash_size(server.schedule.algorithm)});
    }
    ct.zeroize(?shared[0], 32);
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    ct.zeroize(?server.private_key[0], 32);
    if (failure != error.OK) { ret failure; }
    if (!queue_crypto(server, engine.INITIAL, server.output_used,
        encoded.produced)) { ret error.INTERNAL_ERROR; }
    server.output_used = server.output_used + encoded.produced;
    if (!queue_secret(server, engine.HANDSHAKE, engine.SEND, SEND_HANDSHAKE) ||
        !queue_secret(server, engine.HANDSHAKE, engine.RECEIVE,
        RECEIVE_HANDSHAKE)) { ret error.INTERNAL_ERROR; }
    ret error.OK;
}

fun append_encrypted_extensions(server: *Handshake, offset: usize) usize {
    var extension_bytes: [512]u8;
    var cursor:          usize = 0;
    if (server.selected_alpn.len != 0) {
        var alpn_body: [258]u8;
        write_u16(?alpn_body[0], 0, (1 + server.selected_alpn.len)::u16);
        alpn_body[2] = server.selected_alpn.len::u8;
        copy_bytes(?alpn_body[3], server.selected_alpn.data,
            server.selected_alpn.len);
        cursor = put_extension(?extension_bytes[0], cursor,
            extensions.APPLICATION_LAYER_PROTOCOL,
            contracts.Bytes{data: ?alpn_body[0],
            len: 3 + server.selected_alpn.len});
    }
    if (server.server_name.len != 0) {
        cursor = put_extension(?extension_bytes[0], cursor,
            extensions.SERVER_NAME, contracts.Bytes{data: nil, len: 0});
    }
    if (server.record_limit_seen) {
        var limit: [2]u8;
        write_u16(?limit[0], 0, (server.receive_record_plaintext + 1)::u16);
        cursor = put_extension(?extension_bytes[0], cursor,
            extensions.RECORD_SIZE_LIMIT,
            contracts.Bytes{data: ?limit[0], len: 2});
    }
    if (server.extra.kind != 0) {
        if (4 + server.extra.data.len > 512 - cursor) { ret 0; }
        cursor = put_extension(?extension_bytes[0], cursor, server.extra.kind,
            server.extra.data);
    }
    val encoded: handshake.Progress = codec.encode_extension_message(
        handshake.ENCRYPTED_EXTENSIONS,
        extensions.list(?extension_bytes[0], cursor,
        extensions.ENCRYPTED_EXTENSIONS),
        contracts.Buffer{data: ?server.buffers.output.chunk.data[offset],
        capacity: server.buffers.output.chunk.bytes - offset});
    if (encoded.status != handshake.COMPLETE) { ret 0; }
    ret offset + encoded.produced;
}

val MAX_SIGNATURE_ALGORITHM_BYTES: usize =
    2 + config.MAX_SIGNATURE_SCHEMES * 2;

fun encode_signature_algorithms(server: *Handshake, output: *u8,
    capacity: usize) usize {
    if (server == nil || server.config == nil || output == nil ||
        !config.valid_signature_count(server.config.signature_len)) { ret 0; }
    val required: usize = 2 + server.config.signature_len * 2;
    if (capacity < required) { ret 0; }
    write_u16(output, 0, (server.config.signature_len * 2)::u16);
    var i: usize = 0;
    for (i < server.config.signature_len) {
        write_u16(output, 2 + i * 2, server.config.signatures[i]);
        i = i + 1;
    }
    ret required;
}

fun append_certificate_request(server: *Handshake, offset: usize) usize {
    if (!server.client_auth_required) { ret offset; }
    var extension_bytes: [32]u8;
    var algorithms:      [MAX_SIGNATURE_ALGORITHM_BYTES]u8;
    val algorithm_len:   usize = encode_signature_algorithms(server,
        ?algorithms[0], MAX_SIGNATURE_ALGORITHM_BYTES);
    if (algorithm_len == 0) { ret 0; }
    val cursor: usize = put_extension(?extension_bytes[0], 0,
        extensions.SIGNATURE_ALGORITHMS,
        contracts.Bytes{data: ?algorithms[0], len: algorithm_len});
    var request: codec.CertificateRequest;
    request.context    = contracts.Bytes{data: nil, len: 0};
    request.extensions = extensions.list(?extension_bytes[0], cursor,
        extensions.CERTIFICATE_REQUEST);
    val encoded: handshake.Progress = codec.encode_certificate_request(?request,
        contracts.Buffer{data: ?server.buffers.output.chunk.data[offset],
        capacity: server.buffers.output.chunk.bytes - offset});
    if (encoded.status != handshake.COMPLETE) { ret 0; }
    ret offset + encoded.produced;
}

fun append_certificate(server: *Handshake, offset: usize) usize {
    val identity: *credentials.Identity = server.lease.identity;
    if (identity == nil) { ret 0; }
    var entries_length: usize = 0;
    var i:              usize = 0;
    for (i < identity.chain.len) {
        val encoded_length: usize = identity.chain.certificates[i].der_len;
        if (encoded_length > server.buffers.output.chunk.bytes ||
            entries_length > server.buffers.output.chunk.bytes - encoded_length ||
            entries_length + encoded_length >
            server.buffers.output.chunk.bytes - 5) { ret 0; }
        entries_length = entries_length + 5 + encoded_length;
        i              = i + 1;
    }
    if (entries_length == 0 || offset > server.buffers.output.chunk.bytes ||
        entries_length > server.buffers.output.chunk.bytes - 8) { ret 0; }
    val required: usize = 8 + entries_length;
    if (required > server.buffers.output.chunk.bytes - offset) { ret 0; }
    server.buffers.output.chunk.data[offset] = handshake.CERTIFICATE;
    write_u24(server.buffers.output.chunk.data, offset + 1, 4 + entries_length);
    server.buffers.output.chunk.data[offset + 4] = 0;
    write_u24(server.buffers.output.chunk.data, offset + 5, entries_length);
    var cursor: usize = offset + 8;
    i = 0;
    for (i < identity.chain.len) {
        val encoded: cert.Certificate = identity.chain.certificates[i];
        write_u24(server.buffers.output.chunk.data, cursor, encoded.der_len);
        copy_bytes(?server.buffers.output.chunk.data[cursor + 3], encoded.der,
            encoded.der_len);
        write_u16(server.buffers.output.chunk.data, cursor + 3 + encoded.der_len, 0);
        cursor = cursor + 5 + encoded.der_len;
        i      = i + 1;
    }
    ret cursor;
}

fun certificate_verify_input(server: *Handshake, from_server: bool,
    output: *u8) error.Error {
    var hash:    [48]u8;
    val size:    usize       = key_schedule.hash_size(server.schedule.algorithm);
    val failure: error.Error = transcript.snapshot(?server.transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48});
    if (failure != error.OK) { ret failure; }
    var i: usize = 0;
    for (i < 64) {
        output[i] = 0x20;
        i         = i + 1;
    }
    var context: *u8 = "TLS 1.3, client CertificateVerify"::*u8;
    if (from_server) { context = "TLS 1.3, server CertificateVerify"::*u8; }
    copy_bytes(?output[64], context, 33);
    output[97] = 0;
    copy_bytes(?output[98], ?hash[0], size);
    i = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    ret error.OK;
}

fun sign_server(server: *Handshake, message: contracts.Bytes,
    output: contracts.Buffer) contracts.Operation {
    val private_key: *keys.PrivateKey = server.lease.identity.private_key;
    if (private_key.algorithm == keys.ED25519 ||
        private_key.algorithm == keys.P256) {
        var key: contracts.SecretBytes;
        if (keys.private_bytes(private_key, ?key) != contracts.OK) {
            ret contracts.Operation{error: contracts.INVALID_KEY, written: 0};
        }
        if (private_key.algorithm == keys.ED25519) {
            ret signature.sign_ed25519(key, message, output);
        }
        ret signature.sign_ecdsa_p256_sha256(key, message, output);
    }
    var modulus:          [512]u8;
    var exponent:         [512]u8;
    var private_exponent: [512]^u8;
    val copied:           contracts.Error = keys.copy_rsa(private_key,
        contracts.Buffer{data: ?modulus[0], capacity: 512},
        contracts.Buffer{data: ?exponent[0], capacity: 512},
        contracts.SecretBuffer{data: ?private_exponent[0], capacity: 512});
    if (copied != contracts.OK) {
        ct.zeroize(?private_exponent[0], 512);
        ret contracts.Operation{error: copied, written: 0};
    }
    var salt:        [48]^u8;
    var salt_length: usize = 48;
    if (server.signature_scheme == tls13.RSA_PSS_RSAE_SHA256) {
        salt_length = 32;
    }
    if (!entropy_fill(server, ?salt[0], salt_length)) {
        ct.zeroize(?private_exponent[0], 512);
        ct.zeroize(?salt[0], 48);
        ret contracts.Operation{error: contracts.ENTROPY_UNAVAILABLE, written: 0};
    }
    val rsa_key: signature.RsaPrivateKey = signature.RsaPrivateKey{
        modulus:         contracts.Bytes{data: ?modulus[0], len: private_key.modulus_len},
        public_exponent: contracts.Bytes{data: ?exponent[0],
            len: private_key.exponent_len},
        private_exponent: contracts.SecretBytes{data: ?private_exponent[0],
            len: private_key.modulus_len},
    };
    var operation: contracts.Operation;
    if (server.signature_scheme == tls13.RSA_PSS_RSAE_SHA256) {
        operation = signature.sign_rsa_pss_sha256(rsa_key, message,
            contracts.SecretBytes{data: ?salt[0], len: 32}, output);
    }
    or {
        operation = signature.sign_rsa_pss_sha384(rsa_key, message,
            contracts.SecretBytes{data: ?salt[0], len: 48}, output);
    }
    ct.zeroize(?private_exponent[0], 512);
    ct.zeroize(?salt[0], 48);
    ret operation;
}

fun append_certificate_verify(server: *Handshake, offset: usize) usize {
    var signed: [MAX_SIGNED_CONTEXT]u8;
    if (certificate_verify_input(server, true, ?signed[0]) != error.OK) { ret 0; }
    var signature_bytes: [MAX_SIGNATURE]u8;
    val operation:       contracts.Operation = sign_server(server,
        contracts.Bytes{data: ?signed[0],
        len: 98 + key_schedule.hash_size(server.schedule.algorithm)},
        contracts.Buffer{data: ?signature_bytes[0], capacity: MAX_SIGNATURE});
    var i: usize = 0;
    for (i < MAX_SIGNED_CONTEXT) {
        signed[i] = 0;
        i         = i + 1;
    }
    if (operation.error != contracts.OK || operation.written == 0 ||
        8 + operation.written > server.buffers.output.chunk.bytes - offset) {
        ret 0;
    }
    var value: codec.CertificateVerify;
    value.scheme    = server.signature_scheme;
    value.signature = contracts.Bytes{data: ?signature_bytes[0],
        len: operation.written};
    val encoded: handshake.Progress = codec.encode_certificate_verify(?value,
        contracts.Buffer{data: ?server.buffers.output.chunk.data[offset],
        capacity: server.buffers.output.chunk.bytes - offset});
    i = 0;
    for (i < MAX_SIGNATURE) {
        signature_bytes[i] = 0;
        i                  = i + 1;
    }
    if (encoded.status != handshake.COMPLETE) { ret 0; }
    ret offset + encoded.produced;
}

fun append_finished(server: *Handshake, base: *key_schedule.Secret,
    offset: usize) usize {
    var hash: [48]u8;
    val size: usize = key_schedule.hash_size(server.schedule.algorithm);
    if (transcript.snapshot(?server.transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48}) != error.OK) { ret 0; }
    var verify_data: [48]u8;
    if (key_schedule.finished(?server.schedule, base,
        contracts.Bytes{data: ?hash[0], len: size},
        contracts.Buffer{data: ?verify_data[0], capacity: 48}) != error.OK) {
        ret 0;
    }
    var value: codec.Finished;
    value.verify_data = contracts.Bytes{data: ?verify_data[0], len: size};
    val encoded: handshake.Progress = codec.encode_finished(?value,
        contracts.Buffer{data: ?server.buffers.output.chunk.data[offset],
        capacity: server.buffers.output.chunk.bytes - offset});
    var i: usize = 0;
    for (i < 48) {
        hash[i]        = 0;
        verify_data[i] = 0;
        i              = i + 1;
    }
    if (encoded.status != handshake.COMPLETE) { ret 0; }
    ret offset + encoded.produced;
}

fun absorb(server: *Handshake, start: usize, end: usize) error.Error {
    if (end <= start) { ret error.INTERNAL_ERROR; }
    ret transcript.update_frame(?server.transcript,
        contracts.Bytes{data: ?server.buffers.output.chunk.data[start], len: end - start});
}

fun build_server_flight(server: *Handshake) error.Error {
    val flight_start: usize = server.output_used;
    var offset:       usize = flight_start;
    var next:         usize = append_encrypted_extensions(server, offset);
    if (next == 0) { ret error.RESOURCE_LIMIT; }
    var failure: error.Error = absorb(server, offset, next);
    if (failure != error.OK) { ret failure; }
    offset = next;
    if (!server.resumed) {
        if (server.client_auth_required) {
            next = append_certificate_request(server, offset);
            if (next == 0) { ret error.RESOURCE_LIMIT; }
            failure = absorb(server, offset, next);
            if (failure != error.OK) { ret failure; }
            offset = next;
        }
        next = append_certificate(server, offset);
        if (next == 0) { ret error.RESOURCE_LIMIT; }
        failure = absorb(server, offset, next);
        if (failure != error.OK) { ret failure; }
        offset = next;
        next   = append_certificate_verify(server, offset);
        if (next == 0) { ret error.INTERNAL_ERROR; }
        failure = absorb(server, offset, next);
        if (failure != error.OK) { ret failure; }
        offset = next;
    }
    next = append_finished(server, ?server.schedule.server_handshake_traffic,
        offset);
    if (next == 0) { ret error.INTERNAL_ERROR; }
    failure = absorb(server, offset, next);
    if (failure != error.OK) { ret failure; }
    offset = next;
    if (offset - flight_start > server.config.limits.max_server_flight_bytes) {
        ret error.RESOURCE_LIMIT;
    }
    var hash: [48]u8;
    val size: usize = key_schedule.hash_size(server.schedule.algorithm);
    failure = transcript.snapshot(?server.transcript,
        contracts.Buffer{data: ?hash[0], capacity: 48});
    if (failure == error.OK) {
        failure = key_schedule.advance_application(?server.schedule,
            contracts.Bytes{data: ?hash[0], len: size});
    }
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    if (failure != error.OK) { ret failure; }
    if (!queue_crypto(server, engine.HANDSHAKE, flight_start,
        offset - flight_start) ||
        !queue_secret(server, engine.APPLICATION, engine.SEND,
        SEND_APPLICATION)) { ret error.INTERNAL_ERROR; }
    server.output_used = offset;
    # the peer's transport parameters reach the caller through the event stream,
    # on the same borrowed-until-complete_event contract the client half uses,
    # and before HANDSHAKE_COMPLETE so a consumer can gate completion on them.
    # retain_peer_parameters has already rejected a configured peer that omitted
    # the extension, so the bytes are present whenever peer_extension is set.
    if (server.peer_extension != 0 &&
        !queue_simple(server, engine.PEER_PARAMETERS, engine.HANDSHAKE,
        0)) { ret error.INTERNAL_ERROR; }
    var disposition: u8 = engine.EARLY_NOT_OFFERED;
    if (server.early_data_offered) { disposition = engine.EARLY_REJECTED; }
    if (!queue_simple(server, engine.EARLY_DATA, engine.HANDSHAKE,
        disposition)) { ret error.INTERNAL_ERROR; }
    if (server.client_auth_required && !server.resumed) {
        server.state = EXPECT_CLIENT_CERTIFICATE;
    }
    or {
        server.state = EXPECT_CLIENT_FINISHED;
    }
    ret error.OK;
}

fun handle_client_hello(server: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    val after_retry: bool        = server.retry_count != 0;
    var hello:       codec.ClientHello;
    var failure:     error.Error = codec.decode_client_hello(message, after_retry,
        ?hello);
    if (failure != error.OK)      { ret failure; }
    if (!offered_version(?hello)) { ret error.PROTOCOL_VERSION; }
    if (frame.len > server.config.limits.max_client_hello_bytes) {
        ret error.RESOURCE_LIMIT;
    }
    if (!after_retry) {
        if (frame.len > server.buffers.hello.chunk.bytes) {
            ret error.RESOURCE_LIMIT;
        }
        copy_bytes(server.buffers.hello.chunk.data, frame.data, frame.len);
        server.hello_len = frame.len;
        if (hello.legacy_session_id.len > 32) { ret error.ILLEGAL_PARAMETER; }
        server.session_id_len = hello.legacy_session_id.len;
        if (server.session_id_len != 0) {
            copy_bytes(?server.session_id[0], hello.legacy_session_id.data,
                server.session_id_len);
        }
        server.early_data_offered = extensions.contains(hello.extensions,
            extensions.EARLY_DATA);
        var requested: contracts.Bytes;
        if (!extract_server_name(?hello, ?requested)) {
            ret error.ILLEGAL_PARAMETER;
        }
        var offered_alpn: contracts.Bytes;
        if (!extract_offered_alpn(?hello, ?offered_alpn)) {
            ret error.ILLEGAL_PARAMETER;
        }
        retain_server_name(server, requested);
        failure = acquire_credentials(server, server.server_name, offered_alpn);
        if (failure != error.OK)                { ret failure; }
        if (!record_size_limit(server, ?hello)) { ret error.ILLEGAL_PARAMETER; }
        failure = retain_peer_parameters(server, ?hello);
        if (failure != error.OK) { ret failure; }
    }
    or {
        var original: codec.ClientHello;
        failure = decode_retained_hello(server, ?original);
        if (failure != error.OK) { ret failure; }
        if (!hello_consistent(?original, ?hello)) {
            ret error.ILLEGAL_PARAMETER;
        }
    }
    var schemes:   [config.MAX_SIGNATURE_SCHEMES]tls13.SignatureScheme;
    var protocols: [255]negotiation.Protocol;
    var policy:    negotiation.Policy;
    if (!build_policy(server, ?schemes[0], ?protocols[0], ?policy)) {
        ret error.HANDSHAKE_FAILURE;
    }
    var selection: negotiation.Selection;
    failure = negotiation.negotiate(?hello, ?policy, ?selection);
    if (failure != error.OK) { ret failure; }
    if (after_retry && (selection.retry || selection.group != server.group ||
        selection.suite != server.suite)) { ret error.ILLEGAL_PARAMETER; }
    if (selection.retry) { ret build_hello_retry(server, ?selection); }
    # a retried hello carries a rewritten transcript, so resumption is only
    # attempted on the first flight and otherwise falls back to a full handshake
    if (!after_retry) {
        var resumed_suite: tls13.CipherSuite = selection.suite;
        failure = try_resume(server, ?hello, frame, ?resumed_suite);
        if (failure != error.OK) { ret failure; }
        if (server.resumed)      { selection.suite = resumed_suite; }
    }
    var peer: contracts.Bytes;
    if (!client_share(?hello, selection.group, ?peer)) {
        ret error.ILLEGAL_PARAMETER;
    }
    server.suite             = selection.suite;
    server.signature_scheme  = selection.signature;
    server.peer_offered_alpn = selection.protocol_offered;
    if (selection.protocol.len != 0) {
        copy_bytes(?server.selected_alpn_storage[0], selection.protocol.data,
            selection.protocol.len);
        server.selected_alpn = contracts.Bytes{
            data: ?server.selected_alpn_storage[0], len: selection.protocol.len
        };
    }
    if (!after_retry) {
        failure = transcript.init_for_suite(?server.transcript, selection.suite);
        if (failure == error.OK) {
            failure = transcript.update_frame(?server.transcript, frame);
        }
    }
    or {
        failure = transcript.update_frame(?server.transcript, frame);
    }
    if (failure != error.OK)                    { ret failure; }
    if (!derive_share(server, selection.group)) { ret error.INTERNAL_ERROR; }
    failure = build_server_hello(server, peer);
    if (failure != error.OK) { ret failure; }
    ret build_server_flight(server);
}

fun retain_peer_key(server: *Handshake) bool {
    val first:  contracts.Bytes = server.peer_leaf.public_key.first;
    val second: contracts.Bytes = server.peer_leaf.public_key.second;
    if (first.data == nil || first.len == 0 || first.len > MAX_PUBLIC_KEY ||
        second.len > MAX_PUBLIC_KEY || (second.len != 0 && second.data == nil)) {
        ret false;
    }
    copy_bytes(?server.peer_key_first[0], first.data, first.len);
    if (second.len != 0) {
        copy_bytes(?server.peer_key_second[0], second.data, second.len);
    }
    server.peer_leaf.public_key.encoded.data = nil;
    server.peer_leaf.public_key.encoded.len  = 0;
    server.peer_leaf.public_key.first        = contracts.Bytes{
        data: ?server.peer_key_first[0], len: first.len
    };
    server.peer_leaf.public_key.second = contracts.Bytes{
        data: ?server.peer_key_second[0], len: second.len
    };
    ret true;
}

fun handle_client_certificate(server: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var certificate_message: codec.CertificateMessage;
    var failure:             error.Error = codec.decode_certificate(message, true,
        ?certificate_message);
    if (failure != error.OK)                  { ret failure; }
    if (certificate_message.context.len != 0) { ret error.ILLEGAL_PARAMETER; }
    server.client_certificate_seen = true;
    if (certificate_message.count == 0) {
        server.client_certificate_empty = true;
        failure                         = transcript.update_frame(?server.transcript, frame);
        if (failure != error.OK) { ret failure; }
        server.state = EXPECT_CLIENT_FINISHED;
        ret error.CERTIFICATE_REQUIRED;
    }
    if (certificate_message.count > verify.MAX_CHAIN_DEPTH ||
        certificate_message.count > verify.MAX_CHAIN_DEPTH ||
        certificate_message.entries.len >
        server.config.limits.max_chain_bytes) { ret error.BAD_CERTIFICATE; }
    var iterator: codec.CertificateIterator = codec.certificate_iterator(
        ?certificate_message);
    var entry: codec.CertificateEntry;
    var count: usize = 0;
    var total: usize = 0;
    for (true) {
        val status: extensions.NextStatus = codec.next_certificate(?iterator,
            ?entry);
        if (status == extensions.NEXT_DONE) { brk; }
        if (status != extensions.NEXT_ITEM ||
            count >= verify.MAX_CHAIN_DEPTH ||
            entry.certificate.len > server.config.limits.max_certificate_bytes ||
            entry.certificate.len >
            server.config.limits.max_chain_bytes - total) {
            ret error.BAD_CERTIFICATE;
        }
        server.certificates[count].der     = entry.certificate.data;
        server.certificates[count].der_len = entry.certificate.len;
        total                              = total + entry.certificate.len;
        count                              = count + 1;
    }
    if (count != certificate_message.count || count == 0) {
        ret error.BAD_CERTIFICATE;
    }
    val chain: cert.Chain = cert.Chain{
        certificates: ?server.certificates[0], len: count
    };
    var options: verify.Options;
    options.identity             = contracts.Bytes{data: nil, len: 0};
    options.purpose              = verify.CLIENT_AUTH;
    options.now                  = server.at.wall;
    options.max_depth            = verify.MAX_CHAIN_DEPTH;
    options.max_signature_checks = verify.MAX_SIGNATURE_CHECKS;
    failure                      = verify.chain(server.client_trust, ?chain, ?options);
    if (failure != error.OK) { ret failure; }
    if (x509.parse(contracts.Bytes{data: server.certificates[0].der,
        len: server.certificates[0].der_len},
        ?server.peer_leaf) != contracts.OK || !retain_peer_key(server)) {
        ret error.BAD_CERTIFICATE;
    }
    failure = transcript.update_frame(?server.transcript, frame);
    if (failure == error.OK) {
        server.state = EXPECT_CLIENT_CERTIFICATE_VERIFY;
    }
    ret failure;
}

fun configured_signature(server: *Handshake, scheme: tls13.SignatureScheme) bool {
    var i: usize = 0;
    for (i < server.config.signature_len) {
        if (server.config.signatures[i] == scheme) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun verify_peer_signature(server: *Handshake,
    value: *codec.CertificateVerify) error.Error {
    if (!configured_signature(server, value.scheme)) {
        ret error.ILLEGAL_PARAMETER;
    }
    var signed:  [MAX_SIGNED_CONTEXT]u8;
    var failure: error.Error = certificate_verify_input(server, false,
        ?signed[0]);
    if (failure != error.OK) { ret failure; }
    val message: contracts.Bytes = contracts.Bytes{data: ?signed[0],
        len: 98 + key_schedule.hash_size(server.schedule.algorithm)};
    val status: contracts.Error = signature_scheme.verify(value.scheme,
        ?server.peer_leaf.public_key, message, value.signature);
    var i: usize = 0;
    for (i < MAX_SIGNED_CONTEXT) {
        signed[i] = 0;
        i         = i + 1;
    }
    if (status == contracts.UNSUPPORTED) { ret error.UNSUPPORTED_ALGORITHM; }
    if (status != contracts.OK)          { ret error.DECRYPT_ERROR; }
    ret error.OK;
}

fun handle_client_certificate_verify(server: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    var value:   codec.CertificateVerify;
    var failure: error.Error = codec.decode_certificate_verify(message, ?value);
    if (failure == error.OK) { failure = verify_peer_signature(server, ?value); }
    if (failure == error.OK) {
        failure = transcript.update_frame(?server.transcript, frame);
    }
    if (failure == error.OK) {
        server.authenticated = true;
        server.state         = EXPECT_CLIENT_FINISHED;
    }
    ret failure;
}

fun handle_client_finished(server: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    val size:    usize       = key_schedule.hash_size(server.schedule.algorithm);
    var value:   codec.Finished;
    var failure: error.Error = codec.decode_finished(message, size, ?value);
    var hash:    [48]u8;
    if (failure == error.OK) {
        failure = transcript.snapshot(?server.transcript,
            contracts.Buffer{data: ?hash[0], capacity: 48});
    }
    if (failure == error.OK) {
        failure = key_schedule.verify_finished(?server.schedule,
            ?server.schedule.client_handshake_traffic,
            contracts.Bytes{data: ?hash[0], len: size}, value.verify_data);
    }
    if (failure == error.OK) {
        failure = transcript.update_frame(?server.transcript, frame);
    }
    if (failure == error.OK) {
        failure = transcript.snapshot(?server.transcript,
            contracts.Buffer{data: ?hash[0], capacity: 48});
    }
    if (failure == error.OK) {
        failure = key_schedule.derive_resumption(?server.schedule,
            contracts.Bytes{data: ?hash[0], len: size});
    }
    var i: usize = 0;
    for (i < 48) {
        hash[i] = 0;
        i       = i + 1;
    }
    if (failure != error.OK) { ret failure; }
    if (!queue_secret(server, engine.APPLICATION, engine.RECEIVE,
        RECEIVE_APPLICATION)) { ret error.INTERNAL_ERROR; }
    if (server.client_auth_required) {
        var disposition: u8 = engine.AUTHENTICATION_FAILED;
        if (server.authenticated) { disposition = engine.AUTHENTICATED; }
        if (!queue_simple(server, engine.AUTHENTICATION, engine.APPLICATION,
            disposition)) { ret error.INTERNAL_ERROR; }
    }
    val issued: error.Error = issue_tickets(server);
    if (issued != error.OK) { ret issued; }
    if (!queue_simple(server, engine.HANDSHAKE_COMPLETE, engine.APPLICATION,
        0)) { ret error.INTERNAL_ERROR; }
    server.state = ESTABLISHED;
    ret error.OK;
}

fun ticket_state_for(server: *Handshake, nonce: contracts.Bytes,
    output: *session.State) bool {
    val size: usize = key_schedule.hash_size(server.schedule.algorithm);
    @output = session.empty_state();
    if (key_schedule.resumption_psk(?server.schedule, nonce,
        contracts.SecretBuffer{data: ?output.secret[0],
        capacity: session.MAX_SECRET}) != error.OK) {
        session.state_destroy(output);
        ret false;
    }
    output.version               = tls13.VERSION;
    output.suite                 = server.suite;
    output.secret_len            = size;
    output.issued_at             = server.at.wall;
    output.lifetime_seconds      = server.config.tickets.ticket_lifetime_seconds;
    output.max_early_data        = 0;
    output.client_authenticated  = server.authenticated;
    output.credential_generation =
        session.keyring_generation(server.config.tickets);
    if (server.selected_alpn.len != 0 &&
        server.selected_alpn.len <= session.MAX_ALPN) {
        copy_bytes(?output.alpn[0], server.selected_alpn.data,
            server.selected_alpn.len);
        output.alpn_len = server.selected_alpn.len;
    }
    if (server.server_name.len != 0 &&
        server.server_name.len <= session.MAX_SERVER_NAME) {
        copy_bytes(?output.server_name[0], server.server_name.data,
            server.server_name.len);
        output.server_name_len = server.server_name.len;
    }
    ret true;
}

# issue the configured number of independent single-nonce tickets
fun issue_tickets(server: *Handshake) error.Error {
    if (server.config.tickets == nil ||
        server.config.tickets_per_connection == 0) { ret error.OK; }
    var issued: u8 = 0;
    for (issued < server.config.tickets_per_connection) {
        var nonce: [session.NONCE_SIZE]u8;
        server.ticket_nonce = server.ticket_nonce + 1;
        var i: usize = 0;
        for (i < session.NONCE_SIZE) {
            nonce[i] = (server.ticket_nonce >>
                ((session.NONCE_SIZE - 1 - i) * 8)::u64)::u8;
            i = i + 1;
        }
        var state: session.State;
        if (!ticket_state_for(server,
            contracts.Bytes{data: ?nonce[0], len: session.NONCE_SIZE},
            ?state)) { ret error.INTERNAL_ERROR; }
        var age_add: [4]u8;
        if (!fill_public(server, ?age_add[0], 4)) {
            session.state_destroy(?state);
            ret error.INTERNAL_ERROR;
        }
        state.age_add = (age_add[0]::u32 << 24) | (age_add[1]::u32 << 16) |
            (age_add[2]::u32 << 8) | age_add[3]::u32;
        var sealed: [session.MAX_TICKET_BYTES]u8;
        val length: usize = session.seal(server.config.tickets, ?state,
            server.at, ?server.entropy,
            contracts.Buffer{data: ?sealed[0],
            capacity: session.MAX_TICKET_BYTES});
        if (length == 0) {
            session.state_destroy(?state);
            ret error.INTERNAL_ERROR;
        }
        var message: codec.NewSessionTicket;
        message.lifetime = state.lifetime_seconds;
        message.age_add  = state.age_add;
        message.nonce    = contracts.Bytes{data: ?nonce[0],
            len: session.NONCE_SIZE};
        message.ticket     = contracts.Bytes{data: ?sealed[0], len: length};
        message.extensions = extensions.list(nil, 0,
            extensions.NEW_SESSION_TICKET);
        val encoded: handshake.Progress = codec.encode_new_session_ticket(
            ?message,
            contracts.Buffer{data: ?server.buffers.output.chunk.data[server.output_used],
            capacity: server.buffers.output.chunk.bytes - server.output_used});
        session.state_destroy(?state);
        if (encoded.status != handshake.COMPLETE) { ret error.RESOURCE_LIMIT; }
        if (!queue_crypto(server, engine.APPLICATION, server.output_used,
            encoded.produced)) { ret error.INTERNAL_ERROR; }
        server.output_used    = server.output_used + encoded.produced;
        server.tickets_issued = server.tickets_issued + 1;
        issued                = issued + 1;
    }
    ret error.OK;
}

fun process_frame(server: *Handshake, frame: contracts.Bytes,
    message: *handshake.Message) error.Error {
    if (server.state == EXPECT_CLIENT_HELLO ||
        server.state == EXPECT_RETRY_HELLO) {
        if (message.header.message_type != handshake.CLIENT_HELLO) {
            ret error.UNEXPECTED_MESSAGE;
        }
        ret handle_client_hello(server, frame, message);
    }
    if (server.state == EXPECT_CLIENT_CERTIFICATE) {
        if (message.header.message_type != handshake.CERTIFICATE) {
            ret error.UNEXPECTED_MESSAGE;
        }
        ret handle_client_certificate(server, frame, message);
    }
    if (server.state == EXPECT_CLIENT_CERTIFICATE_VERIFY) {
        if (message.header.message_type != handshake.CERTIFICATE_VERIFY) {
            ret error.UNEXPECTED_MESSAGE;
        }
        ret handle_client_certificate_verify(server, frame, message);
    }
    if (server.state == EXPECT_CLIENT_FINISHED) {
        if (message.header.message_type != handshake.FINISHED) {
            ret error.UNEXPECTED_MESSAGE;
        }
        ret handle_client_finished(server, frame, message);
    }
    ret error.UNEXPECTED_MESSAGE;
}

# the limit for the next buffered message, chosen by its type
fun peer_limit(server: *Handshake) usize {
    var message_type: handshake.MessageType = 0;
    if (server.input_read < server.input_len) {
        message_type = server.buffers.input.chunk.data[server.input_read];
    }
    ret config.peer_message_limit(server.config.limits, message_type);
}

fun drive(server: *Handshake) engine.Result {
    var progressed: bool = false;
    for (true) {
        if (pending(server) || server.event_active) {
            ret result(engine.BLOCKED, error.OK, 0, 0);
        }
        if (server.input_read == server.input_len) {
            server.input_read = 0;
            server.input_len  = 0;
            ret result(engine.MORE, error.OK, 0, handshake.HEADER_SIZE);
        }
        var message: handshake.Message;
        val parsed:  handshake.Progress = handshake.parse(
            ?server.buffers.input.chunk.data[server.input_read],
            server.input_len - server.input_read,
            peer_limit(server) - handshake.HEADER_SIZE,
            ?message);
        if (parsed.status == handshake.NEED_INPUT) {
            ret result(engine.MORE, error.OK, 0, parsed.required);
        }
        if (parsed.status != handshake.COMPLETE) {
            ret fail(server, parsed.error, engine.alert_for(parsed.error));
        }
        val frame: contracts.Bytes = contracts.Bytes{
            data: ?server.buffers.input.chunk.data[server.input_read], len: parsed.consumed
        };
        val prepared: buffer.Outcome = prepare_frame(server,
            message.header.message_type, frame.len);
        if (prepared == buffer.FAIL) {
            ret fail(server, error.RESOURCE_LIMIT, record.INTERNAL_ERROR_ALERT);
        }
        if (prepared == buffer.WAIT) {
            if (progressed) { ret result(engine.OK, error.OK, 0, 0); }
            ret result(engine.WAITING, error.OK, 0, 0);
        }
        val failure: error.Error = process_frame(server, frame, ?message);
        if (failure != error.OK) {
            ret fail(server, failure, engine.alert_for(failure));
        }
        server.input_read = server.input_read + parsed.consumed;
        progressed        = true;
        if (pending(server)) { ret result(engine.OK, error.OK, 0, 0); }
    }
    ret result(engine.FAILED, error.INTERNAL_ERROR, 0, 0);
}

fun compact_input(server: *Handshake) {
    if (server.input_read == 0) { ret; }
    if (server.input_read == server.input_len) {
        server.input_read = 0;
        server.input_len  = 0;
        ret;
    }
    val remaining: usize = server.input_len - server.input_read;
    var i:         usize = 0;
    for (i < remaining) {
        server.buffers.input.chunk.data[i] = server.buffers.input.chunk.data[server.input_read + i];
        i                                  = i + 1;
    }
    server.input_read = 0;
    server.input_len  = remaining;
}

fun expected_level(server: *Handshake) engine.Level {
    if (server.state == EXPECT_CLIENT_HELLO ||
        server.state == EXPECT_RETRY_HELLO) { ret engine.INITIAL; }
    if (server.state == ESTABLISHED) { ret engine.APPLICATION; }
    ret engine.HANDSHAKE;
}

fun ingest_inner(server: *Handshake, level: engine.Level, data: *u8,
    length: usize) engine.Result {
    if (!server_owner_valid(server) || server.config == nil ||
        !engine.valid_level(level) || server.state == DESTROYED ||
        server.state == TERMINAL || !memory_range.valid(data, length) ||
        server_owner_overlaps(server, data, length) ||
        buffers_overlap(server, data, length) ||
        borrowed_overlaps(server.config, server.extra, data, length,
        true, true)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    if (pending(server) || server.event_active) {
        ret result(engine.BLOCKED, error.OK, 0, 0);
    }
    if (level != expected_level(server)) {
        ret fail(server, error.UNEXPECTED_MESSAGE,
            record.UNEXPECTED_MESSAGE_ALERT);
    }
    val unread: usize = server.input_len - server.input_read;
    if (length > input_limit(server) - unread) {
        ret fail(server, error.RESOURCE_LIMIT, record.INTERNAL_ERROR_ALERT);
    }
    # a larger chunk takes only the unread bytes, which is the same compaction
    if (length > server.buffers.input.chunk.bytes - unread) {
        val room: engine.Result = reserved(server, buffer.reserve_from(server.memory,
            ?server.buffers.input, unread + length, server.input_read, unread));
        if (room.status != engine.OK) { ret room; }
        server.input_read = 0;
        server.input_len  = unread;
    }
    compact_input(server);
    val before: usize = server.input_len;
    if (length != 0) {
        copy_bytes(?server.buffers.input.chunk.data[server.input_len], data, length);
        server.input_len = server.input_len + length;
    }
    var progress: engine.Result = drive(server);
    if (progress.status == engine.WAITING) {
        # nothing was processed, so the bytes are handed back
        zero_bytes(?server.buffers.input.chunk.data[before], length);
        server.input_len = before;
        ret progress;
    }
    progress.consumed = length;
    ret progress;
}

pub fun ingest(server: *Handshake, level: engine.Level, data: *u8,
    length: usize) engine.Result {
    if (!enter(server)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var progress: engine.Result;
    if (server.delegating) {
        if (server_owner_overlaps(server, data, length)) {
            progress = result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
        }
        or { progress = established.ingest(?server.core, level, data, length); }
    }
    or { progress = ingest_inner(server, level, data, length); }
    leave(server);
    ret progress;
}

fun poll_inner(server: *Handshake) engine.Result {
    if (!server_owner_valid(server) || server.config == nil ||
        server.state == DESTROYED || server.state == TERMINAL) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    ret drive(server);
}

pub fun poll(server: *Handshake) engine.Result {
    if (!enter(server)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var progress: engine.Result;
    if (server.delegating) { progress = established.poll(?server.core); }
    or                     { progress = poll_inner(server); }
    leave(server);
    ret progress;
}

fun aead_for(suite: tls13.CipherSuite) record.Algorithm {
    if (suite == tls13.AES_128_GCM_SHA256) { ret record.AES_128_GCM; }
    if (suite == tls13.AES_256_GCM_SHA384) { ret record.AES_256_GCM; }
    if (suite == tls13.CHACHA20_POLY1305_SHA256) {
        ret record.CHACHA20_POLY1305;
    }
    ret 0;
}

fun secret_for(server: *Handshake, index: usize) *key_schedule.Secret {
    if (index == SEND_HANDSHAKE) {
        ret ?server.schedule.server_handshake_traffic;
    }
    if (index == RECEIVE_HANDSHAKE) {
        ret ?server.schedule.client_handshake_traffic;
    }
    if (index == SEND_APPLICATION) {
        ret ?server.schedule.server_application_traffic;
    }
    if (index == RECEIVE_APPLICATION) {
        ret ?server.schedule.client_application_traffic;
    }
    ret nil;
}

fun next_event_inner(server: *Handshake, output: *engine.Event) bool {
    # nothing pending is answered before the borrowed descriptors are walked
    if (!server_owner_valid(server) || output == nil || server.event_active ||
        server.state == DESTROYED || !pending(server) ||
        !memory_range.valid((?output.token)::*u8, $size_of(engine.Event)) ||
        server_owner_overlaps(server, (?output.token)::*u8,
        $size_of(engine.Event)) ||
        buffers_overlap(server, (?output.token)::*u8,
        $size_of(engine.Event)) ||
        borrowed_overlaps(server.config, server.extra, (?output.token)::*u8,
        $size_of(engine.Event), true, true)) { ret false; }
    val item:  Pending      = server.queue[server.queue_head];
    var event: engine.Event = engine.empty_event();
    event.token       = engine.next_generation(server.event_generation);
    event.kind        = item.kind;
    event.level       = item.level;
    event.direction   = item.direction;
    event.suite       = server.suite;
    event.aead        = aead_for(server.suite);
    event.disposition = item.disposition;
    event.alert       = item.alert;
    if (item.kind == engine.CRYPTO) {
        if (item.offset > server.buffers.output.chunk.bytes ||
            item.length > server.buffers.output.chunk.bytes - item.offset) {
            ret false;
        }
        event.data = contracts.Bytes{data: ?server.buffers.output.chunk.data[item.offset],
            len: item.length};
    }
    or (item.kind == engine.TRAFFIC_SECRET) {
        val traffic: *key_schedule.Secret = secret_for(server, item.secret_index);
        if (traffic == nil) { ret false; }
        event.secret     = key_schedule.bytes(traffic);
        event.generation = engine.next_generation(
            server.secret_generation[item.secret_index]);
        server.secret_generation[item.secret_index] = event.generation;
    }
    or (item.kind == engine.PEER_PARAMETERS) {
        event.data = server.peer_parameters;
    }
    output[0]               = event;
    server.event_generation = event.token;
    server.active_event     = event;
    server.event_active     = true;
    ret true;
}

pub fun next_event(server: *Handshake, output: *engine.Event) bool {
    if (!enter(server)) { ret false; }
    var available: bool = false;
    if (server.delegating) {
        available = output != nil && !server_owner_overlaps(server,
            (?output.token)::*u8, $size_of(engine.Event)) &&
            established.next_event(?server.core, output);
    }
    or { available = next_event_inner(server, output); }
    leave(server);
    ret available;
}

# the configured protocol the handshake selected, borrowed from the caller
fun configured_alpn(server: *Handshake) contracts.Bytes {
    var i: usize = 0;
    for (server.selected_alpn.len != 0 && i < server.config.alpn_len) {
        val name: config.ProtocolName = server.config.alpn[i];
        if (bytes_equal(contracts.Bytes{data: name.data, len: name.len},
            server.selected_alpn)) {
            ret contracts.Bytes{data: name.data, len: name.len};
        }
        i = i + 1;
    }
    ret contracts.Bytes{data: nil, len: 0};
}

# once the last handshake event is accepted the established core takes over:
# it is seeded with the application secrets, and the schedule, transcript,
# resumed psk and credential lease go with the handshake
fun discard_completed(server: *Handshake) {
    var seed: established.Seed;
    seed.role                  = engine.SERVER;
    seed.suite                 = server.suite;
    seed.group                 = server.group;
    seed.retry_count           = server.retry_count;
    seed.tickets_issued        = server.tickets_issued;
    seed.authenticated         = server.authenticated;
    seed.resumed               = server.resumed;
    seed.peer_offered_alpn     = server.peer_offered_alpn;
    seed.client_auth_requested = server.client_auth_required;
    seed.quic                  = server.peer_extension == QUIC_TRANSPORT_PARAMETERS;
    seed.retain_exporter       = server.config.retain_exporter;
    seed.alpn                  = configured_alpn(server);
    seed.server_name.data      = nil;
    seed.server_name.len       = 0;
    seed.receive_record_limit  = server.receive_record_plaintext;
    seed.send_record_limit     = server.send_record_plaintext;
    seed.max_message_bytes     = server.config.limits.max_peer_handshake_bytes;
    seed.max_ticket_bytes      = server.config.limits.max_ticket_bytes;
    seed.sessions              = nil;
    seed.started_at            = server.at.monotonic;
    val seeded: bool = established.begin(?server.core, seed,
        ?server.schedule.server_application_traffic,
        ?server.schedule.client_application_traffic, nil,
        ?server.schedule.exporter_master, server.memory);
    key_schedule.destroy(?server.schedule);
    transcript.destroy(?server.transcript);
    session.state_destroy(?server.ticket_state);
    release_lease(server);
    if (!seeded) {
        fail(server, error.INTERNAL_ERROR, record.INTERNAL_ERROR_ALERT);
        ret;
    }
    server.delegating = true;
    # bytes the peer sent behind its finished belong to the core. a server core
    # assembles no ticket, so this never waits for memory
    if (server.input_read < server.input_len) {
        established.feed(?server.core, ?server.buffers.input.chunk.data[server.input_read],
            server.input_len - server.input_read);
    }
    server.input_read = 0;
    server.input_len  = 0;
    buffer.release(server.memory, ?server.buffers.input, server.buffers.input.chunk.bytes);
    buffer.release(server.memory, ?server.buffers.output, server.buffers.output.chunk.bytes);
}

fun complete_event_inner(server: *Handshake, token: u64, accepted: bool) bool {
    if (!server_owner_valid(server) || !server.event_active || token == 0 ||
        token != server.active_event.token) { ret false; }
    server.event_active = false;
    if (!accepted) {
        fail(server, error.INTERNAL_ERROR, record.INTERNAL_ERROR_ALERT);
        ret true;
    }
    server.queue_head = server.queue_head + 1;
    if (server.queue_head >= server.queue_len) {
        queue_clear(server);
        server.output_used = 0;
    }
    if (server.state == ESTABLISHED && !pending(server) &&
        server.schedule.stage == key_schedule.APPLICATION &&
        server.schedule.master_secret.active) {
        discard_completed(server);
    }
    ret true;
}

pub fun complete_event(server: *Handshake, token: u64, accepted: bool) bool {
    if (!enter(server)) { ret false; }
    var completed: bool = false;
    if (server.delegating) {
        completed = established.complete_event(?server.core, token, accepted);
    }
    or { completed = complete_event_inner(server, token, accepted); }
    leave(server);
    ret completed;
}

fun traffic_keys_inner(server: *Handshake, event: *engine.Event,
    key: contracts.SecretBuffer, iv: contracts.Buffer,
    key_length: *usize) bool {
    if (!server_owner_valid(server) || event == nil || key_length == nil ||
        !server.event_active || event.token != server.active_event.token ||
        server.active_event.kind != engine.TRAFFIC_SECRET) { ret false; }
    var index: usize = NO_SECRET;
    if (server.active_event.level == engine.HANDSHAKE &&
        server.active_event.direction == engine.SEND) { index = SEND_HANDSHAKE; }
    or (server.active_event.level == engine.HANDSHAKE &&
        server.active_event.direction == engine.RECEIVE) {
        index = RECEIVE_HANDSHAKE;
    }
    or (server.active_event.level == engine.APPLICATION &&
        server.active_event.direction == engine.SEND) {
        index = SEND_APPLICATION;
    }
    or (server.active_event.level == engine.APPLICATION &&
        server.active_event.direction == engine.RECEIVE) {
        index = RECEIVE_APPLICATION;
    }
    val traffic: *key_schedule.Secret = secret_for(server, index);
    if (traffic == nil) { ret false; }
    if (key_schedule.traffic_key(?server.schedule, traffic, key) != error.OK ||
        key_schedule.traffic_iv(?server.schedule, traffic, iv) != error.OK) {
        ret false;
    }
    @key_length = key_schedule.key_size(server.suite);
    ret true;
}

pub fun traffic_keys(server: *Handshake, event: *engine.Event,
    key: contracts.SecretBuffer, iv: contracts.Buffer,
    key_length: *usize) bool {
    if (!enter(server)) { ret false; }
    var derived: bool = false;
    if (server.delegating) {
        derived = established.traffic_keys(?server.core, event, key, iv, key_length);
    }
    or { derived = traffic_keys_inner(server, event, key, iv, key_length); }
    leave(server);
    ret derived;
}

fun close_inner(server: *Handshake,
    description: record.AlertDescription) engine.Result {
    if (!server_owner_valid(server) || server.state == DESTROYED ||
        server.state == TERMINAL || server.state == CLOSING ||
        !record.valid_tls13_alert(description)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var i: usize = server.queue_head;
    for (i < server.queue_len) {
        if (server.queue[i].kind == engine.ALERT) {
            ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
        }
        i = i + 1;
    }
    if (!queue_push(server, Pending{kind: engine.ALERT, level: 0, direction: 0,
        secret_index: NO_SECRET, offset: 0, length: 0, disposition: 0,
        alert:        description})) {
        ret result(engine.FAILED, error.RESOURCE_LIMIT, 0, 0);
    }
    server.pending_alert = description;
    if (description != record.USER_CANCELED_ALERT) { server.state = CLOSING; }
    ret result(engine.OK, error.OK, 0, 0);
}

pub fun close(server: *Handshake,
    description: record.AlertDescription) engine.Result {
    if (!enter(server)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var closed: engine.Result;
    if (server.delegating) { closed = established.close(?server.core, description); }
    or                     { closed = close_inner(server, description); }
    leave(server);
    ret closed;
}

fun destroy_inner(server: *Handshake) bool {
    if (!server_owner_valid(server) || server.event_active ||
        established.event_active(?server.core)) { ret false; }
    established.wipe(?server.core);
    server.delegating = false;
    ct.zeroize(?server.private_key[0], 32);
    transcript.destroy(?server.transcript);
    transcript.destroy(?server.binder_transcript);
    key_schedule.destroy(?server.schedule);
    session.state_destroy(?server.ticket_state);
    release_lease(server);
    release_buffers(server);
    server.config = nil;
    # cleared by declaration, which covers every field rather than the subset
    # a manual list happens to name (briar-systems/mach#3108)
    server.configuration        = config.no_server_config();
    server.entropy              = config.no_entropy();
    server.extra.data.data      = nil;
    server.peer_parameters.data = nil;
    server.selected_alpn.data   = nil;
    server.server_name.data     = nil;
    server.client_trust         = nil;
    queue_clear(server);
    server.output_used = 0;
    # every per-handshake field goes with the handshake, so an engine
    # initialised on this record again starts from the declared zero state;
    # only the transition owner survives, since this thread still holds it
    val owner:   i64 = server.transition_owner;
    var cleared: Handshake;
    @server                 = cleared;
    server.transition_owner = owner;
    server.state            = DESTROYED;
    ret true;
}

pub fun destroy(server: *Handshake) bool {
    if (!enter(server)) { ret false; }
    val destroyed: bool = destroy_inner(server);
    leave(server);
    ret destroyed;
}

# move the established connection into core and release the handshake, which
# init may then reuse. refused, changing nothing, until the handshake queue
# has drained and no event is active. take the snapshot first: the peer's
# name and quic parameters are not kept past this call
pub fun finish(server: *Handshake, core: *established.Established) contracts.Error {
    if (!enter(server)) { ret contracts.INVALID_STATE; }
    var finished: contracts.Error = contracts.INVALID_STATE;
    if (server.delegating && !server.event_active && !pending(server) &&
        established.move(core, ?server.core)) {
        destroy_inner(server);
        finished = contracts.OK;
    }
    leave(server);
    ret finished;
}

# a key update, served by the established core once the handshake has drained
pub fun request_key_update(server: *Handshake, request: u8) engine.Result {
    if (!enter(server)) {
        ret result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    var requested: engine.Result = result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    if (server.delegating) {
        requested = established.request_key_update(?server.core, request);
    }
    leave(server);
    ret requested;
}

fun snapshot_inner(server: *Handshake) engine.Snapshot {
    var value: engine.Snapshot = engine.empty_snapshot();
    if (!server_owner_valid(server)) { ret value; }
    value.role                  = engine.SERVER;
    value.version               = tls13.VERSION;
    value.error                 = server.failure;
    value.suite                 = server.suite;
    value.group                 = server.group;
    value.retry_count           = server.retry_count;
    value.authenticated         = server.authenticated;
    value.selected_alpn         = server.selected_alpn;
    value.peer_offered_alpn     = server.peer_offered_alpn;
    value.peer_parameters       = server.peer_parameters;
    value.peer_name             = server.server_name;
    value.client_auth_requested = server.client_auth_required;
    value.resumed               = server.resumed;
    value.tickets_issued        = server.tickets_issued;
    value.output_pending        = pending(server);
    value.event_active          = server.event_active;
    value.destroyed             = server.state == DESTROYED;
    if (server.state == ESTABLISHED) { value.status = engine.COMPLETE; }
    or (server.state == TERMINAL)    { value.status = engine.FAILED; }
    or (server.state == DESTROYED)   { value.status = engine.CLOSED; }
    or                               { value.status = engine.MORE; }
    ret value;
}

pub fun snapshot(server: *Handshake) engine.Snapshot {
    if (!enter(server)) { ret engine.empty_snapshot(); }
    var value: engine.Snapshot;
    if (server.delegating) {
        # the peer's name and parameters are the handshake's to report, until finish
        value                 = established.snapshot(?server.core);
        value.peer_name       = server.server_name;
        value.peer_parameters = server.peer_parameters;
    }
    or { value = snapshot_inner(server); }
    leave(server);
    ret value;
}

pub fun receive_record_limit(server: *Handshake) usize {
    if (!enter(server)) { ret 0; }
    var limit: usize = 0;
    if (server.delegating) { limit = established.receive_record_limit(?server.core); }
    or (server.config != nil && server.state != DESTROYED) {
        limit = server.receive_record_plaintext;
    }
    leave(server);
    ret limit;
}

pub fun send_record_limit(server: *Handshake) usize {
    if (!enter(server)) { ret 0; }
    var limit: usize = 0;
    if (server.delegating) { limit = established.send_record_limit(?server.core); }
    or (server.config != nil && server.state != DESTROYED) {
        limit = server.send_record_plaintext;
    }
    leave(server);
    ret limit;
}

# see the note on the no_* constructors in config.mach
fun no_extra_extension() ExtraExtension {
    var value: ExtraExtension;
    ret value;
}

test "server: configuration rejects unbounded and missing ownership" {
    var server:        Handshake;
    var configuration: config.ServerConfig;
    if (init(?server, ?configuration, pool.shared(), no_extra_extension(), 0)) { ret 1; }
    if (snapshot(?server).status != engine.MORE ||
        snapshot(?server).role != engine.SERVER) { ret 2; }
    if (start(?server, clock.at(0, 0)).status != engine.FAILED ||
        ingest(?server, engine.INITIAL, nil, 0).status != engine.FAILED) { ret 3; }
    ret 0;
}

test "server: certificate request carries the maximum signature policy" {
    var signatures: [config.MAX_SIGNATURE_SCHEMES]tls13.SignatureScheme =
        [config.MAX_SIGNATURE_SCHEMES]tls13.SignatureScheme{
        tls13.ED25519,
        tls13.ECDSA_SECP256R1_SHA256,
        tls13.ECDSA_SECP384R1_SHA384,
        tls13.RSA_PSS_RSAE_SHA256,
        tls13.RSA_PSS_RSAE_SHA384,
    };
    var configuration: config.ServerConfig;
    configuration.signatures    = ?signatures[0];
    configuration.signature_len = config.MAX_SIGNATURE_SCHEMES;
    var wire:   [64]u8;
    var server: Handshake;
    server.config                     = ?configuration;
    server.client_auth_required       = true;
    server.buffers.output.chunk.data  = ?wire[0];
    server.buffers.output.chunk.bytes = 64;
    var bounded: [MAX_SIGNATURE_ALGORITHM_BYTES + 2]u8;
    bounded[0]                                 = 0xa5;
    bounded[MAX_SIGNATURE_ALGORITHM_BYTES + 1] = 0x5a;
    if (encode_signature_algorithms(?server, ?bounded[1],
        MAX_SIGNATURE_ALGORITHM_BYTES - 1) != 0 ||
        bounded[0] != 0xa5 ||
        bounded[MAX_SIGNATURE_ALGORITHM_BYTES + 1] != 0x5a ||
        encode_signature_algorithms(?server, ?bounded[1],
        MAX_SIGNATURE_ALGORITHM_BYTES) != MAX_SIGNATURE_ALGORITHM_BYTES ||
        bounded[0] != 0xa5 ||
        bounded[MAX_SIGNATURE_ALGORITHM_BYTES + 1] != 0x5a) { ret 1; }
    val written: usize = append_certificate_request(?server, 0);
    if (written == 0) { ret 2; }
    var message: handshake.Message;
    if (handshake.parse(?wire[0], written, written, ?message).status !=
        handshake.COMPLETE) { ret 3; }
    var request: codec.CertificateRequest;
    if (codec.decode_certificate_request(?message, ?request) != error.OK) {
        ret 4;
    }
    var offered: extensions.Extension;
    if (!extensions.find(request.extensions, extensions.SIGNATURE_ALGORITHMS,
        ?offered) || offered.len != 12 ||
        read_u16(offered.data, 0) != 10) { ret 5; }
    var i: usize = 0;
    for (i < config.MAX_SIGNATURE_SCHEMES) {
        if (read_u16(offered.data, 2 + i * 2) != signatures[i]) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

var loopback_root: [341]u8;
var loopback_leaf: [393]u8;

fun hex_nibble(value: u8, output: *u8) bool {
    if (value >= '0' && value <= '9') {
        output[0] = value - '0';
        ret true;
    }
    if (value >= 'a' && value <= 'f') {
        output[0] = value - 'a' + 10;
        ret true;
    }
    ret false;
}

fun decode_hex(input: *u8, length: usize, output: *u8, capacity: usize) bool {
    if (input == nil || output == nil || (length & 1) != 0 ||
        length / 2 > capacity) { ret false; }
    var i: usize = 0;
    for (i < length / 2) {
        var high: u8;
        var low:  u8;
        if (!hex_nibble(input[i * 2], ?high) ||
            !hex_nibble(input[i * 2 + 1], ?low)) { ret false; }
        output[i] = (high << 4) | low;
        i         = i + 1;
    }
    ret true;
}

#[oblivious]
fun test_entropy(context: ptr, secret_context: *^u8, destination: *^u8,
    length: usize) i64 {
    val counter: *u8   = context::*u8;
    var i:       usize = 0;
    for (i < length) {
        destination[i] = counter[0] + i::u8 + 1;
        i              = i + 1;
    }
    counter[0] = counter[0] + 23;
    ret 0;
}

fun load_test_credentials(identity: *credentials.Identity,
    chain_storage: *cert.Certificate, key: *keys.PrivateKey,
    owner: *secret.Allocator) bool {
    val root_hex: *u8 = ""::*u8;
    val leaf_hex: *u8 = ""::*u8;
    if (!decode_hex(root_hex, 682, ?loopback_root[0], 341) ||
        !decode_hex(leaf_hex, 786, ?loopback_leaf[0], 393)) { ret false; }
    var key_der: [48]^u8 = [48]^u8{
        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06,
        0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20,
        0xeb, 0x3b, 0x8b, 0xa3, 0x21, 0x67, 0x09, 0xef,
        0x29, 0x39, 0x0e, 0x9c, 0x43, 0x84, 0x01, 0xbe,
        0xca, 0x3f, 0xf8, 0x03, 0x7d, 0x60, 0xbb, 0x30,
        0x42, 0x18, 0xc8, 0x8c, 0xd4, 0xb7, 0x9b, 0x72,
    };
    @key = keys.empty_private();
    val loaded: contracts.Error = load.private_der(
        contracts.SecretBytes{data: ?key_der[0], len: 48}, cert.PKCS8_DER,
        owner, key);
    ct.zeroize(?key_der[0], 48);
    if (loaded != contracts.OK) { ret false; }
    chain_storage[0]     = cert.Certificate{der: ?loopback_leaf[0], der_len: 393};
    identity.server_name = contracts.Bytes{data: "api.example.com"::*u8, len: 15};
    identity.chain       = cert.Chain{certificates: chain_storage, len: 1};
    identity.private_key = key;
    ret true;
}

# pump one complete handshake between the two engines in this package
fun exchange(local: *Handshake, peer: *client.Handshake) i64 {
    var rounds: usize = 0;
    for (rounds < 64) {
        var progressed: bool = false;
        var event:      engine.Event;
        for (next_event(local, ?event)) {
            progressed = true;
            if (event.kind == engine.CRYPTO) {
                val fed: engine.Result = client.ingest(peer, event.level,
                    event.data.data, event.data.len);
                if (fed.status == engine.FAILED) { ret 100; }
            }
            if (!complete_event(local, event.token, true)) { ret 101; }
        }
        var peer_event: engine.Event;
        for (client.next_event(peer, ?peer_event)) {
            progressed = true;
            if (peer_event.kind == engine.CRYPTO) {
                val fed: engine.Result = ingest(local, peer_event.level,
                    peer_event.data.data, peer_event.data.len);
                if (fed.status == engine.FAILED) { ret 102; }
            }
            if (!client.complete_event(peer, peer_event.token, true)) { ret 103; }
        }
        # complete means both sides are established and drained, as a caller
        # would leave them
        if (!progressed && snapshot(local).status == engine.COMPLETE &&
            client.snapshot(peer).status == engine.COMPLETE) { ret 0; }
        if (!progressed) {
            poll(local);
            client.poll(peer);
            if (!pending(local) && !client.snapshot(peer).output_pending) {
                ret 104;
            }
        }
        rounds = rounds + 1;
    }
    ret 105;
}

var quic_server_parameters: [64]u8;
var quic_client_parameters: [64]u8;
var quic_event_kinds:       [64]u8;
var quic_event_count:       usize = 0;
var quic_seen_parameters:   [8]u8;
var quic_seen_len:          usize = 0;

# the same loopback as `exchange`, recording the listener's event sequence and
# the bytes carried by PEER_PARAMETERS while they are still borrowed
fun exchange_recording(local: *Handshake, peer: *client.Handshake) i64 {
    var rounds: usize = 0;
    quic_event_count = 0;
    quic_seen_len    = 0;
    for (rounds < 64) {
        var progressed: bool = false;
        var event:      engine.Event;
        for (next_event(local, ?event)) {
            progressed = true;
            if (quic_event_count < 64) {
                quic_event_kinds[quic_event_count] = event.kind;
                quic_event_count                   = quic_event_count + 1;
            }
            if (event.kind == engine.PEER_PARAMETERS) {
                var i: usize = 0;
                for (i < event.data.len && i < 8) {
                    quic_seen_parameters[i] = event.data.data[i];
                    i                       = i + 1;
                }
                quic_seen_len = event.data.len;
            }
            if (event.kind == engine.CRYPTO) {
                val fed: engine.Result = client.ingest(peer, event.level,
                    event.data.data, event.data.len);
                if (fed.status == engine.FAILED) { ret 100; }
            }
            if (!complete_event(local, event.token, true)) { ret 101; }
        }
        var peer_event: engine.Event;
        for (client.next_event(peer, ?peer_event)) {
            progressed = true;
            if (peer_event.kind == engine.CRYPTO) {
                val fed: engine.Result = ingest(local, peer_event.level,
                    peer_event.data.data, peer_event.data.len);
                if (fed.status == engine.FAILED) { ret 102; }
            }
            if (!client.complete_event(peer, peer_event.token, true)) { ret 103; }
        }
        if (snapshot(local).status == engine.COMPLETE &&
            client.snapshot(peer).status == engine.COMPLETE) {
            # drain what the listener queued in the round that completed it,
            # so the recorded sequence ends at HANDSHAKE_COMPLETE
            var tail: engine.Event;
            for (next_event(local, ?tail)) {
                if (quic_event_count < 64) {
                    quic_event_kinds[quic_event_count] = tail.kind;
                    quic_event_count                   = quic_event_count + 1;
                }
                if (!complete_event(local, tail.token, true)) { ret 106; }
            }
            ret 0;
        }
        if (!progressed) {
            poll(local);
            client.poll(peer);
            if (!pending(local) && !client.snapshot(peer).output_pending) {
                ret 104;
            }
        }
        rounds = rounds + 1;
    }
    ret 105;
}

test "server: a complete tls 1.3 handshake authenticates the mach client" {
    var owner:         secret.Allocator = secret.system_allocator();
    var chain_storage: [1]cert.Certificate;
    var key:           keys.PrivateKey;
    var identity:      credentials.Identity;
    if (!load_test_credentials(?identity, ?chain_storage[0], ?key, ?owner)) {
        ret 1;
    }
    var generation: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK) { ret 2; }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        ret 3;
    }

    var server_counter: u8             = 3;
    var server_entropy: secret.Entropy = secret.Entropy{
        context:     ?server_counter, secret_context: nil, fill_fn: test_entropy,
        initialized: true
    };
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{
        tls13.ED25519
    };
    var listener: config.ServerConfig;
    listener.credentials                     = ?store;
    listener.alpn                            = ?protocols[0];
    listener.alpn_len                        = 1;
    listener.require_alpn                    = true;
    listener.versions                        = ?versions[0];
    listener.version_len                     = 1;
    listener.suites                          = ?suites[0];
    listener.suite_len                       = 1;
    listener.groups                          = ?groups[0];
    listener.group_len                       = 1;
    listener.signatures                      = ?signatures[0];
    listener.signature_len                   = 1;
    listener.entropy                         = ?server_entropy;
    listener.entropy_context_size            = 1;
    listener.limits                          = config.production_limits();
    listener.limits.max_peer_handshake_bytes = 8192;
    listener.limits.max_client_hello_bytes   = 8192;
    listener.limits.max_chain_bytes          = 4096;
    listener.limits.max_server_flight_bytes  = 8192;

    val server_storage: buffer.Lease = pool.shared();
    var extra:          ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    var hello_required:  usize = 0;
    var flight_required: usize = 0;
    if (!storage_requirements(?listener, extra, ?hello_required,
        ?flight_required) || hello_required == 0 || flight_required == 0) {
        ret 4;
    }
    var listener_engine: Handshake;
    if (!init(?listener_engine, ?listener, server_storage, extra, 0) ||
        start(?listener_engine, clock.at(1800000000, 1800000000)).status != engine.OK) { ret 5; }

    var anchor: cert.Certificate = cert.Certificate{der: ?loopback_root[0],
        der_len: 341};
    var trust:          cert.TrustStore = cert.TrustStore{anchors: ?anchor, len: 1};
    var client_counter: u8              = 91;
    var client_entropy: secret.Entropy  = secret.Entropy{
        context:     ?client_counter, secret_context: nil, fill_fn: test_entropy,
        initialized: true
    };
    var dialer: config.ClientConfig;
    dialer.server_name                     = contracts.Bytes{data: "api.example.com"::*u8, len: 15};
    dialer.alpn                            = ?protocols[0];
    dialer.alpn_len                        = 1;
    dialer.trust                           = ?trust;
    dialer.versions                        = ?versions[0];
    dialer.version_len                     = 1;
    dialer.suites                          = ?suites[0];
    dialer.suite_len                       = 1;
    dialer.groups                          = ?groups[0];
    dialer.group_len                       = 1;
    dialer.signatures                      = ?signatures[0];
    dialer.signature_len                   = 1;
    dialer.client_identity                 = nil;
    dialer.entropy                         = ?client_entropy;
    dialer.entropy_context_size            = 1;
    dialer.limits                          = config.production_limits();
    dialer.limits.max_peer_handshake_bytes = 8192;
    dialer.limits.max_chain_bytes          = 7168;
    val client_storage: buffer.Lease = pool.shared();
    var client_extra:   client.ExtraExtension;
    client_extra.kind      = 0;
    client_extra.data.data = nil;
    client_extra.data.len  = 0;
    var dialer_engine: client.Handshake;
    if (!client.init(?dialer_engine, ?dialer, client_storage, client_extra, 0) ||
        client.start(?dialer_engine, clock.at(1800000000, 1800000000)).status != engine.OK) { ret 6; }

    val exchanged: i64 = exchange(?listener_engine, ?dialer_engine);
    if (exchanged != 0) { ret 10 + exchanged::i32; }

    val server_view: engine.Snapshot = snapshot(?listener_engine);
    val client_view: engine.Snapshot = client.snapshot(?dialer_engine);
    if (server_view.status != engine.COMPLETE ||
        client_view.status != engine.COMPLETE) { ret 7; }
    if (!client_view.authenticated) { ret 8; }
    if (server_view.suite != tls13.AES_128_GCM_SHA256 ||
        client_view.suite != tls13.AES_128_GCM_SHA256) { ret 9; }
    if (server_view.group != tls13.X25519) { ret 30; }
    if (server_view.retry_count != 0)      { ret 31; }
    if (server_view.peer_name.len != 15)   { ret 32; }
    if (server_view.selected_alpn.len != 2 ||
        server_view.selected_alpn.data[0] != 'h' ||
        server_view.selected_alpn.data[1] != '2') { ret 33; }
    if (client_view.selected_alpn.len != 2) { ret 34; }

    # both sides derived the same application traffic secrets
    var server_secret: [48]u8;
    var client_secret: [48]u8;
    val size:          usize                 = key_schedule.hash_size(listener_engine.schedule.algorithm);
    val server_bytes:  contracts.SecretBytes = key_schedule.bytes(
        ?listener_engine.schedule.server_application_traffic);
    val client_bytes: contracts.SecretBytes = key_schedule.bytes(
        ?dialer_engine.schedule.server_application_traffic);
    if (server_bytes.len != size || client_bytes.len != size) { ret 35; }
    var i: usize = 0;
    for (i < size) {
        server_secret[i] = server_bytes.data[i]:>u8;
        client_secret[i] = client_bytes.data[i]:>u8;
        if (server_secret[i] != client_secret[i]) { ret 36; }
        i = i + 1;
    }

    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 37; }
    # the same records and storage carry a second handshake whose secrets
    # start again at generation one
    if (!init(?listener_engine, ?listener, server_storage, extra, 0) ||
        start(?listener_engine, clock.at(1800000001, 1800000001)).status != engine.OK) { ret 40; }
    if (!client.init(?dialer_engine, ?dialer, client_storage, client_extra, 0) ||
        client.start(?dialer_engine, clock.at(1800000001, 1800000001)).status != engine.OK) { ret 41; }
    if (!client.snapshot(?dialer_engine).output_pending)       { ret 46; }
    if (client.snapshot(?dialer_engine).status != engine.MORE) { ret 47; }
    if (snapshot(?listener_engine).status != engine.MORE)      { ret 48; }
    val exchanged_again: i64 = exchange(?listener_engine, ?dialer_engine);
    if (exchanged_again != 0) { ret 50 + exchanged_again::i32; }
    if (snapshot(?listener_engine).status != engine.COMPLETE ||
        client.snapshot(?dialer_engine).status != engine.COMPLETE) { ret 42; }
    i = 0;
    for (i < 4) {
        if (listener_engine.secret_generation[i] > 1) { ret 43; }
        i = i + 1;
    }
    i = 0;
    for (i < 6) {
        if (dialer_engine.secret_generation[i] > 1) { ret 44; }
        i = i + 1;
    }
    # a completed connection pins no credential generation, so a rotation is
    # reclaimable while it is still live
    if (listener_engine.lease_held || listener_engine.schedule.master_secret.active ||
        listener_engine.transcript.state != transcript.DESTROYED ||
        dialer_engine.schedule.master_secret.active ||
        dialer_engine.transcript.state != transcript.DESTROYED) { ret 49; }
    var retired: *credentials.Generation = nil;
    if (credentials.retire_store(?store, ?retired) != contracts.OK ||
        !credentials.reclaimable(retired)) { ret 38; }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 45; }
    if (keys.destroy_private(?key) != contracts.OK)                    { ret 39; }
    ret 0;
}

test "server: quic transport parameters reach the caller as an event" {
    var owner:         secret.Allocator = secret.system_allocator();
    var chain_storage: [1]cert.Certificate;
    var key:           keys.PrivateKey;
    var identity:      credentials.Identity;
    if (!load_test_credentials(?identity, ?chain_storage[0], ?key, ?owner)) {
        ret 1;
    }
    var generation: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK) { ret 2; }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        ret 3;
    }

    var server_counter: u8             = 3;
    var server_entropy: secret.Entropy = secret.Entropy{
        context:     ?server_counter, secret_context: nil, fill_fn: test_entropy,
        initialized: true
    };
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h3"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{
        tls13.ED25519
    };
    var listener: config.ServerConfig;
    listener.credentials                     = ?store;
    listener.alpn                            = ?protocols[0];
    listener.alpn_len                        = 1;
    listener.require_alpn                    = true;
    listener.versions                        = ?versions[0];
    listener.version_len                     = 1;
    listener.suites                          = ?suites[0];
    listener.suite_len                       = 1;
    listener.groups                          = ?groups[0];
    listener.group_len                       = 1;
    listener.signatures                      = ?signatures[0];
    listener.signature_len                   = 1;
    listener.entropy                         = ?server_entropy;
    listener.entropy_context_size            = 1;
    listener.limits                          = config.production_limits();
    listener.limits.max_peer_handshake_bytes = 8192;
    listener.limits.max_client_hello_bytes   = 8192;
    listener.limits.max_chain_bytes          = 4096;
    listener.limits.max_server_flight_bytes  = 8192;

    val server_storage: buffer.Lease = pool.shared();
    # what the listener sends; the client reads this as its own peer parameters
    var server_transport: [4]u8 = [4]u8{0x51, 0x52, 0x53, 0x54};
    var extra:            ExtraExtension;
    extra.kind      = QUIC_TRANSPORT_PARAMETERS;
    extra.data.data = ?server_transport[0];
    extra.data.len  = 4;
    var listener_engine: Handshake;
    if (!init(?listener_engine, ?listener, server_storage, extra,
        QUIC_TRANSPORT_PARAMETERS) ||
        start(?listener_engine, clock.at(1800000000, 1800000000)).status != engine.OK) { ret 4; }

    var anchor: cert.Certificate = cert.Certificate{der: ?loopback_root[0],
        der_len: 341};
    var trust:          cert.TrustStore = cert.TrustStore{anchors: ?anchor, len: 1};
    var client_counter: u8              = 91;
    var client_entropy: secret.Entropy  = secret.Entropy{
        context:     ?client_counter, secret_context: nil, fill_fn: test_entropy,
        initialized: true
    };
    var dialer: config.ClientConfig;
    dialer.server_name                     = contracts.Bytes{data: "api.example.com"::*u8, len: 15};
    dialer.alpn                            = ?protocols[0];
    dialer.alpn_len                        = 1;
    dialer.trust                           = ?trust;
    dialer.versions                        = ?versions[0];
    dialer.version_len                     = 1;
    dialer.suites                          = ?suites[0];
    dialer.suite_len                       = 1;
    dialer.groups                          = ?groups[0];
    dialer.group_len                       = 1;
    dialer.signatures                      = ?signatures[0];
    dialer.signature_len                   = 1;
    dialer.client_identity                 = nil;
    dialer.entropy                         = ?client_entropy;
    dialer.entropy_context_size            = 1;
    dialer.limits                          = config.production_limits();
    dialer.limits.max_peer_handshake_bytes = 8192;
    dialer.limits.max_chain_bytes          = 7168;
    val client_storage: buffer.Lease = pool.shared();
    # what the client sends; the listener must surface exactly these bytes
    var client_transport: [4]u8 = [4]u8{0x11, 0x22, 0x33, 0x44};
    var client_extra:     client.ExtraExtension;
    client_extra.kind      = client.QUIC_TRANSPORT_PARAMETERS;
    client_extra.data.data = ?client_transport[0];
    client_extra.data.len  = 4;
    var dialer_engine: client.Handshake;
    if (!client.init(?dialer_engine, ?dialer, client_storage, client_extra,
        client.QUIC_TRANSPORT_PARAMETERS) ||
        client.start(?dialer_engine, clock.at(1800000000, 1800000000)).status != engine.OK) { ret 5; }

    val exchanged: i64 = exchange_recording(?listener_engine, ?dialer_engine);
    if (exchanged != 0) { ret 10 + exchanged::i32; }

    # the event was delivered, carrying the peer's exact bytes while borrowed
    if (quic_seen_len != 4) { ret 6; }
    if (quic_seen_parameters[0] != 0x11 || quic_seen_parameters[1] != 0x22 ||
        quic_seen_parameters[2] != 0x33 ||
        quic_seen_parameters[3] != 0x44) { ret 7; }

    # and it arrived before completion, so a consumer may gate on it
    var parameters_at: usize = 64;
    var complete_at:   usize = 64;
    var i:             usize = 0;
    for (i < quic_event_count) {
        if (quic_event_kinds[i] == engine.PEER_PARAMETERS &&
            parameters_at == 64) { parameters_at = i; }
        if (quic_event_kinds[i] == engine.HANDSHAKE_COMPLETE &&
            complete_at == 64) { complete_at = i; }
        i = i + 1;
    }
    if (parameters_at == 64 || complete_at == 64) { ret 8; }
    if (parameters_at >= complete_at)             { ret 9; }

    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) {
        ret 40;
    }
    var retired: *credentials.Generation = nil;
    if (credentials.retire_store(?store, ?retired) != contracts.OK) { ret 41; }
    if (keys.destroy_private(?key) != contracts.OK)                 { ret 42; }
    ret 0;
}

var corpus_extensions: [1024]u8;
var corpus_hello:      [2048]u8;

fun put_u16_at(output: *u8, offset: usize, value: u16) usize {
    write_u16(output, offset, value);
    ret offset + 2;
}

fun put_bytes_at(output: *u8, offset: usize, source: *u8,
    length: usize) usize {
    copy_bytes(?output[offset], source, length);
    ret offset + length;
}

fun extension_supported_versions(offset: usize, include_tls13: bool) usize {
    var body:   [5]u8;
    var length: usize = 3;
    body[0] = 2;
    if (include_tls13) {
        body[1] = 3;
        body[2] = 4;
    }
    or {
        body[1] = 3;
        body[2] = 3;
    }
    ret put_extension(?corpus_extensions[0], offset,
        extensions.SUPPORTED_VERSIONS,
        contracts.Bytes{data: ?body[0], len: length});
}

fun extension_groups(offset: usize, group: u16, duplicate: bool) usize {
    var body:   [6]u8;
    var length: usize = 4;
    write_u16(?body[0], 0, 2);
    write_u16(?body[0], 2, group);
    if (duplicate) {
        write_u16(?body[0], 0, 4);
        write_u16(?body[0], 4, group);
        length = 6;
    }
    ret put_extension(?corpus_extensions[0], offset,
        extensions.SUPPORTED_GROUPS,
        contracts.Bytes{data: ?body[0], len: length});
}

fun extension_signatures(offset: usize) usize {
    var body: [4]u8;
    write_u16(?body[0], 0, 2);
    write_u16(?body[0], 2, tls13.ED25519);
    ret put_extension(?corpus_extensions[0], offset,
        extensions.SIGNATURE_ALGORITHMS,
        contracts.Bytes{data: ?body[0], len: 4});
}

fun extension_alpn(offset: usize, name: *u8, name_len: usize) usize {
    var body: [64]u8;
    write_u16(?body[0], 0, (1 + name_len)::u16);
    body[2] = name_len::u8;
    copy_bytes(?body[3], name, name_len);
    ret put_extension(?corpus_extensions[0], offset,
        extensions.APPLICATION_LAYER_PROTOCOL,
        contracts.Bytes{data: ?body[0], len: 3 + name_len});
}

fun extension_key_share(offset: usize, group: u16, key_len: usize) usize {
    var body: [128]u8;
    write_u16(?body[0], 0, (4 + key_len)::u16);
    write_u16(?body[0], 2, group);
    write_u16(?body[0], 4, key_len::u16);
    var i: usize = 0;
    for (i < key_len) {
        body[6 + i] = (0x40 + i)::u8;
        i           = i + 1;
    }
    if (group == tls13.SECP256R1) { body[6] = 4; }
    ret put_extension(?corpus_extensions[0], offset, extensions.KEY_SHARE,
        contracts.Bytes{data: ?body[0], len: 6 + key_len});
}

fun extension_server_name(offset: usize) usize {
    var body: [32]u8;
    write_u16(?body[0], 0, 18);
    body[2] = 0;
    write_u16(?body[0], 3, 15);
    copy_bytes(?body[5], "api.example.com"::*u8, 15);
    ret put_extension(?corpus_extensions[0], offset, extensions.SERVER_NAME,
        contracts.Bytes{data: ?body[0], len: 20});
}

fun assemble_hello(legacy_version: u16, suite: u16, suite_count: usize,
    compression: u8, extension_len: usize) usize {
    var offset: usize = 4;
    offset = put_u16_at(?corpus_hello[0], offset, legacy_version);
    var i: usize = 0;
    for (i < 32) {
        corpus_hello[offset + i] = (0x10 + i)::u8;
        i                        = i + 1;
    }
    offset               = offset + 32;
    corpus_hello[offset] = 0;
    offset               = offset + 1;
    offset               = put_u16_at(?corpus_hello[0], offset, (suite_count * 2)::u16);
    i                    = 0;
    for (i < suite_count) {
        offset = put_u16_at(?corpus_hello[0], offset, suite);
        i      = i + 1;
    }
    corpus_hello[offset]     = 1;
    corpus_hello[offset + 1] = compression;
    offset                   = offset + 2;
    offset                   = put_u16_at(?corpus_hello[0], offset, extension_len::u16);
    offset                   = put_bytes_at(?corpus_hello[0], offset, ?corpus_extensions[0],
        extension_len);
    corpus_hello[0] = handshake.CLIENT_HELLO;
    write_u24(?corpus_hello[0], 1, offset - 4);
    ret offset;
}

fun corpus_listener(listener: *config.ServerConfig, store: *credentials.Store,
    protocols: *config.ProtocolName, versions: *u16,
    suites: *tls13.CipherSuite, groups: *tls13.NamedGroup,
    signatures: *tls13.SignatureScheme, entropy: *secret.Entropy) {
    listener.credentials                     = store;
    listener.alpn                            = protocols;
    listener.alpn_len                        = 1;
    listener.require_alpn                    = true;
    listener.versions                        = versions;
    listener.version_len                     = 1;
    listener.suites                          = suites;
    listener.suite_len                       = 1;
    listener.groups                          = groups;
    listener.group_len                       = 1;
    listener.signatures                      = signatures;
    listener.signature_len                   = 1;
    listener.entropy                         = entropy;
    listener.entropy_context_size            = 1;
    listener.limits                          = config.production_limits();
    listener.limits.max_peer_handshake_bytes = 8192;
    listener.limits.max_client_hello_bytes   = 8192;
    listener.limits.max_chain_bytes          = 4096;
    listener.limits.max_server_flight_bytes  = 8192;
}

# feed one hello to a fresh listener and report the alert it emits
fun reject_code(listener: *config.ServerConfig, hello_len: usize,
    failure: *error.Error) record.AlertDescription {
    val storage: buffer.Lease = pool.shared();
    var extra:   ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    var value: Handshake;
    @failure = error.INTERNAL_ERROR;
    if (!init(?value, listener, storage, extra, 0) ||
        start(?value, clock.at(1800000000, 1800000000)).status != engine.OK) { ret record.NO_ALERT; }
    val fed: engine.Result = ingest(?value, engine.INITIAL, ?corpus_hello[0],
        hello_len);
    if (fed.status != engine.FAILED) {
        destroy(?value);
        ret record.NO_ALERT;
    }
    @failure = snapshot(?value).error;
    var event: engine.Event;
    if (!next_event(?value, ?event) || event.kind != engine.ALERT) {
        destroy(?value);
        ret record.NO_ALERT;
    }
    val alert: record.AlertDescription = event.alert;
    complete_event(?value, event.token, true);
    # a terminal engine accepts no further peer input
    if (ingest(?value, engine.INITIAL, ?corpus_hello[0],
        hello_len).status != engine.FAILED) {
        destroy(?value);
        ret record.NO_ALERT;
    }
    destroy(?value);
    ret alert;
}

test "server: malformed client hellos fail with protocol-correct alerts" {
    var owner:         secret.Allocator = secret.system_allocator();
    var chain_storage: [1]cert.Certificate;
    var key:           keys.PrivateKey;
    var identity:      credentials.Identity;
    if (!load_test_credentials(?identity, ?chain_storage[0], ?key, ?owner)) {
        ret 1;
    }
    var generation: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK) { ret 2; }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        ret 3;
    }
    var counter: u8             = 5;
    var entropy: secret.Entropy = secret.Entropy{context: ?counter,
        secret_context: nil, fill_fn: test_entropy, initialized: true};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{
        tls13.ED25519
    };
    var listener: config.ServerConfig;
    corpus_listener(?listener, ?store, ?protocols[0], ?versions[0], ?suites[0],
        ?groups[0], ?signatures[0], ?entropy);
    var failure: error.Error = error.OK;

    # a well-formed offer is accepted, so every rejection below is specific
    var extension_len: usize = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    var hello_len: usize = assemble_hello(tls13.LEGACY_VERSION,
        tls13.AES_128_GCM_SHA256, 1, 0, extension_len);
    if (reject_code(?listener, hello_len, ?failure) != record.NO_ALERT) {
        ret 4;
    }

    # a truncated offer consumes input without publishing state
    val accepted_storage: buffer.Lease = pool.shared();
    var partial_extra:    ExtraExtension;
    partial_extra.kind      = 0;
    partial_extra.data.data = nil;
    partial_extra.data.len  = 0;
    var partial: Handshake;
    if (!init(?partial, ?listener, accepted_storage, partial_extra, 0) ||
        start(?partial, clock.at(1800000000, 1800000000)).status != engine.OK) { ret 5; }
    var byte: usize = 0;
    for (byte + 1 < hello_len) {
        val fed: engine.Result = ingest(?partial, engine.INITIAL,
            ?corpus_hello[byte], 1);
        if (fed.status != engine.MORE || fed.required == 0 ||
            pending(?partial)) { ret 6; }
        byte = byte + 1;
    }
    if (ingest(?partial, engine.INITIAL, ?corpus_hello[hello_len - 1],
        1).status != engine.OK || !pending(?partial)) { ret 7; }
    if (!destroy(?partial)) { ret 8; }

    # supported_versions absent
    extension_len = extension_server_name(0);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, tls13.AES_128_GCM_SHA256,
        1, 0, extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.PROTOCOL_VERSION_ALERT ||
        failure != error.PROTOCOL_VERSION) { ret 10; }

    # supported_versions without tls 1.3
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, false);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, tls13.AES_128_GCM_SHA256,
        1, 0, extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.PROTOCOL_VERSION_ALERT ||
        failure != error.PROTOCOL_VERSION) { ret 11; }

    # no key share and no pre-shared key
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, tls13.AES_128_GCM_SHA256,
        1, 0, extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.MISSING_EXTENSION_ALERT ||
        failure != error.MISSING_EXTENSION) { ret 12; }

    # a key share for a group that was never offered
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.SECP256R1, 65);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, tls13.AES_128_GCM_SHA256,
        1, 0, extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.ILLEGAL_PARAMETER_ALERT ||
        failure != error.ILLEGAL_PARAMETER) { ret 13; }

    # a duplicated value inside supported_groups
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, true);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, tls13.AES_128_GCM_SHA256,
        1, 0, extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.ILLEGAL_PARAMETER_ALERT ||
        failure != error.ILLEGAL_PARAMETER) { ret 14; }

    # no cipher suite in common
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, 0x1305, 1, 0,
        extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.HANDSHAKE_FAILURE_ALERT ||
        failure != error.HANDSHAKE_FAILURE) { ret 15; }

    # no application protocol in common
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h3"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, tls13.AES_128_GCM_SHA256,
        1, 0, extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.NO_APPLICATION_PROTOCOL_ALERT ||
        failure != error.NO_APPLICATION_PROTOCOL) { ret 16; }

    # a legacy record version the protocol forbids
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    hello_len     = assemble_hello(0x0301, tls13.AES_128_GCM_SHA256, 1, 0,
        extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.ILLEGAL_PARAMETER_ALERT ||
        failure != error.ILLEGAL_PARAMETER) { ret 17; }

    # a compression method other than null
    extension_len = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    hello_len     = assemble_hello(tls13.LEGACY_VERSION, tls13.AES_128_GCM_SHA256,
        1, 1, extension_len);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.ILLEGAL_PARAMETER_ALERT ||
        failure != error.ILLEGAL_PARAMETER) { ret 18; }

    # an unknown handshake message in place of the client hello
    corpus_hello[0] = 0x63;
    if (reject_code(?listener, hello_len, ?failure) !=
        record.UNEXPECTED_MESSAGE_ALERT ||
        failure != error.UNEXPECTED_MESSAGE) { ret 19; }

    # a declared body above the configured client hello bound
    corpus_hello[0] = handshake.CLIENT_HELLO;
    write_u24(?corpus_hello[0], 1, 0xFFFFF0);
    if (reject_code(?listener, hello_len, ?failure) !=
        record.INTERNAL_ERROR_ALERT ||
        failure != error.RESOURCE_LIMIT) { ret 20; }

    var retired: *credentials.Generation = nil;
    if (credentials.retire_store(?store, ?retired) != contracts.OK ||
        !credentials.reclaimable(retired)) { ret 21; }
    if (keys.destroy_private(?key) != contracts.OK) { ret 22; }
    ret 0;
}

var resume_ring:              session.KeyRing;
var resume_window:            session.ReplayWindow;
var resume_store:             session.ClientStore;
var resume_listener:          config.ServerConfig;
var resume_dialer:            config.ClientConfig;
var resume_protocols:         [1]config.ProtocolName;
var resume_versions:          [1]u16;
var resume_suites:            [1]tls13.CipherSuite;
var resume_groups:            [1]tls13.NamedGroup;
var resume_signatures:        [1]tls13.SignatureScheme;
var resume_server_entropy:    secret.Entropy;
var resume_client_entropy:    secret.Entropy;
var resume_server_counter:    u8;
var resume_client_counter:    u8;
var resume_anchor:            cert.Certificate;
var resume_trust:             cert.TrustStore;
var resume_chain:             [1]cert.Certificate;
var resume_key:               keys.PrivateKey;
var resume_identity:          credentials.Identity;
var resume_generation:        credentials.Generation;
var resume_store_credentials: credentials.Store;

fun resume_configure(policy: session.ReplayPolicy, tickets: u8,
    owner: *secret.Allocator, now: clock.Moment) bool {
    if (!load_test_credentials(?resume_identity, ?resume_chain[0], ?resume_key,
        owner)) { ret false; }
    resume_generation = credentials.empty_generation();
    if (credentials.initialize(?resume_generation, ?resume_identity, 1, 0, nil,
        false) != contracts.OK) { ret false; }
    resume_store_credentials = credentials.empty_store();
    if (credentials.initialize_store(?resume_store_credentials,
        ?resume_generation) != contracts.OK) { ret false; }
    resume_server_counter = 11;
    resume_client_counter = 71;
    resume_server_entropy = secret.Entropy{context: ?resume_server_counter,
        secret_context: nil, fill_fn: test_entropy, initialized: true};
    resume_client_entropy = secret.Entropy{context: ?resume_client_counter,
        secret_context: nil, fill_fn: test_entropy, initialized: true};
    if (!session.keyring_init(?resume_ring, ?resume_server_entropy, now, 3600,
        1800, 7200) || !session.replay_init(?resume_window) ||
        !session.client_store_init(?resume_store)) { ret false; }
    resume_protocols[0]                             = config.ProtocolName{data: "h2"::*u8, len: 2};
    resume_versions[0]                              = tls13.VERSION;
    resume_suites[0]                                = tls13.AES_128_GCM_SHA256;
    resume_groups[0]                                = tls13.X25519;
    resume_signatures[0]                            = tls13.ED25519;
    resume_listener                                 = config.no_server_config();
    resume_listener.credentials                     = ?resume_store_credentials;
    resume_listener.alpn                            = ?resume_protocols[0];
    resume_listener.alpn_len                        = 1;
    resume_listener.require_alpn                    = true;
    resume_listener.versions                        = ?resume_versions[0];
    resume_listener.version_len                     = 1;
    resume_listener.suites                          = ?resume_suites[0];
    resume_listener.suite_len                       = 1;
    resume_listener.groups                          = ?resume_groups[0];
    resume_listener.group_len                       = 1;
    resume_listener.signatures                      = ?resume_signatures[0];
    resume_listener.signature_len                   = 1;
    resume_listener.entropy                         = ?resume_server_entropy;
    resume_listener.entropy_context_size            = 1;
    resume_listener.tickets                         = ?resume_ring;
    resume_listener.replay                          = ?resume_window;
    resume_listener.replay_policy                   = policy;
    resume_listener.tickets_per_connection          = tickets;
    resume_listener.limits                          = config.production_limits();
    resume_listener.limits.max_peer_handshake_bytes = 16384;
    resume_listener.limits.max_client_hello_bytes   = 16384;
    resume_listener.limits.max_chain_bytes          = 4096;
    resume_listener.limits.max_server_flight_bytes  = 8192;

    resume_anchor             = cert.Certificate{der: ?loopback_root[0], der_len: 341};
    resume_trust              = cert.TrustStore{anchors: ?resume_anchor, len: 1};
    resume_dialer             = config.no_client_config();
    resume_dialer.server_name = contracts.Bytes{data: "api.example.com"::*u8,
        len: 15};
    resume_dialer.alpn                            = ?resume_protocols[0];
    resume_dialer.alpn_len                        = 1;
    resume_dialer.trust                           = ?resume_trust;
    resume_dialer.versions                        = ?resume_versions[0];
    resume_dialer.version_len                     = 1;
    resume_dialer.suites                          = ?resume_suites[0];
    resume_dialer.suite_len                       = 1;
    resume_dialer.groups                          = ?resume_groups[0];
    resume_dialer.group_len                       = 1;
    resume_dialer.signatures                      = ?resume_signatures[0];
    resume_dialer.signature_len                   = 1;
    resume_dialer.entropy                         = ?resume_client_entropy;
    resume_dialer.entropy_context_size            = 1;
    resume_dialer.sessions                        = ?resume_store;
    resume_dialer.limits                          = config.production_limits();
    resume_dialer.limits.max_peer_handshake_bytes = 16384;
    resume_dialer.limits.max_client_hello_bytes   = 16384;
    resume_dialer.limits.max_chain_bytes          = 12288;
    ret true;
}

fun resume_connect(listener_engine: *Handshake, dialer_engine: *client.Handshake,
    now: clock.Moment) i64 {
    val server_storage: buffer.Lease = pool.shared();
    var extra:          ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    if (!init(listener_engine, ?resume_listener, server_storage, extra, 0) ||
        start(listener_engine, now).status != engine.OK) { ret 1; }
    val client_storage: buffer.Lease = pool.shared();
    var client_extra:   client.ExtraExtension;
    client_extra.kind      = 0;
    client_extra.data.data = nil;
    client_extra.data.len  = 0;
    if (!client.init(dialer_engine, ?resume_dialer, client_storage,
        client_extra, 0) ||
        client.start(dialer_engine, now).status != engine.OK) { ret 2; }
    val exchanged: i64 = exchange(listener_engine, dialer_engine);
    if (exchanged != 0) { ret 3; }
    ret 0;
}

# drain every queued post-handshake event in both directions
fun pump_post(local: *Handshake, peer: *client.Handshake) i64 {
    var rounds: usize = 0;
    for (rounds < 32) {
        var progressed: bool = false;
        var event:      engine.Event;
        for (next_event(local, ?event)) {
            progressed = true;
            if (event.kind == engine.CRYPTO) {
                if (client.ingest(peer, event.level, event.data.data,
                    event.data.len).status == engine.FAILED) { ret 1; }
            }
            if (!complete_event(local, event.token, true)) { ret 2; }
        }
        var peer_event: engine.Event;
        for (client.next_event(peer, ?peer_event)) {
            progressed = true;
            if (peer_event.kind == engine.CRYPTO) {
                if (ingest(local, peer_event.level, peer_event.data.data,
                    peer_event.data.len).status == engine.FAILED) { ret 3; }
            }
            if (!client.complete_event(peer, peer_event.token, true)) { ret 4; }
        }
        if (!progressed) { ret 0; }
        rounds = rounds + 1;
    }
    ret 5;
}

fun secrets_match(local: *Handshake, peer: *client.Handshake, server_send: bool) bool {
    val size: usize = key_schedule.hash_size(key_schedule.algorithm_for_suite(local.suite));
    if (size == 0 || !local.delegating || !peer.delegating) { ret false; }
    var mine:   contracts.SecretBytes;
    var theirs: contracts.SecretBytes;
    if (server_send) {
        mine   = key_schedule.bytes(?local.core.send);
        theirs = key_schedule.bytes(?peer.core.receive);
    }
    or {
        mine   = key_schedule.bytes(?local.core.receive);
        theirs = key_schedule.bytes(?peer.core.send);
    }
    if (mine.len != size || theirs.len != size) { ret false; }
    var i: usize = 0;
    for (i < size) {
        if (mine.data[i]:>u8 != theirs.data[i]:>u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "session: a ticket resumes one connection and a key update rekeys it" {
    var owner: secret.Allocator = secret.system_allocator();
    if (!resume_configure(session.REPLAY_PERMISSIVE, 2, ?owner, clock.at(1800000000, 1800000000))) {
        ret 1;
    }
    var listener_engine: Handshake;
    var dialer_engine:   client.Handshake;
    val first:           i64 = resume_connect(?listener_engine, ?dialer_engine,
        clock.at(1800000000, 1800000000));
    if (first != 0) { ret 10 + first::i32; }
    if (snapshot(?listener_engine).resumed ||
        client.snapshot(?dialer_engine).resumed) { ret 2; }
    if (snapshot(?listener_engine).tickets_issued != 2) { ret 3; }
    val drained: i64 = pump_post(?listener_engine, ?dialer_engine);
    if (drained != 0)                                   { ret 20 + drained::i32; }
    if (session.client_store_count(?resume_store) != 2) { ret 4; }

    # a key update rekeys the sending direction on both sides
    if (!secrets_match(?listener_engine, ?dialer_engine, true)) { ret 5; }
    if (request_key_update(?listener_engine,
        codec.UPDATE_NOT_REQUESTED).status != engine.OK) { ret 6; }
    val updated: i64 = pump_post(?listener_engine, ?dialer_engine);
    if (updated != 0)                                            { ret 30 + updated::i32; }
    if (!secrets_match(?listener_engine, ?dialer_engine, true))  { ret 7; }
    if (!secrets_match(?listener_engine, ?dialer_engine, false)) { ret 8; }
    # the client initiates one too, and the peer answers it
    if (client.request_key_update(?dialer_engine,
        codec.UPDATE_REQUESTED).status != engine.OK) { ret 9; }
    val answered: i64 = pump_post(?listener_engine, ?dialer_engine);
    if (answered != 0) { ret 40 + answered::i32; }
    if (!secrets_match(?listener_engine, ?dialer_engine, false) ||
        !secrets_match(?listener_engine, ?dialer_engine, true)) { ret 50; }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) {
        ret 51;
    }

    # the retained ticket resumes a fresh pair of engines
    var second_listener: Handshake;
    var second_dialer:   client.Handshake;
    val second:          i64 = resume_connect(?second_listener, ?second_dialer,
        clock.at(1800000100, 1800000100));
    if (second != 0) { ret 60 + second::i32; }
    val server_view: engine.Snapshot = snapshot(?second_listener);
    val client_view: engine.Snapshot = client.snapshot(?second_dialer);
    if (!server_view.resumed || !client_view.resumed)  { ret 52; }
    if (!client_view.authenticated)                    { ret 53; }
    if (server_view.suite != tls13.AES_128_GCM_SHA256) { ret 54; }
    if (server_view.selected_alpn.len != 2)            { ret 55; }
    if (!secrets_match(?second_listener, ?second_dialer, true) ||
        !secrets_match(?second_listener, ?second_dialer, false)) { ret 56; }
    # the resumed connection consumed one ticket and delivered its own two
    if (session.client_store_count(?resume_store) != 3) { ret 57; }
    # a completed resumption keeps neither side's psk, transcript or lease
    if (second_listener.ticket_state.secret_len != 0 ||
        second_dialer.offered_ticket.secret_len != 0 ||
        second_dialer.offered_ticket.valid || second_listener.lease_held ||
        second_listener.transcript.state != transcript.DESTROYED ||
        second_dialer.transcript.state != transcript.DESTROYED) { ret 61; }
    if (!destroy(?second_listener) || !client.destroy(?second_dialer)) {
        ret 58;
    }

    var retired: *credentials.Generation = nil;
    credentials.retire_store(?resume_store_credentials, ?retired);
    session.keyring_destroy(?resume_ring);
    session.replay_destroy(?resume_window);
    session.client_store_destroy(?resume_store);
    if (keys.destroy_private(?resume_key) != contracts.OK) { ret 59; }
    ret 0;
}

# every engine call below first finds the pool empty. a call that must wait
# changes nothing, and after a wake its retry proceeds
var pressure:       pool.Harness;
var squeezed:       pool.Squeeze;
var pressure_waits: usize;
var pressure_fault: i64;

fun hog() {
    squeezed.harness = ?pressure;
    pool.squeeze(?squeezed);
}

fun unhog() {
    pool.relax(?squeezed);
}

rec Marks {
    state:      u8;
    input_len:  usize;
    input_read: usize;
    hello_len:  usize;
    output:     usize;
    queue:      usize;
    active:     bool;
    failure:    error.Error;
}

fun server_marks(value: *Handshake) Marks {
    ret Marks{state: value.state, input_len: value.input_len,
        input_read: value.input_read, hello_len: value.hello_len,
        output:     value.output_used, queue: value.queue_len,
        active:     value.event_active, failure: value.failure};
}

fun client_marks(value: *client.Handshake) Marks {
    ret Marks{state: value.state, input_len: value.input_len,
        input_read: value.input_read, hello_len: value.hello_len,
        output:     value.output_len, queue: value.leftover::usize,
        active:     value.event_active, failure: value.failure};
}

fun marks_equal(first: Marks, second: Marks) bool {
    ret first.state == second.state && first.input_len == second.input_len &&
        first.input_read == second.input_read && first.hello_len == second.hello_len &&
        first.output == second.output && first.queue == second.queue &&
        first.active == second.active && first.failure == second.failure;
}

# one pressured call: kind 0 start, 1 ingest, 2 poll
fun pressed_server(local: *Handshake, kind: u8, level: engine.Level, data: *u8,
    length: usize, now: clock.Moment) engine.Result {
    hog();
    val before:  Marks = server_marks(local);
    var outcome: engine.Result;
    var round:   usize = 0;
    for (round < 2) {
        if (kind == 0)                        { outcome = start(local, now); }
        or (kind == 1)                        { outcome = ingest(local, level, data, length); }
        or                                    { outcome = poll(local); }
        if (outcome.status != engine.WAITING) { brk; }
        pressure_waits = pressure_waits + 1;
        if (round != 0 || outcome.consumed != 0 ||
            !marks_equal(before, server_marks(local))) { pressure_fault = 1; }
        unhog();
        round = round + 1;
    }
    if (outcome.status == engine.WAITING) { pressure_fault = 2; }
    unhog();
    ret outcome;
}

fun pressed_client(peer: *client.Handshake, kind: u8, level: engine.Level, data: *u8,
    length: usize, now: clock.Moment) engine.Result {
    hog();
    val before:  Marks = client_marks(peer);
    var outcome: engine.Result;
    var round:   usize = 0;
    for (round < 2) {
        if (kind == 0)                        { outcome = client.start(peer, now); }
        or (kind == 1)                        { outcome = client.ingest(peer, level, data, length); }
        or                                    { outcome = client.poll(peer); }
        if (outcome.status != engine.WAITING) { brk; }
        pressure_waits = pressure_waits + 1;
        if (round != 0 || outcome.consumed != 0 ||
            !marks_equal(before, client_marks(peer))) { pressure_fault = 3; }
        unhog();
        round = round + 1;
    }
    if (outcome.status == engine.WAITING) { pressure_fault = 4; }
    unhog();
    ret outcome;
}

fun pressed_exchange(local: *Handshake, peer: *client.Handshake) i64 {
    var rounds: usize = 0;
    for (rounds < 64) {
        var progressed: bool = false;
        var event:      engine.Event;
        for (next_event(local, ?event)) {
            progressed = true;
            if (event.kind == engine.CRYPTO &&
                pressed_client(peer, 1, event.level, event.data.data,
                event.data.len, clock.at(0, 0)).status == engine.FAILED) { ret 100; }
            if (!complete_event(local, event.token, true)) { ret 101; }
        }
        var peer_event: engine.Event;
        for (client.next_event(peer, ?peer_event)) {
            progressed = true;
            if (peer_event.kind == engine.CRYPTO &&
                pressed_server(local, 1, peer_event.level, peer_event.data.data,
                peer_event.data.len, clock.at(0, 0)).status == engine.FAILED) { ret 102; }
            if (!client.complete_event(peer, peer_event.token, true)) { ret 103; }
        }
        if (!progressed && snapshot(local).status == engine.COMPLETE &&
            client.snapshot(peer).status == engine.COMPLETE) { ret 0; }
        if (!progressed) {
            pressed_server(local, 2, 0, nil, 0, clock.at(0, 0));
            pressed_client(peer, 2, 0, nil, 0, clock.at(0, 0));
            if (!pending(local) && !client.snapshot(peer).output_pending) {
                ret 104;
            }
        }
        rounds = rounds + 1;
    }
    ret 105;
}

fun copy_secret_bytes(from: *key_schedule.Secret, output: *u8) {
    val view: contracts.SecretBytes = key_schedule.bytes(from);
    var i:    usize                 = 0;
    for (i < view.len && i < 64) {
        output[i] = view.data[i]:>u8;
        i         = i + 1;
    }
}

test "memory: a handshake that waits for memory matches one that never did" {
    var owner: secret.Allocator = secret.system_allocator();
    if (!resume_configure(session.REPLAY_PERMISSIVE, 0, ?owner, clock.at(1800000000, 1800000000))) {
        ret 1;
    }
    var listener_engine: Handshake;
    var dialer_engine:   client.Handshake;
    val server_counter:  u8 = resume_server_counter;
    val client_counter:  u8 = resume_client_counter;
    if (resume_connect(?listener_engine, ?dialer_engine, clock.at(1800000000, 1800000000)) != 0) { ret 2; }
    var calm: [128]u8;
    copy_secret_bytes(?listener_engine.core.send, ?calm[0]);
    copy_secret_bytes(?listener_engine.core.receive, ?calm[64]);
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 3; }

    resume_server_counter = server_counter;
    resume_client_counter = client_counter;
    if (!pool.make(?pressure, 1 << 18, 1 << 22)) { ret 4; }
    val memory: buffer.Lease = pool.lease(?pressure);
    var extra:  ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    var client_extra: client.ExtraExtension;
    client_extra.kind      = 0;
    client_extra.data.data = nil;
    client_extra.data.len  = 0;
    if (!init(?listener_engine, ?resume_listener, memory, extra, 0) ||
        !client.init(?dialer_engine, ?resume_dialer, memory, client_extra, 0)) { ret 5; }
    if (pressed_server(?listener_engine, 0, 0, nil, 0, clock.at(1800000000, 1800000000)).status != engine.OK ||
        pressed_client(?dialer_engine, 0, 0, nil, 0, clock.at(1800000000, 1800000000)).status != engine.OK) {
        ret 6;
    }
    val exchanged: i64 = pressed_exchange(?listener_engine, ?dialer_engine);
    if (exchanged != 0)      { ret 10 + exchanged::i32; }
    if (pressure_fault != 0) { ret 200 + pressure_fault::i32; }
    if (pressure_waits < 4)  { ret 7; }
    var pressed: [128]u8;
    copy_secret_bytes(?listener_engine.core.send, ?pressed[0]);
    copy_secret_bytes(?listener_engine.core.receive, ?pressed[64]);
    var i: usize = 0;
    for (i < 128) {
        if (calm[i] != pressed[i]) { ret 8; }
        i = i + 1;
    }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine) ||
        pool.held(?pressure) != 0 || !pool.destroy(?pressure)) { ret 9; }

    var retired: *credentials.Generation = nil;
    credentials.retire_store(?resume_store_credentials, ?retired);
    session.keyring_destroy(?resume_ring);
    session.replay_destroy(?resume_window);
    session.client_store_destroy(?resume_store);
    if (keys.destroy_private(?resume_key) != contracts.OK) { ret 10; }
    ret 0;
}

fun pump_cores(local: *established.Established,
    peer: *established.Established) i64 {
    var rounds: usize = 0;
    for (rounds < 16) {
        var progressed: bool = false;
        var event:      engine.Event;
        for (established.next_event(local, ?event)) {
            progressed = true;
            if (event.kind == engine.CRYPTO && established.ingest(peer, event.level,
                event.data.data, event.data.len).status == engine.FAILED) { ret 1; }
            if (!established.complete_event(local, event.token, true)) { ret 2; }
        }
        for (established.next_event(peer, ?event)) {
            progressed = true;
            if (event.kind == engine.CRYPTO && established.ingest(local, event.level,
                event.data.data, event.data.len).status == engine.FAILED) { ret 3; }
            if (!established.complete_event(peer, event.token, true)) { ret 4; }
        }
        if (!progressed) { ret 0; }
        rounds = rounds + 1;
    }
    ret 5;
}

fun cores_match(server_core: *established.Established,
    client_core: *established.Established) bool {
    val sent:     contracts.SecretBytes = key_schedule.bytes(?server_core.send);
    val received: contracts.SecretBytes = key_schedule.bytes(?client_core.receive);
    if (sent.len == 0 || sent.len != received.len) { ret false; }
    var i: usize = 0;
    for (i < sent.len) {
        if (sent.data[i]:>u8 != received.data[i]:>u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "resume: the offered identity carries the ticket's obfuscated age" {
    var owner: secret.Allocator = secret.system_allocator();
    if (!resume_configure(session.REPLAY_PERMISSIVE, 1, ?owner, clock.at(1800000000, 5000))) {
        ret 1;
    }
    var listener_engine: Handshake;
    var dialer_engine:   client.Handshake;
    if (resume_connect(?listener_engine, ?dialer_engine,
        clock.at(1800000000, 5000)) != 0 ||
        pump_post(?listener_engine, ?dialer_engine) != 0) { ret 2; }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 3; }
    if (session.client_store_count(?resume_store) != 1)                { ret 4; }

    # the wall clock jumped ten minutes while the monotonic clock moved 3s
    val later: clock.Moment = clock.at(1800000000 + 600, 5003);
    var kept:  session.Ticket;
    if (!session.client_store_take(?resume_store,
        contracts.Bytes{data: "api.example.com"::*u8, len: 15}, later.monotonic,
        ?kept) || kept.age_milliseconds != 3000) { ret 5; }
    val expected: u32 = (3000::u64 + kept.age_add::u64)::u32;
    kept.valid = true;
    if (!session.client_store_save(?resume_store, ?kept)) { ret 6; }

    val server_storage: buffer.Lease = pool.shared();
    var extra:          ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    var client_extra: client.ExtraExtension;
    client_extra.kind      = 0;
    client_extra.data.data = nil;
    client_extra.data.len  = 0;
    if (!init(?listener_engine, ?resume_listener, server_storage, extra, 0) ||
        start(?listener_engine, later).status != engine.OK ||
        !client.init(?dialer_engine, ?resume_dialer, pool.shared(), client_extra, 0) ||
        client.start(?dialer_engine, later).status != engine.OK) { ret 7; }
    var event: engine.Event;
    if (!client.next_event(?dialer_engine, ?event) || event.kind != engine.CRYPTO ||
        ingest(?listener_engine, event.level, event.data.data,
        event.data.len).status == engine.FAILED) { ret 8; }
    var hello: codec.ClientHello;
    var psk:   extensions.Extension;
    if (decode_retained_hello(?listener_engine, ?hello) != error.OK ||
        !extensions.find(hello.extensions, extensions.PRE_SHARED_KEY, ?psk)) { ret 9; }
    var identity: contracts.Bytes;
    var age:      u32 = 0;
    if (!psk_identity_at(psk, 0, ?identity, ?age) || age != expected) { ret 10; }
    if (!client.complete_event(?dialer_engine, event.token, true) ||
        exchange(?listener_engine, ?dialer_engine) != 0 ||
        !snapshot(?listener_engine).resumed) { ret 11; }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 13; }

    session.ticket_destroy(?kept);
    var retired: *credentials.Generation = nil;
    credentials.retire_store(?resume_store_credentials, ?retired);
    session.keyring_destroy(?resume_ring);
    session.replay_destroy(?resume_window);
    session.client_store_destroy(?resume_store);
    if (keys.destroy_private(?resume_key) != contracts.OK) { ret 12; }
    ret 0;
}

test "finish: established cores carry the connection and the handshakes are reused" {
    var owner: secret.Allocator = secret.system_allocator();
    if (!resume_configure(session.REPLAY_PERMISSIVE, 1, ?owner, clock.at(1800000000, 1800000000))) {
        ret 1;
    }
    var listener_engine: Handshake;
    var dialer_engine:   client.Handshake;
    val connected:       i64 = resume_connect(?listener_engine, ?dialer_engine,
        clock.at(1800000000, 1800000000));
    if (connected != 0) { ret 10 + connected::i32; }
    # the handshake still reports the peer's name before finish
    val before: engine.Snapshot = snapshot(?listener_engine);
    if (before.peer_name.len != 15 || before.selected_alpn.len != 2) { ret 2; }

    # a key update in flight on the handshake refuses finish until accepted
    var server_core: established.Established = established.empty();
    var client_core: established.Established = established.empty();
    if (request_key_update(?listener_engine, codec.UPDATE_REQUESTED).status !=
        engine.OK) { ret 3; }
    var event: engine.Event;
    if (!next_event(?listener_engine, ?event) || event.kind != engine.CRYPTO) { ret 4; }
    if (finish(?listener_engine, ?server_core) !=
        contracts.INVALID_STATE || server_core.state != established.EMPTY) { ret 5; }
    if (client.ingest(?dialer_engine, event.level, event.data.data,
        event.data.len).status == engine.FAILED ||
        !complete_event(?listener_engine, event.token, true)) { ret 6; }
    # the queued secret event moves with the core
    if (finish(?listener_engine, ?server_core) !=
        contracts.OK) { ret 7; }
    if (listener_engine.state != DESTROYED || listener_engine.delegating ||
        listener_engine.core.state != established.EMPTY) { ret 8; }
    if (client.finish(?dialer_engine, ?client_core) != contracts.OK) {
        ret 9;
    }
    val pumped: i64 = pump_cores(?server_core, ?client_core);
    if (pumped != 0) { ret 20 + pumped::i32; }
    # the client answered the requested update, so both directions moved on
    if (!cores_match(?server_core, ?client_core) ||
        !cores_match(?client_core, ?server_core)) { ret 11; }
    if (established.request_key_update(?client_core,
        codec.UPDATE_NOT_REQUESTED).status != engine.OK ||
        pump_cores(?client_core, ?server_core) != 0 ||
        !cores_match(?client_core, ?server_core)) { ret 12; }

    # after finish a server reports no peer name, and the alpn stays borrowed
    val after: engine.Snapshot = established.snapshot(?server_core);
    if (after.status != engine.COMPLETE || after.peer_name.len != 0 ||
        after.selected_alpn.len != 2 || after.selected_alpn.data[0] != 'h') {
        ret 13;
    }
    if (established.snapshot(?client_core).peer_name.len != 15) { ret 14; }
    if (established.close(?server_core, record.CLOSE_NOTIFY).status != engine.OK ||
        pump_cores(?server_core, ?client_core) != 0) { ret 15; }

    # the released handshakes carry a second connection
    val again: i64 = resume_connect(?listener_engine, ?dialer_engine, clock.at(1800000100, 1800000100));
    if (again != 0) { ret 30 + again::i32; }
    if (!established.destroy(?server_core) || !established.destroy(?client_core) ||
        server_core.send.active || client_core.resumption.active) { ret 16; }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 17; }

    var retired: *credentials.Generation = nil;
    credentials.retire_store(?resume_store_credentials, ?retired);
    session.keyring_destroy(?resume_ring);
    session.replay_destroy(?resume_window);
    session.client_store_destroy(?resume_store);
    if (keys.destroy_private(?resume_key) != contracts.OK) { ret 18; }
    ret 0;
}

test "limits: input grows for a long chain and an oversized entry is refused" {
    var owner: secret.Allocator = secret.system_allocator();
    if (!resume_configure(session.REPLAY_PERMISSIVE, 0, ?owner, clock.at(1800000000, 1800000000))) {
        ret 1;
    }
    var listener_engine: Handshake;
    var dialer_engine:   client.Handshake;
    # the default chain limit costs nothing until a chain arrives
    resume_dialer.limits.max_chain_bytes = config.production_limits().max_chain_bytes;
    if (resume_connect(?listener_engine, ?dialer_engine, clock.at(1800000000, 1800000000)) != 0) { ret 2; }
    if (dialer_engine.buffers.input.chunk.bytes > 4096 ||
        !destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 3; }
    # an entry above its own limit fails the handshake even inside the chain limit
    resume_dialer.limits.max_chain_bytes       = 12288;
    resume_dialer.limits.max_certificate_bytes = 64;
    if (resume_connect(?listener_engine, ?dialer_engine, clock.at(1800000000, 1800000000)) == 0) { ret 4; }
    if (client.snapshot(?dialer_engine).error != error.BAD_CERTIFICATE)                          { ret 5; }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine))                           { ret 6; }
    resume_dialer.limits.max_certificate_bytes = 16384;
    val served: i64 = resume_connect(?listener_engine, ?dialer_engine, clock.at(1800000000, 1800000000));
    if (served != 0)                                                   { ret 10 + served::i32; }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 7; }

    var retired: *credentials.Generation = nil;
    credentials.retire_store(?resume_store_credentials, ?retired);
    session.keyring_destroy(?resume_ring);
    session.replay_destroy(?resume_window);
    session.client_store_destroy(?resume_store);
    if (keys.destroy_private(?resume_key) != contracts.OK) { ret 8; }
    ret 0;
}

test "session: replay control, rotation overlap, and long sessions hold" {
    var owner: secret.Allocator = secret.system_allocator();
    if (!resume_configure(session.REPLAY_SINGLE_USE, 1, ?owner, clock.at(1800000000, 1800000000))) {
        ret 1;
    }
    var listener_engine: Handshake;
    var dialer_engine:   client.Handshake;
    if (resume_connect(?listener_engine, ?dialer_engine, clock.at(1800000000, 1800000000)) != 0) {
        ret 2;
    }
    if (pump_post(?listener_engine, ?dialer_engine) != 0) { ret 3; }
    if (session.client_store_count(?resume_store) != 1)   { ret 4; }

    # one long session survives repeated rekeying in both directions
    var rounds: usize = 0;
    for (rounds < 32) {
        if (request_key_update(?listener_engine,
            codec.UPDATE_NOT_REQUESTED).status != engine.OK ||
            pump_post(?listener_engine, ?dialer_engine) != 0 ||
            !secrets_match(?listener_engine, ?dialer_engine, true)) { ret 5; }
        if (client.request_key_update(?dialer_engine,
            codec.UPDATE_NOT_REQUESTED).status != engine.OK ||
            pump_post(?listener_engine, ?dialer_engine) != 0 ||
            !secrets_match(?listener_engine, ?dialer_engine, false)) { ret 6; }
        rounds = rounds + 1;
    }
    if (!destroy(?listener_engine) || !client.destroy(?dialer_engine)) { ret 7; }

    # keep a copy of the ticket so the same one can be presented twice
    var kept: session.Ticket;
    if (!session.client_store_take(?resume_store,
        contracts.Bytes{data: "api.example.com"::*u8, len: 15},
        clock.at(1800000000, 1800000000).monotonic, ?kept)) { ret 8; }
    var offered: session.Ticket = kept;
    offered.valid = true;
    if (!session.client_store_save(?resume_store, ?offered)) { ret 9; }

    var second_listener: Handshake;
    var second_dialer:   client.Handshake;
    if (resume_connect(?second_listener, ?second_dialer, clock.at(1800000100, 1800000100)) != 0) {
        ret 10;
    }
    if (!snapshot(?second_listener).resumed) { ret 11; }
    if (!destroy(?second_listener) || !client.destroy(?second_dialer)) {
        ret 12;
    }

    # presenting the very same ticket again is refused and falls back
    offered       = kept;
    offered.valid = true;
    if (!session.client_store_save(?resume_store, ?offered)) { ret 13; }
    var third_listener: Handshake;
    var third_dialer:   client.Handshake;
    if (resume_connect(?third_listener, ?third_dialer, clock.at(1800000200, 1800000200)) != 0) {
        ret 14;
    }
    if (snapshot(?third_listener).resumed ||
        client.snapshot(?third_dialer).resumed) { ret 15; }
    if (snapshot(?third_listener).status != engine.COMPLETE ||
        client.snapshot(?third_dialer).status != engine.COMPLETE) { ret 16; }
    if (!client.snapshot(?third_dialer).authenticated)               { ret 17; }
    if (!destroy(?third_listener) || !client.destroy(?third_dialer)) { ret 18; }

    # a ticket sealed before rotation still resumes inside the overlap
    resume_listener.replay_policy = session.REPLAY_PERMISSIVE;
    if (!session.keyring_rotate(?resume_ring, ?resume_server_entropy,
        clock.at(1800000300, 1800000300))) { ret 19; }
    if (session.keyring_openable(?resume_ring, clock.at(1800000300, 1800000300).monotonic) != 2) { ret 20; }
    offered       = kept;
    offered.valid = true;
    if (!session.client_store_save(?resume_store, ?offered)) { ret 21; }
    var fourth_listener: Handshake;
    var fourth_dialer:   client.Handshake;
    if (resume_connect(?fourth_listener, ?fourth_dialer, clock.at(1800000400, 1800000400)) != 0) {
        ret 22;
    }
    if (!snapshot(?fourth_listener).resumed) { ret 23; }
    if (!destroy(?fourth_listener) || !client.destroy(?fourth_dialer)) {
        ret 24;
    }

    # past the overlap the retired key is gone and the ticket cannot resume
    offered       = kept;
    offered.valid = true;
    if (!session.client_store_save(?resume_store, ?offered)) { ret 25; }
    var fifth_listener: Handshake;
    var fifth_dialer:   client.Handshake;
    if (resume_connect(?fifth_listener, ?fifth_dialer, clock.at(1800002200, 1800002200)) != 0) {
        ret 26;
    }
    if (snapshot(?fifth_listener).resumed)                           { ret 27; }
    if (snapshot(?fifth_listener).status != engine.COMPLETE)         { ret 28; }
    if (!destroy(?fifth_listener) || !client.destroy(?fifth_dialer)) { ret 29; }

    var retired: *credentials.Generation = nil;
    credentials.retire_store(?resume_store_credentials, ?retired);
    session.ticket_destroy(?kept);
    session.ticket_destroy(?offered);
    session.keyring_destroy(?resume_ring);
    session.replay_destroy(?resume_window);
    session.client_store_destroy(?resume_store);
    if (keys.destroy_private(?resume_key) != contracts.OK) { ret 30; }
    ret 0;
}

var mutation_case: [validation.MAX_CORPUS]u8;

# every outcome of one mutated hello must be a complete, bounded state
fun feed_mutation(listener: *config.ServerConfig, length: usize) i64 {
    val storage: buffer.Lease = pool.shared();
    var extra:   ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    var value: Handshake;
    if (!init(?value, listener, storage, extra, 0) ||
        start(?value, clock.at(1800000000, 1800000000)).status != engine.OK) { ret 1; }
    val fed: engine.Result = ingest(?value, engine.INITIAL,
        ?mutation_case[0], length);
    var outcome: i64 = 0;
    if (fed.status == engine.FAILED) {
        if (value.queue_len != 1 ||
            value.queue[0].kind != engine.ALERT ||
            value.queue[0].alert == record.NO_ALERT) { outcome = 2; }
        if (outcome == 0 && ingest(?value, engine.INITIAL, ?mutation_case[0],
            length).status != engine.FAILED) { outcome = 3; }
        if (outcome == 0 && snapshot(?value).error == error.OK) { outcome = 4; }
    }
    or (fed.status == engine.OK) {
        if (!pending(?value)) { outcome = 5; }
        var index: usize = 0;
        for (index < value.queue_len) {
            val item: Pending = value.queue[index];
            if (item.kind == engine.CRYPTO &&
                (item.offset > 8192 || item.length > 8192 - item.offset ||
                item.length == 0)) { outcome = 6; }
            index = index + 1;
        }
        if (outcome == 0 && !codec.valid_cipher_suite(value.suite)) {
            outcome = 7;
        }
        if (outcome == 0 && snapshot(?value).status == engine.COMPLETE) {
            outcome = 8;
        }
    }
    or (fed.status == engine.MORE) {
        if (pending(?value)) { outcome = 9; }
    }
    or { outcome = 10; }
    destroy(?value);
    ret outcome;
}

test "validation: mutated client hellos leave the server in a bounded state" {
    var owner:         secret.Allocator = secret.system_allocator();
    var chain_storage: [1]cert.Certificate;
    var key:           keys.PrivateKey;
    var identity:      credentials.Identity;
    if (!load_test_credentials(?identity, ?chain_storage[0], ?key, ?owner)) {
        ret 1;
    }
    var generation: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK) { ret 2; }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        ret 3;
    }
    var counter: u8             = 17;
    var entropy: secret.Entropy = secret.Entropy{context: ?counter,
        secret_context: nil, fill_fn: test_entropy, initialized: true};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{
        tls13.ED25519
    };
    var listener: config.ServerConfig;
    corpus_listener(?listener, ?store, ?protocols[0], ?versions[0], ?suites[0],
        ?groups[0], ?signatures[0], ?entropy);
    listener.limits.max_peer_handshake_bytes = 8192;
    listener.limits.max_client_hello_bytes   = 8192;

    var extension_len: usize = extension_server_name(0);
    extension_len = extension_supported_versions(extension_len, true);
    extension_len = extension_groups(extension_len, tls13.X25519, false);
    extension_len = extension_signatures(extension_len);
    extension_len = extension_alpn(extension_len, "h2"::*u8, 2);
    extension_len = extension_key_share(extension_len, tls13.X25519, 32);
    val length: usize = assemble_hello(tls13.LEGACY_VERSION,
        tls13.AES_128_GCM_SHA256, 1, 0, extension_len);
    if (length == 0 || length > validation.MAX_CORPUS) { ret 4; }

    var state:     u64   = 0xfeedfacecafe;
    var accepted:  usize = 0;
    var refused:   usize = 0;
    var iteration: usize = 0;
    for (iteration < 384) {
        var i: usize = 0;
        for (i < length) {
            mutation_case[i] = corpus_hello[i];
            i                = i + 1;
        }
        var mutated: usize = length;
        var rounds:  usize = 1;
        var applied: usize = 0;
        for (applied < rounds) {
            mutated = validation.mutate(?state, ?mutation_case[0], mutated,
                validation.MAX_CORPUS);
            applied = applied + 1;
        }
        val outcome: i64 = feed_mutation(?listener, mutated);
        if (outcome != 0) { ret 10 + outcome::i32; }
        iteration = iteration + 1;
    }
    var retired: *credentials.Generation = nil;
    if (credentials.retire_store(?store, ?retired) != contracts.OK) { ret 5; }
    if (keys.destroy_private(?key) != contracts.OK)                 { ret 6; }
    ret 0;
}

test "server: an ALPN-aware selector sees only complete offered protocol names" {
    var offered: [12]u8 = [12]u8{2, 'h', '2', 8, 'h', 't', 't', 'p', '/', '1',
        '.', '1'};
    val request: CredentialOffer = CredentialOffer{server_name: contracts.Bytes{
        data: "site.example"::*u8, len: 12
    }, offered_alpn: contracts.Bytes{
        data: ?offered[0], len: 12
    }};
    if (!offered_alpn_contains(request, contracts.Bytes{data: "h2"::*u8,
        len:  2}) || !offered_alpn_contains(request, contracts.Bytes{
        data: "http/1.1"::*u8, len: 8
    })) { ret 1; }
    if (offered_alpn_contains(request, contracts.Bytes{data: "acme-tls/1"::*u8,
        len: 10})) { ret 2; }
    offered[3] = 9;
    if (offered_alpn_contains(request, contracts.Bytes{data: "http/1.1"::*u8,
        len: 8})) { ret 3; }
    ret 0;
}

test "server: an exact ALPN offer contains only its single protocol" {
    var single: [11]u8 = [11]u8{
        10, 'a', 'c', 'm', 'e', '-', 't', 'l', 's', '/', '1'
    };
    var offer: CredentialOffer = CredentialOffer{
        server_name:  contracts.Bytes{data: nil, len: 0},
        offered_alpn: contracts.Bytes{data: ?single[0], len: 11}
    };
    val challenge: contracts.Bytes = contracts.Bytes{
        data: "acme-tls/1"::*u8, len: 10
    };
    if (!offered_alpn_exactly(offer, challenge)) { ret 1; }
    var mixed: [14]u8 = [14]u8{
        10, 'a', 'c', 'm', 'e', '-', 't', 'l', 's', '/', '1', 2, 'h', '2'
    };
    offer.offered_alpn = contracts.Bytes{data: ?mixed[0], len: 14};
    if (!offered_alpn_contains(offer, challenge) ||
        offered_alpn_exactly(offer, challenge)) { ret 2; }
    var duplicate: [22]u8 = [22]u8{
        10, 'a', 'c', 'm', 'e', '-', 't', 'l', 's', '/', '1',
        10, 'a', 'c', 'm', 'e', '-', 't', 'l', 's', '/', '1'
    };
    offer.offered_alpn = contracts.Bytes{data: ?duplicate[0], len: 22};
    if (offered_alpn_exactly(offer, challenge)) { ret 3; }
    ret 0;
}

fun test_challenge_store_selector(store: *credentials.Store, offer: CredentialOffer,
    output: *credentials.Lease) contracts.Error {
    if (store == nil || !offered_alpn_exactly(offer,
        contracts.Bytes{data: "acme-tls/1"::*u8, len: 10})) {
        ret contracts.UNSUPPORTED;
    }
    ret credentials.acquire(store, offer.server_name, output);
}

test "server: transient selector leases its store before retirement" {
    var owner:         secret.Allocator = secret.system_allocator();
    var chain_storage: [1]cert.Certificate;
    var key:           keys.PrivateKey;
    var identity:      credentials.Identity;
    if (!load_test_credentials(?identity, ?chain_storage[0], ?key, ?owner)) {
        ret 1;
    }
    var generation: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK) { ret 2; }
    var challenge_store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?challenge_store, ?generation) != contracts.OK) {
        ret 3;
    }
    var alpn:  [11]u8          = [11]u8{10, 'a', 'c', 'm', 'e', '-', 't', 'l', 's', '/', '1'};
    val offer: CredentialOffer = CredentialOffer{server_name: contracts.Bytes{
        data: "api.example.com"::*u8, len: 15
    }, offered_alpn: contracts.Bytes{
        data: ?alpn[0], len: 11
    }};
    var lease: credentials.Lease = credentials.empty_lease();
    if (test_challenge_store_selector(?challenge_store, offer, ?lease) !=
        contracts.OK || lease.generation != ?generation ||
        lease.identity != ?identity) { ret 4; }
    var retired: *credentials.Generation = nil;
    if (credentials.retire_store(?challenge_store, ?retired) != contracts.OK ||
        retired != ?generation || credentials.reclaimable(retired) ||
        credentials.clear(retired) != contracts.INVALID_STATE) { ret 5; }
    if (credentials.release(?lease) != contracts.OK ||
        !credentials.reclaimable(retired) ||
        credentials.clear(retired) != contracts.OK) { ret 6; }
    var refused: credentials.Lease = credentials.empty_lease();
    if (test_challenge_store_selector(?challenge_store, offer, ?refused) !=
        contracts.INVALID_STATE || keys.destroy_private(?key) != contracts.OK) {
        ret 7;
    }
    ret 0;
}
