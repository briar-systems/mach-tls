# bounded tls 1.3 session ticket storage contracts

use crypto.contracts;
use std.types.size.usize;

pub rec Ticket {
    identity:        contracts.Bytes;
    secret:          contracts.SecretBytes;
    issued_at_ns:    u64;
    lifetime_seconds: u32;
    age_add:         u32;
    max_early_data:  u32;
}

pub rec Store {
    context: ptr;
    load_fn: LoadFun;
    save_fn: SaveFun;
    remove_fn: RemoveFun;
}

pub def LoadFun:   fun(ptr, contracts.Bytes, *Ticket) u8;
pub def SaveFun:   fun(ptr, *Ticket) u8;
pub def RemoveFun: fun(ptr, contracts.Bytes) u8;

pub val DEFAULT_MAX_TICKETS: usize = 8;

test "session: default client ticket retention is bounded" {
    if (DEFAULT_MAX_TICKETS == 0 || DEFAULT_MAX_TICKETS > 64) { ret 1; }
    ret 0;
}
