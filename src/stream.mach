# completion-driven tls 1.3 secure stream
#
# a stream carries one read and one write at once, each in its own lane. the
# handshake, a full close and a caller alert need both lanes free and run in the
# write lane. a half close and a key update need only the write lane.
#
# one lane at a time owns wire_out, from preparing a record until its last byte
# is sent, so records never interleave. the engine's events are taken in order
# by whichever lane finds them, and a record an event owes is sent by that lane
# once wire_out is free; a lane that finds wire_out owned by the other parks
# until the other releases it.
#
# a lane short of memory parks until `resume`. while both lanes are parked for
# memory only the lane holding the turn may reserve, and the turn passes to the
# other lane once its holder acquires; it starts with the write lane, whose
# record gives its memory back once sent. a lane parked for the other lane is
# not a contender for memory and never holds up one that is.
#
# a lane that fails the stream leaves the other lane's lower action in flight.
# that action's transfer is still accounted when it completes, and the lane then
# resolves with the error that failed the stream. a failed stream must be closed:
# `close` on a failed stream is abortive and is allowed while the other lane is
# outstanding, and the lower abort is what ends that lane's action.

use crypto.contracts;
use std.crypto.ct;
use std.io.runtime;
use std.memory.buffers;
use std.sync.atomic;
use std.sync.cancel;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.buffer;
use tls.cert;
use tls.cert.credentials;
use tls.cert.x509;
use tls.client;
use tls.config;
use tls.engine;
use tls.error;
use tls.memory_range;
use tls.record;
use tls.server;
use tls.test.pool;
use tls12_connection:  tls.tls12.connection;
use tls12_established: tls.tls12.established;
use tls.tls13;
use tls.tls13.established;
use tls.tls13.key_schedule;
use tls.transition;
use tls.transport;

pub def State: u8;
pub val NEW:         State = 1;
pub val HANDSHAKING: State = 2;
pub val OPEN:        State = 3;
pub val CLOSING:     State = 4;
pub val CLOSED:      State = 5;
pub val FAILED:      State = 6;
pub val DESTROYED:   State = 7;

# a read with nothing buffered asks for this much; a record header then says
# how much its record needs
pub val READ_START: usize = 512;

pub def Control: u8;
val CONTROL_NONE:       Control = 0;
val CONTROL_ALERT:      Control = 1;
val CONTROL_HALF_CLOSE: Control = 2;
val CONTROL_CLOSE:      Control = 3;
val CONTROL_ABORT:      Control = 4;

# why a lane's pending wait was submitted
pub def Park: u8;
pub val PARK_NONE:   Park = 0;
pub val PARK_MEMORY: Park = 1;
pub val PARK_PEER:   Park = 2;

# a lane, or none
pub def LaneId: u8;
pub val NO_LANE:    LaneId = 0;
pub val READ_LANE:  LaneId = 1;
pub val WRITE_LANE: LaneId = 2;

# one caller operation and the lower action it is waiting on
pub rec Lane {
    operation:      transport.Operation;
    pending_action: transport.ActionKind;
    park:           Park;
}

pub rec Snapshot {
    state:              State;
    read:               transport.Snapshot;
    write:              transport.Snapshot;
    handshake_complete: bool;
    send_closed:        bool;
    peer_closed:        bool;
    alert:              record.AlertDescription;
    failure:            error.Error;
}

# exactly one engine pointer is set; both are caller-owned and outlive the stream
pub rec Stream {
    # the stream's own validated copy of the caller's transport
    lower: transport.Provider;
    # the connection's lease on both sources, charging one account
    memory:  buffer.Lease;
    secrets: buffer.SecretLease;
    # ciphertext in and out, and the plaintext opened from or sealed into it
    wire_in:  buffer.Region;
    wire_out: buffer.Region;
    opened:   buffer.SecretRegion;
    sealing:  buffer.SecretRegion;
    # bytes a record header says the next read must hold
    wire_needed: usize;
    # a handshake message the engine could not take for want of memory, kept
    # in wire_in until it can
    holding:        bool;
    held_protected: bool;
    held_level:     engine.Level;
    held_offset:    usize;
    held_length:    usize;
    role:           engine.Role;
    client:         *client.Handshake;
    server:         *server.Handshake;
    legacy:         *tls12_connection.Handshake;
    # once the handshake operation is destroyed the engine is finished into
    # one of these and the handshake object is released to its owner
    finished: bool;
    core13:   established.Established;
    core12:   tls12_established.Established;
    reading:  Lane;
    writing:  Lane;
    # the lane that owns wire_out, the lane that may reserve memory while both
    # are parked for it, and whether this step freed what a parked peer awaits
    sender:             LaneId;
    turn:               LaneId;
    peer_released:      bool;
    failure:            error.Error;
    read_cipher:        record.Cipher;
    write_cipher:       record.Cipher;
    state:              State;
    control:            Control;
    wire_input_len:     usize;
    wire_input_read:    usize;
    wire_output_len:    usize;
    wire_output_sent:   usize;
    plaintext_len:      usize;
    plaintext_read:     usize;
    application_chunk:  usize;
    core_event:         engine.Event;
    core_event_sending: bool;
    # wire_out holds a record of the borrowed core event
    event_record:             bool;
    core_event_alert:         bool;
    core_event_offset:        usize;
    core_event_chunk:         usize;
    control_alert:            record.AlertDescription;
    control_record_sent:      bool;
    handshake_complete:       bool;
    send_closed:              bool;
    peer_closed:              bool;
    lower_eof:                bool;
    peer_alert:               record.AlertDescription;
    ccs_count:                usize;
    transition_owner:         i64;
    receive_record_plaintext: usize;
    send_record_plaintext:    usize;
}

fun stream_owner_data(stream: *Stream) *u8 {
    if (stream == nil) { ret nil; }
    val address: usize = (?stream.state)::usize;
    val offset:  usize = $offset_of(Stream, state);
    if (address < offset) { ret nil; }
    val data: *u8 = (address - offset)::*u8;
    if (!memory_range.valid(data, $size_of(Stream))) { ret nil; }
    ret data;
}

fun stream_owner_overlaps(stream: *Stream, data: *u8, len: usize) bool {
    val owner: *u8 = stream_owner_data(stream);
    ret owner == nil || !memory_range.valid(data, len) ||
        memory_range.overlap(owner, $size_of(Stream), data, len);
}

fun lane_id(stream: *Stream, lane: *Lane) LaneId {
    if (lane == ?stream.reading) { ret READ_LANE; }
    ret WRITE_LANE;
}

# the write lane holds the turn unless it names the read lane
fun holds_turn(stream: *Stream, lane: *Lane) bool {
    ret (stream.turn == READ_LANE) == (lane == ?stream.reading);
}

fun other(stream: *Stream, lane: *Lane) *Lane {
    if (lane == ?stream.reading) { ret ?stream.writing; }
    ret ?stream.reading;
}

fun lane_state(lane: *Lane) transport.OperationState {
    ret transport.snapshot(?lane.operation).state;
}

fun lane_available(lane: *Lane) bool {
    val state: transport.OperationState = lane_state(lane);
    ret state == 0 || state == transport.OPERATION_DESTROYED;
}

fun lane_terminal(lane: *Lane) bool {
    ret lane_state(lane) == transport.OPERATION_TERMINAL;
}

fun region_overlaps(region: buffer.Region, data: *u8, len: usize) bool {
    ret region.held && memory_range.overlap(data, len, region.chunk.data, region.chunk.bytes);
}

# whether data meets memory the stream holds or the records its lease names
fun buffers_overlap(stream: *Stream, data: *u8, len: usize) bool {
    ret !memory_range.valid(data, len) ||
        region_overlaps(stream.wire_in, data, len) ||
        region_overlaps(stream.wire_out, data, len) ||
        buffer.lease_overlaps(stream.memory, data, len) ||
        buffer.secret_lease_overlaps(stream.secrets, data, len);
}

# the wire bytes one record of this much plaintext can take, in either protocol
fun wire_bytes(record_plaintext: usize) usize {
    ret record.HEADER_SIZE + record.TLS12_AES_EXPLICIT_NONCE + record_plaintext + 1 +
        record.TAG_SIZE;
}

fun wire_limit(stream: *Stream) usize {
    ret record.HEADER_SIZE + stream.receive_record_plaintext + record.MAX_CIPHERTEXT_EXTRA;
}

# the largest record the peer may send now, which is smaller before it encrypts
fun record_limit(stream: *Stream) usize {
    if (stream.read_cipher.installed) { ret wire_limit(stream); }
    ret record.HEADER_SIZE + stream.receive_record_plaintext;
}

# one account backs both leases, and neither lease's records sit in the
# transport's state
fun leases_valid(memory: buffer.Lease, secrets: buffer.SecretLease,
    lower: *transport.Transport) bool {
    ret buffer.lease_valid(memory) && buffer.secret_lease_valid(secrets) &&
        memory.account == secrets.account && transport.valid(lower) &&
        !transport.state_overlaps(lower, memory.source::*u8, $size_of(buffers.Source)) &&
        !transport.state_overlaps(lower, memory.account::*u8, $size_of(buffers.Account));
}

fun engine_bound(stream: *Stream) bool {
    if (stream == nil)                { ret false; }
    if (stream.finished)              { ret true; }
    if (stream.role == engine.CLIENT) { ret stream.client != nil; }
    if (stream.role == engine.SERVER) { ret stream.server != nil; }
    if (engine.is_tls12(stream.role)) { ret stream.legacy != nil; }
    ret false;
}

fun engine_aliases_borrowed(stream: *Stream, data: *u8, len: usize) bool {
    if (!engine_bound(stream)) { ret true; }
    # a finished core borrows nothing a caller buffer could alias
    if (stream.finished) { ret false; }
    if (stream.role == engine.CLIENT) {
        ret client.aliases_borrowed(stream.client, data, len);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.aliases_borrowed(stream.legacy, data, len); }
    ret server.aliases_borrowed(stream.server, data, len);
}

fun engine_aliases_configuration(stream: *Stream, data: *u8, len: usize) bool {
    if (!engine_bound(stream)) { ret true; }
    if (stream.finished)       { ret false; }
    if (stream.role == engine.CLIENT) {
        ret client.aliases_configuration(stream.client, data, len);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.aliases_configuration(stream.legacy, data, len); }
    ret server.aliases_configuration(stream.server, data, len);
}

fun engine_start(stream: *Stream) engine.Result {
    if (!engine_bound(stream)) {
        ret engine.result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    if (stream.finished) { ret engine.result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0); }
    if (stream.role == engine.CLIENT) {
        ret client.start(stream.client);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.start(stream.legacy); }
    ret server.start(stream.server);
}

fun engine_ingest(stream: *Stream, level: engine.Level, data: *u8,
    length: usize) engine.Result {
    if (!engine_bound(stream)) {
        ret engine.result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    if (stream.finished && engine.is_tls12(stream.role)) {
        ret tls12_established.ingest(?stream.core12, level, data, length);
    }
    if (stream.finished) { ret established.ingest(?stream.core13, level, data, length); }
    if (stream.role == engine.CLIENT) {
        ret client.ingest(stream.client, level, data, length);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.ingest(stream.legacy, level, data, length); }
    ret server.ingest(stream.server, level, data, length);
}

fun engine_poll(stream: *Stream) engine.Result {
    if (!engine_bound(stream)) {
        ret engine.result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    if (stream.finished && engine.is_tls12(stream.role)) {
        ret tls12_established.poll(?stream.core12);
    }
    if (stream.finished)              { ret established.poll(?stream.core13); }
    if (stream.role == engine.CLIENT) { ret client.poll(stream.client); }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.poll(stream.legacy); }
    ret server.poll(stream.server);
}

fun engine_next_event(stream: *Stream, output: *engine.Event) bool {
    if (!engine_bound(stream)) { ret false; }
    if (stream.finished && engine.is_tls12(stream.role)) {
        ret tls12_established.next_event(?stream.core12, output);
    }
    if (stream.finished) { ret established.next_event(?stream.core13, output); }
    if (stream.role == engine.CLIENT) {
        ret client.next_event(stream.client, output);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.next_event(stream.legacy, output); }
    ret server.next_event(stream.server, output);
}

fun engine_complete_event(stream: *Stream, token: u64, accepted: bool) bool {
    if (!engine_bound(stream)) { ret false; }
    if (stream.finished && engine.is_tls12(stream.role)) {
        ret tls12_established.complete_event(?stream.core12, token, accepted);
    }
    if (stream.finished) { ret established.complete_event(?stream.core13, token, accepted); }
    if (stream.role == engine.CLIENT) {
        ret client.complete_event(stream.client, token, accepted);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.complete_event(stream.legacy, token, accepted); }
    ret server.complete_event(stream.server, token, accepted);
}

fun engine_traffic_keys(stream: *Stream, event: *engine.Event,
    key: contracts.SecretBuffer, iv: contracts.Buffer,
    key_length: *usize) bool {
    if (!engine_bound(stream))                           { ret false; }
    if (stream.finished && engine.is_tls12(stream.role)) { ret false; }
    if (stream.finished) {
        ret established.traffic_keys(?stream.core13, event, key, iv, key_length);
    }
    if (stream.role == engine.CLIENT) {
        ret client.traffic_keys(stream.client, event, key, iv, key_length);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.traffic_keys(stream.legacy, event, key, iv, key_length); }
    ret server.traffic_keys(stream.server, event, key, iv, key_length);
}

fun engine_request_key_update(stream: *Stream, request: u8) engine.Result {
    if (!engine_bound(stream)) {
        ret engine.result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    if (!stream.finished || engine.is_tls12(stream.role)) {
        ret engine.result(engine.FAILED, error.ILLEGAL_PARAMETER, 0, 0);
    }
    ret established.request_key_update(?stream.core13, request);
}

fun engine_snapshot(stream: *Stream) engine.Snapshot {
    if (!engine_bound(stream)) { ret engine.empty_snapshot(); }
    if (stream.finished && engine.is_tls12(stream.role)) {
        ret tls12_established.snapshot(?stream.core12);
    }
    if (stream.finished)              { ret established.snapshot(?stream.core13); }
    if (stream.role == engine.CLIENT) { ret client.snapshot(stream.client); }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.snapshot(stream.legacy); }
    ret server.snapshot(stream.server);
}

fun engine_receive_limit(stream: *Stream) usize {
    if (!engine_bound(stream)) { ret 0; }
    if (stream.finished && engine.is_tls12(stream.role)) {
        ret tls12_established.receive_record_limit(?stream.core12);
    }
    if (stream.finished) { ret established.receive_record_limit(?stream.core13); }
    if (stream.role == engine.CLIENT) {
        ret client.receive_record_limit(stream.client);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.receive_record_limit(stream.legacy); }
    ret server.receive_record_limit(stream.server);
}

fun engine_send_limit(stream: *Stream) usize {
    if (!engine_bound(stream)) { ret 0; }
    if (stream.finished && engine.is_tls12(stream.role)) {
        ret tls12_established.send_record_limit(?stream.core12);
    }
    if (stream.finished) { ret established.send_record_limit(?stream.core13); }
    if (stream.role == engine.CLIENT) {
        ret client.send_record_limit(stream.client);
    }
    if (engine.is_tls12(stream.role)) { ret tls12_connection.send_record_limit(stream.legacy); }
    ret server.send_record_limit(stream.server);
}

fun engine_event_active(stream: *Stream) bool {
    if (!engine_bound(stream)) { ret false; }
    ret engine_snapshot(stream).event_active;
}

fun engine_failure(stream: *Stream) error.Error {
    if (!engine_bound(stream)) { ret error.INTERNAL_ERROR; }
    ret engine_snapshot(stream).error;
}

fun externally_owned(stream: *Stream, data: *u8, len: usize) bool {
    if (stream_owner_data(stream) == nil || !memory_range.valid(data, len) ||
        stream_owner_overlaps(stream, data, len) ||
        buffers_overlap(stream, data, len)) { ret false; }
    ret !engine_aliases_borrowed(stream, data, len);
}

fun operation_inputs_valid(stream: *Stream, scope: *cancel.Scope,
    buffer: *u8, len: usize) bool {
    if (!externally_owned(stream, scope::*u8, $size_of(cancel.Scope)) ||
        !externally_owned(stream, buffer, len) ||
        transport.state_overlaps(?stream.lower.descriptor, scope::*u8,
        $size_of(cancel.Scope)) ||
        transport.state_overlaps(?stream.lower.descriptor, buffer, len)) { ret false; }
    ret !memory_range.overlap(scope::*u8, $size_of(cancel.Scope), buffer, len);
}

fun configuration_disjoint(stream: *Stream, lower: *transport.Transport) bool {
    ret !engine_aliases_configuration(stream, stream_owner_data(stream),
        $size_of(Stream)) &&
        !engine_aliases_borrowed(stream, lower::*u8,
        $size_of(transport.Transport)) &&
        !engine_aliases_borrowed(stream, lower.context::*u8,
        lower.context_size) &&
        !engine_aliases_borrowed(stream, lower.runtime::*u8,
        $size_of(runtime.Runtime));
}

fun algorithm(kind: record.Algorithm) record.Aead {
    if (kind == record.AES_128_GCM) { ret record.aes_128_gcm(); }
    if (kind == record.AES_256_GCM) { ret record.aes_256_gcm(); }
    ret record.chacha20_poly1305();
}

fun stream_protocol(stream: *Stream) record.Protocol {
    if (engine.is_tls12(stream.role)) { ret record.TLS12; }
    ret record.TLS13;
}

fun install_secret(stream: *Stream, event: *engine.Event) bool {
    var key:        [engine.MAX_TRAFFIC_KEY]^u8;
    var iv:         [engine.TRAFFIC_IV_SIZE]u8;
    var key_length: usize = 0;
    var iv_length:  usize = engine.TRAFFIC_IV_SIZE;
    if (stream_protocol(stream) == record.TLS12 &&
        (event.aead == record.AES_128_GCM ||
        event.aead == record.AES_256_GCM)) { iv_length = 4; }
    if (!engine_traffic_keys(stream, event,
        contracts.SecretBuffer{data: ?key[0],
        capacity: engine.MAX_TRAFFIC_KEY},
        contracts.Buffer{data: ?iv[0], capacity: engine.TRAFFIC_IV_SIZE},
        ?key_length) || key_length == 0 ||
        key_length > engine.MAX_TRAFFIC_KEY) {
        ct.zeroize(?key[0], engine.MAX_TRAFFIC_KEY);
        ret false;
    }
    var target: *record.Cipher = ?stream.read_cipher;
    if (event.direction == engine.SEND) { target = ?stream.write_cipher; }
    val installed: bool = record.install(target, stream_protocol(stream),
        algorithm(event.aead),
        contracts.SecretBytes{data: ?key[0], len: key_length},
        contracts.Bytes{data: ?iv[0], len: iv_length});
    ct.zeroize(?key[0], engine.MAX_TRAFFIC_KEY);
    var i: usize = 0;
    for (i < engine.TRAFFIC_IV_SIZE) {
        iv[i] = 0;
        i     = i + 1;
    }
    ret installed;
}

# the first failure is the one the other lane reports
fun fail_stream(stream: *Stream, failure: error.Error) {
    stream.state = FAILED;
    if (stream.failure == error.OK) {
        stream.failure = failure;
        if (failure == error.OK) { stream.failure = error.INTERNAL_ERROR; }
    }
}

# an operation ended between records leaves the stream intact; one ended with
# a record of its own partly unsent, or mid-handshake or mid-close, does not
fun terminal_requires_failure(stream: *Stream, lane: *Lane,
    snapshot: transport.Snapshot) bool {
    ret stream != nil && snapshot.state == transport.OPERATION_TERMINAL &&
        snapshot.terminal_error != error.OK &&
        ((stream.sender == lane_id(stream, lane) && stream.wire_output_len != 0) ||
        snapshot.kind == transport.HANDSHAKE ||
        snapshot.kind == transport.APPLICATION_CLOSE);
}

fun clear_core_event(stream: *Stream) {
    if (stream.core_event_sending) {
        engine_complete_event(stream, stream.core_event.token, false);
    }
    stream.core_event_sending = false;
    stream.event_record       = false;
    stream.core_event_alert   = false;
    stream.core_event_offset  = 0;
    stream.core_event_chunk   = 0;
}

fun settle_terminal(stream: *Stream, lane: *Lane) bool {
    val snapshot: transport.Snapshot = transport.snapshot(?lane.operation);
    if (snapshot.state != transport.OPERATION_TERMINAL) { ret false; }
    val owned: bool = stream.sender == lane_id(stream, lane);
    # an event this lane was sending cannot be finished by anyone once its
    # record is cut short; one it had not started stays for the other lane
    if ((owned && stream.event_record) || lane_available(other(stream, lane)) ||
        stream.failure != error.OK) {
        clear_core_event(stream);
    }
    if (terminal_requires_failure(stream, lane, snapshot)) {
        fail_stream(stream, snapshot.terminal_error);
    }
    if ((stream.control == CONTROL_CLOSE || stream.control == CONTROL_ABORT) &&
        (lane.pending_action == transport.TRANSPORT_CLOSE ||
        lane.pending_action == transport.TRANSPORT_ABORT) &&
        snapshot.terminal_error == error.OK) { stream.state = CLOSED; }
    if (owned) {
        stream.sender        = NO_LANE;
        stream.peer_released = true;
    }
    lane.pending_action = 0;
    lane.park           = PARK_NONE;
    release_idle(stream);
    ret true;
}

fun finish(stream: *Stream, lane: *Lane, failure: error.Error, end_of_stream: bool) bool {
    if (failure != error.OK && failure != error.CANCELLED &&
        failure != error.TIMEOUT) { fail_stream(stream, failure); }
    transport.finish(?lane.operation, failure, end_of_stream);
    ret settle_terminal(stream, lane);
}

fun submit(stream: *Stream, lane: *Lane, kind: transport.ActionKind, buffer: *u8,
    length: usize) bool {
    val action: transport.Action = transport.Action{kind: kind, buffer: buffer,
        length: length, context: lane.operation.context};
    if (!transport.begin_action(?lane.operation, ?stream.lower, action)) {
        land_region(stream, kind);
        if (settle_terminal(stream, lane)) { ret true; }
        ret finish(stream, lane, error.INTERNAL_ERROR, false);
    }
    lane.pending_action = kind;
    ret true;
}

fun park(stream: *Stream, lane: *Lane, reason: Park) bool {
    if (!submit(stream, lane, transport.TRANSPORT_WAIT, nil, 0)) { ret false; }
    if (lane.pending_action == transport.TRANSPORT_WAIT)         { lane.park = reason; }
    ret true;
}

# a read or write that ended, or never started, gives its region back
fun land_region(stream: *Stream, kind: transport.ActionKind) {
    if (kind == transport.TRANSPORT_READ && stream.wire_in.flying) {
        buffer.land(stream.memory, ?stream.wire_in);
    }
    if (kind == transport.TRANSPORT_WRITE && stream.wire_out.flying) {
        buffer.land(stream.memory, ?stream.wire_out);
    }
}

# a refusal to wait parks the lane for memory, giving back a record region it
# reserved but could not fill; any other refusal fails it. either way the
# caller has nothing more to do this round
fun refused(stream: *Stream, lane: *Lane, outcome: buffer.Outcome) bool {
    if (outcome == buffer.WAIT) {
        if (stream.wire_output_len == 0 && !stream.wire_out.flying) {
            buffer.release(stream.memory, ?stream.wire_out, 0);
        }
        buffer.secret_release(stream.secrets, ?stream.sealing);
        ret park(stream, lane, PARK_MEMORY);
    }
    ret finish(stream, lane, error.RESOURCE_LIMIT, false);
}

fun compact_input(stream: *Stream) {
    if (stream.wire_input_read == 0) { ret; }
    if (stream.wire_input_read == stream.wire_input_len) {
        stream.wire_input_read = 0;
        stream.wire_input_len  = 0;
        ret;
    }
    val remaining: usize = stream.wire_input_len - stream.wire_input_read;
    var i:         usize = 0;
    for (i < remaining) {
        stream.wire_in.chunk.data[i] = stream.wire_in.chunk.data[stream.wire_input_read + i];
        i                            = i + 1;
    }
    stream.wire_input_read = 0;
    stream.wire_input_len  = remaining;
}

# memory the stream holds only while it is in use goes back between uses
fun release_idle(stream: *Stream) {
    if (!stream.wire_in.flying && !stream.holding &&
        stream.wire_input_read == stream.wire_input_len) {
        stream.wire_input_read = 0;
        stream.wire_input_len  = 0;
        buffer.release(stream.memory, ?stream.wire_in, 0);
    }
    if (!stream.wire_out.flying && stream.wire_output_len == 0) {
        buffer.release(stream.memory, ?stream.wire_out, 0);
    }
    if (stream.plaintext_len == 0) { buffer.secret_release(stream.secrets, ?stream.opened); }
    buffer.secret_release(stream.secrets, ?stream.sealing);
}

# seal or encode one record into wire_out for the lane. content never lives in
# the stream past this call
fun prepare_record(stream: *Stream, lane: *Lane, content_type: record.ContentType,
    content: contracts.Bytes) buffer.Outcome {
    if (content.len > record.MAX_PLAINTEXT ||
        (stream.write_cipher.installed && content.len > stream.send_record_plaintext) ||
        stream.wire_output_len != 0) {
        ret buffer.FAIL;
    }
    val out: buffer.Outcome = buffer.reserve(stream.memory, ?stream.wire_out,
        wire_bytes(content.len), 0);
    if (out != buffer.HELD) { ret out; }
    var sealed: record.Sealed;
    val wire:   contracts.Buffer = contracts.Buffer{data: stream.wire_out.chunk.data,
        capacity: stream.wire_out.chunk.bytes};
    if (!stream.write_cipher.installed) {
        sealed = record.encode_plain(content_type, stream_protocol(stream), content, wire);
    }
    or {
        val room: buffer.Outcome = buffer.secret_reserve(stream.secrets, ?stream.sealing,
            content.len * 2 + 1, 0);
        if (room != buffer.HELD) { ret room; }
        val scratch: *^u8  = ?stream.sealing.data[content.len];
        var i:       usize = 0;
        for (i < content.len) {
            stream.sealing.data[i] = content.data[i];
            i                      = i + 1;
        }
        sealed = record.seal(?stream.write_cipher, content_type,
            contracts.SecretBytes{data: stream.sealing.data, len: content.len}, 0,
            contracts.SecretBuffer{data: scratch, capacity: content.len + 1}, wire);
        buffer.secret_release(stream.secrets, ?stream.sealing);
    }
    if (sealed.error != error.OK) { ret buffer.FAIL; }
    stream.wire_output_len  = sealed.written;
    stream.wire_output_sent = 0;
    stream.sender           = lane_id(stream, lane);
    ret buffer.HELD;
}

fun prepare_application_record(stream: *Stream, lane: *Lane) buffer.Outcome {
    val snapshot: transport.Snapshot = transport.snapshot(?lane.operation);
    if (snapshot.application_bytes >= lane.operation.application_length) {
        ret buffer.FAIL;
    }
    var amount: usize = lane.operation.application_length - snapshot.application_bytes;
    if (amount > stream.send_record_plaintext) { amount = stream.send_record_plaintext; }
    val prepared: buffer.Outcome = prepare_record(stream, lane, record.APPLICATION_DATA,
        contracts.Bytes{data: ?lane.operation.application_buffer[snapshot.application_bytes],
        len: amount});
    if (prepared == buffer.HELD) { stream.application_chunk = amount; }
    ret prepared;
}

fun prepare_alert(stream: *Stream, lane: *Lane, description: record.AlertDescription) buffer.Outcome {
    var bytes: [2]u8;
    bytes[0] = record.FATAL;
    if (description == record.CLOSE_NOTIFY || description == record.USER_CANCELED_ALERT) {
        bytes[0] = record.WARNING;
    }
    bytes[1] = description;
    ret prepare_record(stream, lane, record.ALERT, contracts.Bytes{data: ?bytes[0], len: 2});
}

# the record the borrowed core event still owes, prepared once wire_out is free
fun prepare_core_record(stream: *Stream, lane: *Lane) buffer.Outcome {
    if (stream.core_event.kind == engine.ALERT) {
        ret prepare_alert(stream, lane, stream.core_event.alert);
    }
    if (stream.core_event.kind == engine.CHANGE_CIPHER_SPEC) {
        var marker: [1]u8;
        marker[0] = 1;
        ret prepare_record(stream, lane, record.CHANGE_CIPHER_SPEC,
            contracts.Bytes{data: ?marker[0], len: 1});
    }
    if (stream.core_event.kind != engine.CRYPTO ||
        stream.core_event_offset >= stream.core_event.data.len) { ret buffer.FAIL; }
    var amount: usize = stream.core_event.data.len - stream.core_event_offset;
    if (amount > stream.send_record_plaintext) { amount = stream.send_record_plaintext; }
    val prepared: buffer.Outcome = prepare_record(stream, lane, record.HANDSHAKE,
        contracts.Bytes{data: ?stream.core_event.data.data[stream.core_event_offset],
        len: amount});
    if (prepared == buffer.HELD) { stream.core_event_chunk = amount; }
    ret prepared;
}

# a borrowed event with nothing prepared yet. true when the step settled the
# round: a record is ready and sent, the lane parked, or it failed
fun owe_core_record(stream: *Stream, lane: *Lane) bool {
    if (!stream.core_event_sending) { ret false; }
    if (stream.wire_output_len != 0) {
        if (stream.sender == lane_id(stream, lane)) { ret false; }
        ret park(stream, lane, PARK_PEER);
    }
    # nothing is sent after close_notify: a key update owed then is dropped,
    # and an alert owed then only fails the stream
    if (stream.send_closed && stream.handshake_complete) {
        val alert_event: bool = stream.core_event_alert;
        stream.core_event_sending = false;
        stream.core_event_alert   = false;
        stream.core_event_offset  = 0;
        engine_complete_event(stream, stream.core_event.token, !alert_event);
        stream.peer_released = true;
        if (alert_event) { ret finish(stream, lane, engine_failure(stream), false); }
        ret false;
    }
    val prepared: buffer.Outcome = prepare_core_record(stream, lane);
    if (prepared == buffer.HELD) {
        stream.event_record = true;
        ret false;
    }
    if (prepared == buffer.WAIT) { ret refused(stream, lane, prepared); }
    engine_complete_event(stream, stream.core_event.token, false);
    stream.core_event_sending = false;
    stream.core_event_alert   = false;
    ret finish(stream, lane, error.INTERNAL_ERROR, false);
}

fun handle_core_event(stream: *Stream, lane: *Lane) bool {
    var event: engine.Event;
    if (stream.core_event_sending || !engine_next_event(stream, ?event)) { ret false; }
    stream.send_record_plaintext = engine_send_limit(stream);
    if (event.kind == engine.CRYPTO || event.kind == engine.ALERT ||
        event.kind == engine.CHANGE_CIPHER_SPEC) {
        # the record is prepared on the next step, which may have to wait
        stream.core_event         = event;
        stream.core_event_sending = true;
        stream.core_event_alert   = event.kind == engine.ALERT;
        stream.core_event_offset  = 0;
        stream.core_event_chunk   = 0;
        ret true;
    }
    if (event.kind == engine.TRAFFIC_SECRET && !install_secret(stream, ?event)) {
        engine_complete_event(stream, event.token, false);
        finish(stream, lane, error.INTERNAL_ERROR, false);
        ret true;
    }
    if (event.kind == engine.HANDSHAKE_COMPLETE) {
        stream.handshake_complete = true;
        stream.state              = OPEN;
    }
    engine_complete_event(stream, event.token, true);
    stream.peer_released = true;
    ret true;
}

fun handle_alert(stream: *Stream, lane: *Lane, data: *u8, length: usize) bool {
    var alert: record.AlertMessage;
    if (record.decode_alert(stream_protocol(stream), data, length,
        ?alert) != error.OK) {
        finish(stream, lane, error.DECODE_ERROR, false);
        ret true;
    }
    stream.peer_alert = alert.description;
    if (alert.description == record.CLOSE_NOTIFY) {
        if (!stream.handshake_complete) {
            finish(stream, lane, error.UNEXPECTED_MESSAGE, false);
            ret true;
        }
        stream.peer_closed = true;
        finish(stream, lane, error.OK, true);
    }
    or (alert.fatal) {
        finish(stream, lane, error.ALERT_RECEIVED, false);
    }
    ret true;
}

fun consume_plaintext(stream: *Stream, lane: *Lane) bool {
    if (stream.plaintext_read >= stream.plaintext_len) { ret false; }
    val snapshot: transport.Snapshot = transport.snapshot(?lane.operation);
    if (lane.operation.kind != transport.APPLICATION_READ) { ret false; }
    val available: usize = stream.plaintext_len - stream.plaintext_read;
    val remaining: usize = lane.operation.application_length - snapshot.application_bytes;
    var amount:    usize = available;
    if (amount > remaining) { amount = remaining; }
    var i: usize = 0;
    for (i < amount) {
        lane.operation.application_buffer[snapshot.application_bytes + i] =
            stream.opened.data[stream.plaintext_read + i]:>u8;
        i = i + 1;
    }
    if (!transport.advance(?lane.operation, amount)) {
        finish(stream, lane, error.INTERNAL_ERROR, false);
        ret true;
    }
    stream.plaintext_read = stream.plaintext_read + amount;
    if (stream.plaintext_read == stream.plaintext_len) {
        stream.plaintext_read = 0;
        stream.plaintext_len  = 0;
        buffer.secret_release(stream.secrets, ?stream.opened);
    }
    if (transport.snapshot(?lane.operation).application_bytes ==
        lane.operation.application_length || amount != 0) {
        finish(stream, lane, error.OK, false);
    }
    ret true;
}

# hand a handshake message to the engine. when the engine must wait for memory
# the message stays where it is and the lane parks; it is offered again before
# anything else
fun offer_handshake(stream: *Stream, lane: *Lane) bool {
    val data:     *u8           = ?stream.wire_in.chunk.data[stream.held_offset];
    val progress: engine.Result = engine_ingest(stream, stream.held_level, data,
        stream.held_length);
    if (progress.status == engine.WAITING) {
        ret park(stream, lane, PARK_MEMORY);
    }
    if (stream.held_protected) {
        var i: usize = 0;
        for (i < stream.held_length) {
            data[i] = 0;
            i       = i + 1;
        }
    }
    stream.holding     = false;
    stream.held_length = 0;
    if (progress.status == engine.FAILED) {
        if (!handle_core_event(stream, lane)) { finish(stream, lane, progress.error, false); }
    }
    ret true;
}

# a record that needs more bytes than wire_in can hold grows it, up to the
# largest record the peer may send
fun needs_input(stream: *Stream, lane: *Lane, required: usize) bool {
    if (required > record_limit(stream)) {
        finish(stream, lane, error.RECORD_OVERFLOW, false);
        ret true;
    }
    stream.wire_needed = required;
    ret false;
}

fun process_record(stream: *Stream, lane: *Lane) bool {
    if (stream.holding)                                  { ret offer_handshake(stream, lane); }
    if (stream.wire_input_read >= stream.wire_input_len) { ret false; }
    val start:     usize = stream.wire_input_read;
    val input:     *u8   = ?stream.wire_in.chunk.data[start];
    val available: usize = stream.wire_input_len - start;
    if (stream.read_cipher.installed && !stream.handshake_complete && available >= 1 &&
        input[0] == record.CHANGE_CIPHER_SPEC) {
        val compatibility: record.Parsed = record.inspect(input, available,
            stream_protocol(stream), false);
        if (compatibility.status == record.PARSE_MORE) {
            ret needs_input(stream, lane, compatibility.required);
        }
        if (compatibility.status != record.PARSE_READY ||
            compatibility.frame.length != 1 || compatibility.frame.fragment[0] != 1 ||
            stream.ccs_count >= 8) {
            finish(stream, lane, error.UNEXPECTED_MESSAGE, false);
            ret true;
        }
        stream.ccs_count       = stream.ccs_count + 1;
        stream.wire_input_read = stream.wire_input_read + compatibility.frame.consumed;
        stream.wire_needed     = 0;
        ret true;
    }
    var content_type:   record.ContentType;
    var content:        *u8   = nil;
    var content_length: usize = 0;
    var consumed:       usize = 0;
    var protected:      bool  = false;
    if (!stream.read_cipher.installed) {
        val parsed: record.Parsed = record.inspect(input, available,
            stream_protocol(stream), false);
        if (parsed.status == record.PARSE_MORE) { ret needs_input(stream, lane, parsed.required); }
        if (parsed.status != record.PARSE_READY ||
            parsed.frame.length > stream.receive_record_plaintext) {
            if (parsed.status == record.PARSE_READY) {
                finish(stream, lane, error.RECORD_OVERFLOW, false);
                ret true;
            }
            finish(stream, lane, parsed.error, false);
            ret true;
        }
        content_type   = parsed.frame.header.content_type;
        content        = parsed.frame.fragment;
        content_length = parsed.frame.length;
        consumed       = parsed.frame.consumed;
    }
    or {
        protected = true;
        val bounded: record.Parsed = record.inspect(input, available,
            stream_protocol(stream), true);
        if (bounded.status == record.PARSE_MORE) { ret needs_input(stream, lane, bounded.required); }
        if (bounded.status != record.PARSE_READY ||
            bounded.frame.length > stream.receive_record_plaintext +
            record.MAX_CIPHERTEXT_EXTRA) {
            finish(stream, lane, error.RECORD_OVERFLOW, false);
            ret true;
        }
        # opening advances the cipher, so its plaintext room is held first
        val room: buffer.Outcome = buffer.secret_reserve(stream.secrets, ?stream.opened,
            bounded.frame.length, 0);
        if (room != buffer.HELD) { ret refused(stream, lane, room); }
        val opened: record.Opened = record.open(?stream.read_cipher, input, available,
            contracts.SecretBuffer{data: stream.opened.data,
            capacity: stream.opened.capacity});
        if (opened.status == record.PARSE_MORE) { ret needs_input(stream, lane, opened.required); }
        if (opened.status != record.PARSE_READY || opened.error != error.OK) {
            finish(stream, lane, opened.error, false);
            ret true;
        }
        content_type   = opened.content_type;
        content_length = opened.written;
        consumed       = opened.consumed;
        if (content_length > stream.receive_record_plaintext) {
            buffer.secret_release(stream.secrets, ?stream.opened);
            finish(stream, lane, error.RECORD_OVERFLOW, false);
            ret true;
        }
    }
    stream.wire_input_read = stream.wire_input_read + consumed;
    stream.wire_needed     = 0;
    if (content_type == record.CHANGE_CIPHER_SPEC) {
        if (protected || content_length != 1 || content[0] != 1) {
            finish(stream, lane, error.UNEXPECTED_MESSAGE, false);
        }
        ret true;
    }
    if (content_type == record.ALERT) {
        var alert_bytes: [2]u8;
        if (protected && content_length == 2) {
            alert_bytes[0] = stream.opened.data[0]:>u8;
            alert_bytes[1] = stream.opened.data[1]:>u8;
            content        = ?alert_bytes[0];
        }
        val handled: bool = handle_alert(stream, lane, content, content_length);
        if (protected) { buffer.secret_release(stream.secrets, ?stream.opened); }
        ret handled;
    }
    if (content_type == record.HANDSHAKE) {
        # a handshake message is revealed over its own consumed ciphertext, which
        # is always longer than the plaintext it carried
        if (protected) {
            var i: usize = 0;
            for (i < content_length) {
                input[i] = stream.opened.data[i]:>u8;
                i        = i + 1;
            }
            buffer.secret_release(stream.secrets, ?stream.opened);
            content = input;
        }
        var level: engine.Level = engine.INITIAL;
        if (protected)                 { level = engine.HANDSHAKE; }
        if (stream.handshake_complete) { level = engine.APPLICATION; }
        stream.holding        = true;
        stream.held_protected = protected;
        stream.held_level     = level;
        stream.held_offset    = content::usize - stream.wire_in.chunk.data::usize;
        stream.held_length    = content_length;
        ret offer_handshake(stream, lane);
    }
    if (content_type == record.APPLICATION_DATA && stream.handshake_complete &&
        lane.operation.kind == transport.APPLICATION_READ) {
        stream.plaintext_len  = content_length;
        stream.plaintext_read = 0;
        ret consume_plaintext(stream, lane);
    }
    if (protected) { buffer.secret_release(stream.secrets, ?stream.opened); }
    finish(stream, lane, error.UNEXPECTED_MESSAGE, false);
    ret true;
}

fun submit_read(stream: *Stream, lane: *Lane) bool {
    if (stream.lower_eof) {
        if (stream.peer_closed) { ret finish(stream, lane, error.OK, true); }
        ret finish(stream, lane, error.CLOSED, true);
    }
    val unread: usize = stream.wire_input_len - stream.wire_input_read;
    var target: usize = stream.wire_needed;
    if (target < READ_START)         { target = READ_START; }
    if (target > wire_limit(stream)) { target = wire_limit(stream); }
    # an empty buffer larger than a start goes back rather than idling large
    if (unread == 0 && stream.wire_in.chunk.bytes > target) {
        stream.wire_input_read = 0;
        stream.wire_input_len  = 0;
        buffer.release(stream.memory, ?stream.wire_in, 0);
    }
    if (stream.wire_in.chunk.bytes < target) {
        val grown: buffer.Outcome = buffer.reserve_from(stream.memory, ?stream.wire_in,
            target, stream.wire_input_read, unread);
        if (grown != buffer.HELD) { ret refused(stream, lane, grown); }
        stream.wire_input_read = 0;
        stream.wire_input_len  = unread;
    }
    compact_input(stream);
    if (stream.wire_input_len == stream.wire_in.chunk.bytes) {
        ret finish(stream, lane, error.RESOURCE_LIMIT, false);
    }
    if (!buffer.fly(stream.memory, ?stream.wire_in)) {
        ret finish(stream, lane, error.INTERNAL_ERROR, false);
    }
    ret submit(stream, lane, transport.TRANSPORT_READ,
        ?stream.wire_in.chunk.data[stream.wire_input_len],
        stream.wire_in.chunk.bytes - stream.wire_input_len);
}

fun submit_write(stream: *Stream, lane: *Lane) bool {
    if (!buffer.fly(stream.memory, ?stream.wire_out)) {
        ret finish(stream, lane, error.INTERNAL_ERROR, false);
    }
    ret submit(stream, lane, transport.TRANSPORT_WRITE,
        ?stream.wire_out.chunk.data[stream.wire_output_sent],
        stream.wire_output_len - stream.wire_output_sent);
}

# whether this lane has a record of its own left to send
fun sending(stream: *Stream, lane: *Lane) bool {
    ret stream.sender == lane_id(stream, lane) &&
        stream.wire_output_sent < stream.wire_output_len;
}

fun settled(stream: *Stream, lane: *Lane) bool {
    ret lane.pending_action != 0 || lane_terminal(lane);
}

# the handshake owns both directions: the other lane is idle throughout
fun drive_handshake(stream: *Stream, lane: *Lane) bool {
    for (true) {
        if (sending(stream, lane))         { ret submit_write(stream, lane); }
        if (owe_core_record(stream, lane)) { ret true; }
        if (stream.wire_output_len != 0)   { cnt; }
        var advanced: bool = false;
        if (stream.holding) {
            offer_handshake(stream, lane);
            if (settled(stream, lane)) { ret true; }
            advanced = true;
        }
        if (!advanced && handle_core_event(stream, lane)) {
            if (lane_terminal(lane)) { ret true; }
            if (stream.handshake_complete && !stream.core_event_sending) {
                ret finish(stream, lane, error.OK, false);
            }
            advanced = true;
        }
        if (!advanced) {
            val polled: engine.Result = engine_poll(stream);
            if (polled.status == engine.WAITING) {
                ret park(stream, lane, PARK_MEMORY);
            }
            if (polled.status == engine.FAILED) {
                if (handle_core_event(stream, lane)) { advanced = true; }
                or                                   { ret finish(stream, lane, polled.error, false); }
            }
        }
        if (!advanced && handle_core_event(stream, lane)) { advanced = true; }
        if (!advanced && process_record(stream, lane)) {
            if (settled(stream, lane)) { ret true; }
            advanced = true;
        }
        if (!advanced) { ret submit_read(stream, lane); }
    }
    ret false;
}

# a key update sends its flight and installs its secret, and never reads: a
# read may be outstanding in the other lane
fun drive_key_update(stream: *Stream, lane: *Lane) bool {
    for (true) {
        if (sending(stream, lane))            { ret submit_write(stream, lane); }
        if (owe_core_record(stream, lane))    { ret true; }
        if (sending(stream, lane))            { cnt; }
        if (stream.wire_output_len != 0)      { ret park(stream, lane, PARK_PEER); }
        if (!handle_core_event(stream, lane)) { ret finish(stream, lane, error.OK, false); }
        if (lane_terminal(lane))              { ret true; }
    }
    ret false;
}

# a write first sends whatever the engine owes, then its own records
fun drive_write(stream: *Stream, lane: *Lane) bool {
    for (true) {
        if (sending(stream, lane))         { ret submit_write(stream, lane); }
        if (owe_core_record(stream, lane)) { ret true; }
        if (sending(stream, lane))         { cnt; }
        if (stream.wire_output_len != 0)   { ret park(stream, lane, PARK_PEER); }
        if (handle_core_event(stream, lane)) {
            if (lane_terminal(lane)) { ret true; }
            cnt;
        }
        val snapshot: transport.Snapshot = transport.snapshot(?lane.operation);
        if (snapshot.application_bytes == lane.operation.application_length) {
            ret finish(stream, lane, error.OK, false);
        }
        val prepared: buffer.Outcome = prepare_application_record(stream, lane);
        if (prepared == buffer.WAIT) { ret refused(stream, lane, prepared); }
        if (prepared == buffer.FAIL) { ret finish(stream, lane, error.INTERNAL_ERROR, false); }
    }
    ret false;
}

# a read takes the engine's events as it meets them, sends what they owe when
# wire_out is free, and reads no further record while one is still owed
fun drive_read(stream: *Stream, lane: *Lane) bool {
    for (true) {
        if (sending(stream, lane))         { ret submit_write(stream, lane); }
        if (owe_core_record(stream, lane)) { ret true; }
        if (sending(stream, lane))         { cnt; }
        if (handle_core_event(stream, lane)) {
            if (lane_terminal(lane)) { ret true; }
            cnt;
        }
        if (consume_plaintext(stream, lane)) { ret true; }
        if (!process_record(stream, lane))   { ret submit_read(stream, lane); }
        if (settled(stream, lane))           { ret true; }
    }
    ret false;
}

fun drive_control(stream: *Stream, lane: *Lane) bool {
    if (stream.control == CONTROL_ABORT) {
        stream.state = CLOSING;
        ret submit(stream, lane, transport.TRANSPORT_ABORT, nil, 0);
    }
    # what the engine owes goes out before the alert that ends sending
    for (!stream.control_record_sent) {
        if (sending(stream, lane))         { ret submit_write(stream, lane); }
        if (owe_core_record(stream, lane)) { ret true; }
        if (sending(stream, lane))         { cnt; }
        if (stream.wire_output_len != 0)   { ret park(stream, lane, PARK_PEER); }
        if (handle_core_event(stream, lane)) {
            if (lane_terminal(lane)) { ret true; }
            cnt;
        }
        val prepared: buffer.Outcome = prepare_alert(stream, lane, stream.control_alert);
        if (prepared == buffer.WAIT) { ret refused(stream, lane, prepared); }
        if (prepared == buffer.FAIL) { ret finish(stream, lane, error.INTERNAL_ERROR, false); }
    }
    if (stream.control == CONTROL_ALERT) {
        if (stream.control_alert != record.USER_CANCELED_ALERT) {
            stream.send_closed = true;
            fail_stream(stream, error.CLOSED);
        }
        ret finish(stream, lane, error.OK, false);
    }
    stream.send_closed = true;
    if (stream.control == CONTROL_HALF_CLOSE) {
        ret submit(stream, lane, transport.TRANSPORT_SHUTDOWN, nil, 0);
    }
    stream.state = CLOSING;
    ret submit(stream, lane, transport.TRANSPORT_CLOSE, nil, 0);
}

fun drive(stream: *Stream, lane: *Lane) bool {
    if (stream == nil || lane_state(lane) != transport.OPERATION_OPEN) { ret false; }
    val kind: transport.ApplicationKind = lane.operation.kind;
    if (kind == transport.HANDSHAKE && stream.handshake_complete) {
        ret drive_key_update(stream, lane);
    }
    if (kind == transport.HANDSHAKE)         { ret drive_handshake(stream, lane); }
    if (kind == transport.APPLICATION_WRITE) { ret drive_write(stream, lane); }
    if (kind == transport.APPLICATION_READ)  { ret drive_read(stream, lane); }
    ret drive_control(stream, lane);
}

# a lane parked for the other is woken once this step freed what it waits on
fun wake_peer(stream: *Stream, lane: *Lane) {
    if (!stream.peer_released) { ret; }
    stream.peer_released = false;
    val waiting: *Lane = other(stream, lane);
    if (waiting.park == PARK_PEER) { transport.wake(?waiting.operation); }
}

# a failed stream ends the other lane too: a parked lane is woken to resolve,
# and a lane with a lower action in flight resolves when that action completes
fun wake_failed(stream: *Stream, lane: *Lane) {
    if (stream.failure == error.OK) { ret; }
    val waiting: *Lane = other(stream, lane);
    if (waiting.park != PARK_NONE) { transport.wake(?waiting.operation); }
}

fun drive_owned(stream: *Stream, lane: *Lane) bool {
    if (!settle_terminal(stream, lane)) {
        if (!drive(stream, lane)) {
            finish(stream, lane, error.INTERNAL_ERROR, false);
        }
        settle_terminal(stream, lane);
    }
    wake_peer(stream, lane);
    wake_failed(stream, lane);
    ret true;
}

fun enter(stream: *Stream) bool {
    if (stream_owner_data(stream) == nil) { ret false; }
    ret transition.enter(?stream.transition_owner);
}

fun leave(stream: *Stream, accepted: bool) bool {
    transition.leave(?stream.transition_owner);
    ret accepted;
}

# every operation after the handshake starts from a finished engine; a finish
# the handshake operation's destruction could not make yet is retried here
fun lane_ready(stream: *Stream, lane: *Lane) bool {
    if (stream == nil || !lane_available(lane)) { ret false; }
    finish_engine(stream);
    ret true;
}

# two live operations never share a token, so a token names one lane
fun token_free(stream: *Stream, lane: *Lane, token: transport.Token) bool {
    val peer: *Lane = other(stream, lane);
    if (lane_available(peer)) { ret true; }
    ret peer.operation.token.index != token.index ||
        peer.operation.token.generation != token.generation;
}

fun begin_lane(stream: *Stream, lane: *Lane, token: transport.Token,
    kind: transport.ApplicationKind, scope: *cancel.Scope, buffer: *u8,
    length: usize, context: usize) bool {
    if (!token_free(stream, lane, token) ||
        !transport.begin(?lane.operation, token, kind, scope, buffer, length,
        context)) { ret false; }
    lane.pending_action = 0;
    lane.park           = PARK_NONE;
    ret true;
}

fun init_inner(stream: *Stream, role: engine.Role,
    client_engine: *client.Handshake, server_engine: *server.Handshake,
    legacy_engine: *tls12_connection.Handshake, memory: buffer.Lease,
    secrets: buffer.SecretLease, lower: *transport.Transport) bool {
    if (stream_owner_data(stream) == nil ||
        (stream.state != 0 && stream.state != DESTROYED) ||
        !lane_available(?stream.reading) || !lane_available(?stream.writing) ||
        stream.read_cipher.installed || stream.write_cipher.installed ||
        (role != engine.CLIENT && role != engine.SERVER &&
        !engine.is_tls12(role)) ||
        (role == engine.CLIENT && (client_engine == nil ||
        server_engine != nil || legacy_engine != nil)) ||
        (role == engine.SERVER && (server_engine == nil ||
        client_engine != nil || legacy_engine != nil)) ||
        (engine.is_tls12(role) && (legacy_engine == nil ||
        client_engine != nil || server_engine != nil)) ||
        !leases_valid(memory, secrets, lower) ||
        buffer.lease_overlaps(memory, stream_owner_data(stream), $size_of(Stream)) ||
        buffer.secret_lease_overlaps(secrets, stream_owner_data(stream), $size_of(Stream)) ||
        transport.state_overlaps(lower, stream_owner_data(stream),
        $size_of(Stream))) { ret false; }
    stream.finished = false;
    stream.core13   = established.empty();
    stream.core12   = tls12_established.empty();
    stream.role     = role;
    stream.client   = client_engine;
    stream.server   = server_engine;
    stream.legacy   = legacy_engine;
    val ready: engine.Snapshot = engine_snapshot(stream);
    if (!engine_bound(stream) || ready.role != role || ready.destroyed ||
        ready.status != engine.MORE || ready.event_active ||
        ready.output_pending || !configuration_disjoint(stream, lower)) {
        stream.role   = 0;
        stream.client = nil;
        stream.server = nil;
        stream.legacy = nil;
        ret false;
    }
    stream.receive_record_plaintext = engine_receive_limit(stream);
    stream.send_record_plaintext    = engine_send_limit(stream);
    stream.lower.descriptor         = lower[0];
    if (stream.receive_record_plaintext == 0 || stream.send_record_plaintext == 0 ||
        stream.receive_record_plaintext > record.MAX_PLAINTEXT ||
        stream.send_record_plaintext > record.MAX_PLAINTEXT ||
        !transport.pin(?stream.lower, ?stream.lower.descriptor)) {
        stream.lower  = transport.no_provider();
        stream.role   = 0;
        stream.client = nil;
        stream.server = nil;
        stream.legacy = nil;
        ret false;
    }
    stream.memory                 = memory;
    stream.secrets                = secrets;
    stream.wire_in                = buffer.empty();
    stream.wire_out               = buffer.empty();
    stream.opened                 = buffer.secret_empty();
    stream.sealing                = buffer.secret_empty();
    stream.wire_needed            = 0;
    stream.holding                = false;
    stream.held_length            = 0;
    stream.state                  = NEW;
    stream.control                = CONTROL_NONE;
    stream.reading.pending_action = 0;
    stream.reading.park           = PARK_NONE;
    stream.writing.pending_action = 0;
    stream.writing.park           = PARK_NONE;
    stream.sender                 = NO_LANE;
    stream.turn                   = WRITE_LANE;
    stream.peer_released          = false;
    stream.failure                = error.OK;
    stream.wire_input_len         = 0;
    stream.wire_input_read        = 0;
    stream.wire_output_len        = 0;
    stream.wire_output_sent       = 0;
    stream.plaintext_len          = 0;
    stream.plaintext_read         = 0;
    stream.application_chunk      = 0;
    stream.core_event_sending     = false;
    stream.event_record           = false;
    stream.core_event_alert       = false;
    stream.core_event_offset      = 0;
    stream.core_event_chunk       = 0;
    stream.handshake_complete     = false;
    stream.send_closed            = false;
    stream.peer_closed            = false;
    stream.lower_eof              = false;
    stream.peer_alert             = record.NO_ALERT;
    stream.ccs_count              = 0;
    ret true;
}

# the caller initializes and owns the engine; the stream only borrows it
pub fun init_client(stream: *Stream, core: *client.Handshake, memory: buffer.Lease,
    secrets: buffer.SecretLease, lower: *transport.Transport) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, init_inner(stream, engine.CLIENT, core, nil, nil, memory, secrets,
        lower));
}

pub fun init_tls12_client(stream: *Stream,
    core: *tls12_connection.Handshake, memory: buffer.Lease,
    secrets: buffer.SecretLease, lower: *transport.Transport) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, init_inner(stream, engine.TLS12_CLIENT, nil, nil, core,
        memory, secrets, lower));
}

pub fun init_tls12_server(stream: *Stream,
    core: *tls12_connection.Handshake, memory: buffer.Lease,
    secrets: buffer.SecretLease, lower: *transport.Transport) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, init_inner(stream, engine.TLS12_SERVER, nil, nil, core,
        memory, secrets, lower));
}

pub fun init_server(stream: *Stream, core: *server.Handshake, memory: buffer.Lease,
    secrets: buffer.SecretLease, lower: *transport.Transport) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, init_inner(stream, engine.SERVER, nil, core, nil, memory, secrets,
        lower));
}

# the handshake runs in the write lane and needs the read lane free
fun handshake_inner(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    context: usize) bool {
    val lane: *Lane = ?stream.writing;
    if (stream == nil || stream.state != NEW || !lane_available(?stream.reading) ||
        !lane_ready(stream, lane) ||
        !operation_inputs_valid(stream, scope, nil, 0) ||
        !begin_lane(stream, lane, token, transport.HANDSHAKE, scope, nil, 0,
        context)) { ret false; }
    stream.state = HANDSHAKING;
    if (settle_terminal(stream, lane)) { ret true; }
    val started: engine.Result = engine_start(stream);
    if (started.status != engine.OK) {
        finish(stream, lane, started.error, false);
        ret true;
    }
    ret drive_owned(stream, lane);
}

pub fun handshake(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    context: usize) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, handshake_inner(stream, scope, token, context));
}

fun read_inner(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    buffer: *u8, length: usize, context: usize) bool {
    val lane: *Lane = ?stream.reading;
    if (stream == nil || stream.state != OPEN || stream.peer_closed ||
        !lane_ready(stream, lane) ||
        !operation_inputs_valid(stream, scope, buffer, length) ||
        !begin_lane(stream, lane, token, transport.APPLICATION_READ,
        scope, buffer, length, context)) { ret false; }
    if (settle_terminal(stream, lane)) { ret true; }
    if (length == 0) {
        finish(stream, lane, error.OK, false);
        ret true;
    }
    ret drive_owned(stream, lane);
}

pub fun read(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    buffer: *u8, length: usize, context: usize) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, read_inner(stream, scope, token, buffer, length, context));
}

fun write_inner(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    buffer: *u8, length: usize, context: usize) bool {
    val lane: *Lane = ?stream.writing;
    if (stream == nil || stream.state != OPEN || stream.send_closed ||
        !lane_ready(stream, lane) ||
        !operation_inputs_valid(stream, scope, buffer, length) ||
        !begin_lane(stream, lane, token, transport.APPLICATION_WRITE,
        scope, buffer, length, context)) { ret false; }
    if (settle_terminal(stream, lane)) { ret true; }
    if (length == 0) {
        finish(stream, lane, error.OK, false);
        ret true;
    }
    ret drive_owned(stream, lane);
}

pub fun write(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    buffer: *u8, length: usize, context: usize) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, write_inner(stream, scope, token, buffer, length, context));
}

# a half close needs only the write lane; a full close or an alert needs both
fun begin_control(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    control: Control, description: record.AlertDescription, context: usize) bool {
    val lane: *Lane = ?stream.writing;
    if (stream == nil || stream.state != OPEN || stream.send_closed ||
        (control != CONTROL_HALF_CLOSE && !lane_available(?stream.reading)) ||
        !lane_ready(stream, lane) ||
        !operation_inputs_valid(stream, scope, nil, 0) ||
        !begin_lane(stream, lane, token, transport.APPLICATION_CLOSE,
        scope, nil, 0, context)) { ret false; }
    stream.control             = control;
    stream.control_alert       = description;
    stream.control_record_sent = false;
    if (settle_terminal(stream, lane)) { ret true; }
    ret drive_owned(stream, lane);
}

pub fun alert(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    description: record.AlertDescription, context: usize) bool {
    if (!enter(stream)) { ret false; }
    if (description == record.CLOSE_NOTIFY || description == record.NO_ALERT) {
        ret leave(stream, false);
    }
    if (!record.valid_tls13_alert(description)) { ret leave(stream, false); }
    ret leave(stream, begin_control(stream, scope, token, CONTROL_ALERT,
        description, context));
}

pub fun half_close(stream: *Stream, scope: *cancel.Scope,
    token: transport.Token, context: usize) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, begin_control(stream, scope, token, CONTROL_HALF_CLOSE,
        record.CLOSE_NOTIFY, context));
}

# a failed stream is closed abortively, and that close is allowed while a read
# is outstanding: the lower abort is what ends it. any other close needs both
# lanes free
pub fun close(stream: *Stream, scope: *cancel.Scope, token: transport.Token,
    context: usize) bool {
    if (!enter(stream)) { ret false; }
    val lane: *Lane = ?stream.writing;
    if (stream != nil && stream.state == FAILED && lane_ready(stream, lane) &&
        operation_inputs_valid(stream, scope, nil, 0) &&
        begin_lane(stream, lane, token, transport.APPLICATION_CLOSE,
        scope, nil, 0, context)) {
        stream.control             = CONTROL_ABORT;
        stream.control_record_sent = true;
        if (settle_terminal(stream, lane)) { ret leave(stream, true); }
        ret leave(stream, drive_owned(stream, lane));
    }
    if (stream != nil && stream.state == OPEN && stream.send_closed &&
        lane_available(?stream.reading) && lane_ready(stream, lane) &&
        operation_inputs_valid(stream, scope, nil, 0) &&
        begin_lane(stream, lane, token, transport.APPLICATION_CLOSE,
        scope, nil, 0, context)) {
        stream.control             = CONTROL_CLOSE;
        stream.control_alert       = record.CLOSE_NOTIFY;
        stream.control_record_sent = true;
        if (settle_terminal(stream, lane)) { ret leave(stream, true); }
        ret leave(stream, drive_owned(stream, lane));
    }
    ret leave(stream, begin_control(stream, scope, token, CONTROL_CLOSE,
        record.CLOSE_NOTIFY, context));
}

fun key_update_inner(stream: *Stream, scope: *cancel.Scope,
    token: transport.Token, request: u8, context: usize) bool {
    val lane: *Lane = ?stream.writing;
    if (stream == nil || stream.state != OPEN || stream.send_closed ||
        !lane_ready(stream, lane) || stream.core_event_sending ||
        !operation_inputs_valid(stream, scope, nil, 0) ||
        !token_free(stream, lane, token) ||
        engine_request_key_update(stream, request).status != engine.OK ||
        !begin_lane(stream, lane, token, transport.HANDSHAKE, scope,
        nil, 0, context)) { ret false; }
    if (settle_terminal(stream, lane)) { ret true; }
    ret drive_owned(stream, lane);
}

# post-handshake rekeying runs in the write lane: one flight out, one secret
# transition, and the operation settles. a read may be outstanding
pub fun key_update(stream: *Stream, scope: *cancel.Scope,
    token: transport.Token, request: u8, context: usize) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, key_update_inner(stream, scope, token, request, context));
}

pub fun connect(stream: *Stream, core: *client.Handshake, memory: buffer.Lease,
    secrets: buffer.SecretLease, lower: *transport.Transport, scope: *cancel.Scope, token: transport.Token,
    context: usize) bool {
    if (!enter(stream)) { ret false; }
    if (!init_inner(stream, engine.CLIENT, core, nil, nil, memory, secrets, lower)) {
        ret leave(stream, false);
    }
    if (!handshake_inner(stream, scope, token, context)) {
        destroy_inner(stream);
        ret leave(stream, false);
    }
    ret leave(stream, true);
}

# a tls 1.2 connection is driven by the same operations as a tls 1.3 one
pub fun connect_tls12(stream: *Stream, core: *tls12_connection.Handshake,
    memory: buffer.Lease, secrets: buffer.SecretLease, lower: *transport.Transport,
    scope: *cancel.Scope,
    token: transport.Token, context: usize) bool {
    if (!enter(stream)) { ret false; }
    if (!init_inner(stream, engine.TLS12_CLIENT, nil, nil, core, memory, secrets,
        lower)) { ret leave(stream, false); }
    if (!handshake_inner(stream, scope, token, context)) {
        destroy_inner(stream);
        ret leave(stream, false);
    }
    ret leave(stream, true);
}

pub fun serve_tls12(stream: *Stream, core: *tls12_connection.Handshake,
    memory: buffer.Lease, secrets: buffer.SecretLease, lower: *transport.Transport,
    scope: *cancel.Scope,
    token: transport.Token, context: usize) bool {
    if (!enter(stream)) { ret false; }
    if (!init_inner(stream, engine.TLS12_SERVER, nil, nil, core, memory, secrets,
        lower)) { ret leave(stream, false); }
    if (!handshake_inner(stream, scope, token, context)) {
        destroy_inner(stream);
        ret leave(stream, false);
    }
    ret leave(stream, true);
}

pub fun serve(stream: *Stream, core: *server.Handshake, memory: buffer.Lease,
    secrets: buffer.SecretLease, lower: *transport.Transport, scope: *cancel.Scope, token: transport.Token,
    context: usize) bool {
    if (!enter(stream)) { ret false; }
    if (!init_inner(stream, engine.SERVER, nil, core, nil, memory, secrets, lower)) {
        ret leave(stream, false);
    }
    if (!handshake_inner(stream, scope, token, context)) {
        destroy_inner(stream);
        ret leave(stream, false);
    }
    ret leave(stream, true);
}

pub fun negotiated(stream: *Stream) engine.Snapshot {
    if (!enter(stream)) { ret engine.empty_snapshot(); }
    val value: engine.Snapshot = engine_snapshot(stream);
    leave(stream, true);
    ret value;
}

# a record that went out in full settles: the event or application bytes it
# carried are done, and wire_out is free for either lane
fun record_written(stream: *Stream, lane: *Lane) {
    stream.wire_output_len  = 0;
    stream.wire_output_sent = 0;
    stream.sender           = NO_LANE;
    stream.peer_released    = true;
    if (stream.event_record) {
        stream.event_record = false;
        val alert_event: bool = stream.core_event_alert;
        if (stream.core_event.kind == engine.CRYPTO) {
            stream.core_event_offset = stream.core_event_offset + stream.core_event_chunk;
            stream.core_event_chunk  = 0;
        }
        # a crypto event with bytes left is prepared by the next drive
        if (stream.core_event.kind != engine.CRYPTO ||
            stream.core_event_offset >= stream.core_event.data.len) {
            stream.core_event_sending = false;
            stream.core_event_alert   = false;
            stream.core_event_offset  = 0;
            engine_complete_event(stream, stream.core_event.token, true);
            if (alert_event) { finish(stream, lane, engine_failure(stream), false); }
        }
        ret;
    }
    if (stream.application_chunk != 0) {
        transport.advance(?lane.operation, stream.application_chunk);
        stream.application_chunk = 0;
    }
    if (lane.operation.kind == transport.APPLICATION_CLOSE &&
        stream.control != CONTROL_NONE) {
        stream.control_record_sent = true;
    }
}

fun completion_lane(stream: *Stream, completion: *runtime.Completion) *Lane {
    if (transport.accept(?stream.reading.operation, completion)) { ret ?stream.reading; }
    if (transport.accept(?stream.writing.operation, completion)) { ret ?stream.writing; }
    ret nil;
}

fun accept_inner(stream: *Stream, completion: *runtime.Completion) bool {
    if (completion == nil ||
        !externally_owned(stream, completion::*u8,
        $size_of(runtime.Completion))) { ret false; }
    val lane: *Lane = completion_lane(stream, completion);
    if (lane == nil) { ret false; }
    val action: transport.ActionKind = lane.pending_action;
    val reason: Park                 = lane.park;
    land_region(stream, action);
    lane.park = PARK_NONE;
    val snapshot: transport.Snapshot = transport.snapshot(?lane.operation);
    val moved:    usize              = snapshot.last_transport_bytes;
    # the transfer a completion reports is real however the operation resolved:
    # a cancelled read's bytes are already in wire_in and a cancelled write's
    # already left. accounting for it before the terminal check keeps the
    # stream at the record position the peer sees
    if (action == transport.TRANSPORT_READ) {
        if (moved > stream.wire_in.chunk.bytes - stream.wire_input_len) {
            finish(stream, lane, error.INTERNAL_ERROR, false);
            wake_failed(stream, lane);
            ret true;
        }
        stream.wire_input_len = stream.wire_input_len + moved;
        if (snapshot.last_end_of_stream) { stream.lower_eof = true; }
    }
    or (action == transport.TRANSPORT_WRITE) {
        if (moved > stream.wire_output_len - stream.wire_output_sent) {
            finish(stream, lane, error.INTERNAL_ERROR, false);
            wake_failed(stream, lane);
            ret true;
        }
        stream.wire_output_sent = stream.wire_output_sent + moved;
        if (moved != 0 && stream.wire_output_sent == stream.wire_output_len) {
            record_written(stream, lane);
        }
    }
    if (settle_terminal(stream, lane)) {
        wake_peer(stream, lane);
        wake_failed(stream, lane);
        ret true;
    }
    lane.pending_action = 0;
    # a stream the other lane failed ends this one with the same error
    if (stream.failure != error.OK) {
        finish(stream, lane, stream.failure, false);
        ret true;
    }
    # a successful transfer must make progress
    if (action == transport.TRANSPORT_WRITE &&
        (moved == 0 || snapshot.last_end_of_stream)) {
        finish(stream, lane, error.INTERNAL_ERROR, false);
        wake_failed(stream, lane);
        ret true;
    }
    if (action == transport.TRANSPORT_READ && moved == 0) {
        if (!snapshot.last_end_of_stream) {
            finish(stream, lane, error.INTERNAL_ERROR, false);
            wake_failed(stream, lane);
            ret true;
        }
        if (stream.peer_closed) { finish(stream, lane, error.OK, true); }
        or                      { finish(stream, lane, error.CLOSED, true); }
        wake_peer(stream, lane);
        ret true;
    }
    # while both lanes are parked for memory only the turn's holder reserves
    val peer: *Lane = other(stream, lane);
    if (reason == PARK_MEMORY && peer.park == PARK_MEMORY && !holds_turn(stream, lane)) {
        park(stream, lane, PARK_MEMORY);
        ret true;
    }
    drive_owned(stream, lane);
    # the turn passes once its holder acquires, and a lane that stood aside for
    # it is woken to take its own
    if (reason == PARK_MEMORY && lane.park != PARK_MEMORY && holds_turn(stream, lane)) {
        stream.turn = lane_id(stream, peer);
        if (peer.park == PARK_MEMORY) { transport.wake(?peer.operation); }
    }
    ret true;
}

pub fun accept(stream: *Stream, completion: *runtime.Completion) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, accept_inner(stream, completion));
}

# retry the lanes parked for memory. the caller calls this when the pool reports
# the connection's account ready; the wake may have been for its own chunks, and
# a stream with nothing parked for memory ignores it. each retry arrives as a
# completion for accept, like cancellation and deadlines do
pub fun resume(stream: *Stream) bool {
    if (!enter(stream)) { ret false; }
    var woken: bool = false;
    if (stream.reading.park == PARK_MEMORY &&
        transport.wake(?stream.reading.operation)) { woken = true; }
    if (stream.writing.park == PARK_MEMORY &&
        transport.wake(?stream.writing.operation)) { woken = true; }
    ret leave(stream, woken);
}

pub fun snapshot(stream: *Stream) Snapshot {
    var value: Snapshot;
    if (!enter(stream)) { ret value; }
    value.state              = stream.state;
    value.read               = transport.snapshot(?stream.reading.operation);
    value.write              = transport.snapshot(?stream.writing.operation);
    value.handshake_complete = stream.handshake_complete;
    value.send_closed        = stream.send_closed;
    value.peer_closed        = stream.peer_closed;
    value.alert              = stream.peer_alert;
    value.failure            = stream.failure;
    leave(stream, true);
    ret value;
}

# a completed handshake is finished into the stream's own core, which drops
# every handshake-only byte and releases the handshake object to its owner
fun finish_engine(stream: *Stream) {
    if (stream.finished || !stream.handshake_complete || !engine_bound(stream)) { ret; }
    var finished: contracts.Error = contracts.INVALID_STATE;
    if (engine.is_tls12(stream.role)) {
        finished = tls12_connection.finish(stream.legacy, ?stream.core12);
    }
    or (stream.role == engine.CLIENT) {
        finished = client.finish(stream.client, ?stream.core13);
    }
    or {
        finished = server.finish(stream.server, ?stream.core13);
    }
    if (finished != contracts.OK) { ret; }
    stream.finished = true;
    stream.client   = nil;
    stream.server   = nil;
    stream.legacy   = nil;
}

fun token_lane(stream: *Stream, token: transport.Token) *Lane {
    if (!lane_available(?stream.reading) &&
        stream.reading.operation.token.index == token.index &&
        stream.reading.operation.token.generation == token.generation) {
        ret ?stream.reading;
    }
    if (!lane_available(?stream.writing) &&
        stream.writing.operation.token.index == token.index &&
        stream.writing.operation.token.generation == token.generation) {
        ret ?stream.writing;
    }
    ret nil;
}

fun destroy_operation_inner(stream: *Stream, token: transport.Token) bool {
    val lane: *Lane = token_lane(stream, token);
    if (lane == nil || !lane_terminal(lane)) { ret false; }
    settle_terminal(stream, lane);
    if (!transport.destroy_operation(?lane.operation)) { ret false; }
    finish_engine(stream);
    ret true;
}

# release the terminal operation the token names
pub fun destroy_operation(stream: *Stream, token: transport.Token) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, destroy_operation_inner(stream, token));
}

fun destroy_lane(lane: *Lane) bool {
    val state: transport.OperationState = lane_state(lane);
    if (state == 0 || state == transport.OPERATION_DESTROYED) { ret true; }
    if (state != transport.OPERATION_TERMINAL)                { ret false; }
    if (!transport.destroy_operation(?lane.operation))        { ret false; }
    lane.pending_action = 0;
    lane.park           = PARK_NONE;
    ret true;
}

fun destroy_inner(stream: *Stream) bool {
    if (stream.state == DESTROYED || engine_event_active(stream)) { ret false; }
    val read_state:  transport.OperationState = lane_state(?stream.reading);
    val write_state: transport.OperationState = lane_state(?stream.writing);
    if ((read_state != 0 && read_state != transport.OPERATION_TERMINAL &&
        read_state != transport.OPERATION_DESTROYED) ||
        (write_state != 0 && write_state != transport.OPERATION_TERMINAL &&
        write_state != transport.OPERATION_DESTROYED)) { ret false; }
    if (!destroy_lane(?stream.reading) || !destroy_lane(?stream.writing)) { ret false; }
    stream.holding = false;
    if (!buffer.release(stream.memory, ?stream.wire_in, stream.wire_input_len) ||
        !buffer.release(stream.memory, ?stream.wire_out, stream.wire_output_len) ||
        !buffer.secret_release(stream.secrets, ?stream.opened) ||
        !buffer.secret_release(stream.secrets, ?stream.sealing)) { ret false; }
    stream.wire_input_len   = 0;
    stream.wire_input_read  = 0;
    stream.wire_output_len  = 0;
    stream.wire_output_sent = 0;
    stream.plaintext_len    = 0;
    stream.plaintext_read   = 0;
    stream.sender           = NO_LANE;
    record.destroy(?stream.read_cipher);
    record.destroy(?stream.write_cipher);
    established.wipe(?stream.core13);
    tls12_established.wipe(?stream.core12);
    stream.finished = false;
    stream.role     = 0;
    stream.client   = nil;
    stream.server   = nil;
    stream.legacy   = nil;
    stream.lower    = transport.no_provider();
    stream.memory   = buffer.no_lease();
    stream.secrets  = buffer.no_secret_lease();
    stream.state    = DESTROYED;
    ret true;
}

pub fun destroy(stream: *Stream) bool {
    if (!enter(stream)) { ret false; }
    ret leave(stream, destroy_inner(stream));
}

# Mach refuses to erase a pointer that transitively reaches secret-welded
# storage, and the failure surfaces as a cast error far from the field that
# caused it. This pins the types that do erase, so a welded field added to any
# of them fails here rather than in a consumer.
#
# Eight public types deliberately cannot erase, because key material lives
# inline in them: client.Handshake, server.Handshake, Stream, config.ClientConfig,
# config.ServerConfig, credentials.Identity, engine.Event and
# tls12.connection.Connection. No consumer needs to erase one today, and
# mach-quic does not. If one ever must, that is the shape of laurel#27 and the
# fix is an opaque handle rather than relaxing the weld.
fun erase_transport(value: *transport.Transport) ptr {
    ret value::ptr;
}

fun erase_operation(value: *transport.Operation) ptr {
    ret value::ptr;
}

fun erase_limits(value: *config.Limits) ptr {
    ret value::ptr;
}

fun erase_trust_store(value: *cert.TrustStore) ptr {
    ret value::ptr;
}

fun erase_certificate(value: *cert.Certificate) ptr {
    ret value::ptr;
}

fun erase_leaf(value: *x509.Certificate) ptr {
    ret value::ptr;
}

test stream__the_unwelded_public_types_erase_to_the_untyped_ptr {
    if (erase_transport(nil) != nil
        || erase_operation(nil) != nil || erase_limits(nil) != nil) { ret 1; }
    if (erase_trust_store(nil) != nil || erase_certificate(nil) != nil
        || erase_leaf(nil) != nil) { ret 2; }
    ret 0;
}

test stream__an_unbound_or_uninitialized_engine_cannot_take_ownership {
    var stream:   Stream;
    var lower:    transport.Transport;
    var core:     client.Handshake;
    var listener: server.Handshake;
    val memory:   buffer.Lease       = pool.shared();
    val secrets:  buffer.SecretLease = pool.shared_secret();
    if (init_client(?stream, nil, memory, secrets, ?lower) ||
        init_server(?stream, nil, memory, secrets, ?lower)) { ret 1; }
    if (init_client(?stream, ?core, memory, secrets, ?lower))     { ret 2; }
    if (init_server(?stream, ?listener, memory, secrets, ?lower)) { ret 3; }
    if (engine_bound(?stream) || stream.role != 0)                { ret 4; }
    ret 0;
}

fun header_stream(stream: *Stream, length: usize) bool {
    stream.state                    = HANDSHAKING;
    stream.memory                   = pool.shared();
    stream.secrets                  = pool.shared_secret();
    stream.wire_in                  = buffer.empty();
    stream.receive_record_plaintext = 63;
    if (buffer.reserve(stream.memory, ?stream.wire_in, READ_START, 0) != buffer.HELD) {
        ret false;
    }
    stream.wire_input_len        = record.HEADER_SIZE;
    stream.wire_in.chunk.data[0] = record.HANDSHAKE;
    stream.wire_in.chunk.data[1] = 3;
    stream.wire_in.chunk.data[2] = 3;
    stream.wire_in.chunk.data[3] = (length >> 8)::u8;
    stream.wire_in.chunk.data[4] = length::u8;
    ret true;
}

test stream__a_record_header_sizes_the_next_read_within_the_record_limit {
    var stream: Stream;
    if (!header_stream(?stream, 60)) { ret 1; }
    if (process_record(?stream, ?stream.reading) || stream.wire_needed != record.HEADER_SIZE + 60 ||
        stream.state != HANDSHAKING) { ret 2; }
    ret 0;
}

test stream__an_incomplete_record_cannot_exceed_the_record_limit {
    var stream: Stream;
    if (!header_stream(?stream, 100)) { ret 1; }
    if (!process_record(?stream, ?stream.reading) || stream.state != FAILED ||
        transport.snapshot(?stream.reading.operation).state !=
        transport.OPERATION_TERMINAL ||
        transport.snapshot(?stream.reading.operation).terminal_error !=
        error.RECORD_OVERFLOW) { ret 2; }
    ret 0;
}

test stream__tls_1_3_user_canceled_warning_keeps_the_stream_open {
    var stream: Stream;
    stream.state              = OPEN;
    stream.handshake_complete = true;
    var alert: [2]u8 = [2]u8{record.WARNING,
        record.USER_CANCELED_ALERT};
    if (!handle_alert(?stream, ?stream.reading, ?alert[0], 2) || stream.state != OPEN ||
        stream.peer_closed || stream.peer_alert != record.USER_CANCELED_ALERT) {
        ret 1;
    }
    ret 0;
}
