    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_a, ?adapter) || !stream.half_close(?secure, ?scope,
        transport.Token{index: 12, generation: 1}, 47)) { ret 3; }
    if (transport_state.writes != 1 || transport_state.closes != 0) { ret 4; }
    var completion: io_runtime.Completion;
    if (!runtime_ok(io_runtime.complete(?runtime,
        live(?secure).lower_token, secure.wire_output_len, 0, false)) ||
        !take_one(?runtime, ?completion) || !stream.accept(?secure, ?completion)) { ret 5; }
    if (transport_state.closes != 1 || live_lane(?secure).pending_action != transport.TRANSPORT_SHUTDOWN ||
        !secure.send_closed) { ret 6; }
    if (!runtime_ok(io_runtime.complete(?runtime,
        live(?secure).lower_token, 0, 0, false)) || !take_one(?runtime, ?completion) ||
        !stream.accept(?secure, ?completion)) { ret 7; }
    if (transport.snapshot(live(?secure)).state != transport.OPERATION_TERMINAL ||
        secure.state != stream.OPEN || !secure.send_closed ||
        !settle(?secure) || !operation_ok(cancel.destroy(?scope))) { ret 8; }
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 11; }
    if (!stream.close(?secure, ?scope,
        transport.Token{index: 12, generation: 2}, 49)) { ret 13; }
    if (transport_state.writes != 1)                                    { ret 14; }
    if (transport_state.closes != 2)                                    { ret 15; }
    if (live_lane(?secure).pending_action != transport.TRANSPORT_CLOSE) { ret 16; }
    if (!runtime_ok(io_runtime.complete(?runtime,
        live(?secure).lower_token, 0, 0, false)) ||
        !take_one(?runtime, ?completion) ||
        !stream.accept(?secure, ?completion) || secure.state != stream.CLOSED ||
        !settle(?secure) || !stream.destroy(?secure) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 12; }
    ret 0;
}

test stream__encrypted_records_retain_read_ownership_at_every_byte_boundary {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 32)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_a, ?adapter)) { ret 3; }

    var key: [16]^u8;
    var iv:  [12]u8;
    var i:   usize = 0;
    for (i < 16) {
        key[i] = (i + 1)::u8;
        i      = i + 1;
    }
    i = 0;
    for (i < 12) {
        iv[i] = (0x80 + i)::u8;
        i     = i + 1;
    }
    var peer: record.Cipher;
    if (!record.install(?peer, record.TLS13, record.aes_128_gcm(),
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 4; }
    ct.zeroize(?key[0], 16);
    var clear:   [5]^u8        = [5]^u8{'w', 'o', 'r', 'l', 'd'};
    var scratch: [record.MAX_INNER_PLAINTEXT]^u8;
    var wire:    [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
    val sealed:  record.Sealed = record.seal(?peer, record.APPLICATION_DATA,
        contracts.SecretBytes{data: ?clear[0], len: 5}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: record.MAX_INNER_PLAINTEXT},
        contracts.Buffer{data: ?wire[0],
        capacity: record.HEADER_SIZE + record.MAX_CIPHERTEXT});
    ct.zeroize(?clear[0], 5);
    if (sealed.error != error.OK) { ret 5; }
    var application: [5]u8;
    if (!stream.read(?secure, ?scope,
        transport.Token{index: 13, generation: 1}, ?application[0], 5, 49)) {
        ret 6;
    }
    i = 0;
    for (i < sealed.written) {
        live(?secure).lower_buffer[0] = wire[i];
        if (!runtime_ok(io_runtime.complete(?runtime,
            live(?secure).lower_token, 1, 0,
            i + 1 == sealed.written))) { ret 7; }
        var completion: io_runtime.Completion;
        if (!take_one(?runtime, ?completion) || !stream.accept(?secure, ?completion)) {
            ret 8;
        }
        i = i + 1;
    }
    val finished: transport.Snapshot = transport.snapshot(live(?secure));
    record.destroy(?peer);
    if (finished.state != transport.OPERATION_TERMINAL) { ret 10; }
    if (finished.application_bytes != 5)                { ret 11; }
    if (application[0] != 'w' ||
        application[1] != 'o' || application[2] != 'r' || application[3] != 'l' ||
        application[4] != 'd') { ret 12; }
    if (!settle(?secure)) { ret 13; }
    var after_eof: [1]u8;
    if (!stream.read(?secure, ?scope,
        transport.Token{index: 14, generation: 2}, ?after_eof[0], 1, 50)) {
        ret 16;
    }
    val eof: transport.Snapshot = transport.snapshot(live(?secure));
    if (eof.state != transport.OPERATION_TERMINAL ||
        eof.terminal_error != error.CLOSED || secure.state != stream.FAILED ||
        !settle(?secure)) { ret 17; }
    if (!operation_ok(cancel.destroy(?scope))) { ret 14; }
    if (
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 15; }
    ret 0;
}

# a caller cancelling a read is saying it no longer wants to wait, not that the
# transport should throw away bytes it has already taken off the socket. if
# those bytes are dropped the stream is left mid-record and nothing decodes
# again.
test stream__cancelling_a_read_keeps_the_bytes_the_transport_already_settled {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 32)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_b, ?adapter)) { ret 3; }

    var key: [16]^u8;
    var iv:  [12]u8;
    var i:   usize = 0;
    for (i < 16) {
        key[i] = (i + 1)::u8;
        i      = i + 1;
    }
    i = 0;
    for (i < 12) {
        iv[i] = (0x80 + i)::u8;
        i     = i + 1;
    }
    var peer: record.Cipher;
    if (!record.install(?peer, record.TLS13, record.aes_128_gcm(),
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 4; }
    ct.zeroize(?key[0], 16);
    var clear:   [5]^u8        = [5]^u8{'h', 'e', 'l', 'l', 'o'};
    var scratch: [record.MAX_INNER_PLAINTEXT]^u8;
    var wire:    [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
    val sealed:  record.Sealed = record.seal(?peer, record.APPLICATION_DATA,
        contracts.SecretBytes{data: ?clear[0], len: 5}, 0,
        contracts.SecretBuffer{data: ?scratch[0],
        capacity: record.MAX_INNER_PLAINTEXT},
        contracts.Buffer{data: ?wire[0],
        capacity: record.HEADER_SIZE + record.MAX_CIPHERTEXT});
    ct.zeroize(?clear[0], 5);
    record.destroy(?peer);
    if (sealed.error != error.OK || sealed.written < 8) { ret 5; }

    # deliver part of the record, then cancel before it is complete
    var application: [5]u8;
    if (!stream.read(?secure, ?scope,
        transport.Token{index: 21, generation: 1}, ?application[0], 5, 61)) {
        ret 6;
    }
    val delivered: usize = 4;
    i = 0;
    for (i < delivered) {
        live(?secure).lower_buffer[i] = wire[i];
        i                             = i + 1;
    }
    if (!runtime_ok(io_runtime.complete(?runtime,
        live(?secure).lower_token, delivered, 0, false))) { ret 7; }
    if (!transition_ok(cancel.cancel(?scope))) { ret 8; }
    var completion: io_runtime.Completion;
    if (!take_one(?runtime, ?completion)
        || !stream.accept(?secure, ?completion)) { ret 9; }
    val cancelled: transport.Snapshot = transport.snapshot(live(?secure));
    if (cancelled.state != transport.OPERATION_TERMINAL
        || cancelled.terminal_error != error.CANCELLED
        || secure.state != stream.OPEN) { ret 10; }

    # the settled bytes must still be accounted for in the wire buffer
    if (secure.wire_input_len != delivered) { ret 11; }

    # and the record must still decode once the remainder arrives
    if (!settle(?secure)) { ret 12; }
    var resumed: cancel.Scope;
    if (!operation_ok(cancel.make_root(?resumed, opt[time.Instant].none{}))) {
        ret 13;
    }
    if (!stream.read(?secure, ?resumed,
        transport.Token{index: 22, generation: 2}, ?application[0], 5, 62)) {
        ret 14;
    }
    i = delivered;
    for (i < sealed.written) {
        live(?secure).lower_buffer[0] = wire[i];
        if (!runtime_ok(io_runtime.complete(?runtime,
            live(?secure).lower_token, 1, 0, false))) { ret 15; }
        var next: io_runtime.Completion;
        if (!take_one(?runtime, ?next) || !stream.accept(?secure, ?next)) {
            ret 16;
        }
        i = i + 1;
    }
    val finished: transport.Snapshot = transport.snapshot(live(?secure));
    if (finished.state != transport.OPERATION_TERMINAL
        || finished.application_bytes != 5) { ret 17; }
    if (application[0] != 'h' || application[1] != 'e' || application[2] != 'l'
        || application[3] != 'l' || application[4] != 'o') { ret 18; }
    if (!settle(?secure) || !stream.destroy(?secure)) {
        ret 19;
    }
    if (!operation_ok(cancel.destroy(?resumed)) || !operation_ok(cancel.destroy(?scope))) { ret 20; }
    if (!runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 21; }
    ret 0;
}

var parked_harness: pool.Harness;
var parked_squeeze: pool.Squeeze;

fun parked_setup() bool {
    if (!pool.make(?parked_harness, 1 << 18, 1 << 20)) { ret false; }
    parked_squeeze.harness = ?parked_harness;
    parked_squeeze.count   = 0;
    ret true;
}

fun parked(secure: *stream.Stream, transport_state: *TestTransport,
    reads: usize, writes: usize) bool {
    ret live_lane(secure).pending_action == transport.TRANSPORT_WAIT &&
        transport.snapshot(live(secure)).state == transport.OPERATION_WAITING &&
        transport_state.reads == reads && transport_state.writes == writes;
}

fun resumed(runtime: *io_runtime.Runtime, secure: *stream.Stream) bool {
    pool.relax(?parked_squeeze);
    var completion: io_runtime.Completion;
    ret stream.resume(secure) && take_one(runtime, ?completion) &&
        stream.accept(secure, ?completion);
}

test stream__a_write_that_waits_for_memory_parks_and_resumes_where_it_stopped {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16) || !parked_setup()) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_leased_stream(?secure, ?core_a, ?adapter, pool.lease(?parked_harness),
        pool.secret_lease(?parked_harness))) { ret 3; }
    if (stream.resume(?secure)) { ret 4; }
    pool.squeeze(?parked_squeeze);
    var application: [3]u8 = [3]u8{1, 2, 3};
    if (!stream.write(?secure, ?scope, transport.Token{index: 40, generation: 1},
        ?application[0], 3, 70)) { ret 5; }
    if (!parked(?secure, ?transport_state, 0, 0) || secure.wire_output_len != 0 ||
        secure.sealing.held) { ret 6; }
    if (!resumed(?runtime, ?secure))                                { ret 7; }
    if (transport_state.writes != 1 || secure.wire_output_len <= 3) { ret 8; }
    var completion: io_runtime.Completion;
    if (!runtime_ok(io_runtime.complete(?runtime, live(?secure).lower_token,
        secure.wire_output_len, 0, false)) || !take_one(?runtime, ?completion) ||
        !stream.accept(?secure, ?completion)) { ret 9; }
    val finished: transport.Snapshot = transport.snapshot(live(?secure));
    if (finished.state != transport.OPERATION_TERMINAL ||
        finished.terminal_error != error.OK || finished.application_bytes != 3 ||
        secure.wire_out.held) { ret 10; }
    if (!settle(?secure) || !stream.destroy(?secure) ||
        pool.held(?parked_harness) != 0 || !pool.destroy(?parked_harness) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 11; }
    ret 0;
}

test stream__a_read_waits_for_memory_to_buffer_and_to_open_a_record {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16) || !parked_setup()) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_leased_stream(?secure, ?core_a, ?adapter, pool.lease(?parked_harness),
        pool.secret_lease(?parked_harness))) { ret 3; }
    var key: [16]^u8;
    var iv:  [12]u8;
    var i:   usize = 0;
    for (i < 16) {
        key[i] = (i + 1)::u8;
        i      = i + 1;
    }
    i = 0;
    for (i < 12) {
        iv[i] = (0x80 + i)::u8;
        i     = i + 1;
    }
    var peer: record.Cipher;
    if (!record.install(?peer, record.TLS13, record.aes_128_gcm(),
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 4; }
    ct.zeroize(?key[0], 16);
    var clear:   [5]^u8        = [5]^u8{'p', 'a', 'r', 'k', 's'};
    var scratch: [record.MAX_INNER_PLAINTEXT]^u8;
    var wire:    [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
    val sealed:  record.Sealed = record.seal(?peer, record.APPLICATION_DATA,
        contracts.SecretBytes{data: ?clear[0], len: 5}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: record.MAX_INNER_PLAINTEXT},
        contracts.Buffer{data: ?wire[0],
        capacity: record.HEADER_SIZE + record.MAX_CIPHERTEXT});
    ct.zeroize(?clear[0], 5);
    record.destroy(?peer);
    if (sealed.error != error.OK) { ret 5; }

    pool.squeeze(?parked_squeeze);
    var application: [5]u8;
    if (!stream.read(?secure, ?scope, transport.Token{index: 41, generation: 1},
        ?application[0], 5, 71)) { ret 6; }
    if (!parked(?secure, ?transport_state, 0, 0) || secure.wire_in.held) { ret 7; }
    if (!resumed(?runtime, ?secure) || transport_state.reads != 1 ||
        secure.wire_in.chunk.bytes != stream.READ_START) { ret 8; }

    # the whole record arrives while memory is short again: opening it waits,
    # and nothing it read is lost
    i = 0;
    for (i < sealed.written) {
        live(?secure).lower_buffer[i] = wire[i];
        i                             = i + 1;
    }
    pool.squeeze(?parked_squeeze);
    var completion: io_runtime.Completion;
    if (!runtime_ok(io_runtime.complete(?runtime, live(?secure).lower_token,
        sealed.written, 0, false)) || !take_one(?runtime, ?completion) ||
        !stream.accept(?secure, ?completion)) { ret 9; }
    if (!parked(?secure, ?transport_state, 1, 0) ||
        secure.wire_input_len != sealed.written || secure.wire_input_read != 0 ||
        secure.opened.held) { ret 10; }
    if (!resumed(?runtime, ?secure)) { ret 11; }
    val finished: transport.Snapshot = transport.snapshot(live(?secure));
    if (finished.state != transport.OPERATION_TERMINAL ||
        finished.terminal_error != error.OK || finished.application_bytes != 5 ||
        application[0] != 'p' || application[4] != 's') { ret 12; }
    if (secure.wire_in.held || secure.opened.held) { ret 13; }
    if (!settle(?secure) || !stream.destroy(?secure) ||
        pool.held(?parked_harness) != 0 || !pool.destroy(?parked_harness) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 14; }
    ret 0;
}

test stream__cancelling_an_operation_parked_for_memory_settles_it_as_cancelled {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16) || !parked_setup()) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_leased_stream(?secure, ?core_a, ?adapter, pool.lease(?parked_harness),
        pool.secret_lease(?parked_harness))) { ret 3; }
    pool.squeeze(?parked_squeeze);
    var application: [3]u8 = [3]u8{7, 8, 9};
    if (!stream.write(?secure, ?scope, transport.Token{index: 42, generation: 1},
        ?application[0], 3, 72) || !parked(?secure, ?transport_state, 0, 0)) { ret 4; }
    if (!transition_ok(cancel.cancel(?scope))) { ret 5; }
    var completion: io_runtime.Completion;
    if (!take_one(?runtime, ?completion) || !stream.accept(?secure, ?completion)) { ret 6; }
    val cancelled: transport.Snapshot = transport.snapshot(live(?secure));
    if (cancelled.state != transport.OPERATION_TERMINAL ||
        cancelled.terminal_error != error.CANCELLED ||
        cancelled.application_bytes != 0 || live_lane(?secure).pending_action != 0) { ret 7; }
    # nothing was sealed, so the stream is still usable, and a late resume is ignored
    if (secure.state != stream.OPEN || stream.resume(?secure) ||
        secure.wire_out.held || secure.sealing.held) { ret 8; }
    if (!settle(?secure) || !operation_ok(cancel.destroy(?scope))) { ret 9; }

    # a read parked the same way ends the same way
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 10; }
    var input: [3]u8;
    if (!stream.read(?secure, ?scope, transport.Token{index: 42, generation: 2},
        ?input[0], 3, 73)) { ret 16; }
    if (!parked(?secure, ?transport_state, 0, 0))                                  { ret 17; }
    if (!transition_ok(cancel.cancel(?scope)) || !take_one(?runtime, ?completion)) { ret 18; }
    if (!stream.accept(?secure, ?completion))                                      { ret 11; }
    if (transport.snapshot(live(?secure)).terminal_error != error.CANCELLED ||
        secure.state != stream.OPEN || !settle(?secure) ||
        !operation_ok(cancel.destroy(?scope))) { ret 12; }

    # once memory is back the stream writes as if nothing happened
    pool.relax(?parked_squeeze);
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.write(?secure, ?scope, transport.Token{index: 42, generation: 3},
        ?application[0], 3, 74) || transport_state.writes != 1) { ret 13; }
    if (!runtime_ok(io_runtime.complete(?runtime, live(?secure).lower_token,
        secure.wire_output_len, 0, false)) || !take_one(?runtime, ?completion) ||
        !stream.accept(?secure, ?completion) ||
        transport.snapshot(live(?secure)).application_bytes != 3) { ret 14; }
    if (!settle(?secure) || !stream.destroy(?secure) ||
        pool.held(?parked_harness) != 0 || !pool.destroy(?parked_harness) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 15; }
    ret 0;
}

# a source that settles cancellation later, the way a native backend does, so a
# test can publish the transfer a cancelled request finished first
fun pending_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    ret false;
}

fun pending_cancel(context: ptr, token: io_runtime.Token, reason: io_error.Error) i64 {
    ret io_runtime.CANCELLATION_PENDING;
}

fun pending_release(context: ptr, completion: *io_runtime.Completion) {}

fun make_pending_source(state: *TestTransport) bool {
    val registered: res[io_runtime.SourceToken, io_error.Error] = io_runtime.register_source(
        state.runtime, state::ptr, pending_dispatch, pending_cancel, pending_release);
    if (sel registered.err) { ret false; }
    state.source       = registered.ok;
    state.asynchronous = true;
    ret true;
}

fun cancelled_with(completion: *io_runtime.Completion, kind: io_error.Kind, bytes: usize) bool {
    ret completion.has_error && completion.error.kind == kind && completion.bytes == bytes;
}

fun seal_application(clear: *^u8, length: usize, wire: *u8) usize {
    var key: [16]^u8;
    var iv:  [12]u8;
    var i:   usize = 0;
    for (i < 16) {
        key[i] = (i + 1)::u8;
        i      = i + 1;
    }
    i = 0;
    for (i < 12) {
        iv[i] = (0x80 + i)::u8;
        i     = i + 1;
    }
    var peer: record.Cipher;
    if (!record.install(?peer, record.TLS13, record.aes_128_gcm(),
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12})) { ret 0; }
    ct.zeroize(?key[0], 16);
    var scratch: [record.MAX_INNER_PLAINTEXT]^u8;
    val sealed:  record.Sealed = record.seal(?peer, record.APPLICATION_DATA,
        contracts.SecretBytes{data: clear, len: length}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: record.MAX_INNER_PLAINTEXT},
        contracts.Buffer{data: wire, capacity: record.HEADER_SIZE + record.MAX_CIPHERTEXT});
    record.destroy(?peer);
    if (sealed.error != error.OK) { ret 0; }
    ret sealed.written;
}

# the runtime publishes a cancellation with the bytes its request read first.
# those bytes are the start of a record, and the next read must finish it
test stream__a_cancelled_completion_s_read_bytes_reach_the_record_layer {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 32)) { ret 1; }
    var state:   TestTransport;
    var adapter: transport.Transport;
    make_test_transport(?adapter, ?state, ?runtime);
    if (!make_pending_source(?state)) { ret 2; }
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_a, ?adapter)) { ret 3; }
    var clear:  [5]^u8 = [5]^u8{'b', 'y', 't', 'e', 's'};
    var wire:   [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
    val sealed: usize  = seal_application(?clear[0], 5, ?wire[0]);
    ct.zeroize(?clear[0], 5);
    if (sealed < 8) { ret 4; }

    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 5; }
    var application: [5]u8;
    if (!stream.read(?secure, ?scope, transport.Token{index: 50, generation: 1},
        ?application[0], 5, 80)) { ret 6; }
    val delivered: usize = 6;
    var i:         usize = 0;
    for (i < delivered) {
        live(?secure).lower_buffer[i] = wire[i];
        i                             = i + 1;
    }
    val token: io_runtime.Token = live(?secure).lower_token;
    if (!transition_ok(cancel.cancel(?scope)) ||
        !runtime_ok(io_runtime.complete_cancellation_transfer(?runtime, token, delivered, 0, false))) {
        ret 7;
    }
    var completion: io_runtime.Completion;
    if (!take_one(?runtime, ?completion) ||
        !cancelled_with(?completion, io_error.CANCELLED, delivered)) { ret 8; }
    if (!stream.accept(?secure, ?completion)) { ret 9; }
    val cancelled: transport.Snapshot = transport.snapshot(live(?secure));
    if (cancelled.terminal_error != error.CANCELLED || cancelled.last_transport_bytes != delivered ||
        secure.state != stream.OPEN || secure.wire_input_len != delivered) { ret 10; }
    if (!settle(?secure) || !operation_ok(cancel.destroy(?scope))) { ret 11; }

    # a completion that finished while the cancellation was underway rides on it
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.read(?secure, ?scope, transport.Token{index: 50, generation: 2},
        ?application[0], 5, 81)) { ret 12; }
    val raced: usize = 5;
    i = 0;
    for (i < raced) {
        live(?secure).lower_buffer[i] = wire[delivered + i];
        i                             = i + 1;
    }
    val raced_token: io_runtime.Token = live(?secure).lower_token;
    if (!transition_ok(cancel.cancel(?scope)) ||
        !runtime_ok(io_runtime.complete(?runtime, raced_token, raced, 0, false)) ||
        !runtime_ok(io_runtime.complete_cancellation(?runtime, raced_token)) ||
        !take_one(?runtime, ?completion) ||
        !cancelled_with(?completion, io_error.CANCELLED, raced) ||
        !stream.accept(?secure, ?completion)) { ret 13; }
    if (secure.wire_input_len != delivered + raced || secure.state != stream.OPEN ||
        !settle(?secure) || !operation_ok(cancel.destroy(?scope))) { ret 14; }

    # the rest of the record arrives normally and the whole record decodes
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.read(?secure, ?scope, transport.Token{index: 50, generation: 3},
        ?application[0], 5, 82)) { ret 15; }
    val rest: usize = sealed - delivered - raced;
    i = 0;
    for (i < rest) {
        live(?secure).lower_buffer[i] = wire[delivered + raced + i];
        i                             = i + 1;
    }
    if (!runtime_ok(io_runtime.complete(?runtime, live(?secure).lower_token, rest, 0, false)) ||
        !take_one(?runtime, ?completion) || !stream.accept(?secure, ?completion)) { ret 16; }
    val finished: transport.Snapshot = transport.snapshot(live(?secure));
    if (finished.terminal_error != error.OK || finished.application_bytes != 5 ||
        application[0] != 'b' || application[4] != 's') { ret 17; }
    if (!settle(?secure) || !stream.destroy(?secure) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_ok(io_runtime.unregister_source(?runtime, state.source)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 18; }
    ret 0;
}

# a read that timed out as the peer closed reports the end of stream it saw
test stream__a_timed_out_completion_s_end_of_stream_is_kept {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16)) { ret 1; }
    var state:   TestTransport;
    var adapter: transport.Transport;
    make_test_transport(?adapter, ?state, ?runtime);
    if (!make_pending_source(?state)) { ret 2; }
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_a, ?adapter)) { ret 3; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 4; }
    var application: [5]u8;
    if (!stream.read(?secure, ?scope, transport.Token{index: 51, generation: 1},
        ?application[0], 5, 83)) { ret 5; }
    var completion: io_runtime.Completion;
    if (!transition_ok(cancel.timeout(?scope)) ||
        !runtime_ok(io_runtime.complete_cancellation_transfer(?runtime,
        live(?secure).lower_token, 0, 0, true)) ||
        !take_one(?runtime, ?completion) ||
        !cancelled_with(?completion, io_error.TIMEOUT, 0) || !completion.end_of_stream ||
        !stream.accept(?secure, ?completion)) { ret 6; }
    val timed_out: transport.Snapshot = transport.snapshot(live(?secure));
    if (timed_out.terminal_error != error.TIMEOUT || !timed_out.last_end_of_stream ||
        !secure.lower_eof || secure.state != stream.OPEN) { ret 7; }
    if (!settle(?secure) || !operation_ok(cancel.destroy(?scope))) { ret 8; }
    # the next read knows the peer is gone without another lower read
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.read(?secure, ?scope, transport.Token{index: 51, generation: 2},
        ?application[0], 5, 84)) { ret 9; }
    if (transport.snapshot(live(?secure)).terminal_error != error.CLOSED ||
        state.reads != 1) { ret 10; }
    if (!settle(?secure) || !stream.destroy(?secure) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_ok(io_runtime.unregister_source(?runtime, state.source)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 11; }
    ret 0;
}

# a cancelled write reports what it sent. a whole record sent leaves the stream
# at a record boundary and counts; a record cut short fails it
test stream__a_cancelled_completion_s_written_bytes_settle_their_record {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16)) { ret 1; }
    var state:   TestTransport;
    var adapter: transport.Transport;
    make_test_transport(?adapter, ?state, ?runtime);
    var provider: transport.Provider = transport.no_provider();
    if (!transport.pin(?provider, ?adapter)) { ret 90; }
    if (!make_pending_source(?state))        { ret 2; }
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_a, ?adapter)) { ret 3; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 4; }
    var application: [3]u8 = [3]u8{4, 5, 6};
    if (!stream.write(?secure, ?scope, transport.Token{index: 52, generation: 1},
        ?application[0], 3, 85)) { ret 5; }
    val whole:      usize = secure.wire_output_len;
    var completion: io_runtime.Completion;
    if (!transition_ok(cancel.cancel(?scope)) ||
        !runtime_ok(io_runtime.complete_cancellation_transfer(?runtime,
        live(?secure).lower_token, whole, 0, false)) ||
        !take_one(?runtime, ?completion) ||
        !cancelled_with(?completion, io_error.CANCELLED, whole) ||
        !stream.accept(?secure, ?completion)) { ret 6; }
    val sent: transport.Snapshot = transport.snapshot(live(?secure));
    if (sent.terminal_error != error.CANCELLED || sent.application_bytes != 3 ||
        secure.state != stream.OPEN || secure.wire_output_len != 0) { ret 7; }
    if (!settle(?secure) || !operation_ok(cancel.destroy(?scope))) { ret 8; }

    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.write(?secure, ?scope, transport.Token{index: 52, generation: 2},
        ?application[0], 3, 86)) { ret 9; }
    val partial: usize = secure.wire_output_len - 1;
    if (!transition_ok(cancel.cancel(?scope)) ||
        !runtime_ok(io_runtime.complete_cancellation_transfer(?runtime,
        live(?secure).lower_token, partial, 0, false)) ||
        !take_one(?runtime, ?completion) ||
        !stream.accept(?secure, ?completion)) { ret 10; }
    val cut: transport.Snapshot = transport.snapshot(live(?secure));
    if (cut.terminal_error != error.CANCELLED || cut.application_bytes != 0 ||
        secure.state != stream.FAILED) { ret 11; }
    if (!settle(?secure) || !operation_ok(cancel.destroy(?scope))) { ret 12; }

    # a transfer larger than the request is refused however the request ended
    var lower:   transport.Operation;
    var bounded: cancel.Scope;
    var buffer:  [4]u8;
    if (!operation_ok(cancel.make_root(?bounded, opt[time.Instant].none{})) ||
        !transport.begin(?lower, transport.Token{index: 53, generation: 1},
        transport.APPLICATION_READ, ?bounded, ?buffer[0], 4, 0) ||
        !transport.begin_action(?lower, ?provider, transport.Action{kind: transport.TRANSPORT_READ,
        buffer: ?buffer[0], length: 4, context: 0}) ||
        !transition_ok(cancel.cancel(?bounded)) ||
        !runtime_ok(io_runtime.complete_cancellation_transfer(?runtime, lower.lower_token, 5, 0, false)) ||
        !take_one(?runtime, ?completion) || !transport.accept(?lower, ?completion)) { ret 13; }
    val refused: transport.Snapshot = transport.snapshot(?lower);
    if (refused.terminal_error != error.INTERNAL_ERROR || refused.last_transport_bytes != 0 ||
        !transport.destroy_operation(?lower) || !operation_ok(cancel.destroy(?bounded))) { ret 14; }
    if (!stream.destroy(?secure) ||
        !runtime_ok(io_runtime.unregister_source(?runtime, state.source)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 15; }
    ret 0;
}

fun fill_secret(secret: *key_schedule.Secret, base: u8) {
    var i: usize = 0;
    for (i < 32) {
        val byte: u8 = base + i::u8;
        secret.data[i] = byte;
        i              = i + 1;
    }
    secret.len    = 32;
    secret.active = true;
}

# an open stream over a finished core, which is what takes key updates
fun make_finished_stream(value: *stream.Stream, core: *client.Handshake,
    adapter: *transport.Transport, memory: buffer.Lease,
    secrets: buffer.SecretLease) bool {
    if (!make_leased_stream(value, core, adapter, memory, secrets)) { ret false; }
    var send:    key_schedule.Secret;
    var receive: key_schedule.Secret;
    fill_secret(?send, 1);
    fill_secret(?receive, 65);
    var seed: established.Seed;
    seed.role                 = engine.SERVER;
    seed.suite                = tls13.AES_128_GCM_SHA256;
    seed.group                = tls13.X25519;
    seed.receive_record_limit = record.MAX_PLAINTEXT;
    seed.send_record_limit    = record.MAX_PLAINTEXT;
    seed.max_message_bytes    = 16384;
    seed.max_ticket_bytes     = 256;
    value.core13              = established.empty();
    val begun: bool = established.begin(?value.core13, seed, ?send, ?receive, nil, nil,
        buffer.no_lease());
    ct.zeroize(?send.data[0], 48);
    ct.zeroize(?receive.data[0], 48);
    if (!begun) { ret false; }
    value.role     = engine.SERVER;
    value.client   = nil;
    value.finished = true;
    ret true;
}

# the peer seals with the key the test stream reads with
fun make_peer(peer: *record.Cipher) bool {
    var key: [16]^u8;
    var iv:  [12]u8;
    var i:   usize = 0;
    for (i < 16) {
        key[i] = (i + 1)::u8;
        i      = i + 1;
    }
    i = 0;
    for (i < 12) {
        iv[i] = (0x80 + i)::u8;
        i     = i + 1;
    }
    val installed: bool = record.install(peer, record.TLS13, record.aes_128_gcm(),
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 12});
    ct.zeroize(?key[0], 16);
    ret installed;
}

fun seal_peer(peer: *record.Cipher, kind: record.ContentType, clear: *^u8,
    length: usize, wire: *u8) usize {
    var scratch: [record.MAX_INNER_PLAINTEXT]^u8;
    val sealed:  record.Sealed = record.seal(peer, kind,
        contracts.SecretBytes{data: clear, len: length}, 0,
        contracts.SecretBuffer{data: ?scratch[0], capacity: record.MAX_INNER_PLAINTEXT},
        contracts.Buffer{data: wire, capacity: record.HEADER_SIZE + record.MAX_CIPHERTEXT});
    if (sealed.error != error.OK) { ret 0; }
    ret sealed.written;
}

fun deliver(runtime: *io_runtime.Runtime, operation: *transport.Operation, wire: *u8,
    length: usize) bool {
    var i: usize = 0;
    for (i < length) {
        operation.lower_buffer[i] = wire[i];
        i                         = i + 1;
    }
    ret runtime_ok(io_runtime.complete(runtime, operation.lower_token, length, 0, false));
}

fun step(runtime: *io_runtime.Runtime, secure: *stream.Stream) bool {
    var completion: io_runtime.Completion;
    ret take_one(runtime, ?completion) && stream.accept(secure, ?completion);
}

fun lane_ended(lane: *stream.Lane, failure: error.Error, bytes: usize) bool {
    val value: transport.Snapshot = transport.snapshot(?lane.operation);
    ret value.state == transport.OPERATION_TERMINAL && value.terminal_error == failure &&
        value.application_bytes == bytes;
}

fun token(index: u32, generation: u32) transport.Token {
    ret transport.Token{index: index, generation: generation};
}

test stream__a_read_that_finds_memory_first_does_not_starve_a_parked_write {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16) || !parked_setup()) { ret 1; }
    var writes: cancel.Scope;
    var reads:  cancel.Scope;
    if (!operation_ok(cancel.make_root(?writes, opt[time.Instant].none{})) ||
        !operation_ok(cancel.make_root(?reads, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_leased_stream(?secure, ?core_a, ?adapter, pool.lease(?parked_harness),
        pool.secret_lease(?parked_harness))) { ret 3; }
    pool.squeeze(?parked_squeeze);
    var output: [3]u8 = [3]u8{1, 2, 3};
    var input:  [5]u8;
    if (!stream.write(?secure, ?writes, token(60, 1), ?output[0], 3, 0) ||
        !stream.read(?secure, ?reads, token(60, 2), ?input[0], 5, 0)) { ret 4; }
    if (secure.writing.park != stream.PARK_MEMORY ||
        secure.reading.park != stream.PARK_MEMORY || transport_state.reads != 0 ||
        transport_state.writes != 0) { ret 5; }
    pool.relax(?parked_squeeze);
    if (!stream.resume(?secure)) { ret 6; }
    # the read is woken first and stands aside, since the write holds the turn
    if (!step(?runtime, ?secure)) { ret 7; }
    if (secure.reading.park != stream.PARK_MEMORY || secure.wire_in.held ||
        transport_state.reads != 0 || transport_state.writes != 0) { ret 8; }
    if (!step(?runtime, ?secure))                                       { ret 9; }
    if (transport_state.writes != 1 || secure.turn != stream.READ_LANE) { ret 10; }
    # the write passed the turn and woke the read, which now takes its memory
    if (!step(?runtime, ?secure) || transport_state.reads != 1 ||
        secure.reading.park != stream.PARK_NONE) { ret 11; }
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        secure.wire_output_len, 0, false)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.writing, error.OK, 3) ||
        !stream.destroy_operation(?secure, token(60, 1))) { ret 12; }
    if (!transition_ok(cancel.cancel(?reads)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.reading, error.CANCELLED, 0) ||
        !stream.destroy_operation(?secure, token(60, 2)) || secure.state != stream.OPEN) {
        ret 13;
    }
    if (!stream.destroy(?secure) || pool.held(?parked_harness) != 0 ||
        !pool.destroy(?parked_harness) || !operation_ok(cancel.destroy(?writes)) ||
        !operation_ok(cancel.destroy(?reads)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 14; }
    ret 0;
}

test stream__a_write_that_went_out_in_full_counts_its_bytes_when_the_read_fails {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    var peer:   record.Cipher;
    if (!make_open_stream(?secure, ?core_a, ?adapter) || !make_peer(?peer)) { ret 3; }
    var output: [3]u8 = [3]u8{1, 2, 3};
    var input:  [5]u8;
    if (!stream.write(?secure, ?scope, token(61, 1), ?output[0], 3, 0) ||
        !stream.read(?secure, ?scope, token(61, 2), ?input[0], 5, 0) ||
        transport_state.writes != 1 || transport_state.reads != 1) { ret 4; }
    var clear:  [5]^u8 = [5]^u8{'f', 'o', 'r', 'g', 'e'};
    var wire:   [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
    val sealed: usize  = seal_peer(?peer, record.APPLICATION_DATA, ?clear[0], 5, ?wire[0]);
    record.destroy(?peer);
    if (sealed == 0) { ret 5; }
    wire[sealed - 1] = wire[sealed - 1] ^ 1;
    if (!deliver(?runtime, ?secure.reading.operation, ?wire[0], sealed) ||
        !step(?runtime, ?secure)) { ret 6; }
    if (!lane_ended(?secure.reading, error.BAD_RECORD_MAC, 0) ||
        secure.state != stream.FAILED ||
        transport.snapshot(?secure.writing.operation).state !=
        transport.OPERATION_WAITING) { ret 7; }
    # the record reached the peer, so its bytes count, and the write reports
    # the failure that ended the stream
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        secure.wire_output_len, 0, false)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.writing, error.BAD_RECORD_MAC, 3)) { ret 8; }
    if (!stream.destroy_operation(?secure, token(61, 1)) ||
        !stream.destroy_operation(?secure, token(61, 2)) ||
        !stream.close(?secure, ?scope, token(61, 3), 0) ||
        secure.writing.pending_action != transport.TRANSPORT_ABORT) { ret 9; }
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        0, 0, false)) || !step(?runtime, ?secure) || secure.state != stream.CLOSED ||
        !stream.destroy_operation(?secure, token(61, 3)) || !stream.destroy(?secure) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 10; }
    ret 0;
}

test stream__a_read_in_flight_refuses_close_while_half_close_and_key_update_proceed {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16)) { ret 1; }
    var writes: cancel.Scope;
    var reads:  cancel.Scope;
    if (!operation_ok(cancel.make_root(?writes, opt[time.Instant].none{})) ||
        !operation_ok(cancel.make_root(?reads, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_finished_stream(?secure, ?core_a, ?adapter, pool.shared(),
        pool.shared_secret())) { ret 3; }
    var input: [5]u8;
    if (!stream.read(?secure, ?reads, token(62, 1), ?input[0], 5, 0) ||
        transport_state.reads != 1) { ret 4; }
    # a full close and an alert need both lanes and change nothing
    if (stream.close(?secure, ?writes, token(62, 2), 0) ||
        stream.alert(?secure, ?writes, token(62, 2), record.INTERNAL_ERROR_ALERT, 0)) { ret 5; }
    if (secure.state != stream.OPEN || secure.send_closed || transport_state.writes != 0 ||
        transport_state.closes != 0 ||
        transport.snapshot(?secure.writing.operation).state != 0) { ret 6; }
    # a key update and a half close need only the write lane
    if (!stream.key_update(?secure, ?writes, token(62, 3), 0, 0) ||
        transport_state.writes != 1) { ret 7; }
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        secure.wire_output_len, 0, false)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.writing, error.OK, 0) ||
        !stream.destroy_operation(?secure, token(62, 3))) { ret 8; }
    if (!stream.half_close(?secure, ?writes, token(62, 4), 0) ||
        transport_state.writes != 2) { ret 9; }
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        secure.wire_output_len, 0, false)) || !step(?runtime, ?secure) ||
        transport_state.closes != 1 ||
        !runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        0, 0, false)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.writing, error.OK, 0) || !secure.send_closed ||
        !stream.destroy_operation(?secure, token(62, 4))) { ret 10; }
    if (transport.snapshot(?secure.reading.operation).state !=
        transport.OPERATION_WAITING || transport_state.reads != 1) { ret 11; }
    if (!transition_ok(cancel.cancel(?reads)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.reading, error.CANCELLED, 0) ||
        !stream.destroy_operation(?secure, token(62, 1)) ||
        secure.state != stream.OPEN) { ret 12; }
    if (!stream.destroy(?secure) || !operation_ok(cancel.destroy(?writes)) ||
        !operation_ok(cancel.destroy(?reads)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 13; }
    ret 0;
}

test stream__a_peer_close_notify_ends_the_read_and_leaves_the_write_finishable {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    var peer:   record.Cipher;
    if (!make_open_stream(?secure, ?core_a, ?adapter) || !make_peer(?peer)) { ret 3; }
    var output: [3]u8 = [3]u8{1, 2, 3};
    var input:  [5]u8;
    if (!stream.write(?secure, ?scope, token(63, 1), ?output[0], 3, 0) ||
        !stream.read(?secure, ?scope, token(63, 2), ?input[0], 5, 0)) { ret 4; }
    var clear:  [2]^u8 = [2]^u8{record.WARNING, record.CLOSE_NOTIFY};
    var wire:   [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
    val sealed: usize  = seal_peer(?peer, record.ALERT, ?clear[0], 2, ?wire[0]);
    record.destroy(?peer);
    if (sealed == 0 || !deliver(?runtime, ?secure.reading.operation, ?wire[0], sealed) ||
        !step(?runtime, ?secure)) { ret 5; }
    if (!lane_ended(?secure.reading, error.OK, 0) || !secure.peer_closed ||
        secure.state != stream.OPEN) { ret 6; }
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        secure.wire_output_len, 0, false)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.writing, error.OK, 3) || secure.state != stream.OPEN) { ret 7; }
    if (!stream.destroy_operation(?secure, token(63, 1)) ||
        !stream.destroy_operation(?secure, token(63, 2)) || !stream.destroy(?secure) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 8; }
    ret 0;
}

test stream__a_failed_stream_closes_over_a_read_in_flight_and_still_accounts_it {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_a, ?adapter)) { ret 3; }
    var output: [3]u8 = [3]u8{1, 2, 3};
    var input:  [5]u8;
    if (!stream.read(?secure, ?scope, token(64, 1), ?input[0], 5, 0)) { ret 4; }
    # sealing fails while the socket is healthy and the read is still in flight
    secure.write_cipher.sequence = 0xffffffffffffffff;
    if (!stream.write(?secure, ?scope, token(64, 2), ?output[0], 3, 0) ||
        !lane_ended(?secure.writing, error.INTERNAL_ERROR, 0) ||
        secure.state != stream.FAILED || transport_state.writes != 0 ||
        transport.snapshot(?secure.reading.operation).state !=
        transport.OPERATION_WAITING) { ret 5; }
    if (!stream.destroy_operation(?secure, token(64, 2))) { ret 6; }
    # only an abortive close is allowed, and it is what ends the read
    if (stream.write(?secure, ?scope, token(64, 3), ?output[0], 3, 0) ||
        !stream.close(?secure, ?scope, token(64, 3), 0) ||
        secure.writing.pending_action != transport.TRANSPORT_ABORT ||
        transport_state.closes != 1) { ret 7; }
    var header: [4]u8 = [4]u8{record.APPLICATION_DATA, 3, 3, 0};
    if (!deliver(?runtime, ?secure.reading.operation, ?header[0], 4) ||
        !step(?runtime, ?secure)) { ret 8; }
    if (!lane_ended(?secure.reading, error.INTERNAL_ERROR, 0) ||
        secure.wire_input_len != 4) { ret 9; }
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        0, 0, false)) || !step(?runtime, ?secure) || secure.state != stream.CLOSED) {
        ret 10;
    }
    if (!stream.destroy_operation(?secure, token(64, 1)) ||
        !stream.destroy_operation(?secure, token(64, 3)) || !stream.destroy(?secure) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 11; }
    ret 0;
}

test stream__a_read_owing_a_record_and_a_write_short_of_memory_do_not_deadlock {
    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16) || !parked_setup()) { ret 1; }
    var writes: cancel.Scope;
    var reads:  cancel.Scope;
    if (!operation_ok(cancel.make_root(?writes, opt[time.Instant].none{})) ||
        !operation_ok(cancel.make_root(?reads, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    var peer:   record.Cipher;
    if (!make_finished_stream(?secure, ?core_a, ?adapter, pool.lease(?parked_harness),
        pool.secret_lease(?parked_harness)) || !make_peer(?peer)) { ret 3; }
    var output: [3]u8 = [3]u8{1, 2, 3};
    var input:  [5]u8;
    if (!stream.write(?secure, ?writes, token(65, 1), ?output[0], 3, 0) ||
        !stream.read(?secure, ?reads, token(65, 2), ?input[0], 5, 0)) { ret 4; }
    # the peer asks for an update while the write's record is on the wire
    var clear:  [5]^u8 = [5]^u8{24, 0, 0, 1, 1};
    var wire:   [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
    val sealed: usize  = seal_peer(?peer, record.HANDSHAKE, ?clear[0], 5, ?wire[0]);
    record.destroy(?peer);
    if (sealed == 0 || !deliver(?runtime, ?secure.reading.operation, ?wire[0], sealed) ||
        !step(?runtime, ?secure)) { ret 5; }
    if (secure.reading.park != stream.PARK_PEER || !secure.core_event_sending ||
        secure.sender != stream.WRITE_LANE) { ret 6; }
    # the write's record lands, and the owed record then finds no memory
    pool.squeeze(?parked_squeeze);
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        secure.wire_output_len, 0, false)) || !step(?runtime, ?secure)) { ret 7; }
    if (secure.writing.park != stream.PARK_MEMORY ||
        transport.snapshot(?secure.writing.operation).application_bytes != 3) { ret 8; }
    # the woken read tries the record too, and parks for memory beside the write
    if (!step(?runtime, ?secure) || secure.reading.park != stream.PARK_MEMORY) { ret 9; }
    pool.relax(?parked_squeeze);
    if (!stream.resume(?secure) || !step(?runtime, ?secure) ||
        !step(?runtime, ?secure)) { ret 10; }
    # the write held the turn and sent the owed record exactly once
    if (transport_state.writes != 2 || secure.sender != stream.WRITE_LANE ||
        secure.turn != stream.READ_LANE) { ret 11; }
    if (!step(?runtime, ?secure) || secure.reading.park != stream.PARK_PEER) { ret 12; }
    if (!runtime_ok(io_runtime.complete(?runtime, secure.writing.operation.lower_token,
        secure.wire_output_len, 0, false)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.writing, error.OK, 3) || secure.core_event_sending) { ret 13; }
    # the read is woken once the record is out and goes back to reading
    if (!step(?runtime, ?secure) || transport_state.reads != 2 ||
        transport_state.writes != 2 || secure.state != stream.OPEN) { ret 14; }
    if (!stream.destroy_operation(?secure, token(65, 1)) ||
        !transition_ok(cancel.cancel(?reads)) || !step(?runtime, ?secure) ||
        !lane_ended(?secure.reading, error.CANCELLED, 0) ||
        !stream.destroy_operation(?secure, token(65, 2))) { ret 15; }
    if (!stream.destroy(?secure) || pool.held(?parked_harness) != 0 ||
        !pool.destroy(?parked_harness) || !operation_ok(cancel.destroy(?writes)) ||
        !operation_ok(cancel.destroy(?reads)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 16; }
    ret 0;
}

fun submitted(result: res[io_runtime.Token, io_error.Error]) bool {
    ret sel result.ok;
}

fun waited(runtime: *io_runtime.Runtime, completion: *io_runtime.Completion) bool {
    val result: res[usize, io_error.Error] = io_runtime.wait(runtime, completion, 1, 5000);
    ret (sel result.ok) && result.ok == 1;
}

# a lower close through the bundled adapter in close_mode, then what the peer
# reads: 1 for a clean end of stream, 2 for a reset, 0 for anything else
fun adapter_close(close_mode: lifecycle.Mode) i32 {
    var runtime: io_runtime.Runtime;
    var driver:  net_async.Driver;
    var scope:   cancel.Scope;
    if (!make_runtime(?runtime, 8) ||
        !runtime_ok(net_async.make(?driver, ?runtime)) ||
        !operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 0; }
    val listening: res[tcp.Listener, io_error.Error] = net_async.listen(
        ip.endpoint(127, 0, 0, 1, 0), 4);
    if (sel listening.err) { ret 0; }
    var listener: tcp.Listener                     = listening.ok;
    val local:    res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?listener);
    if (sel local.err) { ret 0; }
    var peer_address: ip.Endpoint;
    if (!submitted(net_async.submit_accept(?driver, ?scope, ?listener, ?peer_address, 1))) { ret 0; }
    val dialed: res[tcp.Stream, io_error.Error] = tcp.connect(local.ok);
    if (sel dialed.err) { ret 0; }
    var client:     tcp.Stream = dialed.ok;
    var completion: io_runtime.Completion;
    if (!waited(?runtime, ?completion) || completion.has_error ||
        completion.kind != io_runtime.ACCEPT) { ret 0; }
    var server:   tcp.Stream         = net_async.stream(?completion);
    var adapter:  transport.TcpAdapter;
    var lower:    transport.Transport;
    var provider: transport.Provider = transport.no_provider();
    if (!transport.make_tcp(?lower, ?adapter, ?driver, ?client, close_mode) ||
        !transport.pin(?provider, ?lower)) { ret 0; }
    var operation: transport.Operation;
    if (!transport.begin(?operation, transport.Token{index: 70, generation: 1},
        transport.APPLICATION_CLOSE, ?scope, nil, 0, 0) ||
        !transport.begin_action(?operation, ?provider, transport.Action{
        kind: transport.TRANSPORT_CLOSE, buffer: nil, length: 0, context: 0
    }) ||
        !waited(?runtime, ?completion) ||
        !transport.accept(?operation, ?completion)) { ret 0; }
    val closed: transport.Snapshot = transport.snapshot(?operation);
    if (closed.state != transport.OPERATION_TERMINAL ||
        closed.terminal_error != error.OK ||
        !transport.destroy_operation(?operation)) { ret 0; }
    var byte: [1]u8;
    if (!submitted(net_async.submit_read(?driver, ?scope, ?server, ?byte[0], 1, 2)) ||
        !waited(?runtime, ?completion) || completion.kind != io_runtime.READ) { ret 0; }
    var seen: i32 = 0;
    if (!completion.has_error && completion.end_of_stream && completion.bytes == 0) {
        seen = 1;
    }
    or (completion.has_error) {
        seen = 2;
    }
    var released: io_runtime.Completion;
    if (!submitted(net_async.submit_stream_close(?driver, ?scope, ?server,
        lifecycle.ABORTIVE, 3)) || !waited(?runtime, ?released) ||
        !runtime_ok(tcp.listener_close(?listener)) ||
        !operation_ok(cancel.destroy(?scope)) ||
        !runtime_ok(net_async.destroy(?driver)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 0; }
    ret seen;
}

# a graceful close releases the socket and the peer reads a clean end of stream.
# before this, the adapter shut the write side down instead, whose completion a
# close refused and whose socket was never released
test transport__the_tcp_adapter_s_graceful_close_releases_the_socket {
    if (adapter_close(lifecycle.GRACEFUL) != 1) { ret 1; }
    ret 0;
}

$if ($mach.build.os == $mach.os.linux) {
    test transport__the_tcp_adapter_s_abortive_close_resets_the_peer {
        if (adapter_close(lifecycle.ABORTIVE) != 2) { ret 1; }
        ret 0;
    }
}
