    var runtime: io_runtime.Runtime;
    if (!make_runtime(?runtime, 16)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var transport_state: TestTransport;
    var adapter:         transport.Transport;
    make_test_transport(?adapter, ?transport_state, ?runtime);
    var secure: stream.Stream;
    if (!make_open_stream(?secure, ?core_a, ?adapter)) { ret 3; }
    var application: [3]u8 = [3]u8{1, 2, 3};
    if (!stream.write(?secure, ?scope, transport.Token{index: 11, generation: 1},
        ?application[0], 3, 45) || !transition_ok(cancel.cancel(?scope))) { ret 4; }
    if (transport.snapshot(live(?secure)).state != transport.OPERATION_WAITING ||
        live(?secure).application_buffer != ?application[0]) { ret 5; }
    var completion: io_runtime.Completion;
    if (!take_one(?runtime, ?completion) || !stream.accept(?secure, ?completion)) { ret 6; }
    if (transport.snapshot(live(?secure)).terminal_error != error.CANCELLED ||
        secure.state != stream.FAILED || !settle(?secure) ||
        !operation_ok(cancel.destroy(?scope))) { ret 7; }
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.close(?secure, ?scope,
        transport.Token{index: 11, generation: 2}, 46) ||
        live_lane(?secure).pending_action != transport.TRANSPORT_ABORT) { ret 8; }
    if (!runtime_ok(io_runtime.complete(?runtime,
        live(?secure).lower_token, 0, 0, false)) || !take_one(?runtime, ?completion) ||
        !stream.accept(?secure, ?completion)) { ret 9; }
    if (transport.snapshot(live(?secure)).terminal_error != error.OK ||
        secure.state != stream.CLOSED || !settle(?secure) ||
        !stream.destroy(?secure) || !operation_ok(cancel.destroy(?scope)) ||
        !runtime_closed(io_runtime.close(?runtime)) ||
        !runtime_ok(io_runtime.destroy(?runtime))) { ret 10; }
    ret 0;
}

