# tls 1.2 registry values and suite properties

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.record;
use tls.tls13.key_schedule;

pub val VERSION: u16 = 0x0303;

pub val ECDHE_ECDSA_AES_128_GCM_SHA256: u16 = 0xC02B;
pub val ECDHE_RSA_AES_128_GCM_SHA256:   u16 = 0xC02F;
pub val ECDHE_ECDSA_AES_256_GCM_SHA384: u16 = 0xC02C;
pub val ECDHE_RSA_AES_256_GCM_SHA384:   u16 = 0xC030;
pub val ECDHE_RSA_CHACHA20_POLY1305:    u16 = 0xCCA8;
pub val ECDHE_ECDSA_CHACHA20_POLY1305:  u16 = 0xCCA9;

# the signalling value a client sends to say it is not renegotiating
pub val EMPTY_RENEGOTIATION_INFO_SCSV: u16 = 0x00FF;
# the value a client sends when it deliberately offers less than it supports
pub val FALLBACK_SCSV: u16 = 0x5600;

pub val MAX_PLAINTEXT:      usize = 16384;
pub val VERIFY_DATA_SIZE:   usize = 12;
pub val MASTER_SECRET_SIZE: usize = 48;

# the last eight bytes a tls 1.3 capable server writes into its random when it
# negotiates a lower version, so a downgraded client can notice
pub val DOWNGRADE_TLS12: [8]u8 = [8]u8{0x44, 0x4F, 0x57, 0x4E, 0x47, 0x52,
    0x44, 0x01};
pub val DOWNGRADE_TLS11: [8]u8 = [8]u8{0x44, 0x4F, 0x57, 0x4E, 0x47, 0x52,
    0x44, 0x00};

pub fun valid_suite(suite: u16) bool {
    ret suite == ECDHE_ECDSA_AES_128_GCM_SHA256 ||
        suite == ECDHE_RSA_AES_128_GCM_SHA256 ||
        suite == ECDHE_ECDSA_AES_256_GCM_SHA384 ||
        suite == ECDHE_RSA_AES_256_GCM_SHA384 ||
        suite == ECDHE_RSA_CHACHA20_POLY1305 ||
        suite == ECDHE_ECDSA_CHACHA20_POLY1305;
}

pub fun suite_hash(suite: u16) key_schedule.HashAlgorithm {
    if (suite == ECDHE_ECDSA_AES_256_GCM_SHA384 ||
        suite == ECDHE_RSA_AES_256_GCM_SHA384) { ret key_schedule.SHA384; }
    if (valid_suite(suite)) { ret key_schedule.SHA256; }
    ret 0;
}

pub fun suite_key_size(suite: u16) usize {
    if (suite == ECDHE_ECDSA_AES_128_GCM_SHA256 ||
        suite == ECDHE_RSA_AES_128_GCM_SHA256) { ret 16; }
    if (valid_suite(suite)) { ret 32; }
    ret 0;
}

# gcm carries an explicit per-record nonce, so only four bytes are derived
pub fun suite_iv_size(suite: u16) usize {
    if (suite == ECDHE_RSA_CHACHA20_POLY1305 ||
        suite == ECDHE_ECDSA_CHACHA20_POLY1305) { ret 12; }
    if (valid_suite(suite)) { ret 4; }
    ret 0;
}

pub fun suite_aead(suite: u16) record.Algorithm {
    if (suite == ECDHE_ECDSA_AES_128_GCM_SHA256 ||
        suite == ECDHE_RSA_AES_128_GCM_SHA256) { ret record.AES_128_GCM; }
    if (suite == ECDHE_ECDSA_AES_256_GCM_SHA384 ||
        suite == ECDHE_RSA_AES_256_GCM_SHA384) { ret record.AES_256_GCM; }
    if (valid_suite(suite)) { ret record.CHACHA20_POLY1305; }
    ret 0;
}

# an ecdsa suite authenticates with an ecdsa or eddsa certificate
pub fun suite_requires_ecdsa(suite: u16) bool {
    ret suite == ECDHE_ECDSA_AES_128_GCM_SHA256 ||
        suite == ECDHE_ECDSA_AES_256_GCM_SHA384 ||
        suite == ECDHE_ECDSA_CHACHA20_POLY1305;
}

test "tls12: suite properties are total and distinct" {
    if (VERSION != 0x0303 || MAX_PLAINTEXT != 16384) { ret 1; }
    if (valid_suite(0x1301) || valid_suite(0))       { ret 2; }
    if (suite_hash(ECDHE_RSA_AES_256_GCM_SHA384) != key_schedule.SHA384 ||
        suite_hash(ECDHE_RSA_AES_128_GCM_SHA256) != key_schedule.SHA256 ||
        suite_hash(0x1301) != 0) { ret 3; }
    if (suite_key_size(ECDHE_RSA_AES_128_GCM_SHA256) != 16 ||
        suite_key_size(ECDHE_ECDSA_CHACHA20_POLY1305) != 32 ||
        suite_key_size(0) != 0) { ret 4; }
    if (suite_iv_size(ECDHE_RSA_AES_128_GCM_SHA256) != 4 ||
        suite_iv_size(ECDHE_RSA_CHACHA20_POLY1305) != 12) { ret 5; }
    if (suite_aead(ECDHE_ECDSA_AES_256_GCM_SHA384) != record.AES_256_GCM ||
        suite_aead(ECDHE_RSA_CHACHA20_POLY1305) !=
        record.CHACHA20_POLY1305) { ret 6; }
    if (!suite_requires_ecdsa(ECDHE_ECDSA_AES_128_GCM_SHA256) ||
        suite_requires_ecdsa(ECDHE_RSA_AES_128_GCM_SHA256)) { ret 7; }
    if (DOWNGRADE_TLS12[7] != 1 || DOWNGRADE_TLS11[7] != 0) { ret 8; }
    ret 0;
}
