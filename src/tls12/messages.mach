# borrowed typed views and transactional encoders for tls 1.2 messages

use crypto.contracts;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.error;
use tls.handshake;
use tls.handshake.extensions;
use tls.signature_scheme;
use tls.tls12;
use tls.tls13;

pub val NAMED_CURVE:   u8    = 3;
pub val MAX_POINT:     usize = 65;
pub val MAX_SIGNATURE: usize = 512;

pub val CERTIFICATE_TYPE_RSA:   u8 = 1;
pub val CERTIFICATE_TYPE_ECDSA: u8 = 64;

pub rec ClientHello {
    legacy_version:      u16;
    random:              contracts.Bytes;
    session_id:          contracts.Bytes;
    cipher_suites:       contracts.Bytes;
    compression_methods: contracts.Bytes;
    extensions:          extensions.List;
}

pub rec ServerHello {
    legacy_version:     u16;
    random:             contracts.Bytes;
    session_id:         contracts.Bytes;
    cipher_suite:       u16;
    compression_method: u8;
    extensions:         extensions.List;
}

pub rec CertificateMessage {
    entries: contracts.Bytes;
    count:   usize;
}

pub rec CertificateIterator {
    data:   *u8;
    len:    usize;
    offset: usize;
    failed: bool;
}

# params is the exact signed prefix: curve type, curve, and point
pub rec ServerKeyExchange {
    curve:      u16;
    public_key: contracts.Bytes;
    scheme:     u16;
    signature:  contracts.Bytes;
    params:     contracts.Bytes;
}

pub rec CertificateRequest {
    certificate_types:    contracts.Bytes;
    signature_algorithms: contracts.Bytes;
    authorities:          contracts.Bytes;
}

pub rec ClientKeyExchange {
    public_key: contracts.Bytes;
}

pub rec CertificateVerify {
    scheme:    u16;
    signature: contracts.Bytes;
}

pub rec Finished {
    verify_data: contracts.Bytes;
}

rec Reader {
    data:   *u8;
    len:    usize;
    offset: usize;
    failed: bool;
}

fun reader(data: *u8, len: usize) Reader {
    ret Reader{data: data, len: len, offset: 0, failed: len != 0 && data == nil};
}

fun remaining(state: *Reader) usize {
    if (state.failed || state.offset > state.len) { ret 0; }
    ret state.len - state.offset;
}

fun take(state: *Reader, length: usize) contracts.Bytes {
    if (state.failed || length > remaining(state)) {
        state.failed = true;
        ret contracts.Bytes{data: nil, len: 0};
    }
    var value: contracts.Bytes = contracts.Bytes{data: nil, len: length};
    if (length != 0) { value.data = ?state.data[state.offset]; }
    state.offset = state.offset + length;
    ret value;
}

fun u8_value(state: *Reader) u8 {
    val value: contracts.Bytes = take(state, 1);
    if (value.data == nil) { ret 0; }
    ret value.data[0];
}

fun u16_value(state: *Reader) u16 {
    val value: contracts.Bytes = take(state, 2);
    if (value.data == nil) { ret 0; }
    ret (value.data[0]::u16 << 8) | value.data[1]::u16;
}

fun u24_value(state: *Reader) usize {
    val value: contracts.Bytes = take(state, 3);
    if (value.data == nil) { ret 0; }
    ret (value.data[0]::usize << 16) | (value.data[1]::usize << 8) |
        value.data[2]::usize;
}

fun vector8(state: *Reader) contracts.Bytes {
    ret take(state, u8_value(state)::usize);
}

fun vector16(state: *Reader) contracts.Bytes {
    ret take(state, u16_value(state)::usize);
}

fun vector24(state: *Reader) contracts.Bytes {
    ret take(state, u24_value(state));
}

fun complete(state: *Reader) bool {
    ret !state.failed && state.offset == state.len;
}

rec Writer {
    data:     *u8;
    capacity: usize;
    offset:   usize;
}

fun put_u8(output: *Writer, value: u8) {
    if (output.offset >= output.capacity) { ret; }
    output.data[output.offset] = value;
    output.offset              = output.offset + 1;
}

fun put_u16(output: *Writer, value: u16) {
    put_u8(output, (value >> 8)::u8);
    put_u8(output, value::u8);
}

fun put_u24(output: *Writer, value: usize) {
    put_u8(output, (value >> 16)::u8);
    put_u8(output, (value >> 8)::u8);
    put_u8(output, value::u8);
}

fun put_bytes(output: *Writer, value: contracts.Bytes) {
    var i: usize = 0;
    for (i < value.len) {
        put_u8(output, value.data[i]);
        i = i + 1;
    }
}

fun result(status: handshake.ProgressStatus, produced: usize,
    required: usize, failure: error.Error) handshake.Progress {
    ret handshake.Progress{status: status, consumed: produced,
        produced: produced, required: required, error: failure};
}

fun prepare(message_type: handshake.MessageType, body_length: usize,
    output: contracts.Buffer, writer: *Writer) handshake.Progress {
    if (body_length > handshake.MAX_BODY_SIZE) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val required: usize = handshake.HEADER_SIZE + body_length;
    if (output.data == nil || output.capacity < required) {
        ret result(handshake.NEED_OUTPUT, 0, required, error.OK);
    }
    writer.data     = output.data;
    writer.capacity = output.capacity;
    writer.offset   = 0;
    put_u8(writer, message_type);
    put_u24(writer, body_length);
    ret result(handshake.PROGRESSED, 0, required, error.OK);
}

pub fun valid_signature_scheme(scheme: u16) bool {
    ret signature_scheme.valid_tls12(scheme);
}

pub val RSA_PKCS1_SHA256: u16 = signature_scheme.RSA_PKCS1_SHA256;
pub val RSA_PKCS1_SHA384: u16 = signature_scheme.RSA_PKCS1_SHA384;

pub fun valid_named_curve(curve: u16) bool {
    ret curve == tls13.X25519 || curve == tls13.SECP256R1;
}

fun valid_point(curve: u16, value: contracts.Bytes) bool {
    if (value.data == nil)     { ret false; }
    if (curve == tls13.X25519) { ret value.len == 32; }
    if (curve == tls13.SECP256R1) {
        ret value.len == 65 && value.data[0] == 4;
    }
    ret false;
}

pub fun decode_client_hello(message: *handshake.Message,
    output: *ClientHello) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.CLIENT_HELLO ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    var state: Reader = reader(message.body.data, message.body.len);
    output.legacy_version      = u16_value(?state);
    output.random              = take(?state, 32);
    output.session_id          = vector8(?state);
    output.cipher_suites       = vector16(?state);
    output.compression_methods = vector8(?state);
    var extension_bytes: contracts.Bytes = contracts.Bytes{data: nil, len: 0};
    if (remaining(?state) != 0) { extension_bytes = vector16(?state); }
    output.extensions = extensions.list(extension_bytes.data,
        extension_bytes.len, extensions.CLIENT_HELLO);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    if (output.random.len != 32 || output.session_id.len > 32 ||
        output.cipher_suites.len < 2 || (output.cipher_suites.len & 1) != 0 ||
        output.compression_methods.len == 0) { ret error.ILLEGAL_PARAMETER; }
    var null_compression: bool  = false;
    var i:                usize = 0;
    for (i < output.compression_methods.len) {
        if (output.compression_methods.data[i] == 0) { null_compression = true; }
        i = i + 1;
    }
    if (!null_compression)                     { ret error.ILLEGAL_PARAMETER; }
    if (output.legacy_version < tls12.VERSION) { ret error.PROTOCOL_VERSION; }
    ret extensions.validate(output.extensions);
}

pub fun decode_server_hello(message: *handshake.Message,
    output: *ServerHello) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.SERVER_HELLO ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    var state: Reader = reader(message.body.data, message.body.len);
    output.legacy_version     = u16_value(?state);
    output.random             = take(?state, 32);
    output.session_id         = vector8(?state);
    output.cipher_suite       = u16_value(?state);
    output.compression_method = u8_value(?state);
    var extension_bytes: contracts.Bytes = contracts.Bytes{data: nil, len: 0};
    if (remaining(?state) != 0) { extension_bytes = vector16(?state); }
    output.extensions = extensions.list(extension_bytes.data,
        extension_bytes.len, extensions.TLS12_SERVER_HELLO);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    if (output.random.len != 32 || output.session_id.len > 32) {
        ret error.ILLEGAL_PARAMETER;
    }
    if (output.legacy_version != tls12.VERSION) { ret error.PROTOCOL_VERSION; }
    if (output.compression_method != 0)         { ret error.ILLEGAL_PARAMETER; }
    ret extensions.validate(output.extensions);
}

pub fun encode_server_hello(value: *ServerHello,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || value.random.len != 32 || value.random.data == nil ||
        value.session_id.len > 32 || value.compression_method != 0 ||
        !tls12.valid_suite(value.cipher_suite) ||
        value.extensions.context != extensions.TLS12_SERVER_HELLO) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val validation: error.Error = extensions.validate(value.extensions);
    if (validation != error.OK) {
        ret result(handshake.REJECTED, 0, 0, validation);
    }
    val body: usize = 2 + 32 + 1 + value.session_id.len + 2 + 1 + 2 +
        value.extensions.len;
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.SERVER_HELLO, body,
        output, ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    put_u16(?writer, tls12.VERSION);
    put_bytes(?writer, value.random);
    put_u8(?writer, value.session_id.len::u8);
    put_bytes(?writer, value.session_id);
    put_u16(?writer, value.cipher_suite);
    put_u8(?writer, 0);
    put_u16(?writer, value.extensions.len::u16);
    put_bytes(?writer, contracts.Bytes{data: value.extensions.data,
        len: value.extensions.len});
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

fun inspect_certificate_entries(bytes: contracts.Bytes,
    count: *usize) error.Error {
    @count = 0;
    if (bytes.len == 0)    { ret error.OK; }
    if (bytes.data == nil) { ret error.DECODE_ERROR; }
    var offset:  usize = 0;
    var entries: usize = 0;
    for (offset < bytes.len) {
        if (bytes.len - offset < 3) { ret error.DECODE_ERROR; }
        val length: usize = (bytes.data[offset]::usize << 16) |
            (bytes.data[offset + 1]::usize << 8) | bytes.data[offset + 2]::usize;
        if (length == 0 || length > bytes.len - offset - 3) {
            ret error.DECODE_ERROR;
        }
        offset  = offset + 3 + length;
        entries = entries + 1;
    }
    if (offset != bytes.len) { ret error.DECODE_ERROR; }
    @count = entries;
    ret error.OK;
}

pub fun decode_certificate(message: *handshake.Message,
    output: *CertificateMessage) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.CERTIFICATE ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    var state: Reader = reader(message.body.data, message.body.len);
    output.entries = vector24(?state);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    ret inspect_certificate_entries(output.entries, ?output.count);
}

pub fun certificate_iterator(message: *CertificateMessage) CertificateIterator {
    ret CertificateIterator{data: message.entries.data,
        len: message.entries.len, offset: 0, failed: false};
}

pub fun next_certificate(state: *CertificateIterator,
    output: *contracts.Bytes) extensions.NextStatus {
    if (state == nil || output == nil || state.failed) {
        ret extensions.NEXT_INVALID;
    }
    if (state.offset == state.len) { ret extensions.NEXT_DONE; }
    if (state.len - state.offset < 3) {
        state.failed = true;
        ret extensions.NEXT_INVALID;
    }
    val length: usize = (state.data[state.offset]::usize << 16) |
        (state.data[state.offset + 1]::usize << 8) |
        state.data[state.offset + 2]::usize;
    if (length == 0 || length > state.len - state.offset - 3) {
        state.failed = true;
        ret extensions.NEXT_INVALID;
    }
    output[0] = contracts.Bytes{data: ?state.data[state.offset + 3],
        len: length};
    state.offset = state.offset + 3 + length;
    ret extensions.NEXT_ITEM;
}

pub fun encode_certificate(entries: contracts.Bytes,
    output: contracts.Buffer) handshake.Progress {
    var count:      usize       = 0;
    val validation: error.Error = inspect_certificate_entries(entries, ?count);
    if (validation != error.OK) {
        ret result(handshake.REJECTED, 0, 0, validation);
    }
    val body:   usize              = 3 + entries.len;
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.CERTIFICATE, body, output,
        ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    put_u24(?writer, entries.len);
    put_bytes(?writer, entries);
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun decode_server_key_exchange(message: *handshake.Message,
    output: *ServerKeyExchange) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.SERVER_KEY_EXCHANGE ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    var state:      Reader = reader(message.body.data, message.body.len);
    val curve_type: u8     = u8_value(?state);
    output.curve      = u16_value(?state);
    output.public_key = vector8(?state);
    val params_length: usize = state.offset;
    output.scheme    = u16_value(?state);
    output.signature = vector16(?state);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    if (curve_type != NAMED_CURVE || !valid_named_curve(output.curve) ||
        !valid_point(output.curve, output.public_key) ||
        !valid_signature_scheme(output.scheme) ||
        output.signature.len == 0 ||
        output.signature.len > MAX_SIGNATURE) { ret error.ILLEGAL_PARAMETER; }
    output.params = contracts.Bytes{data: message.body.data,
        len: params_length};
    ret error.OK;
}

pub fun encode_server_key_exchange(value: *ServerKeyExchange,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || !valid_named_curve(value.curve) ||
        !valid_point(value.curve, value.public_key) ||
        !valid_signature_scheme(value.scheme) ||
        value.signature.len == 0 || value.signature.len > MAX_SIGNATURE ||
        value.signature.data == nil) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val body: usize = 1 + 2 + 1 + value.public_key.len + 2 + 2 +
        value.signature.len;
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.SERVER_KEY_EXCHANGE, body,
        output, ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    put_u8(?writer, NAMED_CURVE);
    put_u16(?writer, value.curve);
    put_u8(?writer, value.public_key.len::u8);
    put_bytes(?writer, value.public_key);
    put_u16(?writer, value.scheme);
    put_u16(?writer, value.signature.len::u16);
    put_bytes(?writer, value.signature);
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

# the exact bytes a server key exchange signature covers
pub fun signed_params(client_random: contracts.Bytes,
    server_random: contracts.Bytes, params: contracts.Bytes, output: *u8,
    capacity: usize, length: *usize) bool {
    if (output == nil || length == nil || client_random.len != 32 ||
        server_random.len != 32 || params.data == nil ||
        capacity < 64 + params.len) { ret false; }
    var i: usize = 0;
    for (i < 32) {
        output[i] = client_random.data[i];
        i         = i + 1;
    }
    i = 0;
    for (i < 32) {
        output[32 + i] = server_random.data[i];
        i              = i + 1;
    }
    i = 0;
    for (i < params.len) {
        output[64 + i] = params.data[i];
        i              = i + 1;
    }
    @length = 64 + params.len;
    ret true;
}

pub fun decode_certificate_request(message: *handshake.Message,
    output: *CertificateRequest) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.CERTIFICATE_REQUEST ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    var state: Reader = reader(message.body.data, message.body.len);
    output.certificate_types    = vector8(?state);
    output.signature_algorithms = vector16(?state);
    output.authorities          = vector16(?state);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    if (output.certificate_types.len == 0 ||
        output.signature_algorithms.len < 2 ||
        (output.signature_algorithms.len & 1) != 0) {
        ret error.ILLEGAL_PARAMETER;
    }
    ret error.OK;
}

pub fun encode_certificate_request(value: *CertificateRequest,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || value.certificate_types.len == 0 ||
        value.certificate_types.len > 255 ||
        value.certificate_types.data == nil ||
        value.signature_algorithms.len < 2 ||
        (value.signature_algorithms.len & 1) != 0 ||
        value.signature_algorithms.data == nil) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val body: usize = 1 + value.certificate_types.len + 2 +
        value.signature_algorithms.len + 2 + value.authorities.len;
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.CERTIFICATE_REQUEST, body,
        output, ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    put_u8(?writer, value.certificate_types.len::u8);
    put_bytes(?writer, value.certificate_types);
    put_u16(?writer, value.signature_algorithms.len::u16);
    put_bytes(?writer, value.signature_algorithms);
    put_u16(?writer, value.authorities.len::u16);
    put_bytes(?writer, value.authorities);
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun decode_server_hello_done(message: *handshake.Message) error.Error {
    if (message == nil ||
        message.header.message_type != handshake.SERVER_HELLO_DONE) {
        ret error.UNEXPECTED_MESSAGE;
    }
    if (message.body.len != 0 || message.header.length != 0) {
        ret error.DECODE_ERROR;
    }
    ret error.OK;
}

pub fun encode_server_hello_done(output: contracts.Buffer) handshake.Progress {
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.SERVER_HELLO_DONE, 0,
        output, ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun decode_client_key_exchange(message: *handshake.Message, curve: u16,
    output: *ClientKeyExchange) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.CLIENT_KEY_EXCHANGE ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    var state: Reader = reader(message.body.data, message.body.len);
    output.public_key = vector8(?state);
    if (!complete(?state))                      { ret error.DECODE_ERROR; }
    if (!valid_point(curve, output.public_key)) { ret error.ILLEGAL_PARAMETER; }
    ret error.OK;
}

pub fun encode_client_key_exchange(value: contracts.Bytes,
    output: contracts.Buffer) handshake.Progress {
    if (value.data == nil || value.len == 0 || value.len > MAX_POINT) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.CLIENT_KEY_EXCHANGE,
        1 + value.len, output, ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    put_u8(?writer, value.len::u8);
    put_bytes(?writer, value);
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun decode_certificate_verify(message: *handshake.Message,
    output: *CertificateVerify) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.CERTIFICATE_VERIFY ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    var state: Reader = reader(message.body.data, message.body.len);
    output.scheme    = u16_value(?state);
    output.signature = vector16(?state);
    if (!complete(?state)) { ret error.DECODE_ERROR; }
    if (!valid_signature_scheme(output.scheme) || output.signature.len == 0 ||
        output.signature.len > MAX_SIGNATURE) { ret error.ILLEGAL_PARAMETER; }
    ret error.OK;
}

pub fun encode_certificate_verify(value: *CertificateVerify,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || !valid_signature_scheme(value.scheme) ||
        value.signature.len == 0 || value.signature.len > MAX_SIGNATURE ||
        value.signature.data == nil) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.CERTIFICATE_VERIFY,
        4 + value.signature.len, output, ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    put_u16(?writer, value.scheme);
    put_u16(?writer, value.signature.len::u16);
    put_bytes(?writer, value.signature);
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

pub fun decode_finished(message: *handshake.Message,
    output: *Finished) error.Error {
    if (message == nil || output == nil ||
        message.header.message_type != handshake.FINISHED ||
        message.body.len::u32 != message.header.length) {
        ret error.UNEXPECTED_MESSAGE;
    }
    if (message.body.len != tls12.VERIFY_DATA_SIZE) { ret error.DECODE_ERROR; }
    output.verify_data = message.body;
    ret error.OK;
}

pub fun encode_finished(value: contracts.Bytes,
    output: contracts.Buffer) handshake.Progress {
    if (value.data == nil || value.len != tls12.VERIFY_DATA_SIZE) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    ret handshake.serialize_version(handshake.FINISHED, value, true, output);
}

pub fun encode_client_hello(value: *ClientHello,
    output: contracts.Buffer) handshake.Progress {
    if (value == nil || value.random.len != 32 || value.random.data == nil ||
        value.session_id.len > 32 || value.cipher_suites.len < 2 ||
        (value.cipher_suites.len & 1) != 0 ||
        value.cipher_suites.data == nil ||
        value.compression_methods.len == 0 ||
        value.compression_methods.data == nil ||
        value.extensions.context != extensions.CLIENT_HELLO) {
        ret result(handshake.REJECTED, 0, 0, error.ILLEGAL_PARAMETER);
    }
    val validation: error.Error = extensions.validate(value.extensions);
    if (validation != error.OK) {
        ret result(handshake.REJECTED, 0, 0, validation);
    }
    val body: usize = 2 + 32 + 1 + value.session_id.len + 2 +
        value.cipher_suites.len + 1 + value.compression_methods.len + 2 +
        value.extensions.len;
    var writer: Writer;
    val ready:  handshake.Progress = prepare(handshake.CLIENT_HELLO, body,
        output, ?writer);
    if (ready.status != handshake.PROGRESSED) { ret ready; }
    put_u16(?writer, tls12.VERSION);
    put_bytes(?writer, value.random);
    put_u8(?writer, value.session_id.len::u8);
    put_bytes(?writer, value.session_id);
    put_u16(?writer, value.cipher_suites.len::u16);
    put_bytes(?writer, value.cipher_suites);
    put_u8(?writer, value.compression_methods.len::u8);
    put_bytes(?writer, value.compression_methods);
    put_u16(?writer, value.extensions.len::u16);
    put_bytes(?writer, contracts.Bytes{data: value.extensions.data,
        len: value.extensions.len});
    ret result(handshake.COMPLETE, writer.offset, writer.offset, error.OK);
}

test tls12_codec__the_server_flight_round_trips_through_exact_framing {
    var random: [32]u8;
    var i:      usize = 0;
    for (i < 32) {
        random[i] = (0x40 + i)::u8;
        i         = i + 1;
    }
    var extension_bytes: [8]u8 = [8]u8{0, 23, 0, 0, 0xff, 0x01, 0, 1};
    var wire:            [512]u8;
    var hello:           ServerHello;
    hello.legacy_version     = tls12.VERSION;
    hello.random             = contracts.Bytes{data: ?random[0], len: 32};
    hello.session_id         = contracts.Bytes{data: nil, len: 0};
    hello.cipher_suite       = tls12.ECDHE_RSA_AES_128_GCM_SHA256;
    hello.compression_method = 0;
    hello.extensions         = extensions.list(?extension_bytes[0], 9,
        extensions.TLS12_SERVER_HELLO);
    # a truncated renegotiation_info body is refused
    if (encode_server_hello(?hello,
        contracts.Buffer{data: ?wire[0], capacity: 512}).status !=
        handshake.REJECTED) { ret 1; }
    hello.extensions = extensions.list(?extension_bytes[0], 9,
        extensions.TLS12_SERVER_HELLO);
    extension_bytes[7] = 1;
    var body: [1]u8 = [1]u8{0};
    var full: [9]u8 = [9]u8{0, 23, 0, 0, 0xff, 0x01, 0, 1, 0};
    hello.extensions = extensions.list(?full[0], 9,
        extensions.TLS12_SERVER_HELLO);
    val encoded: handshake.Progress = encode_server_hello(?hello,
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (encoded.status != handshake.COMPLETE) { ret 2; }
    var message: handshake.Message;
    if (handshake.parse_version(?wire[0], encoded.produced, 4096, true,
        ?message).status != handshake.COMPLETE) { ret 3; }
    var decoded: ServerHello;
    if (decode_server_hello(?message, ?decoded) != error.OK) { ret 4; }
    if (decoded.cipher_suite != tls12.ECDHE_RSA_AES_128_GCM_SHA256 ||
        decoded.random.len != 32 || decoded.extensions.len != 9) { ret 5; }
    var found: extensions.Extension;
    if (!extensions.find(decoded.extensions, extensions.EXTENDED_MASTER_SECRET,
        ?found) || found.len != 0) { ret 6; }
    if (!extensions.find(decoded.extensions, extensions.RENEGOTIATION_INFO,
        ?found) || found.len != 1) { ret 7; }

    var point: [65]u8;
    point[0] = 4;
    i        = 1;
    for (i < 65) {
        point[i] = (0x10 + i)::u8;
        i        = i + 1;
    }
    var signature_bytes: [64]u8;
    i = 0;
    for (i < 64) {
        signature_bytes[i] = (0x70 + i)::u8;
        i                  = i + 1;
    }
    var exchange: ServerKeyExchange;
    exchange.curve      = tls13.SECP256R1;
    exchange.public_key = contracts.Bytes{data: ?point[0], len: 65};
    exchange.scheme     = tls13.ECDSA_SECP256R1_SHA256;
    exchange.signature  = contracts.Bytes{data: ?signature_bytes[0], len: 64};
    val exchange_encoded: handshake.Progress = encode_server_key_exchange(
        ?exchange, contracts.Buffer{data: ?wire[0], capacity: 512});
    if (exchange_encoded.status != handshake.COMPLETE) { ret 8; }
    if (handshake.parse_version(?wire[0], exchange_encoded.produced, 4096, true,
        ?message).status != handshake.COMPLETE) { ret 9; }
    var exchange_decoded: ServerKeyExchange;
    if (decode_server_key_exchange(?message, ?exchange_decoded) != error.OK) {
        ret 10;
    }
    # the signed prefix is exactly curve type, curve, and point
    if (exchange_decoded.params.len != 1 + 2 + 1 + 65) { ret 11; }
    if (exchange_decoded.curve != tls13.SECP256R1 ||
        exchange_decoded.public_key.len != 65 ||
        exchange_decoded.signature.len != 64) { ret 12; }
    # a point of the wrong length for its curve is refused
    wire[8] = 3;
    if (decode_server_key_exchange(?message, ?exchange_decoded) == error.OK) {
        ret 13;
    }

    val done: handshake.Progress = encode_server_hello_done(
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (done.status != handshake.COMPLETE || done.produced != 4) { ret 14; }
    if (handshake.parse_version(?wire[0], 4, 4096, true, ?message).status !=
        handshake.COMPLETE || decode_server_hello_done(?message) != error.OK) {
        ret 15;
    }

    var verify_bytes: [12]u8;
    i = 0;
    for (i < 12) {
        verify_bytes[i] = (0xc0 + i)::u8;
        i               = i + 1;
    }
    val finished: handshake.Progress = encode_finished(
        contracts.Bytes{data: ?verify_bytes[0], len: 12},
        contracts.Buffer{data: ?wire[0], capacity: 512});
    if (finished.status != handshake.COMPLETE || finished.produced != 16) {
        ret 16;
    }
    if (handshake.parse_version(?wire[0], 16, 4096, true, ?message).status !=
        handshake.COMPLETE) { ret 17; }
    var finished_decoded: Finished;
    if (decode_finished(?message, ?finished_decoded) != error.OK ||
        finished_decoded.verify_data.len != 12) { ret 18; }
    ret 0;
}

test tls12_codec__p_384_server_key_exchange_preserves_scheme_0x0503 {
    var point: [65]u8;
    point[0] = 4;
    var i: usize = 1;
    for (i < 65) {
        point[i] = i::u8;
        i        = i + 1;
    }
    var signature_bytes: [8]u8 = [8]u8{0x30, 6, 2, 1, 1, 2, 1, 1};
    var exchange:        ServerKeyExchange;
    exchange.curve      = tls13.SECP256R1;
    exchange.public_key = contracts.Bytes{data: ?point[0], len: 65};
    exchange.scheme     = tls13.ECDSA_SECP384R1_SHA384;
    exchange.signature  = contracts.Bytes{data: ?signature_bytes[0], len: 8};
    var wire:    [85]u8;
    val encoded: handshake.Progress = encode_server_key_exchange(?exchange,
        contracts.Buffer{data: ?wire[0], capacity: 85});
    if (encoded.status != handshake.COMPLETE || encoded.produced != 85 ||
        wire[73] != 0x05 || wire[74] != 0x03) { ret 1; }
    var message: handshake.Message;
    if (handshake.parse_version(?wire[0], 85, 85, true, ?message).status !=
        handshake.COMPLETE) { ret 2; }
    var decoded: ServerKeyExchange;
    if (decode_server_key_exchange(?message, ?decoded) != error.OK ||
        decoded.scheme != tls13.ECDSA_SECP384R1_SHA384 ||
        decoded.signature.len != 8) { ret 3; }
    wire[74] = 0x04;
    if (handshake.parse_version(?wire[0], 85, 85, true, ?message).status !=
        handshake.COMPLETE) { ret 4; }
    val rejected: error.Error = decode_server_key_exchange(?message,
        ?decoded);
    if (rejected != error.ILLEGAL_PARAMETER) { ret 5; }
    ret 0;
}
