# tls 1.2 pseudorandom function and its derived secrets

use crypto.contracts;
use crypto.hkdf;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.error;
use tls.tls12;
use tls.tls13.key_schedule;

pub val MAX_HASH: usize = 48;
pub val MAX_SEED: usize = 128;
pub val MAX_OUTPUT: usize = 128;
pub val MAX_KEY: usize = 32;
pub val MAX_IV: usize = 12;
pub val RANDOM_SIZE: usize = 32;

# the complete secret state of one tls 1.2 connection
pub rec Secrets {
    algorithm: key_schedule.HashAlgorithm;
    suite: u16;
    master: [tls12.MASTER_SECRET_SIZE]^u8;
    client_key: [MAX_KEY]^u8;
    server_key: [MAX_KEY]^u8;
    client_iv: [MAX_IV]u8;
    server_iv: [MAX_IV]u8;
    key_len: usize;
    iv_len: usize;
    master_ready: bool;
    keys_ready: bool;
}

pub fun empty() Secrets {
    var value: Secrets;
    value.algorithm = 0;
    value.suite = 0;
    value.key_len = 0;
    value.iv_len = 0;
    value.master_ready = false;
    value.keys_ready = false;
    ct.zeroize(?value.master[0], tls12.MASTER_SECRET_SIZE);
    ct.zeroize(?value.client_key[0], MAX_KEY);
    ct.zeroize(?value.server_key[0], MAX_KEY);
    var i: usize = 0;
    for (i < MAX_IV) {
        value.client_iv[i] = 0;
        value.server_iv[i] = 0;
        i = i + 1;
    }
    ret value;
}

pub fun destroy(value: *Secrets) {
    if (value == nil) { ret; }
    ct.zeroize(?value.master[0], tls12.MASTER_SECRET_SIZE);
    ct.zeroize(?value.client_key[0], MAX_KEY);
    ct.zeroize(?value.server_key[0], MAX_KEY);
    var i: usize = 0;
    for (i < MAX_IV) {
        value.client_iv[i] = 0;
        value.server_iv[i] = 0;
        i = i + 1;
    }
    value.algorithm = 0;
    value.suite = 0;
    value.key_len = 0;
    value.iv_len = 0;
    value.master_ready = false;
    value.keys_ready = false;
}

pub fun bytes(value: *Secrets) contracts.SecretBytes {
    if (value == nil || !value.master_ready) {
        ret contracts.SecretBytes{data: nil, len: 0};
    }
    ret contracts.SecretBytes{data: ?value.master[0],
        len: tls12.MASTER_SECRET_SIZE};
}

# hmac with a secret key and a secret message; hkdf extract is exactly that
fun mac(algorithm: key_schedule.HashAlgorithm, key: contracts.SecretBytes,
    message: contracts.SecretBytes, output: *^u8) bool {
    var operation: contracts.Operation;
    if (algorithm == key_schedule.SHA256) {
        operation = hkdf.extract_sha256(key, message,
            contracts.SecretBuffer{data: output, capacity: 32});
    } or (algorithm == key_schedule.SHA384) {
        operation = hkdf.extract_sha384(key, message,
            contracts.SecretBuffer{data: output, capacity: 48});
    } or { ret false; }
    ret operation.error == contracts.OK &&
        operation.written == key_schedule.hash_size(algorithm);
}

# P_hash from RFC 5246 section 5, with every intermediate held secret
fun p_hash(algorithm: key_schedule.HashAlgorithm, secret: contracts.SecretBytes,
    seed: *^u8, seed_len: usize, output: *^u8, output_len: usize) bool {
    val size: usize = key_schedule.hash_size(algorithm);
    if (size == 0 || seed_len > MAX_SEED || output_len == 0 ||
        output_len > MAX_OUTPUT) { ret false; }
    var current: [MAX_HASH]^u8;
    var next: [MAX_HASH]^u8;
    var block_input: [MAX_HASH + MAX_SEED]^u8;
    var block: [MAX_HASH]^u8;
    ct.zeroize(?current[0], MAX_HASH);
    ct.zeroize(?next[0], MAX_HASH);
    ct.zeroize(?block[0], MAX_HASH);
    ct.zeroize(?block_input[0], MAX_HASH + MAX_SEED);
    if (!mac(algorithm, secret,
            contracts.SecretBytes{data: seed, len: seed_len}, ?current[0])) {
        ct.zeroize(?current[0], MAX_HASH);
        ret false;
    }
    var written: usize = 0;
    var rounds: usize = 0;
    for (written < output_len) {
        if (rounds > MAX_OUTPUT) { brk; }
        var i: usize = 0;
        for (i < size) { block_input[i] = current[i]; i = i + 1; }
        i = 0;
        for (i < seed_len) { block_input[size + i] = seed[i]; i = i + 1; }
        if (!mac(algorithm, secret,
                contracts.SecretBytes{data: ?block_input[0],
                    len: size + seed_len}, ?block[0])) {
            ct.zeroize(?current[0], MAX_HASH);
            ct.zeroize(?next[0], MAX_HASH);
            ct.zeroize(?block[0], MAX_HASH);
            ct.zeroize(?block_input[0], MAX_HASH + MAX_SEED);
            ret false;
        }
        var amount: usize = size;
        if (amount > output_len - written) { amount = output_len - written; }
        i = 0;
        for (i < amount) { output[written + i] = block[i]; i = i + 1; }
        written = written + amount;
        if (written < output_len) {
            if (!mac(algorithm, secret,
                    contracts.SecretBytes{data: ?current[0], len: size},
                    ?next[0])) {
                ct.zeroize(?current[0], MAX_HASH);
                ct.zeroize(?next[0], MAX_HASH);
                ct.zeroize(?block[0], MAX_HASH);
                ct.zeroize(?block_input[0], MAX_HASH + MAX_SEED);
                ret false;
            }
            i = 0;
            for (i < size) { current[i] = next[i]; i = i + 1; }
        }
        rounds = rounds + 1;
    }
    ct.zeroize(?current[0], MAX_HASH);
    ct.zeroize(?next[0], MAX_HASH);
    ct.zeroize(?block[0], MAX_HASH);
    ct.zeroize(?block_input[0], MAX_HASH + MAX_SEED);
    ret written == output_len;
}

# PRF(secret, label, seed) with the label and seed supplied publicly
pub fun prf(algorithm: key_schedule.HashAlgorithm, secret: contracts.SecretBytes,
    label: contracts.Bytes, seed_first: contracts.Bytes,
    seed_second: contracts.Bytes, output: contracts.SecretBuffer) error.Error {
    val total: usize = label.len + seed_first.len + seed_second.len;
    if (key_schedule.hash_size(algorithm) == 0 || secret.data == nil ||
        secret.len == 0 || label.len == 0 || label.data == nil ||
        (seed_first.len != 0 && seed_first.data == nil) ||
        (seed_second.len != 0 && seed_second.data == nil) ||
        total > MAX_SEED || output.data == nil || output.capacity == 0 ||
        output.capacity > MAX_OUTPUT) { ret error.ILLEGAL_PARAMETER; }
    var seed: [MAX_SEED]^u8;
    ct.zeroize(?seed[0], MAX_SEED);
    var i: usize = 0;
    for (i < label.len) { seed[i] = label.data[i]; i = i + 1; }
    i = 0;
    for (i < seed_first.len) { seed[label.len + i] = seed_first.data[i]; i = i + 1; }
    i = 0;
    for (i < seed_second.len) {
        seed[label.len + seed_first.len + i] = seed_second.data[i];
        i = i + 1;
    }
    val expanded: bool = p_hash(algorithm, secret, ?seed[0], total, output.data,
        output.capacity);
    ct.zeroize(?seed[0], MAX_SEED);
    if (!expanded) { ret error.INTERNAL_ERROR; }
    ret error.OK;
}

fun prepare(value: *Secrets, suite: u16) error.Error {
    val algorithm: key_schedule.HashAlgorithm = tls12.suite_hash(suite);
    if (value == nil || value.master_ready || algorithm == 0 ||
        !tls12.valid_suite(suite)) { ret error.ILLEGAL_PARAMETER; }
    value.algorithm = algorithm;
    value.suite = suite;
    value.key_len = tls12.suite_key_size(suite);
    value.iv_len = tls12.suite_iv_size(suite);
    ret error.OK;
}

# the RFC 7627 master secret, bound to the handshake that produced it
pub fun extended_master_secret(value: *Secrets, suite: u16,
    pre_master: contracts.SecretBytes,
    session_hash: contracts.Bytes) error.Error {
    val prepared: error.Error = prepare(value, suite);
    if (prepared != error.OK) { ret prepared; }
    if (session_hash.data == nil ||
        session_hash.len != key_schedule.hash_size(value.algorithm)) {
        ret error.ILLEGAL_PARAMETER;
    }
    val derived: error.Error = prf(value.algorithm, pre_master,
        contracts.Bytes{data: "extended master secret"::*u8, len: 22},
        session_hash, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBuffer{data: ?value.master[0],
            capacity: tls12.MASTER_SECRET_SIZE});
    if (derived != error.OK) {
        ct.zeroize(?value.master[0], tls12.MASTER_SECRET_SIZE);
        ret derived;
    }
    value.master_ready = true;
    ret error.OK;
}

# the RFC 5246 master secret, kept for peers that refuse the extension
pub fun legacy_master_secret(value: *Secrets, suite: u16,
    pre_master: contracts.SecretBytes, client_random: contracts.Bytes,
    server_random: contracts.Bytes) error.Error {
    val prepared: error.Error = prepare(value, suite);
    if (prepared != error.OK) { ret prepared; }
    if (client_random.len != RANDOM_SIZE || server_random.len != RANDOM_SIZE) {
        ret error.ILLEGAL_PARAMETER;
    }
    val derived: error.Error = prf(value.algorithm, pre_master,
        contracts.Bytes{data: "master secret"::*u8, len: 13}, client_random,
        server_random, contracts.SecretBuffer{data: ?value.master[0],
            capacity: tls12.MASTER_SECRET_SIZE});
    if (derived != error.OK) {
        ct.zeroize(?value.master[0], tls12.MASTER_SECRET_SIZE);
        ret derived;
    }
    value.master_ready = true;
    ret error.OK;
}

# key_block = PRF(master, "key expansion", server_random + client_random)
pub fun derive_keys(value: *Secrets, client_random: contracts.Bytes,
    server_random: contracts.Bytes) error.Error {
    if (value == nil || !value.master_ready || value.keys_ready ||
        client_random.len != RANDOM_SIZE ||
        server_random.len != RANDOM_SIZE) { ret error.ILLEGAL_PARAMETER; }
    val required: usize = value.key_len * 2 + value.iv_len * 2;
    if (required == 0 || required > MAX_OUTPUT) { ret error.ILLEGAL_PARAMETER; }
    var block: [MAX_OUTPUT]^u8;
    ct.zeroize(?block[0], MAX_OUTPUT);
    val derived: error.Error = prf(value.algorithm, bytes(value),
        contracts.Bytes{data: "key expansion"::*u8, len: 13}, server_random,
        client_random, contracts.SecretBuffer{data: ?block[0],
            capacity: required});
    if (derived != error.OK) {
        ct.zeroize(?block[0], MAX_OUTPUT);
        ret derived;
    }
    var i: usize = 0;
    for (i < value.key_len) {
        value.client_key[i] = block[i];
        value.server_key[i] = block[value.key_len + i];
        i = i + 1;
    }
    val iv_offset: usize = value.key_len * 2;
    i = 0;
    for (i < value.iv_len) {
        value.client_iv[i] = block[iv_offset + i]:>u8;
        value.server_iv[i] = block[iv_offset + value.iv_len + i]:>u8;
        i = i + 1;
    }
    ct.zeroize(?block[0], MAX_OUTPUT);
    value.keys_ready = true;
    ret error.OK;
}

pub fun key_bytes(value: *Secrets, from_client: bool) contracts.SecretBytes {
    if (value == nil || !value.keys_ready) {
        ret contracts.SecretBytes{data: nil, len: 0};
    }
    if (from_client) {
        ret contracts.SecretBytes{data: ?value.client_key[0], len: value.key_len};
    }
    ret contracts.SecretBytes{data: ?value.server_key[0], len: value.key_len};
}

pub fun iv_bytes(value: *Secrets, from_client: bool) contracts.Bytes {
    if (value == nil || !value.keys_ready) {
        ret contracts.Bytes{data: nil, len: 0};
    }
    if (from_client) {
        ret contracts.Bytes{data: ?value.client_iv[0], len: value.iv_len};
    }
    ret contracts.Bytes{data: ?value.server_iv[0], len: value.iv_len};
}

# verify_data = PRF(master, "client finished" | "server finished", hash)
pub fun verify_data(value: *Secrets, from_client: bool,
    transcript_hash: contracts.Bytes, output: contracts.Buffer) error.Error {
    if (value == nil || !value.master_ready || output.data == nil ||
        output.capacity < tls12.VERIFY_DATA_SIZE ||
        transcript_hash.data == nil ||
        transcript_hash.len != key_schedule.hash_size(value.algorithm)) {
        ret error.ILLEGAL_PARAMETER;
    }
    var label: contracts.Bytes = contracts.Bytes{
        data: "server finished"::*u8, len: 15};
    if (from_client) {
        label = contracts.Bytes{data: "client finished"::*u8, len: 15};
    }
    var produced: [tls12.VERIFY_DATA_SIZE]^u8;
    ct.zeroize(?produced[0], tls12.VERIFY_DATA_SIZE);
    val derived: error.Error = prf(value.algorithm, bytes(value), label,
        transcript_hash, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBuffer{data: ?produced[0],
            capacity: tls12.VERIFY_DATA_SIZE});
    if (derived != error.OK) {
        ct.zeroize(?produced[0], tls12.VERIFY_DATA_SIZE);
        ret derived;
    }
    var i: usize = 0;
    for (i < tls12.VERIFY_DATA_SIZE) { output.data[i] = produced[i]:>u8; i = i + 1; }
    ct.zeroize(?produced[0], tls12.VERIFY_DATA_SIZE);
    ret error.OK;
}

pub fun verify_data_matches(value: *Secrets, from_client: bool,
    transcript_hash: contracts.Bytes, offered: contracts.Bytes) bool {
    if (offered.data == nil || offered.len != tls12.VERIFY_DATA_SIZE) {
        ret false;
    }
    var expected: [tls12.VERIFY_DATA_SIZE]u8;
    if (verify_data(value, from_client, transcript_hash,
        contracts.Buffer{data: ?expected[0],
            capacity: tls12.VERIFY_DATA_SIZE}) != error.OK) {
        ret false;
    }
    var difference: u8 = 0;
    var i: usize = 0;
    for (i < tls12.VERIFY_DATA_SIZE) {
        difference = difference | (expected[i] ^ offered.data[i]);
        expected[i] = 0;
        i = i + 1;
    }
    ret difference == 0;
}

test "tls12.prf: rfc 5246 test vector reproduces the expected output" {
    # the widely used SHA-256 PRF vector: secret, label "test label", seed
    var secret_bytes: [16]^u8 = [16]^u8{
        0x9b, 0xbe, 0x43, 0x6b, 0xa9, 0x40, 0xf0, 0x17,
        0xb1, 0x76, 0x52, 0x84, 0x9a, 0x71, 0xdb, 0x35};
    var seed_bytes: [16]u8 = [16]u8{
        0xa0, 0xba, 0x9f, 0x93, 0x6c, 0xda, 0x31, 0x18,
        0x27, 0xa6, 0xf7, 0x96, 0xff, 0xd5, 0x19, 0x8c};
    var expected: [100]u8 = [100]u8{
        0xe3, 0xf2, 0x29, 0xba, 0x72, 0x7b, 0xe1, 0x7b,
        0x8d, 0x12, 0x26, 0x20, 0x55, 0x7c, 0xd4, 0x53,
        0xc2, 0xaa, 0xb2, 0x1d, 0x07, 0xc3, 0xd4, 0x95,
        0x32, 0x9b, 0x52, 0xd4, 0xe6, 0x1e, 0xdb, 0x5a,
        0x6b, 0x30, 0x17, 0x91, 0xe9, 0x0d, 0x35, 0xc9,
        0xc9, 0xa4, 0x6b, 0x4e, 0x14, 0xba, 0xf9, 0xaf,
        0x0f, 0xa0, 0x22, 0xf7, 0x07, 0x7d, 0xef, 0x17,
        0xab, 0xfd, 0x37, 0x97, 0xc0, 0x56, 0x4b, 0xab,
        0x4f, 0xbc, 0x91, 0x66, 0x6e, 0x9d, 0xef, 0x9b,
        0x97, 0xfc, 0xe3, 0x4f, 0x79, 0x67, 0x89, 0xba,
        0xa4, 0x80, 0x82, 0xd1, 0x22, 0xee, 0x42, 0xc5,
        0xa7, 0x2e, 0x5a, 0x51, 0x10, 0xff, 0xf7, 0x01,
        0x87, 0x34, 0x7b, 0x66};
    var output: [100]^u8;
    if (prf(key_schedule.SHA256,
            contracts.SecretBytes{data: ?secret_bytes[0], len: 16},
            contracts.Bytes{data: "test label"::*u8, len: 10},
            contracts.Bytes{data: ?seed_bytes[0], len: 16},
            contracts.Bytes{data: nil, len: 0},
            contracts.SecretBuffer{data: ?output[0], capacity: 100}) !=
        error.OK) { ret 1; }
    var i: usize = 0;
    for (i < 100) {
        if (output[i]:>u8 != expected[i]) { ret 2; }
        i = i + 1;
    }
    ct.zeroize(?output[0], 100);
    ct.zeroize(?secret_bytes[0], 16);
    ret 0;
}

test "tls12.prf: derived keys and finished values are suite exact" {
    var pre_master: [32]^u8;
    var i: usize = 0;
    for (i < 32) { pre_master[i] = (0x20 + i)::u8; i = i + 1; }
    var session_hash: [32]u8;
    for (i < 32) { session_hash[i] = (0x60 + i)::u8; i = i + 1; }
    var client_random: [32]u8;
    var server_random: [32]u8;
    i = 0;
    for (i < 32) {
        client_random[i] = (0x01 + i)::u8;
        server_random[i] = (0x81 + i)::u8;
        i = i + 1;
    }
    var value: Secrets = empty();
    if (extended_master_secret(?value, tls12.ECDHE_RSA_AES_128_GCM_SHA256,
            contracts.SecretBytes{data: ?pre_master[0], len: 32},
            contracts.Bytes{data: ?session_hash[0], len: 32}) != error.OK) {
        ret 1;
    }
    if (!value.master_ready || value.key_len != 16 || value.iv_len != 4) {
        ret 2;
    }
    if (derive_keys(?value, contracts.Bytes{data: ?client_random[0], len: 32},
            contracts.Bytes{data: ?server_random[0], len: 32}) != error.OK ||
        !value.keys_ready) { ret 3; }
    # the two directions never share key material
    var identical: bool = true;
    i = 0;
    for (i < 16) {
        if (value.client_key[i]:>u8 != value.server_key[i]:>u8) { identical = false; }
        i = i + 1;
    }
    if (identical) { ret 4; }
    identical = true;
    i = 0;
    for (i < 4) {
        if (value.client_iv[i] != value.server_iv[i]) { identical = false; }
        i = i + 1;
    }
    if (identical) { ret 5; }

    var transcript: [32]u8;
    i = 0;
    for (i < 32) { transcript[i] = (0xa0 + i)::u8; i = i + 1; }
    var client_finished: [12]u8;
    var server_finished: [12]u8;
    val hash_bytes: contracts.Bytes = contracts.Bytes{data: ?transcript[0],
        len: 32};
    if (verify_data(?value, true, hash_bytes,
            contracts.Buffer{data: ?client_finished[0], capacity: 12}) !=
        error.OK ||
        verify_data(?value, false, hash_bytes,
            contracts.Buffer{data: ?server_finished[0], capacity: 12}) !=
        error.OK) { ret 6; }
    identical = true;
    i = 0;
    for (i < 12) {
        if (client_finished[i] != server_finished[i]) { identical = false; }
        i = i + 1;
    }
    if (identical) { ret 7; }
    if (!verify_data_matches(?value, true, hash_bytes,
            contracts.Bytes{data: ?client_finished[0], len: 12})) { ret 8; }
    if (verify_data_matches(?value, false, hash_bytes,
            contracts.Bytes{data: ?client_finished[0], len: 12})) { ret 9; }
    client_finished[0] = client_finished[0] ^ 0x01;
    if (verify_data_matches(?value, true, hash_bytes,
            contracts.Bytes{data: ?client_finished[0], len: 12})) { ret 10; }

    # a legacy master secret differs from the extended one for the same inputs
    var legacy: Secrets = empty();
    if (legacy_master_secret(?legacy, tls12.ECDHE_RSA_AES_128_GCM_SHA256,
            contracts.SecretBytes{data: ?pre_master[0], len: 32},
            contracts.Bytes{data: ?client_random[0], len: 32},
            contracts.Bytes{data: ?server_random[0], len: 32}) != error.OK) {
        ret 11;
    }
    identical = true;
    i = 0;
    for (i < tls12.MASTER_SECRET_SIZE) {
        if (legacy.master[i]:>u8 != value.master[i]:>u8) { identical = false; }
        i = i + 1;
    }
    if (identical) { ret 12; }
    destroy(?value);
    destroy(?legacy);
    ct.zeroize(?pre_master[0], 32);
    ret 0;
}
