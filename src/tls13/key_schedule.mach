# rfc 8446 hkdf key schedule over caller-owned secret state

use crypto.contracts;
use crypto.hkdf;
use crypto.hmac;
use tls.error;
use tls.tls13;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def HashAlgorithm: u8;
pub def Stage: u8;

pub val SHA256: HashAlgorithm = 1;
pub val SHA384: HashAlgorithm = 2;

pub val EMPTY:       Stage = 0;
pub val EARLY:       Stage = 1;
pub val HANDSHAKE:   Stage = 2;
pub val APPLICATION: Stage = 3;
pub val DESTROYED:   Stage = 4;

pub val MAX_HASH_SIZE: usize = 48;
pub val IV_SIZE: usize = 12;
pub val LABEL_PREFIX_SIZE: usize = 6;
pub val MAX_LABEL_SIZE: usize = 249;
pub val MAX_CONTEXT_SIZE: usize = 255;
pub val MAX_INFO_SIZE: usize = 2 + 1 + 255 + 1 + 255;

val EMPTY_SHA256: [32]u8 = [32]u8{
    0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
    0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
    0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
    0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55,
};

val EMPTY_SHA384: [48]u8 = [48]u8{
    0x38, 0xb0, 0x60, 0xa7, 0x51, 0xac, 0x96, 0x38,
    0x4c, 0xd9, 0x32, 0x7e, 0xb1, 0xb1, 0xe3, 0x6a,
    0x21, 0xfd, 0xb7, 0x11, 0x14, 0xbe, 0x07, 0x43,
    0x4c, 0x0c, 0xc7, 0xbf, 0x63, 0xf6, 0xe1, 0xda,
    0x27, 0x4e, 0xde, 0xbf, 0xe7, 0x6f, 0x65, 0xfb,
    0xd5, 0x1a, 0xd2, 0xf1, 0x48, 0x98, 0xb9, 0x5b,
};

pub rec Secret {
    data:   [48]^u8;
    len:    usize;
    active: bool;
}

pub rec Schedule {
    suite:                       tls13.CipherSuite;
    algorithm:                   HashAlgorithm;
    stage:                       Stage;
    early_secret:                Secret;
    client_early_traffic:        Secret;
    early_exporter_master:       Secret;
    handshake_secret:            Secret;
    client_handshake_traffic:    Secret;
    server_handshake_traffic:    Secret;
    master_secret:               Secret;
    client_application_traffic:  Secret;
    server_application_traffic:  Secret;
    exporter_master:             Secret;
    resumption_master:           Secret;
    early_traffic_ready:         bool;
    resumption_ready:            bool;
}

fun crypto_failure(operation: contracts.Operation) error.Error {
    if (operation.error == contracts.OUTPUT_TOO_SMALL) { ret error.RESOURCE_LIMIT; }
    if (operation.error == contracts.INVALID_INPUT || operation.error == contracts.INVALID_KEY) {
        ret error.ILLEGAL_PARAMETER;
    }
    ret error.INTERNAL_ERROR;
}

fun zero_public(data: *u8, length: usize) {
    if (data == nil) { ret; }
    var i: usize = 0;
    for (i < length) { data[i] = 0; i = i + 1; }
}

pub fun algorithm_for_suite(suite: tls13.CipherSuite) HashAlgorithm {
    if (suite == tls13.AES_128_GCM_SHA256
        || suite == tls13.CHACHA20_POLY1305_SHA256) { ret SHA256; }
    if (suite == tls13.AES_256_GCM_SHA384) { ret SHA384; }
    ret 0;
}

pub fun hash_size(algorithm: HashAlgorithm) usize {
    if (algorithm == SHA256) { ret 32; }
    if (algorithm == SHA384) { ret 48; }
    ret 0;
}

pub fun key_size(suite: tls13.CipherSuite) usize {
    if (suite == tls13.AES_128_GCM_SHA256) { ret 16; }
    if (suite == tls13.AES_256_GCM_SHA384
        || suite == tls13.CHACHA20_POLY1305_SHA256) { ret 32; }
    ret 0;
}

pub fun bytes(value: *Secret) contracts.SecretBytes {
    if (value == nil || !value.active || value.len == 0) {
        ret contracts.SecretBytes{data: nil, len: 0};
    }
    ret contracts.SecretBytes{data: ?value.data[0], len: value.len};
}

fun clear(value: *Secret) {
    if (value == nil) { ret; }
    ct.zeroize(?value.data[0], MAX_HASH_SIZE);
    value.len = 0;
    value.active = false;
}

fun clear_many(schedule: *Schedule) {
    clear(?schedule.early_secret);
    clear(?schedule.client_early_traffic);
    clear(?schedule.early_exporter_master);
    clear(?schedule.handshake_secret);
    clear(?schedule.client_handshake_traffic);
    clear(?schedule.server_handshake_traffic);
    clear(?schedule.master_secret);
    clear(?schedule.client_application_traffic);
    clear(?schedule.server_application_traffic);
    clear(?schedule.exporter_master);
    clear(?schedule.resumption_master);
}

fun move_secret(destination: *Secret, source: *Secret) {
    clear(destination);
    var i: usize = 0;
    for (i < source.len) {
        destination.data[i] = source.data[i];
        i = i + 1;
    }
    destination.len = source.len;
    destination.active = source.active;
    clear(source);
}

fun empty_hash(algorithm: HashAlgorithm) contracts.Bytes {
    if (algorithm == SHA256) {
        ret contracts.Bytes{data: ?EMPTY_SHA256[0], len: 32};
    }
    if (algorithm == SHA384) {
        ret contracts.Bytes{data: ?EMPTY_SHA384[0], len: 48};
    }
    ret contracts.Bytes{data: nil, len: 0};
}

fun valid_hash(algorithm: HashAlgorithm, value: contracts.Bytes) bool {
    ret value.len == hash_size(algorithm) && value.data != nil;
}

# expand one tls 1.3 label into output.capacity secret bytes
pub fun expand_label(algorithm: HashAlgorithm, secret: contracts.SecretBytes,
    label: contracts.Bytes, context: contracts.Bytes,
    output: contracts.SecretBuffer) error.Error {
    val digest_size: usize = hash_size(algorithm);
    if (digest_size == 0 || secret.len != digest_size || secret.data == nil
        || label.len > MAX_LABEL_SIZE || (label.len != 0 && label.data == nil)
        || context.len > MAX_CONTEXT_SIZE || (context.len != 0 && context.data == nil)
        || output.capacity > 65535 || (output.capacity != 0 && output.data == nil)) {
        ret error.ILLEGAL_PARAMETER;
    }
    var info: [MAX_INFO_SIZE]u8;
    info[0] = (output.capacity >> 8)::u8;
    info[1] = output.capacity::u8;
    info[2] = (LABEL_PREFIX_SIZE + label.len)::u8;
    info[3] = 't'; info[4] = 'l'; info[5] = 's';
    info[6] = '1'; info[7] = '3'; info[8] = ' ';
    var i: usize = 0;
    for (i < label.len) {
        info[9 + i] = label.data[i];
        i = i + 1;
    }
    val context_offset: usize = 9 + label.len;
    info[context_offset] = context.len::u8;
    i = 0;
    for (i < context.len) {
        info[context_offset + 1 + i] = context.data[i];
        i = i + 1;
    }
    val info_length: usize = context_offset + 1 + context.len;
    var operation: contracts.Operation;
    if (algorithm == SHA256) {
        operation = hkdf.expand_sha256(secret,
            contracts.Bytes{data: ?info[0], len: info_length}, output);
    } or {
        operation = hkdf.expand_sha384(secret,
            contracts.Bytes{data: ?info[0], len: info_length}, output);
    }
    if (operation.error != contracts.OK || operation.written != output.capacity) {
        if (output.data != nil) { ct.zeroize(output.data, output.capacity); }
        ret crypto_failure(operation);
    }
    ret error.OK;
}

fun derive(algorithm: HashAlgorithm, secret: contracts.SecretBytes,
    label: contracts.Bytes, transcript_hash: contracts.Bytes,
    output: *Secret) error.Error {
    if (output == nil || !valid_hash(algorithm, transcript_hash)) {
        ret error.ILLEGAL_PARAMETER;
    }
    clear(output);
    val length: usize = hash_size(algorithm);
    val failure: error.Error = expand_label(algorithm, secret, label, transcript_hash,
        contracts.SecretBuffer{data: ?output.data[0], capacity: length});
    if (failure != error.OK) {
        clear(output);
        ret failure;
    }
    output.len = length;
    output.active = true;
    ret error.OK;
}

fun expand_secret(algorithm: HashAlgorithm, secret: contracts.SecretBytes,
    label: contracts.Bytes, context: contracts.Bytes, output: *Secret) error.Error {
    if (output == nil) { ret error.ILLEGAL_PARAMETER; }
    clear(output);
    val length: usize = hash_size(algorithm);
    val failure: error.Error = expand_label(algorithm, secret, label, context,
        contracts.SecretBuffer{data: ?output.data[0], capacity: length});
    if (failure != error.OK) { clear(output); ret failure; }
    output.len = length;
    output.active = true;
    ret error.OK;
}

fun extract(algorithm: HashAlgorithm, salt: contracts.SecretBytes,
    input: contracts.SecretBytes, output: *Secret) error.Error {
    if (output == nil) { ret error.ILLEGAL_PARAMETER; }
    clear(output);
    val length: usize = hash_size(algorithm);
    var operation: contracts.Operation;
    if (algorithm == SHA256) {
        operation = hkdf.extract_sha256(salt, input,
            contracts.SecretBuffer{data: ?output.data[0], capacity: length});
    } or (algorithm == SHA384) {
        operation = hkdf.extract_sha384(salt, input,
            contracts.SecretBuffer{data: ?output.data[0], capacity: length});
    } or { ret error.ILLEGAL_PARAMETER; }
    if (operation.error != contracts.OK || operation.written != length) {
        clear(output);
        ret crypto_failure(operation);
    }
    output.len = length;
    output.active = true;
    ret error.OK;
}

fun zero_input(length: usize, storage: *^u8) contracts.SecretBytes {
    ct.zeroize(storage, MAX_HASH_SIZE);
    ret contracts.SecretBytes{data: storage, len: length};
}

pub fun init(schedule: *Schedule, suite: tls13.CipherSuite,
    psk: contracts.SecretBytes) error.Error {
    if (schedule == nil || (schedule.stage != EMPTY && schedule.stage != DESTROYED)
        || (psk.len != 0 && psk.data == nil)) { ret error.ILLEGAL_PARAMETER; }
    val algorithm: HashAlgorithm = algorithm_for_suite(suite);
    val length: usize = hash_size(algorithm);
    if (length == 0) { ret error.UNSUPPORTED_ALGORITHM; }
    var absent_psk: [48]^u8;
    var input: contracts.SecretBytes = psk;
    if (psk.len == 0) { input = zero_input(length, ?absent_psk[0]); }
    var early: Secret;
    val failure: error.Error = extract(algorithm,
        contracts.SecretBytes{data: nil, len: 0}, input, ?early);
    ct.zeroize(?absent_psk[0], MAX_HASH_SIZE);
    if (failure != error.OK) {
        clear(?early);
        ret failure;
    }
    clear_many(schedule);
    schedule.suite = suite;
    schedule.algorithm = algorithm;
    schedule.stage = EARLY;
    schedule.early_traffic_ready = false;
    schedule.resumption_ready = false;
    move_secret(?schedule.early_secret, ?early);
    ret error.OK;
}

pub fun derive_early_traffic(schedule: *Schedule,
    client_hello_hash: contracts.Bytes) error.Error {
    if (schedule == nil || schedule.stage != EARLY || schedule.early_traffic_ready
        || !valid_hash(schedule.algorithm, client_hello_hash)) { ret error.ILLEGAL_PARAMETER; }
    var client: Secret;
    var exporter: Secret;
    var failure: error.Error = derive(schedule.algorithm, bytes(?schedule.early_secret),
        contracts.Bytes{data: "c e traffic"::*u8, len: 11}, client_hello_hash, ?client);
    if (failure == error.OK) {
        failure = derive(schedule.algorithm, bytes(?schedule.early_secret),
            contracts.Bytes{data: "e exp master"::*u8, len: 12}, client_hello_hash, ?exporter);
    }
    if (failure != error.OK) {
        clear(?client); clear(?exporter);
        ret failure;
    }
    move_secret(?schedule.client_early_traffic, ?client);
    move_secret(?schedule.early_exporter_master, ?exporter);
    schedule.early_traffic_ready = true;
    ret error.OK;
}

pub fun binder(schedule: *Schedule, resumption: bool,
    transcript_hash: contracts.Bytes, output: contracts.Buffer) error.Error {
    if (schedule == nil || schedule.stage != EARLY
        || !valid_hash(schedule.algorithm, transcript_hash)
        || output.capacity < hash_size(schedule.algorithm) || output.data == nil) {
        ret error.ILLEGAL_PARAMETER;
    }
    var binder_key: Secret;
    var finished_key: Secret;
    var label: contracts.Bytes = contracts.Bytes{data: "ext binder"::*u8, len: 10};
    if (resumption) { label = contracts.Bytes{data: "res binder"::*u8, len: 10}; }
    var failure: error.Error = derive(schedule.algorithm, bytes(?schedule.early_secret),
        label, empty_hash(schedule.algorithm), ?binder_key);
    if (failure == error.OK) {
        failure = expand_secret(schedule.algorithm, bytes(?binder_key),
            contracts.Bytes{data: "finished"::*u8, len: 8},
            contracts.Bytes{data: nil, len: 0}, ?finished_key);
    }
    var operation: contracts.Operation;
    if (failure == error.OK && schedule.algorithm == SHA256) {
        operation = hmac.sha256(bytes(?finished_key), transcript_hash,
            contracts.Buffer{data: output.data, capacity: 32});
    } or (failure == error.OK) {
        operation = hmac.sha384(bytes(?finished_key), transcript_hash,
            contracts.Buffer{data: output.data, capacity: 48});
    }
    clear(?binder_key); clear(?finished_key);
    if (failure != error.OK) { ret failure; }
    if (operation.error != contracts.OK
        || operation.written != hash_size(schedule.algorithm)) {
        zero_public(output.data, hash_size(schedule.algorithm));
        ret crypto_failure(operation);
    }
    ret error.OK;
}

pub fun advance_handshake(schedule: *Schedule, shared_secret: contracts.SecretBytes,
    transcript_hash: contracts.Bytes) error.Error {
    if (schedule == nil || schedule.stage != EARLY || shared_secret.len != 32
        || shared_secret.data == nil || !valid_hash(schedule.algorithm, transcript_hash)) {
        ret error.ILLEGAL_PARAMETER;
    }
    val algorithm: HashAlgorithm = schedule.algorithm;
    val length: usize = hash_size(algorithm);
    var derived_early: Secret;
    var handshake_secret: Secret;
    var client_traffic: Secret;
    var server_traffic: Secret;
    var derived_handshake: Secret;
    var master_secret: Secret;
    var zeroes: [48]^u8;
    var failure: error.Error = derive(algorithm, bytes(?schedule.early_secret),
        contracts.Bytes{data: "derived"::*u8, len: 7}, empty_hash(algorithm), ?derived_early);
    if (failure == error.OK) {
        failure = extract(algorithm, bytes(?derived_early), shared_secret, ?handshake_secret);
    }
    if (failure == error.OK) {
        failure = derive(algorithm, bytes(?handshake_secret),
            contracts.Bytes{data: "c hs traffic"::*u8, len: 12}, transcript_hash, ?client_traffic);
    }
    if (failure == error.OK) {
        failure = derive(algorithm, bytes(?handshake_secret),
            contracts.Bytes{data: "s hs traffic"::*u8, len: 12}, transcript_hash, ?server_traffic);
    }
    if (failure == error.OK) {
        failure = derive(algorithm, bytes(?handshake_secret),
            contracts.Bytes{data: "derived"::*u8, len: 7}, empty_hash(algorithm), ?derived_handshake);
    }
    val zero_input_bytes: contracts.SecretBytes = zero_input(length, ?zeroes[0]);
    if (failure == error.OK) {
        failure = extract(algorithm, bytes(?derived_handshake), zero_input_bytes, ?master_secret);
    }
    clear(?derived_early); clear(?derived_handshake);
    ct.zeroize(?zeroes[0], MAX_HASH_SIZE);
    if (failure != error.OK) {
        clear(?handshake_secret); clear(?client_traffic);
        clear(?server_traffic); clear(?master_secret);
        ret failure;
    }
    move_secret(?schedule.handshake_secret, ?handshake_secret);
    move_secret(?schedule.client_handshake_traffic, ?client_traffic);
    move_secret(?schedule.server_handshake_traffic, ?server_traffic);
    move_secret(?schedule.master_secret, ?master_secret);
    schedule.stage = HANDSHAKE;
    ret error.OK;
}

pub fun advance_application(schedule: *Schedule,
    server_finished_hash: contracts.Bytes) error.Error {
    if (schedule == nil || schedule.stage != HANDSHAKE
        || !valid_hash(schedule.algorithm, server_finished_hash)) { ret error.ILLEGAL_PARAMETER; }
    var client: Secret;
    var server: Secret;
    var exporter: Secret;
    var failure: error.Error = derive(schedule.algorithm, bytes(?schedule.master_secret),
        contracts.Bytes{data: "c ap traffic"::*u8, len: 12}, server_finished_hash, ?client);
    if (failure == error.OK) {
        failure = derive(schedule.algorithm, bytes(?schedule.master_secret),
            contracts.Bytes{data: "s ap traffic"::*u8, len: 12}, server_finished_hash, ?server);
    }
    if (failure == error.OK) {
        failure = derive(schedule.algorithm, bytes(?schedule.master_secret),
            contracts.Bytes{data: "exp master"::*u8, len: 10}, server_finished_hash, ?exporter);
    }
    if (failure != error.OK) {
        clear(?client); clear(?server); clear(?exporter);
        ret failure;
    }
    move_secret(?schedule.client_application_traffic, ?client);
    move_secret(?schedule.server_application_traffic, ?server);
    move_secret(?schedule.exporter_master, ?exporter);
    schedule.stage = APPLICATION;
    ret error.OK;
}

pub fun derive_resumption(schedule: *Schedule,
    client_finished_hash: contracts.Bytes) error.Error {
    if (schedule == nil || schedule.stage != APPLICATION || schedule.resumption_ready
        || !valid_hash(schedule.algorithm, client_finished_hash)) { ret error.ILLEGAL_PARAMETER; }
    var resumption: Secret;
    val failure: error.Error = derive(schedule.algorithm, bytes(?schedule.master_secret),
        contracts.Bytes{data: "res master"::*u8, len: 10}, client_finished_hash, ?resumption);
    if (failure != error.OK) { clear(?resumption); ret failure; }
    move_secret(?schedule.resumption_master, ?resumption);
    schedule.resumption_ready = true;
    ret error.OK;
}

pub fun finished_key(schedule: *Schedule, base: *Secret,
    output: contracts.SecretBuffer) error.Error {
    if (schedule == nil || base == nil || !base.active
        || output.capacity < hash_size(schedule.algorithm) || output.data == nil) {
        ret error.ILLEGAL_PARAMETER;
    }
    ret expand_label(schedule.algorithm, bytes(base),
        contracts.Bytes{data: "finished"::*u8, len: 8},
        contracts.Bytes{data: nil, len: 0},
        contracts.SecretBuffer{data: output.data, capacity: hash_size(schedule.algorithm)});
}

pub fun finished(schedule: *Schedule, base: *Secret,
    transcript_hash: contracts.Bytes, output: contracts.Buffer) error.Error {
    if (schedule == nil || base == nil || !base.active
        || !valid_hash(schedule.algorithm, transcript_hash)
        || output.capacity < hash_size(schedule.algorithm) || output.data == nil) {
        ret error.ILLEGAL_PARAMETER;
    }
    var key: Secret;
    key.len = hash_size(schedule.algorithm);
    key.active = true;
    val key_error: error.Error = finished_key(schedule, base,
        contracts.SecretBuffer{data: ?key.data[0], capacity: key.len});
    if (key_error != error.OK) { clear(?key); ret key_error; }
    var operation: contracts.Operation;
    if (schedule.algorithm == SHA256) {
        operation = hmac.sha256(bytes(?key), transcript_hash,
            contracts.Buffer{data: output.data, capacity: 32});
    } or {
        operation = hmac.sha384(bytes(?key), transcript_hash,
            contracts.Buffer{data: output.data, capacity: 48});
    }
    clear(?key);
    if (operation.error != contracts.OK
        || operation.written != hash_size(schedule.algorithm)) {
        zero_public(output.data, hash_size(schedule.algorithm));
        ret crypto_failure(operation);
    }
    ret error.OK;
}

pub fun verify_finished(schedule: *Schedule, base: *Secret,
    transcript_hash: contracts.Bytes, received: contracts.Bytes) error.Error {
    if (schedule == nil || received.len != hash_size(schedule.algorithm)
        || received.data == nil) { ret error.ILLEGAL_PARAMETER; }
    var expected: [48]u8;
    val failure: error.Error = finished(schedule, base, transcript_hash,
        contracts.Buffer{data: ?expected[0], capacity: hash_size(schedule.algorithm)});
    if (failure != error.OK) { ret failure; }
    var received_secret: [48]^u8;
    var expected_secret: [48]^u8;
    var i: usize = 0;
    for (i < received.len) {
        received_secret[i] = received.data[i];
        expected_secret[i] = expected[i];
        i = i + 1;
    }
    val matches: ^u8 = ct.eq_bytes(?received_secret[0], ?expected_secret[0], received.len);
    ct.zeroize(?received_secret[0], MAX_HASH_SIZE);
    ct.zeroize(?expected_secret[0], MAX_HASH_SIZE);
    var result: error.Error = error.DECRYPT_ERROR;
    if (matches:^ == 1) { result = error.OK; }
    ret result;
}

pub fun traffic_key(schedule: *Schedule, traffic_secret: *Secret,
    output: contracts.SecretBuffer) error.Error {
    var length: usize = 0;
    if (schedule != nil) { length = key_size(schedule.suite); }
    if (schedule == nil || traffic_secret == nil || !traffic_secret.active
        || length == 0 || output.capacity < length || output.data == nil) {
        ret error.ILLEGAL_PARAMETER;
    }
    ret expand_label(schedule.algorithm, bytes(traffic_secret),
        contracts.Bytes{data: "key"::*u8, len: 3}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBuffer{data: output.data, capacity: length});
}

pub fun traffic_iv(schedule: *Schedule, traffic_secret: *Secret,
    output: contracts.Buffer) error.Error {
    if (schedule == nil || traffic_secret == nil || !traffic_secret.active
        || output.capacity < IV_SIZE || output.data == nil) { ret error.ILLEGAL_PARAMETER; }
    var secret_iv: [12]^u8;
    val failure: error.Error = expand_label(schedule.algorithm, bytes(traffic_secret),
        contracts.Bytes{data: "iv"::*u8, len: 2}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBuffer{data: ?secret_iv[0], capacity: IV_SIZE});
    if (failure != error.OK) { ct.zeroize(?secret_iv[0], IV_SIZE); ret failure; }
    var i: usize = 0;
    for (i < IV_SIZE) { output.data[i] = secret_iv[i]:^; i = i + 1; }
    ct.zeroize(?secret_iv[0], IV_SIZE);
    ret error.OK;
}

pub fun update_traffic(schedule: *Schedule, traffic_secret: *Secret) error.Error {
    if (schedule == nil || traffic_secret == nil || !traffic_secret.active
        || traffic_secret.len != hash_size(schedule.algorithm)) { ret error.ILLEGAL_PARAMETER; }
    var updated: Secret;
    val failure: error.Error = expand_secret(schedule.algorithm, bytes(traffic_secret),
        contracts.Bytes{data: "traffic upd"::*u8, len: 11},
        contracts.Bytes{data: nil, len: 0}, ?updated);
    if (failure != error.OK) { clear(?updated); ret failure; }
    move_secret(traffic_secret, ?updated);
    ret error.OK;
}

pub fun resumption_psk(schedule: *Schedule, ticket_nonce: contracts.Bytes,
    output: contracts.SecretBuffer) error.Error {
    if (schedule == nil || !schedule.resumption_ready
        || ticket_nonce.len > 255 || (ticket_nonce.len != 0 && ticket_nonce.data == nil)
        || output.capacity < hash_size(schedule.algorithm) || output.data == nil) {
        ret error.ILLEGAL_PARAMETER;
    }
    ret expand_label(schedule.algorithm, bytes(?schedule.resumption_master),
        contracts.Bytes{data: "resumption"::*u8, len: 10}, ticket_nonce,
        contracts.SecretBuffer{data: output.data, capacity: hash_size(schedule.algorithm)});
}

pub fun export_keying_material(schedule: *Schedule, label: contracts.Bytes,
    context_hash: contracts.Bytes, output: contracts.SecretBuffer) error.Error {
    if (schedule == nil || schedule.stage != APPLICATION
        || !valid_hash(schedule.algorithm, context_hash)) { ret error.ILLEGAL_PARAMETER; }
    var exporter_secret: Secret;
    val failure: error.Error = derive(schedule.algorithm, bytes(?schedule.exporter_master),
        label, empty_hash(schedule.algorithm), ?exporter_secret);
    if (failure != error.OK) { clear(?exporter_secret); ret failure; }
    val expanded: error.Error = expand_label(schedule.algorithm, bytes(?exporter_secret),
        contracts.Bytes{data: "exporter"::*u8, len: 8}, context_hash, output);
    clear(?exporter_secret);
    ret expanded;
}

pub fun discard_handshake(schedule: *Schedule) error.Error {
    if (schedule == nil || schedule.stage != APPLICATION) { ret error.ILLEGAL_PARAMETER; }
    clear(?schedule.early_secret);
    clear(?schedule.client_early_traffic);
    clear(?schedule.early_exporter_master);
    clear(?schedule.handshake_secret);
    clear(?schedule.client_handshake_traffic);
    clear(?schedule.server_handshake_traffic);
    clear(?schedule.master_secret);
    schedule.early_traffic_ready = false;
    ret error.OK;
}

pub fun destroy(schedule: *Schedule) {
    if (schedule == nil) { ret; }
    clear_many(schedule);
    schedule.suite = 0;
    schedule.algorithm = 0;
    schedule.stage = DESTROYED;
    schedule.early_traffic_ready = false;
    schedule.resumption_ready = false;
}

fun matches(value: *Secret, expected: *u8, length: usize) bool {
    if (value == nil || !value.active || value.len != length) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (value.data[i]:^ != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun secret_matches(value: *^u8, expected: *u8, length: usize) bool {
    if (value == nil || expected == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (value[i]:^ != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun public_matches(value: *u8, expected: *u8, length: usize) bool {
    if (value == nil || expected == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (value[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "key schedule: rfc 8448 handshake secrets match every stage" {
    var schedule: Schedule;
    if (init(?schedule, tls13.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: nil, len: 0}) != error.OK) { ret 1; }
    var early: [32]u8 = [32]u8{
        0x33, 0xad, 0x0a, 0x1c, 0x60, 0x7e, 0xc0, 0x3b,
        0x09, 0xe6, 0xcd, 0x98, 0x93, 0x68, 0x0c, 0xe2,
        0x10, 0xad, 0xf3, 0x00, 0xaa, 0x1f, 0x26, 0x60,
        0xe1, 0xb2, 0x2e, 0x10, 0xf1, 0x70, 0xf9, 0x2a,
    };
    if (!matches(?schedule.early_secret, ?early[0], 32)) { ret 2; }
    var shared: [32]^u8 = [32]^u8{
        0x8b, 0xd4, 0x05, 0x4f, 0xb5, 0x5b, 0x9d, 0x63,
        0xfd, 0xfb, 0xac, 0xf9, 0xf0, 0x4b, 0x9f, 0x0d,
        0x35, 0xe6, 0xd6, 0x3f, 0x53, 0x75, 0x63, 0xef,
        0xd4, 0x62, 0x72, 0x90, 0x0f, 0x89, 0x49, 0x2d,
    };
    var transcript: [32]u8 = [32]u8{
        0x86, 0x0c, 0x06, 0xed, 0xc0, 0x78, 0x58, 0xee,
        0x8e, 0x78, 0xf0, 0xe7, 0x42, 0x8c, 0x58, 0xed,
        0xd6, 0xb4, 0x3f, 0x2c, 0xa3, 0xe6, 0xe9, 0x5f,
        0x02, 0xed, 0x06, 0x3c, 0xf0, 0xe1, 0xca, 0xd8,
    };
    if (advance_handshake(?schedule,
        contracts.SecretBytes{data: ?shared[0], len: 32},
        contracts.Bytes{data: ?transcript[0], len: 32}) != error.OK) { ret 3; }
    var handshake_expected: [32]u8 = [32]u8{
        0x1d, 0xc8, 0x26, 0xe9, 0x36, 0x06, 0xaa, 0x6f,
        0xdc, 0x0a, 0xad, 0xc1, 0x2f, 0x74, 0x1b, 0x01,
        0x04, 0x6a, 0xa6, 0xb9, 0x9f, 0x69, 0x1e, 0xd2,
        0x21, 0xa9, 0xf0, 0xca, 0x04, 0x3f, 0xbe, 0xac,
    };
    var client_expected: [32]u8 = [32]u8{
        0xb3, 0xed, 0xdb, 0x12, 0x6e, 0x06, 0x7f, 0x35,
        0xa7, 0x80, 0xb3, 0xab, 0xf4, 0x5e, 0x2d, 0x8f,
        0x3b, 0x1a, 0x95, 0x07, 0x38, 0xf5, 0x2e, 0x96,
        0x00, 0x74, 0x6a, 0x0e, 0x27, 0xa5, 0x5a, 0x21,
    };
    var server_expected: [32]u8 = [32]u8{
        0xb6, 0x7b, 0x7d, 0x69, 0x0c, 0xc1, 0x6c, 0x4e,
        0x75, 0xe5, 0x42, 0x13, 0xcb, 0x2d, 0x37, 0xb4,
        0xe9, 0xc9, 0x12, 0xbc, 0xde, 0xd9, 0x10, 0x5d,
        0x42, 0xbe, 0xfd, 0x59, 0xd3, 0x91, 0xad, 0x38,
    };
    var master_expected: [32]u8 = [32]u8{
        0x18, 0xdf, 0x06, 0x84, 0x3d, 0x13, 0xa0, 0x8b,
        0xf2, 0xa4, 0x49, 0x84, 0x4c, 0x5f, 0x8a, 0x47,
        0x80, 0x01, 0xbc, 0x4d, 0x4c, 0x62, 0x79, 0x84,
        0xd5, 0xa4, 0x1d, 0xa8, 0xd0, 0x40, 0x29, 0x19,
    };
    if (!matches(?schedule.handshake_secret, ?handshake_expected[0], 32)
        || !matches(?schedule.client_handshake_traffic, ?client_expected[0], 32)
        || !matches(?schedule.server_handshake_traffic, ?server_expected[0], 32)
        || !matches(?schedule.master_secret, ?master_expected[0], 32)) { ret 4; }

    var client_handshake_key_expected: [16]u8 = [16]u8{
        0xdb, 0xfa, 0xa6, 0x93, 0xd1, 0x76, 0x2c, 0x5b,
        0x66, 0x6a, 0xf5, 0xd9, 0x50, 0x25, 0x8d, 0x01,
    };
    var client_handshake_iv_expected: [12]u8 = [12]u8{
        0x5b, 0xd3, 0xc7, 0x1b, 0x83, 0x6e, 0x0b, 0x76,
        0xbb, 0x73, 0x26, 0x5f,
    };
    var server_handshake_key_expected: [16]u8 = [16]u8{
        0x3f, 0xce, 0x51, 0x60, 0x09, 0xc2, 0x17, 0x27,
        0xd0, 0xf2, 0xe4, 0xe8, 0x6e, 0xe4, 0x03, 0xbc,
    };
    var server_handshake_iv_expected: [12]u8 = [12]u8{
        0x5d, 0x31, 0x3e, 0xb2, 0x67, 0x12, 0x76, 0xee,
        0x13, 0x00, 0x0b, 0x30,
    };
    var client_finished_key_expected: [32]u8 = [32]u8{
        0xb8, 0x0a, 0xd0, 0x10, 0x15, 0xfb, 0x2f, 0x0b,
        0xd6, 0x5f, 0xf7, 0xd4, 0xda, 0x5d, 0x6b, 0xf8,
        0x3f, 0x84, 0x82, 0x1d, 0x1f, 0x87, 0xfd, 0xc7,
        0xd3, 0xc7, 0x5b, 0x5a, 0x7b, 0x42, 0xd9, 0xc4,
    };
    var server_finished_key_expected: [32]u8 = [32]u8{
        0x00, 0x8d, 0x3b, 0x66, 0xf8, 0x16, 0xea, 0x55,
        0x9f, 0x96, 0xb5, 0x37, 0xe8, 0x85, 0xc3, 0x1f,
        0xc0, 0x68, 0xbf, 0x49, 0x2c, 0x65, 0x2f, 0x01,
        0xf2, 0x88, 0xa1, 0xd8, 0xcd, 0xc1, 0x9f, 0xc8,
    };
    var key_output: [32]^u8;
    var iv_output: [12]u8;
    var finished_key_output: [32]^u8;
    if (traffic_key(?schedule, ?schedule.client_handshake_traffic,
            contracts.SecretBuffer{data: ?key_output[0], capacity: 32}) != error.OK
        || !secret_matches(?key_output[0], ?client_handshake_key_expected[0], 16)
        || traffic_iv(?schedule, ?schedule.client_handshake_traffic,
            contracts.Buffer{data: ?iv_output[0], capacity: 12}) != error.OK
        || !public_matches(?iv_output[0], ?client_handshake_iv_expected[0], 12)) { ret 5; }
    if (traffic_key(?schedule, ?schedule.server_handshake_traffic,
            contracts.SecretBuffer{data: ?key_output[0], capacity: 32}) != error.OK
        || !secret_matches(?key_output[0], ?server_handshake_key_expected[0], 16)
        || traffic_iv(?schedule, ?schedule.server_handshake_traffic,
            contracts.Buffer{data: ?iv_output[0], capacity: 12}) != error.OK
        || !public_matches(?iv_output[0], ?server_handshake_iv_expected[0], 12)) { ret 6; }
    if (finished_key(?schedule, ?schedule.client_handshake_traffic,
            contracts.SecretBuffer{data: ?finished_key_output[0], capacity: 32}) != error.OK
        || !secret_matches(?finished_key_output[0], ?client_finished_key_expected[0], 32)
        || finished_key(?schedule, ?schedule.server_handshake_traffic,
            contracts.SecretBuffer{data: ?finished_key_output[0], capacity: 32}) != error.OK
        || !secret_matches(?finished_key_output[0], ?server_finished_key_expected[0], 32)) { ret 7; }

    var verify_data: [32]u8;
    if (finished(?schedule, ?schedule.server_handshake_traffic,
            contracts.Bytes{data: ?transcript[0], len: 32},
            contracts.Buffer{data: ?verify_data[0], capacity: 32}) != error.OK
        || verify_finished(?schedule, ?schedule.server_handshake_traffic,
            contracts.Bytes{data: ?transcript[0], len: 32},
            contracts.Bytes{data: ?verify_data[0], len: 32}) != error.OK) { ret 8; }
    verify_data[0] = verify_data[0] ^ 1;
    if (verify_finished(?schedule, ?schedule.server_handshake_traffic,
        contracts.Bytes{data: ?transcript[0], len: 32},
        contracts.Bytes{data: ?verify_data[0], len: 32}) != error.DECRYPT_ERROR) { ret 9; }

    var server_finished_hash: [32]u8 = [32]u8{
        0x96, 0x08, 0x10, 0x2a, 0x0f, 0x1c, 0xcc, 0x6d,
        0xb6, 0x25, 0x0b, 0x7b, 0x7e, 0x41, 0x7b, 0x1a,
        0x00, 0x0e, 0xaa, 0xda, 0x3d, 0xaa, 0xe4, 0x77,
        0x7a, 0x76, 0x86, 0xc9, 0xff, 0x83, 0xdf, 0x13,
    };
    if (advance_application(?schedule,
        contracts.Bytes{data: ?server_finished_hash[0], len: 32}) != error.OK) { ret 10; }
    var client_application_expected: [32]u8 = [32]u8{
        0x9e, 0x40, 0x64, 0x6c, 0xe7, 0x9a, 0x7f, 0x9d,
        0xc0, 0x5a, 0xf8, 0x88, 0x9b, 0xce, 0x65, 0x52,
        0x87, 0x5a, 0xfa, 0x0b, 0x06, 0xdf, 0x00, 0x87,
        0xf7, 0x92, 0xeb, 0xb7, 0xc1, 0x75, 0x04, 0xa5,
    };
    var server_application_expected: [32]u8 = [32]u8{
        0xa1, 0x1a, 0xf9, 0xf0, 0x55, 0x31, 0xf8, 0x56,
        0xad, 0x47, 0x11, 0x6b, 0x45, 0xa9, 0x50, 0x32,
        0x82, 0x04, 0xb4, 0xf4, 0x4b, 0xfb, 0x6b, 0x3a,
        0x4b, 0x4f, 0x1f, 0x3f, 0xcb, 0x63, 0x16, 0x43,
    };
    var exporter_expected: [32]u8 = [32]u8{
        0xfe, 0x22, 0xf8, 0x81, 0x17, 0x6e, 0xda, 0x18,
        0xeb, 0x8f, 0x44, 0x52, 0x9e, 0x67, 0x92, 0xc5,
        0x0c, 0x9a, 0x3f, 0x89, 0x45, 0x2f, 0x68, 0xd8,
        0xae, 0x31, 0x1b, 0x43, 0x09, 0xd3, 0xcf, 0x50,
    };
    if (!matches(?schedule.client_application_traffic, ?client_application_expected[0], 32)
        || !matches(?schedule.server_application_traffic, ?server_application_expected[0], 32)
        || !matches(?schedule.exporter_master, ?exporter_expected[0], 32)) { ret 11; }

    var client_application_key_expected: [16]u8 = [16]u8{
        0x17, 0x42, 0x2d, 0xda, 0x59, 0x6e, 0xd5, 0xd9,
        0xac, 0xd8, 0x90, 0xe3, 0xc6, 0x3f, 0x50, 0x51,
    };
    var client_application_iv_expected: [12]u8 = [12]u8{
        0x5b, 0x78, 0x92, 0x3d, 0xee, 0x08, 0x57, 0x90,
        0x33, 0xe5, 0x23, 0xd9,
    };
    var server_application_key_expected: [16]u8 = [16]u8{
        0x9f, 0x02, 0x28, 0x3b, 0x6c, 0x9c, 0x07, 0xef,
        0xc2, 0x6b, 0xb9, 0xf2, 0xac, 0x92, 0xe3, 0x56,
    };
    var server_application_iv_expected: [12]u8 = [12]u8{
        0xcf, 0x78, 0x2b, 0x88, 0xdd, 0x83, 0x54, 0x9a,
        0xad, 0xf1, 0xe9, 0x84,
    };
    if (traffic_key(?schedule, ?schedule.client_application_traffic,
            contracts.SecretBuffer{data: ?key_output[0], capacity: 32}) != error.OK
        || !secret_matches(?key_output[0], ?client_application_key_expected[0], 16)
        || traffic_iv(?schedule, ?schedule.client_application_traffic,
            contracts.Buffer{data: ?iv_output[0], capacity: 12}) != error.OK
        || !public_matches(?iv_output[0], ?client_application_iv_expected[0], 12)) { ret 12; }
    if (traffic_key(?schedule, ?schedule.server_application_traffic,
            contracts.SecretBuffer{data: ?key_output[0], capacity: 32}) != error.OK
        || !secret_matches(?key_output[0], ?server_application_key_expected[0], 16)
        || traffic_iv(?schedule, ?schedule.server_application_traffic,
            contracts.Buffer{data: ?iv_output[0], capacity: 12}) != error.OK
        || !public_matches(?iv_output[0], ?server_application_iv_expected[0], 12)) { ret 13; }

    var client_finished_hash: [32]u8 = [32]u8{
        0x20, 0x91, 0x45, 0xa9, 0x6e, 0xe8, 0xe2, 0xa1,
        0x22, 0xff, 0x81, 0x00, 0x47, 0xcc, 0x95, 0x26,
        0x84, 0x65, 0x8d, 0x60, 0x49, 0xe8, 0x64, 0x29,
        0x42, 0x6d, 0xb8, 0x7c, 0x54, 0xad, 0x14, 0x3d,
    };
    if (derive_resumption(?schedule,
        contracts.Bytes{data: ?client_finished_hash[0], len: 32}) != error.OK) { ret 14; }
    var resumption_master_expected: [32]u8 = [32]u8{
        0x7d, 0xf2, 0x35, 0xf2, 0x03, 0x1d, 0x2a, 0x05,
        0x12, 0x87, 0xd0, 0x2b, 0x02, 0x41, 0xb0, 0xbf,
        0xda, 0xf8, 0x6c, 0xc8, 0x56, 0x23, 0x1f, 0x2d,
        0x5a, 0xba, 0x46, 0xc4, 0x34, 0xec, 0x19, 0x6c,
    };
    var resumption_psk_expected: [32]u8 = [32]u8{
        0x4e, 0xcd, 0x0e, 0xb6, 0xec, 0x3b, 0x4d, 0x87,
        0xf5, 0xd6, 0x02, 0x8f, 0x92, 0x2c, 0xa4, 0xc5,
        0x85, 0x1a, 0x27, 0x7f, 0xd4, 0x13, 0x11, 0xc9,
        0xe6, 0x2d, 0x2c, 0x94, 0x92, 0xe1, 0xc4, 0xf3,
    };
    var ticket_nonce: [2]u8;
    var resumption_psk_output: [32]^u8;
    if (!matches(?schedule.resumption_master, ?resumption_master_expected[0], 32)
        || resumption_psk(?schedule,
            contracts.Bytes{data: ?ticket_nonce[0], len: 2},
            contracts.SecretBuffer{data: ?resumption_psk_output[0], capacity: 32}) != error.OK
        || !secret_matches(?resumption_psk_output[0], ?resumption_psk_expected[0], 32)) { ret 15; }

    destroy(?schedule);
    if (schedule.stage != DESTROYED || schedule.master_secret.active
        || schedule.early_secret.data[0]:^ != 0) { ret 16; }
    ct.zeroize(?shared[0], 32);
    ct.zeroize(?key_output[0], 32);
    ct.zeroize(?finished_key_output[0], 32);
    ct.zeroize(?resumption_psk_output[0], 32);
    ret 0;
}

test "key schedule: labels, traffic material, updates, and failures are bounded" {
    var schedule: Schedule;
    if (init(?schedule, tls13.AES_256_GCM_SHA384,
        contracts.SecretBytes{data: nil, len: 0}) != error.OK) { ret 1; }
    var shared: [32]^u8;
    var transcript: [48]u8;
    if (advance_handshake(?schedule, contracts.SecretBytes{data: ?shared[0], len: 32},
        contracts.Bytes{data: ?transcript[0], len: 48}) != error.OK) { ret 2; }
    var key: [32]^u8;
    var iv: [12]u8;
    if (traffic_key(?schedule, ?schedule.client_handshake_traffic,
        contracts.SecretBuffer{data: ?key[0], capacity: 32}) != error.OK
        || traffic_iv(?schedule, ?schedule.client_handshake_traffic,
            contracts.Buffer{data: ?iv[0], capacity: 12}) != error.OK) { ret 3; }
    var before: [48]u8;
    var i: usize = 0;
    for (i < 48) { before[i] = schedule.client_handshake_traffic.data[i]:^; i = i + 1; }
    if (update_traffic(?schedule, ?schedule.client_handshake_traffic) != error.OK) { ret 4; }
    var different: bool = false;
    i = 0;
    for (i < 48) {
        if (before[i] != schedule.client_handshake_traffic.data[i]:^) { different = true; }
        i = i + 1;
    }
    if (!different) { ret 5; }
    var tiny: [4]^u8;
    if (traffic_key(?schedule, ?schedule.server_handshake_traffic,
        contracts.SecretBuffer{data: ?tiny[0], capacity: 4}) != error.ILLEGAL_PARAMETER) { ret 6; }
    var overlong: [250]u8;
    if (expand_label(schedule.algorithm, bytes(?schedule.master_secret),
        contracts.Bytes{data: ?overlong[0], len: 250},
        contracts.Bytes{data: nil, len: 0},
        contracts.SecretBuffer{data: ?key[0], capacity: 32}) != error.ILLEGAL_PARAMETER) { ret 7; }
    destroy(?schedule);
    ct.zeroize(?shared[0], 32); ct.zeroize(?key[0], 32); ct.zeroize(?tiny[0], 4);
    ret 0;
}
