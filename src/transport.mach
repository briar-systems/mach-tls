# completion-based ordered-byte transport below tls

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.system.os;
use std.chrono.time;
use std.sync.cancel;
use std.sync.mutex;
use std.net.tcp;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use io_error: std.io.error;
use net_async: std.net.async;
use tls.error;

pub def SubmitBufferFun: fun(ptr, *cancel.Scope, *u8, usize, usize) Result[io_runtime.Token, io_error.Error];
pub def SubmitCloseFun: fun(ptr, *cancel.Scope, usize) Result[io_runtime.Token, io_error.Error];

# every submission resolves through the shared runtime exactly once
pub rec Transport {
    runtime: *io_runtime.Runtime;
    context: ptr;
    submit_read: SubmitBufferFun;
    submit_write: SubmitBufferFun;
    submit_close: SubmitCloseFun;
}

fun invalid(operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(os.EINVAL, operation);
}

pub fun valid(transport: *Transport) bool {
    ret transport != nil
        && transport.runtime != nil
        && transport.submit_read::usize != 0
        && transport.submit_write::usize != 0
        && transport.submit_close::usize != 0;
}

pub fun read(
    transport: *Transport,
    scope: *cancel.Scope,
    buffer: *u8,
    length: usize,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (!valid(transport) || scope == nil || (buffer == nil && length != 0)) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_READ));
    }
    ret transport.submit_read(transport.context, scope, buffer, length, context);
}

pub fun write(
    transport: *Transport,
    scope: *cancel.Scope,
    buffer: *u8,
    length: usize,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (!valid(transport) || scope == nil || (buffer == nil && length != 0)) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_WRITE));
    }
    ret transport.submit_write(transport.context, scope, buffer, length, context);
}

pub fun close(
    transport: *Transport,
    scope: *cancel.Scope,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (!valid(transport) || scope == nil) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_CLOSE));
    }
    ret transport.submit_close(transport.context, scope, context);
}

pub rec TcpAdapter {
    driver: *net_async.Driver;
    stream: *tcp.Stream;
    close_mode: lifecycle.Mode;
}

fun tcp_read(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val adapter: *TcpAdapter = context::*TcpAdapter;
    ret net_async.submit_read(adapter.driver, scope, adapter.stream, buffer, length, token_context);
}

fun tcp_write(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val adapter: *TcpAdapter = context::*TcpAdapter;
    ret net_async.submit_write(adapter.driver, scope, adapter.stream, buffer, length, token_context);
}

fun tcp_close(context: ptr, scope: *cancel.Scope, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val adapter: *TcpAdapter = context::*TcpAdapter;
    ret net_async.submit_stream_close(adapter.driver, scope, adapter.stream, adapter.close_mode, token_context);
}

pub fun make_tcp(
    transport: *Transport,
    adapter: *TcpAdapter,
    driver: *net_async.Driver,
    stream: *tcp.Stream,
    close_mode: lifecycle.Mode,
) bool {
    if (transport == nil || adapter == nil || driver == nil || driver.runtime == nil || stream == nil || close_mode > lifecycle.ABORTIVE) {
        ret false;
    }
    adapter.driver = driver;
    adapter.stream = stream;
    adapter.close_mode = close_mode;
    transport.runtime = driver.runtime;
    transport.context = adapter::ptr;
    transport.submit_read = tcp_read;
    transport.submit_write = tcp_write;
    transport.submit_close = tcp_close;
    ret true;
}

pub def ApplicationKind: u8;
pub val APPLICATION_READ: ApplicationKind = 1;
pub val APPLICATION_WRITE: ApplicationKind = 2;
pub val HANDSHAKE: ApplicationKind = 3;
pub val APPLICATION_CLOSE: ApplicationKind = 4;

pub def ActionKind: u8;
pub val TRANSPORT_READ: ActionKind = 1;
pub val TRANSPORT_WRITE: ActionKind = 2;
pub val TRANSPORT_CLOSE: ActionKind = 3;

pub def OperationState: u8;
pub val OPERATION_OPEN: OperationState = 1;
pub val OPERATION_WAITING: OperationState = 2;
pub val OPERATION_TERMINAL: OperationState = 3;
pub val OPERATION_DESTROYED: OperationState = 4;

pub rec Token {
    index: u32;
    generation: u32;
}

pub rec Action {
    kind: ActionKind;
    buffer: *u8;
    length: usize;
    context: usize;
}

pub rec Snapshot {
    token: Token;
    kind: ApplicationKind;
    state: OperationState;
    context: usize;
    application_bytes: usize;
    last_transport_bytes: usize;
    last_end_of_stream: bool;
    terminal_error: error.Error;
}

# an operation retains its application buffer and scope until terminal resolution
pub rec Operation {
    token: Token;
    kind: ApplicationKind;
    scope: *cancel.Scope;
    application_buffer: *u8;
    application_length: usize;
    application_bytes: usize;
    context: usize;
    state: OperationState;
    lower_token: io_runtime.Token;
    lower_kind: ActionKind;
    lower_buffer: *u8;
    lower_length: usize;
    last_transport_bytes: usize;
    last_end_of_stream: bool;
    terminal_error: error.Error;
    cancellation: cancel.Registration;
    cancellation_active: bool;
    cancellation_requested: bool;
    cancellation_error: error.Error;
    lock: mutex.Mutex;
}

fun reason_error(reason: cancel.Reason) error.Error {
    if (reason == cancel.TIMED_OUT) { ret error.TIMEOUT; }
    if (reason == cancel.CANCELLED) { ret error.CANCELLED; }
    ret error.CLOSED;
}

pub fun map_error(failure: io_error.Error) error.Error {
    if (failure.kind == io_error.TIMEOUT) { ret error.TIMEOUT; }
    if (failure.kind == io_error.CANCELLED) { ret error.CANCELLED; }
    if (failure.kind == io_error.CLOSED || failure.kind == io_error.RESET || failure.kind == io_error.ABORTED) { ret error.CLOSED; }
    if (failure.kind == io_error.RESOURCE_EXHAUSTED) { ret error.RESOURCE_LIMIT; }
    ret error.INTERNAL_ERROR;
}

fun terminal_locked(operation: *Operation, terminal_error: error.Error, end_of_stream: bool, cancellation_owner: bool) bool {
    if (operation.state == OPERATION_TERMINAL || operation.state == OPERATION_DESTROYED) { ret false; }
    if (operation.state == OPERATION_WAITING) { ret false; }
    if (!cancellation_owner && operation.cancellation_active) {
        if (!cancel.unregister(?operation.cancellation)) { ret false; }
        operation.cancellation_active = false;
    }
    operation.state = OPERATION_TERMINAL;
    operation.terminal_error = terminal_error;
    operation.last_end_of_stream = end_of_stream;
    ret true;
}

fun cancel_operation(context: ptr, reason: cancel.Reason) {
    val operation: *Operation = context::*Operation;
    mutex.lock(?operation.lock);
    operation.cancellation_active = false;
    operation.cancellation_requested = true;
    operation.cancellation_error = reason_error(reason);
    if (operation.state != OPERATION_WAITING) {
        terminal_locked(operation, operation.cancellation_error, false, true);
    }
    mutex.unlock(?operation.lock);
}

pub fun begin(
    operation: *Operation,
    token: Token,
    kind: ApplicationKind,
    scope: *cancel.Scope,
    buffer: *u8,
    length: usize,
    context: usize,
) bool {
    if (operation == nil || token.generation == 0 || scope == nil || kind < APPLICATION_READ || kind > APPLICATION_CLOSE || (buffer == nil && length != 0) || (kind == APPLICATION_CLOSE && (buffer != nil || length != 0))) {
        ret false;
    }
    operation.token = token;
    operation.kind = kind;
    operation.scope = scope;
    operation.application_buffer = buffer;
    operation.application_length = length;
    operation.application_bytes = 0;
    operation.context = context;
    operation.state = OPERATION_OPEN;
    operation.lower_kind = 0;
    operation.lower_buffer = nil;
    operation.lower_length = 0;
    operation.last_transport_bytes = 0;
    operation.last_end_of_stream = false;
    operation.terminal_error = error.OK;
    operation.cancellation_active = false;
    operation.cancellation_requested = false;
    operation.cancellation_error = error.OK;
    operation.lock = mutex.make();
    cancel.init_registration(?operation.cancellation);
    val attached: cancel.Reason = cancel.attach(scope, ?operation.cancellation, cancel_operation, operation::ptr);
    if (attached == cancel.ACTIVE) {
        operation.cancellation_active = true;
    } or {
        operation.cancellation_requested = true;
        operation.cancellation_error = reason_error(attached);
        operation.terminal_error = operation.cancellation_error;
        operation.state = OPERATION_TERMINAL;
    }
    ret true;
}

fun action_submission(transport: *Transport, operation: *Operation, action: Action) Result[io_runtime.Token, io_error.Error] {
    if (action.kind == TRANSPORT_READ) {
        ret read(transport, operation.scope, action.buffer, action.length, action.context);
    }
    if (action.kind == TRANSPORT_WRITE) {
        ret write(transport, operation.scope, action.buffer, action.length, action.context);
    }
    if (action.kind == TRANSPORT_CLOSE) {
        if (action.buffer != nil || action.length != 0) { ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_CLOSE)); }
        ret close(transport, operation.scope, action.context);
    }
    ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_SUBMIT));
}

# engines may sequence reads and writes under one stable application token
pub fun begin_action(operation: *Operation, transport: *Transport, action: Action) bool {
    if (operation == nil || !valid(transport)) { ret false; }
    mutex.lock(?operation.lock);
    if (operation.state != OPERATION_OPEN || operation.cancellation_requested || (action.kind != TRANSPORT_CLOSE && action.buffer == nil && action.length != 0)) {
        mutex.unlock(?operation.lock);
        ret false;
    }
    val submitted: Result[io_runtime.Token, io_error.Error] = action_submission(transport, operation, action);
    if (is_err[io_runtime.Token, io_error.Error](submitted)) {
        terminal_locked(operation, map_error(unwrap_err[io_runtime.Token, io_error.Error](submitted)), false, false);
        mutex.unlock(?operation.lock);
        ret false;
    }
    operation.lower_token = unwrap_ok[io_runtime.Token, io_error.Error](submitted);
    operation.lower_kind = action.kind;
    operation.lower_buffer = action.buffer;
    operation.lower_length = action.length;
    operation.state = OPERATION_WAITING;
    mutex.unlock(?operation.lock);
    ret true;
}

fun token_equals(a: io_runtime.Token, b: io_runtime.Token) bool {
    ret a.index == b.index && a.generation == b.generation;
}

fun completion_matches(operation: *Operation, completion: *io_runtime.Completion) bool {
    if (!token_equals(operation.lower_token, completion.token)) { ret false; }
    if (operation.lower_kind == TRANSPORT_READ) { ret completion.kind == io_runtime.READ; }
    if (operation.lower_kind == TRANSPORT_WRITE) { ret completion.kind == io_runtime.WRITE; }
    ret completion.kind == io_runtime.CLOSE || completion.kind == io_runtime.SHUTDOWN;
}

pub fun accept(operation: *Operation, completion: *io_runtime.Completion) bool {
    if (operation == nil || completion == nil) { ret false; }
    mutex.lock(?operation.lock);
    if (operation.state != OPERATION_WAITING || !completion_matches(operation, completion)) {
        mutex.unlock(?operation.lock);
        ret false;
    }
    val lower_kind: ActionKind = operation.lower_kind;
    val lower_length: usize = operation.lower_length;
    operation.state = OPERATION_OPEN;
    operation.lower_kind = 0;
    operation.lower_buffer = nil;
    operation.lower_length = 0;
    operation.last_transport_bytes = completion.bytes;
    operation.last_end_of_stream = completion.end_of_stream;
    if (operation.cancellation_requested) {
        terminal_locked(operation, operation.cancellation_error, false, true);
    } or (completion.has_error) {
        terminal_locked(operation, map_error(completion.error), false, false);
    } or ((lower_kind == TRANSPORT_READ || lower_kind == TRANSPORT_WRITE) && completion.bytes > lower_length) {
        terminal_locked(operation, error.INTERNAL_ERROR, false, false);
    } or (lower_kind == TRANSPORT_CLOSE) {
        terminal_locked(operation, error.OK, false, false);
    }
    mutex.unlock(?operation.lock);
    ret true;
}

pub fun advance(operation: *Operation, bytes: usize) bool {
    if (operation == nil) { ret false; }
    mutex.lock(?operation.lock);
    if (operation.state != OPERATION_OPEN || bytes > operation.application_length - operation.application_bytes) {
        mutex.unlock(?operation.lock);
        ret false;
    }
    operation.application_bytes = operation.application_bytes + bytes;
    mutex.unlock(?operation.lock);
    ret true;
}

pub fun finish(operation: *Operation, terminal_error: error.Error, end_of_stream: bool) bool {
    if (operation == nil) { ret false; }
    mutex.lock(?operation.lock);
    val finished: bool = terminal_locked(operation, terminal_error, end_of_stream, false);
    mutex.unlock(?operation.lock);
    ret finished;
}

pub fun snapshot(operation: *Operation) Snapshot {
    var result: Snapshot;
    if (operation == nil) { ret result; }
    mutex.lock(?operation.lock);
    result.token = operation.token;
    result.kind = operation.kind;
    result.state = operation.state;
    result.context = operation.context;
    result.application_bytes = operation.application_bytes;
    result.last_transport_bytes = operation.last_transport_bytes;
    result.last_end_of_stream = operation.last_end_of_stream;
    result.terminal_error = operation.terminal_error;
    mutex.unlock(?operation.lock);
    ret result;
}

pub fun destroy_operation(operation: *Operation) bool {
    if (operation == nil) { ret false; }
    mutex.lock(?operation.lock);
    if (operation.state != OPERATION_TERMINAL || operation.cancellation_active) {
        mutex.unlock(?operation.lock);
        ret false;
    }
    operation.scope = nil;
    operation.application_buffer = nil;
    operation.application_length = 0;
    operation.lower_buffer = nil;
    operation.lower_length = 0;
    operation.state = OPERATION_DESTROYED;
    mutex.unlock(?operation.lock);
    ret true;
}

rec TestTransport {
    runtime: *io_runtime.Runtime;
    last_scope: *cancel.Scope;
    reads: usize;
    writes: usize;
    closes: usize;
}

fun test_submit(context: ptr, scope: *cancel.Scope, kind: io_runtime.Kind, buffer: *u8, length: usize, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val transport: *TestTransport = context::*TestTransport;
    val operation: io_runtime.Operation = io_runtime.Operation{kind: kind, resource: 1, buffer: buffer, length: length, offset: 0, context: token_context};
    ret io_runtime.submit_scoped(transport.runtime, scope, operation);
}

fun test_read(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val transport: *TestTransport = context::*TestTransport;
    transport.last_scope = scope;
    transport.reads = transport.reads + 1;
    ret test_submit(context, scope, io_runtime.READ, buffer, length, token_context);
}

fun test_write(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val transport: *TestTransport = context::*TestTransport;
    transport.last_scope = scope;
    transport.writes = transport.writes + 1;
    ret test_submit(context, scope, io_runtime.WRITE, buffer, length, token_context);
}

fun test_close(context: ptr, scope: *cancel.Scope, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val transport: *TestTransport = context::*TestTransport;
    transport.last_scope = scope;
    transport.closes = transport.closes + 1;
    ret test_submit(context, scope, io_runtime.CLOSE, nil, 0, token_context);
}

fun make_test_transport(transport: *Transport, state: *TestTransport, runtime: *io_runtime.Runtime) {
    state.runtime = runtime;
    state.last_scope = nil;
    state.reads = 0;
    state.writes = 0;
    state.closes = 0;
    transport.runtime = runtime;
    transport.context = state::ptr;
    transport.submit_read = test_read;
    transport.submit_write = test_write;
    transport.submit_close = test_close;
}

fun take_one(runtime: *io_runtime.Runtime, completion: *io_runtime.Completion) bool {
    val polled: Result[usize, io_error.Error] = io_runtime.poll(runtime, completion, 1);
    if (is_err[usize, io_error.Error](polled)) { ret false; }
    ret unwrap_ok[usize, io_error.Error](polled) == 1;
}

test "transport: one application write may drive write and read completions" {
    var runtime: io_runtime.Runtime;
    if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 8))) { ret 1; }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, true, time.Time{sec: 999999999, nsec: 0})) { ret 2; }
    var transport_state: TestTransport;
    var transport: Transport;
    make_test_transport(?transport, ?transport_state, ?runtime);
    var application: [8]u8;
    var wire: [16]u8;
    val token: Token = Token{index: 4, generation: 7};
    var operation: Operation;
    if (!begin(?operation, token, APPLICATION_WRITE, ?scope, ?application[0], 8, 99)) { ret 3; }
    if (!begin_action(?operation, ?transport, Action{kind: TRANSPORT_WRITE, buffer: ?wire[0], length: 16, context: 101})) { ret 4; }
    val first_lower: io_runtime.Token = operation.lower_token;
    if (is_err[bool, io_error.Error](io_runtime.complete(?runtime, first_lower, 5, 0, false))) { ret 5; }
    var completion: io_runtime.Completion;
    if (!take_one(?runtime, ?completion) || !accept(?operation, ?completion)) { ret 6; }
    if (accept(?operation, ?completion)) { ret 7; }
    val after_write: Snapshot = snapshot(?operation);
    if (after_write.state != OPERATION_OPEN || after_write.token.index != token.index || after_write.token.generation != token.generation || after_write.last_transport_bytes != 5 || transport_state.last_scope != ?scope) { ret 8; }
    if (!begin_action(?operation, ?transport, Action{kind: TRANSPORT_READ, buffer: ?wire[0], length: 16, context: 102})) { ret 9; }
    if (is_err[bool, io_error.Error](io_runtime.complete(?runtime, operation.lower_token, 9, 0, false))) { ret 10; }
    if (!take_one(?runtime, ?completion) || !accept(?operation, ?completion)) { ret 11; }
    if (!advance(?operation, 8) || !finish(?operation, error.OK, false) || finish(?operation, error.OK, false)) { ret 12; }
    val terminal: Snapshot = snapshot(?operation);
    if (terminal.state != OPERATION_TERMINAL || terminal.application_bytes != 8 || transport_state.reads != 1 || transport_state.writes != 1) { ret 13; }
    if (!destroy_operation(?operation) || !cancel.destroy(?scope) || is_err[bool, io_error.Error](io_runtime.close(?runtime)) || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 14; }
    ret 0;
}

test "transport: cancellation waits for lower buffer ownership" {
    var runtime: io_runtime.Runtime;
    if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 1; }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 2; }
    var transport_state: TestTransport;
    var transport: Transport;
    make_test_transport(?transport, ?transport_state, ?runtime);
    var buffer: [4]u8;
    var operation: Operation;
    if (!begin(?operation, Token{index: 1, generation: 1}, APPLICATION_READ, ?scope, ?buffer[0], 4, 0)) { ret 3; }
    if (!begin_action(?operation, ?transport, Action{kind: TRANSPORT_READ, buffer: ?buffer[0], length: 4, context: 0})) { ret 4; }
    if (finish(?operation, error.CANCELLED, false)) { ret 5; }
    if (!cancel.cancel(?scope)) { ret 6; }
    if (snapshot(?operation).state != OPERATION_WAITING || operation.application_buffer != ?buffer[0] || operation.lower_buffer != ?buffer[0]) { ret 7; }
    var completion: io_runtime.Completion;
    if (!take_one(?runtime, ?completion) || !accept(?operation, ?completion)) { ret 8; }
    val terminal: Snapshot = snapshot(?operation);
    if (terminal.state != OPERATION_TERMINAL || terminal.terminal_error != error.CANCELLED) { ret 9; }
    if (!destroy_operation(?operation) || operation.application_buffer != nil || operation.lower_buffer != nil || !cancel.destroy(?scope) || is_err[bool, io_error.Error](io_runtime.close(?runtime)) || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 10; }
    ret 0;
}

test "transport: eof and close settle once" {
    var runtime: io_runtime.Runtime;
    if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 8))) { ret 1; }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 2; }
    var transport_state: TestTransport;
    var transport: Transport;
    make_test_transport(?transport, ?transport_state, ?runtime);
    var buffer: [1]u8;
    var read_operation: Operation;
    if (!begin(?read_operation, Token{index: 1, generation: 2}, APPLICATION_READ, ?scope, ?buffer[0], 1, 0)) { ret 3; }
    if (!begin_action(?read_operation, ?transport, Action{kind: TRANSPORT_READ, buffer: ?buffer[0], length: 1, context: 0})) { ret 4; }
    if (is_err[bool, io_error.Error](io_runtime.complete(?runtime, read_operation.lower_token, 0, 0, true))) { ret 5; }
    var completion: io_runtime.Completion;
    if (!take_one(?runtime, ?completion) || !accept(?read_operation, ?completion)) { ret 6; }
    if (!snapshot(?read_operation).last_end_of_stream || !finish(?read_operation, error.CLOSED, true) || finish(?read_operation, error.CLOSED, true)) { ret 7; }
    if (!destroy_operation(?read_operation)) { ret 8; }
    var close_operation: Operation;
    if (!begin(?close_operation, Token{index: 2, generation: 2}, APPLICATION_CLOSE, ?scope, nil, 0, 0)) { ret 9; }
    if (!begin_action(?close_operation, ?transport, Action{kind: TRANSPORT_CLOSE, buffer: nil, length: 0, context: 0})) { ret 10; }
    if (is_err[bool, io_error.Error](io_runtime.complete(?runtime, close_operation.lower_token, 0, 0, false))) { ret 11; }
    if (!take_one(?runtime, ?completion) || !accept(?close_operation, ?completion)) { ret 12; }
    if (snapshot(?close_operation).terminal_error != error.OK || finish(?close_operation, error.OK, false)) { ret 13; }
    if (!destroy_operation(?close_operation) || transport_state.closes != 1 || !cancel.destroy(?scope) || is_err[bool, io_error.Error](io_runtime.close(?runtime)) || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 14; }
    ret 0;
}

test "transport: timeout resolves an idle operation once" {
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 1; }
    var operation: Operation;
    if (!begin(?operation, Token{index: 3, generation: 9}, HANDSHAKE, ?scope, nil, 0, 0)) { ret 2; }
    if (!cancel.timeout(?scope)) { ret 3; }
    val terminal: Snapshot = snapshot(?operation);
    if (terminal.state != OPERATION_TERMINAL || terminal.terminal_error != error.TIMEOUT) { ret 4; }
    if (finish(?operation, error.TIMEOUT, false)) { ret 5; }
    if (!destroy_operation(?operation) || !cancel.destroy(?scope)) { ret 6; }
    ret 0;
}
