# deterministic structured mutation corpora for every parsing surface
#
# this is not coverage-guided fuzzing. it is a seeded, reproducible mutator run
# over valid inputs at each layer, asserting that a mutated input is never
# accepted, never consumes more than it was given, and never leaves a parser
# reporting progress it did not make.

use crypto.contracts;
use crypto.encoding.keys;
use crypto.secret;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.cert;
use tls.cert.credentials;
use tls.cert.load;
use tls.error;
use tls.handshake;
use tls.handshake.codec;
use tls.handshake.extensions;
use tls.record;
use tls.tls12;
use tls.tls12.messages;
use tls.tls13;

pub val MAX_CORPUS: usize = 4096;

pub def Mutation: u8;
pub val FLIP_BIT:       Mutation = 0;
pub val SET_BYTE:       Mutation = 1;
pub val TRUNCATE:       Mutation = 2;
pub val EXTEND:         Mutation = 3;
pub val SWAP:           Mutation = 4;
pub val ZERO_RUN:       Mutation = 5;
pub val MUTATION_KINDS: usize    = 6;

# one reproducible pseudorandom sequence; the corpus must be replayable
pub fun advance(state: u64) u64 {
    ret state * 6364136223846793005 + 1442695040888963407;
}

fun draw(state: *u64, bound: usize) usize {
    if (bound == 0) { ret 0; }
    @state = advance(@state);
    ret ((@state >> 33)::usize) % bound;
}

# apply exactly one mutation and report the resulting length
pub fun mutate(state: *u64, buffer: *u8, length: usize,
    capacity: usize) usize {
    if (buffer == nil || length == 0 || capacity < length) { ret length; }
    val kind:     Mutation = draw(state, MUTATION_KINDS)::u8;
    val position: usize    = draw(state, length);
    if (kind == FLIP_BIT) {
        buffer[position] = buffer[position] ^ (1::u8 << draw(state, 8)::u8);
        ret length;
    }
    if (kind == SET_BYTE) {
        buffer[position] = draw(state, 256)::u8;
        ret length;
    }
    if (kind == TRUNCATE) {
        val kept: usize = draw(state, length);
        if (kept == 0) { ret 1; }
        ret kept;
    }
    if (kind == EXTEND) {
        if (length >= capacity) { ret length; }
        val added: usize = draw(state, capacity - length);
        var i:     usize = 0;
        for (i < added) {
            buffer[length + i] = draw(state, 256)::u8;
            i                  = i + 1;
        }
        ret length + added;
    }
    if (kind == SWAP) {
        val other: usize = draw(state, length);
        val held:  u8    = buffer[position];
        buffer[position] = buffer[other];
        buffer[other]    = held;
        ret length;
    }
    var run: usize = draw(state, 8) + 1;
    if (run > length - position) { run = length - position; }
    var i: usize = 0;
    for (i < run) {
        buffer[position + i] = 0;
        i                    = i + 1;
    }
    ret length;
}

fun copy_bytes(destination: *u8, source: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = source[i];
        i              = i + 1;
    }
}

var record_seed: [record.HEADER_SIZE + 64]u8;
var record_case: [MAX_CORPUS]u8;

test "validation: mutated records never report progress they did not make" {
    var length: usize = record.HEADER_SIZE + 32;
    record_seed[0] = record.HANDSHAKE;
    record_seed[1] = 3;
    record_seed[2] = 3;
    record_seed[3] = 0;
    record_seed[4] = 32;
    var i: usize = 0;
    for (i < 32) {
        record_seed[record.HEADER_SIZE + i] = i::u8;
        i                                   = i + 1;
    }
    var state:     u64   = 0x5eed12345678;
    var iteration: usize = 0;
    for (iteration < 2048) {
        copy_bytes(?record_case[0], ?record_seed[0], length);
        var mutated: usize = length;
        var rounds:  usize = draw(?state, 3) + 1;
        var applied: usize = 0;
        for (applied < rounds) {
            mutated = mutate(?state, ?record_case[0], mutated, MAX_CORPUS);
            applied = applied + 1;
        }
        var protocol: record.Protocol = record.TLS13;
        if (draw(?state, 2) == 1) { protocol = record.TLS12; }
        val protected: bool          = draw(?state, 2) == 1;
        val parsed:    record.Parsed = record.inspect(?record_case[0], mutated,
            protocol, protected);
        if (parsed.status == record.PARSE_READY) {
            # a frame is only ever published inside the bytes it was given
            if (parsed.frame.consumed > mutated)                    { ret 1; }
            if (parsed.frame.length > mutated - record.HEADER_SIZE) { ret 2; }
            if (parsed.frame.consumed != record.HEADER_SIZE +
                parsed.frame.length) { ret 3; }
            if (parsed.frame.length != 0 &&
                parsed.frame.fragment != ?record_case[record.HEADER_SIZE]) {
                ret 4;
            }
        }
        if (parsed.status == record.PARSE_MORE && parsed.required <= mutated) {
            ret 5;
        }
        if (parsed.status == record.PARSE_FAILED &&
            parsed.error == error.OK) { ret 6; }
        iteration = iteration + 1;
    }
    ret 0;
}

var frame_seed: [64]u8;
var frame_case: [MAX_CORPUS]u8;

test "validation: mutated handshake frames never publish a partial view" {
    var body: [16]u8;
    var i:    usize = 0;
    for (i < 16) {
        body[i] = (0x30 + i)::u8;
        i       = i + 1;
    }
    val encoded: handshake.Progress = handshake.serialize(handshake.FINISHED,
        contracts.Bytes{data: ?body[0], len: 16},
        contracts.Buffer{data: ?frame_seed[0], capacity: 64});
    if (encoded.status != handshake.COMPLETE) { ret 1; }
    val length:    usize = encoded.produced;
    var state:     u64   = 0x1337c0ffee;
    var iteration: usize = 0;
    for (iteration < 2048) {
        copy_bytes(?frame_case[0], ?frame_seed[0], length);
        var mutated: usize = length;
        var rounds:  usize = draw(?state, 3) + 1;
        var applied: usize = 0;
        for (applied < rounds) {
            mutated = mutate(?state, ?frame_case[0], mutated, MAX_CORPUS);
            applied = applied + 1;
        }
        var message:       handshake.Message;
        val tls12_framing: bool               = draw(?state, 2) == 1;
        val parsed:        handshake.Progress = handshake.parse_version(
            ?frame_case[0], mutated, 1024, tls12_framing, ?message);
        if (parsed.status == handshake.COMPLETE) {
            if (parsed.consumed > mutated)                      { ret 2; }
            if (message.body.len::u32 != message.header.length) { ret 3; }
            if (parsed.consumed != handshake.HEADER_SIZE + message.body.len) {
                ret 4;
            }
            if (message.body.len != 0 &&
                message.body.data != ?frame_case[handshake.HEADER_SIZE]) {
                ret 5;
            }
        }
        if (parsed.status == handshake.NEED_INPUT &&
            parsed.required <= mutated) { ret 6; }
        if (parsed.status == handshake.REJECTED &&
            parsed.error == error.OK) { ret 7; }
        iteration = iteration + 1;
    }
    ret 0;
}

var hello_extensions: [128]u8;
var hello_seed:       [512]u8;
var hello_case:       [MAX_CORPUS]u8;

fun build_client_hello(output: *u8, capacity: usize) usize {
    var offset: usize = 0;
    hello_extensions[offset]     = 0;
    hello_extensions[offset + 1] = 43;
    hello_extensions[offset + 2] = 0;
    hello_extensions[offset + 3] = 3;
    hello_extensions[offset + 4] = 2;
    hello_extensions[offset + 5] = 3;
    hello_extensions[offset + 6] = 4;
    offset                       = 7;
    hello_extensions[offset]     = 0;
    hello_extensions[offset + 1] = 10;
    hello_extensions[offset + 2] = 0;
    hello_extensions[offset + 3] = 4;
    hello_extensions[offset + 4] = 0;
    hello_extensions[offset + 5] = 2;
    hello_extensions[offset + 6] = 0;
    hello_extensions[offset + 7] = 29;
    offset                       = offset + 8;
    hello_extensions[offset]     = 0;
    hello_extensions[offset + 1] = 13;
    hello_extensions[offset + 2] = 0;
    hello_extensions[offset + 3] = 4;
    hello_extensions[offset + 4] = 0;
    hello_extensions[offset + 5] = 2;
    hello_extensions[offset + 6] = 8;
    hello_extensions[offset + 7] = 7;
    offset                       = offset + 8;
    hello_extensions[offset]     = 0;
    hello_extensions[offset + 1] = 51;
    hello_extensions[offset + 2] = 0;
    hello_extensions[offset + 3] = 38;
    hello_extensions[offset + 4] = 0;
    hello_extensions[offset + 5] = 36;
    hello_extensions[offset + 6] = 0;
    hello_extensions[offset + 7] = 29;
    hello_extensions[offset + 8] = 0;
    hello_extensions[offset + 9] = 32;
    var i: usize = 0;
    for (i < 32) {
        hello_extensions[offset + 10 + i] = (0x50 + i)::u8;
        i                                 = i + 1;
    }
    offset = offset + 42;
    var random: [32]u8;
    i = 0;
    for (i < 32) {
        random[i] = (0x11 + i)::u8;
        i         = i + 1;
    }
    var suites:      [2]u8 = [2]u8{0x13, 0x01};
    var compression: [1]u8;
    var hello:       codec.ClientHello;
    hello.legacy_version      = tls13.LEGACY_VERSION;
    hello.random              = contracts.Bytes{data: ?random[0], len: 32};
    hello.legacy_session_id   = contracts.Bytes{data: nil, len: 0};
    hello.cipher_suites       = contracts.Bytes{data: ?suites[0], len: 2};
    hello.compression_methods = contracts.Bytes{data: ?compression[0], len: 1};
    hello.extensions          = extensions.list(?hello_extensions[0], offset,
        extensions.CLIENT_HELLO);
    hello.after_retry = false;
    val encoded: handshake.Progress = codec.encode_client_hello(?hello,
        contracts.Buffer{data: output, capacity: capacity});
    if (encoded.status != handshake.COMPLETE) { ret 0; }
    ret encoded.produced;
}

test "validation: mutated tls 1.3 client hellos never decode as valid" {
    val length: usize = build_client_hello(?hello_seed[0], 512);
    if (length == 0) { ret 1; }
    var message: handshake.Message;
    if (handshake.parse(?hello_seed[0], length, 4096, ?message).status !=
        handshake.COMPLETE) { ret 2; }
    var original: codec.ClientHello;
    if (codec.decode_client_hello(?message, false, ?original) != error.OK) {
        ret 3;
    }
    var state:     u64   = 0xabcdef0123;
    var accepted:  usize = 0;
    var iteration: usize = 0;
    for (iteration < 1024) {
        copy_bytes(?hello_case[0], ?hello_seed[0], length);
        var mutated: usize = length;
        var rounds:  usize = draw(?state, 2) + 1;
        var applied: usize = 0;
        for (applied < rounds) {
            mutated = mutate(?state, ?hello_case[0], mutated, MAX_CORPUS);
            applied = applied + 1;
        }
        var frame:  handshake.Message;
        val parsed: handshake.Progress = handshake.parse(?hello_case[0],
            mutated, 4096, ?frame);
        if (parsed.status == handshake.COMPLETE) {
            var decoded: codec.ClientHello;
            val outcome: error.Error = codec.decode_client_hello(?frame, false,
                ?decoded);
            if (outcome == error.OK) {
                # an accepted mutation must still be structurally exact
                if (decoded.random.len != 32 ||
                    decoded.legacy_version != tls13.LEGACY_VERSION ||
                    decoded.compression_methods.len != 1 ||
                    decoded.compression_methods.data[0] != 0 ||
                    (decoded.cipher_suites.len & 1) != 0 ||
                    decoded.extensions.len > mutated) { ret 4; }
                if (codec.validate_client(?decoded) != error.OK) { ret 5; }
                accepted = accepted + 1;
            }
        }
        iteration = iteration + 1;
    }
    # the corpus must exercise both outcomes to be worth anything
    if (accepted == 0 || accepted == 1024) { ret 6; }
    ret 0;
}

var tls12_seed:       [512]u8;
var tls12_case:       [MAX_CORPUS]u8;
var tls12_extensions: [32]u8;

test "validation: mutated tls 1.2 server hellos never decode as valid" {
    var random: [32]u8;
    var i:      usize = 0;
    for (i < 32) {
        random[i] = (0x70 + i)::u8;
        i         = i + 1;
    }
    tls12_extensions[0] = 0;
    tls12_extensions[1] = 23;
    tls12_extensions[2] = 0;
    tls12_extensions[3] = 0;
    tls12_extensions[4] = 0xff;
    tls12_extensions[5] = 0x01;
    tls12_extensions[6] = 0;
    tls12_extensions[7] = 1;
    tls12_extensions[8] = 0;
    var hello: messages.ServerHello;
    hello.legacy_version     = tls12.VERSION;
    hello.random             = contracts.Bytes{data: ?random[0], len: 32};
    hello.session_id         = contracts.Bytes{data: nil, len: 0};
    hello.cipher_suite       = tls12.ECDHE_ECDSA_AES_128_GCM_SHA256;
    hello.compression_method = 0;
    hello.extensions         = extensions.list(?tls12_extensions[0], 9,
        extensions.TLS12_SERVER_HELLO);
    val encoded: handshake.Progress = messages.encode_server_hello(?hello,
        contracts.Buffer{data: ?tls12_seed[0], capacity: 512});
    if (encoded.status != handshake.COMPLETE) { ret 1; }
    val length:    usize = encoded.produced;
    var state:     u64   = 0x9911223344;
    var accepted:  usize = 0;
    var iteration: usize = 0;
    for (iteration < 1024) {
        copy_bytes(?tls12_case[0], ?tls12_seed[0], length);
        var mutated: usize = length;
        var rounds:  usize = draw(?state, 2) + 1;
        var applied: usize = 0;
        for (applied < rounds) {
            mutated = mutate(?state, ?tls12_case[0], mutated, MAX_CORPUS);
            applied = applied + 1;
        }
        var frame:  handshake.Message;
        val parsed: handshake.Progress = handshake.parse_version(
            ?tls12_case[0], mutated, 4096, true, ?frame);
        if (parsed.status == handshake.COMPLETE) {
            var decoded: messages.ServerHello;
            if (messages.decode_server_hello(?frame, ?decoded) == error.OK) {
                if (decoded.random.len != 32 ||
                    decoded.legacy_version != tls12.VERSION ||
                    decoded.compression_method != 0 ||
                    decoded.session_id.len > 32 ||
                    decoded.extensions.len > mutated) { ret 2; }
                accepted = accepted + 1;
            }
        }
        iteration = iteration + 1;
    }
    if (accepted == 0 || accepted == 1024) { ret 3; }
    ret 0;
}

var exchange_seed: [256]u8;
var exchange_case: [MAX_CORPUS]u8;

test "validation: mutated key exchanges never publish an unchecked point" {
    var point: [32]u8;
    var i:     usize = 0;
    for (i < 32) {
        point[i] = (0x20 + i)::u8;
        i        = i + 1;
    }
    var signature_bytes: [64]u8;
    i = 0;
    for (i < 64) {
        signature_bytes[i] = (0x90 + i)::u8;
        i                  = i + 1;
    }
    var exchange: messages.ServerKeyExchange;
    exchange.curve      = tls13.X25519;
    exchange.public_key = contracts.Bytes{data: ?point[0], len: 32};
    exchange.scheme     = tls13.ED25519;
    exchange.signature  = contracts.Bytes{data: ?signature_bytes[0], len: 64};
    val encoded: handshake.Progress = messages.encode_server_key_exchange(
        ?exchange, contracts.Buffer{data: ?exchange_seed[0], capacity: 256});
    if (encoded.status != handshake.COMPLETE) { ret 1; }
    val length:    usize = encoded.produced;
    var state:     u64   = 0x2468ace013;
    var accepted:  usize = 0;
    var iteration: usize = 0;
    for (iteration < 1024) {
        copy_bytes(?exchange_case[0], ?exchange_seed[0], length);
        var mutated: usize = length;
        var rounds:  usize = draw(?state, 2) + 1;
        var applied: usize = 0;
        for (applied < rounds) {
            mutated = mutate(?state, ?exchange_case[0], mutated, MAX_CORPUS);
            applied = applied + 1;
        }
        var frame:  handshake.Message;
        val parsed: handshake.Progress = handshake.parse_version(
            ?exchange_case[0], mutated, 4096, true, ?frame);
        if (parsed.status == handshake.COMPLETE) {
            var decoded: messages.ServerKeyExchange;
            if (messages.decode_server_key_exchange(?frame, ?decoded) ==
                error.OK) {
                # every accepted point matches its curve exactly
                if (decoded.curve == tls13.X25519 &&
                    decoded.public_key.len != 32) { ret 2; }
                if (decoded.curve == tls13.SECP256R1 &&
                    (decoded.public_key.len != 65 ||
                    decoded.public_key.data[0] != 4)) { ret 3; }
                if (!messages.valid_named_curve(decoded.curve))       { ret 4; }
                if (!messages.valid_signature_scheme(decoded.scheme)) { ret 5; }
                # the signed prefix never runs past the message
                if (decoded.params.len > mutated) { ret 6; }
                accepted = accepted + 1;
            }
        }
        iteration = iteration + 1;
    }
    if (accepted == 0 || accepted == 1024) { ret 7; }
    ret 0;
}

var alert_case: [16]u8;

test "validation: mutated alerts never decode outside the known set" {
    var state:     u64   = 0x77665544;
    var iteration: usize = 0;
    for (iteration < 512) {
        alert_case[0] = draw(?state, 256)::u8;
        alert_case[1] = draw(?state, 256)::u8;
        var message:  record.AlertMessage;
        var protocol: record.Protocol = record.TLS13;
        if (draw(?state, 2) == 1) { protocol = record.TLS12; }
        if (record.decode_alert(protocol, ?alert_case[0], 2, ?message) ==
            error.OK) {
            if (message.description != alert_case[1]) { ret 1; }
            if (alert_case[0] != record.WARNING &&
                alert_case[0] != record.FATAL) { ret 2; }
        }
        # a length other than two is never a valid alert
        if (record.decode_alert(protocol, ?alert_case[0], 1, ?message) ==
            error.OK) { ret 3; }
        if (record.decode_alert(protocol, ?alert_case[0], 3, ?message) ==
            error.OK) { ret 4; }
        iteration = iteration + 1;
    }
    ret 0;
}

var allocation_failures: usize;

fun failing_allocate(context: ptr, secret_context: *^u8, length: usize,
    output: **^u8) i64 {
    allocation_failures = allocation_failures + 1;
    @output             = nil;
    ret -1;
}

fun failing_deallocate(context: ptr, secret_context: *^u8, data: *^u8,
    length: usize) i64 {
    ret 0;
}

test "validation: an allocation failure never publishes a partial key" {
    var key_der: [48]^u8 = [48]^u8{
        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06,
        0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20,
        0xeb, 0x3b, 0x8b, 0xa3, 0x21, 0x67, 0x09, 0xef,
        0x29, 0x39, 0x0e, 0x9c, 0x43, 0x84, 0x01, 0xbe,
        0xca, 0x3f, 0xf8, 0x03, 0x7d, 0x60, 0xbb, 0x30,
        0x42, 0x18, 0xc8, 0x8c, 0xd4, 0xb7, 0x9b, 0x72,
    };
    var failing: secret.Allocator = secret.Allocator{context: nil,
        secret_context: nil, allocate_fn: failing_allocate,
        deallocate_fn:  failing_deallocate, initialized: true};
    allocation_failures = 0;
    var key:     keys.PrivateKey = keys.empty_private();
    val refused: contracts.Error = load.private_der(
        contracts.SecretBytes{data: ?key_der[0], len: 48}, cert.PKCS8_DER,
        ?failing, ?key);
    if (refused == contracts.OK)  { ret 1; }
    if (allocation_failures == 0) { ret 2; }
    # nothing was published, so the key is still the empty one
    if (key.algorithm != 0 || key.private_len != 0 || key.encoded_len != 0) {
        ret 3;
    }
    var chain_entry: cert.Certificate = cert.Certificate{der: "x"::*u8,
        der_len: 1};
    var chain: cert.Chain = cert.Chain{certificates: ?chain_entry, len: 1};
    if (credentials.key_matches(?chain, ?key)) { ret 4; }
    var identity: credentials.Identity;
    identity.server_name = contracts.Bytes{data: nil, len: 0};
    identity.chain       = chain;
    identity.private_key = ?key;
    var generation: credentials.Generation = credentials.empty_generation();
    # a credential generation is never published from an unusable key
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) == contracts.OK) { ret 5; }
    # the rejected generation published nothing at all
    if (generation.identities != nil || generation.identity_len != 0 ||
        generation.client_trust != nil ||
        generation.default_index != credentials.NO_DEFAULT) { ret 6; }

    # the same input succeeds with a working allocator, so the refusal above
    # was the allocator and not the input
    var working:  secret.Allocator = secret.system_allocator();
    var accepted: keys.PrivateKey  = keys.empty_private();
    if (load.private_der(contracts.SecretBytes{data: ?key_der[0], len: 48},
        cert.PKCS8_DER, ?working, ?accepted) != contracts.OK) { ret 7; }
    if (accepted.algorithm != keys.ED25519)              { ret 8; }
    if (keys.destroy_private(?accepted) != contracts.OK) { ret 9; }
    ct.zeroize(?key_der[0], 48);
    ret 0;
}
