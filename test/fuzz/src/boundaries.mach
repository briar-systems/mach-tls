# every untrusted-input entry point the lane answers, by corpus directory name

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use fuzz.certificate;
use fuzz.extensions;
use fuzz.handshake;
use fuzz.record;
use fuzz.tls12;
use fuzz.verdict;

pub def AnswerFn: fun(*u8, usize) verdict.Verdict;

pub rec Boundary {
    name:   str;
    answer: AnswerFn;
}

pub val CAPACITY: usize = 32;

fun put(out: *Boundary, i: usize, name: str, answer: AnswerFn) usize {
    if (i >= CAPACITY) { ret i; }
    out[i].name   = name;
    out[i].answer = answer;
    ret i + 1;
}

pub fun all(out: *Boundary) usize {
    var i: usize = 0;
    i = put(out, i, "record", record.answer_record);
    i = put(out, i, "alert", record.answer_alert);
    i = put(out, i, "frame", handshake.answer_frame);
    i = put(out, i, "extensions", extensions.answer);
    i = put(out, i, "client-hello", handshake.answer_client_hello);
    i = put(out, i, "server-hello", handshake.answer_server_hello);
    i = put(out, i, "encrypted-extensions", handshake.answer_encrypted_extensions);
    i = put(out, i, "certificate-request", handshake.answer_certificate_request);
    i = put(out, i, "certificate", handshake.answer_certificate);
    i = put(out, i, "certificate-verify", handshake.answer_certificate_verify);
    i = put(out, i, "finished", handshake.answer_finished);
    i = put(out, i, "new-session-ticket", handshake.answer_new_session_ticket);
    i = put(out, i, "key-update", handshake.answer_key_update);
    i = put(out, i, "tls12-client-hello", tls12.answer_client_hello);
    i = put(out, i, "tls12-server-hello", tls12.answer_server_hello);
    i = put(out, i, "tls12-certificate", tls12.answer_certificate);
    i = put(out, i, "tls12-server-key-exchange", tls12.answer_server_key_exchange);
    i = put(out, i, "tls12-certificate-request", tls12.answer_certificate_request);
    i = put(out, i, "tls12-server-hello-done", tls12.answer_server_hello_done);
    i = put(out, i, "tls12-client-key-exchange", tls12.answer_client_key_exchange);
    i = put(out, i, "tls12-certificate-verify", tls12.answer_certificate_verify);
    i = put(out, i, "tls12-finished", tls12.answer_finished);
    i = put(out, i, "x509", certificate.answer);
    ret i;
}

pub fun lookup(table: *Boundary, n: usize, name: str) opt[usize] {
    var i: usize = 0;
    for (i < n) {
        if (str_equals(table[i].name, name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}
