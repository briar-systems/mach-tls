# the tls 1.3 and tls 1.2 server engines fed one mutated client hello
#
# an engine boundary's input is the bytes the engine ingests at the initial
# level: a whole handshake message, header included, so a mutation can reach
# the engine's own framing. each input goes to a fresh server built from the
# interop fixtures, which must come to one of three bounded states: failed with
# exactly one alert and refusing further input, progressed with every crypto
# event inside its output buffer and a configured suite and no completed
# handshake, or waiting for more with nothing queued. the connection's account
# holds nothing once the server is destroyed

use crypto.contracts;
use crypto.encoding.keys;
use crypto.secret;
use pki.cert;
use pki.load;
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use tls.buffer;
use tls.cert.credentials;
use tls.clock;
use tls.config;
use tls.engine;
use tls.error;
use tls.record;
use tls.server;
use tls.session;
use tls.tls12;
use tls12_connection: tls.tls12.connection;
use tls.tls13;

use A:  std.allocator;
use fs: std.filesystem;

use fuzz.pool;
use fuzz.verdict;

val FIXTURES: str   = "test/interop/fixtures";
val MAX_PEM:  usize = 8192;
# the fixtures are valid for a fixed window, and a fixed moment keeps every
# answer the same from one run to the next
val WALL: i64 = 1800000000;
# more events than either engine queues is a finding, and bounds the drain
val MAX_EVENTS: usize = 16;

rec Fixture {
    pem:        [MAX_PEM]u8;
    der:        [MAX_PEM]u8;
    chain:      [4]cert.Certificate;
    key:        keys.PrivateKey;
    identity:   [1]credentials.Identity;
    generation: credentials.Generation;
    store:      credentials.Store;
    protocols:  [1]config.ProtocolName;
    versions:   [1]u16;
    suites:     [6]u16;
    groups:     [2]tls13.NamedGroup;
    signatures: [5]tls13.SignatureScheme;
    listener:   config.ServerConfig;
    ready:      bool;
    failed:     bool;
}

var backing:   A.Allocator;
var owner:     secret.Allocator;
var moment:    clock.Moment;
var frozen:    clock.Source;
var counter:   u8;
var entropy:   secret.Entropy;
var memory:    pool.Harness;
var shared:    bool;
var key_bytes: [MAX_PEM]^u8;

var fixture13: Fixture;
var fixture12: Fixture;
var engine13:  server.Handshake;
var engine12:  tls12_connection.Handshake;

# the same bytes for every input, so an answer does not depend on the ones before it
#[oblivious]
fun counter_fill(context: ptr, secret_context: *^u8, destination: *^u8,
    length: usize) i64 {
    val state: *u8   = context::*u8;
    var i:     usize = 0;
    for (i < length) {
        destination[i] = state[0] + i::u8 + 1;
        i              = i + 1;
    }
    state[0] = state[0] + 23;
    ret 0;
}

fun read_fixture(name: str, output: *u8, length: *usize) bool {
    var path: [128]u8;
    var n:    usize = 0;
    var i:    usize = 0;
    for (FIXTURES[i]::u8 != 0) {
        path[n] = FIXTURES[i]::u8;
        n       = n + 1;
        i       = i + 1;
    }
    path[n] = '/';
    n       = n + 1;
    i       = 0;
    for (name[i]::u8 != 0 && n < 127) {
        path[n] = name[i]::u8;
        n       = n + 1;
        i       = i + 1;
    }
    path[n] = 0;
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?backing, (?path[0])::usize::str);
    if (sel read.err) { ret false; }
    var bytes: Vector[u8] = read.ok;
    val fits:  bool       = bytes.len != 0 && bytes.len < MAX_PEM;
    i = 0;
    for (fits && i < bytes.len) {
        output[i] = bytes.data[i];
        i         = i + 1;
    }
    @length = bytes.len;
    vector.dnit[u8](?bytes);
    ret fits;
}

#[oblivious]
fun copy_secret(destination: *^u8, source: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = source[i];
        i              = i + 1;
    }
}

# the process-wide pieces both fixtures borrow, made on first use
fun prepare_shared() bool {
    if (shared) { ret true; }
    val made: err[A.Error] = page.make(?backing);
    if (sel made.err)                          { ret false; }
    if (!pool.make(?memory, 1 << 24, 1 << 22)) { ret false; }
    owner   = secret.system_allocator();
    moment  = clock.at(WALL, 0);
    frozen  = clock.frozen(?moment);
    entropy = secret.Entropy{context: (?counter)::ptr, secret_context: nil,
        fill_fn: counter_fill, initialized: true};
    shared = true;
    ret true;
}

# one identity from the interop fixtures, published in a credential store
fun load_identity(value: *Fixture, certificate: str, private_key: str) bool {
    var length: usize = 0;
    if (!read_fixture(certificate, ?value.pem[0], ?length)) { ret false; }
    var chain:   cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?value.pem[0], len: length},
        contracts.Buffer{data: ?value.der[0], capacity: MAX_PEM},
        ?value.chain[0], 4, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0)    { ret false; }
    if (!read_fixture(private_key, ?value.pem[0], ?length)) { ret false; }
    copy_secret(?key_bytes[0], ?value.pem[0], length);
    value.key = keys.empty_private();
    val loaded: contracts.Error = load.private_pem(
        contracts.SecretBytes{data: ?key_bytes[0], len: length}, ?owner, ?value.key);
    ct.zeroize(?key_bytes[0], MAX_PEM);
    if (loaded != contracts.OK) { ret false; }
    value.identity[0].server_name = contracts.Bytes{data: "api.example.com"::*u8, len: 15};
    value.identity[0].chain       = chain;
    value.identity[0].private_key = ?value.key;
    value.generation              = credentials.empty_generation();
    value.store                   = credentials.empty_store();
    ret credentials.initialize(?value.generation, ?value.identity[0], 1, 0, nil,
        false) == contracts.OK &&
        credentials.initialize_store(?value.store, ?value.generation) == contracts.OK;
}

# the listener the interop harness serves, with alpn offered but not required
# so a hello without it is still served
fun listen(value: *Fixture, suite_len: usize) {
    value.protocols[0]                             = config.ProtocolName{data: "h2"::*u8, len: 2};
    value.groups[0]                                = tls13.X25519;
    value.groups[1]                                = tls13.SECP256R1;
    value.signatures[0]                            = tls13.ED25519;
    value.signatures[1]                            = tls13.ECDSA_SECP256R1_SHA256;
    value.signatures[2]                            = tls13.ECDSA_SECP384R1_SHA384;
    value.signatures[3]                            = tls13.RSA_PSS_RSAE_SHA256;
    value.signatures[4]                            = tls13.RSA_PSS_RSAE_SHA384;
    value.listener                                 = config.ServerConfig{};
    value.listener.credentials                     = ?value.store;
    value.listener.alpn                            = ?value.protocols[0];
    value.listener.alpn_len                        = 1;
    value.listener.require_alpn                    = false;
    value.listener.versions                        = ?value.versions[0];
    value.listener.version_len                     = 1;
    value.listener.suites                          = ?value.suites[0];
    value.listener.suite_len                       = suite_len;
    value.listener.groups                          = ?value.groups[0];
    value.listener.group_len                       = 2;
    value.listener.signatures                      = ?value.signatures[0];
    value.listener.signature_len                   = 5;
    value.listener.entropy                         = ?entropy;
    value.listener.entropy_context_size            = 1;
    value.listener.clock                           = ?frozen;
    value.listener.tickets                         = nil;
    value.listener.replay                          = nil;
    value.listener.replay_policy                   = session.REPLAY_PERMISSIVE;
    value.listener.tickets_per_connection          = 0;
    value.listener.limits                          = config.production_limits();
    value.listener.limits.max_peer_handshake_bytes = 8192;
    value.listener.limits.max_client_hello_bytes   = 8192;
}

fun prepare13() bool {
    if (fixture13.ready)                       { ret true; }
    if (fixture13.failed || !prepare_shared()) { ret false; }
    fixture13.failed = true;
    if (!load_identity(?fixture13, "server-ed25519.pem", "server-ed25519.key")) {
        ret false;
    }
    fixture13.versions[0] = tls13.VERSION;
    fixture13.suites[0]   = tls13.AES_128_GCM_SHA256;
    fixture13.suites[1]   = tls13.AES_256_GCM_SHA384;
    fixture13.suites[2]   = tls13.CHACHA20_POLY1305_SHA256;
    listen(?fixture13, 3);
    fixture13.failed = false;
    fixture13.ready  = true;
    ret true;
}

fun prepare12() bool {
    if (fixture12.ready)                       { ret true; }
    if (fixture12.failed || !prepare_shared()) { ret false; }
    fixture12.failed = true;
    if (!load_identity(?fixture12, "server-p256.pem", "server-p256.key")) {
        ret false;
    }
    fixture12.versions[0] = tls12.VERSION;
    fixture12.suites[0]   = tls12.ECDHE_ECDSA_AES_128_GCM_SHA256;
    fixture12.suites[1]   = tls12.ECDHE_ECDSA_AES_256_GCM_SHA384;
    fixture12.suites[2]   = tls12.ECDHE_ECDSA_CHACHA20_POLY1305;
    fixture12.suites[3]   = tls12.ECDHE_RSA_AES_128_GCM_SHA256;
    fixture12.suites[4]   = tls12.ECDHE_RSA_AES_256_GCM_SHA384;
    fixture12.suites[5]   = tls12.ECDHE_RSA_CHACHA20_POLY1305;
    listen(?fixture12, 6);
    fixture12.failed = false;
    fixture12.ready  = true;
    ret true;
}

# what one hello did to a fresh server
rec Run {
    fed:    engine.Result;
    again:  engine.Result;
    before: engine.Snapshot;
    after:  engine.Snapshot;
    events: usize;
    alerts: usize;
    alert:  record.AlertDescription;
    # a crypto event that was empty or lay outside the output buffer
    stray: bool;
    # an event the engine delivered and then would not complete
    refused: bool;
    outcome: u64;
}

fun empty_run() Run {
    var run: Run;
    run.fed     = engine.result(0, error.OK, 0, 0);
    run.again   = engine.result(0, error.OK, 0, 0);
    run.before  = engine.empty_snapshot();
    run.after   = engine.empty_snapshot();
    run.events  = 0;
    run.alerts  = 0;
    run.alert   = record.NO_ALERT;
    run.stray   = false;
    run.refused = false;
    run.outcome = 0;
    ret run;
}

fun observe(run: *Run, event: *engine.Event, output: buffer.Region) {
    run.events  = run.events + 1;
    run.outcome = verdict.mix(run.outcome, (event.kind::u64 << 8) | event.level::u64);
    if (event.kind == engine.ALERT) {
        run.alerts  = run.alerts + 1;
        run.alert   = event.alert;
        run.outcome = verdict.mix(run.outcome, event.alert::u64);
    }
    if (event.kind == engine.CRYPTO && (event.data.len == 0 ||
        !verdict.bytes_inside(event.data, output.chunk.data, output.chunk.bytes))) {
        run.stray = true;
    }
}

fun configured(suite: u16, value: *Fixture) bool {
    var i: usize = 0;
    for (i < value.listener.suite_len) {
        if (value.suites[i] == suite) { ret true; }
        i = i + 1;
    }
    ret false;
}

# every outcome of one hello is a complete, bounded state
fun judge(run: *Run, value: *Fixture, len: usize) verdict.Verdict {
    if (run.fed.consumed > len) { ret verdict.violated("an ingest consumed more than its input"); }
    if (run.refused)            { ret verdict.violated("a delivered event could not be completed"); }
    if (run.fed.status == engine.FAILED) {
        if (run.events != 1 || run.alerts != 1 || run.alert == record.NO_ALERT) {
            ret verdict.violated("a failed server did not queue exactly one alert");
        }
        if (run.again.status != engine.FAILED) {
            ret verdict.violated("a failed server accepted further input");
        }
        if (run.before.status != engine.FAILED || run.before.error == error.OK) {
            ret verdict.violated("a failed server reports no failure");
        }
    }
    or (run.fed.status == engine.OK) {
        verdict.accept();
        if (!run.before.output_pending || run.events == 0) {
            ret verdict.violated("a server that progressed queued nothing");
        }
        if (run.stray) {
            ret verdict.violated("a crypto event lies outside the server's output buffer");
        }
        if (!configured(run.before.suite, value)) {
            ret verdict.violated("a server negotiated a suite it was not configured with");
        }
        if (run.before.status == engine.COMPLETE || run.after.status == engine.COMPLETE) {
            ret verdict.violated("a server completed a handshake from one message");
        }
        run.outcome = verdict.mix(run.outcome, (run.before.suite::u64 << 16) |
            run.before.group::u64);
        run.outcome = verdict.mix(run.outcome, verdict.bucket(run.before.selected_alpn.len));
    }
    or (run.fed.status == engine.MORE) {
        if (run.events != 0 || run.before.output_pending) {
            ret verdict.violated("a server that needs more queued output");
        }
    }
    or { ret verdict.violated("a server answered one hello with no bounded state"); }
    ret verdict.answered(verdict.mix(run.outcome, (run.fed.status::u64 << 16) |
        run.fed.error::u64));
}

# the account holds nothing once the server that borrowed it is gone
fun returned() bool {
    ret pool.held(?memory) == 0;
}

pub fun answer_server13(data: *u8, len: usize) verdict.Verdict {
    if (!prepare13()) { ret verdict.violated("server13: cannot build the fixture configuration"); }
    counter = 17;
    var extra: server.ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    if (!server.init(?engine13, ?fixture13.listener, pool.lease(?memory), extra, 0) ||
        server.start(?engine13).status != engine.OK) {
        ret verdict.violated("server13: a fresh server did not start");
    }
    var run: Run = empty_run();
    run.fed    = server.ingest(?engine13, engine.INITIAL, data, len);
    run.before = server.snapshot(?engine13);
    if (run.fed.status == engine.FAILED) {
        run.again = server.ingest(?engine13, engine.INITIAL, data, len);
    }
    var event: engine.Event = engine.empty_event();
    for (run.events < MAX_EVENTS && server.next_event(?engine13, ?event)) {
        observe(?run, ?event, engine13.buffers.output);
        if (!server.complete_event(?engine13, event.token, true)) { run.refused = true; }
    }
    run.after = server.snapshot(?engine13);
    val verdict_now: verdict.Verdict = judge(?run, ?fixture13, len);
    if (!server.destroy(?engine13)) { ret verdict.violated("server13: destroy was refused"); }
    if (!returned())                { ret verdict.violated("server13: a destroyed server kept a chunk"); }
    ret verdict_now;
}

pub fun answer_server12(data: *u8, len: usize) verdict.Verdict {
    if (!prepare12()) { ret verdict.violated("server12: cannot build the fixture configuration"); }
    counter = 17;
    if (!tls12_connection.init_server(?engine12, ?fixture12.listener, pool.lease(?memory)) ||
        tls12_connection.start(?engine12).status != engine.OK) {
        ret verdict.violated("server12: a fresh server did not start");
    }
    var run: Run = empty_run();
    run.fed    = tls12_connection.ingest(?engine12, engine.INITIAL, data, len);
    run.before = tls12_connection.snapshot(?engine12);
    if (run.fed.status == engine.FAILED) {
        run.again = tls12_connection.ingest(?engine12, engine.INITIAL, data, len);
    }
    var event: engine.Event = engine.empty_event();
    for (run.events < MAX_EVENTS && tls12_connection.next_event(?engine12, ?event)) {
        observe(?run, ?event, engine12.buffers.output);
        if (!tls12_connection.complete_event(?engine12, event.token, true)) {
            run.refused = true;
        }
    }
    run.after = tls12_connection.snapshot(?engine12);
    val verdict_now: verdict.Verdict = judge(?run, ?fixture12, len);
    if (!tls12_connection.destroy(?engine12)) {
        ret verdict.violated("server12: destroy was refused");
    }
    if (!returned()) { ret verdict.violated("server12: a destroyed server kept a chunk"); }
    ret verdict_now;
}
