# tls 1.3 server interoperability harness driven by external clients

use crypto.contracts;
use crypto.encoding.keys;
use crypto.secret;
use std.crypto.ct;
use std.filesystem;
use std.net.ip;
use std.net.tcp;
use std.print;
use std.runtime;
use std.types.string.str;
use std.types.char.char;
use std.types.result.unwrap_err;
use std.sync.cancel;
use std.chrono.time;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.size.usize;
use file: std.io.file;
use io_error: std.io.error;
use io_runtime: std.io.runtime;
use tls.cert;
use tls.cert.credentials;
use tls.cert.load;
use tls.config;
use tls.engine;
use tls.error;
use tls.memory_range;
use tls.record;
use tls.server;
use tls.stream;
use tls.tls13;
use tls.transport;

rec BlockingTransport {
    runtime: *io_runtime.Runtime;
    stream: *tcp.Stream;
}

fun blocking_aliases_state(context: ptr, data: *u8, len: usize) bool {
    if (!memory_range.valid(data, len)) { ret true; }
    if (len == 0) { ret false; }
    if (!memory_range.valid(context::*u8, $size_of(BlockingTransport))) {
        ret true;
    }
    val state: *BlockingTransport = context::*BlockingTransport;
    if (!memory_range.valid(state.stream::*u8, $size_of(tcp.Stream)) ||
        memory_range.overlap(state::*u8, $size_of(BlockingTransport),
            state.stream::*u8, $size_of(tcp.Stream)) ||
        io_runtime.aliases(state.runtime, state::*u8,
            $size_of(BlockingTransport)) ||
        io_runtime.aliases(state.runtime, state.stream::*u8,
            $size_of(tcp.Stream))) { ret true; }
    ret memory_range.overlap(state::*u8, $size_of(BlockingTransport),
            data, len) ||
        memory_range.overlap(state.stream::*u8, $size_of(tcp.Stream),
            data, len) || io_runtime.aliases(state.runtime, data, len);
}

fun submit(state: *BlockingTransport, scope: *cancel.Scope,
    kind: io_runtime.Kind, buffer: *u8, length: usize,
    context: usize) Result[io_runtime.Token, io_error.Error] {
    val operation: io_runtime.Operation = io_runtime.Operation{kind: kind,
        resource: state.stream.handle.value, buffer: buffer, length: length,
        offset: 0, context: context};
    ret io_runtime.submit_scoped(state.runtime, scope, operation);
}

fun blocking_read(context: ptr, scope: *cancel.Scope, buffer: *u8,
    length: usize, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val state: *BlockingTransport = context::*BlockingTransport;
    val submitted: Result[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.READ, buffer, length, token_context);
    if (is_err[io_runtime.Token, io_error.Error](submitted)) { ret submitted; }
    val token: io_runtime.Token = unwrap_ok[io_runtime.Token,
        io_error.Error](submitted);
    val received: Result[usize, io_error.Error] = tcp.stream_read(state.stream,
        buffer, length);
    if (is_err[usize, io_error.Error](received)) {
        io_runtime.fail(state.runtime, token,
            unwrap_err[usize, io_error.Error](received));
    } or {
        val bytes: usize = unwrap_ok[usize, io_error.Error](received);
        io_runtime.complete(state.runtime, token, bytes,
            state.stream.handle.value, bytes == 0);
    }
    ret submitted;
}

fun blocking_write(context: ptr, scope: *cancel.Scope, buffer: *u8,
    length: usize, token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val state: *BlockingTransport = context::*BlockingTransport;
    val submitted: Result[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.WRITE, buffer, length, token_context);
    if (is_err[io_runtime.Token, io_error.Error](submitted)) { ret submitted; }
    val token: io_runtime.Token = unwrap_ok[io_runtime.Token,
        io_error.Error](submitted);
    val written: Result[usize, io_error.Error] = tcp.stream_write(state.stream,
        buffer, length);
    if (is_err[usize, io_error.Error](written)) {
        io_runtime.fail(state.runtime, token,
            unwrap_err[usize, io_error.Error](written));
    } or {
        io_runtime.complete(state.runtime, token,
            unwrap_ok[usize, io_error.Error](written),
            state.stream.handle.value, false);
    }
    ret submitted;
}

fun blocking_shutdown(context: ptr, scope: *cancel.Scope,
    token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val state: *BlockingTransport = context::*BlockingTransport;
    val submitted: Result[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.SHUTDOWN, nil, 0, token_context);
    if (is_err[io_runtime.Token, io_error.Error](submitted)) { ret submitted; }
    val token: io_runtime.Token = unwrap_ok[io_runtime.Token,
        io_error.Error](submitted);
    val stopped: Result[bool, io_error.Error] = tcp.stream_shutdown(state.stream,
        os.SHUT_WR);
    if (is_err[bool, io_error.Error](stopped)) {
        io_runtime.fail(state.runtime, token,
            unwrap_err[bool, io_error.Error](stopped));
    } or {
        io_runtime.complete(state.runtime, token, 0,
            state.stream.handle.value, false);
    }
    ret submitted;
}

fun blocking_close(context: ptr, scope: *cancel.Scope,
    token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val state: *BlockingTransport = context::*BlockingTransport;
    val resource: usize = state.stream.handle.value;
    val submitted: Result[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.CLOSE, nil, 0, token_context);
    if (is_err[io_runtime.Token, io_error.Error](submitted)) { ret submitted; }
    val token: io_runtime.Token = unwrap_ok[io_runtime.Token,
        io_error.Error](submitted);
    val closed: Result[bool, io_error.Error] = tcp.stream_close(state.stream);
    if (is_err[bool, io_error.Error](closed)) {
        io_runtime.fail(state.runtime, token,
            unwrap_err[bool, io_error.Error](closed));
    } or {
        io_runtime.complete(state.runtime, token, 0, resource, false);
    }
    ret submitted;
}

fun settle(secure: *stream.Stream, owner: *io_runtime.Runtime) bool {
    for (transport.snapshot(?secure.operation).state !=
        transport.OPERATION_TERMINAL) {
        var completion: io_runtime.Completion;
        val polled: Result[usize, io_error.Error] = io_runtime.poll(owner,
            ?completion, 1);
        if (is_err[usize, io_error.Error](polled) ||
            unwrap_ok[usize, io_error.Error](polled) != 1 ||
            !stream.accept(secure, ?completion)) { ret false; }
    }
    ret true;
}

fun streq(a: *u8, b: *u8) bool {
    if (a == nil || b == nil) { ret false; }
    var i: usize = 0;
    for (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret a[i] == b[i];
}

fun parse_number(value: *u8) usize {
    var total: usize = 0;
    var i: usize = 0;
    for (value[i] != 0) {
        if (value[i] < '0' || value[i] > '9') { ret 0; }
        total = total * 10 + (value[i] - '0')::usize;
        i = i + 1;
    }
    ret total;
}

val MAX_PEM: usize = 8192;
val MAX_IDENTITIES: usize = 4;

var pem_scratch: [MAX_IDENTITIES][MAX_PEM]u8;
var der_scratch: [MAX_IDENTITIES][MAX_PEM]u8;
var chain_certificates: [MAX_IDENTITIES][4]cert.Certificate;
var identity_keys: [MAX_IDENTITIES]keys.PrivateKey;
var identities: [MAX_IDENTITIES]credentials.Identity;
var identity_count: usize;

var rotated_pem: [MAX_PEM]u8;
var rotated_der: [MAX_PEM]u8;
var rotated_certificates: [4]cert.Certificate;
var rotated_key: keys.PrivateKey;
var rotated_identities: [1]credentials.Identity;

var anchor_pem: [MAX_PEM]u8;
var anchor_der: [MAX_PEM]u8;
var anchor_certificates: [4]cert.Certificate;
var client_trust: cert.TrustStore;

var handshake_input: [65536]u8;
var handshake_output: [65536]u8;
var retained_hello: [65536]u8;
var peer_certificates: [8]cert.Certificate;
var wire_input: [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
var wire_output: [record.HEADER_SIZE + record.MAX_CIPHERTEXT]u8;
var application_input: [512]u8;
var application_output: [64]u8;

var fixtures: file.Root;

fun read_fixture(path: str, buffer: *u8, capacity: usize,
    length: *usize) bool {
    val opened: Result[filesystem.File, io_error.Error] = file.open_confined(
        ?fixtures, path, file.read_options());
    if (is_err[filesystem.File, io_error.Error](opened)) { ret false; }
    var handle: filesystem.File = unwrap_ok[filesystem.File,
        io_error.Error](opened);
    val read: Result[usize, io_error.Error] = file.read_at(handle, buffer,
        capacity, 0);
    filesystem.close(?handle);
    if (is_err[usize, io_error.Error](read)) { ret false; }
    @length = unwrap_ok[usize, io_error.Error](read);
    ret @length != 0 && @length < capacity;
}

#[oblivious]
fun copy_secret(destination: *^u8, source: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = source[i];
        i = i + 1;
    }
}

var key_secret: [MAX_PEM]^u8;

fun load_identity(slot: usize, certificate_path: str, key_path: str,
    server_name: str, name_length: usize,
    allocator: *secret.Allocator) bool {
    if (slot >= MAX_IDENTITIES) { ret false; }
    var pem_length: usize = 0;
    if (!read_fixture(certificate_path, ?pem_scratch[slot][0], MAX_PEM,
            ?pem_length)) { ret false; }
    var chain: cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?pem_scratch[slot][0], len: pem_length},
        contracts.Buffer{data: ?der_scratch[slot][0], capacity: MAX_PEM},
        ?chain_certificates[slot][0], 4, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret false; }
    var key_length: usize = 0;
    if (!read_fixture(key_path, ?pem_scratch[slot][0], MAX_PEM, ?key_length)) {
        ret false;
    }
    copy_secret(?key_secret[0], ?pem_scratch[slot][0], key_length);
    identity_keys[slot] = keys.empty_private();
    val key_status: contracts.Error = load.private_pem(
        contracts.SecretBytes{data: ?key_secret[0], len: key_length},
        allocator, ?identity_keys[slot]);
    ct.zeroize(?key_secret[0], MAX_PEM);
    if (key_status != contracts.OK) { ret false; }
    identities[slot].server_name = contracts.Bytes{data: server_name::*u8,
        len: name_length};
    identities[slot].chain = chain;
    identities[slot].private_key = ?identity_keys[slot];
    ret true;
}

fun load_anchor(path: str, output: *cert.TrustStore) bool {
    var pem_length: usize = 0;
    if (!read_fixture(path, ?anchor_pem[0], MAX_PEM, ?pem_length)) { ret false; }
    var chain: cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?anchor_pem[0], len: pem_length},
        contracts.Buffer{data: ?anchor_der[0], capacity: MAX_PEM},
        ?anchor_certificates[0], 4, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret false; }
    output.anchors = chain.certificates;
    output.len = chain.len;
    ret true;
}

fun report(label: str, value: usize) {
    print.print(label);
    var digits: [24]u8;
    var count: usize = 0;
    var remaining: usize = value;
    if (remaining == 0) { digits[0] = '0'; count = 1; }
    for (remaining != 0) {
        digits[count] = '0' + (remaining % 10)::u8;
        remaining = remaining / 10;
        count = count + 1;
    }
    var text: [25]char;
    var i: usize = 0;
    for (i < count) {
        text[i] = digits[count - 1 - i]::char;
        i = i + 1;
    }
    text[count] = 0::char;
    print.print(?text[0]);
    print.print("\n");
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var port: u16 = 9443;
    var require_client_auth: bool = false;
    var require_alpn: bool = true;
    var prefer_p256: bool = false;
    var suite_choice: usize = 0;
    var expect_failure: bool = false;
    var expect_alert: usize = 256;
    var rotate: bool = false;
    var no_default: bool = false;
    var identity_choice: str = "server-ed25519";

    var argument: i64 = 1;
    for (argument < argc) {
        val current: *u8 = argv[argument];
        if (streq(current, "--port"::*u8) && argument + 1 < argc) {
            argument = argument + 1;
            port = parse_number(argv[argument])::u16;
        } or (streq(current, "--require-client-auth"::*u8)) {
            require_client_auth = true;
        } or (streq(current, "--optional-alpn"::*u8)) {
            require_alpn = false;
        } or (streq(current, "--groups-p256"::*u8)) {
            prefer_p256 = true;
        } or (streq(current, "--suite"::*u8) && argument + 1 < argc) {
            argument = argument + 1;
            suite_choice = parse_number(argv[argument]);
        } or (streq(current, "--identity"::*u8) && argument + 1 < argc) {
            argument = argument + 1;
            if (streq(argv[argument], "p256"::*u8)) {
                identity_choice = "server-p256";
            } or (streq(argv[argument], "rsa"::*u8)) {
                identity_choice = "server-rsa";
            } or { identity_choice = "server-ed25519"; }
        } or (streq(current, "--expect-failure"::*u8) && argument + 1 < argc) {
            argument = argument + 1;
            expect_failure = true;
            expect_alert = parse_number(argv[argument]);
        } or (streq(current, "--rotate"::*u8)) {
            rotate = true;
        } or (streq(current, "--no-default"::*u8)) {
            no_default = true;
        }
        argument = argument + 1;
    }

    val opened: Result[file.Root, io_error.Error] = file.root_open(
        "test/interop/fixtures");
    if (is_err[file.Root, io_error.Error](opened)) {
        print.print("cannot open test/interop/fixtures\n");
        ret 2;
    }
    fixtures = unwrap_ok[file.Root, io_error.Error](opened);

    var allocator: secret.Allocator = secret.system_allocator();
    var certificate_path: str = "server-ed25519.pem";
    var key_path: str = "server-ed25519.key";
    if (streq(identity_choice::*u8, "server-p256"::*u8)) {
        certificate_path = "server-p256.pem";
        key_path = "server-p256.key";
    }
    if (streq(identity_choice::*u8, "server-rsa"::*u8)) {
        certificate_path = "server-rsa.pem";
        key_path = "server-rsa.key";
    }
    if (!load_identity(0, certificate_path, key_path, "api.example.com", 15,
            ?allocator) ||
        !load_identity(1, "server-alt.pem", "server-alt.key",
            "alt.example.com", 15, ?allocator) ||
        !load_identity(2, "server-wild.pem", "server-wild.key",
            "*.example.com", 13, ?allocator)) {
        print.print("cannot load server identities\n");
        ret 3;
    }
    identity_count = 3;
    if (!load_anchor("root.pem", ?client_trust)) {
        print.print("cannot load the client trust anchor\n");
        ret 4;
    }

    var generation: credentials.Generation = credentials.empty_generation();
    var trust: *cert.TrustStore = nil;
    if (require_client_auth) { trust = ?client_trust; }
    var default_index: usize = 0;
    if (no_default) { default_index = credentials.NO_DEFAULT; }
    if (credentials.initialize(?generation, ?identities[0], identity_count,
            default_index, trust, require_client_auth) != contracts.OK) {
        print.print("cannot publish the credential generation\n");
        ret 5;
    }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        print.print("cannot initialize the credential store\n");
        ret 6;
    }

    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}};
    var versions: [1]u16 = [1]u16{tls13.VERSION};
    var suites: [3]tls13.CipherSuite = [3]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256, tls13.AES_256_GCM_SHA384,
        tls13.CHACHA20_POLY1305_SHA256};
    var suite_len: usize = 3;
    if (suite_choice == 1) { suites[0] = tls13.AES_128_GCM_SHA256; suite_len = 1; }
    if (suite_choice == 2) { suites[0] = tls13.AES_256_GCM_SHA384; suite_len = 1; }
    if (suite_choice == 3) {
        suites[0] = tls13.CHACHA20_POLY1305_SHA256;
        suite_len = 1;
    }
    var groups: [2]tls13.NamedGroup = [2]tls13.NamedGroup{
        tls13.X25519, tls13.SECP256R1};
    var group_len: usize = 2;
    if (prefer_p256) { groups[0] = tls13.SECP256R1; group_len = 1; }
    var signatures: [4]tls13.SignatureScheme = [4]tls13.SignatureScheme{
        tls13.ED25519, tls13.ECDSA_SECP256R1_SHA256,
        tls13.RSA_PSS_RSAE_SHA256, tls13.RSA_PSS_RSAE_SHA384};
    var entropy: secret.Entropy = secret.system_entropy();

    var configuration: config.ServerConfig;
    configuration.credentials = ?store;
    configuration.alpn = ?protocols[0];
    configuration.alpn_len = 1;
    configuration.require_alpn = require_alpn;
    configuration.versions = ?versions[0];
    configuration.version_len = 1;
    configuration.suites = ?suites[0];
    configuration.suite_len = suite_len;
    configuration.groups = ?groups[0];
    configuration.group_len = group_len;
    configuration.signatures = ?signatures[0];
    configuration.signature_len = 4;
    configuration.entropy = ?entropy;
    configuration.entropy_context_size = 0;
    configuration.limits = config.production_limits();
    configuration.limits.max_peer_handshake_bytes = 65536;
    configuration.limits.max_client_hello_bytes = 65536;
    configuration.limits.max_chain_bytes = 32768;
    configuration.limits.max_server_flight_bytes = 65536;

    val listening: Result[tcp.Listener, io_error.Error] = tcp.listen(
        ip.endpoint(127, 0, 0, 1, port), 4);
    if (is_err[tcp.Listener, io_error.Error](listening)) {
        print.print("cannot listen\n");
        ret 7;
    }
    var listener: tcp.Listener = unwrap_ok[tcp.Listener,
        io_error.Error](listening);
    print.print("listening\n");

    val accepted: Result[tcp.Stream, io_error.Error] = tcp.accept(?listener);
    if (is_err[tcp.Stream, io_error.Error](accepted)) {
        print.print("cannot accept\n");
        ret 8;
    }
    var socket: tcp.Stream = unwrap_ok[tcp.Stream, io_error.Error](accepted);
    tcp.listener_close(?listener);

    var owner: io_runtime.Runtime;
    if (is_err[bool, io_error.Error](io_runtime.make(?owner, 16))) { ret 9; }
    var blocking: BlockingTransport = BlockingTransport{runtime: ?owner,
        stream: ?socket};
    var lower: transport.Transport = transport.Transport{runtime: ?owner,
        context: (?blocking)::ptr, context_size: $size_of(BlockingTransport),
        aliases_state: blocking_aliases_state,
        submit_read: blocking_read, submit_write: blocking_write,
        submit_shutdown: blocking_shutdown, submit_close: blocking_close,
        submit_abort: blocking_close};

    var core_storage: server.Storage = server.Storage{
        input: ?handshake_input[0], input_capacity: 65536,
        output: ?handshake_output[0], output_capacity: 65536,
        hello: ?retained_hello[0], hello_capacity: 65536,
        certificates: ?peer_certificates[0], certificate_capacity: 8,
        peer_parameters: nil, peer_parameters_capacity: 0};
    var storage: stream.Storage;
    storage.wire_input = ?wire_input[0];
    storage.wire_input_capacity = record.HEADER_SIZE + record.MAX_CIPHERTEXT;
    storage.wire_output = ?wire_output[0];
    storage.wire_output_capacity = record.HEADER_SIZE + record.MAX_CIPHERTEXT;

    var listener_engine: server.Server;
    var empty_extra: server.ExtraExtension;
    empty_extra.kind = 0;
    empty_extra.data.data = nil;
    empty_extra.data.len = 0;
    var hello_required: usize = 0;
    var flight_required: usize = 0;
    if (!server.storage_requirements(?configuration, empty_extra,
            ?hello_required, ?flight_required)) {
        print.print("cannot size server storage\n");
        ret 10;
    }
    if (!server.init(?listener_engine, ?configuration, core_storage,
            empty_extra, 0)) {
        report("hello required=", hello_required);
        report("flight required=", flight_required);
        report("output capacity=", core_storage.output_capacity);
        print.print("cannot initialize the server engine\n");
        ret 10;
    }

    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 11; }
    var secure: stream.Stream;
    if (!stream.serve(?secure, ?listener_engine, storage, ?lower, ?scope,
            transport.Token{index: 1, generation: 1}, 1800000000, 1) ||
        !settle(?secure, ?owner)) {
        print.print("the handshake operation was not accepted\n");
        ret 12;
    }
    val handshake: transport.Snapshot = transport.snapshot(?secure.operation);
    val negotiated: engine.Snapshot = stream.negotiated(?secure);

    if (expect_failure) {
        if (handshake.terminal_error == error.OK) {
            print.print("expected a handshake failure\n");
            ret 13;
        }
        val alert: usize = engine.alert_for(negotiated.error)::usize;
        report("alert=", alert);
        report("error=", negotiated.error::usize);
        if (expect_alert != 256 && alert != expect_alert) {
            print.print("wrong alert\n");
            ret 14;
        }
        stream.destroy_operation(?secure);
        stream.destroy(?secure);
        server.destroy(?listener_engine);
        ret 0;
    }

    if (handshake.terminal_error != error.OK) {
        report("handshake error=", handshake.terminal_error::usize);
        ret 20;
    }
    if (negotiated.selected_alpn.len != 2 ||
        negotiated.selected_alpn.data[0] != 'h' ||
        negotiated.selected_alpn.data[1] != '2') {
        if (require_alpn) {
            print.print("alpn was not negotiated\n");
            ret 21;
        }
    }
    if (require_client_auth && !negotiated.authenticated) {
        print.print("the client was not authenticated\n");
        ret 22;
    }
    report("suite=", negotiated.suite::usize);
    report("group=", negotiated.group::usize);
    report("retries=", negotiated.retry_count::usize);
    report("sni=", negotiated.peer_name.len);
    if (negotiated.peer_name.len != 0) {
        var name_text: [256]char;
        var i: usize = 0;
        for (i < negotiated.peer_name.len) {
            name_text[i] = negotiated.peer_name.data[i]::char;
            i = i + 1;
        }
        name_text[negotiated.peer_name.len] = 0::char;
        print.print("name=");
        print.print(?name_text[0]);
        print.print("\n");
    }
    if (!stream.destroy_operation(?secure) || !cancel.destroy(?scope)) {
        ret 23;
    }

    # rotation must not disturb this established connection
    var replacement: credentials.Generation = credentials.empty_generation();
    var retired: *credentials.Generation = nil;
    if (rotate) {
        if (!load_identity(3, "server-rotated.pem", "server-rotated.key",
                "api.example.com", 15, ?allocator)) { ret 24; }
        rotated_identities[0] = identities[3];
        if (credentials.initialize(?replacement, ?rotated_identities[0], 1, 0,
                trust, require_client_auth) != contracts.OK ||
            credentials.rotate(?store, ?replacement, ?retired) != contracts.OK ||
            retired == nil) { ret 25; }
        if (credentials.reclaimable(retired)) {
            print.print("a retired generation was reclaimable while leased\n");
            ret 26;
        }
    }

    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}) ||
        !stream.read(?secure, ?scope,
            transport.Token{index: 2, generation: 1},
            ?application_input[0], 512, 2) || !settle(?secure, ?owner)) {
        ret 30;
    }
    val read: transport.Snapshot = transport.snapshot(?secure.operation);
    if (read.terminal_error != error.OK || read.application_bytes == 0) {
        report("read error=", read.terminal_error::usize);
        ret 31;
    }
    report("read=", read.application_bytes);
    if (!stream.destroy_operation(?secure) || !cancel.destroy(?scope)) {
        ret 32;
    }

    application_output[0] = 'm'; application_output[1] = 'a';
    application_output[2] = 'c'; application_output[3] = 'h';
    application_output[4] = '-'; application_output[5] = 't';
    application_output[6] = 'l'; application_output[7] = 's';
    application_output[8] = ' '; application_output[9] = 's';
    application_output[10] = 'e'; application_output[11] = 'r';
    application_output[12] = 'v'; application_output[13] = 'e';
    application_output[14] = 'r'; application_output[15] = '\n';
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}) ||
        !stream.write(?secure, ?scope,
            transport.Token{index: 3, generation: 1},
            ?application_output[0], 16, 3) || !settle(?secure, ?owner)) {
        ret 33;
    }
    val written: transport.Snapshot = transport.snapshot(?secure.operation);
    if (written.terminal_error != error.OK || written.application_bytes != 16) {
        ret 34;
    }
    if (!stream.destroy_operation(?secure) || !cancel.destroy(?scope)) {
        ret 35;
    }

    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}) ||
        !stream.half_close(?secure, ?scope,
            transport.Token{index: 4, generation: 1}, 4) ||
        !settle(?secure, ?owner)) { ret 36; }
    val half_closed: transport.Snapshot = transport.snapshot(?secure.operation);
    if (half_closed.terminal_error != error.OK || !secure.send_closed ||
        !stream.destroy_operation(?secure) || !cancel.destroy(?scope)) {
        ret 37;
    }

    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}) ||
        !stream.close(?secure, ?scope,
            transport.Token{index: 5, generation: 1}, 5) ||
        !settle(?secure, ?owner)) { ret 38; }
    val closed: transport.Snapshot = transport.snapshot(?secure.operation);
    if (closed.terminal_error != error.OK || !stream.destroy_operation(?secure) ||
        !stream.destroy(?secure) || !cancel.destroy(?scope)) { ret 39; }

    if (!server.destroy(?listener_engine)) { ret 40; }
    if (rotate) {
        if (!credentials.reclaimable(retired)) {
            print.print("a retired generation stayed leased after destroy\n");
            ret 41;
        }
        print.print("rotated\n");
    }
    if (is_err[bool, io_error.Error](io_runtime.close(?owner)) ||
        is_err[bool, io_error.Error](io_runtime.destroy(?owner))) { ret 42; }
    file.root_close(?fixtures);
    print.print("ok\n");
    ret 0;
}
