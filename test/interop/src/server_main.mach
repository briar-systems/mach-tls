fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun runtime_ok(outcome: err[io_error.Error]) bool {
    ret sel outcome.ok;
}

# std 7 runtimes draw from a caller-owned allocator; the page allocator has no
# context, so one module-level instance outlives every runtime made here
var runtime_pages: A.Allocator;

fun make_runtime(runtime: *io_runtime.Runtime, initial: usize) bool {
    val paged: err[A.Error] = page.make(?runtime_pages);
    if (sel paged.err) { ret false; }
    ret runtime_ok(io_runtime.make(runtime, ?runtime_pages, initial));
}

rec BlockingTransport {
    runtime: *io_runtime.Runtime;
    stream:  *tcp.Stream;
}

fun blocking_aliases_state(context: ptr, data: *u8, len: usize) bool {
    if (!memory_range.valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory_range.valid(context::*u8, $size_of(BlockingTransport))) {
        ret true;
    }
    val state: *BlockingTransport = context::*BlockingTransport;
    if (!memory_range.valid(state.stream::*u8, $size_of(tcp.Stream)) ||
        memory_range.overlap(state::*u8, $size_of(BlockingTransport),
        state.stream::*u8, $size_of(tcp.Stream)) ||
        io_runtime.aliases(state.runtime, state::*u8,
        $size_of(BlockingTransport)) ||
        io_runtime.aliases(state.runtime, state.stream::*u8,
        $size_of(tcp.Stream))) { ret true; }
    ret memory_range.overlap(state::*u8, $size_of(BlockingTransport),
        data, len) ||
        memory_range.overlap(state.stream::*u8, $size_of(tcp.Stream),
        data, len) || io_runtime.aliases(state.runtime, data, len);
}

fun submit(state: *BlockingTransport, scope: *cancel.Scope,
    kind: io_runtime.Kind, buffer: *u8, length: usize,
    context: usize) res[io_runtime.Token, io_error.Error] {
    val operation: io_runtime.Operation = io_runtime.Operation{kind: kind,
        resource: state.stream.handle.value, buffer: buffer, length: length,
        offset:   0, context: context};
    ret io_runtime.submit_scoped(state.runtime, scope, operation);
}

fun blocking_read(context: ptr, scope: *cancel.Scope, buffer: *u8,
    length: usize, token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *BlockingTransport                    = context::*BlockingTransport;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.READ, buffer, length, token_context);
    if (sel submitted.err) { ret submitted; }
    val token:    io_runtime.Token           = submitted.ok;
    val received: res[usize, io_error.Error] = tcp.stream_read(state.stream,
        buffer, length);
    if (sel received.err) {
        io_runtime.fail(state.runtime, token,
            received.err);
    }
    if (sel received.ok) {
        val bytes: usize = received.ok;
        io_runtime.complete(state.runtime, token, bytes,
            state.stream.handle.value, bytes == 0);
    }
    ret submitted;
}

fun blocking_write(context: ptr, scope: *cancel.Scope, buffer: *u8,
    length: usize, token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *BlockingTransport                    = context::*BlockingTransport;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.WRITE, buffer, length, token_context);
    if (sel submitted.err) { ret submitted; }
    val token:   io_runtime.Token           = submitted.ok;
    val written: res[usize, io_error.Error] = tcp.stream_write(state.stream,
        buffer, length);
    if (sel written.err) {
        io_runtime.fail(state.runtime, token,
            written.err);
    }
    if (sel written.ok) {
        io_runtime.complete(state.runtime, token,
            written.ok,
            state.stream.handle.value, false);
    }
    ret submitted;
}

fun blocking_shutdown(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *BlockingTransport                    = context::*BlockingTransport;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.SHUTDOWN, nil, 0, token_context);
    if (sel submitted.err) { ret submitted; }
    val token:   io_runtime.Token    = submitted.ok;
    val stopped: err[io_error.Error] = tcp.stream_shutdown(state.stream,
        os.SHUT_WR);
    if (sel stopped.err) {
        io_runtime.fail(state.runtime, token,
            stopped.err);
    }
    or {
        io_runtime.complete(state.runtime, token, 0,
            state.stream.handle.value, false);
    }
    ret submitted;
}

fun blocking_close(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *BlockingTransport                    = context::*BlockingTransport;
    val resource:  usize                                 = state.stream.handle.value;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.CLOSE, nil, 0, token_context);
    if (sel submitted.err) { ret submitted; }
    val token:  io_runtime.Token    = submitted.ok;
    val closed: err[io_error.Error] = tcp.stream_close(state.stream);
    if (sel closed.err) {
        io_runtime.fail(state.runtime, token,
            closed.err);
    }
    or {
        io_runtime.complete(state.runtime, token, 0, resource, false);
    }
    ret submitted;
}

# the fixtures are valid for a fixed window, so the wall reading is pinned to a
# time inside it. the monotonic reading is the process clock, so ticket ages
# are real
fun harness_read(context: ptr, output: *clock.Moment) bool {
    if (!clock.now(output)) { ret false; }
    output.wall = time.unix(1800000000, 0);
    ret true;
}

var harness_clock: clock.Source = clock.Source{context: nil, context_size: 0,
    read_fn: harness_read};

# the harness runs one operation at a time, so the live lane is the only one
# not yet destroyed
fun lane(secure: *stream.Stream) *stream.Lane {
    val state: transport.OperationState = transport.snapshot(?secure.writing.operation).state;
    if (state == 0 || state == transport.OPERATION_DESTROYED) { ret ?secure.reading; }
    ret ?secure.writing;
}

fun operation(secure: *stream.Stream) *transport.Operation {
    ret ?lane(secure).operation;
}

fun release(secure: *stream.Stream) bool {
    ret stream.destroy_operation(secure, operation(secure).token);
}

# an operation parked for memory is resumed once the connection's account is ready
fun settle(secure: *stream.Stream, owner: *io_runtime.Runtime) bool {
    for (transport.snapshot(operation(secure)).state !=
        transport.OPERATION_TERMINAL) {
        if (lane(secure).park == stream.PARK_MEMORY) {
            if (!pool.ready(?cur_memory) || !stream.resume(secure)) { ret false; }
        }
        var completion: io_runtime.Completion;
        val polled:     res[usize, io_error.Error] = io_runtime.poll(owner,
            ?completion, 1);
        if (sel polled.err)                                        { ret false; }
        if (polled.ok != 1 || !stream.accept(secure, ?completion)) { ret false; }
    }
    ret true;
}

fun streq(a: *u8, b: *u8) bool {
    if (a == nil || b == nil) { ret false; }
    var i: usize = 0;
    for (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret a[i] == b[i];
}

fun parse_number(value: *u8) usize {
    var total: usize = 0;
    var i:     usize = 0;
    for (value[i] != 0) {
        if (value[i] < '0' || value[i] > '9') { ret 0; }
        total = total * 10 + (value[i] - '0')::usize;
        i     = i + 1;
    }
    ret total;
}

val MAX_PEM:        usize = 8192;
val MAX_IDENTITIES: usize = 4;

var pem_scratch:        [MAX_IDENTITIES][MAX_PEM]u8;
var der_scratch:        [MAX_IDENTITIES][MAX_PEM]u8;
var chain_certificates: [MAX_IDENTITIES][4]cert.Certificate;
var identity_keys:      [MAX_IDENTITIES]keys.PrivateKey;
var identities:         [MAX_IDENTITIES]credentials.Identity;
var identity_count:     usize;

var rotated_pem:          [MAX_PEM]u8;
var rotated_der:          [MAX_PEM]u8;
var rotated_certificates: [4]cert.Certificate;
var rotated_key:          keys.PrivateKey;
var rotated_identities:   [1]credentials.Identity;

var anchor_pem:          [MAX_PEM]u8;
var anchor_der:          [MAX_PEM]u8;
var anchor_certificates: [4]cert.Certificate;
var client_trust:        cert.TrustStore;

var application_input:  [512]u8;
var application_output: [64]u8;

var fixtures:                   file.Root;
var option_require_client_auth: bool;
var option_require_alpn:        bool;
# a client that sends no ALPN extension must still be served by a listener that
# configures `require_alpn`, and must be reported as having offered nothing.
# this is separate from `--optional-alpn`, which relaxes the configuration; here
# the configuration stays strict and the expectation changes.
var option_expect_absent_alpn: bool;
var option_expect_failure:     bool;
var option_expect_alert:       usize;
var option_rotate:             bool;
var option_key_update:         bool;
var option_tickets:            u8;
var option_single_use:         bool;
var option_handshake_only:     bool;
var connection_count:          usize;
var option_tls12:              bool;
var option_dual_version:       bool;
var tls12_configuration:       config.ServerConfig;
var tls12_suites:              [6]tls13.CipherSuite;
var tls12_signatures:          [5]tls13.SignatureScheme;
var tls12_versions:            [2]u16;
var legacy_engine:             tls12_connection.Handshake;
var ticket_ring:               session.KeyRing;
var replay_window:             session.ReplayWindow;
var listener_configuration:    config.ServerConfig;
var lower_transport:           transport.Transport;
var blocking_state:            BlockingTransport;
var connection_socket:         tcp.Stream;
var connection_runtime:        io_runtime.Runtime;

fun read_fixture(path: str, buffer: *u8, capacity: usize,
    length: *usize) bool {
    val opened: res[filesystem.File, io_error.Error] = file.open_confined(
        ?fixtures, path, file.read_options());
    if (sel opened.err) { ret false; }
    var handle: filesystem.File            = opened.ok;
    val read:   res[usize, io_error.Error] = file.read_at(handle, buffer,
        capacity, 0);
    filesystem.close(?handle);
    if (sel read.err) { ret false; }
    @length = read.ok;
    ret @length != 0 && @length < capacity;
}

#[oblivious]
fun copy_secret(destination: *^u8, source: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = source[i];
        i              = i + 1;
    }
}

var key_secret: [MAX_PEM]^u8;

fun load_identity(slot: usize, certificate_path: str, key_path: str,
    server_name: str, name_length: usize,
    allocator: *secret.Allocator) bool {
    if (slot >= MAX_IDENTITIES) { ret false; }
    var pem_length: usize = 0;
    if (!read_fixture(certificate_path, ?pem_scratch[slot][0], MAX_PEM,
        ?pem_length)) { ret false; }
    var chain:   cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?pem_scratch[slot][0], len: pem_length},
        contracts.Buffer{data: ?der_scratch[slot][0], capacity: MAX_PEM},
        ?chain_certificates[slot][0], 4, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret false; }
    var key_length: usize = 0;
    if (!read_fixture(key_path, ?pem_scratch[slot][0], MAX_PEM, ?key_length)) {
        ret false;
    }
    copy_secret(?key_secret[0], ?pem_scratch[slot][0], key_length);
    identity_keys[slot] = keys.empty_private();
    val key_status: contracts.Error = load.private_pem(
        contracts.SecretBytes{data: ?key_secret[0], len: key_length},
        allocator, ?identity_keys[slot]);
    ct.zeroize(?key_secret[0], MAX_PEM);
    if (key_status != contracts.OK) { ret false; }
    identities[slot].server_name = contracts.Bytes{data: server_name::*u8,
        len: name_length};
    identities[slot].chain       = chain;
    identities[slot].private_key = ?identity_keys[slot];
    ret true;
}

fun load_anchor(path: str, output: *cert.TrustStore) bool {
    var pem_length: usize = 0;
    if (!read_fixture(path, ?anchor_pem[0], MAX_PEM, ?pem_length)) { ret false; }
    var chain:   cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?anchor_pem[0], len: pem_length},
        contracts.Buffer{data: ?anchor_der[0], capacity: MAX_PEM},
        ?anchor_certificates[0], 4, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret false; }
    output.anchors = chain.certificates;
    output.len     = chain.len;
    ret true;
}

fun report(label: str, value: usize) {
    print.print(label);
    var digits:    [24]u8;
    var count:     usize = 0;
    var remaining: usize = value;
    if (remaining == 0) {
        digits[0] = '0';
        count     = 1;
    }
    for (remaining != 0) {
        digits[count] = '0' + (remaining % 10)::u8;
        remaining     = remaining / 10;
        count         = count + 1;
    }
    var text: [25]char;
    var i:    usize = 0;
    for (i < count) {
        text[i] = digits[count - 1 - i]::char;
        i       = i + 1;
    }
    text[count] = 0::char;
    print.print(?text[0]);
    print.print("\n");
}

# every connection owns one secret-welded region for its stream and one for
# its handshake engine, the way a server holding many connections allocates
# them, and one account for the buffers tls borrows, so its resident footprint
# can be measured
rec Connection {
    secure: stream.Stream;
}

var cur:              *Connection;
var cur_engine:       *server.Handshake;
var handshake_held:   bool;
var cur_memory:       pool.Harness;
var option_footprint: bool;
var footprint_base:   usize;

val PAGE_SIZE:  usize = 4096;
val IDLE_CALLS: usize = 100000;

# resident pages of the whole process, from /proc/self/statm
fun resident_pages() usize {
    var handle: usize = os.INVALID_HANDLE;
    if (os.open(os.working_dir(), "/proc/self/statm", os.O_RDONLY, 0, ?handle) < 0) { ret 0; }
    var text: [128]u8;
    val n:    i64 = os.read(handle, ?text[0], 127);
    os.close(handle);
    if (n <= 0) { ret 0; }
    var i: usize = 0;
    for (i < n::usize && text[i] != ' ') { i = i + 1; }
    i = i + 1;
    var value: usize = 0;
    for (i < n::usize && text[i] >= '0' && text[i] <= '9') {
        value = value * 10 + (text[i] - '0')::usize;
        i     = i + 1;
    }
    ret value;
}

# pages of [start, start + len) that are present, from /proc/self/pagemap
fun present_pages(start: usize, len: usize) usize {
    var handle: usize = os.INVALID_HANDLE;
    if (len == 0 || os.open(os.working_dir(), "/proc/self/pagemap", os.O_RDONLY, 0,
        ?handle) < 0) { ret 0; }
    var count: usize = 0;
    var page:  usize = start / PAGE_SIZE;
    for (page <= (start + len - 1) / PAGE_SIZE) {
        var entry: [8]u8;
        if (os.seek(handle, (page * 8)::i64, 0) >= 0 &&
            os.read(handle, ?entry[0], 8) == 8 && (entry[7] & 0x80) != 0) {
            count = count + 1;
        }
        page = page + 1;
    }
    os.close(handle);
    ret count;
}

# pages of the connection's region and engine, plus the pages its account's
# chunks cover
fun footprint(phase: str) {
    if (!option_footprint) { ret; }
    val secure:       usize = (?cur.secure.state)::usize - $offset_of(stream.Stream, state);
    val base:         usize = secure - $offset_of(Connection, secure);
    var engine_pages: usize = 0;
    if (handshake_held) {
        engine_pages = present_pages((?cur_engine.state)::usize -
            $offset_of(server.Handshake, state), $size_of(server.Handshake));
    }
    val stream_pages: usize = present_pages(base, $size_of(Connection));
    val held_bytes:   usize = pool.held(?cur_memory);
    val buffer_pages: usize = (held_bytes + PAGE_SIZE - 1) / PAGE_SIZE;
    print.print("footprint ");
    print.print(phase);
    print.print("\n");
    report("  process_pages=", resident_pages() - footprint_base);
    report("  region_pages=", stream_pages + engine_pages + buffer_pages);
    report("  engine_pages=", engine_pages);
    report("  stream_pages=", stream_pages);
    report("  stream_bytes=", $size_of(stream.Stream));
    report("  buffer_bytes=", held_bytes);
    report("  buffer_pages=", buffer_pages);
}

# the cost of the calls an idle established engine answers most
fun idle_cost() {
    if (!option_footprint) { ret; }
    var event:   engine.Event;
    val started: time.InstantClock = time.instant();
    var i:       usize             = 0;
    for (i < IDLE_CALLS) {
        if (established.next_event(?cur.secure.core13, ?event)) { ret; }
        i = i + 1;
    }
    val finished: time.InstantClock = time.instant();
    if (sel started.err)  { ret; }
    if (sel finished.err) { ret; }
    val spent: duration.Duration = time.instant_sub(finished.ok, started.ok);
    report("  idle_next_event_ns=", spent::usize / IDLE_CALLS);
}

# a finished handshake goes back to its pool, the way a server holding many
# connections reuses it. its buffers already went back to the account
fun release_handshake() bool {
    if (!handshake_held) { ret true; }
    handshake_held = false;
    val engine: err[io_error.Error] = mem_secret.deallocate_typed[server.Handshake](cur_engine, 1);
    ret sel engine.ok;
}

# every chunk the connection held is back before its account closes
fun release_connection() bool {
    val handshake: bool                = release_handshake();
    val region:    err[io_error.Error] = mem_secret.deallocate_typed[Connection](cur, 1);
    val returned:  bool                = pool.held(?cur_memory) == 0;
    ret handshake && sel region.ok && returned && pool.destroy(?cur_memory);
}

fun serve_one(index: usize, allocator: *secret.Allocator,
    trust: *cert.TrustStore, store: *credentials.Store) i64 {
    blocking_state = BlockingTransport{runtime: ?connection_runtime,
        stream: ?connection_socket};
    lower_transport = transport.Transport{runtime: ?connection_runtime,
        context: (?blocking_state)::ptr,
        context_size:    $size_of(BlockingTransport),
        aliases_state:   blocking_aliases_state,
        submit_read:     blocking_read, submit_write: blocking_write,
        submit_shutdown: blocking_shutdown, submit_close: blocking_close,
        submit_abort:    blocking_close};

    val memory:  buffer.Lease       = pool.lease(?cur_memory);
    val secrets: buffer.SecretLease = pool.secret_lease(?cur_memory);

    var empty_extra: server.ExtraExtension;
    empty_extra.kind      = 0;
    empty_extra.data.data = nil;
    empty_extra.data.len  = 0;
    var hello_required:  usize = 0;
    var flight_required: usize = 0;
    if (!server.storage_requirements(?listener_configuration, empty_extra,
        ?hello_required, ?flight_required)) {
        print.print("cannot size server storage\n");
        ret 10;
    }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 11; }
    if (option_tls12) {
        if (!tls12_connection.init_server(?legacy_engine, ?tls12_configuration,
            memory)) {
            print.print("cannot initialize the tls 1.2 server engine\n");
            ret 10;
        }
        if (!stream.serve_tls12(?cur.secure, ?legacy_engine, memory, secrets,
            ?lower_transport, ?scope,
            transport.Token{index: 1, generation: 1}, 1) ||
            !settle(?cur.secure, ?connection_runtime)) {
            print.print("the handshake operation was not accepted\n");
            ret 12;
        }
    }
    or {
        if (!server.init(cur_engine, ?listener_configuration,
            memory, empty_extra, 0)) {
            report("hello required=", hello_required);
            report("flight required=", flight_required);
            print.print("cannot initialize the server engine\n");
            ret 10;
        }
        if (!stream.serve(?cur.secure, cur_engine, memory, secrets,
            ?lower_transport, ?scope,
            transport.Token{index: 1, generation: 1}, 1) ||
            !settle(?cur.secure, ?connection_runtime)) {
            print.print("the handshake operation was not accepted\n");
            ret 12;
        }
    }
    val handshake:  transport.Snapshot = transport.snapshot(operation(?cur.secure));
    val negotiated: engine.Snapshot    = stream.negotiated(?cur.secure);

    if (option_expect_failure) {
        if (handshake.terminal_error == error.OK) {
            print.print("expected a handshake failure\n");
            ret 13;
        }
        val alert: usize = engine.alert_for(negotiated.error)::usize;
        report("alert=", alert);
        report("error=", negotiated.error::usize);
        if (option_expect_alert != 256 && alert != option_expect_alert) {
            print.print("wrong alert\n");
            ret 14;
        }
        release(?cur.secure);
        stream.destroy(?cur.secure);
        if (option_tls12) { tls12_connection.destroy(?legacy_engine); }
        or {
            if (handshake_held) { server.destroy(cur_engine); }
        }
        ret 0;
    }

    if (handshake.terminal_error != error.OK) {
        report("handshake error=", handshake.terminal_error::usize);
        ret 20;
    }
    if (option_expect_absent_alpn) {
        if (negotiated.selected_alpn.len != 0) {
            print.print("a protocol was negotiated with no offer\n");
            ret 21;
        }
        if (negotiated.peer_offered_alpn) {
            print.print("an absent alpn extension was reported as offered\n");
            ret 21;
        }
    }
    or (option_require_alpn && (negotiated.selected_alpn.len != 2 ||
        negotiated.selected_alpn.data[0] != 'h' ||
        negotiated.selected_alpn.data[1] != '2')) {
        print.print("alpn was not negotiated\n");
        ret 21;
    }
    if (option_require_client_auth && !negotiated.authenticated) {
        print.print("the client was not authenticated\n");
        ret 22;
    }
    report("connection=", index);
    report("version=", negotiated.version::usize);
    report("suite=", negotiated.suite::usize);
    report("group=", negotiated.group::usize);
    report("retries=", negotiated.retry_count::usize);
    report("tickets=", negotiated.tickets_issued::usize);
    if (negotiated.resumed) { print.print("resumed=1\n"); }
    or                      { print.print("resumed=0\n"); }
    if (negotiated.peer_name.len != 0) {
        var name_text: [256]char;
        var i:         usize = 0;
        for (i < negotiated.peer_name.len) {
            name_text[i] = negotiated.peer_name.data[i]::char;
            i            = i + 1;
        }
        name_text[negotiated.peer_name.len] = 0::char;
        print.print("name=");
        print.print(?name_text[0]);
        print.print("\n");
    }
    if (!release(?cur.secure) || !operation_ok(cancel.destroy(?scope))) {
        ret 23;
    }
    # the handshake operation is gone, so the stream has finished the engine and
    # the handshake returns to its pool
    if (!option_tls12) {
        # the stream finished the engine, so the handshake object is released
        if (!server.snapshot(cur_engine).destroyed || !cur.secure.finished) {
            print.print("the stream did not finish its engine\n");
            ret 48;
        }
        if (!release_handshake()) { ret 47; }
        footprint("idle");
        idle_cost();
    }

    var replacement: credentials.Generation  = credentials.empty_generation();
    var retired:     *credentials.Generation = nil;
    if (option_rotate) {
        if (!load_identity(3, "server-rotated.pem", "server-rotated.key",
            "api.example.com", 15, allocator)) { ret 24; }
        rotated_identities[0] = identities[3];
        if (credentials.initialize(?replacement, ?rotated_identities[0], 1, 0,
            trust, option_require_client_auth) != contracts.OK ||
            credentials.rotate(store, ?replacement, ?retired) != contracts.OK ||
            retired == nil) { ret 25; }
        # a completed connection holds no lease, so the generation it was
        # served from is reclaimable while it keeps serving
        if (!credentials.reclaimable(retired)) {
            print.print("an established connection still pins its generation\n");
            ret 26;
        }
    }

    # a peer that only measures the handshake has already gone away, so this
    # connection is torn down without attempting another record
    if (option_handshake_only && index + 1 < connection_count) {
        if (!stream.destroy(?cur.secure)) { ret 46; }
        if (option_tls12)                 { tls12_connection.destroy(?legacy_engine); }
        or {
            if (handshake_held) { server.destroy(cur_engine); }
        }
        tcp.stream_close(?connection_socket);
        ret 0;
    }
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.read(?cur.secure, ?scope,
        transport.Token{index: 2, generation: 1},
        ?application_input[0], 512, 2) ||
        !settle(?cur.secure, ?connection_runtime)) { ret 30; }
    val read: transport.Snapshot = transport.snapshot(operation(?cur.secure));
    if (read.terminal_error != error.OK || read.application_bytes == 0) {
        report("read error=", read.terminal_error::usize);
        ret 31;
    }
    report("read=", read.application_bytes);
    if (!option_tls12) { footprint("request"); }
    if (!release(?cur.secure) || !operation_ok(cancel.destroy(?scope))) {
        ret 32;
    }

    if (option_key_update) {
        if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
            !stream.key_update(?cur.secure, ?scope,
            transport.Token{index: 6, generation: 1}, 0, 6) ||
            !settle(?cur.secure, ?connection_runtime)) { ret 60; }
        val updated: transport.Snapshot = transport.snapshot(operation(?cur.secure));
        if (updated.terminal_error != error.OK) {
            report("key update error=", updated.terminal_error::usize);
            ret 61;
        }
        if (!release(?cur.secure) || !operation_ok(cancel.destroy(?scope))) {
            ret 62;
        }
        print.print("key-updated\n");
    }

    application_output[0]  = 'm';
    application_output[1]  = 'a';
    application_output[2]  = 'c';
    application_output[3]  = 'h';
    application_output[4]  = '-';
    application_output[5]  = 't';
    application_output[6]  = 'l';
    application_output[7]  = 's';
    application_output[8]  = ' ';
    application_output[9]  = 's';
    application_output[10] = 'e';
    application_output[11] = 'r';
    application_output[12] = 'v';
    application_output[13] = 'e';
    application_output[14] = 'r';
    application_output[15] = '\n';
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.write(?cur.secure, ?scope,
        transport.Token{index: 3, generation: 1},
        ?application_output[0], 16, 3) ||
        !settle(?cur.secure, ?connection_runtime)) { ret 33; }
    val written: transport.Snapshot = transport.snapshot(operation(?cur.secure));
    if (written.terminal_error != error.OK || written.application_bytes != 16) {
        ret 34;
    }
    if (!release(?cur.secure) || !operation_ok(cancel.destroy(?scope))) {
        ret 35;
    }

    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.half_close(?cur.secure, ?scope,
        transport.Token{index: 4, generation: 1}, 4) ||
        !settle(?cur.secure, ?connection_runtime)) { ret 36; }
    val half_closed: transport.Snapshot = transport.snapshot(operation(?cur.secure));
    if (half_closed.terminal_error != error.OK || !cur.secure.send_closed ||
        !release(?cur.secure) || !operation_ok(cancel.destroy(?scope))) {
        ret 37;
    }

    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{})) ||
        !stream.close(?cur.secure, ?scope,
        transport.Token{index: 5, generation: 1}, 5) ||
        !settle(?cur.secure, ?connection_runtime)) { ret 38; }
    val closed: transport.Snapshot = transport.snapshot(operation(?cur.secure));
    if (closed.terminal_error != error.OK || !release(?cur.secure) ||
        !stream.destroy(?cur.secure) || !operation_ok(cancel.destroy(?scope))) { ret 39; }

    if (option_tls12) {
        if (!tls12_connection.destroy(?legacy_engine)) { ret 40; }
    }
    or {
        if (handshake_held && !server.destroy(cur_engine)) { ret 40; }
    }
    if (option_rotate) {
        if (!credentials.reclaimable(retired)) {
            print.print("a retired generation was pinned again before destroy\n");
            ret 41;
        }
        print.print("rotated\n");
    }
    if (!option_tls12) { footprint("destroyed"); }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var port: u16 = 9443;
    option_require_client_auth = false;
    option_require_alpn        = true;
    option_expect_absent_alpn  = false;
    option_expect_failure      = false;
    option_expect_alert        = 256;
    option_rotate              = false;
    option_key_update          = false;
    option_tickets             = 0;
    option_single_use          = false;
    option_handshake_only      = false;
    option_footprint           = false;
    option_tls12               = false;
    option_dual_version        = false;
    var prefer_p256:     bool  = false;
    var suite_choice:    usize = 0;
    var no_default:      bool  = false;
    var connections:     usize = 1;
    var identity_choice: str   = "server-ed25519";

    var argument: i64 = 1;
    for (argument < argc) {
        val current: *u8 = argv[argument];
        if (streq(current, "--port"::*u8) && argument + 1 < argc) {
            argument = argument + 1;
            port     = parse_number(argv[argument])::u16;
        }
        or (streq(current, "--require-client-auth"::*u8)) {
            option_require_client_auth = true;
        }
        or (streq(current, "--optional-alpn"::*u8)) {
            option_require_alpn = false;
        }
        or (streq(current, "--expect-absent-alpn"::*u8)) {
            option_expect_absent_alpn = true;
        }
        or (streq(current, "--groups-p256"::*u8)) {
            prefer_p256 = true;
        }
        or (streq(current, "--key-update"::*u8)) {
            option_key_update = true;
        }
        or (streq(current, "--single-use"::*u8)) {
            option_single_use = true;
        }
        or (streq(current, "--handshake-only"::*u8)) {
            option_handshake_only = true;
        }
        or (streq(current, "--footprint"::*u8)) {
            option_footprint = true;
        }
        or (streq(current, "--tls12"::*u8)) {
            option_tls12 = true;
        }
        or (streq(current, "--dual-version"::*u8)) {
            option_dual_version = true;
        }
        or (streq(current, "--tickets"::*u8) && argument + 1 < argc) {
            argument       = argument + 1;
            option_tickets = parse_number(argv[argument])::u8;
        }
        or (streq(current, "--connections"::*u8) && argument + 1 < argc) {
            argument    = argument + 1;
            connections = parse_number(argv[argument]);
        }
        or (streq(current, "--suite"::*u8) && argument + 1 < argc) {
            argument     = argument + 1;
            suite_choice = parse_number(argv[argument]);
        }
        or (streq(current, "--identity"::*u8) && argument + 1 < argc) {
            argument = argument + 1;
            if (streq(argv[argument], "p256"::*u8)) {
                identity_choice = "server-p256";
            }
            or (streq(argv[argument], "rsa"::*u8)) {
                identity_choice = "server-rsa";
            }
            or { identity_choice = "server-ed25519"; }
        }
        or (streq(current, "--expect-failure"::*u8) && argument + 1 < argc) {
            argument              = argument + 1;
            option_expect_failure = true;
            option_expect_alert   = parse_number(argv[argument]);
        }
        or (streq(current, "--rotate"::*u8)) {
            option_rotate = true;
        }
        or (streq(current, "--no-default"::*u8)) {
            no_default = true;
        }
        argument = argument + 1;
    }
    if (connections == 0 || connections > 4) { connections = 1; }
    connection_count = connections;

    val opened: err[io_error.Error] = file.root_open(?fixtures,
        "test/interop/fixtures");
    if (sel opened.err) {
        print.print("cannot open test/interop/fixtures\n");
        ret 2;
    }

    var allocator:        secret.Allocator = secret.system_allocator();
    var certificate_path: str              = "server-ed25519.pem";
    var key_path:         str              = "server-ed25519.key";
    if (streq(identity_choice::*u8, "server-p256"::*u8)) {
        certificate_path = "server-p256.pem";
        key_path         = "server-p256.key";
    }
    if (streq(identity_choice::*u8, "server-rsa"::*u8)) {
        certificate_path = "server-rsa.pem";
        key_path         = "server-rsa.key";
    }
    if (!load_identity(0, certificate_path, key_path, "api.example.com", 15,
        ?allocator) ||
        !load_identity(1, "server-alt.pem", "server-alt.key",
        "alt.example.com", 15, ?allocator) ||
        !load_identity(2, "server-wild.pem", "server-wild.key",
        "*.example.com", 13, ?allocator)) {
        print.print("cannot load server identities\n");
        ret 3;
    }
    identity_count = 3;
    if (!load_anchor("root.pem", ?client_trust)) {
        print.print("cannot load the client trust anchor\n");
        ret 4;
    }

    var generation: credentials.Generation = credentials.empty_generation();
    var trust:      *cert.TrustStore       = nil;
    if (option_require_client_auth) { trust = ?client_trust; }
    var default_index: usize = 0;
    if (no_default) { default_index = credentials.NO_DEFAULT; }
    if (credentials.initialize(?generation, ?identities[0], identity_count,
        default_index, trust,
        option_require_client_auth) != contracts.OK) {
        print.print("cannot publish the credential generation\n");
        ret 5;
    }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        print.print("cannot initialize the credential store\n");
        ret 6;
    }

    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h2"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [3]tls13.CipherSuite = [3]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256, tls13.AES_256_GCM_SHA384,
        tls13.CHACHA20_POLY1305_SHA256
    };
    var suite_len: usize = 3;
    if (suite_choice == 1) {
        suites[0] = tls13.AES_128_GCM_SHA256;
        suite_len = 1;
    }
    if (suite_choice == 2) {
        suites[0] = tls13.AES_256_GCM_SHA384;
        suite_len = 1;
    }
    if (suite_choice == 3) {
        suites[0] = tls13.CHACHA20_POLY1305_SHA256;
        suite_len = 1;
    }
    var groups: [2]tls13.NamedGroup = [2]tls13.NamedGroup{
        tls13.X25519, tls13.SECP256R1
    };
    var group_len: usize = 2;
    if (prefer_p256) {
        groups[0] = tls13.SECP256R1;
        group_len = 1;
    }
    var signatures: [5]tls13.SignatureScheme = [5]tls13.SignatureScheme{
        tls13.ED25519, tls13.ECDSA_SECP256R1_SHA256,
        tls13.ECDSA_SECP384R1_SHA384, tls13.RSA_PSS_RSAE_SHA256,
        tls13.RSA_PSS_RSAE_SHA384
    };
    var entropy: secret.Entropy = secret.system_entropy();

    listener_configuration                        = config.ServerConfig{};
    listener_configuration.credentials            = ?store;
    listener_configuration.alpn                   = ?protocols[0];
    listener_configuration.alpn_len               = 1;
    listener_configuration.require_alpn           = option_require_alpn;
    listener_configuration.versions               = ?versions[0];
    listener_configuration.version_len            = 1;
    listener_configuration.suites                 = ?suites[0];
    listener_configuration.suite_len              = suite_len;
    listener_configuration.groups                 = ?groups[0];
    listener_configuration.group_len              = group_len;
    listener_configuration.signatures             = ?signatures[0];
    listener_configuration.signature_len          = 5;
    listener_configuration.entropy                = ?entropy;
    listener_configuration.clock                  = ?harness_clock;
    listener_configuration.entropy_context_size   = 0;
    listener_configuration.tickets                = nil;
    listener_configuration.replay                 = nil;
    listener_configuration.replay_policy          = session.REPLAY_PERMISSIVE;
    listener_configuration.tickets_per_connection = 0;
    if (option_tickets != 0) {
        var ring_moment: clock.Moment;
        if (!clock.read(?harness_clock, ?ring_moment) ||
            !session.keyring_init(?ticket_ring, ?entropy, ring_moment, 3600,
            1800, 7200)) {
            print.print("cannot initialize the ticket key ring\n");
            ret 43;
        }
        listener_configuration.tickets                = ?ticket_ring;
        listener_configuration.tickets_per_connection = option_tickets;
        if (option_single_use) {
            if (!session.replay_init(?replay_window)) { ret 44; }
            listener_configuration.replay        = ?replay_window;
            listener_configuration.replay_policy = session.REPLAY_SINGLE_USE;
        }
    }
    listener_configuration.limits                          = config.production_limits();
    listener_configuration.limits.max_peer_handshake_bytes = 65536;
    listener_configuration.limits.max_client_hello_bytes   = 65536;
    listener_configuration.limits.max_chain_bytes          = 32768;
    listener_configuration.limits.max_server_flight_bytes  = 65536;

    tls12_versions[0]                = tls12.VERSION;
    tls12_versions[1]                = tls13.VERSION;
    tls12_suites[0]                  = tls12.ECDHE_ECDSA_AES_128_GCM_SHA256;
    tls12_suites[1]                  = tls12.ECDHE_ECDSA_AES_256_GCM_SHA384;
    tls12_suites[2]                  = tls12.ECDHE_ECDSA_CHACHA20_POLY1305;
    tls12_suites[3]                  = tls12.ECDHE_RSA_AES_128_GCM_SHA256;
    tls12_suites[4]                  = tls12.ECDHE_RSA_AES_256_GCM_SHA384;
    tls12_suites[5]                  = tls12.ECDHE_RSA_CHACHA20_POLY1305;
    tls12_signatures[0]              = tls13.ED25519;
    tls12_signatures[1]              = tls13.ECDSA_SECP256R1_SHA256;
    tls12_signatures[2]              = tls13.ECDSA_SECP384R1_SHA384;
    tls12_signatures[3]              = tls13.RSA_PSS_RSAE_SHA256;
    tls12_signatures[4]              = tls13.RSA_PSS_RSAE_SHA384;
    tls12_configuration              = config.ServerConfig{};
    tls12_configuration.tickets      = nil;
    tls12_configuration.replay       = nil;
    tls12_configuration.credentials  = ?store;
    tls12_configuration.alpn         = ?protocols[0];
    tls12_configuration.alpn_len     = 1;
    tls12_configuration.require_alpn = option_require_alpn;
    tls12_configuration.versions     = ?tls12_versions[0];
    tls12_configuration.version_len  = 1;
    if (option_dual_version) { tls12_configuration.version_len = 2; }
    tls12_configuration.suites                          = ?tls12_suites[0];
    tls12_configuration.suite_len                       = 6;
    tls12_configuration.groups                          = ?groups[0];
    tls12_configuration.group_len                       = group_len;
    tls12_configuration.signatures                      = ?tls12_signatures[0];
    tls12_configuration.signature_len                   = 5;
    tls12_configuration.entropy                         = ?entropy;
    tls12_configuration.clock                           = ?harness_clock;
    tls12_configuration.entropy_context_size            = 0;
    tls12_configuration.limits                          = config.production_limits();
    tls12_configuration.limits.max_peer_handshake_bytes = 65536;
    tls12_configuration.limits.max_chain_bytes          = 32768;

    val listening: res[tcp.Listener, io_error.Error] = tcp.listen(
        ip.endpoint(127, 0, 0, 1, port), 4);
    if (sel listening.err) {
        print.print("cannot listen\n");
        ret 7;
    }
    var listener: tcp.Listener = listening.ok;
    print.print("listening\n");

    var index: usize = 0;
    for (index < connections) {
        val accepted: res[tcp.Stream, io_error.Error] = tcp.accept(?listener);
        if (sel accepted.err) {
            print.print("cannot accept\n");
            ret 8;
        }
        connection_socket = accepted.ok;
        if (!make_runtime(?connection_runtime, 16)) { ret 9; }
        footprint_base = resident_pages();
        cur            = mem_secret.allocate_typed[Connection](1);
        cur_engine     = mem_secret.allocate_typed[server.Handshake](1);
        handshake_held = true;
        if (cur == nil || cur_engine == nil || !pool.make(?cur_memory, 1 << 24, 1 << 22)) {
            print.print("cannot allocate the connection\n");
            ret 9;
        }
        val served: i64 = serve_one(index, ?allocator, trust, ?store);
        if (!release_connection()) { ret 9; }
        io_runtime.close(?connection_runtime);
        io_runtime.destroy(?connection_runtime);
        if (served != 0) { ret served; }
        index = index + 1;
    }
    tcp.listener_close(?listener);
    if (option_tickets != 0) { session.keyring_destroy(?ticket_ring); }
    if (option_single_use)   { session.replay_destroy(?replay_window); }
    file.root_close(?fixtures);
    print.print("ok\n");
    ret 0;
}
